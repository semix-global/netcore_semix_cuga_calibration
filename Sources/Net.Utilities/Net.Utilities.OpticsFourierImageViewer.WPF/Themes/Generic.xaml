<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:wpf="clr-namespace:Net.Utilities.Graphics.WPF;assembly=Net.Utilities.Graphics.WPF"
                    xmlns:local="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF"
                    xmlns:converts="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF.Converts"
                    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Net.Utilities.WPF.CustomControl.Themes;component/Themes/ToolBarStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <converts:MultiBitmapImageDrawableToStringConverter x:Key="MultiBitmapImageDrawableToStringConverter" />
    <Style TargetType="{x:Type local:OpticsFourierImageCanvasControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OpticsFourierImageCanvasControl}">
                    <wpf:WPFCanvasControl x:Name="PART_WPFCanvasControl"
                                          d:DesignHeight="800"
                                          d:DesignWidth="800"
                                          Document="{TemplateBinding Document}"
                                          CursorTextVisibility="Collapsed">
                        <wpf:WPFCanvasControl.RightToolBars>
                            <ToolBar Margin="3,2"
                                     Padding="3,2"
                                     Background="Transparent"
                                     Band="0"
                                     BandIndex="1">
                                <TextBlock d:Text="0, 0 | (0.0, 0.0)" Style="{StaticResource ToolBarTextBlock}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource MultiBitmapImageDrawableToStringConverter}">
                                            <Binding ElementName="PART_WPFCanvasControl" Path="Document.View.Cursor.Point" />
                                            <Binding ElementName="PART_WPFCanvasControl" Path="Document" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </ToolBar>
                        </wpf:WPFCanvasControl.RightToolBars>
                    </wpf:WPFCanvasControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>