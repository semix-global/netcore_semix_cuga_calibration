<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <AssemblyName>Net.Utilities.Calibration</AssemblyName>
        <RootNamespace>$(AssemblyName)</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SourceGenerator.InjectHostDI">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="algocv_sharp" VersionOverride="1.4.1" />

        <PackageReference Include="Net.Utilities.Mapper" VersionOverride="2.9.7-preview2-xuan" />
        <PackageReference Include="Net.Utilities.Models" VersionOverride="2.9.7-preview2-xuan" />
        <PackageReference Include="Net.Utilities.DataAnnotations" VersionOverride="2.9.7-preview2-xuan" />
        <PackageReference Include="Net.Utilities.Helpers" VersionOverride="2.9.7-preview2-xuan" />
        <PackageReference Include="Net.Utilities.Algorithms" VersionOverride="2.9.7-preview2-xuan" />
        <PackageReference Include="Net.Utilities.Algorithms.Halcon" VersionOverride="2.9.7-preview2-xuan" />
        <PackageReference Include="Net.Utilities.IOC" VersionOverride="2.9.7-preview2-xuan" />

        <PackageReference Include="Net.Utilities.Nlog" VersionOverride="2.9.7-preview2-xuan" />

        <PackageReference Include="Net.Utilities.Graphics" VersionOverride="2.9.7-preview2-xuan" />
        <PackageReference Include="Net.Utilities.Graphics.Algorithms.Halcon" VersionOverride="2.9.7-preview2-xuan" />

        <PackageReference Include="Local.SQL.Cache.Providers" VersionOverride="2.9.7-preview2-xuan" />
        <PackageReference Include="Local.SQL.DB.Providers" VersionOverride="2.9.7-preview2-xuan" />
    </ItemGroup>

    <ItemGroup>
        <!-- 分发面引用 algo 实现（Net.Utilities.Calibration 为显示域算子分发面，混引双实现合法；06 不反向引用 00，无循环） -->
        <ProjectReference Include="..\Net.Utilities.Algorithms.AlgoCSharp\Net.Utilities.Algorithms.AlgoCSharp.csproj" />
    </ItemGroup>

</Project>