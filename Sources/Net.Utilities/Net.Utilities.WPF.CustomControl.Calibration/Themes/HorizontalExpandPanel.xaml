<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Net.Utilities.WPF.CustomControl.Calibration">
    <Style TargetType="{x:Type local:HorizontalExpandPanel}">
        <Setter Property="PanelBackground" Value="#EEEEEE" />
        <Setter Property="PanelHoverBackground" Value="#F0F0F0" />
        <Setter Property="PanelForeground" Value="#4B4B4B" />
        <Setter Property="PanelBorderBrush" Value="#E0E0E0" />
        <Setter Property="PanelBorderThickness" Value="1" />
        <Setter Property="PanelBorderCornerRadius" Value="3" />
        <Setter Property="PanelVisibility" Value="Visible" />
        <Setter Property="HorizontalExpandDirectionEnum" Value="Right" />
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HorizontalExpandPanel}">
                    <Grid FlowDirection="{TemplateBinding FlowDirection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PART_ToolColumn" Width="Auto" />
                            <ColumnDefinition x:Name="PART_SideContentColumn" Width="500" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PART_ToolBorder" Grid.Column="0"
                                Background="{TemplateBinding PanelBackground}"
                                BorderBrush="{TemplateBinding PanelBorderBrush}"
                                BorderThickness="{TemplateBinding PanelBorderThickness}"
                                Visibility="{TemplateBinding PanelVisibility}">
                            <Path x:Name="PART_ToolArrowPath"
                                  Width="24"
                                  Height="24"
                                  Margin="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Fill="{TemplateBinding PanelForeground}"
                                  Stretch="Uniform" />
                        </Border>
                        <ContentPresenter x:Name="PART_SideContent" Grid.Column="1"
                                          Content="{TemplateBinding ExpandContent}"
                                          FlowDirection="LeftToRight"
                                          Visibility="{TemplateBinding PanelVisibility}" />
                        <GridSplitter x:Name="PART_Splitter" Grid.Column="2"
                                      Width="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ResizeBehavior="PreviousAndNext"
                                      Visibility="{TemplateBinding PanelVisibility}" />
                        <ContentPresenter Grid.Column="3"
                                          Content="{TemplateBinding MainContent}"
                                          FlowDirection="LeftToRight" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PART_ToolBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ToolBorder" Property="Background" Value="{Binding PanelHoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>