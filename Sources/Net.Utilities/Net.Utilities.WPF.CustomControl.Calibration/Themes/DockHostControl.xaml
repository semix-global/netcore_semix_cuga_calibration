<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Net.Utilities.WPF.CustomControl.Calibration">
    <Style TargetType="{x:Type local:DockHostControl}">
        <Setter Property="Background" Value="#F0F0F0" />
        <Setter Property="Foreground" Value="#FF545454" />
        <Setter Property="BorderHoverBrush" Value="#FFE0E0E0" />
        <Setter Property="BorderBrush" Value="#E0E0E0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderCornerRadius" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DockHostControl}">
                    <Grid FlowDirection="{TemplateBinding FlowDirection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PART_ToolColumn" Width="Auto" />
                            <ColumnDefinition x:Name="PART_SideContentColumn" Width="500" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PART_ToolBorder" Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Visibility="{TemplateBinding SideContentVisibility}">
                            <Path x:Name="PART_ArrowPath"
                                  Width="24"
                                  Height="24"
                                  Margin="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Data="{TemplateBinding IconGeometry}"
                                  Fill="{TemplateBinding Foreground}"
                                  Stretch="Uniform" />
                        </Border>
                        <ContentPresenter x:Name="PART_SideContent" Grid.Column="1"
                                          Content="{TemplateBinding SideContent}"
                                          FlowDirection="LeftToRight"
                                          Visibility="{TemplateBinding SideContentVisibility}" />
                        <GridSplitter x:Name="PART_Splitter" Grid.Column="2"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext"
                                      Visibility="{TemplateBinding SideContentVisibility}" />
                        <ContentPresenter Grid.Column="3"
                                          Content="{TemplateBinding MainContent}"
                                          FlowDirection="LeftToRight" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PART_ToolBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ToolBorder"
                                    Property="Background"
                                    Value="{Binding BorderHoverBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>