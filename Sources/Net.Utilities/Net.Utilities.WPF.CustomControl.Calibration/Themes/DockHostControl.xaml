<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Net.Utilities.WPF.CustomControl.Calibration"
                    xmlns:o="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <Style TargetType="{x:Type local:DockHostControl}">
        <Style.Resources>
            <DrawingImage x:Key="LeftDrawingImage" o:Freeze="True">
                <DrawingImage.Drawing>
                    <DrawingGroup ClipGeometry="M0,0 V1024 H1024 V0 H0 Z">
                        <GeometryDrawing Brush="#FF545454" Geometry="F1 M1024,1024z M0,0z M724,218.3L724,141C724,134.3,716.3,130.6,711.1,134.7L260.3,486.8C243.9,499.6,243.9,524.3,260.3,537.1L711.1,889.2C716.4,893.3,724,889.6,724,882.9L724,805.6C724,800.7,721.7,796,717.9,793L357.9,512 717.9,230.9C721.7,227.9,724,223.2,724,218.3z" />
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <DrawingImage x:Key="RightDrawingImage" o:Freeze="True">
                <DrawingImage.Drawing>
                    <DrawingGroup ClipGeometry="M0,0 V1024 H1024 V0 H0 Z">
                        <GeometryDrawing Brush="#FF545454" Geometry="F1 M1024,1024z M0,0z M765.7,486.8L314.9,134.7C309.6,130.6,302,134.3,302,141L302,218.3C302,223.2,304.3,227.9,308.1,230.9L668.1,512 308.1,793.1C304.2,796.1,302,800.8,302,805.7L302,883C302,889.7,309.7,893.4,314.9,889.3L765.7,537.2C782.1,524.4,782.1,499.6,765.7,486.8z" />
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DockHostControl}">
                    <Grid FlowDirection="{TemplateBinding FlowDirection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PART_ToolColumn" Width="28" />
                            <ColumnDefinition x:Name="PART_SideContentColumn" Width="300" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PART_ToolBorder" Grid.Column="0"
                                Background="#F0F0F0"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0"
                                CornerRadius="3"
                                Visibility="{TemplateBinding SideContentVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Image x:Name="PART_ArrowImage"
                                       Width="24"
                                       Height="24"
                                       Margin="5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Stretch="Fill" />
                                <ContentPresenter Grid.Row="1"
                                                  Content="{TemplateBinding ToolContent}"
                                                  FlowDirection="LeftToRight" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="PART_SideContent" Grid.Column="1"
                                          Content="{TemplateBinding SideContent}"
                                          FlowDirection="LeftToRight"
                                          Visibility="{TemplateBinding SideContentVisibility}" />
                        <GridSplitter x:Name="PART_Splitter" Grid.Column="2"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext"
                                      Visibility="{TemplateBinding SideContentVisibility}" />
                        <ContentPresenter Grid.Column="3"
                                          Content="{TemplateBinding MainContent}"
                                          FlowDirection="LeftToRight" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>