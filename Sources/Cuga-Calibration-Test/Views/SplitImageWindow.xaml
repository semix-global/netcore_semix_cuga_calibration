<hc:Window x:Class="CugaCalibrationTest.Views.SplitImageWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibrationTest.ViewModels"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="Split Image"
           Width="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:SplitImageWindowViewModel,
                                            IsDesignTimeCreatable=True}"
           SizeToContent="Height"
           WindowState="Normal"
           WindowStartupLocation="CenterScreen"
           Icon="/Assets/Images/Function.ico"
           mc:Ignorable="d">
    <Border Margin="1"
            Style="{StaticResource BorderRegion}"
            Effect="{StaticResource EffectShadow1}">
        <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical">
            <TextBox Text="{Binding TemplateFilePath}"
                     Height="100"
                     TextWrapping="Wrap"
                     hc:TitleElement.Title="TemplateFilePath: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Style="{StaticResource TextBoxExtend}" />
            <TextBox Text="{Binding TemplateImageFilePath}"
                     Height="100"
                     TextWrapping="Wrap"
                     hc:TitleElement.Title="TemplateImageFilePath: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Style="{StaticResource TextBoxExtend}" />
            <TextBox Text="{Binding RawImageFilePath}"
                     Height="100"
                     TextWrapping="Wrap"
                     hc:TitleElement.Title="RawImageFilePath: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Style="{StaticResource TextBoxExtend}" />
            <Separator />
            <TextBox Text="{Binding DieWidthUm}"
                     hc:TitleElement.Title="DieWidthUm: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Style="{StaticResource TextBoxExtend}" />
            <TextBox Text="{Binding ImageMatchThreshold}"
                     hc:TitleElement.Title="ImageMatchThreshold: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Style="{StaticResource TextBoxExtend}" />
            <Separator />
            <TextBox Text="{Binding RealUmPerPixel}"
                     hc:TitleElement.Title="RealUmPerPixel: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Background="{StaticResource SecondaryRegionBrush}"
                     IsReadOnly="True"
                     Style="{StaticResource TextBoxExtend}" />
            <Separator />
            <TextBox Text="{Binding ImageWidthPixel}"
                     hc:TitleElement.Title="ImageWidthPixel: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Style="{StaticResource TextBoxExtend}" />
            <TextBox Text="{Binding ImageCount}"
                     hc:TitleElement.Title="ImageCount: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Style="{StaticResource TextBoxExtend}" />
            <Separator />
            <TextBox Text="{Binding WaferDiameterUm}"
                     hc:TitleElement.Title="WaferDiameterUm: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Style="{StaticResource TextBoxExtend}" />
            <TextBox Text="{Binding VerifyThreasholdPixel}"
                     hc:TitleElement.Title="VerifyThreasholdPixel: "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="200"
                     Style="{StaticResource TextBoxExtend}" />
            <Separator />
            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="20">
                <Button Content="Action"
                        Command="{Binding SplitImageCommand}"
                        Width="200"
                        Style="{StaticResource ButtonPrimary.Loading}" />
                <Button Content="Cancel"
                        Command="{Binding SplitImageCancelCommand}"
                        Width="200"
                        Style="{StaticResource ButtonWarning}" />
            </hc:UniformSpacingPanel>
        </hc:UniformSpacingPanel>
    </Border>
</hc:Window>