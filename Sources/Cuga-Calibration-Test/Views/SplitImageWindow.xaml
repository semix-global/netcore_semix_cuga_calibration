<hc:Window x:Class="CugaCalibrationTest.Views.SplitImageWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibrationTest.ViewModels"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:xPixelSize="clr-namespace:CugaCalibration.Views.Laser.XPixelSize;assembly=Cuga-Calibration-Solution"
           Title="Split Image"
           Width="1800"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:SplitImageWindowViewModel,
                                            IsDesignTimeCreatable=True}"
           SizeToContent="Height"
           WindowState="Normal"
           WindowStartupLocation="CenterScreen"
           Icon="/Assets/Images/Function.ico"
           mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Border Margin="1"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical">
                <TextBox Text="{Binding TemplateFilePath}"
                         Height="100"
                         TextWrapping="Wrap"
                         hc:TitleElement.Title="TemplateFilePath: "
                         hc:TitleElement.TitlePlacement="Left"
                         hc:TitleElement.TitleWidth="150"
                         Style="{StaticResource TextBoxExtend}" />
                <TextBox Text="{Binding TemplateImageFilePath}"
                         Height="100"
                         TextWrapping="Wrap"
                         hc:TitleElement.Title="TemplateImageFilePath: "
                         hc:TitleElement.TitlePlacement="Left"
                         hc:TitleElement.TitleWidth="150"
                         Style="{StaticResource TextBoxExtend}" />
                <TextBox Text="{Binding SlideRawImageFilePath}"
                         Height="50"
                         TextWrapping="Wrap"
                         hc:TitleElement.Title="SlideRawImageFilePath: "
                         hc:TitleElement.TitlePlacement="Left"
                         hc:TitleElement.TitleWidth="150"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource TextBoxExtend}" />
                <TextBox Text="{Binding VerifyRawImageFilePath}"
                         Height="50"
                         TextWrapping="Wrap"
                         hc:TitleElement.Title="VerifyRawImageFilePath: "
                         hc:TitleElement.TitlePlacement="Left"
                         hc:TitleElement.TitleWidth="150"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource TextBoxExtend}" />
                <hc:NumericUpDown hc:TitleElement.Title="Threshold(px): "
                                  hc:TitleElement.TitleWidth="150"
                                  hc:TitleElement.TitlePlacement="Left"
                                  Minimum="0"
                                  Style="{StaticResource NumericUpDownExtend}"
                                  Value="{Binding Threshold}" />
                <hc:NumericUpDown hc:TitleElement.Title="NCC Match Threshold: "
                                  hc:TitleElement.TitleWidth="150"
                                  hc:TitleElement.TitlePlacement="Left"
                                  Minimum="0"
                                  Maximum="1"
                                  Style="{StaticResource NumericUpDownExtend}"
                                  Value="{Binding NccTypeTemplateMatchScoreThreshold}" />
                <hc:NumericUpDown hc:TitleElement.Title="Sharpe Match Threshold: "
                                  hc:TitleElement.TitleWidth="150"
                                  hc:TitleElement.TitlePlacement="Left"
                                  Minimum="0"
                                  Maximum="1"
                                  Style="{StaticResource NumericUpDownExtend}"
                                  Value="{Binding SharpeTypeTemplateMatchScoreThreshold}" />
                <Separator />
                <TextBox Text="{Binding XPixelSize}"
                         hc:TitleElement.Title="XPixelSize(um/px): "
                         hc:TitleElement.TitlePlacement="Left"
                         hc:TitleElement.TitleWidth="150"
                         Background="{StaticResource SecondaryRegionBrush}"
                         IsReadOnly="True"
                         Style="{StaticResource TextBoxExtend}" />
                <Separator />
                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Spacing="10">
                    <Button Content="Split"
                            Command="{Binding SplitImageCommand}"
                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                            Style="{StaticResource ButtonPrimary.Loading}" />
                    <Button Content="Continue"
                            Command="{Binding ContinueCommand}"
                            Style="{StaticResource ButtonDefault}" />
                    <Button Content="Cancel"
                            Command="{Binding SplitImageCancelCommand}"
                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                            Style="{StaticResource ButtonWarning}" />
                </hc:UniformSpacingPanel>
                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Spacing="10">
                    <Button Content="Verify"
                            Command="{Binding VerifyCommand}"
                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                            Style="{StaticResource ButtonPrimary.Loading}" />
                    <Button Content="Cancel"
                            Command="{Binding VerifyCancelCommand}"
                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                            Style="{StaticResource ButtonWarning}" />
                </hc:UniformSpacingPanel>
            </hc:UniformSpacingPanel>
        </Border>
        <Border Grid.Column="2">
            <xPixelSize:LaserXPixelSizeCalibrationUserControl />
        </Border>
    </Grid>
</hc:Window>