<hc:Window x:Class="CugaCalibrationTest.Views.StageMapWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibrationTest.ViewModels"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="Stage Map"
           Width="1200"
           Height="800"
           d:DataContext="{d:DesignInstance Type=viewModels:StageMapWindowViewModel,
                                            IsDesignTimeCreatable=True}"
           WindowState="Normal"
           WindowStartupLocation="CenterScreen"
           Icon="/Assets/Images/Function.ico"
           mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="300"
                Margin="5"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <hc:UniformSpacingPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                            <Setter Property="Margin" Value="5" />
                        </Style>
                    </hc:UniformSpacingPanel.Resources>
                    <Button Content="Stage Map Merge 1" Command="{Binding MergeStageMapStep0Command}" />
                    <Button Content="Stage Map Merge 2" Command="{Binding MergeStageMapStep1Command}" />
                    <Button Content="Calculate Error Map" Command="{Binding CalculateStageMapErrorCommand}" />
                    <GroupBox Margin="5" Header="Verify Bilinear Position">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:UniformSpacingPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                    <Setter Property="Margin" Value="5" />
                                </Style>
                            </hc:UniformSpacingPanel.Resources>
                            <TextBox Text="{Binding StartPoint, Converter={StaticResource PointToStringConverter}}"
                                     hc:InfoElement.Title="Start Point: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="100"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Rows: "
                                              hc:TitleElement.TitleWidth="100"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding RowCount}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Columns: "
                                              hc:TitleElement.TitleWidth="100"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding ColumnCount}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Row Height: "
                                              hc:TitleElement.TitleWidth="100"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding RowHeight}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Column Width: "
                                              hc:TitleElement.TitleWidth="100"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding ColumnWidth}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Show Details: "
                                           Width="100"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <ToggleButton IsChecked="{Binding IsShowDetails}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Background="{StaticResource InfoBrush}"
                                              Style="{StaticResource ToggleButtonSwitch}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Is Contain Error: "
                                           Width="100"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <ToggleButton IsChecked="{Binding IsContainError}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Background="{StaticResource InfoBrush}"
                                              Style="{StaticResource ToggleButtonSwitch}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Vertical"
                                                    Spacing="8"
                                                    Visibility="{Binding IsContainError, Converter={StaticResource BoolToVisibilityConverter}}">
                                <hc:NumericUpDown hc:InfoElement.Title="Error 1: "
                                                  hc:TitleElement.TitleWidth="100"
                                                  hc:InfoElement.TitlePlacement="Left"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Minimum="1"
                                                  Value="{Binding Error1}" />
                                <hc:NumericUpDown hc:InfoElement.Title="Error 2: "
                                                  hc:TitleElement.TitleWidth="100"
                                                  hc:InfoElement.TitlePlacement="Left"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Minimum="1"
                                                  Value="{Binding Error2}" />
                                <hc:NumericUpDown hc:InfoElement.Title="Error 3: "
                                                  hc:TitleElement.TitleWidth="100"
                                                  hc:InfoElement.TitlePlacement="Left"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Minimum="1"
                                                  Value="{Binding Error3}" />
                                <hc:NumericUpDown hc:InfoElement.Title="Error 4: "
                                                  hc:TitleElement.TitleWidth="100"
                                                  hc:InfoElement.TitlePlacement="Left"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Minimum="1"
                                                  Value="{Binding Error4}" />
                            </hc:UniformSpacingPanel>
                            <Button Content="Generate Matrix" Command="{Binding TestBilinearGenerateMatrixCommand}" />
                            <Separator />
                            <TextBox Text="{Binding SearchPoint, Converter={StaticResource PointToStringConverter}}"
                                     hc:InfoElement.Title="Search Point: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="100"
                                     Style="{StaticResource TextBoxExtend}" />
                            <Button Content="Search Position" Command="{Binding TestBilinearSearchPointCommand}" />
                        </hc:UniformSpacingPanel>
                    </GroupBox>
                </hc:UniformSpacingPanel>
            </hc:UniformSpacingPanel>
        </Border>
        <Border Grid.Column="1"
                Margin="5"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <ContentControl Content="{Binding WpfPlot}" />
        </Border>
    </Grid>
</hc:Window>