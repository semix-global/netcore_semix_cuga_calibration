<hc:Window x:Class="CugaScript.Views.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaScript.ViewModels"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
           xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
           xmlns:nlog="clr-namespace:Net.Utilities.WPF.UI.Nlog;assembly=Net.Utilities.WPF"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="{Binding Title, Mode=OneWay}"
           Width="1200"
           Height="800"
           d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
           wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
           Background="{StaticResource SecondaryRegionBrush}"
           Icon="/Assets/Images/CugaScript.ico"
           NonClientAreaBackground="{StaticResource PrimaryBrush}"
           NonClientAreaForeground="White"
           ResizeMode="CanResizeWithGrip"
           ShowTitle="False"
           Style="{StaticResource WindowWin10}"
           WindowStartupLocation="CenterScreen"
           WindowState="Maximized"
           mc:Ignorable="d">
    <hc:Window.NonClientAreaContent>
        <TextBlock Text="{Binding Title, Mode=OneWay}"
                   Margin="5,0"
                   HorizontalAlignment="Left"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="White"
                   Style="{StaticResource TextBlockDefault}" />
    </hc:Window.NonClientAreaContent>
    <hc:Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunScriptFileCommand}" />
        <KeyBinding Command="{Binding RunScriptFileCancelCommand}" Gesture="Shift+F5" />
        <KeyBinding Command="{Binding SaveScriptFileCommand}" Gesture="Ctrl+S" />
    </hc:Window.InputBindings>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel IsEnabled="{Binding IsLoadingOk}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="View">
                <MenuItem Command="{Binding ShowStageCommand}" Header="Move Stage" />
                <MenuItem Command="{Binding ShowMicroscopeCommand}" Header="Switch Microscope" />
            </MenuItem>
            <MenuItem Header="Help" />
        </Menu>
        <ToolBar Margin="5,5,5,0"
                 DockPanel.Dock="Top"
                 Background="White">
            <ToolBar.Resources>
                <Style x:Key="ToolButtonStyle"
                       BasedOn="{StaticResource ButtonDefault.Small}"
                       TargetType="Button">
                    <Setter Property="Width" Value="30" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="5,0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="ToolTipService.Placement" Value="Top" />
                </Style>
                <Style x:Key="ToolButtonStyle.Loading"
                       BasedOn="{StaticResource ToolButtonStyle}"
                       TargetType="Button">
                    <Setter Property="IsEnabled" Value="{Binding IsRunningScript, Converter={StaticResource BoolNegationConverter}}" />
                </Style>
            </ToolBar.Resources>
            <Button Command="{Binding NewScriptFileCommand}"
                    ToolTip="New Script"
                    Style="{StaticResource ToolButtonStyle.Loading}">
                <Image Width="20"
                       Height="20"
                       Source="{StaticResource CsharpFileImage}" />
            </Button>
            <Button Command="{Binding NewScriptDirectoryCommand}"
                    ToolTip="New Directory"
                    Style="{StaticResource ToolButtonStyle.Loading}">
                <Image Width="20"
                       Height="20"
                       Source="{StaticResource AddFolderImage}" />
            </Button>
            <Button Command="{Binding DeleteDirectoryCommand}"
                    ToolTip="Delete"
                    Style="{StaticResource ToolButtonStyle.Loading}">
                <Image Width="20"
                       Height="20"
                       Source="{StaticResource RecycleBinImage}" />
            </Button>
            <Separator Margin="5,0" />
            <Button Command="{Binding SaveScriptFileCommand}"
                    ToolTip="Save Script"
                    Style="{StaticResource ToolButtonStyle.Loading}">
                <Image Width="20"
                       Height="20"
                       Source="{StaticResource SaveImage}" />
            </Button>
            <Separator Margin="5,0" />
            <Button Command="{Binding RunScriptFileCommand}"
                    ToolTip="Run Script"
                    Style="{StaticResource ToolButtonStyle.Loading}">
                <Grid>
                    <Image Width="20"
                           Height="20"
                           Source="{StaticResource RunImage}" />
                </Grid>
            </Button>
            <Button Command="{Binding RunScriptFileCancelCommand}"
                    ToolTip="Stop Script"
                    Style="{StaticResource ToolButtonStyle}">
                <Image Width="20"
                       Height="20"
                       Source="{StaticResource StopImage}" />
            </Button>
            <Button Command="{Binding CloseScriptFileCommand}"
                    ToolTip="Close"
                    Style="{StaticResource ToolButtonStyle.Loading}">
                <Image Width="20"
                       Height="20"
                       Source="{StaticResource CloseImage}" />
            </Button>
        </ToolBar>
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--#region Left-->
            <TreeView ItemsSource="{Binding ScriptFileMenu.ChildList}">
                <i:Interaction.Behaviors>
                    <behaviors:BindableSelectedItemBehavior SelectedItem="{Binding SelectScriptFileMenu, Mode=OneWayToSource}" />
                </i:Interaction.Behaviors>
                <TreeView.ItemContainerStyle>
                    <!--  防止覆盖原有样式  -->
                    <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFile}" Value="True">
                                <Setter Property="attachedHelper:MouseDoubleClickHelper.Command" Value="{Binding DataContext.OpenScriptFileCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
                                <Setter Property="attachedHelper:MouseDoubleClickHelper.CommandParameter" Value="{Binding .}" />
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource MultiValueEqualityConverter}">
                                        <!--  任何一个Binding变动都会触发MultiBinding  -->
                                        <Binding Mode="OneWay" Path="." />
                                        <Binding Mode="OneWay"
                                                 Path="DataContext.ActiveItem"
                                                 RelativeSource="{RelativeSource FindAncestor,
                                                                                 AncestorType=Window}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Foreground" Value="{StaticResource DarkAccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding ChildList}">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <Image x:Name="Image"
                                   Width="16"
                                   Height="16"
                                   Margin="5,0"
                                   Source="{StaticResource CsharpFileImage}" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                <Setter TargetName="Image" Property="Source" Value="{StaticResource FolderImage}" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <!--#endregion-->

            <GridSplitter Grid.Column="1" Width="5" />

            <!--#region right-->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource BorderRegion}">
                    <avalonedit:TextEditor x:Name="TextEditor"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Background="White"
                                           Document="{Binding TextDocument, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                           Foreground="Black"
                                           LineNumbersForeground="Black"
                                           ShowLineNumbers="True"
                                           SyntaxHighlighting="C#" />
                </Border>

                <GridSplitter Grid.Row="1" Height="5" />

                <nlog:NLogViewer Grid.Row="2"
                                 MinLogLevel="{Binding MinLogLevel, Mode=TwoWay}"
                                 TargetName="targetNLogViewer" />
            </Grid>
            <!--#endregion-->
        </Grid>
    </DockPanel>
</hc:Window>