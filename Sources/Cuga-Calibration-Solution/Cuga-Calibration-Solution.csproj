<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>net480;net8.0-windows10.0.19041</TargetFrameworks>
        <UseWPF>true</UseWPF>
        <PlatformTarget>x64</PlatformTarget>
        <RootNamespace>CugaCalibration</RootNamespace>
        <StartupObject>CugaCalibration.App</StartupObject>
        <ApplicationIcon>Assets\Images\CugaCalibration.ico</ApplicationIcon>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsPreviewNamespaces>
    </PropertyGroup>

    <PropertyGroup>
        <ContentSQLiteInteropFiles>true</ContentSQLiteInteropFiles>
        <CopySQLiteInteropFiles>false</CopySQLiteInteropFiles>
        <CleanSQLiteInteropFiles>false</CleanSQLiteInteropFiles>
        <CollectSQLiteInteropFiles>false</CollectSQLiteInteropFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="NLog.Schema" />
        <PackageReference Include="NLog.Extensions.Hosting" />
        <PackageReference Include="System.Data.SQLite.Core" />
        <PackageReference Include="FreeSql.Provider.Sqlite" />
        <PackageReference Include="SourceGenerator.InjectHostDI">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Source Generator 项目引用 -->
    <ItemGroup>
        <ProjectReference Include="..\Cores\Core.SourceGenerators\Core.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="HAlgorithm">
            <HintPath>..\..\Dependencies\Semix.Arithmetic2.0\HAlgorithm.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net480'">
        <Reference Include="Semix.CoreLib">
            <HintPath>..\..\Dependencies\Semix.Cuga.Runtime2.0\Semix.CoreLib.dll</HintPath>
        </Reference>
        <Reference Include="Cuga.Data.DataStruct">
            <HintPath>..\..\Dependencies\Semix.Cuga.Runtime2.0\Cuga.Data.DataStruct.dll</HintPath>
        </Reference>
        <Reference Include="Semix.WcfTransfer.DTO">
            <HintPath>..\..\Dependencies\Semix.Cuga.Runtime2.0\Semix.WcfTransfer.DTO.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cores\Core.Models\03. Core.Models.csproj" />
        <ProjectReference Include="..\Cores\Core.Services\04. Core.Services.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="ViewModels\Common\Windows\Tools\AODWaveform\AODWaveformCommon*.cs">
            <DependentUpon>AbstractAODWaveformCommonWindowViewModel.cs</DependentUpon>
        </Compile>
        <Compile Update="ViewModels\Common\Windows\Tools\AODWaveform\AODWaveformElectrodeOffset*.cs">
            <DependentUpon>AbstractAODWaveformElectrodeOffsetWindowViewModel.cs</DependentUpon>
        </Compile>
        <Compile Update="ViewModels\Common\Windows\Tools\AODWaveform\AODWaveformElectrodeInitialize*.cs">
            <DependentUpon>AbstractAODWaveformElectrodeInitializeWindowViewModel.cs</DependentUpon>
        </Compile>
        <Compile Update="ViewModels\Common\Windows\Tools\AODWaveform\ChirpAODWaveformElectrodeOffset*.cs">
            <DependentUpon>ChirpAODWaveformElectrodeOffsetWindowViewModel.cs</DependentUpon>
        </Compile>
        <Compile Update="ViewModels\Common\Windows\Tools\AODWaveform\ChirpAODWaveformElectrodeInitialize*.cs">
            <DependentUpon>ChirpAODWaveformElectrodeInitializeWindowViewModel.cs</DependentUpon>
        </Compile>
        <Compile Update="ViewModels\Common\Windows\Tools\AODWaveform\PrescanAODWaveformElectrodeOffset*.cs">
            <DependentUpon>PrescanAODWaveformElectrodeOffsetWindowViewModel.cs</DependentUpon>
        </Compile>
        <Compile Update="ViewModels\Common\Windows\Tools\AODWaveform\PrescanAODWaveformElectrodeInitialize*.cs">
            <DependentUpon>PrescanAODWaveformElectrodeInitializeWindowViewModel.cs</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <ApplicationDefinition Remove="App.xaml" />
        <Page Include="App.xaml" />
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="appsettings.Development.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <DependentUpon>appsettings.json</DependentUpon>
        </Content>
        <Content Include="appsettings.Production.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <DependentUpon>appsettings.json</DependentUpon>
        </Content>
        <Content Include="NLog.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Page Update="Views\AOD\BestFocusAndAstigmatism\Children\Step0View.xaml">
          <Generator>MSBuild:Compile</Generator>
          <XamlRuntime>Wpf</XamlRuntime>
          <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\AOD\BestFocusAndAstigmatism\Children\Step1View.xaml">
          <Generator>MSBuild:Compile</Generator>
          <XamlRuntime>Wpf</XamlRuntime>
          <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\AOD\BestFocusAndAstigmatism\BestFocusAndAstigmatismCalibrationUserControl.xaml">
          <Generator>MSBuild:Compile</Generator>
          <XamlRuntime>Wpf</XamlRuntime>
          <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Assets\Images\*.*" />
        <None Update="Assets\Data\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>