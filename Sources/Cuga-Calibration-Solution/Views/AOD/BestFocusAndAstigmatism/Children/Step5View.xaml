<UserControl x:Class="CugaCalibration.Views.AOD.BestFocusAndAstigmatism.Children.Step5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AOD"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:bestFocusAndAstigmatism="clr-namespace:Core.Models.Models.AOD.BestFocusAndAstigmatism;assembly=Core.Models"
             xmlns:ui="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
             xmlns:darkField="clr-namespace:Core.Models.Models.Common.DarkField;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:AODBestFocusAndAstigmatismViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Step 6: "
                           Status="{Binding CalibrationStepList[4].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.Item.MicroscopeLensInformation.LensName}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Productivity Information: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Apodization Mode: "
                           Status="{Binding Cache.ApodizationModeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="CIB Information: "
                           Status="{Binding Cache.Item.CIBInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Common Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:TitleElement.TitleWidth="220"
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.Title="Algorithm Type: "
                                         SelectedItem="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmImageQualityTypeEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <hc:NumericUpDown hc:TitleElement.Title="Times: "
                                              hc:TitleElement.TitleWidth="220"
                                              hc:TitleElement.TitlePlacement="Left"
                                              Increment="1"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.Times}" />
                            <hc:NumericUpDown hc:TitleElement.Title="XY Best Focus Ecs Offset Threshold: "
                                              hc:TitleElement.TitleWidth="220"
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.XYBestFocusEcsOffsetThreshold}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="X Axis Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox Text="{Binding Cache.Item.StartPosition, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.TitleWidth="220"
                                 hc:TitleElement.Title="Start Bright Field Position(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Cache.Item.ScanLength}"
                                 hc:TitleElement.TitleWidth="220"
                                 hc:TitleElement.Title="Scan Length(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <StackPanel>
                            <TextBlock Text="Z Axis Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                          hc:TitleElement.Title="Center ECS: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.CenterECS}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                          hc:TitleElement.Title="Range ECS(±ecs): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.RangeECS}" />
                        <StackPanel>
                            <TextBlock Text="Chirp AOD Wave Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox Text="{Binding Cache.Item.DefaultGenerateChirpAODWaveformParam.SpectralDensity, Mode=OneWay, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="220"
                                 hc:TitleElement.Title="Default SpectralDensity(MHz/mm): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                          hc:TitleElement.Title="Start SpectralDensity(MHz/mm): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.StartSpectralDensity}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                          hc:TitleElement.Title="Step SpectralDensity(MHz/mm): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.StepSpectralDensity}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                          hc:TitleElement.Title="Step Count: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:Increment="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.SpectralDensityStepCount}" />
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:TextBox Text="{Binding CalibratingItem.ResultDTO.SpectralDensity, StringFormat='0.###', Mode=OneWay}"
                                    hc:TitleElement.TitleWidth="220"
                                    hc:TitleElement.Title="Astigmatism Spectral Density(Mhz/mm): "
                                    hc:TitleElement.TitlePlacement="Left"
                                    Background="{StaticResource SecondaryRegionBrush}"
                                    Style="{StaticResource TextBoxExtend}"
                                    IsReadOnly="True" />

                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step5Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step5CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <Grid Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Row="0" Grid.Column="0"
                      Header="History">
                <ListView x:Name="HistoryListView"
                          ItemsSource="{Binding CalibratingItem.Items}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Spectral Density" DisplayMemberBinding="{Binding SpectralDensity, StringFormat='0.###'}" />
                            <GridViewColumn Header="X Best Focus" DisplayMemberBinding="{Binding BestFocus.BestXStrehlRatioECS, StringFormat='0.###'}" />
                            <GridViewColumn Header="Y Best Focus" DisplayMemberBinding="{Binding BestFocus.BestYStrehlRatioECS, StringFormat='0.###'}" />
                            <GridViewColumn Header="XY Best Focus Offset" DisplayMemberBinding="{Binding XYBestFocusOffsetEcs, StringFormat='0.###'}" />
                            <GridViewColumn Header="Waveform Profiles">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type bestFocusAndAstigmatism:AODBestFocusAndAstigmatismDTOItem}">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButtonAODWaveformProfiles"
                                                          Content="Profiles"
                                                          Margin="0,2"
                                                          HorizontalAlignment="Left"
                                                          hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                            <Popup Width="800"
                                                   Height="800"
                                                   StaysOpen="False"
                                                   PlacementTarget="{Binding ElementName=ToggleButtonAODWaveformProfiles}"
                                                   Placement="Right"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Slide"
                                                   IsOpen="{Binding IsChecked, ElementName=ToggleButtonAODWaveformProfiles, Mode=TwoWay}">
                                                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                                    <TabControl>
                                                        <TabItem Header="Chirp AOD Waveform">
                                                            <ui:ChirpAODWaveformProfilesUserControl DataContext="{Binding ChirpAODWaveformProfiles}" />
                                                        </TabItem>
                                                    </TabControl>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <GridSplitter Grid.Row="0" Grid.Column="1"
                          Grid.RowSpan="3" />

            <GroupBox Grid.Row="0" Grid.Column="2"
                      Header="History Plot">
                <TabControl>
                    <TabItem Header="Summary">
                        <hc:ScrollViewer>
                            <ContentControl Content="{Binding CalibratingItem.ScatterPlotControl, Mode=OneWay}" />
                        </hc:ScrollViewer>
                    </TabItem>
                </TabControl>
            </GroupBox>

            <GridSplitter Grid.Row="1" Grid.Column="0"
                          Grid.ColumnSpan="3" />

            <GroupBox Grid.Row="2" Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Header="Details Plot">
                <TabControl ItemsSource="{Binding SelectedItems, ElementName=HistoryListView}" SelectedIndex="0">
                    <i:Interaction.Behaviors>
                        <wpf:SelectorAutoSelectFirstBehavior />
                    </i:Interaction.Behaviors>
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type bestFocusAndAstigmatism:AODBestFocusAndAstigmatismDTOItem}">
                            <TextBlock Text="{Binding SpectralDensity}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type bestFocusAndAstigmatism:AODBestFocusAndAstigmatismDTOItem}">
                            <Border Height="400" Style="{StaticResource BorderRegion}">
                                <darkField:BestFocusUserControl Grid.Row="1" DataContext="{Binding BestFocus}" />
                            </Border>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>