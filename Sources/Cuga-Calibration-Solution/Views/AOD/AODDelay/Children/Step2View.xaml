<UserControl x:Class="CugaCalibration.Views.AOD.AODDelay.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AOD"
             xmlns:aodDelay="clr-namespace:Core.Models.Models.AOD.AODDelay;assembly=Core.Models"
             xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
             xmlns:helper="clr-namespace:Core.Models.Helper;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:AODDelayViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1920"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser AOD Delay Step 3: "
                           Status="{Binding CalibrationStepList[1].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position(um): "
                           Status="{Binding Cache.Item.FindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <tools:CibGrabModeTypeUserControl DataContext="{Binding Cache.Item.CIBConfiguration}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Wait Time(s): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.WaitTime}" />
                    <hc:NumericUpDown hc:TitleElement.Title="PMT Data Count: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.PMTDataCount}" />
                    <hc:ComboBox hc:TitleElement.Title="Laser Light Information: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 SelectedItem="{Binding Cache.Item.LaserLightInformation}"
                                 Style="{StaticResource ComboBoxExtend}"
                                 ItemsSource="{Binding ApplicationCookie.LaserLightInformations}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox hc:TitleElement.Title="PMT Id: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 SelectedItem="{Binding Cache.Item.PMTId}"
                                 Style="{StaticResource ComboBoxExtend}"
                                 ItemsSource="{x:Static helper:CalibrationConstantsHelper.PmtIds}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox hc:TitleElement.Title="Channel Id: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 SelectedItem="{Binding Cache.Item.ChannelId}"
                                 Style="{StaticResource ComboBoxExtend}"
                                 ItemsSource="{x:Static helper:CalibrationConstantsHelper.ChannelIds}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <Separator />
                    <hc:NumericUpDown hc:TitleElement.Title="Rough Start AOD Delay(sa): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.RoughStartAODDelay}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Rough Step AOD Delay(sa): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.RoughStepAODDelay}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Rough Stop AOD Delay(sa): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.RoughStopAODDelay}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Refined AOD Delay ±Range(sa): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.RefinedRangeAODDelay}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Refined Step AOD Delay(sa): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.RefinedStepAODDelay}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding Calibratings}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectedCalibratingItem, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Productivity" DisplayMemberBinding="{Binding ProductivityInformation}" />
                            <GridViewColumn Header="AOD Delay(sa)" DisplayMemberBinding="{Binding RefinedAODDelay, StringFormat='0.###'}" />
                            <GridViewColumn Header="Prescan AOD Delay(sa)" DisplayMemberBinding="{Binding RefinedPrescanAODDelay, StringFormat='0.###'}" />
                            <GridViewColumn Header="Chirp AOD Delay(sa)" DisplayMemberBinding="{Binding RefinedChirpAODDelay, StringFormat='0.###'}" />
                            <GridViewColumn Header="Average PMT Data" DisplayMemberBinding="{Binding AveragePmtData, StringFormat='0.###'}" />
                            <GridViewColumn Header="PMT Data">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type aodDelay:AODDelayDto}">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                                          Margin="0,2"
                                                          HorizontalAlignment="Left"
                                                          hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                            <Popup Width="600"
                                                   Height="600"
                                                   StaysOpen="False"
                                                   PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                                                   Placement="Right"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Slide"
                                                   IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}">
                                                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                                    <wpf:WpfPlot>
                                                        <i:Interaction.Behaviors>
                                                            <behaviors:WpfPlotMultiBehavior Title="PMT Data(Y: - X: -)" Plot0="{Binding PmtData, Converter={StaticResource DoublesToPointsConverter}}" />
                                                        </i:Interaction.Behaviors>
                                                    </wpf:WpfPlot>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Border Grid.Row="2"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot>
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="AOD Delay(Y: - X: sa)" Plot0="{Binding CalibratingPoints}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </Grid>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>