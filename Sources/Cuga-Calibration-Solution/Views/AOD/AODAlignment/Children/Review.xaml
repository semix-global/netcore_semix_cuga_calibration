<UserControl x:Class="CugaCalibration.Views.AOD.AODAlignment.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AOD"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:mmd="clr-namespace:Core.Models.Models.AOD.AODAlignment;assembly=Core.Models"
             xmlns:ui="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
             xmlns:controls="clr-namespace:Net.Utilities.ScottPlot.WPF.WPF.Controls;assembly=Net.Utilities.ScottPlot.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:AODAlignmentViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="AOD Alignment: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown hc:TitleElement.Title="Threshold: "
                                      hc:TitleElement.TitleWidth="190"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Threshold}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Verify"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="Calibration Data">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding Reviews}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                        <wpf:ListBoxSelectedItemsBehavior Type="{x:Type mmd:AODAlignmentDto}" BindableSelectedItems="{Binding SelectedReviewItems}" />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Productivity Information" DisplayMemberBinding="{Binding ProductivityInformation}" />
                            <GridViewColumn Header="Slope" DisplayMemberBinding="{Binding Slope, StringFormat='0.###'}" />
                            <GridViewColumn Header="Intercept" DisplayMemberBinding="{Binding Intercept, StringFormat='0.###'}" />
                            <GridViewColumn Header="RSquared" DisplayMemberBinding="{Binding RSquared, StringFormat='0.###'}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <TabControl ItemsSource="{Binding SelectedReviewItems}" SelectedIndex="0">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProductivityInformation}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type mmd:AODAlignmentDto}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ScatterMultiPlotControl Title="Result"
                                                                      ScatterLine0Title="Origin"
                                                                      ScatterLine0Points="{Binding ItemPoints}"
                                                                      ScatterLine1Title="Fit"
                                                                      ScatterLine1Points="{Binding ItemFitPoints}" />
                                    <Border Grid.Column="1"
                                            Style="{StaticResource BorderRegion}"
                                            Effect="{StaticResource EffectShadow1}">
                                        <ui:PrescanAODWaveformProfilesUserControl DataContext="{Binding PrescanAODWaveformProfiles}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Border>
            </Grid>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>