<UserControl x:Class="CugaCalibration.Views.AOD.AODAlignment.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AOD"
             xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
             xmlns:helper="clr-namespace:Core.Models.Helper;assembly=Core.Models"
             xmlns:generates="clr-namespace:Core.Models.Models.Common.AODWaveform.UI.Generates;assembly=Core.Models"
             xmlns:ui="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
             xmlns:aodAlignment="clr-namespace:Core.Models.Models.AOD.AODAlignment;assembly=Core.Models"
             xmlns:controls="clr-namespace:Net.Utilities.ScottPlot.WPF.WPF.Controls;assembly=Net.Utilities.ScottPlot.WPF"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:AODAlignmentViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1920"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="AOD Alignment Step 3: "
                           Status="{Binding CalibrationStepList[1].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="BF Machine Position(um): "
                           Status="{Binding Cache.Item.FindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <Expander Header="CIB Configuration Param"
                              IsExpanded="False"
                              ExpandDirection="Down">
                        <tools:CibGrabModeTypeUserControl DataContext="{Binding Cache.Item.CIBConfiguration}" />
                    </Expander>
                    <hc:ComboBox hc:TitleElement.Title="Laser Light Information: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 SelectedItem="{Binding Cache.Item.LaserLightInformation}"
                                 Style="{StaticResource ComboBoxExtend}"
                                 ItemsSource="{Binding ApplicationCookie.LaserLightInformations}" />
                    <hc:ComboBox hc:TitleElement.Title="PMT Id: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 SelectedItem="{Binding Cache.Item.PMTId}"
                                 Style="{StaticResource ComboBoxExtend}"
                                 ItemsSource="{x:Static helper:CalibrationConstantsHelper.PmtIds}" />
                    <hc:ComboBox hc:TitleElement.Title="Channel Id: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 SelectedItem="{Binding Cache.Item.ChannelId}"
                                 Style="{StaticResource ComboBoxExtend}"
                                 ItemsSource="{x:Static helper:CalibrationConstantsHelper.ChannelIds}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Image Width(px): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.ImageWidth}" />
                    <Expander Header="Generate Prescan AOD Waveform Param"
                              IsExpanded="False"
                              ExpandDirection="Down">
                        <Border Style="{StaticResource BorderRegion}">
                            <generates:GeneratePrescanAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                  IsVisibleDirectoryPath="False"
                                                                                  DataContext="{Binding Cache.Item.GeneratePrescanAODWaveformParam}" />
                        </Border>
                    </Expander>
                    <hc:NumericUpDown hc:TitleElement.Title="Start Prescan Frequency(MHz): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.StartPrescanFrequency}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Step Prescan Frequency(MHz): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.StepPrescanFrequency}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Stop Prescan Frequency(MHz): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.StopPrescanFrequency}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding CalibratingItem.Items}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Frequency(MHz)" DisplayMemberBinding="{Binding PrescanFrequency, StringFormat='0.###'}" />
                            <GridViewColumn Header="Max Pixel" DisplayMemberBinding="{Binding ImageProjectionYsMaxPixel}" />
                            <GridViewColumn Header="Profiles">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type aodAlignment:AODAlignmentItemDto}">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                                          Content="Profiles"
                                                          Margin="0,2"
                                                          HorizontalAlignment="Left"
                                                          hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                            <Popup Width="800"
                                                   Height="800"
                                                   StaysOpen="False"
                                                   PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                                                   Placement="Right"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Slide"
                                                   IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}">
                                                <TabControl>
                                                    <TabItem Header="Prescan AOD Waveform Profiles">
                                                        <ui:PrescanAODWaveformProfilesUserControl DataContext="{Binding PrescanAODWaveformProfiles}" />
                                                    </TabItem>
                                                    <TabItem Header="Image Projection">
                                                        <controls:ScatterMultiPlotControl ScatterLine0Points="{Binding ImageProjectionYs, Converter={StaticResource DoublesToPointsConverter}}" />
                                                    </TabItem>
                                                    <TabItem Header="Image Projection">
                                                        <view:CanvasView AxisColor="Red"
                                                                         BackgroundColor="#0A0A0A"
                                                                         BackgroundImage="{Binding ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                         Interactive="True"
                                                                         ShowAxes="True"
                                                                         ShowCursor="False"
                                                                         ShowGrid="False" />
                                                    </TabItem>
                                                </TabControl>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:ScatterMultiPlotControl Title="Result"
                                                          ScatterLine0Title="Origin"
                                                          ScatterLine0Points="{Binding CalibratingItem.ItemPoints}"
                                                          ScatterLine1Title="Fit"
                                                          ScatterLine1Points="{Binding CalibratingItem.ItemFitPoints}" />
                        <Border Grid.Column="1"
                                Style="{StaticResource BorderRegion}"
                                Effect="{StaticResource EffectShadow1}">
                            <ui:PrescanAODWaveformProfilesUserControl DataContext="{Binding CalibratingItem.PrescanAODWaveformProfiles}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>