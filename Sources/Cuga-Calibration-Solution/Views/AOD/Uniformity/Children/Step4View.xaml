<UserControl x:Class="CugaCalibration.Views.AOD.Uniformity.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AOD"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:uniformity="clr-namespace:Core.Models.Models.AOD.Uniformity;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:AODUniformityViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Step 5: "
                           Status="{Binding CalibrationSteps[4].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Laser Light: "
                           Status="{Binding Cache.LaserLightInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.Item.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Haze BF Machine Position(um): "
                           Status="{Binding Cache.Item.HazeFindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Width(px): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="200"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.ImageWidth}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Prescan Segment Count: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="200"
                                          Minimum="4"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.PrescanAODWaveformProfileSegmentCount}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Image Segment Count: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="200"
                                          Minimum="4"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.ImageHorizontalProjectsSegmentCount}" />
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultSuccess}" />
                        </StackPanel>
                        <TextBox Text="{Binding CalibratingItem.IsReverse, Mode=OneWay}"
                                 hc:TitleElement.Title="Is Reverse: "
                                 hc:TitleElement.TitleWidth="200"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step4Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step4CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <TabControl>
                <TabItem Header="IsReverse Plots">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <ContentControl Content="{Binding CalibratingItem.IsReverseScatterPlotControl, Mode=OneWay}" />
                    </Border>
                </TabItem>
                <TabItem Header="Mapping Plots">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <ContentControl Content="{Binding CalibratingItem.MappingScatterPlotControl, Mode=OneWay}" />
                    </Border>
                </TabItem>
                <TabItem Header="Mapping Details">
                    <ListView Style="{StaticResource ListView.Small}" ItemsSource="{Binding CalibratingItem.Mappings}">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNotLinearSpline}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ImageHorizontalProjectIndex" DisplayMemberBinding="{Binding ImageHorizontalProjectIndex}" />
                                <GridViewColumn Header="LinearSplinePrescanAODWaveformProfileIndex" DisplayMemberBinding="{Binding LinearSplineMappingIndex, StringFormat='0.###'}" />
                                <GridViewColumn Header="PrescanAODWaveformProfileIndex" DisplayMemberBinding="{Binding MappingIndex}" />
                                <GridViewColumn Header="PrescanAODWaveformProfileIndices">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type uniformity:AODUniformityDTO+Mapping}">
                                            <TextBlock Text="{Binding MappingIndices, Converter={StaticResource IntsToStringConverter}}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</UserControl>