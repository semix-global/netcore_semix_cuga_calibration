<hc:Window x:Class="CugaCalibration.Views.LoginWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF.behaviors"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:passwordBoxBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.PasswordBoxBehaviors;assembly=Net.Utilities.WPF.Behaviors"
           Title="{Binding Title, Mode=OneWay}"
           Width="500" Height="400"
           d:DataContext="{d:DesignInstance Type=viewModels:LoginWindowViewModel}"
           Topmost="True"
           WindowStyle="None"
           ResizeMode="NoResize"
           BorderThickness="2"
           WindowStartupLocation="CenterScreen"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Title, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <Grid Margin="30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="1"
                           Text="Sign In"
                           HorizontalAlignment="Center"
                           FontSize="30"
                           Foreground="#3099c5" />
                <TextBlock Grid.Row="2"
                           Text="Please enter your username and password"
                           Margin="0,10"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           Foreground="#bdbdbd" />
                <ComboBox Grid.Row="4"
                          Text="{Binding SysUserDTO.UserName, UpdateSourceTrigger=PropertyChanged}"
                          Height="35"
                          Margin="30,10"
                          hc:InfoElement.Placeholder="Name"
                          IsEditable="True"
                          ItemsSource="{Binding UserNames}"
                          Style="{StaticResource ComboBoxExtend}" />
                <PasswordBox Grid.Row="5"
                             Height="35"
                             Margin="30,10"
                             hc:InfoElement.Placeholder="Password"
                             Style="{StaticResource PasswordBoxExtend}">
                    <i:Interaction.Behaviors>
                        <passwordBoxBehaviors:PasswordBoxBindingSupportBehavior Password="{Binding SysUserDTO.Password}" />
                    </i:Interaction.Behaviors>
                </PasswordBox>
                <Button Grid.Row="6"
                        Content="Login"
                        Command="{Binding LoginCommand}"
                        Width="200"
                        Height="50"
                        Margin="0,30"
                        HorizontalAlignment="Center"
                        Style="{StaticResource ButtonWarning.Loading}" />
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>