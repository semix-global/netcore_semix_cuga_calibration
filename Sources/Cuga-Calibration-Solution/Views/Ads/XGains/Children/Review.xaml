<UserControl x:Class="CugaCalibration.Views.Ads.XGains.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Ads"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
             d:DataContext="{d:DesignInstance Type=viewModels:AdsXGainsCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Ads X Gains: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="ThresholdNumeric"
                                      Width="275"
                                      hc:TitleElement.Title="Threshold: "
                                      hc:TitleElement.TitleWidth="90"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyThreshold}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="Data">
                <Grid>
                    <DataGrid x:Name="HistoryDataGrid"
                              hc:DataGridAttach.ShowRowNumber="True"
                              d:SelectedIndex="0"
                              RowHeaderWidth="60"
                              HeadersVisibility="All"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding ReviewDTO.VerifyItems}"
                              Style="{StaticResource DataGrid.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:DataGridScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.ColumnHeaderStyle>
                            <Style BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}" TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style BasedOn="{StaticResource DataGridCellStyle.Small}" TargetType="DataGridCell">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource DataGridRowStyle.Small}" TargetType="DataGridRow">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="120"
                                                Header="SpeedXValue"
                                                Binding="{Binding SpeedXValue, StringFormat={}{0:f3}}" />
                            <DataGridTemplateColumn Width="100" Header="X1/X3">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding X1OrX3}" Width="30" />
                                            <Path>
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Width" Value="15" />
                                                        <Setter Property="Height" Value="15" />
                                                        <Setter Property="Stretch" Value="Uniform" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Data" Value="{StaticResource DownArrowGeometry}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpwardZ1OrZ3}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource UpArrowGeometry}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource DefaultBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100" Header="X2/X4">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding X2OrX4}" Width="30" />
                                            <Path>
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Width" Value="15" />
                                                        <Setter Property="Height" Value="15" />
                                                        <Setter Property="Stretch" Value="Uniform" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Data" Value="{StaticResource DownArrowGeometry}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpwardZ2OrZ4}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource UpArrowGeometry}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource DefaultBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="100"
                                                Header="H"
                                                Binding="{Binding H, StringFormat={}{0:f3}}" />
                            <DataGridTextColumn Width="100"
                                                Header="P"
                                                Binding="{Binding P, StringFormat={}{0:f3}}" />
                            <DataGridTextColumn Width="100"
                                                Header="R"
                                                Binding="{Binding R, StringFormat={}{0:f3}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Row="1" />
            <GroupBox Grid.Row="2" Header="Plot">
                <TabControl>
                    <TabItem Header="Z Plot">
                        <v2:PlotControl Margin="5" DataSource="{Binding SelectedItem.ZPlotDataSource, ElementName=HistoryDataGrid}" />
                    </TabItem>
                    <TabItem Header="HRP Plot">
                        <v2:PlotControl Margin="5" DataSource="{Binding SelectedItem.HrpPlotDataSource, ElementName=HistoryDataGrid}" />
                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>