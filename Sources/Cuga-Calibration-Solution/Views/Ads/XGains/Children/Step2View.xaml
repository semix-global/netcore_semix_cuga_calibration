<UserControl x:Class="CugaCalibration.Views.Ads.XGains.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Ads"
             xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:AdsXGainsCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Start Position: "
                           Status="{Binding Cache.StartPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="End Position: "
                           Status="{Binding Cache.EndPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <StackPanel>
                                <TextBlock Text="1. Find"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <TextBox Text="{Binding Calibrating.X1P0}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X1P0: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X1P1}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X1P1: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X1P2}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X1P2: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X2P0}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X2P0: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X2P1}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X2P1: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X2P2}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X2P2: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <StackPanel>
                                <TextBlock Text="2. Find"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <TextBox Text="{Binding Calibrating.X3P0}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X3P0: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X3P1}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X3P1: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X3P2}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X3P2: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X4P0}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X4P0: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X4P1}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X4P1: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Calibrating.X4P2}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="X4P2: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step2Command}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step2CancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <TabControl Grid.Column="2">
            <TabItem Header="Positive Plot">
                <GroupBox Header="Plot">
                    <Grid>
                        <v2:PlotControl Margin="5" DataSource="{Binding Calibrating.X1X2PlotDataSource}" />
                    </Grid>
                </GroupBox>
            </TabItem>
            <TabItem Header="Negative Plot">
                <GroupBox Header="Plot">
                    <Grid>
                        <v2:PlotControl Margin="5" DataSource="{Binding Calibrating.X3X4PlotDataSource}" />
                    </Grid>
                </GroupBox>
            </TabItem>
        </TabControl>
        <!--#endregion-->
    </Grid>
</UserControl>