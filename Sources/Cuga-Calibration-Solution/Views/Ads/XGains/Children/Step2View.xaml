<UserControl x:Class="CugaCalibration.Views.Ads.XGains.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Ads"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:AdsXGainsCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Color="{StaticResource InfoBrush}">
                    <hc:Shield.Style>
                        <Style BasedOn="{StaticResource ShieldBaseStyle}" TargetType="hc:Shield">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="2">
                                    <Setter Property="Subject" Value="Ads X Gains Step 3:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[2].StepName}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="4">
                                    <Setter Property="Subject" Value="Ads X Gains Step 5:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[4].StepName}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:Shield.Style>
                </hc:Shield>
                <hc:Shield Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}"
                           DockPanel.Dock="Bottom"
                           Subject="Start Position: "
                           Status="{Binding Cache.PositiveStartPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}"
                           DockPanel.Dock="Bottom"
                           Subject="End Position: "
                           Status="{Binding Cache.PositiveEndPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolNegationToVisibilityConverter}}"
                           DockPanel.Dock="Bottom"
                           Subject="Start Position: "
                           Status="{Binding Cache.NegativeStartPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolNegationToVisibilityConverter}}"
                           DockPanel.Dock="Bottom"
                           Subject="End Position: "
                           Status="{Binding Cache.NegativeEndPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:NumericUpDown x:Name="IntervalNumeric"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:InfoElement.Title="X1Interval: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="10000000"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.FindInterval1}" />
                        <hc:NumericUpDown x:Name="IntervalNumeric1"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:InfoElement.Title="X2Interval: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="10000000"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.FindInterval2}" />
                        <hc:NumericUpDown x:Name="RowNumber"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:InfoElement.Title="X1Number: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Row Number"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="10000000"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.RowNumber}" />
                        <hc:NumericUpDown x:Name="ColumnNumber"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:InfoElement.Title="X2Number: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Column Number"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="10000000"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ColumnNumber}" />
                        <hc:NumericUpDown x:Name="ThresholdNumber"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:InfoElement.Title="Threshold: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="10000000"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.VerifyThreshold}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <Border Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}"
                            Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <StackPanel>
                                <TextBlock Text="2. Find"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.PositiveX1P1}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X1P0: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.PositiveX1P2}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X1P1: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.PositiveX1P3}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X1P2: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.PositiveX2P1}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X2P0: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.PositiveX2P2}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X2P1: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.PositiveX2P3}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X2P2: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}"
                            Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <StackPanel>
                                <TextBlock Text="2. Find"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.NegativeX3P1}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X3P0: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.NegativeX3P2}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X3P1: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.NegativeX3P3}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X3P2: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.NegativeX4P1}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X4P0: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.NegativeX4P2}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X4P1: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultAdsXGainsItemDto.NegativeX4P3}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="X4P2: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="History">
                <Grid>
                    <ListView d:SelectedIndex="0"
                              Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}"
                              ItemsSource="{Binding AdsXGainsHrpCacheItemList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectAdsXGainsItemDto, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="80"
                                                Header="Index"
                                                DisplayMemberBinding="{Binding Index}" />
                                <GridViewColumn Width="100"
                                                Header="SpeedXValue"
                                                DisplayMemberBinding="{Binding SpeedXValue, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="X1"
                                                DisplayMemberBinding="{Binding PositiveX1, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="X2"
                                                DisplayMemberBinding="{Binding PositiveX2, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="H"
                                                DisplayMemberBinding="{Binding PositiveH, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="R"
                                                DisplayMemberBinding="{Binding PositiveR, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="P"
                                                DisplayMemberBinding="{Binding PositiveP, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100" Header="Action Review">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:ButtonGroup>
                                                <Button Content="PlotHRP"
                                                        Command="{Binding Path=DataContext.ShowPlotHRPCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ButtonSuccess}" />
                                            </hc:ButtonGroup>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListView d:SelectedIndex="0"
                              Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolNegationToVisibilityConverter}}"
                              ItemsSource="{Binding AdsXGainsHrpCacheItemList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="80"
                                                Header="Index"
                                                DisplayMemberBinding="{Binding Index}" />
                                <GridViewColumn Width="100"
                                                Header="SpeedXValue"
                                                DisplayMemberBinding="{Binding SpeedXValue, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="X3"
                                                DisplayMemberBinding="{Binding NegativeX3, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="X4"
                                                DisplayMemberBinding="{Binding NegativeX4, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="H"
                                                DisplayMemberBinding="{Binding NegativeH, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="R"
                                                DisplayMemberBinding="{Binding NegativeR, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="P"
                                                DisplayMemberBinding="{Binding NegativeP, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100" Header="Action Review">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:ButtonGroup>
                                                <Button Content="PlotHRP"
                                                        Command="{Binding Path=DataContext.ShowPlotHRPCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ButtonSuccess}" />
                                            </hc:ButtonGroup>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Row="1" />
            <GroupBox Grid.Row="2" Header="Plot">
                <Grid>
                    <wpf:WpfPlot Margin="5" Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="PositiveFeedforwardPlot"
                                                            Plot0Title="X1"
                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                            Plot0="{Binding ResultAdsXGainsItemDto.PositiveX1Plots}"
                                                            Plot1Title="SmoothX1"
                                                            Plot1Color="{x:Static scottPlot:Colors.Red}"
                                                            Plot1="{Binding ResultAdsXGainsItemDto.PositiveX1SmoothPlots}"
                                                            Plot2Title="X2"
                                                            Plot2Color="{x:Static scottPlot:Colors.DarkGreen}"
                                                            Plot2="{Binding ResultAdsXGainsItemDto.PositiveX2Plots}"
                                                            Plot3Title="SmoothX2"
                                                            Plot3Color="{x:Static scottPlot:Colors.DarkRed}"
                                                            Plot3="{Binding ResultAdsXGainsItemDto.PositiveX2SmoothPlots}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                    <wpf:WpfPlot Margin="5" Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="NegativeFeedforwardPlot"
                                                            Plot0Title="X3"
                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                            Plot0="{Binding ResultAdsXGainsItemDto.NegativeX3Plots}"
                                                            Plot1Title="SmoothX3"
                                                            Plot1Color="{x:Static scottPlot:Colors.Red}"
                                                            Plot1="{Binding ResultAdsXGainsItemDto.NegativeX3SmoothPlots}"
                                                            Plot2Title="X4"
                                                            Plot2Color="{x:Static scottPlot:Colors.DarkGreen}"
                                                            Plot2="{Binding ResultAdsXGainsItemDto.NegativeX4Plots}"
                                                            Plot3Title="SmoothX4"
                                                            Plot3Color="{x:Static scottPlot:Colors.DarkRed}"
                                                            Plot3="{Binding ResultAdsXGainsItemDto.NegativeX4SmoothPlots}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Grid>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>