<UserControl x:Class="CugaCalibration.Views.Ads.YGains.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Ads"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:AdsYGainsCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Ads Y Gains Step 1: "
                           Status="{Binding CalibrationSteps[0].StepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Find Positive Position"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding Cache.PositiveStartPosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="275"
                                 hc:InfoElement.Title="Start Position(um): "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:ButtonGroup Width="275">
                            <Button x:Name="PositiveStartGetButton"
                                    Content="Get"
                                    Command="{Binding GetPointCommand}"
                                    CommandParameter="PositiveStartPosition" />
                            <Button x:Name="PositiveStartGotoButton"
                                    Content="Goto"
                                    Command="{Binding GotoPointCommand}"
                                    CommandParameter="PositiveStartPosition" />
                        </hc:ButtonGroup>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding Cache.PositiveEndPosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="275"
                                 hc:InfoElement.Title="End Position(um): "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:ButtonGroup Width="275">
                            <Button x:Name="PositiveEndGetButton"
                                    Content="Get"
                                    Command="{Binding GetPointCommand}"
                                    CommandParameter="PositiveEndPosition" />
                            <Button x:Name="PositiveEndGotoButton"
                                    Content="Goto"
                                    Command="{Binding GotoPointCommand}"
                                    CommandParameter="PositiveEndPosition" />
                        </hc:ButtonGroup>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="2. Find Negative Position"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding Cache.NegativeStartPosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="275"
                                 hc:InfoElement.Title="Start Position(um): "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:ButtonGroup Width="275">
                            <Button x:Name="NegativeStartGetButton"
                                    Content="Get"
                                    Command="{Binding GetPointCommand}"
                                    CommandParameter="NegativeStartPosition" />
                            <Button x:Name="NegativeStartGotoButton"
                                    Content="Goto"
                                    Command="{Binding GotoPointCommand}"
                                    CommandParameter="NegativeStartPosition" />
                        </hc:ButtonGroup>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding Cache.NegativeEndPosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="275"
                                 hc:InfoElement.Title="End Position(um): "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:ButtonGroup Width="275">
                            <Button x:Name="NegativeEndGetButton"
                                    Content="Get"
                                    Command="{Binding GetPointCommand}"
                                    CommandParameter="NegativeEndPosition" />
                            <Button x:Name="NegativeEndGotoButton"
                                    Content="Goto"
                                    Command="{Binding GotoPointCommand}"
                                    CommandParameter="NegativeEndPosition" />
                        </hc:ButtonGroup>
                    </hc:UniformSpacingPanel>

                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step0CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step0CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
    </Grid>
</UserControl>