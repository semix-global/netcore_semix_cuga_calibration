<UserControl x:Class="CugaCalibration.Views.Ads.YGains.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Ads"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:AdsYGainsCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />

                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Start Position: "
                           Status="{Binding Cache.StartPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="End Position: "
                           Status="{Binding Cache.EndPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding Cache.YSpeeds, Converter={StaticResource DoublesToStringConverter}}"
                                 Width="275"
                                 hc:TitleElement.TitleWidth="90"
                                 hc:TitleElement.Title="Speed List: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:NumericUpDown x:Name="MaxValueNumeric1"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:TitleElement.Title="Max Y: "
                                          hc:InfoElement.Necessary="True"
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input y value"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="300"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.FindMaxY}" />
                        <hc:NumericUpDown x:Name="MinValueNumeric1"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:TitleElement.Title="Min Y: "
                                          hc:InfoElement.Necessary="True"
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input y value"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0"
                                          Maximum="150"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.FindMinY}" />

                        <hc:NumericUpDown x:Name="ThresholdNumeric"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:TitleElement.Title="Threshold: "
                                          hc:InfoElement.Necessary="True"
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Threshold"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0"
                                          Maximum="10000000"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Threshold}" />
                        <hc:NumericUpDown x:Name="WaitTimeNumeric"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:TitleElement.Title="Wait Time(s): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Wait Time"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.WaitTime}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Spacing="10">
                    <Button x:Name="ActionButton"
                            Content="Action"
                            Command="{Binding Step1Command}"
                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                            Style="{StaticResource ButtonPrimary.Loading}" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Command="{Binding Step1CancelCommand}"
                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                            Style="{StaticResource ButtonWarning}" />
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="History">
                <Grid>
                    <DataGrid x:Name="HistoryDataGrid"
                              hc:DataGridAttach.ShowRowNumber="True"
                              d:SelectedIndex="0"
                              RowHeaderWidth="60"
                              HeadersVisibility="All"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource DataGrid.Small}"
                              ItemsSource="{Binding Calibrating.CalibrateItems}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:DataGridScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <DataGrid.ColumnHeaderStyle>
                            <Style BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}" TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style BasedOn="{StaticResource DataGridCellStyle.Small}" TargetType="DataGridCell">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource DataGridRowStyle.Small}" TargetType="DataGridRow">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="120"
                                                Header="SpeedYValue"
                                                Binding="{Binding SpeedYValue, StringFormat={}{0:f3}}" />
                            <DataGridTemplateColumn Width="100" Header="Y1/Y4">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Y1OrY4}" Width="30" />
                                            <Path>
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Width" Value="15" />
                                                        <Setter Property="Height" Value="15" />
                                                        <Setter Property="Stretch" Value="Uniform" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Data" Value="{StaticResource DownArrowGeometry}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpwardZ1OrZ4}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource UpArrowGeometry}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource DefaultBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100" Header="Y2/Y5">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Y2OrY5}" Width="30" />
                                            <Path>
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Width" Value="15" />
                                                        <Setter Property="Height" Value="15" />
                                                        <Setter Property="Stretch" Value="Uniform" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Data" Value="{StaticResource DownArrowGeometry}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpwardZ2OrZ5}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource UpArrowGeometry}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource DefaultBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100" Header="Y3/Y6">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Y3OrY6}" Width="30" />
                                            <Path>
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Width" Value="15" />
                                                        <Setter Property="Height" Value="15" />
                                                        <Setter Property="Stretch" Value="Uniform" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Data" Value="{StaticResource DownArrowGeometry}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpwardZ3OrZ6}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource UpArrowGeometry}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource DefaultBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="100"
                                                Header="H"
                                                Binding="{Binding H, StringFormat={}{0:f3}}" />
                            <DataGridTextColumn Width="100"
                                                Header="P"
                                                Binding="{Binding P, StringFormat={}{0:f3}}" />
                            <DataGridTextColumn Width="100"
                                                Header="R"
                                                Binding="{Binding R, StringFormat={}{0:f3}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Row="1" />
            <GroupBox Grid.Row="2" Header="Plot">
                <TabControl>
                    <TabItem Header="Z Plot">
                        <v2:PlotControl Margin="5" DataSource="{Binding SelectedItem.ZPlotDataSource, ElementName=HistoryDataGrid}" />
                    </TabItem>
                    <TabItem Header="HRP Plot">
                        <v2:PlotControl Margin="5" DataSource="{Binding SelectedItem.HrpPlotDataSource, ElementName=HistoryDataGrid}" />
                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>