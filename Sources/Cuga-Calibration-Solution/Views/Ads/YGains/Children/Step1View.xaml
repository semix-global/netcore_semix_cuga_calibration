<UserControl x:Class="CugaCalibration.Views.Ads.YGains.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Ads"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:AdsYGainsCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Color="{StaticResource InfoBrush}">
                    <hc:Shield.Style>
                        <Style BasedOn="{StaticResource ShieldBaseStyle}" TargetType="hc:Shield">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="1">
                                    <Setter Property="Subject" Value="Ads Y Gains Step 2:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[1].StepName}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:Shield.Style>
                </hc:Shield>

                <hc:Shield Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}"
                           DockPanel.Dock="Bottom"
                           Subject="Start Position: "
                           Status="{Binding Cache.PositiveStartPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}"
                           DockPanel.Dock="Bottom"
                           Subject="End Position: "
                           Status="{Binding Cache.PositiveEndPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}"
                           DockPanel.Dock="Bottom"
                           Subject="Start Position: "
                           Status="{Binding Cache.NegativeStartPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}"
                           DockPanel.Dock="Bottom"
                           Subject="End Position: "
                           Status="{Binding Cache.NegativeEndPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding Cache.SpeedYValueList, Converter={StaticResource ListToStringConverter}}"
                                 Width="275"
                                 hc:TitleElement.TitleWidth="90"
                                 hc:InfoElement.Title="Speed List: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:NumericUpDown x:Name="MaxValueNumeric1"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:InfoElement.Title="Max Y: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input x value"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="300"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.FindMaxY}" />
                        <hc:NumericUpDown x:Name="MinValueNumeric1"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:InfoElement.Title="Min Y: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input x value"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0"
                                          Maximum="150"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.FindMinY}" />
                        <hc:NumericUpDown x:Name="speedYvalue"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="120"
                                          hc:InfoElement.Title="Default Speed: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input DefaultSpeed"
                                          hc:InfoElement.ShowClearButton="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.DefaultSpeedYValue}" />
                        <hc:NumericUpDown x:Name="ThresholdNumeric"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="90"
                                          hc:InfoElement.Title="Threshold: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Threshold"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0"
                                          Maximum="10000000"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Threshold}" />
                        <hc:NumericUpDown x:Name="WaitTimeNumeric"
                                          Width="275"
                                          hc:TitleElement.TitleWidth="110"
                                          hc:InfoElement.Title="Wait Time(s): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Wait Time"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.WaitTime}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Spacing="10">
                    <Button x:Name="ActionButton"
                            Content="Action"
                            Command="{Binding Step1CalibrateActionCommand}"
                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                            Style="{StaticResource ButtonPrimary.Loading}" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Command="{Binding Step1CalibrateActionCancelCommand}"
                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                            Style="{StaticResource ButtonWarning}" />
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="History">
                <Grid>
                    <ListView d:SelectedIndex="0"
                              Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}"
                              ItemsSource="{Binding AdsYGainsCacheItemList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectAdsYGainsCacheItem, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="80"
                                                Header="Index"
                                                DisplayMemberBinding="{Binding Index}" />
                                <GridViewColumn Width="80"
                                                Header="Speed"
                                                DisplayMemberBinding="{Binding SpeedYValue, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Y1"
                                                DisplayMemberBinding="{Binding PositiveY1, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Y2"
                                                DisplayMemberBinding="{Binding PositiveY2, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Y3"
                                                DisplayMemberBinding="{Binding PositiveY3, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MaxZ1"
                                                DisplayMemberBinding="{Binding PositiveMaxZ1, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MinZ1"
                                                DisplayMemberBinding="{Binding PositiveMinZ1, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Z1"
                                                DisplayMemberBinding="{Binding PositiveZ1, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MaxZ2"
                                                DisplayMemberBinding="{Binding PositiveMaxZ2, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MinZ2"
                                                DisplayMemberBinding="{Binding PositiveMinZ2, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Z2"
                                                DisplayMemberBinding="{Binding PositiveZ2, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MaxZ3"
                                                DisplayMemberBinding="{Binding PositiveMaxZ3, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MinZ3"
                                                DisplayMemberBinding="{Binding PositiveMinZ3, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Z3"
                                                DisplayMemberBinding="{Binding PositiveZ3, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="H"
                                                DisplayMemberBinding="{Binding PositiveH, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="P"
                                                DisplayMemberBinding="{Binding PositiveP, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="R"
                                                DisplayMemberBinding="{Binding PositiveR, StringFormat={}{0:f3}}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="History">
                <Grid>
                    <ListView d:SelectedIndex="0"
                              Visibility="{Binding Cache.IsPositive, Converter={StaticResource BoolToVisibilityConverter}}"
                              ItemsSource="{Binding AdsYGainsCacheConverseItemList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectAdsYGainsCacheConverseItem, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="80"
                                                Header="Index"
                                                DisplayMemberBinding="{Binding Index}" />
                                <GridViewColumn Width="80"
                                                Header="Speed"
                                                DisplayMemberBinding="{Binding SpeedYValue, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Y4"
                                                DisplayMemberBinding="{Binding NegativeY4, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Y5"
                                                DisplayMemberBinding="{Binding NegativeY5, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Y6"
                                                DisplayMemberBinding="{Binding NegativeY6, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MaxZ4"
                                                DisplayMemberBinding="{Binding NegativeMaxZ4, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MinZ4"
                                                DisplayMemberBinding="{Binding NegativeMinZ4, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Z4"
                                                DisplayMemberBinding="{Binding NegativeZ4, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MaxZ5"
                                                DisplayMemberBinding="{Binding NegativeMaxZ5, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MinZ5"
                                                DisplayMemberBinding="{Binding NegativeMinZ5, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Z5"
                                                DisplayMemberBinding="{Binding NegativeZ5, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MaxZ6"
                                                DisplayMemberBinding="{Binding NegativeMaxZ6, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="MinZ6"
                                                DisplayMemberBinding="{Binding NegativeMinZ6, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="Z6"
                                                DisplayMemberBinding="{Binding NegativeZ6, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="H"
                                                DisplayMemberBinding="{Binding NegativeH, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="P"
                                                DisplayMemberBinding="{Binding NegativeP, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="R"
                                                DisplayMemberBinding="{Binding NegativeR, StringFormat={}{0:f3}}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Row="2" />
            <GroupBox Grid.Row="3" Header="Plot">
                <Grid>
                    <wpf:WpfPlot Margin="5">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotListBehavior Title="Plot" PlotList="{Binding PlotList, Mode=TwoWay}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Grid>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>