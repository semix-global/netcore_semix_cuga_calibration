<UserControl x:Class="CugaCalibration.Views.Ads.PressureGains.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Ads"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:AdsPressureGainsCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Ads Pressure Gains: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="ThresholdNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="Threshold: "
                                      hc:TitleElement.TitleWidth="90"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Threshold}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="Calibration Data">
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <UniformGrid Rows="3" Columns="1">
                    <UniformGrid.Resources>
                        <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                            <Setter Property="Margin" Value="5" />
                        </Style>
                    </UniformGrid.Resources>
                    <Border>
                        <TextBox Text="{Binding ReviewDto.PressureValue1, StringFormat={}{0:f3}}"
                                 Width="275"
                                 Height="25"
                                 hc:InfoElement.Title="Pressure Value 1: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                 Style="{StaticResource TextBoxExtend}" />
                    </Border>
                    <Border>
                        <TextBox Text="{Binding ReviewDto.PressureValue2, StringFormat={}{0:f3}}"
                                 Width="275"
                                 Height="25"
                                 hc:InfoElement.Title="Pressure Value 1: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                 Style="{StaticResource TextBoxExtend}" />
                    </Border>
                    <Border>
                        <TextBox Text="{Binding ReviewDto.PressureValue3, StringFormat={}{0:f3}}"
                                 Width="275"
                                 Height="25"
                                 hc:InfoElement.Title="Pressure Value 3: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                 Style="{StaticResource TextBoxExtend}" />
                    </Border>
                </UniformGrid>
            </Border>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>