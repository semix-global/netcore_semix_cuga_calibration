<UserControl x:Class="CugaCalibration.Views.Common.Windows.Diagnosis.Ads.Children.AdsCenterOfMassDiagnosisUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Diagnosis.AdsDiagonosis"
             d:DataContext="{d:DesignInstance Type=viewModels:AdsCenterOfMassDiagnosisViewModel}"
             d:DesignHeight="1600"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
                <i:InvokeCommandAction Command="{Binding LoadCommand}" />
            </i:EventTrigger>
        </i:Interaction.Triggers>
        <hc:UniformSpacingPanel Grid.Column="0"
                                Orientation="Vertical"
                                Spacing="10"
                                IsEnabled="{Binding IsEnableWindow}">
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsEnableWindow}">
                <hc:UniformSpacingPanel Orientation="Vertical" IsEnabled="{Binding IsEnableWindow}">
                    <hc:UniformSpacingPanel Margin="2"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                        <hc:SimpleText hc:Text="Axis:" hc:Width="70" />
                        <RadioButton Content="X"
                                     IsChecked="{Binding Cache.IsFindX}"
                                     Margin="0,0,5,0" />
                        <RadioButton Content="Y" IsChecked="{Binding Cache.IsFindX, Converter={StaticResource Boolean2BooleanReConverter}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockDefaultInfo}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.IsFindX}" Value="True">
                                            <Setter Property="Text" Value="Find X Axis Position" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.IsFindX}" Value="False">
                                            <Setter Property="Text" Value="Find Y Axis Position" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Width="275"
                                 hc:InfoElement.Title="Start Position(um): "
                                 hc:InfoElement.TitlePlacement="Left">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.IsFindX}" Value="True">
                                            <Setter Property="Text" Value="{Binding Cache.StartPositionFindX, Converter={StaticResource PointToStringConverter}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.IsFindX}" Value="False">
                                            <Setter Property="Text" Value="{Binding Cache.StartPositionFindY, Converter={StaticResource PointToStringConverter}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Width="275"
                                 hc:InfoElement.Title="End Position(um): "
                                 hc:InfoElement.TitlePlacement="Left">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.IsFindX}" Value="True">
                                            <Setter Property="Text" Value="{Binding Cache.EndPositionFindX, Converter={StaticResource PointToStringConverter}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.IsFindX}" Value="False">
                                            <Setter Property="Text" Value="{Binding Cache.EndPositionFindY, Converter={StaticResource PointToStringConverter}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <hc:NumericUpDown Width="275"
                                          hc:TitleElement.TitleWidth="110"
                                          hc:InfoElement.Title="Wait Time(s): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Wait Time"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.WaitTime}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>

        <GridSplitter Grid.Column="1" Width="10" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>

            <TabControl TabStripPlacement="Bottom">
                <TabItem Header="Find X Configure"
                         IsSelected="{Binding Cache.IsFindX}"
                         IsEnabled="{Binding IsEnableWindow}">
                    <GroupBox Header="Find X Configure">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding CenterOfMassDiagnosisList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedDiagnosisDtoItem, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="80" Header="IsSelect">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <hc:SimplePanel>
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              MinWidth="120"
                                                              IsEnabled="{Binding DataContext.IsEnableWindow, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </hc:SimplePanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="80"
                                                    Header="X Speed"
                                                    DisplayMemberBinding="{Binding Cache.YspeedValue}" />
                                    <GridViewColumn Width="80"
                                                    Header="Y1"
                                                    DisplayMemberBinding="{Binding Cache.YSpeedForwardValuePositiveY1}" />
                                    <GridViewColumn Width="80"
                                                    Header="Y2"
                                                    DisplayMemberBinding="{Binding Cache.YSpeedForwardValuePositiveY2}" />
                                    <GridViewColumn Width="80"
                                                    Header="Y3"
                                                    DisplayMemberBinding="{Binding Cache.YSpeedForwardValuePositiveY3}" />
                                    <GridViewColumn Width="80"
                                                    Header="Y4"
                                                    DisplayMemberBinding="{Binding Cache.YSpeedForwardValueNegativeY4}" />
                                    <GridViewColumn Width="80"
                                                    Header="Y5"
                                                    DisplayMemberBinding="{Binding Cache.YSpeedForwardValueNegativeY5}" />
                                    <GridViewColumn Width="80"
                                                    Header="Y6"
                                                    DisplayMemberBinding="{Binding Cache.YSpeedForwardValueNegativeY6}" />
                                    <GridViewColumn Width="80"
                                                    Header="FindCount"
                                                    DisplayMemberBinding="{Binding Cache.FindCountX}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
                <TabItem Header="Find Y Configure"
                         IsSelected="{Binding Cache.IsFindX, Converter={StaticResource Boolean2BooleanReConverter}}"
                         IsEnabled="{Binding IsEnableWindow}">
                    <GroupBox Header="Find Y Configure">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding CenterOfMassDiagnosisList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedDiagnosisDtoItem, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="80" Header="IsSelect">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <hc:SimplePanel>
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              MinWidth="120"
                                                              IsEnabled="{Binding DataContext.IsEnableWindow, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </hc:SimplePanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="80"
                                                    Header="X Speed"
                                                    DisplayMemberBinding="{Binding Cache.XspeedValue}" />
                                    <GridViewColumn Width="80"
                                                    Header="X1"
                                                    DisplayMemberBinding="{Binding Cache.XSpeedForwardValuePositiveX1}" />
                                    <GridViewColumn Width="80"
                                                    Header="X2"
                                                    DisplayMemberBinding="{Binding Cache.XSpeedForwardValuePositiveX2}" />
                                    <GridViewColumn Width="80"
                                                    Header="X3"
                                                    DisplayMemberBinding="{Binding Cache.XSpeedForwardValueNegativeX3}" />
                                    <GridViewColumn Width="80"
                                                    Header="X4"
                                                    DisplayMemberBinding="{Binding Cache.XSpeedForwardValueNegativeX4}" />
                                    <GridViewColumn Width="80"
                                                    Header="FindCount"
                                                    DisplayMemberBinding="{Binding Cache.FindCountY}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
            </TabControl>
            <TabControl Grid.Row="1" TabStripPlacement="Bottom">
                <TabItem Header="Diagnosis History">
                    <GroupBox Header="Diagnosis History">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding CenterOfMassItemDtoList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedItemDto, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCalibrated}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="60"
                                                    Header="Index"
                                                    DisplayMemberBinding="{Binding Index}" />
                                    <GridViewColumn Width="150"
                                                    Header="StartPosition"
                                                    DisplayMemberBinding="{Binding StartPosition, Converter={StaticResource PointToStringConverter}}" />
                                    <GridViewColumn Width="150"
                                                    Header="EndPosition"
                                                    DisplayMemberBinding="{Binding EndPosition, Converter={StaticResource PointToStringConverter}}" />
                                    <GridViewColumn Width="100"
                                                    Header="XErrorMin"
                                                    DisplayMemberBinding="{Binding XErrorMin, StringFormat=F4}" />
                                    <GridViewColumn Width="100"
                                                    Header="XErrorMax"
                                                    DisplayMemberBinding="{Binding XErrorMax, StringFormat=F4}" />
                                    <GridViewColumn Width="100"
                                                    Header="YErrorMin"
                                                    DisplayMemberBinding="{Binding YErrorMin, StringFormat=F4}" />
                                    <GridViewColumn Width="100"
                                                    Header="YErrorMax"
                                                    DisplayMemberBinding="{Binding YErrorMax, StringFormat=F4}" />
                                    <GridViewColumn Width="100"
                                                    Header="DeltaX"
                                                    DisplayMemberBinding="{Binding DeltaX, StringFormat=F4}" />
                                    <GridViewColumn Width="100"
                                                    Header="DeltaY"
                                                    DisplayMemberBinding="{Binding DeltaY, StringFormat=F4}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Row="2" />
            <GroupBox Grid.Row="3" Header="Tracebuffer Data">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot>
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotListBehavior Title="Tracebuffer" PlotList="{Binding PlotListZ}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>