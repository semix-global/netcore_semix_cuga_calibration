<UserControl x:Class="CugaCalibration.Views.Common.Windows.Diagnosis.Ads.Children.AdsGainsDiagnosisUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Diagnosis.AdsDiagonosis"
             d:DataContext="{d:DesignInstance Type=viewModels:AdsGainsDiagnosisViewModel}"
             d:DesignHeight="1200"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
                <i:InvokeCommandAction Command="{Binding LoadCommand}" />
            </i:EventTrigger>
        </i:Interaction.Triggers>
        <hc:UniformSpacingPanel Grid.Column="0"
                                Orientation="Vertical"
                                Spacing="10">
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsEnableWindow}">
                <hc:UniformSpacingPanel Orientation="Vertical">
                    <hc:UniformSpacingPanel Margin="2"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                        <hc:SimpleText hc:Text="Polarity:" hc:Width="70" />
                        <RadioButton Content="Positive"
                                     IsChecked="{Binding IsPositive}"
                                     Margin="0,0,5,0" />
                        <RadioButton Content="Negative" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical">
                    <StackPanel>
                        <TextBlock Text="1. Find Position"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>

                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding StartPosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="275"
                                 hc:InfoElement.Title="Start Position(um): "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:ButtonGroup Width="275">
                            <Button x:Name="StartGetButton"
                                    Content="Get"
                                    Command="{Binding GetPointCommand}"
                                    CommandParameter="StartPosition" />
                            <Button x:Name="StartGotoButton"
                                    Content="Goto"
                                    Command="{Binding GotoPointCommand}"
                                    CommandParameter="StartPosition" />
                        </hc:ButtonGroup>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding EndPosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="275"
                                 hc:InfoElement.Title="End Position(um): "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:ButtonGroup Width="275">
                            <Button x:Name="EndGetButton"
                                    Content="Get"
                                    Command="{Binding GetPointCommand}"
                                    CommandParameter="EndPosition" />
                            <Button x:Name="EndGotoButton"
                                    Content="Goto"
                                    Command="{Binding GotoPointCommand}"
                                    CommandParameter="EndPosition" />
                        </hc:ButtonGroup>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsEnableWindow}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="2.Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="WaitTimeNumeric"
                                      Width="275"
                                      hc:TitleElement.TitleWidth="110"
                                      hc:InfoElement.Title="Wait Time(s): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Wait Time"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding WaitTime}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical">
                    <StackPanel>
                        <TextBlock Text="Handle Test"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown Width="100"
                                      Margin="2"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Title="Speed"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SingleDiagnosisSpeed}" />
                    <hc:UniformSpacingPanel Orientation="Vertical"
                                            Spacing="2"
                                            Visibility="{Binding IsX, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <hc:NumericUpDown Width="100"
                                          Margin="2"
                                          hc:InfoElement.TitlePlacement="Left">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="True">
                                            <Setter Property="Value" Value="{Binding Path=XGainCache.X1}" />
                                            <Setter Property="hc:InfoElement.Title" Value="X1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="False">
                                            <Setter Property="Value" Value="{Binding Path=XGainCache.X3}" />
                                            <Setter Property="hc:InfoElement.Title" Value="X3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown Width="100"
                                          Margin="2"
                                          hc:InfoElement.TitlePlacement="Left">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="True">
                                            <Setter Property="Value" Value="{Binding Path=XGainCache.X2}" />
                                            <Setter Property="hc:InfoElement.Title" Value="X2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="False">
                                            <Setter Property="Value" Value="{Binding Path=XGainCache.X4}" />
                                            <Setter Property="hc:InfoElement.Title" Value="X4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical"
                                            Spacing="2"
                                            Visibility="{Binding IsX, Converter={StaticResource Boolean2VisibilityReConverter}}">
                        <hc:NumericUpDown Width="100"
                                          Margin="2"
                                          hc:InfoElement.TitlePlacement="Left">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="True">
                                            <Setter Property="Value" Value="{Binding Path=YGainCache.Y1}" />
                                            <Setter Property="hc:InfoElement.Title" Value="Y1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="False">
                                            <Setter Property="Value" Value="{Binding Path=YGainCache.Y4}" />
                                            <Setter Property="hc:InfoElement.Title" Value="Y4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown Width="100"
                                          Margin="2"
                                          hc:InfoElement.TitlePlacement="Left">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="True">
                                            <Setter Property="Value" Value="{Binding Path=YGainCache.Y2}" />
                                            <Setter Property="hc:InfoElement.Title" Value="Y2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="False">
                                            <Setter Property="Value" Value="{Binding Path=YGainCache.Y5}" />
                                            <Setter Property="hc:InfoElement.Title" Value="Y5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown Width="100"
                                          Margin="2"
                                          hc:InfoElement.TitlePlacement="Left">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="True">
                                            <Setter Property="Value" Value="{Binding Path=YGainCache.Y3}" />
                                            <Setter Property="hc:InfoElement.Title" Value="Y3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=IsPositive}" Value="False">
                                            <Setter Property="Value" Value="{Binding Path=YGainCache.Y6}" />
                                            <Setter Property="hc:InfoElement.Title" Value="Y6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:SimplePanel>
                            <Button Content="Once Diagnosis"
                                    Command="{Binding OnceDianosisActionCommand}"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                        </hc:SimplePanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>

        <GridSplitter Grid.Column="1" Width="10" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>

            <TabControl TabStripPlacement="Bottom">
                <TabItem Header="X Gains Configure" Visibility="{Binding IsX, Converter={StaticResource BoolToVisibilityConverter}}">
                    <GroupBox Header="X Gains Diagnosis Configure">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding XGainsItemDtoList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedXGainsItemDto, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCalibrated}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="150"
                                                    Header="Positive X1"
                                                    DisplayMemberBinding="{Binding PositiveX1}" />
                                    <GridViewColumn Width="150"
                                                    Header="Positive X2"
                                                    DisplayMemberBinding="{Binding PositiveX2}" />
                                    <GridViewColumn Width="150"
                                                    Header="Negative X3"
                                                    DisplayMemberBinding="{Binding NegativeX3}" />
                                    <GridViewColumn Width="150"
                                                    Header="Negative X4"
                                                    DisplayMemberBinding="{Binding NegativeX4}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
                <TabItem Header="Y Gains Configure" Visibility="{Binding IsX, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                    <GroupBox Header="Y Gains Diagnosis Configure">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding YGainsItemDtoList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedYGainsItemDto}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCalibrated}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="120"
                                                    Header="Positive Y1"
                                                    DisplayMemberBinding="{Binding PositiveY1}" />
                                    <GridViewColumn Width="120"
                                                    Header="Positive Y2"
                                                    DisplayMemberBinding="{Binding PositiveY2}" />
                                    <GridViewColumn Width="120"
                                                    Header="Positive Y3"
                                                    DisplayMemberBinding="{Binding PositiveY3}" />
                                    <GridViewColumn Width="120"
                                                    Header="Negative Y4"
                                                    DisplayMemberBinding="{Binding NegativeY4}" />
                                    <GridViewColumn Width="120"
                                                    Header="Negative Y5"
                                                    DisplayMemberBinding="{Binding NegativeY5}" />
                                    <GridViewColumn Width="120"
                                                    Header="Negative Y6"
                                                    DisplayMemberBinding="{Binding NegativeY6}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="1" />
            <GroupBox Grid.Row="2" Header="Tracebuffer Data">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot>
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotListBehavior Title="Tracebuffer" PlotList="{Binding PlotListZ}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>