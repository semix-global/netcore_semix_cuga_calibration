<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Diagnosis.AdsMove.AdsXYMoveDiagnosisWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
           xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
           xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Diagnosis"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="AdsXYMoveWindow"
           Width="1800"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:AdsXYMoveDiagnosisWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title,first region-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="ADS XY MoveAnyDirection"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--  #Second region  -->
        <Grid Grid.Row="1" Cursor="">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Loaded">
                    <i:InvokeCommandAction Command="{Binding LoadCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <hc:UniformSpacingPanel Grid.Column="0"
                                    Orientation="Vertical"
                                    Spacing="10">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <hc:SimplePanel>
                            <DataGrid x:Name="dataGrid"
                                      Margin="10"
                                      AutoGenerateColumns="False"
                                      ItemsSource="{Binding SelectPositions}"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      SelectionMode="Single"
                                      SelectedItem="{Binding SelectedPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="DataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="120"
                                                        Header="PositionName"
                                                        Binding="{Binding Number}" />
                                    <DataGridComboBoxColumn Width="90"
                                                            Header="StageType"
                                                            SelectedItemBinding="{Binding Type}">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource" Value="{Binding DataContext.StageCoordinateSystemValues, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource" Value="{Binding DataContext.StageCoordinateSystemValues, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                    <DataGridTextColumn Width="100"
                                                        Header="StartPosition"
                                                        Binding="{Binding StartPos, Converter={StaticResource PointToStringConverter}}" />
                                    <DataGridTextColumn Width="100"
                                                        Header="EndPosition"
                                                        Binding="{Binding EndPos, Converter={StaticResource PointToStringConverter}}" />
                                    <DataGridTextColumn Width="60"
                                                        Header="Time"
                                                        Binding="{Binding Time}" />
                                    <DataGridTextColumn Width="90"
                                                        Header="SpeedX"
                                                        Binding="{Binding SpeedX}" />
                                    <DataGridTextColumn Width="90"
                                                        Header="SpeedY"
                                                        Binding="{Binding SpeedY}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </hc:SimplePanel>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical">
                        <StackPanel>
                            <TextBlock Text="Run All Test Data"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <hc:SimplePanel>
                                <Button Content="Action"
                                        Command="{Binding OnceDianosisActionCommand}"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                            </hc:SimplePanel>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </hc:UniformSpacingPanel>

            <GridSplitter Grid.Column="1" Width="10" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GridSplitter Grid.Row="0" />
                <GroupBox Grid.Row="1" Header="HRP Data">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <wpf:WpfPlot>
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="ADS Move Any Direction HRP Curve"
                                                                Plot0Title="Hight Curve"
                                                                Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                Plot0="{Binding HList, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot1Title="Roll Curve"
                                                                Plot1Color="{x:Static scottPlot:Colors.Orange}"
                                                                Plot1="{Binding RList, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot2Title="Pitch Curve"
                                                                Plot2Color="{x:Static scottPlot:Colors.Yellow}"
                                                                Plot2="{Binding PList, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot3Title="Speed X"
                                                                Plot3Color="{x:Static scottPlot:Colors.Red}"
                                                                Plot3="{Binding XSpeedList, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot4Title="Speed Y"
                                                                Plot4Color="{x:Static scottPlot:Colors.Blue}"
                                                                Plot4="{Binding YSpeedList, Converter={StaticResource DoublesToPointsConverter}}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Border>
                </GroupBox>
                <GroupBox Grid.Row="2" Header="Z1Z2Z3 Data">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <wpf:WpfPlot>
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="ADS Move Any Direction Z1Z2Z3 Curve"
                                                                Plot0Title="Z1 Curve"
                                                                Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                Plot0="{Binding Z1List, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot1Title="Z2 Curve"
                                                                Plot1Color="{x:Static scottPlot:Colors.Orange}"
                                                                Plot1="{Binding Z2List, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot2Title="Z3 Curve"
                                                                Plot2Color="{x:Static scottPlot:Colors.Yellow}"
                                                                Plot2="{Binding Z3List, Converter={StaticResource DoublesToPointsConverter}}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Border>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</hc:Window>
