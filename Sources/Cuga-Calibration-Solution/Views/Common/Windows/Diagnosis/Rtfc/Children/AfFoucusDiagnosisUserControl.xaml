<UserControl x:Class="CugaCalibration.Views.Common.Windows.Diagnosis.Rtfc.Children.AfFocusDiagnosisUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:optics="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Diagnosis.RtfcDiagonosis"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Laser.Rtfc;assembly=Core.Models"
             xmlns:focusShiftCoreModels="clr-namespace:Core.Models.Models.Laser.FocusShift;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:AfFocusDiagnosisViewModel}"
             d:DesignHeight="1600"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
                <i:InvokeCommandAction Command="{Binding LoadCommand}" />
            </i:EventTrigger>
        </i:Interaction.Triggers>
        <hc:ScrollViewer Grid.Column="0">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown x:Name="ZLimitMinNumeric"
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Limit Min: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding FocusShiftCache.LowMagFindFocusMin}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding FocusShiftCache.MiddleMagFindFocusMin}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding FocusShiftCache.HighMagFindFocusMin}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown x:Name="ZLimitMaxNumeric"
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Limit Max: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding FocusShiftCache.LowMagFindFocusMax}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding FocusShiftCache.MiddleMagFindFocusMax}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding FocusShiftCache.HighMagFindFocusMax}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown x:Name="IntervalNumeric"
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Interval: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="100">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding FocusShiftCache.LowMagFindFocusInterval}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding FocusShiftCache.MiddleMagFindFocusInterval}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding FocusShiftCache.HighMagFindFocusInterval}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Quality Threshold: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.QualityThreshold}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="X Offset Threshold(um): "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.OffsetThreshold}" />
                    </hc:UniformSpacingPanel>
                </Border>
                <Border Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        IsEnabled="{Binding IsEnableWindow}">
                    <hc:UniformSpacingPanel Orientation="Vertical" IsEnabled="{Binding IsEnableWindow}">
                        <hc:UniformSpacingPanel Margin="2"
                                                HorizontalAlignment="Center"
                                                Orientation="Vertical">
                            <StackPanel>
                                <TextBlock Text="AF Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:NumericUpDown Height="30"
                                              Margin="2"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:InfoElement.Title="Ecs: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="100">
                                <hc:NumericUpDown.Style>
                                    <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                                <Setter Property="Value" Value="{Binding FocusShiftCache.LowMagDarkFieldAutoFocusParam.DswEcsValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                                <Setter Property="Value" Value="{Binding FocusShiftCache.MiddleMagDarkFieldAutoFocusParam.DswEcsValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                                <Setter Property="Value" Value="{Binding FocusShiftCache.HighMagDarkFieldAutoFocusParam.DswEcsValue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                            <hc:NumericUpDown Height="30"
                                              Margin="2"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:InfoElement.Title="Motor: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="100">
                                <hc:NumericUpDown.Style>
                                    <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                                <Setter Property="Value" Value="{Binding FocusShiftCache.LowMagDarkFieldAutoFocusParam.DswMotorValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                                <Setter Property="Value" Value="{Binding FocusShiftCache.MiddleMagDarkFieldAutoFocusParam.DswMotorValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                                <Setter Property="Value" Value="{Binding FocusShiftCache.HighMagDarkFieldAutoFocusParam.DswMotorValue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                            <hc:SimplePanel Height="30">
                                <TextBlock Text="AutoFocus:"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <ToggleButton HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Background="{StaticResource DangerBrush}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonSwitch}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                                    <Setter Property="IsChecked" Value="{Binding FocusShiftCache.LowMagDarkFieldAutoFocusParam.IsEnableDsw}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                                    <Setter Property="IsChecked" Value="{Binding FocusShiftCache.MiddleMagDarkFieldAutoFocusParam.IsEnableDsw}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FocusShiftCache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                                    <Setter Property="IsChecked" Value="{Binding FocusShiftCache.HighMagDarkFieldAutoFocusParam.IsEnableDsw}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </hc:SimplePanel>

                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        IsEnabled="{Binding IsEnableWindow}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="LowSite Template"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                                <TextBox Text="{Binding FocusShiftCache.LowSiteFindPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="275"
                                         hc:InfoElement.Title="Position1(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="LowFindPosition" />
                            </hc:UniformSpacingPanel>
                            <view:CanvasView Width="100"
                                             Height="100"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding FocusShiftCache.LowSiteTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                        </hc:UniformSpacingPanel>

                    </hc:UniformSpacingPanel>
                </Border>
                <Border Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        IsEnabled="{Binding IsEnableWindow}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="HighSite Template"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Dark Field Template Type: "
                                         hc:InfoElement.Necessary="True"
                                         SelectedItem="{Binding FocusShiftCache.AlgorithmTemplateTypeEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                                <TextBox Text="{Binding FocusShiftCache.HighSiteFindPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="275"
                                         hc:InfoElement.Title="Position2(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="HighFindPosition"
                                        Style="{StaticResource ButtonDefault.Loading}" />
                            </hc:UniformSpacingPanel>
                            <hc:UniformSpacingPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="2">
                                <view:CanvasView Width="100"
                                                 Height="100"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding FocusShiftCache.HighSiteTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <view:CanvasView Width="100"
                                                 Height="100"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding FocusShiftCache.DarkFiledTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Focus Shift Calibration Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                            <TextBox Text="{Binding ResultFocusShiftDto.EcsOffset, Mode=OneWay}"
                                     Width="275"
                                     hc:InfoElement.Title="Ecs Offset: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}"
                                     IsReadOnly="True" />
                            <TextBox Text="{Binding ResultFocusShiftDto.FocusShiftOffset, Mode=OneWay}"
                                     Width="275"
                                     hc:InfoElement.Title="Focus Shift Offset: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}"
                                     IsReadOnly="True" />
                            <TextBox Text="{Binding ResultFocusShiftDto.AfMotorOffset}"
                                     Width="275"
                                     hc:InfoElement.Title="Af Motor Offset: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultFocusShiftDto.BrightFiedlToDarkFieldOffset, Mode=OneWay}"
                                     Width="275"
                                     hc:InfoElement.Title="BF To DF Machine Offset: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button x:Name="ActionButton"
                                        Content="Action"
                                        Command="{Binding FocusShiftCalibrationCommand}"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button x:Name="CancelButton"
                                        Content="Cancel"
                                        Command="{Binding FocusShiftCalibrationCancelCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                            </hc:UniformSpacingPanel>
                        </StackPanel>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="RTFC Diagnosis Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                            <TextBox Text="{Binding ResultRtfcDto.AutoFocusEcs}"
                                     Width="275"
                                     hc:InfoElement.Title="AutoFocus Ecs: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultRtfcDto.AutoFocusNsc}"
                                     Width="275"
                                     hc:InfoElement.Title="AutoFocus Nsc: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultRtfcDto.IdealEcs}"
                                     Width="275"
                                     hc:InfoElement.Title="Idea Ecs: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultRtfcDto.IdealEcsNsc}"
                                     Width="275"
                                     hc:InfoElement.Title="Ideal Ecs Nsc: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultRtfcDto.EcsValue}"
                                     Width="275"
                                     hc:InfoElement.Title="Real Ecs: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultRtfcDto.NscValue}"
                                     Width="275"
                                     hc:InfoElement.Title="Real Ecs Nsc: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                        </StackPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </hc:UniformSpacingPanel>
        </hc:ScrollViewer>
        <GridSplitter Grid.Column="1" Width="10" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>

            <TabControl TabStripPlacement="Bottom">
                <TabItem Header="Diagnosis">
                    <GroupBox Header="Get Quality">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding RtfcDtoItems}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedItemDto, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="80"
                                                    Header="Index"
                                                    DisplayMemberBinding="{Binding Index}" />
                                    <GridViewColumn Width="80"
                                                    Header="EcsValue"
                                                    DisplayMemberBinding="{Binding EcsValue, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="100"
                                                    Header="Quality"
                                                    DisplayMemberBinding="{Binding Quality, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200" Header="Action Review">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <hc:ButtonGroup>
                                                    <Button Content="Image"
                                                            Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                            CommandParameter="{Binding DarkFieldImageFilePath}"
                                                            d:DataContext="{d:DesignInstance Type=coreModels:RtfcDto}" />
                                                </hc:ButtonGroup>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
                <TabItem Header="Focus Shift Calibration">
                    <GroupBox Header="Get Quality">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding FocusShiftDtoItems}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="80"
                                                    Header="Index"
                                                    DisplayMemberBinding="{Binding Index}" />
                                    <GridViewColumn Width="80"
                                                    Header="EcsValue"
                                                    DisplayMemberBinding="{Binding DarkFieldEcsValue, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="100"
                                                    Header="Quality"
                                                    DisplayMemberBinding="{Binding DarkFieldQuality, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200" Header="Action Review">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <hc:ButtonGroup>
                                                    <Button Content="Image"
                                                            Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                            CommandParameter="{Binding DarkFieldImageFilePath}"
                                                            d:DataContext="{d:DesignInstance Type=focusShiftCoreModels:FocusShiftDto}" />
                                                </hc:ButtonGroup>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
            </TabControl>
            <TabControl Grid.Row="1" TabStripPlacement="Bottom">
                <TabItem Header="Iteration">
                    <GroupBox Header="Iteration">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding RtfcDtoIterationItems}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedItemDto, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="80"
                                                    Header="EcsValue"
                                                    DisplayMemberBinding="{Binding EcsValue, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="100"
                                                    Header="Quality"
                                                    DisplayMemberBinding="{Binding Quality, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="180"
                                                    Header="DarkFieldMatchOffset"
                                                    DisplayMemberBinding="{Binding DarkFieldMatchOffset, Converter={StaticResource PointToStringConverter}}" />
                                    <GridViewColumn Width="180"
                                                    Header="LightAxisOffset"
                                                    DisplayMemberBinding="{Binding LightAxisOffset, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="80"
                                                    Header="DeltaEcs"
                                                    DisplayMemberBinding="{Binding DeltaEcs, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="80"
                                                    Header="DeltaNsc"
                                                    DisplayMemberBinding="{Binding DeltaNsc, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="80"
                                                    Header="AfMotorOffset"
                                                    DisplayMemberBinding="{Binding AfMotorOffset, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200" Header="Action Review">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <hc:ButtonGroup>
                                                    <Button Content="Image"
                                                            Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                            CommandParameter="{Binding DarkFieldImageFilePath}"
                                                            d:DataContext="{d:DesignInstance Type=coreModels:RtfcDto}" />
                                                </hc:ButtonGroup>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Row="2" />
            <hc:ScrollViewer Grid.Row="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="Tracebuffer Data">
                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                            <wpf:WpfPlot Width="500" Height="400">
                                <i:Interaction.Behaviors>
                                    <behaviors:WpfPlotMultiBehavior Title="Focus"
                                                                    Plot0Title="Quality"
                                                                    Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                    Plot0="{Binding EcsPoints}" />
                                </i:Interaction.Behaviors>
                            </wpf:WpfPlot>
                        </Border>
                    </GroupBox>
                    <Border Grid.Column="1">
                        <GroupBox Header="Images">
                            <Border Padding="5" Style="{StaticResource BorderRegion}">
                                <view:CanvasView BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding ResultRtfcDto.DarkFieldImageFilePath, Converter={StaticResource StringToBitmapFrameConverter}}" />
                            </Border>
                        </GroupBox>
                    </Border>
                </Grid>
            </hc:ScrollViewer>

        </Grid>

    </Grid>
</UserControl>