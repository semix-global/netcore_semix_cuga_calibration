<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Diagnosis.Rtfc.RtfcDiagnosisWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:children="clr-namespace:CugaCalibration.Views.Common.Windows.Diagnosis.Rtfc.Children"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Diagnosis"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:RtfcDiagnosisWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="ADS Diagnosis"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Border Grid.Row="1" Style="{StaticResource BorderRegion}">
            <hc:UniformSpacingPanel Orientation="Horizontal">
                <Button Content="Action"
                        Command="{Binding ActionCommand}"
                        Width="90"
                        Height="30"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                        Style="{StaticResource ButtonPrimary.Loading}" />
                <Button Content="Cancel"
                        Command="{Binding ActionCancelCommand}"
                        Width="90"
                        Height="30"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                        Style="{StaticResource ButtonWarning}" />
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Height="30"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                        Style="{StaticResource ButtonSuccess}" />
            </hc:UniformSpacingPanel>
        </Border>
        <!--#endregion-->
        <TabControl Grid.Row="2" Padding="5">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding TabItemChangedCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <TabItem Header="Af Focus">
                <Border>
                    <children:AfFocusDiagnosisUserControl DataContext="{Binding AfFocusDiagnosisViewModel}" />
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</hc:Window>