<hc:Window x:Class="CugaCalibration.Views.Common.Windows.View.ReviewWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.View"
           xmlns:behaviors="clr-namespace:CanvasViewer.Behaviors;assembly=WPF.CanvasViewer"
           Width="450"
           Height="400"
           d:DataContext="{d:DesignInstance Type=viewModels:ReviewWindowViewModel}"
           WindowStartupLocation="CenterScreen"
           Closed="OnClosed"
           WindowStyle="None"
           ShowInTaskbar="False"
           ResizeMode="CanResize"
           BorderThickness="2"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <!--  神奇组件bug, 改为Loaded后, 调试源码发现下面Command绑定失败: 当时View上设置了Window.SizeToContent属性有概率触发bug  -->
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Review"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Padding="1"
                IsEnabled="{Binding IsEnable}"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <view:CanvasView BackgroundColor="#0A0A0A"
                             AxisColor="Red"
                             Interactive="True"
                             ShowAxes="True"
                             ShowCursor="False"
                             ShowGrid="False"
                             BackgroundImage="{Binding StatusViewModel.BitmapMemoryByteArray, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}">
                <i:Interaction.Behaviors>
                    <behaviors:CanvasViewerFpsBehavior FpsValue="{Binding StatusViewModel.Fps}" />
                    <behaviors:CanvasViewerClickBehavior Command="{Binding ReviewViewModel.MousePilotCommand}" />
                </i:Interaction.Behaviors>
            </view:CanvasView>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>