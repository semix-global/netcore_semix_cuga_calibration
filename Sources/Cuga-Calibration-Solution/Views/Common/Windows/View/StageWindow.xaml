<hc:Window x:Class="CugaCalibration.Views.Common.Windows.View.StageWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.View"
           xmlns:constants="clr-namespace:Net.Utilities.Constants;assembly=Net.Utilities"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
           xmlns:helper="clr-namespace:Core.Models.Helper;assembly=Core.Models"
           xmlns:behaviorsCore="clr-namespace:CugaCalibration.Core.Behaviors"
           Width="328"
           Height="772"
           d:DataContext="{d:DesignInstance Type=viewModels:StageWindowViewModel}"
           Loaded="OnLoaded"
           Closed="OnClosed"
           WindowStyle="None"
           ShowInTaskbar="False"
           ResizeMode="NoResize"
           BorderThickness="2"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Move Stage"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Padding="2"
                IsEnabled="{Binding IsEnable}"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <hc:UniformSpacingPanel Grid.Row="1"
                                    Margin="5"
                                    Orientation="Vertical"
                                    Spacing="5">
                <hc:SimplePanel Width="288" HorizontalAlignment="Center">
                    <TextBlock Text="Step(um):"
                               Width="60"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    <ComboBox Text="{Binding StageStep, Converter={StaticResource DoubleToStringConverter}, UpdateSourceTrigger=LostFocus}"
                              Width="223"
                              HorizontalAlignment="Right"
                              IsEditable="True"
                              ItemsSource="{x:Static helper:CalibrationConstantsHelper.StageSteps}" />
                </hc:SimplePanel>
                <UniformGrid Rows="3" Columns="3">
                    <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
                            <Setter Property="Width" Value="60" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Margin" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Resources>
                    <Button Command="{Binding MoveRelativeStageXyCommand}"
                            CommandParameter="{x:Static stage:StageDirectionTypeEnum.UpLeft}"
                            hc:IconElement.Geometry="{StaticResource UpGeometry}"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <SkewTransform />
                                <RotateTransform Angle="-45" />
                                <TranslateTransform />
                            </TransformGroup>
                        </Button.RenderTransform>
                    </Button>
                    <Button Command="{Binding MoveRelativeStageXyCommand}"
                            CommandParameter="{x:Static stage:StageDirectionTypeEnum.Up}"
                            hc:IconElement.Geometry="{StaticResource UpGeometry}" />
                    <Button Command="{Binding MoveRelativeStageXyCommand}"
                            CommandParameter="{x:Static stage:StageDirectionTypeEnum.UpRight}"
                            hc:IconElement.Geometry="{StaticResource UpGeometry}"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <SkewTransform />
                                <RotateTransform Angle="45" />
                                <TranslateTransform />
                            </TransformGroup>
                        </Button.RenderTransform>
                    </Button>
                    <Button Command="{Binding MoveRelativeStageXyCommand}"
                            CommandParameter="{x:Static stage:StageDirectionTypeEnum.Left}"
                            hc:IconElement.Geometry="{StaticResource LeftGeometry}" />
                    <Button Command="{Binding ToggleEnableJoystickCommand}" hc:IconElement.Geometry="{StaticResource JoystickGeometry}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJoystickEnabled}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding MoveRelativeStageXyCommand}"
                            CommandParameter="{x:Static stage:StageDirectionTypeEnum.Right}"
                            hc:IconElement.Geometry="{StaticResource RightGeometry}" />
                    <Button Command="{Binding MoveRelativeStageXyCommand}"
                            CommandParameter="{x:Static stage:StageDirectionTypeEnum.DownLeft}"
                            hc:IconElement.Geometry="{StaticResource DownGeometry}"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <SkewTransform />
                                <RotateTransform Angle="45" />
                                <TranslateTransform />
                            </TransformGroup>
                        </Button.RenderTransform>
                    </Button>
                    <Button Command="{Binding MoveRelativeStageXyCommand}"
                            CommandParameter="{x:Static stage:StageDirectionTypeEnum.Down}"
                            hc:IconElement.Geometry="{StaticResource DownGeometry}" />
                    <Button Command="{Binding MoveRelativeStageXyCommand}"
                            CommandParameter="{x:Static stage:StageDirectionTypeEnum.DownRight}"
                            hc:IconElement.Geometry="{StaticResource DownGeometry}"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <SkewTransform />
                                <RotateTransform Angle="-45" />
                                <TranslateTransform />
                            </TransformGroup>
                        </Button.RenderTransform>
                    </Button>
                </UniformGrid>
                <Border Padding="2"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        BorderBrush="{StaticResource PrimaryBrush}">
                    <wpf:WpfPlot Width="300" Height="300">
                        <i:Interaction.Behaviors>
                            <behaviorsCore:WpfPlotWaferMapBehavior Radius="150000"
                                                                   StageCoordinateSystemEnum="{Binding StageCoordinateSystemEnum}"
                                                                   BrightPosition="{Binding BrightFieldPosition}"
                                                                   DarkPosition="{Binding DarkFieldPosition}"
                                                                   StagePosition="{Binding MachinePosition}"
                                                                   Theta="{Binding MachineTheta}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
                <Border Padding="8"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        BorderBrush="{StaticResource PrimaryBrush}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding GotoPosition, Converter={StaticResource PointToStringConverter}}"
                                     Margin="0,0,-1,0"
                                     hc:InfoElement.Title="Goto Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:BorderElement.CornerRadius="4,0,0,4"
                                     hc:TitleElement.TitleWidth="135"
                                     Style="{StaticResource TextBoxExtend}" />
                            <Button Grid.Column="1"
                                    Command="{Binding GetGotoPositionCommand}"
                                    Padding="3"
                                    hc:BorderElement.CornerRadius="0,4,4,0"
                                    hc:IconElement.Width="10"
                                    hc:IconElement.Geometry="{StaticResource RotateRightGeometry}"
                                    Style="{StaticResource ButtonDefault}" />
                        </Grid>
                        <hc:SimplePanel>
                            <ItemsControl HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:StageCoordinateSystemEnum}}}">
                                <i:Interaction.Behaviors>
                                    <behaviors:RadioButtonSelectedItemBehavior SelectedItem="{Binding StageCoordinateSystemEnum, Mode=TwoWay}" />
                                </i:Interaction.Behaviors>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                                                     CommandParameter="{Binding}"
                                                     Height="25"
                                                     Tag="{Binding}"
                                                     GroupName="fd6cc88f-3768-4901-b609-84fc21b2bec8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </hc:SimplePanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style BasedOn="{StaticResource ButtonDefault}" TargetType="Button">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="Command" Value="{Binding SetAbsoluteStageXyCommand}" />
                                </Style>
                            </Grid.Resources>
                            <Button Grid.ColumnSpan="2"
                                    Content="Goto Chuck"
                                    CommandParameter="{x:Static stage:CalChipSiteModelEnum.ChuckModel}"
                                    hc:BorderElement.CornerRadius="4,4,0,0" />
                            <Button Grid.Row="1" Grid.Column="0"
                                    Content="Goto Undefined"
                                    CommandParameter="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}"
                                    Margin="0,-1,0,0"
                                    hc:BorderElement.CornerRadius="0" />
                            <Button Grid.Row="1" Grid.Column="1"
                                    Content="Goto DSW"
                                    CommandParameter="{x:Static stage:CalChipSiteModelEnum.DswModel}"
                                    Margin="-1,-1,0,0"
                                    hc:BorderElement.CornerRadius="0" />
                            <Button Grid.Row="2" Grid.Column="0"
                                    Content="Goto Haze"
                                    CommandParameter="{x:Static stage:CalChipSiteModelEnum.HazeModel}"
                                    Margin="0,-1,0,0"
                                    hc:BorderElement.CornerRadius="0,0,0,4" />
                            <Button Grid.Row="2" Grid.Column="1"
                                    Content="Goto Shiny Wafer"
                                    CommandParameter="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}"
                                    Margin="-1,-1,0,0"
                                    hc:BorderElement.CornerRadius="0,0,4,0" />
                        </Grid>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border Padding="8"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        BorderBrush="{StaticResource PrimaryBrush}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:SimplePanel Width="288" HorizontalAlignment="Center">
                            <TextBlock Text="Rotate Theta(°):"
                                       Width="122"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <ComboBox Text="{Binding RotateTheta, Converter={StaticResource DoubleToStringConverter}, UpdateSourceTrigger=LostFocus}"
                                      Width="153"
                                      HorizontalAlignment="Right"
                                      IsEditable="True"
                                      ItemsSource="{x:Static helper:CalibrationConstantsHelper.StageThetaSteps}" />
                        </hc:SimplePanel>
                        <hc:ButtonGroup>
                            <Button Content="Relative"
                                    Command="{Binding SetStageThetaCommand}"
                                    CommandParameter="{x:Static constants:ConstantHelper.False}" />
                            <Button Content="Absolute"
                                    Command="{Binding SetStageThetaCommand}"
                                    CommandParameter="{x:Static constants:ConstantHelper.True}" />
                        </hc:ButtonGroup>
                    </hc:UniformSpacingPanel>
                </Border>
            </hc:UniformSpacingPanel>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>