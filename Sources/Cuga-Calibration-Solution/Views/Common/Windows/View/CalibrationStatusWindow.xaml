<hc:Window x:Class="CugaCalibration.Views.Common.Windows.View.CalibrationStatusWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.View"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:constants="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:cookies="clr-namespace:Core.Models.Models.Common.Cookies;assembly=Core.Models"
           Width="450"
           Height="600"
           MinWidth="450"
           MinHeight="600"
           d:DataContext="{d:DesignInstance Type=viewModels:CalibrationStatusWindowViewModel}"
           WindowStartupLocation="CenterScreen"
           WindowStyle="ToolWindow"
           ShowInTaskbar="False"
           ResizeMode="CanResize"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
            <StackPanel>
                <TextBlock Text="{Binding Menu.SysMenu.Name}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource TextBlockSubTitle}" />
            </StackPanel>
            <Separator />
            <StackPanel>
                <TextBlock HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource TextBlockDefault}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Menu.Entry.Status.IsOk}" Value="{x:Static constants:Constants.True}">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Menu.Entry.Status.IsOk}" Value="{x:Static constants:Constants.False}">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run>
                        <Run.Style>
                            <Style TargetType="Run">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Menu.Entry.Status.IsOk}" Value="{x:Static constants:Constants.True}">
                                        <Setter Property="Text" Value="OK: " />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Menu.Entry.Status.IsOk}" Value="{x:Static constants:Constants.False}">
                                        <Setter Property="Text" Value="Not OK: " />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Run.Style>
                    </Run>
                    <Run Text="{Binding Menu.Entry.Status.Progress, Mode=OneWay, StringFormat={}{0:0.###}%}" />
                </TextBlock>
            </StackPanel>
            <Border Style="{StaticResource BorderRegion}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="Calibration"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Count" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Menu.Entry.Status.TotalCalibrationCount}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="OK" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Menu.Entry.Status.CalibratedCount}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Not Ok" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Menu.Entry.Status.NotOkCalibratedCount}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </UniformGrid>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="Review"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Count" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Menu.Entry.Status.TotalCalibrationCount}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="OK" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Menu.Entry.Status.ReviewCount}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Not Ok" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Menu.Entry.Status.NotOkReviewCount}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </UniformGrid>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                <StackPanel>
                    <TextBlock Text="Details"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </StackPanel>
                <ListView ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ListView.Small}"
                          ItemsSource="{Binding Menu.Entry.Status.Details}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="200"
                                            Header="Item"
                                            DisplayMemberBinding="{Binding Item}" />
                            <GridViewColumn Width="100" Header="Calibration">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type cookies:CalibrationViewModelStatus+Detail}">
                                        <Ellipse Width="10"
                                                  Height="10"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCalibrated}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100" Header="Review">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type cookies:CalibrationViewModelStatus+Detail}">
                                        <Ellipse Width="10"
                                                  Height="10"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReviewed}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReviewed}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </hc:UniformSpacingPanel>
        </Border>
    </Grid>
</hc:Window>
