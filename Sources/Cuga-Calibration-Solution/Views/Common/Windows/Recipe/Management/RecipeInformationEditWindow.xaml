<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Recipe.Management.RecipeInformationEditWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Recipe"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:management="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Recipe.Management"
           Width="500"
           Height="400"
           d:DesignHeight="500"
           d:DesignWidth="400"
           d:DataContext="{d:DesignInstance Type=management:RecipeInformationEditViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="True"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           Topmost="True"
           mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title Bar  -->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Recipe Information Setting"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CancelCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>

        <!--  Content Area  -->
        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Recipe Name  -->
            <TextBox Grid.Row="0"
                     Text="{Binding EditSysRecipeInformation.RecipeDbName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"
                     hc:TitleElement.Title="Recipe Name"
                     hc:TitleElement.TitleWidth="120"
                     hc:InfoElement.TitlePlacement="Left"
                     Style="{StaticResource TextBoxExtend}" />

            <!--  Description  -->
            <TextBox Grid.Row="1"
                     Text="{Binding EditSysRecipeInformation.DescribeInformation, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"
                     hc:TitleElement.Title="Description"
                     hc:TitleElement.TitleWidth="120"
                     hc:InfoElement.TitlePlacement="Left"
                     Style="{StaticResource TextBoxExtend}" />

            <!--  Spacer  -->
            <Grid Grid.Row="2" />

            <!--  Action Buttons  -->
            <hc:UniformSpacingPanel Grid.Row="3"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Orientation="Horizontal">
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Width="90"
                        Height="36"
                        hc:IconElement.Geometry="{StaticResource SuccessGeometry}"
                        hc:IconElement.Width="16"
                        Style="{StaticResource ButtonPrimary}" />
            </hc:UniformSpacingPanel>
        </Grid>
    </Grid>
</hc:Window>
