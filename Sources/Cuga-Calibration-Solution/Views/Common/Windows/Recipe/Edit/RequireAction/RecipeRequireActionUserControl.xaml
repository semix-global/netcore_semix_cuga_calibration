<UserControl x:Class="CugaCalibration.Views.Common.Windows.Recipe.Edit.RequireAction.RecipeRequireActionUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:children1="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.Edit.RequireAction.Children"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
             xmlns:children="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Recipe.Edit.Children"
             xmlns:alignment="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.Edit.Alignment"
             d:DataContext="{d:DesignInstance Type=children:RecipeRequireActionViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1300"
             wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <hc:UniformSpacingPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="3"
                    Effect="{StaticResource EffectShadow1}"
                    Style="{StaticResource BorderRegion}">
                <hc:UniformSpacingPanel Margin="5"
                                        Orientation="Horizontal"
                                        Spacing="10">
                    <Button Content="Action"
                            Command="{Binding RequireActionCommandCommand}"
                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                            Style="{StaticResource ButtonSuccess}" />
                    <Button Content="Previous"
                            Command="{Binding PreviousCommandCommand}"
                            hc:IconElement.Geometry="{StaticResource LeftGeometry}"
                            Style="{StaticResource ButtonPrimary}" />
                    <Button Content="Next"
                            Command="{Binding NextCommandCommand}"
                            hc:IconElement.Geometry="{StaticResource RightGeometry}"
                            Style="{StaticResource ButtonPrimary}" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommandCommand}"
                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                            Style="{StaticResource ButtonWarning}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Grid.Row="1"
                    Margin="5"
                    Effect="{StaticResource EffectShadow2}"
                    Style="{StaticResource BorderRegion}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsLoadingToVisibilityConverter}}">
                        <hc:LoadingCircle Width="1000"
                                          Height="800"
                                          Style="{StaticResource LoadingCircleLarge}" />
                        <TextBlock Text="Loading calibration..." Style="{StaticResource TextBlockLargeBold}" />
                    </StackPanel>
                    <Grid Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsWelcomeToVisibilityConverter}}">
                        <Border Width="1000" Height="800">
                            <TextBlock Text="Welcome to require action!" Style="{StaticResource TextBlockLargeBold}" />
                        </Border>
                    </Grid>
                    <Grid Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsCalibrationToVisibilityConverter}}">
                        <children1:FindWaferBrightFieldCenterUserControl1 DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding DataContext.CalibrationStepIndex, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource IntIs0ToVisibilityConverter}}" />
                        <alignment:RecipeBrightFieldAlignmentUserControl Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs1ToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </hc:UniformSpacingPanel>
</UserControl>