<UserControl x:Class="CugaCalibration.Views.Common.Windows.Recipe.Edit.Reticle.Children.ReticleMaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:behaviorsCore="clr-namespace:CugaCalibration.Core.Behaviors"
             xmlns:children="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Recipe.Edit.Children"
             d:DataContext="{d:DesignInstance Type=children:RecipeReticleMaskViewModel,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="900"
             d:DesignWidth="400"
             mc:Ignorable="d">
    <Grid>
        <Border Padding="2"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <wpf:WpfPlot Width="{Binding Width, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}" Height="{Binding Height, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}">
                <i:Interaction.Behaviors>
                    <behaviorsCore:WpfPlotReticleMaskBehavior WaferDTO="{Binding EditingDTO.WaferDTO}" ReticleMaskList="{Binding ReticleMarkList}" />
                </i:Interaction.Behaviors>
            </wpf:WpfPlot>
        </Border>
    </Grid>
</UserControl>