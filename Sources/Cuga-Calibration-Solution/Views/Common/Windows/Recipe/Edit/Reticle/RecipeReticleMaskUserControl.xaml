<UserControl x:Class="CugaCalibration.Views.Common.Windows.Recipe.Edit.Reticle.RecipeReticleMaskUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:children="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.Edit.Reticle.Children"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:opticsEnum="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:reticleMask="clr-namespace:Core.Recipe.Models.Wafer.ReticleMask;assembly=Core.Recipe"
             xmlns:stageSpeedEnum="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:waferEnum="clr-namespace:Core.Models.Enums.Recipe.Wafer;assembly=Core.Models"
             xmlns:children2="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Recipe.Edit.Children"
             xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=children2:RecipeReticleMaskViewModel,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="1000"
             d:DesignWidth="1200"
             mc:Ignorable="d">

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0"
                      Grid.RowSpan="2"
                      Margin="10"
                      Header="Reticle Mask">
                <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                    <children:ReticleMaskView>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding LoadingCommand}" CommandParameter="Microscope" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </children:ReticleMaskView>
                </Border>
            </GroupBox>
            <GridSplitter Grid.Column="1" />

            <!--  右侧：Tab 切换 + 统一 ListView  -->
            <Grid Grid.Column="2" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Tab 仅作切换，无 Content  -->
                <TabControl x:Name="tabcontrol" Grid.Row="0"
                            Style="{StaticResource TabControlCapsuleSolid}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding MaskTypeChangedCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <TabItem Header="Microscope" />
                    <TabItem Header="Chuck" />
                    <TabItem Header="Laser" />
                </TabControl>

                <!--  统一 ListView，绑定 EditReticleMarkList  -->
                <Border Grid.Row="1"
                        Effect="{StaticResource EffectShadow1}"
                        Style="{StaticResource BorderRegion}">
                    <ListView ItemsSource="{Binding EditReticleMarkList}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectReticleMarkItem}"
                              Style="{StaticResource ListView.Small}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="100"
                                                DisplayMemberBinding="{Binding MaskIndex}"
                                                Header="MaskIndex" />
                                <GridViewColumn Width="150" Header="Description">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type reticleMask:ReticleMarkItemDto}">
                                            <hc:SimplePanel>
                                                <TextBlock Text="{Binding Remark}"
                                                           MinWidth="120"
                                                           IsEnabled="False" />
                                            </hc:SimplePanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="200" Header="Mask Type">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type reticleMask:ReticleMarkItemDto}">
                                            <hc:SimplePanel>
                                                <hc:ComboBox Margin="5"
                                                             HorizontalAlignment="Left"
                                                             hc:InfoElement.TitlePlacement="Left"
                                                             IsEnabled="False"
                                                             ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type waferEnum:WaferMaskTypeEnum}}}"
                                                             SelectedItem="{Binding ReticleMaskTypeEnum}">
                                                    <hc:ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                        </DataTemplate>
                                                    </hc:ComboBox.ItemTemplate>
                                                </hc:ComboBox>
                                            </hc:SimplePanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="300" Header="Position">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type reticleMask:ReticleMarkItemDto}">
                                            <Grid Width="220">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="MasktextBox" Grid.Column="0"
                                                         Text="{Binding MaskWaferCellPosition, Converter={StaticResource PointToStringConverter}}"
                                                         Margin="0,0,-1,0"
                                                         hc:BorderElement.CornerRadius="4,0,0,4"
                                                         IsReadOnly="True" />
                                                <Button Grid.Column="1"
                                                        Content="Get"
                                                        Command="{Binding DataContext.GetMaskReticlePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Height="{Binding Height, ElementName=MasktextBox}"
                                                        hc:BorderElement.CornerRadius="0,0,0,0"
                                                        Style="{StaticResource ButtonDefault}"
                                                        ToolTipService.InitialShowDelay="500"
                                                        ToolTipService.Placement="Right"
                                                        ToolTipService.ShowDuration="5000">
                                                    <Button.ToolTip>
                                                        <ToolTip>
                                                            <ToolTip.Content>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Please move to the origin cell to get the cell position" Margin="5,0,0,0" />
                                                                </StackPanel>
                                                            </ToolTip.Content>
                                                            <ToolTip.Style>
                                                                <Style TargetType="ToolTip">
                                                                    <Setter Property="Background" Value="White" />
                                                                    <Setter Property="Foreground" Value="LightGray" />
                                                                    <Setter Property="FontSize" Value="14" />
                                                                </Style>
                                                            </ToolTip.Style>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Content="Goto"
                                                        Command="{Binding DataContext.GotoMaskReticlePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Height="{Binding Height, ElementName=MasktextBox}"
                                                        hc:BorderElement.CornerRadius="0,4,4,0"
                                                        Style="{StaticResource ButtonDefault}" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="350" Header="Bright Template">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type reticleMask:ReticleMarkItemDto}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <hc:ComboBox Margin="5"
                                                             HorizontalAlignment="Center"
                                                             hc:InfoElement.Title="Microscope Type: "
                                                             hc:InfoElement.TitlePlacement="Left"
                                                             IsEnabled="False"
                                                             ItemsSource="{Binding DataContext.ApplicationCookie.MicroscopeLensInformations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             SelectedItem="{Binding RecipeBrightFieldTemplateDto.MicroscopeLensInformation}">
                                                    <hc:ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding LensName}" />
                                                        </DataTemplate>
                                                    </hc:ComboBox.ItemTemplate>
                                                </hc:ComboBox>
                                                <view:CanvasView Grid.Row="1"
                                                                 Width="200"
                                                                 Height="200"
                                                                 Margin="5"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Stretch"
                                                                 AxisColor="Red"
                                                                 BackgroundColor="#0A0A0A"
                                                                 BackgroundImage="{Binding Text, ElementName=TemplateImagePathTextbox, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                 Interactive="True"
                                                                 ShowAxes="True"
                                                                 ShowCursor="False"
                                                                 ShowGrid="False" />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TemplateImagePathTextbox"
                                                             Text="{Binding RecipeBrightFieldTemplateDto.TemplateImageFilePath}"
                                                             Margin="0,0,-1,0"
                                                             hc:BorderElement.CornerRadius="4,0,0,4"
                                                             hc:InfoElement.TitlePlacement="Left"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.LoadBrightImageFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Height="{Binding Height, ElementName=TemplateImagePathTextbox}"
                                                            Padding="5"
                                                            hc:BorderElement.CornerRadius="0,0,0,0"
                                                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                            hc:IconElement.Width="30"
                                                            Style="{StaticResource ButtonDefault}" />
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.GenerateBrightTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Height="{Binding Height, ElementName=TemplateImagePathTextbox}"
                                                            Padding="5"
                                                            hc:BorderElement.CornerRadius="0,4,4,0"
                                                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                                                            hc:IconElement.Width="30"
                                                            Style="{StaticResource ButtonDefault}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="700" Header="Dark Template">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type reticleMask:ReticleMarkItemDto}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <UniformGrid Rows="2">
                                                    <hc:ComboBox Margin="2"
                                                                 hc:InfoElement.Title="Productivity: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 IsEnabled="False"
                                                                 ItemsSource="{Binding DataContext.ApplicationCookie.ProductivityInformations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 SelectedItem="{Binding RecipeDarkFieldTemplateDto.ProductivityInformation}" />
                                                    <hc:ComboBox Margin="2"
                                                                 hc:InfoElement.Title="CIB Information: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 IsEnabled="False"
                                                                 ItemsSource="{Binding DataContext.ApplicationCookie.CIBInformations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 SelectedItem="{Binding RecipeDarkFieldTemplateDto.CIBInformation}" />
                                                    <hc:ComboBox Margin="2"
                                                                 hc:InfoElement.Title="Laser Light Information: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 IsEnabled="False"
                                                                 ItemsSource="{Binding DataContext.ApplicationCookie.LaserLightInformations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 SelectedItem="{Binding RecipeDarkFieldTemplateDto.LaserLightInformation}" />
                                                    <Grid>
                                                        <ToggleButton x:Name="ToggleButtonCIBConfiguration"
                                                                      Content="CIB Configuration"
                                                                      Margin="0,2"
                                                                      HorizontalAlignment="Left"
                                                                      hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                                        <Popup StaysOpen="False"
                                                               PlacementTarget="{Binding ElementName=ToggleButtonCIBConfiguration}"
                                                               Placement="Right"
                                                               AllowsTransparency="True"
                                                               PopupAnimation="Slide"
                                                               IsOpen="{Binding IsChecked, ElementName=ToggleButtonCIBConfiguration, Mode=TwoWay}">
                                                            <Border Style="{StaticResource BorderRegion}">
                                                                <pattern:CIBConfigurationUserControl DataContext="{Binding RecipeDarkFieldTemplateDto.CIBConfiguration}" />
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </UniformGrid>

                                                <view:CanvasView Grid.Row="1"
                                                                 Width="200"
                                                                 Height="200"
                                                                 Margin="5"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Stretch"
                                                                 AxisColor="Red"
                                                                 BackgroundColor="#0A0A0A"
                                                                 BackgroundImage="{Binding Text, ElementName=DarkTemplateImagePathTextbox, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                 Interactive="True"
                                                                 ShowAxes="True"
                                                                 ShowCursor="False"
                                                                 ShowGrid="False" />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="500" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="DarkTemplateImagePathTextbox"
                                                             Text="{Binding RecipeDarkFieldTemplateDto.TemplateImageFilePath}"
                                                             Margin="0,0,-1,0"
                                                             hc:BorderElement.CornerRadius="4,0,0,4"
                                                             hc:InfoElement.TitlePlacement="Left"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.LoadDarkImageFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Height="{Binding Height, ElementName=DarkTemplateImagePathTextbox}"
                                                            Padding="5"
                                                            hc:BorderElement.CornerRadius="0,0,0,0"
                                                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                            hc:IconElement.Width="30"
                                                            Style="{StaticResource ButtonDefault}" />
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.GenerateDarkTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Height="{Binding Height, ElementName=DarkTemplateImagePathTextbox}"
                                                            Padding="5"
                                                            hc:BorderElement.CornerRadius="0,4,4,0"
                                                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                                                            hc:IconElement.Width="30"
                                                            Style="{StaticResource ButtonDefault}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>

