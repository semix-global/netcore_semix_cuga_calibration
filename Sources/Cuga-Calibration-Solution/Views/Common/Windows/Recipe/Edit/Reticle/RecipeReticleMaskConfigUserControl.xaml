<UserControl x:Class="CugaCalibration.Views.Common.Windows.Recipe.Edit.Reticle.RecipeReticleMaskConfigUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:reticleMask="clr-namespace:Core.Recipe.Models.Wafer.ReticleMask;assembly=Core.Recipe"
             xmlns:waferEnum="clr-namespace:Core.Models.Enums.Recipe.Wafer;assembly=Core.Models"
             xmlns:children1="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Recipe.Edit.Children"
             xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=children1:RecipeReticleMaskViewModel,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="1000"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <!--  Tab 仅作切换，无 Content  -->
            <TabControl Grid.Row="0"
                        Margin="5"
                        Style="{StaticResource TabControlCapsuleSolid}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding MaskTypeChangedCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="Loaded">
                        <i:InvokeCommandAction Command="{Binding LoadingCommand}" CommandParameter="Microscope" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TabItem Header="Microscope" />
                <TabItem Header="Chuck" />
                <TabItem Header="Laser" />
            </TabControl>

            <!--  统一 ListView，绑定 EditReticleMarkList  -->
            <Border Grid.Row="1"
                    Margin="5"
                    Effect="{StaticResource EffectShadow1}"
                    Style="{StaticResource BorderRegion}">
                <ListView ItemsSource="{Binding EditReticleMarkList}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectReticleMarkItem}"
                          Style="{StaticResource ListView.Small}">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="50"
                                            DisplayMemberBinding="{Binding MaskIndex}"
                                            Header="MaskIndex" />
                            <GridViewColumn Width="150" Header="description">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type reticleMask:ReticleMarkItemDto}">
                                        <hc:SimplePanel>
                                            <TextBox Text="{Binding Remark}" MinWidth="120" />
                                        </hc:SimplePanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" Header="Mask Type">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type reticleMask:ReticleMarkItemDto}">
                                        <hc:SimplePanel>
                                            <hc:ComboBox Margin="5"
                                                         HorizontalAlignment="Left"
                                                         hc:InfoElement.TitlePlacement="Left"
                                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type waferEnum:WaferMaskTypeEnum}}}"
                                                         SelectedItem="{Binding ReticleMaskTypeEnum}">
                                                <hc:ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                    </DataTemplate>
                                                </hc:ComboBox.ItemTemplate>
                                            </hc:ComboBox>
                                        </hc:SimplePanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="350" Header="Bright Template">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type reticleMask:ReticleMarkItemDto}">
                                        <hc:ComboBox Margin="5"
                                                     HorizontalAlignment="Left"
                                                     hc:InfoElement.Title="Microscope Type: "
                                                     hc:InfoElement.TitlePlacement="Left"
                                                     ItemsSource="{Binding DataContext.ApplicationCookie.MicroscopeLensInformations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     SelectedItem="{Binding RecipeBrightFieldTemplateDto.MicroscopeLensInformation}">
                                            <hc:ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LensName}" />
                                                </DataTemplate>
                                            </hc:ComboBox.ItemTemplate>
                                        </hc:ComboBox>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Dark Template">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type reticleMask:ReticleMarkItemDto}">
                                        <UniformGrid Rows="2">
                                            <hc:ComboBox Margin="2"
                                                         hc:InfoElement.Title="Productivity: "
                                                         hc:InfoElement.TitlePlacement="Left"
                                                         ItemsSource="{Binding DataContext.ApplicationCookie.ProductivityInformations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         SelectedItem="{Binding RecipeDarkFieldTemplateDto.ProductivityInformation}" />
                                            <hc:ComboBox Margin="2"
                                                         hc:InfoElement.Title="CIB Information: "
                                                         hc:InfoElement.TitlePlacement="Left"
                                                         ItemsSource="{Binding DataContext.ApplicationCookie.CIBInformations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         SelectedItem="{Binding RecipeDarkFieldTemplateDto.CIBInformation}" />
                                            <hc:ComboBox Margin="2"
                                                         hc:InfoElement.Title="Laser Light Information: "
                                                         hc:InfoElement.TitlePlacement="Left"
                                                         ItemsSource="{Binding DataContext.ApplicationCookie.LaserLightInformations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         SelectedItem="{Binding RecipeDarkFieldTemplateDto.LaserLightInformation}" />
                                            <Grid>
                                                <ToggleButton x:Name="ToggleButtonCIBConfiguration"
                                                              Content="CIB Configuration"
                                                              Margin="0,2"
                                                              HorizontalAlignment="Left"
                                                              hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                                <Popup StaysOpen="False"
                                                       PlacementTarget="{Binding ElementName=ToggleButtonCIBConfiguration}"
                                                       Placement="Right"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Slide"
                                                       IsOpen="{Binding IsChecked, ElementName=ToggleButtonCIBConfiguration, Mode=TwoWay}">
                                                    <Border Style="{StaticResource BorderRegion}">
                                                        <pattern:CIBConfigurationUserControl DataContext="{Binding RecipeDarkFieldTemplateDto.CIBConfiguration}" />
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </UniformGrid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!--  Add / Delete 按钮  -->
            <hc:SimplePanel Grid.Row="2">
                <Button Content="Add Mask"
                        Command="{Binding AddMaskCommand}"
                        Height="50"
                        Margin="5"
                        hc:IconElement.Geometry="{StaticResource AddGeometry}"
                        FontSize="15"
                        Style="{StaticResource ButtonSuccess}" />
                <Button Content="Delete Mask"
                        Command="{Binding DeleteMaskCommand}"
                        Height="50"
                        Margin="5"
                        HorizontalAlignment="Right"
                        hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                        FontSize="15"
                        Style="{StaticResource ButtonDanger}" />
            </hc:SimplePanel>
        </Grid>
    </Border>
</UserControl>