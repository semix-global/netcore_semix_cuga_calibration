<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Recipe.Edit.RecipeSettingWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:common="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.Edit.Common"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:reticle="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.Edit.Reticle"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:waferMap="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.Edit.WaferMap"
           xmlns:alignment="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.Edit.Alignment"
           xmlns:edit1="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Recipe.Edit"
           xmlns:children="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Recipe.Edit.Children"
           Title="System Management"
           d:DataContext="{d:DesignInstance Type=edit1:RecipeSettingViewModel}"
           d:DesignHeight="1500"
           d:DesignWidth="1200"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowState="Normal"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Recipe Setting"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TabControl SelectedItem="{Binding EditRecipeTypeObj}" TabStripPlacement="Left">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding DataContext.ParamTypeChangedCommand, RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                               PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TabItem Height="50"
                         VerticalAlignment="Bottom"
                         BorderThickness="5"
                         Header="Common">
                    <hc:ScrollViewer>
                        <common:RecipeCommonSettingUserControl DataContext="{Binding DataContext.RecipeCommonSettingViewModel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}" />
                    </hc:ScrollViewer>
                </TabItem>
                <TabItem Height="50"
                         VerticalAlignment="Bottom"
                         BorderThickness="5"
                         Header="Alignment">
                    <TabControl TabStripPlacement="Left" SelectionChanged="AlignmentTabControl_SelectionChanged">
                        <TabItem Height="50"
                                 BorderThickness="3"
                                 Header="Find Wafer Center">
                            <alignment:RecipeFindWaferBrightFieldCenterUserControl DataContext="{Binding DataContext.RecipeAlignmentViewModel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}" />
                        </TabItem>
                        <TabItem Height="50"
                                 BorderThickness="3"
                                 Header="Bright Field Alignment">
                            <alignment:RecipeBrightFieldAlignmentUserControl DataContext="{Binding DataContext.RecipeAlignmentViewModel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}" />
                        </TabItem>
                        <TabItem Height="50"
                                 BorderThickness="3"
                                 Header="Dark Field Alignment">
                            <alignment:RecipeDarkFieldAlignmentUserControl DataContext="{Binding DataContext.RecipeAlignmentViewModel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}" />
                        </TabItem>

                    </TabControl>
                </TabItem>
                <TabItem Height="50"
                         MinWidth="180"
                         BorderThickness="5"
                         Header="Wafer"
                         IsEnabled="{Binding IsEditWaferMapEnable}">
                    <waferMap:RecipeWaferSettingUserControl DataContext="{Binding DataContext.RecipeWaferMapViewModel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}" />
                </TabItem>
                <TabItem Height="50"
                         BorderThickness="5"
                         Header="Reticle Mask Config"
                         IsEnabled="{Binding IsEditWaferMapEnable}">
                    <reticle:RecipeReticleMaskConfigUserControl DataContext="{Binding DataContext.RecipeReticleMaskViewModel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}" />
                </TabItem>
                <TabItem Height="50"
                         BorderThickness="5"
                         Header="Reticle Mask"
                         IsEnabled="{Binding IsEditWaferMapEnable}">
                    <reticle:RecipeReticleMaskUserControl DataContext="{Binding DataContext.RecipeReticleMaskViewModel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}" />
                </TabItem>
            </TabControl>
            <hc:SimplePanel Grid.Row="1" Margin="10">
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Height="40"
                        HorizontalAlignment="Right"
                        hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                        FontSize="20"
                        Style="{StaticResource ButtonPrimary}" />
            </hc:SimplePanel>
        </Grid>
    </Grid>
</hc:Window>