<UserControl x:Class="CugaCalibration.Views.Common.Windows.Recipe.Edit.Alignment.RecipeFindWaferBrightFieldCenterUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
             xmlns:children="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Recipe.Edit.Children"
             d:DataContext="{d:DesignInstance Type=children:RecipeAlignmentViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Find Wafer Center by Manually" Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox x:Name="ThresholdTextBox"
                             Text="{Binding Cache.PositionErrorThreshold, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:TitleElement.Title="Position Error Threshold(um):"
                             hc:TitleElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding FindWaferCenterByManuallyWindowViewModel.Cache.OffsetPosition, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:TitleElement.Title="Center offset position:"
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding FindWaferCenterCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding FindWaferCenterCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <Grid Grid.Column="2">
            <views:FindWaferCenterByManuallyUserControl DataContext="{Binding FindWaferCenterByManuallyWindowViewModel}" />
        </Grid>
    </Grid>
</UserControl>