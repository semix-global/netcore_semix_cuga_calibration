<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Recipe.CalChip.CalChipRecipeSettingWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:calChip="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Recipe.CalChip"
           xmlns:calChipViews="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.CalChip"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:alignment="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.Edit.Alignment"
           xmlns:waferMap="clr-namespace:CugaCalibration.Views.Common.Windows.Recipe.Edit.WaferMap"
           xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           Title="CalChip Recipe Setting"
           d:DataContext="{d:DesignInstance Type=calChip:CalChipRecipeSettingViewModel}"
           d:DesignHeight="1500"
           d:DesignWidth="1200"
           attachedHelper:LoadingHelper.IsShow="{Binding IsLoading}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowState="Normal"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="CalChip Recipe Setting"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  第一级 TabControl: CalChip 类型选择（只显示标签）  -->
                <TabControl Grid.Column="0"
                            SelectedItem="{Binding SelectedCalChipTab}"
                            TabStripPlacement="Left">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding DataContext.CalChipSiteModelEnumChangedCommand, RelativeSource={RelativeSource AncestorType=hc:Window}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <TabControl.ContentTemplate>
                        <!--  隐藏内容区，只显示标签  -->
                        <DataTemplate />
                    </TabControl.ContentTemplate>

                    <TabItem Height="50"
                             BorderThickness="5"
                             Header="DSW" />
                    <TabItem Height="50"
                             BorderThickness="5"
                             Header="Haze" />
                    <TabItem Height="50"
                             BorderThickness="5"
                             Header="ShinyWafer" />
                    <TabItem Height="50"
                             BorderThickness="5"
                             Header="Undefined" />
                </TabControl>

                <!--  第二级 TabControl: 操作菜单（共享实例，只创建一次）  -->
                <TabControl Grid.Column="1"
                            SelectedItem="{Binding SelectedOperationTab}"
                            SelectedIndex="{Binding SelectedOperationTabIndex}"
                            TabStripPlacement="Left">

                    <!--  Alignment Tab  -->
                    <TabItem Height="50"
                             BorderThickness="3"
                             Header="Alignment">
                        <hc:UniformSpacingPanel Width="400"
                                                Margin="5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Orientation="Vertical"
                                                Spacing="10">
                            <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                                <tools:AlignmentUserControl DataContext="{Binding CalChipAlignmentViewModel.AlignmentUserControlViewModel}" />
                            </Border>
                            <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Margin="5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Spacing="10">
                                    <Button Command="{Binding CalChipAlignmentViewModel.BrightFiledMarkSitesCommand}" Style="{StaticResource ButtonSuccess}">
                                        <hc:UniformSpacingPanel Spacing="5">
                                            <!-- <iconPacks:PackIconFontAwesome Kind="PenToSquareSolid" /> -->
                                            <TextBlock Text="Mark Sites" />
                                        </hc:UniformSpacingPanel>
                                    </Button>
                                    <Button x:Name="ActionButton"
                                            Content="Action"
                                            Command="{Binding CalChipAlignmentViewModel.BrightFiledAlignmentCommand}"
                                            Height="28"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                            Style="{StaticResource ButtonPrimary.Loading}" />
                                    <Button x:Name="CancelButton"
                                            Content="Cancel"
                                            Command="{Binding CalChipAlignmentViewModel.BrightFiledAlignmentCancelCommand}"
                                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                            Style="{StaticResource ButtonWarning}" />
                                </hc:UniformSpacingPanel>
                            </Border>

                        </hc:UniformSpacingPanel>
                    </TabItem>

                    <!--  Wafer Tab  -->
                    <TabItem Height="50"
                             BorderThickness="3"
                             Header="Wafer"
                             IsEnabled="{Binding IsEditWaferMapEnable}">
                        <waferMap:RecipeWaferSettingUserControl DataContext="{Binding CalChipWaferMapViewModel.RecipeWaferSettingUserControlViewModel}" />
                    </TabItem>

                    <!--  Reticle Mask Tab  -->
                    <TabItem Height="50"
                             BorderThickness="3"
                             Header="Reticle Mask"
                             IsEnabled="{Binding IsEditWaferMapEnable}">
                        <calChipViews:CalChipReticleMaskUserControl DataContext="{Binding CalChipReticleMaskViewModel}" />
                    </TabItem>
                </TabControl>
            </Grid>

            <hc:SimplePanel Grid.Row="1" Margin="10">
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Height="40"
                        HorizontalAlignment="Right"
                        hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                        FontSize="20"
                        Style="{StaticResource ButtonPrimary}" />
            </hc:SimplePanel>
        </Grid>
    </Grid>
</hc:Window>