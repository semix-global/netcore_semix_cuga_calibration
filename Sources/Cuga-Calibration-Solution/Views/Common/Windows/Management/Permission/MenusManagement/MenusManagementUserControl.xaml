<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Permission.MenusManagement.MenusManagementUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Permission"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:converters="clr-namespace:Net.Utilities.WPF.Converters;assembly=Net.Utilities.WPF"
             xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
             xmlns:controls="clr-namespace:WPF.CustomControl.UI.PermissionMenuTreeView;assembly=WPF.CustomControl"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:dbEnum="clr-namespace:Local.SQL.DB.Providers.Models.Enums;assembly=Local.SQL.DB.Providers"
             d:DataContext="{d:DesignInstance Type=viewModels:MenusManagementViewModel}"
             wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
             d:DesignHeight="700"
             d:DesignWidth="900"
             BorderBrush="{StaticResource PrimaryBrush}"
             BorderThickness="2"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Padding="2" Style="{StaticResource BorderRegion}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.ColumnSpan="2"
                    BorderThickness="0,0,0,1"
                    BorderBrush="LightGray">
                <hc:UniformSpacingPanel Margin="10,10,10,10"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        IsEnabled="{Binding IsEnableWindow}">
                    <TextBox Text="{Binding OperateSysMenuDto.Name}"
                             Width="auto"
                             MinWidth="180"
                             Margin="0,0,5,0"
                             hc:InfoElement.Title="Menu Name: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding OperateSysMenuDto.Perms}"
                             Width="auto"
                             MinWidth="150"
                             Margin="0,0,5,0"
                             hc:InfoElement.Title="Perms: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding OperateSysMenuDto.Component}"
                             Width="auto"
                             MinWidth="200"
                             Margin="0,0,5,0"
                             hc:InfoElement.Title="Component: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:ComboBox MinWidth="150"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Menu Type: "
                                 SelectedItem="{Binding OperateSysMenuDto.MenuTypeEnum, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type dbEnum:MenuTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumDescriptionConverter.Instance}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox x:Name="EnableStatus"
                                 Width="auto"
                                 MinWidth="170"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="EnableStatus: "
                                 SelectedItem="{Binding OperateSysMenuDto.IsEnabled, Converter={StaticResource EnumDescriptionToEnableConverter}, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type dbEnum:EnableStatusEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumDescriptionConverter.Instance}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                </hc:UniformSpacingPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <controls:PermissionMenuTreeView HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 IsCheckBoxEnabled="{Binding OperateCommandIndex}"
                                                 ItemsSource="{Binding MenuTreeList}" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>