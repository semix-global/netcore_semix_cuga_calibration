<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Permission.RolesManagement.RolesManagementUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Permission"
             xmlns:childrenView="clr-namespace:CugaCalibration.Views.Common.Windows.Management.Permission.RolesManagement.Children"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:converters="clr-namespace:Net.Utilities.WPF.Converters;assembly=Net.Utilities.WPF"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:dataScope="clr-namespace:Local.SQL.DB.Providers.Models.Enums;assembly=Local.SQL.DB.Providers"
             wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
             d:DataContext="{d:DesignInstance Type=viewModels:RolesManagementViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Padding="2"
            Style="{StaticResource BorderRegion}"
            BorderBrush="Blue">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.ColumnSpan="2"
                    BorderThickness="0,0,0,1"
                    BorderBrush="LightGray">
                <hc:UniformSpacingPanel Margin="10"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        IsEnabled="{Binding IsEnableWindow}">

                    <TextBox Text="{Binding OperateSysRoleDto.Name}"
                             Width="auto"
                             MinWidth="180"
                             Margin="0,0,5,0"
                             hc:InfoElement.Title="UserName: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:ComboBox Width="auto"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Data Scope: "
                                 hc:InfoElement.Necessary="True"
                                 Visibility="Hidden"
                                 SelectedItem="{Binding OperateSysRoleDto.DataScopeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type dataScope:DataScopeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                </hc:UniformSpacingPanel>
            </Border>

            <Grid Grid.Row="1" Grid.Column="0">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding RoleList}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          BorderThickness="0"
                          IsEnabled="{Binding IsEnableWindow}"
                          SelectedItem="{Binding SelectSysRoleDto}"
                          Style="{StaticResource ListView.Small}"
                          Background="White"
                          Visibility="{Binding IsAssignMenu, Converter={StaticResource IntIs0ToVisibilityConverter}}">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />

                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="120"
                                            Header="Id"
                                            DisplayMemberBinding="{Binding Id}" />
                            <GridViewColumn Width="150"
                                            Header="Name"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Width="100"
                                            Header="DataScope"
                                            DisplayMemberBinding="{Binding DataScopeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Width="150"
                                            Header="Remark"
                                            DisplayMemberBinding="{Binding Remark}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsAssignMenu, Converter={StaticResource IntIs1ToVisibilityConverter}}">
                    <childrenView:AssignMenuView />
                </ScrollViewer>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <childrenView:EditView Visibility="{Binding OperateCommandIndex, Converter={StaticResource IntIs1ToVisibilityConverter}}" />
                <childrenView:EditView Visibility="{Binding OperateCommandIndex, Converter={StaticResource IntIs2ToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>