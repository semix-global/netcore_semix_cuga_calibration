<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Permission.DepartmentsManagement.Children.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:valueConverters="clr-namespace:ValueConverters;assembly=ValueConverters"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Permission"
             d:DataContext="{d:DesignInstance Type=viewModels:DepartmentsManagementViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="300"
             mc:Ignorable="d">
    <UserControl.Resources>
        <valueConverters:IntegerToBoolConverter x:Key="IntIs1ToEnableConverter"
                                                TrueValue="1"
                                                FalseValue="2" />
    </UserControl.Resources>
    <Grid>
        <Border Padding="2" Style="{StaticResource BorderRegion}">
            <hc:UniformSpacingPanel Grid.ColumnSpan="2"
                                    Margin="5,5,5,5"
                                    VerticalAlignment="Top"
                                    Orientation="Vertical"
                                    Spacing="5">
                <hc:SimplePanel Margin="0,0,0,5" Background="{StaticResource PrimaryBrush}">
                    <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                                VerticalAlignment="Center"
                                Background="Transparent">
                        <TextBlock Text="Property"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Style="{StaticResource TextBlockDefault}" />
                    </StackPanel>
                </hc:SimplePanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding OperateSysDeptDto.Parent.Name, Mode=OneWay}"
                             Width="auto"
                             Margin="0,0,0,0"
                             hc:BorderElement.CornerRadius="4,0,0,4"
                             hc:TitleElement.TitleWidth="120"
                             hc:InfoElement.Title="Parent Department: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <Button Grid.Column="1"
                            Command="{Binding ToggleSetParentDepartmentModeCommand}"
                            Width="30"
                            Padding="3"
                            hc:BorderElement.CornerRadius="0,0,0,0"
                            hc:IconElement.Width="30">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTreeViewEnabled}" Value="false">
                                        <Setter Property="hc:IconElement.Geometry" Value="{StaticResource EyeCloseGeometry}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTreeViewEnabled}" Value="true">
                                        <Setter Property="hc:IconElement.Geometry" Value="{StaticResource EyeOpenGeometry}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2"
                            Command="{Binding SetDefaultParentDepartmentCommand}"
                            Width="30"
                            Padding="3"
                            hc:BorderElement.CornerRadius="0,4,4,0"
                            hc:IconElement.Width="30"
                            hc:IconElement.Geometry="{StaticResource RotateRightGeometry}" />
                </Grid>
                <hc:ComboBox Width="auto"
                             Margin="0,0,5,0"
                             HorizontalAlignment="Left"
                             hc:TitleElement.TitleWidth="120"
                             hc:InfoElement.TitlePlacement="Left"
                             hc:InfoElement.Title="Parent Department: "
                             SelectedItem="{Binding OperateSysDeptDto.Parent, UpdateSourceTrigger=PropertyChanged}"
                             ItemsSource="{Binding DeptTreeList}"
                             Visibility="Collapsed"
                             IsEnabled="{Binding OperateCommandIndex, Converter={StaticResource IntIs1ToEnableConverter}}">
                    <hc:ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </hc:ComboBox.ItemTemplate>
                </hc:ComboBox>

                <TextBox x:Name="DepartmentNameTextBox"
                         Text="{Binding OperateSysDeptDto.Name}"
                         Width="auto"
                         Margin="0,0,5,0"
                         hc:TitleElement.TitleWidth="120"
                         hc:InfoElement.Title="Department Name: "
                         hc:InfoElement.TitlePlacement="Left"
                         Style="{StaticResource TextBoxExtend}" />
                <TextBox Text="{Binding OperateSysDeptDto.Remark}"
                         Width="auto"
                         Margin="0,0,5,0"
                         hc:TitleElement.TitleWidth="120"
                         hc:InfoElement.Title="Remark: "
                         hc:InfoElement.TitlePlacement="Left"
                         Style="{StaticResource TextBoxExtend}" />
                <hc:ComboBox x:Name="LeaderName"
                             Width="auto"
                             Margin="0,0,5,0"
                             HorizontalAlignment="Left"
                             hc:TitleElement.TitleWidth="120"
                             hc:InfoElement.TitlePlacement="Left"
                             hc:InfoElement.Title="LeaderName: "
                             SelectedItem="{Binding SelectSysUserDto, UpdateSourceTrigger=PropertyChanged}"
                             ItemsSource="{Binding UserList}">
                    <hc:ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UserName}" />
                        </DataTemplate>
                    </hc:ComboBox.ItemTemplate>
                </hc:ComboBox>
                <hc:SimplePanel>
                    <Button Content="Apply"
                            Command="{Binding ApplyCommandCommand}"
                            Width="80"
                            HorizontalAlignment="Center"
                            Style="{StaticResource ButtonSuccess}" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Width="80"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ButtonDanger}" />
                </hc:SimplePanel>
            </hc:UniformSpacingPanel>
        </Border>
    </Grid>
</UserControl>