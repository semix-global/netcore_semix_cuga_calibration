<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Permission.DepartmentsManagement.DepartmentsManagementUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:childrenView="clr-namespace:CugaCalibration.Views.Common.Windows.Management.Permission.DepartmentsManagement.Children"
             xmlns:controls="clr-namespace:WPF.CustomControl.UI.DepartmentTreeView;assembly=WPF.CustomControl"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dbEnum="clr-namespace:Local.SQL.DB.Providers.Models.Enums;assembly=Local.SQL.DB.Providers"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Permission"
             xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
             d:DataContext="{d:DesignInstance Type=viewModels:DepartmentsManagementViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="900"
             wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
             BorderBrush="{StaticResource PrimaryBrush}"
             BorderThickness="2"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Padding="2" Style="{StaticResource BorderRegion}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.ColumnSpan="2"
                    BorderBrush="LightGray"
                    BorderThickness="0,0,0,1">
                <hc:UniformSpacingPanel Margin="10,10,10,10"
                                        VerticalAlignment="Top"
                                        IsEnabled="{Binding IsEnableWindow}"
                                        Orientation="Horizontal"
                                        Spacing="5">
                    <TextBox Text="{Binding OperateSysDeptDto.Name}"
                             Width="auto"
                             MinWidth="200"
                             Margin="0,0,5,0"
                             hc:TitleElement.Title="DepartmentName: "
                             hc:TitleElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:ComboBox x:Name="LeaderName"
                                 Width="auto"
                                 MinWidth="200"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Left"
                                 hc:TitleElement.Title="LeaderName: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 ItemsSource="{Binding UserList}"
                                 SelectedItem="{Binding SelectSysUserDto, UpdateSourceTrigger=PropertyChanged}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UserName}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox x:Name="EnableStatus"
                                 Width="auto"
                                 MinWidth="180"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Left"
                                 hc:TitleElement.Title="EnableStatus: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type dbEnum:EnableStatusEnum}}}"
                                 SelectedItem="{Binding OperateSysDeptDto.IsEnabled, Converter={StaticResource EnumDescriptionToEnableConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                </hc:UniformSpacingPanel>
            </Border>

            <Grid Grid.Row="1" Grid.Column="0">
                <controls:DepartmentTreeView x:Name="DepartmentTreeView"
                                             Grid.ColumnSpan="2"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             IsCheckBoxEnabled="0"
                                             IsEnabled="{Binding IsTreeViewEnabled}"
                                             ItemsSource="{Binding DeptTreeList}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <childrenView:EditView Visibility="{Binding OperateCommandIndex, Converter={StaticResource IntIs1ToVisibilityConverter}}" />
                <childrenView:EditView Visibility="{Binding OperateCommandIndex, Converter={StaticResource IntIs2ToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>