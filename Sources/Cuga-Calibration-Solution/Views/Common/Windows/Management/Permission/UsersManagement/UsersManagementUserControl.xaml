<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Permission.UsersManagement.UsersManagementUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:childrenView="clr-namespace:CugaCalibration.Views.Common.Windows.Management.Permission.UsersManagement.Children"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Permission"
             xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:dbEnum="clr-namespace:Local.SQL.DB.Providers.Models.Enums;assembly=Local.SQL.DB.Providers"
             d:DataContext="{d:DesignInstance Type=viewModels:UsersManagementViewModel}"
             wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             BorderBrush="{StaticResource PrimaryBrush}"
             BorderThickness="2"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Padding="2" Style="{StaticResource BorderRegion}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.ColumnSpan="2"
                    BorderThickness="0,0,0,1"
                    BorderBrush="LightGray">
                <hc:UniformSpacingPanel Margin="10"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        IsEnabled="{Binding IsEnableWindow}">
                    <TextBox Text="{Binding OperateSysUserDto.Id}"
                             Width="auto"
                             MinWidth="150"
                             Margin="0,0,5,0"
                             hc:InfoElement.Title="UserID: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding OperateSysUserDto.UserName}"
                             Width="auto"
                             MinWidth="180"
                             Margin="0,0,5,0"
                             hc:InfoElement.Title="UserName: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:ComboBox x:Name="Department"
                                 Width="auto"
                                 MinWidth="180"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Department: "
                                 SelectedItem="{Binding SelectSysDeptDto, Mode=TwoWay}"
                                 ItemsSource="{Binding DeptList}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox MinWidth="170"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitleWidth="auto"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Sex Type: "
                                 SelectedItem="{Binding OperateSysUserDto.SexEnum, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type dbEnum:SexEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox x:Name="EnableStatus"
                                 Width="auto"
                                 MinWidth="180"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="EnableStatus: "
                                 SelectedItem="{Binding OperateSysUserDto.IsEnabled, Converter={StaticResource EnumDescriptionToEnableConverter}, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type dbEnum:EnableStatusEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                </hc:UniformSpacingPanel>
            </Border>

            <Grid Grid.Row="1" Grid.Column="0">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding UserList}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          IsEnabled="{Binding IsEnableWindow}"
                          Background="White"
                          BorderThickness="0"
                          Style="{StaticResource ListView.Small}"
                          SelectedItem="{Binding SelectSysUserDto}">

                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Background" Value="LightGray" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="120"
                                            Header="Id"
                                            DisplayMemberBinding="{Binding Id}" />
                            <GridViewColumn Width="150"
                                            Header="UserName"
                                            DisplayMemberBinding="{Binding UserName}" />
                            <GridViewColumn Width="120"
                                            Header="DepartmentId"
                                            DisplayMemberBinding="{Binding DeptId}" />
                            <GridViewColumn Width="150"
                                            Header="DepartmentName"
                                            DisplayMemberBinding="{Binding SysDept.Name}" />
                            <GridViewColumn Width="150"
                                            Header="NickName"
                                            DisplayMemberBinding="{Binding NickName}" />
                            <GridViewColumn Width="100"
                                            Header="Sex"
                                            DisplayMemberBinding="{Binding SexEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Width="180"
                                            Header="Email"
                                            DisplayMemberBinding="{Binding Email}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <childrenView:EditView Visibility="{Binding OperateCommandIndex, Converter={StaticResource IntIs1ToVisibilityConverter}}" />
                <childrenView:EditView Visibility="{Binding OperateCommandIndex, Converter={StaticResource IntIs2ToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>