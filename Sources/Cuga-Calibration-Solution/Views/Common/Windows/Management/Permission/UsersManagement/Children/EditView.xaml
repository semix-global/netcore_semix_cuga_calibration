<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Permission.UsersManagement.Children.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Permission"
             xmlns:sex="clr-namespace:Local.SQL.DB.Providers.Models.Enums;assembly=Local.SQL.DB.Providers"
             d:DataContext="{d:DesignInstance Type=viewModels:UsersManagementViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="300"
             mc:Ignorable="d">
    <Grid>
        <Border Padding="2" Style="{StaticResource BorderRegion}">
            <hc:UniformSpacingPanel Grid.ColumnSpan="2"
                                    Margin="5,5,5,5"
                                    VerticalAlignment="Top"
                                    Orientation="Vertical"
                                    Spacing="5">
                <hc:SimplePanel Margin="0,0,0,5" Background="{StaticResource PrimaryBrush}">
                    <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                                VerticalAlignment="Center"
                                Background="Transparent">
                        <TextBlock Text="Property"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Style="{StaticResource TextBlockDefault}" />
                    </StackPanel>
                </hc:SimplePanel>
                <TextBox Text="{Binding OperateSysUserDto.UserName}"
                         Width="auto"
                         Margin="0,0,5,0"
                         hc:TitleElement.TitleWidth="100"
                         hc:InfoElement.Title="User Name: "
                         hc:InfoElement.TitlePlacement="Left"
                         Style="{StaticResource TextBoxExtend}" />
                <TextBox Text="{Binding OperateSysUserDto.NickName}"
                         Width="auto"
                         Margin="0,0,5,0"
                         hc:TitleElement.TitleWidth="100"
                         hc:InfoElement.Title="NickName: "
                         hc:InfoElement.TitlePlacement="Left"
                         Style="{StaticResource TextBoxExtend}" />
                <TextBox Text="{Binding OperateSysUserDto.Remark}"
                         Width="auto"
                         Margin="0,0,5,0"
                         hc:TitleElement.TitleWidth="100"
                         hc:InfoElement.Title="Remark: "
                         hc:InfoElement.TitlePlacement="Left"
                         Style="{StaticResource TextBoxExtend}" />
                <TextBox Text="{Binding OperateSysUserDto.Password}"
                         Width="auto"
                         Margin="0,0,5,0"
                         hc:TitleElement.TitleWidth="100"
                         hc:InfoElement.Title="Password: "
                         hc:InfoElement.TitlePlacement="Left"
                         Visibility="{Binding OperateCommandIndex, Converter={StaticResource IntIs2ToVisibilityConverter}}"
                         Style="{StaticResource TextBoxExtend}" />
                <TextBox Text="{Binding OperateSysUserDto.Email}"
                         Width="auto"
                         Margin="0,0,5,0"
                         hc:TitleElement.TitleWidth="100"
                         hc:InfoElement.Title="Email: "
                         hc:InfoElement.TitlePlacement="Left"
                         Style="{StaticResource TextBoxExtend}" />
                <hc:ComboBox Margin="0,5,0,5"
                             HorizontalAlignment="Left"
                             hc:InfoElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             hc:InfoElement.Title="Sex Type: "
                             SelectedItem="{Binding OperateSysUserDto.SexEnum, UpdateSourceTrigger=PropertyChanged}"
                             ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type sex:SexEnum}}}">
                    <hc:ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionToEnableConverter}}" />
                        </DataTemplate>
                    </hc:ComboBox.ItemTemplate>
                </hc:ComboBox>
                <hc:ComboBox x:Name="Department"
                             Width="auto"
                             Margin="0,5,0,5"
                             HorizontalAlignment="Left"
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             hc:InfoElement.Title="Department: "
                             SelectedItem="{Binding SelectSysDeptDto, UpdateSourceTrigger=PropertyChanged}"
                             ItemsSource="{Binding DeptList}">
                    <hc:ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </hc:ComboBox.ItemTemplate>
                </hc:ComboBox>
                <Expander Margin="0,0,0,10" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="Assign Roles"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </Expander.Header>
                    <hc:UniformSpacingPanel Orientation="Vertical">
                        <ListBox Height="150"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding RoleAllocationList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected}" />
                                        <TextBlock Text="{Binding RoleDto.Name, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </hc:UniformSpacingPanel>
                </Expander>
                <hc:SimplePanel>
                    <Button Content="Apply"
                            Command="{Binding ApplyCommandCommand}"
                            Width="80"
                            HorizontalAlignment="Center"
                            Style="{StaticResource ButtonSuccess}" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Width="80"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ButtonDanger}" />
                </hc:SimplePanel>
            </hc:UniformSpacingPanel>
        </Border>
    </Grid>
</UserControl>