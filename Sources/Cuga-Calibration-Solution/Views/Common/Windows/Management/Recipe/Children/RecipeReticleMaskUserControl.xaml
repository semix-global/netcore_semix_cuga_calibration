<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Recipe.Children.RecipeReticleMaskUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:CugaCalibration.Views.Common.Windows.Management.Recipe.Children"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:dependencyHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:opticsEnum="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:stageSpeedEnum="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             xmlns:waferEnum="clr-namespace:Core.Models.Enums.Recipe.Wafer;assembly=Core.Models"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             d:DesignHeight="1000"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="PositionTemplate">
            <Grid Width="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="textBox" Grid.Column="0"
                         Text="{TemplateBinding Property=Content,
                                                Converter={StaticResource PointToStringConverter}}"
                         Margin="0,0,-1,0"
                         hc:TitleElement.Title="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Converter={StaticResource BindingPathToStringConverter}}"
                         hc:InfoElement.TitlePlacement="Left"
                         hc:BorderElement.CornerRadius="4,0,0,4"
                         Style="{StaticResource TextBoxExtend}" />
                <Button Grid.Column="1"
                        Content="Get"
                        Command="{Binding DataContext.GetMachinePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Converter={StaticResource BindingPathToStringConverter}}"
                        Height="{Binding Height, ElementName=textBox}"
                        Padding="3"
                        hc:BorderElement.CornerRadius="0,0,0,0"
                        hc:IconElement.Width="30"
                        hc:IconElement.Height="30"
                        Style="{StaticResource ButtonDefault}" />
                <Button Grid.Column="2"
                        Content="Goto"
                        Command="{Binding DataContext.GotoMachinePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Converter={StaticResource BindingPathToStringConverter}}"
                        Height="{Binding Height, ElementName=textBox}"
                        Padding="3"
                        hc:BorderElement.CornerRadius="0,4,4,0"
                        hc:IconElement.Width="30"
                        hc:IconElement.Height="30"
                        Style="{StaticResource ButtonDefault}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ReticleMaskViewTemplate">
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <ListView ItemsSource="{TemplateBinding Property=Content}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding DataContext.SelectReticleMarkItem, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="100"
                                                Header="MaskIndex"
                                                DisplayMemberBinding="{Binding MaskIndex}" />
                                <GridViewColumn Width="150" Header="description">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:SimplePanel>
                                                <TextBlock Text="{Binding Remark}"
                                                           MinWidth="120"
                                                           IsEnabled="False" />
                                            </hc:SimplePanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="200" Header="Mask Type">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:SimplePanel>
                                                <hc:ComboBox Margin="5"
                                                             HorizontalAlignment="Left"
                                                             hc:InfoElement.TitlePlacement="Left"
                                                             SelectedItem="{Binding ReticleMaskTypeEnum}"
                                                             IsEnabled="False"
                                                             ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type waferEnum:WaferMaskTypeEnum}}}">
                                                    <hc:ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                        </DataTemplate>
                                                    </hc:ComboBox.ItemTemplate>
                                                </hc:ComboBox>
                                            </hc:SimplePanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="300" Header="Position">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:UniformSpacingPanel Orientation="Horizontal">
                                                <Grid Width="220">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="MasktextBox" Grid.Column="0"
                                                             Text="{Binding MaskWaferCellPosition, Converter={StaticResource PointToStringConverter}}"
                                                             Margin="0,0,-1,0"
                                                             hc:BorderElement.CornerRadius="4,0,0,4"
                                                             IsReadOnly="True" />
                                                    <Button Grid.Column="1"
                                                            Content="Get"
                                                            Command="{Binding DataContext.GetMaskReticlePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentControl, AncestorLevel=3}, Converter={StaticResource BindingPathToStringConverter}}"
                                                            Height="{Binding Height, ElementName=MasktextBox}"
                                                            hc:BorderElement.CornerRadius="0,0,0,0"
                                                            Style="{StaticResource ButtonDefault}"
                                                            ToolTipService.ShowDuration="5000"
                                                            ToolTipService.Placement="Right"
                                                            ToolTipService.InitialShowDelay="500">
                                                        <Button.ToolTip>
                                                            <ToolTip>
                                                                <!--  自定义样式  -->
                                                                <ToolTip.Content>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Please move to the origin cell to get the cell position" Margin="5,0,0,0" />
                                                                    </StackPanel>
                                                                </ToolTip.Content>
                                                                <!--  设置样式属性  -->
                                                                <ToolTip.Style>
                                                                    <Style TargetType="ToolTip">
                                                                        <Setter Property="Background" Value="White" />
                                                                        <Setter Property="Foreground" Value="LightGray" />
                                                                        <Setter Property="FontSize" Value="14" />
                                                                    </Style>
                                                                </ToolTip.Style>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                            Content="Goto"
                                                            Command="{Binding DataContext.GotoMaskReticlePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentControl, AncestorLevel=3}, Converter={StaticResource BindingPathToStringConverter}}"
                                                            Height="{Binding Height, ElementName=MasktextBox}"
                                                            hc:BorderElement.CornerRadius="0,4,4,0"
                                                            Style="{StaticResource ButtonDefault}" />
                                                </Grid>
                                            </hc:UniformSpacingPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="350" Header="Bright Template">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <hc:ComboBox Margin="5"
                                                             HorizontalAlignment="Center"
                                                             hc:InfoElement.TitlePlacement="Left"
                                                             hc:InfoElement.Title="Microscope Type: "
                                                             IsEnabled="False"
                                                             SelectedItem="{Binding RecipeBrightFieldTemplateDto.MicroscopeLensInformation}"
                                                             ItemsSource="{Binding DataContext.ApplicationCookie.MicroscopeLensInformationList, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <hc:ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding LensName}" />
                                                        </DataTemplate>
                                                    </hc:ComboBox.ItemTemplate>
                                                </hc:ComboBox>
                                                <view:CanvasView Grid.Row="1"
                                                                 Width="200"
                                                                 Height="200"
                                                                 Margin="5"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Stretch"
                                                                 BackgroundColor="#0A0A0A"
                                                                 AxisColor="Red"
                                                                 Interactive="True"
                                                                 ShowAxes="True"
                                                                 ShowCursor="False"
                                                                 ShowGrid="False"
                                                                 BackgroundImage="{Binding Text, ElementName=TemplateImagePathTextbox, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TemplateImagePathTextbox"
                                                             Text="{Binding RecipeBrightFieldTemplateDto.TemplateImageFilePath}"
                                                             Margin="0,0,-1,0"
                                                             hc:InfoElement.TitlePlacement="Left"
                                                             hc:BorderElement.CornerRadius="4,0,0,4"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.LoadBrightImageFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentControl, AncestorLevel=3}, Converter={StaticResource BindingPathToStringConverter}}"
                                                            Height="{Binding Height, ElementName=TemplateImagePathTextbox}"
                                                            Padding="5"
                                                            hc:BorderElement.CornerRadius="0,0,0,0"
                                                            hc:IconElement.Width="30"
                                                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                            Style="{StaticResource ButtonDefault}" />
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.GenerateBrightTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentControl, AncestorLevel=3}, Converter={StaticResource BindingPathToStringConverter}}"
                                                            Height="{Binding Height, ElementName=TemplateImagePathTextbox}"
                                                            Padding="5"
                                                            hc:BorderElement.CornerRadius="0,4,4,0"
                                                            hc:IconElement.Width="30"
                                                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                                                            Style="{StaticResource ButtonDefault}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="700" Header="Dark Template">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <hc:UniformSpacingPanel Orientation="Horizontal">
                                                    <hc:ComboBox Margin="5"
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:InfoElement.Title="Optics Type: "
                                                                 IsEnabled="False"
                                                                 SelectedItem="{Binding RecipeDarkFieldTemplateDto.OpticsMagTypeEnum}"
                                                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type opticsEnum:OpticsMagTypeEnum}}}">
                                                        <hc:ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                            </DataTemplate>
                                                        </hc:ComboBox.ItemTemplate>
                                                    </hc:ComboBox>
                                                    <hc:ComboBox Margin="5"
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:InfoElement.Title="Stage Speed: "
                                                                 IsEnabled="False"
                                                                 SelectedItem="{Binding RecipeDarkFieldTemplateDto.StageSpeedEnum}"
                                                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stageSpeedEnum:StageSpeedEnum}}}">
                                                        <hc:ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                            </DataTemplate>
                                                        </hc:ComboBox.ItemTemplate>
                                                    </hc:ComboBox>
                                                </hc:UniformSpacingPanel>
                                                <view:CanvasView Grid.Row="1"
                                                                 Width="200"
                                                                 Height="200"
                                                                 Margin="5"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Stretch"
                                                                 BackgroundColor="#0A0A0A"
                                                                 AxisColor="Red"
                                                                 Interactive="True"
                                                                 ShowAxes="True"
                                                                 ShowCursor="False"
                                                                 ShowGrid="False"
                                                                 BackgroundImage="{Binding Text, ElementName=DarkTemplateImagePathTextbox, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="DarkTemplateImagePathTextbox"
                                                             Text="{Binding RecipeDarkFieldTemplateDto.TemplateImageFilePath}"
                                                             Margin="0,0,-1,0"
                                                             hc:InfoElement.TitlePlacement="Left"
                                                             hc:BorderElement.CornerRadius="4,0,0,4"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.LoadDarkImageFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentControl, AncestorLevel=3}, Converter={StaticResource BindingPathToStringConverter}}"
                                                            Height="{Binding Height, ElementName=DarkTemplateImagePathTextbox}"
                                                            Padding="5"
                                                            hc:BorderElement.CornerRadius="0,0,0,0"
                                                            hc:IconElement.Width="30"
                                                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                            Style="{StaticResource ButtonDefault}" />
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.GenerateDarkTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentControl, AncestorLevel=3}, Converter={StaticResource BindingPathToStringConverter}}"
                                                            Height="{Binding Height, ElementName=DarkTemplateImagePathTextbox}"
                                                            Padding="5"
                                                            hc:BorderElement.CornerRadius="0,4,4,0"
                                                            hc:IconElement.Width="30"
                                                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                                                            Style="{StaticResource ButtonDefault}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0"
                      Grid.RowSpan="2"
                      Margin="10"
                      Header="Reticle Mask">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <local:ReticleMaskView>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding DataContext.LoadedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </local:ReticleMaskView>
                </Border>
            </GroupBox>
            <GridSplitter Grid.Column="1" />
            <TabControl x:Name="tabcontrol" Grid.Column="2"
                        Margin="5"
                        Style="{StaticResource TabControlCapsuleSolid}"
                        DataContext="{Binding DataContext.CalibrationRecipeDto, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding DataContext.MaskTypeChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TabItem Header="Microscope">
                    <ContentControl Content="{Binding DataContext.WaferDto.ReticleMarkDto.MicrosocpeReticleMarkItemList, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    Margin="5"
                                    dependencyHelper:BindingPathHelper.TargetProperty="{x:Static ContentControl.TagProperty}"
                                    Tag="{Binding DataContext.WaferDto.ReticleMarkDto.MicrosocpeReticleMarkItemList, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    ContentTemplate="{DynamicResource ReticleMaskViewTemplate}" />
                </TabItem>
                <TabItem Header="Chuck">
                    <ContentControl Content="{Binding DataContext.WaferDto.ReticleMarkDto.ChuckReticleMarkItemList, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    Margin="5"
                                    dependencyHelper:BindingPathHelper.TargetProperty="{x:Static ContentControl.TagProperty}"
                                    Tag="{Binding DataContext.WaferDto.ReticleMarkDto.ChuckReticleMarkItemList, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    ContentTemplate="{DynamicResource ReticleMaskViewTemplate}" />
                </TabItem>
                <TabItem Header="Laser">
                    <ContentControl Content="{Binding DataContext.WaferDto.ReticleMarkDto.LaserReticleMarkItemList, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    Margin="5"
                                    dependencyHelper:BindingPathHelper.TargetProperty="{x:Static ContentControl.TagProperty}"
                                    Tag="{Binding DataContext.WaferDto.ReticleMarkDto.LaserReticleMarkItemList, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    ContentTemplate="{DynamicResource ReticleMaskViewTemplate}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>