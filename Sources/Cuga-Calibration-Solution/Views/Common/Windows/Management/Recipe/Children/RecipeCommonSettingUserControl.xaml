<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Recipe.Children.RecipeCommonSettingUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:waferEnum="clr-namespace:Core.Models.Enums.Recipe.Wafer;assembly=Core.Models"
             xmlns:algorithmEnum="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:microscopeEnum="clr-namespace:Core.Models.Enums.Microscope;assembly=Core.Models"
             xmlns:cibMode="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Recipe"
             d:DesignHeight="700"
             d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=viewModels:RecipeSettingViewModel}"
             mc:Ignorable="d">
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Row="0" Grid.Column="0"
                      Margin="10"
                      Header="Information">
                <hc:UniformSpacingPanel Orientation="Vertical">
                    <TextBox Text="{Binding CalibrationRecipeDto.CalibrationRecipeInfoDto.RecipeName}"
                             Margin="5"
                             hc:TitleElement.Title="RecipeName"
                             hc:InfoElement.TitlePlacement="Left"
                             hc:BorderElement.CornerRadius="4,0,0,4"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding CalibrationRecipeDto.CalibrationRecipeInfoDto.DescribeName}"
                             Margin="5"
                             hc:TitleElement.Title="Describe"
                             hc:InfoElement.TitlePlacement="Left"
                             hc:BorderElement.CornerRadius="4,0,0,4"
                             Style="{StaticResource TextBoxExtend}" />
                </hc:UniformSpacingPanel>
            </GroupBox>
            <GroupBox Grid.Row="0" Grid.Column="1"
                      Margin="10"
                      Header="Default Type">
                <hc:UniformSpacingPanel Orientation="Vertical">
                    <hc:ComboBox Margin="5"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Wafer Type: "
                                 SelectedItem="{Binding CalibrationRecipeDto.CalibrationRecipeInfoDto.WaferTypeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type algorithmEnum:AlgorithmWaferTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox Margin="5"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Notch Direction: "
                                 SelectedItem="{Binding CalibrationRecipeDto.CalibrationRecipeInfoDto.NotchDirectionEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type waferEnum:NotchDirectionTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox Margin="5"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Microscope Low Mag: "
                                 SelectedItem="{Binding CalibrationRecipeDto.CalibrationRecipeInfoDto.MicroscopeLowMag}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeMagnificationInfoList}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MicroscopeMagnificationName}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox Margin="5"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Microscope High Mag: "
                                 SelectedItem="{Binding CalibrationRecipeDto.CalibrationRecipeInfoDto.MicroscopeHighMag}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeMagnificationInfoList}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MicroscopeMagnificationName}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                </hc:UniformSpacingPanel>
            </GroupBox>
            <GroupBox Grid.Row="0" Grid.Column="2"
                      Margin="10"
                      Header="CIB">
                <hc:UniformSpacingPanel Orientation="Vertical">
                    <cibMode:CibGrabModeTypeUserControl HorizontalAlignment="Left"
                                                        hc:InfoElement.TitleWidth="150"
                                                        hc:InfoElement.TitlePlacement="Left"
                                                        hc:InfoElement.Title="Cib Grab Mode: "
                                                        DataContext="{Binding CalibrationRecipeDto.CalibrationRecipeInfoDto.CIBConfiguration}" />
                </hc:UniformSpacingPanel>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>