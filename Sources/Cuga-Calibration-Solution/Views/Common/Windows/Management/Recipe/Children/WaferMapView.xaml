<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Recipe.Children.WaferMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Recipe"
             d:DataContext="{d:DesignInstance Type=viewModels:RecipeSettingViewModel}"
             d:DesignHeight="1200"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <Grid>
        <Border Padding="2"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <wpf:WpfPlot x:Name="WaferMapWpfPlot" />
        </Border>
    </Grid>
</UserControl>