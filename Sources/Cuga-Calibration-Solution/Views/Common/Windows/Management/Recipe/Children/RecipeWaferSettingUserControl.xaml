<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Recipe.Children.RecipeWaferSettingUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Recipe"
             xmlns:local="clr-namespace:CugaCalibration.Views.Common.Windows.Management.Recipe.Children"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignHeight="1000"
             d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewModels:RecipeSettingViewModel}"
             mc:Ignorable="d">
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Row="0" Grid.Column="0"
                      Grid.RowSpan="2"
                      Margin="10"
                      Header="Wafer Map">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <local:WaferMapView Width="{Binding RelativeSource={RelativeSource AncestorType=GroupBox}, Path=ActualHeight}" />
                </Border>
            </GroupBox>
            <GroupBox Grid.Row="0" Grid.Column="1"
                      Margin="10"
                      Header="Wafer Parameter">
                <Border Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        DataContext="{Binding DataContext.CalibrationRecipeDto.WaferDto.WaferMapDto.WaferMapData, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <hc:UniformSpacingPanel Orientation="Vertical">
                        <hc:NumericUpDown x:Name="WaferDiameterNumeric"
                                          Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="WaferDiameter: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding DataContext.WaferDiameter, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:NumericUpDown x:Name="CellDieWidthNumeric"
                                          Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="CellDieWidth: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding DataContext.DiePitchWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:NumericUpDown x:Name="CellDieHeightNumeric"
                                          Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="CellDieHeight: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding DataContext.DiePitchHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:NumericUpDown x:Name="RowNumberNumeric"
                                          Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="RowNumber: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          IsReadOnly="True"
                                          Value="{Binding DataContext.CellDiePicthRowNumber, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="ColumnNumber: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          IsReadOnly="True"
                                          Value="{Binding DataContext.CellDiePitchColumnNumber, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:SimplePanel>
                            <Button Content="Generate By DiePitch"
                                    Command="{Binding DataContext.RefreshWaferMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="DiePitch"
                                    Height="50"
                                    Margin="5"
                                    FontSize="15" />
                        </hc:SimplePanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </GroupBox>
            <GroupBox Grid.Row="1" Grid.Column="1"
                      Margin="10"
                      Header="Wafer Parameter">
                <Border Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        DataContext="{Binding DataContext.CalibrationRecipeDto.WaferDto.WaferMapDto.WaferMapData, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <hc:UniformSpacingPanel Orientation="Vertical">
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="ReferenceDieRowNumber: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding DataContext.ReferenceDieRowNumber, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="ReferenceDieColumnNumber: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding DataContext.ReferenceDieColumnNumber, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="ReticleWidth: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          IsReadOnly="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding DataContext.ReticleWidth, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="ReticleHeight: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          IsReadOnly="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding DataContext.ReticleHeight, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="ReticleRowNumber: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          IsReadOnly="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding DataContext.ReticleRowNumber, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="ReticleColumnNumber: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          IsReadOnly="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding DataContext.ReticleColumnNumber, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}" />
                        <hc:SimplePanel>
                            <Button Content="Generate By Reticle"
                                    Command="{Binding DataContext.RefreshWaferMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="Reticle"
                                    Height="50"
                                    Margin="5"
                                    FontSize="15" />
                        </hc:SimplePanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>