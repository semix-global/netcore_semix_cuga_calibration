<UserControl x:Class="CugaCalibration.Views.Common.Windows.Management.Recipe.Children.RecipeWaferSettingUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Management.Recipe"
             xmlns:local="clr-namespace:CugaCalibration.Views.Common.Windows.Management.Recipe.Children"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignHeight="1000"
             d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewModels:RecipeSettingViewModel}"
             mc:Ignorable="d">
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Row="0" Grid.Column="0"
                      Grid.RowSpan="2"
                      Margin="10"
                      Header="Wafer Map">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <local:WaferMapCanvasView Width="{Binding RelativeSource={RelativeSource AncestorType=GroupBox}, Path=ActualHeight}" />
                </Border>
            </GroupBox>
            <GroupBox Grid.Row="0" Grid.Column="1"
                      Grid.RowSpan="2"
                      Margin="10"
                      Header="Wafer Parameter">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical">
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="Wafer Radius: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferRadius, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown x:Name="CellDieWidthNumeric"
                                          Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="Die Width: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferDiePitchSizeWidth, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="Die Height: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferDiePitchSizeHeight, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="Die Scribe Width: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferDieScribeSizeWidth, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="Die Scribe Height: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferDieScribeSizeHeight, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="ReticleWidth: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferReticleDiePitchSizeWidth, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="ReticleHeight: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferReticlePitchDieSizeHeight, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="Reticle Scribe Width: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferReticleDieScribeSizeWidth, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="Reticle Scribe Height: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferReticleDieScribeSizeHeight, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="Reticle References Die RowCount: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferReticleDieCountX, UpdateSourceTrigger=LostFocus}" />
                        <hc:NumericUpDown Width="350"
                                          Margin="5"
                                          hc:InfoElement.Title="Reticle References Die ColCount: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding WaferReticleDieCountY, UpdateSourceTrigger=LostFocus}" />
                        <hc:UniformSpacingPanel Orientation="Vertical">
                            <Button Content="Generate By DiePitch"
                                    Command="{Binding RefreshWaferMapCommand}"
                                    CommandParameter="DiePitch"
                                    Height="50"
                                    Margin="5"
                                    FontSize="15"
                                    Style="{StaticResource ButtonSuccess}" />
                            <Button Content="Review"
                                    Command="{Binding ReviewCommand}"
                                    Height="50"
                                    Margin="5"
                                    FontSize="15"
                                    Style="{StaticResource ButtonPrimary}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>