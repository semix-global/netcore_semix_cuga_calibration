<UserControl x:Class="CugaCalibration.Views.Common.Windows.Tools.AlignmentDarkFieldUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Alignment"
             xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.HandyControl.AttachedHelper;assembly=Net.Utilities.WPF.HandyControl"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:behaviors="clr-namespace:CanvasViewer.Behaviors;assembly=WPF.CanvasViewer"
             Width="1000"
             Height="1000"
             attachedHelper:LoadingHelper.IsShow="{Binding IsEnable, Converter={StaticResource BoolNegationConverter}}"
             d:DataContext="{d:DesignInstance Type=viewModels:AlignmentWindowDarkFieldViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="1000"
             mc:Ignorable="d">
    <Border>
        <!--#region Body-->
        <Border Margin="1"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="710" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--#region Left-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <GroupBox Header="Camera">
                        <view:CanvasView BackgroundColor="#0A0A0A"
                                         AxisColor="Red"
                                         Interactive="True"
                                         ShowAxes="True"
                                         ShowCursor="False"
                                         ShowGrid="False"
                                         BackgroundImage="{Binding StatusViewModel.BitmapMemoryByteArray, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}">
                            <i:Interaction.Behaviors>
                                <behaviors:CanvasViewerFpsBehavior FpsValue="{Binding StatusViewModel.Fps}" />
                                <behaviors:CanvasViewerClickBehavior Command="{Binding ReviewViewModel.MousePilotCommand}" />
                            </i:Interaction.Behaviors>
                        </view:CanvasView>
                    </GroupBox>
                    <Border Grid.Row="2"
                            Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <StackPanel>
                                <TextBlock Text="Config"
                                           HorizontalAlignment="Center"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Spacing="5">
                                <hc:Shield Subject="BF Template Type: "
                                           Status="{Binding Cache.AlgorithmTemplateTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                                           Color="{StaticResource SuccessBrush}" />
                                <hc:Shield Subject="BF Lower Mag: "
                                           Status="{Binding Cache.LowMag.LensName}"
                                           Color="{StaticResource InfoBrush}" />
                                <hc:Shield Subject="BF Lower Template Size: "
                                           Status="{Binding Cache.LowSizeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                                           Color="{StaticResource InfoBrush}" />
                                <hc:Shield Subject="BF High Mag: "
                                           Status="{Binding Cache.HighMag.LensName}"
                                           Color="{StaticResource SuccessBrush}" />
                            </hc:UniformSpacingPanel>
                            <hc:UniformSpacingPanel Spacing="5">
                                <hc:Shield Subject="DF Productivity Information: "
                                           Status="{Binding Cache.ProductivityInformation}"
                                           Color="{StaticResource SuccessBrush}" />
                                <hc:Shield Subject="DF High Template Size: "
                                           Status="{Binding Cache.HighSizeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                                           Color="{StaticResource SuccessBrush}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>

                    <Border Grid.Row="4"
                            Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <StackPanel>
                                <TextBlock Text="Stage"
                                           HorizontalAlignment="Center"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:ButtonGroup>
                                <Button Content="Previous"
                                        Command="{Binding PreviousCommand}"
                                        hc:IconElement.Geometry="{StaticResource LeftGeometry}"
                                        hc:IconElement.Height="20" />
                                <Button Content="Mark site"
                                        Command="{Binding MarkSiteCommand}"
                                        hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                        hc:IconElement.Height="20" />
                                <Button Content="Advance"
                                        Command="{Binding AdvancedCommand}"
                                        hc:IconElement.Geometry="{StaticResource DragHorizontalGeometry}"
                                        hc:IconElement.Height="20" />
                                <Button Content="Align"
                                        Command="{Binding AlignmentCommand}"
                                        hc:IconElement.Geometry="{StaticResource AlignLeftGeometry}"
                                        hc:IconElement.Height="20"
                                        Visibility="{Binding IsShowAlign, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Next"
                                        Command="{Binding NextCommand}"
                                        hc:IconElement.Geometry="{StaticResource RightGeometry}"
                                        hc:IconElement.Height="20"
                                        Visibility="Collapsed" />
                                <Button Content="Finish"
                                        Command="{Binding SaveCommand}"
                                        hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                                        hc:IconElement.Height="20" />
                            </hc:ButtonGroup>
                        </hc:UniformSpacingPanel>
                    </Border>
                </Grid>
                <!--#endregion-->
                <!--#region Right-->
                <hc:UniformSpacingPanel Grid.Column="2"
                                        Orientation="Vertical"
                                        Spacing="10">
                    <GroupBox Header="Low Site">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <TextBox Text="{Binding Cache.LowSite1.Location, Converter={StaticResource PointToStringConverter}}"
                                     Width="275"
                                     hc:InfoElement.Title="Site1(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StepIndex, Converter={StaticResource IntIs0ToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox Text="{Binding Cache.LowSite2.Location, Converter={StaticResource PointToStringConverter}}"
                                     Width="275"
                                     hc:InfoElement.Title="Site2(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StepIndex, Converter={StaticResource IntIs1ToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <view:CanvasView Width="100"
                                             Height="100"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding Cache.LowSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                        </hc:UniformSpacingPanel>
                    </GroupBox>
                    <GroupBox Header="High DF Site">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <TextBox Text="{Binding Cache.HighSite1.Location, Converter={StaticResource PointToStringConverter}}"
                                     Width="275"
                                     hc:InfoElement.Title="Site1(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StepIndex, Converter={StaticResource IntIs2ToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox Text="{Binding Cache.HighSite2.Location, Converter={StaticResource PointToStringConverter}}"
                                     Width="275"
                                     hc:InfoElement.Title="Site2(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StepIndex, Converter={StaticResource IntIs3ToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <view:CanvasView Width="100"
                                             Height="100"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding Cache.HighSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                        </hc:UniformSpacingPanel>
                    </GroupBox>
                    <GroupBox d:Visibility="Visible"
                              Header="Result"
                              Visibility="{Binding Cache.IsVerified, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Text="{Binding Cache.Result.Degrees, StringFormat={}{0:f10}}"
                                 Width="275"
                                 hc:InfoElement.Title="Degrees(°): "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                    </GroupBox>
                </hc:UniformSpacingPanel>
                <!--#endregion-->
            </Grid>
        </Border>
        <!--#endregion-->
    </Border>
</UserControl>