<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.AodPowerUniformityWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:models="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
           xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Width="1240"
           Height="950"
           d:DataContext="{d:DesignInstance Type=viewModels:AodPowerUniformityWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Aod Power Uniformity"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Padding="2"
                Effect="{StaticResource EffectShadow1}"
                Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--#region Left-->
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Param1"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                                    <ItemsControl ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type models:OpticsAodTypeEnum}}}">
                                        <i:Interaction.Behaviors>
                                            <behaviors:RadioButtonSelectedItemBehavior SelectedItem="{Binding OpticsAodTypeEnum, Mode=TwoWay}" />
                                        </i:Interaction.Behaviors>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <hc:UniformSpacingPanel Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Content="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                                                             Tag="{Binding}"
                                                             GroupName="64F03167-419E-45F0-8594-EF711A1EEADC" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <hc:NumericUpDown hc:InfoElement.Title="Wait Time(s): "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding WaitTime}" />
                                    <hc:NumericUpDown hc:InfoElement.Title="Sound Packet Length(mm): "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Value="{Binding ChirpSoundPacketLength}">
                                        <hc:NumericUpDown.Style>
                                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OpticsAodTypeEnum}" Value="{x:Static models:OpticsAodTypeEnum.Prescan}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:NumericUpDown.Style>
                                    </hc:NumericUpDown>
                                    <hc:NumericUpDown hc:InfoElement.Title="Flatness Time(ns): "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Value="{Binding PrescanFlatnessTime}">
                                        <hc:NumericUpDown.Style>
                                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OpticsAodTypeEnum}" Value="{x:Static models:OpticsAodTypeEnum.Chirp}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:NumericUpDown.Style>
                                    </hc:NumericUpDown>
                                    <hc:NumericUpDown hc:InfoElement.Title="Sample Rate: "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding SampleRate}" />
                                    <hc:NumericUpDown hc:InfoElement.Title="Zero Num(ns): "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding ZeroNum}" />
                                    <hc:NumericUpDown hc:InfoElement.Title="Generate Retry Count: "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding AodWaveGenerateRetryCount}" />
                                    <Separator />
                                    <hc:NumericUpDown hc:InfoElement.Title="Start Center Frequency(Mhz): "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding StartCenterFrequency}" />
                                    <hc:NumericUpDown hc:InfoElement.Title="End Center Frequency(Mhz): "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding EndCenterFrequency}" />
                                    <hc:NumericUpDown hc:InfoElement.Title="Center Frequency Step(Mhz): "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding StepCenterFrequency}" />
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Step1"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Spacing="10">
                                        <Button Content="All Action"
                                                Command="{Binding Step1Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="All Cancel"
                                                Command="{Binding Step1CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                        <Button Content="Export"
                                                Command="{Binding SaveCommand}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Spacing="10">
                                        <Button Content="One Action"
                                                Command="{Binding Step1OneCommand}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="One Cancel"
                                                Command="{Binding Step1OneCancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Param2"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                                    <hc:NumericUpDown hc:InfoElement.Title="Target Power(mW): "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding TargetMeasurePower}" />
                                    <hc:NumericUpDown hc:InfoElement.Title="Coefficient Step: "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding CoefficientStep}" />
                                    <hc:NumericUpDown hc:InfoElement.Title="Retry Count: "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding RetryCount}" />
                                    <Separator />
                                    <hc:NumericUpDown hc:InfoElement.Title="Threshold: "
                                                      hc:TitleElement.TitleWidth="180"
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Minimum="0"
                                                      Value="{Binding TargetThreshold}" />
                                    <hc:NumericUpDown hc:InfoElement.Title="Threshold Rate Min: "
                                                      hc:TitleElement.TitleWidth="180"
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      IsReadOnly="True"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding TargetThresholdRateMin, Mode=OneWay}" />
                                    <hc:NumericUpDown hc:InfoElement.Title="Threshold Rate Max: "
                                                      hc:TitleElement.TitleWidth="180"
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      IsReadOnly="True"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding TargetThresholdRateMax, Mode=OneWay}" />
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Step2"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Spacing="10">
                                        <Button Content="All Action"
                                                Command="{Binding Step2Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="All Cancel"
                                                Command="{Binding Step2CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Spacing="10">
                                        <Button Content="One Action"
                                                Command="{Binding Step2OneCommand}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="One Cancel"
                                                Command="{Binding Step2OneCancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Step3"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Spacing="10">
                                        <Button Content="Save"
                                                Command="{Binding SaveCommand}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                </hc:UniformSpacingPanel>
                <!--#endregion-->

                <GridSplitter Grid.Column="1" Width="5" />

                <!--#region Right-->
                <GroupBox Grid.Column="2" Header="History">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding Items}"
                                  Style="{StaticResource ListView.Small}"
                                  SelectedItem="{Binding SelectItem}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Height" Value="250" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOk}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="100"
                                                    Header="Coefficient"
                                                    DisplayMemberBinding="{Binding Coefficient, StringFormat={}{0:0.###}}" />
                                    <GridViewColumn Width="150"
                                                    Header="Center Frequency"
                                                    DisplayMemberBinding="{Binding CenterFrequency, StringFormat={}{0:0.###}}" />
                                    <GridViewColumn Width="120"
                                                    Header="Measure Power"
                                                    DisplayMemberBinding="{Binding MeasurePower, StringFormat={}{0:0.###}}" />
                                    <GridViewColumn Width="100"
                                                    Header="Rate"
                                                    DisplayMemberBinding="{Binding Rate, StringFormat={}{0:0.###}}" />
                                    <GridViewColumn Width="400" Header="Fouriers">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <wpf:WpfPlot Width="400"
                                                             Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}"
                                                             d:DataContext="{d:DesignInstance Type=viewModels:AodPowerUniformityItemDto}">
                                                    <i:Interaction.Behaviors>
                                                        <behaviors:WpfPlotMultiBehavior Title="Fouriers" Plot0="{Binding AodWaveSignalsFourier}" />
                                                    </i:Interaction.Behaviors>
                                                </wpf:WpfPlot>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="400" Header="Signals">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <wpf:WpfPlot Width="400"
                                                             Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}"
                                                             d:DataContext="{d:DesignInstance Type=viewModels:AodPowerUniformityItemDto}">
                                                    <i:Interaction.Behaviors>
                                                        <behaviors:WpfPlotMultiBehavior Title="Signals" Plot0="{Binding AodWaveSignals}" />
                                                    </i:Interaction.Behaviors>
                                                </wpf:WpfPlot>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="150"
                                                    Header="Sound Packet Length"
                                                    DisplayMemberBinding="{Binding ChirpSoundPacketLength, StringFormat={}{0:0.###}}" />
                                    <GridViewColumn Width="150"
                                                    Header="Sample Rate"
                                                    DisplayMemberBinding="{Binding SampleRate, StringFormat={}{0:0.###}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <GridSplitter Grid.Row="1" Height="5" />
                        <Border Grid.Row="2"
                                Padding="0"
                                Style="{StaticResource BorderRegion}"
                                Effect="{StaticResource EffectShadow1}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <wpf:WpfPlot>
                                    <!--<wpf:WpfPlot.IsEnabled>
                                        <MultiBinding>
                                            <Binding Path="Step1Command.IsRunning" Converter="{StaticResource BoolNegationConverter}" />
                                            <Binding Path="Step1OneCommand.IsRunning" Converter="{StaticResource BoolNegationConverter}" />
                                        </MultiBinding>
                                    </wpf:WpfPlot.IsEnabled>-->
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="Frequency of Measure Power" Plot0="{Binding MeasurePowerPoints}" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                                <wpf:WpfPlot Grid.Column="1">
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="Frequency of Coefficient" Plot0="{Binding CoefficientPoints}" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                                <wpf:WpfPlot Grid.Column="2">
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="Coefficient of Measure Power" Plot0="{Binding MeasureCoefficientPowerPoints}" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>
                <!--#endregion-->
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>