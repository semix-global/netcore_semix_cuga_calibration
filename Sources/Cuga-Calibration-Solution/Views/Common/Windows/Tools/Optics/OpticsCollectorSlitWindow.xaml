<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Optics.OpticsCollectorSlitWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:helper="clr-namespace:Core.Models.Helper;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Optics"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
           xmlns:collections="clr-namespace:System.Collections;assembly=mscorlib"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:OpticsCollectorSlitWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:SimplePanel Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="500"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                 IsInertiaEnabled="True"
                                 VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <GroupBox Header="Common Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:UniformSpacingPanel Margin="11,0"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <ComboBox hc:TitleElement.Title="Productivity Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  ItemsSource="{Binding ApplicationCookie.ProductivityInformations}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                        <ComboBox hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  hc:TitleElement.Title="PMT ID: "
                                                  SelectedItem="{Binding Cache.PmtId}"
                                                  Style="{StaticResource ComboBoxExtend}"
                                                  ItemsSource="{x:Static helper:CalibrationConstantsHelper.PmtIds}" />
                                        <hc:NumericUpDown hc:TitleElement.Title="Image Width(px): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="200"
                                                          Minimum="0"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.ImageWidthPixel}" />
                                        <hc:NumericUpDown hc:TitleElement.Title="±Range(ECS): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="200"
                                                          Minimum="0"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.RangeEcs}" />
                                        <hc:NumericUpDown hc:TitleElement.Title="Step(ECS): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="200"
                                                          Minimum="0"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.StepEcs}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Step1 Haze">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <Expander IsExpanded="False"
                                              ExpandDirection="Down"
                                              Header="Optics Configuration">
                                        <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.HazeOpticsConfiguration}" />
                                    </Expander>
                                    <Expander IsExpanded="False"
                                              ExpandDirection="Down"
                                              Header="CIB Configuration">
                                        <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.HazeCIBConfiguration}" />
                                    </Expander>
                                    <ComboBox HorizontalAlignment="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.Title="Laser Light Information: "
                                              SelectedItem="{Binding Cache.HazeLaserLightInformation}"
                                              ItemsSource="{Binding ApplicationCookie.LaserLightInformations}" />
                                    <TextBox Text="{Binding Cache.HazeBrightFieldPosition, Converter={StaticResource PointToStringConverter}}"
                                             hc:TitleElement.Title="Bright Field Position:"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step0Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Cancel"
                                                Command="{Binding Step0CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <StackPanel>
                                        <TextBlock Text="Result"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <TextBox Text="{Binding Cache.HazeAverageECS, StringFormat={}{0:0.###}}"
                                             hc:TitleElement.Title="Result Average ECS:"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Step2 DSW">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <Expander IsExpanded="False"
                                              ExpandDirection="Down"
                                              Header="Optics Configuration">
                                        <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.DSWOpticsConfiguration}" />
                                    </Expander>
                                    <Expander IsExpanded="False"
                                              ExpandDirection="Down"
                                              Header="CIB Configuration">
                                        <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.DSWCIBConfiguration}" />
                                    </Expander>
                                    <ComboBox HorizontalAlignment="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.Title="Coefficient: "
                                              SelectedItem="{Binding Cache.DSWLaserLightInformation}"
                                              ItemsSource="{Binding ApplicationCookie.LaserLightInformations}" />
                                    <TextBox Text="{Binding Cache.DSWBrightFieldPosition, Converter={StaticResource PointToStringConverter}}"
                                             hc:TitleElement.Title="Bright Field Position:"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="X Pixel Size(um): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.DSWXPixelSize}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Y Pixel Size(um): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.DSWYPixelSize}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Pot Diameter(um): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.DSWPotDiameter}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="X Point Diameter(um): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.DSWXPointDiameter}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Y Point Diameter(um): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.DSWYPointDiameter}" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step1Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Cancel"
                                                Command="{Binding Step1CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <StackPanel>
                                        <TextBlock Text="Result"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <TextBox Text="{Binding Cache.DSWROIRect, Converter={StaticResource RectToStringConverter}}"
                                             hc:TitleElement.Title="ROI Rect(px):"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding Cache.DSWAverageECS, StringFormat={}{0:0.###}}"
                                             hc:TitleElement.Title="Result Average ECS:"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </hc:ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" />
            <Border Grid.Column="2"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <TabControl>
                    <i:Interaction.Behaviors>
                        <wpf:SelectorAutoSelectFirstBehavior />
                    </i:Interaction.Behaviors>
                    <TabItem Header="Plots">
                        <TabControl ItemsSource="{Binding PlotDataSources}">
                            <TabControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type collections:IDictionaryEnumerator}">
                                    <TextBlock Text="{Binding Key, StringFormat='Channel Id: {0}'}"
                                               Padding="5,2"
                                               Style="{StaticResource TextBlockDefaultBold}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type collections:IDictionaryEnumerator}">
                                    <Border Style="{StaticResource BorderRegion}">
                                        <v2:PlotControl DataSource="{Binding Value, Mode=OneWay}" />
                                    </Border>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="Haze Details">
                        <ListView Margin="5"
                                  ItemsSource="{Binding Cache.HazeResults}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Style="{StaticResource ListView.Small}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="150"
                                                    Header="ECS"
                                                    DisplayMemberBinding="{Binding ECS, StringFormat={}{0:0.###}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="DSW Details">
                        <ListView Margin="5"
                                  ItemsSource="{Binding Cache.DSWResults}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Style="{StaticResource ListView.Small}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="150"
                                                    Header="ECS"
                                                    DisplayMemberBinding="{Binding ECS, StringFormat={}{0:0.###}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</hc:Window>