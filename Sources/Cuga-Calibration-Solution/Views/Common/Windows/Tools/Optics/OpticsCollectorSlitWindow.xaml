<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Optics.OpticsCollectorSlitWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:helper="clr-namespace:Core.Models.Helper;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Optics"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
           xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:OpticsCollectorSlitWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:SimplePanel Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <GroupBox Header="Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:UniformSpacingPanel Margin="5,0,0,0"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <ComboBox hc:TitleElement.Title="Productivity Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  ItemsSource="{Binding ApplicationCookie.ProductivityInformations}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                        <ComboBox hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  hc:TitleElement.Title="PMT ID: "
                                                  SelectedItem="{Binding Cache.PmtId}"
                                                  Style="{StaticResource ComboBoxExtend}"
                                                  ItemsSource="{x:Static helper:CalibrationConstantsHelper.PmtIds}" />
                                        <ComboBox hc:TitleElement.Title="Capture Mode: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  SelectedItem="{Binding Cache.CaptureMode}"
                                                  Style="{StaticResource ComboBoxExtend}"
                                                  ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type viewModels:OpticsCollectorSlitCaptureModeEnum}}}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Scan Forward: "
                                                       Width="200"
                                                       VerticalAlignment="Center" />
                                            <ToggleButton IsChecked="{Binding Cache.IsForward}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Background="{StaticResource DangerBrush}"
                                                          Style="{StaticResource ToggleButtonSwitch}" />
                                        </StackPanel>
                                    </hc:UniformSpacingPanel>
                                    <Expander Header="Optics Configuration"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.HazeOpticsConfiguration}" />
                                        </Border>
                                    </Expander>
                                    <Expander Header="CIB Configuration"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.HazeCIBConfiguration}" />
                                        </Border>
                                    </Expander>
                                    <ComboBox HorizontalAlignment="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.Title="Laser Light Information: "
                                              SelectedItem="{Binding Cache.HazeLaserLightInformation}"
                                              ItemsSource="{Binding ApplicationCookie.LaserLightInformations}" />
                                    <TextBox Text="{Binding Cache.HazeBrightFieldPosition, Converter={StaticResource PointToStringConverter}}"
                                             Margin="5,0,0,0"
                                             hc:TitleElement.Title="Haze Bright Field Position:"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <Expander Header="{Binding Steps[0]}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <Grid>
                                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                    <hc:UniformSpacingPanel.Style>
                                                        <Style TargetType="hc:UniformSpacingPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cache.CaptureMode}" Value="{x:Static viewModels:OpticsCollectorSlitCaptureModeEnum.FixedHeight}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </hc:UniformSpacingPanel.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <hc:NumericUpDown Grid.Column="0"
                                                                          Margin="0,0,-1,0"
                                                                          hc:TitleElement.Title="Center(ECS): "
                                                                          hc:TitleElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="200"
                                                                          hc:BorderElement.CornerRadius="4,0,0,4"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Value="{Binding Cache.CenterECS}" />
                                                        <Button Grid.Column="1"
                                                                Command="{Binding GetECSCommand}"
                                                                Padding="6,3"
                                                                VerticalAlignment="Stretch"
                                                                hc:BorderElement.CornerRadius="0,4,4,0"
                                                                hc:IconElement.Width="12"
                                                                hc:IconElement.Geometry="{StaticResource RotateRightGeometry}"
                                                                ToolTip="Get current ECS"
                                                                Style="{StaticResource ButtonDefault}" />
                                                    </Grid>
                                                    <hc:NumericUpDown hc:TitleElement.Title="±Range(ECS): "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="200"
                                                                      Minimum="0"
                                                                      Style="{StaticResource NumericUpDownExtend}"
                                                                      Value="{Binding Cache.RangeEcs}" />
                                                    <hc:NumericUpDown hc:TitleElement.Title="Step(ECS): "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="200"
                                                                      Minimum="0"
                                                                      Style="{StaticResource NumericUpDownExtend}"
                                                                      Value="{Binding Cache.StepEcs}" />
                                                    <hc:NumericUpDown hc:TitleElement.Title="Image Width(px): "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="200"
                                                                      Minimum="0"
                                                                      Style="{StaticResource NumericUpDownExtend}"
                                                                      Value="{Binding Cache.ImageWidthPixel}" />
                                                </hc:UniformSpacingPanel>
                                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                    <hc:UniformSpacingPanel.Style>
                                                        <Style TargetType="hc:UniformSpacingPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cache.CaptureMode}" Value="{x:Static viewModels:OpticsCollectorSlitCaptureModeEnum.VariableHeight}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </hc:UniformSpacingPanel.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <hc:NumericUpDown Grid.Column="0"
                                                                          Margin="0,0,-1,0"
                                                                          hc:TitleElement.Title="Center(ECS): "
                                                                          hc:TitleElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="200"
                                                                          hc:BorderElement.CornerRadius="4,0,0,4"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Value="{Binding Cache.CenterECS}" />
                                                        <Button Grid.Column="1"
                                                                Command="{Binding GetECSCommand}"
                                                                Padding="6,3"
                                                                VerticalAlignment="Stretch"
                                                                hc:BorderElement.CornerRadius="0,4,4,0"
                                                                hc:IconElement.Width="12"
                                                                hc:IconElement.Geometry="{StaticResource RotateRightGeometry}"
                                                                ToolTip="Get current ECS"
                                                                Style="{StaticResource ButtonDefault}" />
                                                    </Grid>
                                                    <hc:NumericUpDown hc:TitleElement.Title="±Range(ECS): "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="200"
                                                                      Minimum="0"
                                                                      Style="{StaticResource NumericUpDownExtend}"
                                                                      Value="{Binding Cache.RangeEcs}" />
                                                    <hc:NumericUpDown hc:TitleElement.Title="Scan Length(um): "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="200"
                                                                      Minimum="0"
                                                                      Style="{StaticResource NumericUpDownExtend}"
                                                                      Value="{Binding Cache.ScanLength}" />
                                                </hc:UniformSpacingPanel>
                                            </Grid>
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Actions">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <Expander IsExpanded="False" ExpandDirection="Down">
                                        <Expander.Header>
                                            <TextBlock Text="Results" Style="{StaticResource TextBlockDefaultSuccess}" />
                                        </Expander.Header>
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <TextBox Text="{Binding Cache.BinWidthPixel}"
                                                         hc:TitleElement.Title="Bin Width(px): "
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         hc:TitleElement.TitleWidth="200"
                                                         IsReadOnly="True"
                                                         Background="{StaticResource SecondaryRegionBrush}"
                                                         Style="{StaticResource TextBoxExtend}" />
                                                <TextBox Text="{Binding Cache.DiscardedPixelCount}"
                                                         hc:TitleElement.Title="Discarded Pixels: "
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         hc:TitleElement.TitleWidth="200"
                                                         IsReadOnly="True"
                                                         Background="{StaticResource SecondaryRegionBrush}"
                                                         Style="{StaticResource TextBoxExtend}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <hc:Divider Content="{Binding Steps[0]}" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step0Command}"
                                                CommandParameter="{x:Static models:Constants.False}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Cancel"
                                                Command="{Binding Step0CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" />
            <GroupBox Grid.Column="2"
                      Padding="5"
                      Header="History">
                <TabControl>
                    <i:Interaction.Behaviors>
                        <behaviors:SelectorAutoSelectFirstBehavior />
                    </i:Interaction.Behaviors>
                    <TabItem Header="Samples">
                        <TabControl ItemsSource="{Binding Cache.ChannelResults}">
                            <i:Interaction.Behaviors>
                                <behaviors:SelectorAutoSelectFirstBehavior />
                            </i:Interaction.Behaviors>
                            <TabControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:OpticsCollectorSlitChannelResult}">
                                    <TextBlock Text="{Binding ChannelId, StringFormat='Channel Id: {0}'}"
                                               Padding="5,2"
                                               Style="{StaticResource TextBlockDefaultBold}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type viewModels:OpticsCollectorSlitChannelResult}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1.3*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DataGrid Margin="5"
                                                  hc:DataGridAttach.ShowRowNumber="True"
                                                  RowHeaderWidth="60"
                                                  HeadersVisibility="All"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  Style="{StaticResource DataGrid.Small}"
                                                  SelectedItem="{Binding SelectedItem}"
                                                  ItemsSource="{Binding Samples}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <i:Interaction.Behaviors>
                                                <behaviors:DataGridScrollToCurrentBehavior />
                                            </i:Interaction.Behaviors>
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}" TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.CellStyle>
                                                <Style BasedOn="{StaticResource DataGridCellStyle.Small}" TargetType="DataGridCell">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.RowStyle>
                                                <Style BasedOn="{StaticResource DataGridRowStyle.Small}" TargetType="DataGridRow">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="100"
                                                                    Header="ECS"
                                                                    Binding="{Binding ECS, StringFormat={}{0:0.###}}" />
                                                <DataGridTextColumn Width="110"
                                                                    Header="Top"
                                                                    Binding="{Binding TopAverageGray, StringFormat={}{0:0.###}}" />
                                                <DataGridTextColumn Width="110"
                                                                    Header="Mid"
                                                                    Binding="{Binding MiddleAverageGray, StringFormat={}{0:0.###}}" />
                                                <DataGridTextColumn Width="110"
                                                                    Header="Bottom"
                                                                    Binding="{Binding BottomAverageGray, StringFormat={}{0:0.###}}" />
                                                <DataGridTextColumn Width="90"
                                                                    Header="Std"
                                                                    Binding="{Binding StandardDeviation, StringFormat={}{0:0.###}}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <GridSplitter Grid.Row="1" Height="5" />
                                        <TabControl Grid.Row="2">
                                            <TabItem Header="Images">
                                                <Border Style="{StaticResource BorderRegion}">
                                                    <Grid>
                                                        <view:CanvasView AxisColor="Red"
                                                                         BackgroundColor="#0A0A0A"
                                                                         BackgroundImage="{Binding SelectedItem.ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                         Interactive="True"
                                                                         ShowAxes="False"
                                                                         ShowCursor="False"
                                                                         ShowGrid="False" />
                                                        <TextBlock Text="{Binding SelectedItem.ECS, StringFormat={}ECS: {0:F3}}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Top"
                                                                   Foreground="Yellow" />
                                                    </Grid>
                                                </Border>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="Plots">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabControl ItemsSource="{Binding Cache.ChannelResults}">
                                <i:Interaction.Behaviors>
                                    <behaviors:SelectorAutoSelectFirstBehavior />
                                </i:Interaction.Behaviors>
                                <TabControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:OpticsCollectorSlitChannelResult}">
                                        <TextBlock Text="{Binding ChannelId, StringFormat='Channel Id: {0}'}"
                                                   Padding="5,2"
                                                   Style="{StaticResource TextBlockDefaultBold}" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:OpticsCollectorSlitChannelResult}">
                                        <Border Margin="5" Style="{StaticResource BorderRegion}">
                                            <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
                                        </Border>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>

                            <GridSplitter Grid.Row="1" Height="5" />

                            <TabControl Grid.Row="2">
                                <TabItem Header="Features">
                                    <DataGrid Margin="5"
                                              hc:DataGridAttach.ShowRowNumber="True"
                                              RowHeaderWidth="60"
                                              HeadersVisibility="All"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Style="{StaticResource DataGrid.Small}"
                                              ItemsSource="{Binding Cache.ChannelResults}"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <i:Interaction.Behaviors>
                                            <behaviors:DataGridScrollToCurrentBehavior />
                                        </i:Interaction.Behaviors>
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}" TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.CellStyle>
                                            <Style BasedOn="{StaticResource DataGridCellStyle.Small}" TargetType="DataGridCell">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <DataGrid.RowStyle>
                                            <Style BasedOn="{StaticResource DataGridRowStyle.Small}" TargetType="DataGridRow">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="50"
                                                                Header="Channel"
                                                                Binding="{Binding ChannelId}" />
                                            <DataGridTextColumn Width="100"
                                                                Header="95% Left"
                                                                Binding="{Binding PeakRegionLeftEcs, StringFormat={}{0:0.###}}" />
                                            <DataGridTextColumn Width="100"
                                                                Header="95% Right"
                                                                Binding="{Binding PeakRegionRightEcs, StringFormat={}{0:0.###}}" />
                                            <DataGridTextColumn Width="100"
                                                                Header="95% Width"
                                                                Binding="{Binding PeakRegionWidth, StringFormat={}{0:0.###}}" />
                                            <DataGridTextColumn Width="100"
                                                                Header="ReachedEnd"
                                                                Binding="{Binding PeakRegionReachedEndpoint}" />
                                            <DataGridTextColumn Width="150"
                                                                Header="Collection BF"
                                                                Binding="{Binding CollectionBestFocusPoint, Converter={StaticResource PointToStringConverter}, StringFormat={}{0:f3}}" />
                                            <DataGridTextColumn Width="150"
                                                                Header="Illumination BF"
                                                                Binding="{Binding IlluminationBestFocusPoint, Converter={StaticResource PointToStringConverter}, StringFormat={}{0:f3}}" />
                                            <DataGridTextColumn Width="100"
                                                                Header="Offset"
                                                                Binding="{Binding Offset, StringFormat={}{0:0.###}}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>
    </Grid>
</hc:Window>