<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Optics.OpticsGrabbingImageWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:darkField="clr-namespace:Core.Models.Models.Common.DarkField;assembly=Core.Models"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
           xmlns:ui="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
           xmlns:cmd="clr-namespace:Net.Utilities.WPF.Commands.Calibration;assembly=Net.Utilities.WPF.Commands.Calibration"
           xmlns:wpfImageViewer="clr-namespace:Net.Utilities.ImageViewer.WPF;assembly=Net.Utilities.ImageViewer.WPF"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.HandyControl.AttachedHelper;assembly=Net.Utilities.WPF.HandyControl"
           xmlns:generates="clr-namespace:Core.Models.Models.Common.AODWaveform.UI.Generates;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Optics"
           xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:OpticsGrabbingImageWindowViewModel}"
           attachedHelper:LoadingHelper.IsShow="{Binding LoadedCommand.IsRunning}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Border Grid.Row="1"
                Margin="1"
                Padding="2"
                Effect="{StaticResource EffectShadow1}"
                Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource BorderRegion}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <ComboBox hc:TitleElement.Title="Productivity Information: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      ItemsSource="{Binding ApplicationCookie.ProductivityInformations}"
                                      Style="{StaticResource ComboBoxExtend}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                </i:Interaction.Behaviors>
                            </ComboBox>
                            <ComboBox hc:TitleElement.Title="Stage Coordinate System: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:StageCoordinateSystemEnum}}}"
                                      SelectedItem="{Binding Cache.StageCoordinateSystemEnum}"
                                      Style="{StaticResource ComboBoxExtend}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CIB Informations: "
                                           Width="160"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <ListBox Grid.Column="1"
                                         Height="300"
                                         ItemContainerStyle="{StaticResource ListBoxItemStyle.Center}"
                                         ItemsSource="{Binding ApplicationCookie.CIBInformations}"
                                         SelectionMode="Extended">
                                    <i:Interaction.Behaviors>
                                        <behaviors:ListBoxScrollToCurrentBehavior />
                                        <behaviors:ListBoxSelectedItemsBehavior Type="{x:Type pattern:CIBInformation}" BindableSelectedItems="{Binding Cache.CIBInformations}" />
                                    </i:Interaction.Behaviors>
                                </ListBox>
                            </Grid>
                            <ComboBox hc:TitleElement.Title="Cal Chip: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:CalChipSiteModelEnum}}}"
                                      SelectedItem="{Binding Cache.CalChipSiteModelEnum}"
                                      Style="{StaticResource ComboBoxExtend}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Expander Header="Optics Configuration"
                                      IsExpanded="False"
                                      ExpandDirection="Down">
                                <Border Style="{StaticResource BorderRegion}">
                                    <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.OpticsConfiguration}" />
                                </Border>
                            </Expander>
                            <Expander Header="CIB Configuration"
                                      IsExpanded="False"
                                      ExpandDirection="Down">
                                <Border Style="{StaticResource BorderRegion}">
                                    <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.CIBConfiguration}" />
                                </Border>
                            </Expander>
                            <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      ItemsSource="{Binding ApplicationCookie.LaserLightInformations}"
                                      Style="{StaticResource ComboBoxExtend}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                </i:Interaction.Behaviors>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Scan Forward: "
                                           Width="160"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <ToggleButton IsChecked="{Binding Cache.IsForward}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Background="{StaticResource DangerBrush}"
                                              Style="{StaticResource ToggleButtonSwitch}" />
                            </StackPanel>
                            <Expander Header="AOD Waveform Profiles"
                                      IsExpanded="False"
                                      ExpandDirection="Down">
                                <Border Style="{StaticResource BorderRegion}">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Generate AOD Waveform: "
                                                           Width="160"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />
                                                <ToggleButton IsChecked="{Binding Cache.IsGenerateAODWaveform}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Background="{StaticResource DangerBrush}"
                                                              Style="{StaticResource ToggleButtonSwitch}" />
                                            </StackPanel>
                                            <Button Content="Import AOD Waveform Params"
                                                    Command="{Binding ImportAODWaveformParamsCommand}"
                                                    HorizontalAlignment="Right"
                                                    hc:IconElement.Geometry="{StaticResource ImportGeometry}"
                                                    Visibility="{Binding Cache.IsGenerateAODWaveform, Converter={StaticResource Boolean2VisibilityConverter}}"
                                                    Style="{StaticResource ButtonInfo.Small}" />
                                        </Grid>
                                        <Expander Header="Prescan AOD Waveform"
                                                  IsExpanded="False"
                                                  ExpandDirection="Down"
                                                  Visibility="{Binding Cache.IsGenerateAODWaveform, Converter={StaticResource Boolean2VisibilityConverter}}">
                                            <Border Style="{StaticResource BorderRegion}">
                                                <generates:GeneratePrescanAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                                      IsVisibleDirectoryPath="False"
                                                                                                      DataContext="{Binding Cache.GeneratePrescanAODWaveformParam}" />
                                            </Border>
                                        </Expander>
                                        <TextBox Text="{Binding Cache.PrescanAODWaveformResultFilePath}"
                                                 Height="50"
                                                 TextWrapping="Wrap"
                                                 hc:TitleElement.Title="Prescan File Path: "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="150"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 IsReadOnly="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <hc:UniformSpacingPanel Spacing="10">
                                            <Button Command="{Binding ChangedPrescanAODWaveformProfilesCommand}" hc:IconElement.Geometry="{StaticResource RotateRightGeometry}" />
                                            <Button Command="{Binding ChangedPrescanAODWaveformProfilesCancelCommand}"
                                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                    Style="{StaticResource ButtonWarning}" />
                                            <Button Content="Clear"
                                                    Command="{Binding ClearPrescanAODWaveformProfilesCommand}"
                                                    hc:IconElement.Geometry="{StaticResource RecycleBinGeometry}"
                                                    Style="{StaticResource ButtonDanger}" />
                                            <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                                          Content="Profiles"
                                                          hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                            <Popup Width="800"
                                                   Height="800"
                                                   AllowsTransparency="True"
                                                   IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}"
                                                   Placement="Right"
                                                   PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                                                   PopupAnimation="Slide"
                                                   StaysOpen="False">
                                                <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                                                    <ui:PrescanAODWaveformProfilesUserControl DataContext="{Binding Cache.PrescanAODWaveformProfiles}" />
                                                </Border>
                                            </Popup>
                                        </hc:UniformSpacingPanel>
                                        <Expander Header="Chirp AOD Waveform"
                                                  IsExpanded="False"
                                                  ExpandDirection="Down"
                                                  Visibility="{Binding Cache.IsGenerateAODWaveform, Converter={StaticResource Boolean2VisibilityConverter}}">
                                            <Border Style="{StaticResource BorderRegion}">
                                                <generates:GenerateChirpAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                                    IsVisibleDirectoryPath="False"
                                                                                                    DataContext="{Binding Cache.GenerateChirpAODWaveformParam}" />
                                            </Border>
                                        </Expander>
                                        <TextBox Text="{Binding Cache.ChirpAODWaveformResultFilePath}"
                                                 Height="50"
                                                 TextWrapping="Wrap"
                                                 hc:TitleElement.Title="Chirp File Path: "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="150"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 IsReadOnly="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <hc:UniformSpacingPanel Spacing="10">
                                            <Button Command="{Binding ChangedChirpAODWaveformProfilesCommand}" hc:IconElement.Geometry="{StaticResource RotateRightGeometry}" />
                                            <Button Command="{Binding ChangedPrescanAODWaveformProfilesCancelCommand}"
                                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                    Style="{StaticResource ButtonWarning}" />
                                            <Button Content="Clear"
                                                    Command="{Binding ClearChirpAODWaveformProfilesCommand}"
                                                    hc:IconElement.Geometry="{StaticResource RecycleBinGeometry}"
                                                    Style="{StaticResource ButtonDanger}" />
                                            <ToggleButton x:Name="ToggleButtonChirpAODWaveformProfiles"
                                                          Content="Profiles"
                                                          hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                            <Popup Width="800"
                                                   Height="800"
                                                   AllowsTransparency="True"
                                                   IsOpen="{Binding IsChecked, ElementName=ToggleButtonChirpAODWaveformProfiles, Mode=TwoWay}"
                                                   Placement="Right"
                                                   PlacementTarget="{Binding ElementName=ToggleButtonChirpAODWaveformProfiles}"
                                                   PopupAnimation="Slide"
                                                   StaysOpen="False">
                                                <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                                                    <ui:ChirpAODWaveformProfilesUserControl DataContext="{Binding Cache.ChirpAODWaveformProfiles}" />
                                                </Border>
                                            </Popup>
                                        </hc:UniformSpacingPanel>
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </Expander>
                            <TabControl>
                                <TabItem Header="Width">
                                    <Grid Margin="5">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Auto Focus: "
                                                           Width="160"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />
                                                <ToggleButton IsChecked="{Binding Cache.IsAutoFocus}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Background="{StaticResource DangerBrush}"
                                                              Style="{StaticResource ToggleButtonSwitch}" />
                                            </StackPanel>
                                            <hc:NumericUpDown hc:TitleElement.Title="ECS: "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Visibility="{Binding Cache.IsAutoFocus, Converter={StaticResource Boolean2VisibilityReConverter}}"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.ECS}" />
                                            <hc:NumericUpDown hc:TitleElement.Title="Width(px): "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.ImageWidth}" />
                                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Spacing="10">
                                                <Button Content="Action"
                                                        Command="{Binding GetPMTImagesByWidthCommand}"
                                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                                <Button Content="Cancel"
                                                        Command="{Binding GetPMTImagesByWidthCancelCommand}"
                                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                        Style="{StaticResource ButtonWarning}" />
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="PTP">
                                    <Grid Margin="5">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Auto Focus: "
                                                           Width="160"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />
                                                <ToggleButton IsChecked="{Binding Cache.IsAutoFocus}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Background="{StaticResource DangerBrush}"
                                                              Style="{StaticResource ToggleButtonSwitch}" />
                                            </StackPanel>
                                            <hc:NumericUpDown hc:TitleElement.Title="ECS: "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Visibility="{Binding Cache.IsAutoFocus, Converter={StaticResource Boolean2VisibilityReConverter}}"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.ECS}" />
                                            <hc:NumericUpDown hc:TitleElement.Title="PTP Length(um): "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.ScanLength}" />
                                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Spacing="10">
                                                <Button Content="Action"
                                                        Command="{Binding GetPMTImagesByPTPCommand}"
                                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                                <Button Content="Cancel"
                                                        Command="{Binding GetPMTImagesByPTPCancelCommand}"
                                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                        Style="{StaticResource ButtonWarning}" />
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="PEG">
                                    <Grid Margin="5">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Auto Focus: "
                                                           Width="160"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />
                                                <ToggleButton IsChecked="{Binding Cache.IsAutoFocus}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Background="{StaticResource DangerBrush}"
                                                              Style="{StaticResource ToggleButtonSwitch}" />
                                            </StackPanel>
                                            <hc:NumericUpDown hc:TitleElement.Title="ECS: "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Visibility="{Binding Cache.IsAutoFocus, Converter={StaticResource Boolean2VisibilityReConverter}}"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.ECS}" />
                                            <hc:NumericUpDown hc:TitleElement.Title="Width(px): "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.ImageWidth}" />
                                            <hc:NumericUpDown hc:TitleElement.Title="PEG Column Count: "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.ColumnCount}" />
                                            <hc:NumericUpDown hc:TitleElement.Title="PEG Column Width(um): "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.ColumnWidth}" />
                                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Spacing="10">
                                                <Button Content="Action"
                                                        Command="{Binding GetPMTImagesByPEGCommand}"
                                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                                <Button Content="Cancel"
                                                        Command="{Binding GetPMTImagesByPEGCancelCommand}"
                                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                        Style="{StaticResource ButtonWarning}" />
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="XZ Sync">
                                    <Grid Margin="5">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <hc:NumericUpDown hc:TitleElement.Title="Scan Length(um): "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.ScanLength}" />
                                            <hc:NumericUpDown hc:TitleElement.Title="Center(ECS): "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.CenterECS}" />
                                            <hc:NumericUpDown hc:TitleElement.Title="±Range(ECS): "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="160"
                                                              Minimum="0"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.RangeECS}" />
                                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Spacing="10">
                                                <Button Content="Action"
                                                        Command="{Binding GetPMTImagesByXZSyncCommand}"
                                                        CommandParameter="{x:Static models:Constants.False}"
                                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                                <Button Content="Cancel"
                                                        Command="{Binding GetPMTImagesByXZSyncCancelCommand}"
                                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                        Style="{StaticResource ButtonWarning}" />
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </hc:UniformSpacingPanel>
                    </ScrollViewer>
                </Border>
                <GridSplitter Grid.Column="1" Width="5" />
                <GroupBox Grid.Column="2" Header="History">
                    <Border Padding="5" Style="{StaticResource BorderRegion}">
                        <ListBox Margin="5"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ItemsSource="{Binding Results}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="-5,2"
                                            Padding="5"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource DarkSuccessBrush}"
                                            Style="{StaticResource BorderRegion}">
                                        <ListBox HorizontalContentAlignment="Stretch" ItemsSource="{Binding .}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type darkField:DarkFieldImageDTO}">
                                                    <Border Height="260"
                                                            Margin="-5,2"
                                                            Padding="5"
                                                            Style="{StaticResource BorderRegion}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="Loaded">
                                                                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MethodName="ScrollToEnd" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                                <TextBlock TextWrapping="Wrap"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Bottom"
                                                                           ToolTip="{Binding RawImageFilePath}">
                                                                    <Hyperlink Command="{x:Static cmd:Commands.OpenFilePathCommand}" CommandParameter="{Binding RawImageFilePath}">
                                                                        <Run Text="{Binding Mode=OneWay}" />
                                                                    </Hyperlink>
                                                                </TextBlock>
                                                            </ScrollViewer>
                                                            <wpfImageViewer:ImageViewerCanvas Grid.Row="1"
                                                                                              BitmapImageDrawable="{Binding Mode=OneWay, Converter={StaticResource DarkFieldImageDTOToBitmapImageDrawableConverter}}"
                                                                                              IsShowCrossLine="True"
                                                                                              IsToggleAddOrModifyRectROIDrawable="False" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</hc:Window>