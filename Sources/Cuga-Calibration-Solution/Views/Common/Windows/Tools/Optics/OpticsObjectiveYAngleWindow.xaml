<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Optics.OpticsObjectiveYAngleWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:helper="clr-namespace:Core.Models.Helper;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Optics"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:generates="clr-namespace:Core.Models.Models.Common.AODWaveform.UI.Generates;assembly=Core.Models"
           xmlns:ui="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:OpticsObjectiveYAngleWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:SimplePanel Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="500"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                 IsInertiaEnabled="True"
                                 VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <GroupBox Header="AOD Waveform Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:UniformSpacingPanel Margin="11,0"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <ComboBox hc:TitleElement.Title="Productivity Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  ItemsSource="{Binding ApplicationCookie.ProductivityInformations}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                        <ComboBox hc:TitleElement.Title="Channel Id: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  SelectedItem="{Binding Cache.ChannelId}"
                                                  Style="{StaticResource ComboBoxExtend}"
                                                  ItemsSource="{x:Static helper:CalibrationConstantsHelper.ChannelIds}" />
                                    </hc:UniformSpacingPanel>
                                    <Expander Header="Prescan AOD Waveform"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <hc:UniformSpacingPanel Margin="11,0"
                                                                        Orientation="Vertical"
                                                                        Spacing="2">
                                                    <hc:NumericUpDown hc:TitleElement.Title="Prescan Frequency(MHz): "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="200"
                                                                      Minimum="0"
                                                                      Style="{StaticResource NumericUpDownExtend}"
                                                                      Value="{Binding Cache.PrescanFrequency}" />
                                                </hc:UniformSpacingPanel>
                                                <generates:GeneratePrescanAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                                      IsVisibleFrequency="False"
                                                                                                      IsVisibleAmplitude="False"
                                                                                                      IsVisibleDirectoryPath="False"
                                                                                                      IsVisibleUniformityConfiguration="False"
                                                                                                      IsVisibleSlopeDeltaKConfiguration="False"
                                                                                                      DataContext="{Binding Cache.GeneratePrescanAODWaveformParam}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <Expander Header="Chirp AOD Waveform"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <hc:UniformSpacingPanel Margin="11,0"
                                                                        Orientation="Vertical"
                                                                        Spacing="2">
                                                    <hc:NumericUpDown hc:TitleElement.Title="Chirp Frequency(MHz): "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="200"
                                                                      Minimum="0"
                                                                      Style="{StaticResource NumericUpDownExtend}"
                                                                      Value="{Binding Cache.ChirpFrequency}" />
                                                </hc:UniformSpacingPanel>
                                                <generates:GenerateChirpAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                                    IsVisibleFrequency="False"
                                                                                                    IsVisibleAmplitude="False"
                                                                                                    IsVisibleDirectoryPath="False"
                                                                                                    IsVisibleUniformityConfiguration="False"
                                                                                                    IsVisibleSlopeDeltaKConfiguration="False"
                                                                                                    DataContext="{Binding Cache.GenerateChirpAODWaveformParam}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <TextBox Text="{Binding Cache.HazeBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                             hc:TitleElement.Title="Haze BF Machine Position(um):"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding Cache.ShinyWaferBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                             hc:TitleElement.Title="Shiny BF Machine Position(um):"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <Button Content="Refresh Machine Position"
                                            Command="{Binding RefreshBFMachinePositionCommand}"
                                            Style="{StaticResource ButtonDefault}" />
                                    <ComboBox HorizontalAlignment="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.Title="Haze Laser Light Information: "
                                              SelectedItem="{Binding Cache.HazeLaserLightInformation}"
                                              ItemsSource="{Binding ApplicationCookie.LaserLightInformations}" />
                                    <ComboBox HorizontalAlignment="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.Title="Shiny Laser Light Information: "
                                              SelectedItem="{Binding Cache.ShinyWaferLaserLightInformation}"
                                              ItemsSource="{Binding ApplicationCookie.LaserLightInformations}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Wait Time(s): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.WaitTime}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Rotate Angle(°): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="-180"
                                                      Maximum="180"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.RotateAngle}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Threshold(°): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.Threshold}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Optics Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:NumericUpDown hc:TitleElement.Title="Center Channel Lens Diameter(um): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="300"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.CenterChannelLensDiameterUm}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Center Channel Lens Maximum Angle(°): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="300"
                                                      Minimum="0"
                                                      Maximum="360"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.CenterChannelLensMaximumAngle}" />
                                    <TextBox Text="{Binding Cache.DegreePerUm, Mode=OneWay, StringFormat={}{0:f5}}"
                                             hc:TitleElement.Title="DegreePerUm(°/um):"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="300"
                                             Background="{StaticResource SecondaryRegionBrush}"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Actions">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                                    <StackPanel>
                                        <TextBlock Text="Result"
                                                   HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <TextBox Text="{Binding Cache.Result.PixelSize, StringFormat={}{0:f5}}"
                                             hc:TitleElement.Title="Pixel Size(um/pix):"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="300"
                                             Background="{StaticResource SecondaryRegionBrush}"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding Cache.Result.HorizontalDegree, StringFormat={}{0:f5}}"
                                             hc:TitleElement.Title="Center Channel Light Horizontal Degree(°):"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="300"
                                             Background="{StaticResource SecondaryRegionBrush}"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding Cache.Result.YAngleDegrees, StringFormat={}{0:f5}}"
                                             hc:TitleElement.Title="Y Angle(°): "
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="300"
                                             IsReadOnly="True"
                                             Background="{StaticResource SecondaryRegionBrush}">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.Result.IsOk}" Value="{x:Static models:Constants.True}">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.Result.IsOk}" Value="{x:Static models:Constants.False}">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Step1 Action"
                                                Command="{Binding Step0Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Step1 Cancel"
                                                Command="{Binding Step0CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                                  Content="Prescan AOD Waveform Profiles"
                                                  HorizontalAlignment="Left"
                                                  hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                    <Popup Width="800"
                                           Height="800"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                                           Placement="Right"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide"
                                           IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}">
                                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                            <ui:PrescanAODWaveformProfilesUserControl DataContext="{Binding Cache.PrescanAODWaveformProfiles}" />
                                        </Border>
                                    </Popup>
                                    <ToggleButton x:Name="ToggleButtonChirpAODWaveformProfiles"
                                                  Content="Chirp AOD Waveform Profiles"
                                                  HorizontalAlignment="Left"
                                                  hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                    <Popup Width="800"
                                           Height="800"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=ToggleButtonChirpAODWaveformProfiles}"
                                           Placement="Right"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide"
                                           IsOpen="{Binding IsChecked, ElementName=ToggleButtonChirpAODWaveformProfiles, Mode=TwoWay}">
                                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                            <ui:ChirpAODWaveformProfilesUserControl DataContext="{Binding Cache.ChirpAODWaveformProfiles}" />
                                        </Border>
                                    </Popup>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </hc:ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" />
            <GroupBox Grid.Column="2" Header="History">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <UniformGrid Rows="3" Columns="1">
                        <UniformGrid.Resources>
                            <Style TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBaseStyle}">
                                <Setter Property="Margin" Value="5" />
                            </Style>
                        </UniformGrid.Resources>
                        <GroupBox Header="Haze">
                            <view:CanvasView AxisColor="Red"
                                             BackgroundColor="#0A0A0A"
                                             BackgroundImage="{Binding Cache.Result.HazeImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False" />
                        </GroupBox>
                        <GroupBox Header="Shiny Wafer">
                            <view:CanvasView AxisColor="Red"
                                             BackgroundColor="#0A0A0A"
                                             BackgroundImage="{Binding Cache.Result.ShinyWaferImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False" />
                        </GroupBox>
                        <GroupBox Header="Result">
                            <view:CanvasView AxisColor="Red"
                                             BackgroundColor="#0A0A0A"
                                             BackgroundImage="{Binding Cache.Result.ResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False" />
                        </GroupBox>
                    </UniformGrid>
                </Border>
            </GroupBox>
        </Grid>
    </Grid>
</hc:Window>