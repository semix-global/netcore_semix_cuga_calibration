<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.EFEMWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:enums="clr-namespace:Core.Models.Enums.EFEM;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
           xmlns:valueConverters="clr-namespace:ValueConverters;assembly=ValueConverters"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Width="800"
           Height="900"
           attachedHelper:LoadingHelper.IsShow="{Binding IsEnable, Converter={StaticResource BoolNegationConverter}}"
           d:DataContext="{d:DesignInstance Type=viewModels:EFEMWindowViewModel}"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           ShowInTaskbar="False"
           ResizeMode="NoResize"
           BorderThickness="2"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <Window.Resources>
        <valueConverters:BoolToObjectConverter x:Key="BoolToFoupBrushConverter"
                                               TrueValue="{x:Static Brushes.DarkGreen}"
                                               FalseValue="{x:Static Brushes.DarkGray}" />
        <valueConverters:BoolToObjectConverter x:Key="BoolToFoupForeBrushConverter"
                                               TrueValue="{x:Static Brushes.Red}"
                                               FalseValue="{x:Static Brushes.White}" />
        <valueConverters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Equipment Front End Module"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Front Opening Unified Pod  -->
                <Border Padding="5"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <StackPanel>
                            <TextBlock Text="FOUP1"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <Button Content="Load Foup"
                                Command="{Binding LoadFoupCommand}"
                                CommandParameter="{x:Static enums:EFEMStationEnum.P1}"
                                Margin="10,0"
                                Style="{StaticResource ButtonDefault.Small}" />
                        <Button Content="UnLoad Foup"
                                Command="{Binding UnLoadFoupCommand}"
                                CommandParameter="{x:Static enums:EFEMStationEnum.P1}"
                                Margin="10,0"
                                Style="{StaticResource ButtonDefault.Small}" />
                        <Button Content="Mapping"
                                Command="{Binding GetMapDataCommand}"
                                CommandParameter="{x:Static enums:EFEMStationEnum.P1}"
                                Margin="10,0"
                                Style="{StaticResource ButtonDefault.Small}" />
                        <ListBox Padding="5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 hc:BorderElement.CornerRadius="5"
                                 hc:BorderElement.Circular="True"
                                 BorderThickness="1"
                                 BorderBrush="Black"
                                 Background="LightGray"
                                 ItemsSource="{Binding EFEMFoupLoadPort1}">
                            <i:Interaction.Behaviors>
                                <behaviors:SelectorBehavior BindableSelectedItem="{Binding SelectedFoupItem, Mode=TwoWay}" />
                            </i:Interaction.Behaviors>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListBoxItemBaseStyle.Small}" TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="1" />
                                    <Setter Property="Height" Value="23" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="BorderBrush" Value="Blue" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="150"
                                            Padding="2"
                                            Style="{StaticResource BorderRegion}"
                                            Effect="{StaticResource EffectShadow1}"
                                            BorderThickness="1"
                                            BorderBrush="Black"
                                            CornerRadius="1"
                                            Background="{Binding IsHasWafer, Converter={StaticResource BoolToFoupBrushConverter}}">
                                        <TextBlock Text="{Binding SlotId}"
                                                   Margin="5,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding IsLoadWafer, Converter={StaticResource BoolToFoupForeBrushConverter}}"
                                                   FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border Grid.Column="2"
                        Padding="5"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <StackPanel>
                            <TextBlock Text="FOUP2"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <Button Content="Load Foup"
                                Command="{Binding LoadFoupCommand}"
                                CommandParameter="{x:Static enums:EFEMStationEnum.P2}"
                                Margin="10,0"
                                Style="{StaticResource ButtonDefault.Small}" />
                        <Button Content="UnLoad Foup"
                                Command="{Binding UnLoadFoupCommand}"
                                CommandParameter="{x:Static enums:EFEMStationEnum.P2}"
                                Margin="10,0"
                                Style="{StaticResource ButtonDefault.Small}" />
                        <Button Content="Mapping"
                                Command="{Binding GetMapDataCommand}"
                                CommandParameter="{x:Static enums:EFEMStationEnum.P2}"
                                Margin="10,0"
                                Style="{StaticResource ButtonDefault.Small}" />
                        <ListBox Padding="5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 hc:BorderElement.CornerRadius="5"
                                 hc:BorderElement.Circular="True"
                                 BorderThickness="1"
                                 BorderBrush="Black"
                                 Background="LightGray"
                                 ItemsSource="{Binding EFEMFoupLoadPort2}">
                            <i:Interaction.Behaviors>
                                <behaviors:SelectorBehavior BindableSelectedItem="{Binding SelectedFoupItem, Mode=TwoWay}" />
                            </i:Interaction.Behaviors>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListBoxItemBaseStyle.Small}" TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="1" />
                                    <Setter Property="Height" Value="23" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="BorderBrush" Value="Blue" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="150"
                                            Padding="2"
                                            Style="{StaticResource BorderRegion}"
                                            Effect="{StaticResource EffectShadow1}"
                                            BorderThickness="1"
                                            BorderBrush="Black"
                                            CornerRadius="1"
                                            Background="{Binding IsHasWafer, Converter={StaticResource BoolToFoupBrushConverter}}">
                                        <TextBlock Text="{Binding SlotId}"
                                                   Margin="5,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding IsLoadWafer, Converter={StaticResource BoolToFoupForeBrushConverter}}"
                                                   FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </hc:UniformSpacingPanel>
                </Border>

                <hc:UniformSpacingPanel Grid.Column="4"
                                        Orientation="Vertical"
                                        Spacing="7">
                    <GroupBox Header="MWH">
                        <hc:UniformSpacingPanel Width="275"
                                                HorizontalAlignment="Center"
                                                Orientation="Vertical"
                                                Spacing="10">
                            <hc:ComboBox hc:InfoElement.TitleWidth="80"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Angle(°): "
                                         hc:InfoElement.Placeholder="Select Angle"
                                         hc:InfoElement.Necessary="True"
                                         SelectedItem="{Binding AngleEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enums:EFEMAngleEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <Button Content="Load Wafer" Command="{Binding LoadWaferCommand}" />
                            <Button Content="UnLoad Wafer" Command="{Binding UnLoadWaferCommand}" />
                        </hc:UniformSpacingPanel>
                    </GroupBox>
                </hc:UniformSpacingPanel>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>