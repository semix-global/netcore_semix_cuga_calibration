<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.GrabbingDarkImagePointToPointWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:optics="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
           xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:converters="clr-namespace:Net.Utilities.WPF.Converters;assembly=Net.Utilities.WPF"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
           xmlns:cibMode="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Width="1200"
           Height="935"
           d:DataContext="{d:DesignInstance Type=viewModels:GrabbingDarkImagePointToPointWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Grabbing Dark Image Point To Point"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Padding="2"
                Effect="{StaticResource EffectShadow1}"
                Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="Images">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <hc:ScrollViewer>
                            <Border Padding="5" Style="{StaticResource BorderRegion}">
                                <Border.Resources>
                                    <attachedHelper:BindingProxy x:Key="BindingProxy" Value="{Binding}" />
                                    <ContextMenu x:Key="ContextMenu" Placement="Left">
                                        <MenuItem Command="{Binding Path=Value.(viewModels:GrabbingDarkImagePointToPointWindowViewModel.SavePictureCommand), Source={StaticResource BindingProxy}}"
                                                  CommandParameter="{Binding Path=PlacementTarget.(ContextMenu.Tag), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                                  Header="Save" />
                                        <MenuItem Command="{Binding Path=Value.(viewModels:GrabbingDarkImagePointToPointWindowViewModel.ShowPlotCommand), Source={StaticResource BindingProxy}}"
                                                  CommandParameter="{Binding Path=PlacementTarget.(ContextMenu.Tag), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                                  Header="Show Plot" />
                                    </ContextMenu>
                                </Border.Resources>
                                <ItemsControl VerticalAlignment="Bottom" ItemsSource="{Binding DarkFieldRowScanImageList}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Width" Value="400" />
                                            <Setter Property="Height" Value="400" />
                                            <Setter Property="Margin" Value="5" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <hc:WaterfallPanel hc:PanelElement.FluidMoveBehavior="{StaticResource BehaviorXY200}" Groups="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <hc:SimplePanel>
                                                <view:CanvasView AxisColor="Red"
                                                                 BackgroundColor="#0A0A0A"
                                                                 BackgroundImage="{Binding FilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                 ContextMenu="{StaticResource ContextMenu}"
                                                                 Interactive="True"
                                                                 ShowAxes="True"
                                                                 ShowCursor="False"
                                                                 ShowGrid="False"
                                                                 Tag="{Binding .}" />
                                                <TextBlock Text="{Binding Position, Converter={StaticResource PointToStringConverter}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"
                                                           Foreground="Yellow" />
                                            </hc:SimplePanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </hc:ScrollViewer>
                        <hc:ScrollViewer Grid.Row="2">
                            <Border Padding="5" Style="{StaticResource BorderRegion}">
                                <Border.Resources>
                                    <attachedHelper:BindingProxy x:Key="BindingProxy" Value="{Binding}" />
                                    <ContextMenu x:Key="ContextMenu" Placement="Left">
                                        <MenuItem Command="{Binding Path=Value.(viewModels:GrabbingDarkImagePointToPointWindowViewModel.SavePictureCommand), Source={StaticResource BindingProxy}}"
                                                  CommandParameter="{Binding Path=PlacementTarget.(ContextMenu.Tag), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                                  Header="Save" />
                                        <MenuItem Command="{Binding Path=Value.(viewModels:GrabbingDarkImagePointToPointWindowViewModel.ShowPlotCommand), Source={StaticResource BindingProxy}}"
                                                  CommandParameter="{Binding Path=PlacementTarget.(ContextMenu.Tag), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                                  Header="Show Plot" />
                                    </ContextMenu>
                                </Border.Resources>
                                <ItemsControl VerticalAlignment="Bottom" ItemsSource="{Binding DarkFieldImageList}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Width" Value="400" />
                                            <Setter Property="Height" Value="400" />
                                            <Setter Property="Margin" Value="5" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <hc:WaterfallPanel hc:PanelElement.FluidMoveBehavior="{StaticResource BehaviorXY200}" Groups="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <hc:SimplePanel>
                                                <view:CanvasView AxisColor="Red"
                                                                 BackgroundColor="#0A0A0A"
                                                                 BackgroundImage="{Binding FilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                 ContextMenu="{StaticResource ContextMenu}"
                                                                 Interactive="True"
                                                                 ShowAxes="True"
                                                                 ShowCursor="False"
                                                                 ShowGrid="False"
                                                                 Tag="{Binding .}" />
                                                <TextBlock Text="{Binding Position, Converter={StaticResource PointToStringConverter}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"
                                                           Foreground="Yellow" />
                                            </hc:SimplePanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </hc:ScrollViewer>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Column="1" Width="10" />

                <hc:UniformSpacingPanel Grid.Column="2"
                                        Orientation="Vertical"
                                        Spacing="10">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <StackPanel>
                                <TextBlock Text="Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:ComboBox Margin="0,5,0,5"
                                         HorizontalAlignment="Left"
                                         hc:InfoElement.TitleWidth="150"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Optics Mag: "
                                         SelectedItem="{Binding OpticsMagTypeEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type optics:OpticsMagTypeEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDescriptionConverter.Instance}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:InfoElement.TitleWidth="150"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:Padding="5"
                                         hc:InfoElement.Title="Stage Coordinate: "
                                         SelectedItem="{Binding StageCoordinateSystemEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:StageCoordinateSystemEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDescriptionConverter.Instance}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <hc:NumericUpDown hc:InfoElement.ShowClearButton="True"
                                              hc:InfoElement.Title="XWidth(pixel): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="150"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding XWidth}" />
                            <TextBox Text="{Binding StartPosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitleWidth="150"
                                     hc:InfoElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:ButtonGroup>
                                <Button Content="Get" Command="{Binding GetStartPositionCommand}" />
                            </hc:ButtonGroup>
                            <hc:NumericUpDown hc:InfoElement.Title="Column Number: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="150"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding ColumnNumber}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Column Cell Width(um): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="150"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding ColumnCellWidth}" />
                            <cibMode:CibGrabModeTypeUserControl HorizontalAlignment="Left"
                                                                hc:InfoElement.TitleWidth="150"
                                                                hc:InfoElement.TitlePlacement="Left"
                                                                hc:InfoElement.Title="Cib Grab Mode: "
                                                                DataContext="{Binding CIBConfiguration}" />
                            <hc:SimplePanel>
                                <Button Content="Grabbing"
                                        Command="{Binding GrabbingImageCommand}"
                                        Width="100"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button Content="Grabbing Row Scan"
                                        Command="{Binding GrabbingRowImageCommand}"
                                        Width="140"
                                        Height="30"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                            </hc:SimplePanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                </hc:UniformSpacingPanel>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>