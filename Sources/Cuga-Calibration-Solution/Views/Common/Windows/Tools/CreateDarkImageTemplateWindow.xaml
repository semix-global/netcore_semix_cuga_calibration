<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.CreateDarkImageTemplateWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:behaviors1="clr-namespace:CanvasViewer.Behaviors;assembly=WPF.CanvasViewer"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Width="1200"
           Height="900"
           d:DataContext="{d:DesignInstance Type=viewModels:CreateDarkImageTemplateWindowViewModel}"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           ShowInTaskbar="False"
           ResizeMode="NoResize"
           BorderThickness="2"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Create Template"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <!--#region Left-->
                <view:CanvasView BackgroundColor="#0A0A0A"
                                 AxisColor="Red"
                                 Interactive="True"
                                 ShowAxes="False"
                                 ShowCursor="False"
                                 ShowGrid="False"
                                 BackgroundImage="{Binding ImageFilePath, Converter={StaticResource StringToBitmapFrameConverter}}">
                    <i:Interaction.Behaviors>
                        <behaviors1:CanvasViewerRoiBehavior Rect="{Binding Rect, Mode=TwoWay}" />
                    </i:Interaction.Behaviors>
                </view:CanvasView>
                <!--#endregion-->

                <GridSplitter Grid.Column="1" Width="5" />

                <!--#region Right-->
                <hc:UniformSpacingPanel Grid.Column="2"
                                        Orientation="Vertical"
                                        Spacing="10">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <StackPanel>
                                <TextBlock Text="Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:InfoElement.TitleWidth="120"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Template Type: "
                                         hc:InfoElement.Necessary="True"
                                         SelectedItem="{Binding AlgorithmTemplateTypeEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <hc:ComboBox hc:InfoElement.TitleWidth="120"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Template Size: "
                                         hc:InfoElement.Necessary="True"
                                         SelectedItem="{Binding AlgorithmTemplateSizeEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateSizeEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <TextBox Text="{Binding Rect, Converter={StaticResource RectToStringConverter}}"
                                     hc:InfoElement.TitleWidth="120"
                                     hc:InfoElement.Title="ROI: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsTabStop="False"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding TemplateFilePath}"
                                     TextWrapping="Wrap"
                                     hc:InfoElement.TitleWidth="120"
                                     hc:InfoElement.Title="Template Path: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <view:CanvasView Width="100"
                                             Height="100"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding TemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button Content="OK"
                                        Command="{Binding OkCommand}"
                                        Width="100"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button Content="Cancel"
                                        Command="{Binding CloseCommand}"
                                        Width="100"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                </hc:UniformSpacingPanel>
                <!--#endregion-->
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>