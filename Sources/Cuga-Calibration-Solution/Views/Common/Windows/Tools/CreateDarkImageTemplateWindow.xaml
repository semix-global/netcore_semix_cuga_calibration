<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.CreateDarkImageTemplateWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:behaviors="clr-namespace:CanvasViewer.Behaviors;assembly=WPF.CanvasViewer"
           xmlns:coreBehaviors="clr-namespace:CugaCalibration.Core.Behaviors"
           Width="1200"
           Height="900"
           d:DataContext="{d:DesignInstance Type=viewModels:CreateDarkImageTemplateWindowViewModel}"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           ShowInTaskbar="False"
           ResizeMode="NoResize"
           BorderThickness="2"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Create Template"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <!--#region Left-->
                <view:CanvasView BackgroundColor="#0A0A0A"
                                 AxisColor="Red"
                                 Interactive="True"
                                 ShowAxes="False"
                                 ShowCursor="False"
                                 ShowGrid="False"
                                 BackgroundImage="{Binding ImageFilePath, Converter={StaticResource StringToBitmapFrameConverter}}">
                    <i:Interaction.Behaviors>
                        <!--  十字架标记行为必须置于 RoiBehavior 之前（事件订阅顺序决定命中十字架时清除拾取集合的时机）  -->
                        <coreBehaviors:CanvasViewerMarkPointBehavior Point="{Binding TemplateCenter, Mode=TwoWay}" ShowRoi="{Binding IsRoiVisible}" />
                        <behaviors:CanvasViewerRoiBehavior Rect="{Binding Rect, Mode=TwoWay}" />
                    </i:Interaction.Behaviors>
                </view:CanvasView>
                <!--#endregion-->

                <GridSplitter Grid.Column="1" Width="5" />

                <!--#region Right-->
                <hc:UniformSpacingPanel Grid.Column="2"
                                        Orientation="Vertical"
                                        Spacing="10">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <StackPanel>
                                <TextBlock Text="Step 1"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <Expander Header="{Binding Steps[0]}"
                                      IsExpanded="True"
                                      ExpandDirection="Down">
                                <Border Style="{StaticResource BorderRegion}">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                        <TextBox Text="{Binding Rect, Converter={StaticResource RectToStringConverter}, Mode=OneWay}"
                                                 hc:TitleElement.TitleWidth="120"
                                                 hc:TitleElement.Title="ROI: "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 IsReadOnly="True"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding TemplateFilePath, Mode=OneWay}"
                                                 TextWrapping="Wrap"
                                                 hc:TitleElement.TitleWidth="120"
                                                 hc:TitleElement.Title="Template Path: "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 IsReadOnly="True"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Spacing="10">
                                            <Button Content="Action"
                                                    Command="{Binding Step1Command}"
                                                    Width="100"
                                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                    Style="{StaticResource ButtonPrimary}" />
                                        </hc:UniformSpacingPanel>
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </Expander>
                            <StackPanel>
                                <TextBlock Text="Step 2"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <Expander Header="{Binding Steps[1]}"
                                      IsExpanded="True"
                                      ExpandDirection="Down">
                                <Border Style="{StaticResource BorderRegion}">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                                            <TextBox Text="{Binding TemplateCenterText, Mode=OneWay}"
                                                     hc:TitleElement.TitleWidth="120"
                                                     hc:TitleElement.Title="Template Center: "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     IsReadOnly="True"
                                                     IsTabStop="False"
                                                     Style="{StaticResource TextBoxExtend}" />
                                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Spacing="10">
                                                <Button Content="Action"
                                                        Command="{Binding Step2Command}"
                                                        Width="100"
                                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                        Style="{StaticResource ButtonPrimary}" />
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </Expander>
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button Content="OK"
                                        Command="{Binding OkCommand}"
                                        Width="100"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button Content="Cancel"
                                        Command="{Binding CloseCommand}"
                                        Width="100"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                </hc:UniformSpacingPanel>
                <!--#endregion-->
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>