<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Stage.RTAWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Stage"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:graphicsWPF="clr-namespace:Net.Utilities.Graphics.WPF;assembly=Net.Utilities.Graphics.WPF"
           xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
           xmlns:local="clr-namespace:CugaCalibration.Views.Common.Windows.Tools.Stage"
           xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.HandyControl.AttachedHelper;assembly=Net.Utilities.WPF.HandyControl"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
           xmlns:itemsControlBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
           Width="1500"
           Height="1000"
           MinWidth="1200"
           MinHeight="800"
           d:DataContext="{d:DesignInstance Type=viewModels:RTAWindowViewModel}"
           attachedHelper:LoadingHelper.IsShow="{Binding LoadedCommand.IsRunning}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="CanResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="{Binding Name}"
                       Padding="8"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Center"
                       Foreground="White"
                       FontWeight="Bold"
                       Style="{StaticResource TextBlockDefault}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBlock>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Foreground="White"
                    Style="{StaticResource ButtonIcon}" />
        </hc:SimplePanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <GroupBox Header="Params" IsEnabled="{Binding IsEditable}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <ComboBox hc:TitleElement.Title="Productivity Information: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          ItemsSource="{Binding ApplicationCookie.OpticsMagTypeProductivityInformations}"
                                          Style="{StaticResource ComboBoxExtend}">
                                    <i:Interaction.Behaviors>
                                        <itemsControlBehaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                    </i:Interaction.Behaviors>
                                </ComboBox>
                                <ComboBox hc:TitleElement.Title="Microscope Lens: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}"
                                          Style="{StaticResource ComboBoxExtend}">
                                    <i:Interaction.Behaviors>
                                        <itemsControlBehaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.MicroscopeLensInformation}" FallbackSelectItem="{x:Static pattern:MicroscopeLensInformation.Default}" />
                                    </i:Interaction.Behaviors>
                                </ComboBox>
                                <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          ItemsSource="{Binding ApplicationCookie.LaserLightInformations}"
                                          Style="{StaticResource ComboBoxExtend}">
                                    <i:Interaction.Behaviors>
                                        <itemsControlBehaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                    </i:Interaction.Behaviors>
                                </ComboBox>
                                <ComboBox hc:TitleElement.Title="CIB Information: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          ItemsSource="{Binding ApplicationCookie.CIBInformations}"
                                          Style="{StaticResource ComboBoxExtend}">
                                    <i:Interaction.Behaviors>
                                        <itemsControlBehaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.CIBInformation}" FallbackSelectItem="{x:Static pattern:CIBInformation.Default}" />
                                    </i:Interaction.Behaviors>
                                </ComboBox>
                                <ComboBox hc:TitleElement.Title="Cal Chip: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:CalChipSiteModelEnum}}}"
                                          SelectedItem="{Binding Cache.CalChipSiteModelEnum}"
                                          Style="{StaticResource ComboBoxExtend}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Expander Header="Optics Configuration">
                                    <Border Style="{StaticResource BorderRegion}">
                                        <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.OpticsConfiguration}" />
                                    </Border>
                                </Expander>
                                <Expander Header="CIB Configuration">
                                    <Border Style="{StaticResource BorderRegion}">
                                        <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.CIBConfiguration}" />
                                    </Border>
                                </Expander>
                                <hc:NumericUpDown hc:TitleElement.Title="Wafer Radius(um): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.WaferRadius}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Width(um): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.DiePitchWidth}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Height(um): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.DiePitchHeight}" />
                                <hc:UniformSpacingPanel Spacing="10">
                                    <Button Content="Mark"
                                            Command="{Binding AddStageMapTemplateCommand}"
                                            Style="{StaticResource ButtonPrimary.Loading}" />
                                    <Button Content="Delete"
                                            Command="{Binding RemoveStageMapTemplatesCommand}"
                                            CommandParameter="{Binding SelectedItems, ElementName=MarkerListView}"
                                            Style="{StaticResource ButtonDanger}" />
                                </hc:UniformSpacingPanel>
                                <ListView x:Name="MarkerListView"
                                          ItemsSource="{Binding Cache.StageMapTemplates}"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          Style="{StaticResource ListView.Small}">
                                    <i:Interaction.Behaviors>
                                        <itemsControlBehaviors:ListBoxScrollToCurrentBehavior />
                                    </i:Interaction.Behaviors>
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridView.ColumnHeaderContainerStyle>
                                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                </Style>
                                            </GridView.ColumnHeaderContainerStyle>
                                            <GridViewColumn Width="60"
                                                            Header="Index"
                                                            DisplayMemberBinding="{Binding DisplayIndex, Mode=OneWay}" />
                                            <GridViewColumn Width="300"
                                                            Header="Machine Position"
                                                            DisplayMemberBinding="{Binding FindBFMachinePosition, Mode=OneWay}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </hc:UniformSpacingPanel>
                        </GroupBox>
                        <GroupBox Header="Workflow">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                <Expander Header="Alignment Settings" IsEnabled="{Binding IsEditable}">
                                    <Border Style="{StaticResource BorderRegion}">
                                        <tools:AlignmentUserControl DataContext="{Binding AlignmentUserControlViewModel}" />
                                    </Border>
                                </Expander>
                                <hc:Divider Content="{Binding Steps[0]}" Margin="0" />
                                <hc:UniformSpacingPanel Spacing="10">
                                    <Button Content="Action"
                                            Command="{Binding Step0Command}"
                                            CommandParameter="{x:Static models:Constants.False}"
                                            Style="{StaticResource ButtonPrimary.Loading}" />
                                    <Button Content="Cancel"
                                            Command="{Binding Step0CancelCommand}"
                                            Style="{StaticResource ButtonWarning}" />
                                </hc:UniformSpacingPanel>
                                <hc:Divider Content="{Binding Steps[1]}" Margin="0" />
                                <hc:UniformSpacingPanel Spacing="10">
                                    <Button Content="Action"
                                            Command="{Binding Step1Command}"
                                            CommandParameter="{x:Static models:Constants.False}"
                                            Style="{StaticResource ButtonPrimary.Loading}" />
                                    <Button Content="Cancel"
                                            Command="{Binding Step1CancelCommand}"
                                            Style="{StaticResource ButtonWarning}" />
                                </hc:UniformSpacingPanel>
                                <hc:Divider Content="{Binding Steps[2]}" Margin="0" />
                                <hc:UniformSpacingPanel Spacing="10">
                                    <Button Content="Action"
                                            Command="{Binding Step2Command}"
                                            CommandParameter="{x:Static models:Constants.False}"
                                            Style="{StaticResource ButtonPrimary.Loading}" />
                                    <Button Content="Cancel"
                                            Command="{Binding Step2CancelCommand}"
                                            Style="{StaticResource ButtonWarning}" />
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </GroupBox>
                        <GroupBox Header="Result">
                            <TextBox Text="{Binding Cache.IsWaferMapCurrent, Mode=OneWay}"
                                     hc:TitleElement.Title="Wafer Map Current: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="190"
                                     IsReadOnly="True"
                                     Background="{StaticResource SecondaryRegionBrush}"
                                     Style="{StaticResource TextBoxExtend}" />
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" />
            <TabControl Grid.Column="2">
                <i:Interaction.Behaviors>
                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                </i:Interaction.Behaviors>
                <TabItem Header="{Binding Steps[1]}">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <graphicsWPF:WPFCanvasControl Document="{Binding Cache.StageMapDocument}" CursorTextVisibility="Collapsed">
                            <graphicsWPF:WPFCanvasControl.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="pack://application:,,,/Net.Utilities.WPF.CustomControl.Themes;component/Themes/ToolBarStyles.xaml" />
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </graphicsWPF:WPFCanvasControl.Resources>
                            <graphicsWPF:WPFCanvasControl.LeftToolBars>
                                <ToolBar Margin="3,2"
                                         Padding="3,2"
                                         Background="Transparent"
                                         Band="0"
                                         BandIndex="2">
                                    <Button Content="Goto Marker"
                                            Command="{Binding GotoStageMapDocumentSelectedItemPositionCommand}"
                                            CommandParameter="{Binding Cache.StageMapTemplates[0]}" />
                                </ToolBar>
                            </graphicsWPF:WPFCanvasControl.LeftToolBars>
                            <graphicsWPF:WPFCanvasControl.RightToolBars>
                                <ToolBar Margin="3,2"
                                         Padding="3,2"
                                         Background="Transparent"
                                         Band="0"
                                         BandIndex="1">
                                    <TextBlock Style="{StaticResource ToolBarTextBlock}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{local:StageMapDocumentCursorToStringConverter}">
                                                <Binding Path="Cache.StageMapDocument.View.Cursor.Point" />
                                                <Binding Path="Cache.StageMapDocument" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </ToolBar>
                            </graphicsWPF:WPFCanvasControl.RightToolBars>
                        </graphicsWPF:WPFCanvasControl>
                    </Border>
                </TabItem>
                <TabItem Header="Mean Position And FFT">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Cache.ScanResult.RowScans}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding IsForward, StringFormat='Forward: {0}'}">
                                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                    <TextBox Text="{Binding Row, Mode=OneWay}"
                                                             hc:TitleElement.Title="Row: "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <TextBox Text="{Binding IsForward, Mode=OneWay}"
                                                             hc:TitleElement.Title="Forward: "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <TextBox Text="{Binding StartPosition, Mode=OneWay}"
                                                             hc:TitleElement.Title="Start Position: "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <TextBox Text="{Binding StopPosition, Mode=OneWay}"
                                                             hc:TitleElement.Title="Stop Position: "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <TextBox Text="{Binding SampleRate, Mode=OneWay}"
                                                             hc:TitleElement.Title="Sample Rate(kHz): "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <TextBox Text="{Binding RawScanImage.RawImageFilePath, Mode=OneWay}"
                                                             hc:TitleElement.Title="Raw Image: "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <TextBox Text="{Binding Samples.Length, Mode=OneWay}"
                                                             hc:TitleElement.Title="Sample Count: "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <TextBox Text="{Binding AnalysisError, Mode=OneWay}"
                                                             hc:TitleElement.Title="Analysis Error: "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <TextBox Text="{Binding IsAnalysisSuccessful, Mode=OneWay}"
                                                             hc:TitleElement.Title="Analysis Successful: "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                    <TextBox Text="{Binding FFTStatus, Mode=OneWay}"
                                                             hc:TitleElement.Title="FFT: "
                                                             hc:TitleElement.TitlePlacement="Left"
                                                             hc:TitleElement.TitleWidth="190"
                                                             IsReadOnly="True"
                                                             Background="{StaticResource SecondaryRegionBrush}"
                                                             Style="{StaticResource TextBoxExtend}" />
                                                </hc:UniformSpacingPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <v2:PlotControl Grid.Row="1" DataSource="{Binding Cache.ScanResult.PlotDataSource}" />
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</hc:Window>