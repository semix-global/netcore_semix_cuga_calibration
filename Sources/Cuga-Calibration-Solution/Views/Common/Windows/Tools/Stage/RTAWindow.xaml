<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Stage.RTAWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Stage"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:graphicsWPF="clr-namespace:Net.Utilities.Graphics.WPF;assembly=Net.Utilities.Graphics.WPF"
           xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
           xmlns:stage="clr-namespace:CugaCalibration.Views.Common.Windows.Tools.Stage"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.HandyControl.AttachedHelper;assembly=Net.Utilities.WPF.HandyControl"
           xmlns:itemsControlBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
           xmlns:stage1="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
           xmlns:cmd="clr-namespace:Net.Utilities.WPF.Commands.Calibration;assembly=Net.Utilities.WPF.Commands.Calibration"
           xmlns:sys="clr-namespace:System;assembly=mscorlib"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:RTAWindowViewModel}"
           attachedHelper:LoadingHelper.IsShow="{Binding LoadedCommand.IsRunning}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <hc:SimplePanel Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <GroupBox Header="Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <ComboBox hc:TitleElement.Title="Productivity Information: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              ItemsSource="{Binding ApplicationCookie.OpticsMagTypeProductivityInformations}"
                                              Style="{StaticResource ComboBoxExtend}">
                                        <i:Interaction.Behaviors>
                                            <itemsControlBehaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                        </i:Interaction.Behaviors>
                                    </ComboBox>
                                    <ComboBox hc:TitleElement.Title="Microscope Lens: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              Style="{StaticResource ComboBoxExtend}"
                                              ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}">
                                        <i:Interaction.Behaviors>
                                            <itemsControlBehaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.MicroscopeLensInformation}" FallbackSelectItem="{x:Static pattern:MicroscopeLensInformation.Default}" />
                                        </i:Interaction.Behaviors>
                                    </ComboBox>
                                    <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              Style="{StaticResource ComboBoxExtend}"
                                              ItemsSource="{Binding ApplicationCookie.LaserLightInformations}">
                                        <i:Interaction.Behaviors>
                                            <itemsControlBehaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                        </i:Interaction.Behaviors>
                                    </ComboBox>
                                    <ComboBox hc:TitleElement.Title="CIB Information: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              Style="{StaticResource ComboBoxExtend}"
                                              ItemsSource="{Binding ApplicationCookie.CIBInformations}">
                                        <i:Interaction.Behaviors>
                                            <itemsControlBehaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.CIBInformation}" FallbackSelectItem="{x:Static pattern:CIBInformation.Default}" />
                                        </i:Interaction.Behaviors>
                                    </ComboBox>
                                    <ComboBox hc:TitleElement.Title="Cal Chip: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage1:CalChipSiteModelEnum}}}"
                                              SelectedItem="{Binding Cache.CalChipSiteModelEnum}"
                                              Style="{StaticResource ComboBoxExtend}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Expander Header="Optics Configuration"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.OpticsConfiguration}" />
                                        </Border>
                                    </Expander>
                                    <Expander Header="CIB Configuration"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.CIBConfiguration}" />
                                        </Border>
                                    </Expander>
                                    <Expander Header="{Binding Steps[0]}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <tools:AlignmentUserControl DataContext="{Binding AlignmentUserControlViewModel}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <Expander Header="{Binding Steps[1]}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Width(um): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="200"
                                                                  Minimum="1"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.DiePitchWidth}" />
                                                <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Height(um): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="200"
                                                                  Minimum="1"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.DiePitchHeight}" />
                                                <hc:NumericUpDown hc:TitleElement.Title="Wafer Radius(um): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="200"
                                                                  Minimum="1"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.WaferRadius}" />
                                                <StackPanel>
                                                    <TextBlock Text="StageMap Template Points"
                                                               HorizontalAlignment="Center"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Style="{StaticResource TextBlockDefaultInfo}" />
                                                </StackPanel>
                                                <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                                    <Button Content="Mark"
                                                            Command="{Binding AddStageMapTemplateCommand}"
                                                            CommandParameter="{x:Static models:Constants.False}"
                                                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                            Style="{StaticResource ButtonPrimary.Loading}" />
                                                    <Button Content="Cancel"
                                                            Command="{Binding AddStageMapTemplateCancelCommand}"
                                                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                            Style="{StaticResource ButtonWarning}" />
                                                    <Button Content="Delete"
                                                            Command="{Binding RemoveStageMapTemplatesCommand}"
                                                            CommandParameter="{Binding Path=SelectedItems, ElementName=DataGridTemplatePoints}"
                                                            hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                                                            Style="{StaticResource ButtonDanger}" />
                                                </hc:UniformSpacingPanel>
                                                <DataGrid x:Name="DataGridTemplatePoints"
                                                          MaxHeight="360"
                                                          hc:DataGridAttach.ShowRowNumber="True"
                                                          RowHeight="110"
                                                          Style="{StaticResource DataGrid.Small}"
                                                          HeadersVisibility="All"
                                                          RowHeaderWidth="60"
                                                          CanUserAddRows="False"
                                                          CanUserSortColumns="False"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          ItemsSource="{Binding Cache.StageMapTemplates}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="BF Machine Position(um)" Binding="{Binding FindBFMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <Expander Header="{Binding Steps[2]}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <Expander Header="StageMap Algorithm Configuration"
                                                          IsExpanded="False"
                                                          ExpandDirection="Down">
                                                    <Border Style="{StaticResource BorderRegion}">
                                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                            <hc:NumericUpDown hc:TitleElement.Title="Median Kernel Size: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.MedianKernelSize}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period Row Start: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodRowStart}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period Row Count: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodRowCount}" />
                                                            <ComboBox hc:TitleElement.Title="Period YOperator: "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="230"
                                                                      SelectedItem="{Binding Cache.StageMapConfig.PeriodYOperator}"
                                                                      Style="{StaticResource ComboBoxExtend}">
                                                                <ComboBox.ItemsSource>
                                                                    <x:Array Type="{x:Type sys:String}">
                                                                        <sys:String>mean</sys:String>
                                                                        <sys:String>std</sys:String>
                                                                        <sys:String>range</sys:String>
                                                                    </x:Array>
                                                                </ComboBox.ItemsSource>
                                                            </ComboBox>
                                                            <ComboBox hc:TitleElement.Title="Period XOperator: "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="230"
                                                                      SelectedItem="{Binding Cache.StageMapConfig.PeriodXOperator}"
                                                                      Style="{StaticResource ComboBoxExtend}">
                                                                <ComboBox.ItemsSource>
                                                                    <x:Array Type="{x:Type sys:String}">
                                                                        <sys:String>mean</sys:String>
                                                                        <sys:String>std</sys:String>
                                                                        <sys:String>range</sys:String>
                                                                    </x:Array>
                                                                </ComboBox.ItemsSource>
                                                            </ComboBox>
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period Zero Padding: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodZeroPadding}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period Top N: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodTopN}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period YMin Pixels: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodYMinPixels}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period XMin Pixels: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodXMinPixels}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period YMin Cycles: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodYMinCycles}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period XMin Cycles: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodXMinCycles}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period YMin Distance: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodYMinDistance}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Period XMin Distance: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.PeriodXMinDistance}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Detect Row Limit: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.DetectRowLimit}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Detect Tail Limit: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.DetectTailLimit}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Detect Min Fraction: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.DetectMinFraction}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Detect Max Fraction: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.DetectMaxFraction}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Detect Need Fraction: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.DetectNeedFraction}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Band Smooth Fraction: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.BandSmoothFraction}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Band Window Fraction: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.BandWindowFraction}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Band Edge Fraction: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.BandEdgeFraction}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Template Fraction: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.TemplateFraction}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Template Anchor Row: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.TemplateAnchorRow}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Template Anchor Column: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.TemplateAnchorColumn}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Match Margin: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.MatchMargin}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Match Threshold: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.MatchThreshold}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Match Refresh Threshold: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.MatchRefreshThreshold}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Fit Jitter: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.FitJitter}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Fit Match Ratio: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.FitMatchRatio}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Delta Trim: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.DeltaTrim}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Origin Search Rows: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.OriginSearchRows}" />
                                                            <hc:NumericUpDown hc:TitleElement.Title="Stream Block Rows: "
                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                              hc:TitleElement.TitleWidth="230"
                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                              Value="{Binding Cache.StageMapConfig.StreamBlockRows}" />
                                                            <Button Content="Restore"
                                                                    Command="{Binding Cache.StageMapConfig.RestoreCommand}"
                                                                    CommandParameter="{x:Static models:Constants.False}"
                                                                    HorizontalAlignment="Left"
                                                                    Style="{StaticResource ButtonDefault}" />
                                                        </hc:UniformSpacingPanel>
                                                    </Border>
                                                </Expander>
                                                <Expander Header="Simulator Images"
                                                          IsExpanded="False"
                                                          ExpandDirection="Down"
                                                          Visibility="{Binding IsDevelopment, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Border Style="{StaticResource BorderRegion}">
                                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                            <TextBox x:Name="ForwardSimulatorImageFilePathTextBox"
                                                                     Text="{Binding Cache.ForwardSimulatorImageFilePath}"
                                                                     Height="50"
                                                                     TextWrapping="Wrap"
                                                                     hc:TitleElement.Title="Forward RAW Image: "
                                                                     hc:TitleElement.TitlePlacement="Left"
                                                                     hc:TitleElement.TitleWidth="190"
                                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                                     IsReadOnly="True"
                                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                     Style="{StaticResource TextBoxExtend}" />
                                                            <Button Content="Select File"
                                                                    Command="{x:Static cmd:Commands.SelectFileCommand}"
                                                                    hc:IconElement.Geometry="{StaticResource DragHorizontalGeometry}">
                                                                <Button.CommandParameter>
                                                                    <cmd:SelectFileCommandParameter TextBox="{Binding ElementName=ForwardSimulatorImageFilePathTextBox, Mode=OneWay}" FileExtension=".raw" />
                                                                </Button.CommandParameter>
                                                            </Button>
                                                            <TextBox x:Name="ReverseSimulatorImageFilePathTextBox"
                                                                     Text="{Binding Cache.ReverseSimulatorImageFilePath}"
                                                                     Height="50"
                                                                     TextWrapping="Wrap"
                                                                     hc:TitleElement.Title="Reverse RAW Image: "
                                                                     hc:TitleElement.TitlePlacement="Left"
                                                                     hc:TitleElement.TitleWidth="190"
                                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                                     IsReadOnly="True"
                                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                     Style="{StaticResource TextBoxExtend}" />
                                                            <Button Content="Select File"
                                                                    Command="{x:Static cmd:Commands.SelectFileCommand}"
                                                                    hc:IconElement.Geometry="{StaticResource DragHorizontalGeometry}">
                                                                <Button.CommandParameter>
                                                                    <cmd:SelectFileCommandParameter TextBox="{Binding ElementName=ReverseSimulatorImageFilePathTextBox, Mode=OneWay}" FileExtension=".raw" />
                                                                </Button.CommandParameter>
                                                            </Button>
                                                        </hc:UniformSpacingPanel>
                                                    </Border>
                                                </Expander>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Remove Linear: "
                                                               Width="230"
                                                               VerticalAlignment="Center" />
                                                    <ToggleButton IsChecked="{Binding Cache.IsRemoveLinear}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Background="{StaticResource DangerBrush}"
                                                                  Style="{StaticResource ToggleButtonSwitch}" />
                                                </StackPanel>
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Actions">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <Expander IsExpanded="False" ExpandDirection="Down">
                                        <Expander.Header>
                                            <TextBlock Text="Result" Style="{StaticResource TextBlockDefaultSuccess}" />
                                        </Expander.Header>
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <TextBox Text="{Binding Cache.AlignmentResult.Degrees, StringFormat='0.##########'}"
                                                         hc:TitleElement.Title="Alignment Degrees(°): "
                                                         hc:TitleElement.TitleWidth="150"
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         IsReadOnly="True"
                                                         Background="{StaticResource SecondaryRegionBrush}"
                                                         Style="{StaticResource TextBoxExtend}" />
                                                <TextBox Text="{Binding Cache.AlignmentResult.MarkPoint1, Converter={StaticResource PointToStringConverter}}"
                                                         hc:TitleElement.Title="Mark Point1(um): "
                                                         hc:TitleElement.TitleWidth="150"
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         IsReadOnly="True"
                                                         Background="{StaticResource SecondaryRegionBrush}"
                                                         Style="{StaticResource TextBoxExtend}" />
                                                <TextBox Text="{Binding Cache.AlignmentResult.MarkPoint2, Converter={StaticResource PointToStringConverter}}"
                                                         hc:TitleElement.Title="Mark Point2(um): "
                                                         hc:TitleElement.TitleWidth="150"
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         IsReadOnly="True"
                                                         Background="{StaticResource SecondaryRegionBrush}"
                                                         Style="{StaticResource TextBoxExtend}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <hc:Divider Content="{Binding Steps[0]}" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step0Command}"
                                                CommandParameter="{x:Static models:Constants.False}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="Cancel"
                                                Command="{Binding Step0CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="{Binding Steps[1]}" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step1Command}"
                                                CommandParameter="{x:Static models:Constants.False}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="Cancel"
                                                Command="{Binding Step1CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="{Binding Steps[2]}" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step2Command}"
                                                CommandParameter="{x:Static models:Constants.False}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="Cancel"
                                                Command="{Binding Step2CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" />
            <GroupBox Grid.Column="2"
                      Padding="5"
                      Header="History">
                <TabControl>
                    <TabItem Header="{Binding Steps[1]}">
                        <Border Margin="5" Style="{StaticResource BorderRegion}">
                            <graphicsWPF:WPFCanvasControl Document="{Binding Cache.StageMapDocument}" CursorTextVisibility="Collapsed">
                                <graphicsWPF:WPFCanvasControl.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.MergedDictionaries>
                                            <ResourceDictionary Source="pack://application:,,,/Net.Utilities.WPF.CustomControl.Themes;component/Themes/ToolBarStyles.xaml" />
                                        </ResourceDictionary.MergedDictionaries>
                                    </ResourceDictionary>
                                </graphicsWPF:WPFCanvasControl.Resources>
                                <graphicsWPF:WPFCanvasControl.LeftToolBars>
                                    <ToolBar Margin="3,2"
                                             Padding="3,2"
                                             Background="Transparent"
                                             Band="0"
                                             BandIndex="2">
                                        <ItemsControl ItemsSource="{Binding Cache.StageMapTemplates}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding DisplayIndex}"
                                                            Command="{Binding DataContext.GotoStageMapDocumentSelectedItemPositionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}"
                                                            CommandParameter="{Binding}"
                                                            Height="24"
                                                            Margin="3,0"
                                                            Padding="5,3"
                                                            ContentStringFormat="Goto {0}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ToolBar>
                                </graphicsWPF:WPFCanvasControl.LeftToolBars>
                                <graphicsWPF:WPFCanvasControl.RightToolBars>
                                    <ToolBar Margin="3,2"
                                             Padding="3,2"
                                             Background="Transparent"
                                             Band="0"
                                             BandIndex="1">
                                        <TextBlock d:Text="0, 0 | (0.0, 0.0)" Style="{StaticResource ToolBarTextBlock}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{stage:StageMapDocumentCursorToStringConverter}">
                                                    <Binding Path="Cache.StageMapDocument.View.Cursor.Point" />
                                                    <Binding Path="Cache.StageMapDocument" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </ToolBar>
                                </graphicsWPF:WPFCanvasControl.RightToolBars>
                            </graphicsWPF:WPFCanvasControl>
                        </Border>
                    </TabItem>
                    <TabItem Header="{Binding Steps[2]}">
                        <Border Margin="5" Style="{StaticResource BorderRegion}">
                            <v2:PlotControl DataSource="{Binding Cache.RTAScanResult.PlotDataSource}" />
                        </Border>
                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>
    </Grid>
</hc:Window>