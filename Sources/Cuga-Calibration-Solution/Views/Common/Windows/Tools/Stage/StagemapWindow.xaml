<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Stage.StagemapWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Stage"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:StagemapWindowViewModel}"
           attachedHelper:LoadingHelper.IsShow="{Binding LoadedCommand.IsRunning}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <hc:SimplePanel Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <GroupBox Header="Acquisition Parameters">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:UniformSpacingPanel Margin="11,0"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <ComboBox hc:TitleElement.Title="Microscope Lens: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="180"
                                                  ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.MicroscopeLensInformation}" FallbackSelectItem="{x:Static pattern:MicroscopeLensInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                        <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="180"
                                                  ItemsSource="{Binding ApplicationCookie.LaserLightInformations}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                        <ComboBox hc:TitleElement.Title="CIB Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="180"
                                                  ItemsSource="{Binding ApplicationCookie.CIBInformations}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.CIBInformation}" FallbackSelectItem="{x:Static pattern:CIBInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                    </hc:UniformSpacingPanel>
                                    <Expander Header="Optics Configuration"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.OpticsConfiguration}" />
                                        </Border>
                                    </Expander>
                                    <Expander Header="CIB Configuration"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.CIBConfiguration}" />
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Step Parameters">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <Expander Header="{Binding Steps[0]}"
                                              IsExpanded="True"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Margin="11,0"
                                                                    Orientation="Vertical"
                                                                    Spacing="2">
                                                <ComboBox hc:TitleElement.Title="Productivity Information: "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="180"
                                                          ItemsSource="{Binding ApplicationCookie.OpticsMagTypeProductivityInformations}"
                                                          Style="{StaticResource ComboBoxExtend}">
                                                    <i:Interaction.Behaviors>
                                                        <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                                    </i:Interaction.Behaviors>
                                                </ComboBox>
                                                <TextBox Text="{Binding Cache.AlignmentResult.Degrees, StringFormat='0.##########'}"
                                                         hc:TitleElement.Title="Alignment Degrees(°): "
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         hc:TitleElement.TitleWidth="180"
                                                         IsReadOnly="True"
                                                         Background="{StaticResource SecondaryRegionBrush}"
                                                         Style="{StaticResource TextBoxExtend}" />
                                                <Expander Header="Alignment Parameters"
                                                          IsExpanded="False"
                                                          ExpandDirection="Down">
                                                    <Border Style="{StaticResource BorderRegion}">
                                                        <tools:AlignmentUserControl DataContext="{Binding AlignmentUserControlViewModel}" />
                                                    </Border>
                                                </Expander>
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <Expander Header="{Binding Steps[1]}"
                                              IsExpanded="True"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Margin="11,0"
                                                                    Orientation="Vertical"
                                                                    Spacing="2">
                                                <ComboBox hc:TitleElement.Title="Template Type: "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="180"
                                                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}"
                                                          SelectedItem="{Binding Cache.AlgorithmTemplateTypeEnum}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox hc:TitleElement.Title="Template Size: "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="180"
                                                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateSizeEnum}}}"
                                                          SelectedItem="{Binding Cache.AlgorithmTemplateSizeEnum}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <hc:NumericUpDown hc:TitleElement.Title="Image Width(px): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="180"
                                                                  Minimum="1"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.ImageWidth}" />
                                                <TextBox Text="{Binding Cache.ImageHeight}"
                                                         hc:TitleElement.Title="Captured Image Height(px): "
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         hc:TitleElement.TitleWidth="180"
                                                         IsReadOnly="True"
                                                         Background="{StaticResource SecondaryRegionBrush}"
                                                         Style="{StaticResource TextBoxExtend}" />
                                                <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Width(um): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="180"
                                                                  Minimum="0"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.DiePitchSizeWidth}" />
                                                <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Height(um): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="180"
                                                                  Minimum="0"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.DiePitchSizeHeight}" />
                                                <hc:NumericUpDown hc:TitleElement.Title="Wafer Diameter(um): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="180"
                                                                  Minimum="0"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.WaferDiameter}" />
                                                <TextBlock Margin="0,5,0,0"
                                                           HorizontalAlignment="Center"
                                                           Text="Template Points"
                                                           Style="{StaticResource TextBlockSubTitleBold}"
                                                           Foreground="{StaticResource SuccessBrush}" />
                                                <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                                    <Button Content="Add"
                                                            Command="{Binding AddTemplatePointCommand}"
                                                            hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                                            Style="{StaticResource ButtonInfo}" />
                                                    <Button Content="Delete"
                                                            Command="{Binding RemoveTemplatePointsCommand}"
                                                            CommandParameter="{Binding Path=SelectedItems, ElementName=DataGridTemplatePoints}"
                                                            hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                                                            Style="{StaticResource ButtonDanger}" />
                                                </hc:UniformSpacingPanel>
                                                <DataGrid x:Name="DataGridTemplatePoints"
                                                          MinHeight="120"
                                                          MaxHeight="300"
                                                          hc:DataGridAttach.ShowRowNumber="True"
                                                          Style="{StaticResource DataGrid.Small}"
                                                          HeadersVisibility="All"
                                                          RowHeaderWidth="45"
                                                          CanUserAddRows="False"
                                                          CanUserSortColumns="False"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          ItemsSource="{Binding Cache.TemplatePoints}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Width="170"
                                                                            Header="BF Position(um)"
                                                                            Binding="{Binding FindBrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                                        <DataGridTextColumn Width="*"
                                                                            Header="Bright Template"
                                                                            Binding="{Binding BrightTemplateFilePath}" />
                                                        <DataGridTextColumn Width="*"
                                                                            Header="Dark Template"
                                                                            Binding="{Binding DarkTemplateFilePath}" />
                                                        <DataGridTemplateColumn Width="Auto" Header="Actions">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate DataType="{x:Type viewModels:StagemapTemplatePoint}">
                                                                    <Button Content="Mark"
                                                                            Command="{Binding DataContext.MarkTemplatePointCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Capture the current bright-field position, bright-field template, and dark-field template."
                                                                            Style="{StaticResource ButtonInfo}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Margin="0,5,0,0"
                                                           Text="Later points must stay within one DiePitchSize of the first point and within 2/3 of the PMT image height in Y."
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Style="{StaticResource TextBlockDefault}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <Expander Header="{Binding Steps[2]}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <TextBlock Text="No additional parameters. The scan uses the first template point's Y coordinate for every die row."
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource TextBlockDefaultInfo}" />
                                        </Border>
                                    </Expander>
                                    <Expander Header="{Binding Steps[3]}"
                                              IsExpanded="True"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:NumericUpDown hc:TitleElement.Title="Repeat Count: "
                                                              hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="180"
                                                              Minimum="1"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Cache.RepeatCount}" />
                                        </Border>
                                    </Expander>
                                    <Expander Header="{Binding Steps[4]}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <TextBlock Text="No additional parameters. One Stagemap clone is used for verification."
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource TextBlockDefaultInfo}" />
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Actions">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:Divider Content="{Binding Steps[0]}" Margin="0" />
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                        <Button Content="Alignment"
                                                Command="{Binding Step0Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Cancel"
                                                Command="{Binding Step0CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="{Binding Steps[1]}" Margin="0" />
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                        <Button Content="Generate Wafer Map"
                                                Command="{Binding Step1Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Cancel"
                                                Command="{Binding Step1CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="{Binding Steps[2]}" Margin="0" />
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                        <Button Content="Scan"
                                                Command="{Binding Step2Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Cancel"
                                                Command="{Binding Step2CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="{Binding Steps[3]}" Margin="0" />
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                        <Button Content="Repeated Scan"
                                                Command="{Binding Step3Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Cancel"
                                                Command="{Binding Step3CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="{Binding Steps[4]}" Margin="0" />
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                        <Button Content="Verification Scan"
                                                Command="{Binding Step4Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Cancel"
                                                Command="{Binding Step4CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" />
            <GroupBox Grid.Column="2"
                      Padding="5"
                      Header="Body">
                <Border Style="{StaticResource BorderRegion}">
                    <Grid />
                </Border>
            </GroupBox>
        </Grid>
    </Grid>
</hc:Window>