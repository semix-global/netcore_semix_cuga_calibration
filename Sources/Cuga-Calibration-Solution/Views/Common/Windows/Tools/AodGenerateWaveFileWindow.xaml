<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.AodGenerateWaveFileWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools"
           xmlns:enumAlgorithm="clr-namespace:Net.Utilities.Models.Enums.Maths;assembly=Net.Utilities.Models"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
           xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="GenerateAod"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:AodGenerateWaveFileWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:SimplePanel Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Generate Aod Wave File"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="450"
                    Margin="5,5,0,5"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <TabControl>
                    <TabItem Header="Chirp">
                        <hc:ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                         IsInertiaEnabled="True"
                                         VerticalScrollBarVisibility="Auto">
                            <hc:UniformSpacingPanel Margin="5"
                                                    Orientation="Vertical"
                                                    Spacing="2">
                                <hc:UniformSpacingPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault.Loading}">
                                        <Setter Property="Margin" Value="5" />
                                    </Style>
                                </hc:UniformSpacingPanel.Resources>
                                <GroupBox Header="Params">
                                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <hc:NumericUpDown hc:InfoElement.Title="Sound Package Length(mm): "
                                                              hc:InfoElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="240"
                                                              Minimum="0"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding GenerateChirpAODWaveformParam.SoundPackageLength}" />
                                            <Expander Header="Frequency(MHz)"
                                                      IsExpanded="False"
                                                      ExpandDirection="Down">
                                                <Border Style="{StaticResource BorderRegion}">
                                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Enable Header Footer:  "
                                                                       Width="240"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center" />
                                                            <ToggleButton IsChecked="{Binding GenerateChirpAODWaveformParam.IsHeaderAndFooter}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Background="{StaticResource DarkMaskBrush}"
                                                                          Style="{StaticResource ToggleButtonSwitch}" />
                                                        </StackPanel>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Header Frequency(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          IsEnabled="{Binding GenerateChirpAODWaveformParam.IsHeaderAndFooter}"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.HeaderFrequency}">
                                                            <hc:NumericUpDown.Style>
                                                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:NumericUpDown.Style>
                                                        </hc:NumericUpDown>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Footer Frequency(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          IsEnabled="{Binding GenerateChirpAODWaveformParam.IsHeaderAndFooter}"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.FooterFrequency}">
                                                            <hc:NumericUpDown.Style>
                                                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:NumericUpDown.Style>
                                                        </hc:NumericUpDown>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Band Width(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          IsEnabled="{Binding GenerateChirpAODWaveformParam.IsHeaderAndFooter, Converter={StaticResource BoolNegationConverter}}"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.BandWidth}">
                                                            <hc:NumericUpDown.Style>
                                                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:NumericUpDown.Style>
                                                        </hc:NumericUpDown>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Center Frequency(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          IsEnabled="{Binding GenerateChirpAODWaveformParam.IsHeaderAndFooter, Converter={StaticResource BoolNegationConverter}}"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.CenterFrequency}">
                                                            <hc:NumericUpDown.Style>
                                                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:NumericUpDown.Style>
                                                        </hc:NumericUpDown>
                                                        <hc:ComboBox hc:InfoElement.Title="Monotonic: "
                                                                     hc:InfoElement.TitlePlacement="Left"
                                                                     hc:InfoElement.TitleWidth="240"
                                                                     IsEnabled="{Binding GenerateChirpAODWaveformParam.IsHeaderAndFooter, Converter={StaticResource BoolNegationConverter}}"
                                                                     SelectedItem="{Binding GenerateChirpAODWaveformParam.FunctionMonotonicTypeEnum}"
                                                                     ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:FunctionMonotonicTypeEnum}}}">
                                                            <hc:ComboBox.Style>
                                                                <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:ComboBox.Style>
                                                            <hc:ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                                </DataTemplate>
                                                            </hc:ComboBox.ItemTemplate>
                                                        </hc:ComboBox>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Offset Frequency(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Minimum="0"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.OffsetFrequency}" />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Offset Period Multiple(2pi): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.OffsetFrequencyPeriodMultiple}" />
                                                    </hc:UniformSpacingPanel>
                                                </Border>
                                            </Expander>
                                            <Expander Header="Others"
                                                      IsExpanded="False"
                                                      ExpandDirection="Down">
                                                <Border Style="{StaticResource BorderRegion}">
                                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                        <hc:NumericUpDown hc:InfoElement.Title="SampleRate(Msa/s): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.SampleRate}" />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Amplitude: "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Maximum="1"
                                                                          Minimum="0"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.Amplitude}" />
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.AodWaveDirectory}"
                                                                 Height="50"
                                                                 TextWrapping="Wrap"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 hc:InfoElement.Title="Default Aod Wave Directory:"
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Button Content="Change Aod File Folder" Command="{Binding ChangeChirpAodWaveDirectoryCommand}" />
                                                        <Separator />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Zero Count(sa): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Minimum="0"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.ZeroSampleCount}" />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Endpoint Count(sa): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Minimum="0"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.EndpointSampleCount}" />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Generate Retry Times: "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Maximum="1000000"
                                                                          Minimum="1"
                                                                          Value="{Binding GenerateChirpAODWaveformParam.GenerateRetryTimes}" />
                                                    </hc:UniformSpacingPanel>
                                                </Border>
                                            </Expander>
                                            <Expander Header="Compensation"
                                                      IsExpanded="False"
                                                      ExpandDirection="Down">
                                                <Border Style="{StaticResource BorderRegion}">
                                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.SincCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Sinc Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="0"
                                                                Maximum="10"
                                                                Value="{Binding GenerateChirpAODWaveformParam.SincCoefficient}" />
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.AstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Astigmatism Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GenerateChirpAODWaveformParam.AstigmatismCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.SphericalAberrationCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Spherical Aberration Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GenerateChirpAODWaveformParam.SphericalAberrationCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.SecondaryAstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Secondary Astigmatism Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GenerateChirpAODWaveformParam.SecondaryAstigmatismCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.ComaCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Coma Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GenerateChirpAODWaveformParam.ComaCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.TrefoilCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Trefoil Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GenerateChirpAODWaveformParam.TrefoilCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.QuadrafoilCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Quadrafoil Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GenerateChirpAODWaveformParam.QuadrafoilCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.AlphaOrder, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Alpha Order: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GenerateChirpAODWaveformParam.AlphaOrder}" />
                                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.AlphaOrderCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Alpha Order Coefficient: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GenerateChirpAODWaveformParam.AlphaOrderCoefficient}" />
                                                    </hc:UniformSpacingPanel>
                                                </Border>
                                            </Expander>
                                        </hc:UniformSpacingPanel>
                                    </Border>
                                </GroupBox>
                                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                        <TextBox Text="{Binding GenerateChirpAODWaveformParam.FrequencyAmplitudesFilePath}"
                                                 Height="20"
                                                 TextWrapping="Wrap"
                                                 hc:TitleElement.TitleWidth="200"
                                                 hc:InfoElement.Title="Frequency Amplitudes File:"
                                                 hc:InfoElement.TitlePlacement="Left"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <Button Content="Change Frequency Amplitudes" Command="{Binding ChangeChirpAodWaveFrequencyCompensationsFilePathCommand}" />
                                        <Button Content="Generate" Command="{Binding GenerateChirpAodWaveFileCommand}" />
                                        <TextBox Text="{Binding ChirpAodWaveFilePath}"
                                                 Height="20"
                                                 TextWrapping="Wrap"
                                                 hc:InfoElement.Title="Chirp Aod Wave File Name:"
                                                 hc:InfoElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="240"
                                                 Style="{StaticResource TextBoxExtend}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        <Button Content="Send" Command="{Binding SendChirpAodWaveFileCommand}" />
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </hc:UniformSpacingPanel>
                        </hc:ScrollViewer>
                    </TabItem>
                    <TabItem Header="Prescan">
                        <hc:ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                         IsInertiaEnabled="True"
                                         VerticalScrollBarVisibility="Auto">
                            <hc:UniformSpacingPanel Margin="5"
                                                    Orientation="Vertical"
                                                    Spacing="2">
                                <hc:UniformSpacingPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault.Loading}">
                                        <Setter Property="Margin" Value="5" />
                                    </Style>
                                </hc:UniformSpacingPanel.Resources>
                                <GroupBox Header="Params">
                                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <hc:NumericUpDown hc:InfoElement.Title="Flatness Time(ns): "
                                                              hc:InfoElement.TitlePlacement="Left"
                                                              hc:TitleElement.TitleWidth="240"
                                                              Minimum="0"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding GeneratePrescanAODWaveformParam.FlatnessTime}" />
                                            <Expander Header="Frequency(MHz)"
                                                      IsExpanded="False"
                                                      ExpandDirection="Down">
                                                <Border Style="{StaticResource BorderRegion}">
                                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Enable Header Footer:  "
                                                                       Width="240"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center" />
                                                            <ToggleButton IsChecked="{Binding GeneratePrescanAODWaveformParam.IsHeaderAndFooter}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Background="{StaticResource DarkMaskBrush}"
                                                                          Style="{StaticResource ToggleButtonSwitch}" />
                                                        </StackPanel>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Header Frequency(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          IsEnabled="{Binding GeneratePrescanAODWaveformParam.IsHeaderAndFooter}"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.HeaderFrequency}">
                                                            <hc:NumericUpDown.Style>
                                                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:NumericUpDown.Style>
                                                        </hc:NumericUpDown>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Footer Frequency(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          IsEnabled="{Binding GeneratePrescanAODWaveformParam.IsHeaderAndFooter}"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.FooterFrequency}">
                                                            <hc:NumericUpDown.Style>
                                                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:NumericUpDown.Style>
                                                        </hc:NumericUpDown>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Band Width(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          IsEnabled="{Binding GeneratePrescanAODWaveformParam.IsHeaderAndFooter, Converter={StaticResource BoolNegationConverter}}"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.BandWidth}">
                                                            <hc:NumericUpDown.Style>
                                                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:NumericUpDown.Style>
                                                        </hc:NumericUpDown>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Center Frequency(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          IsEnabled="{Binding GeneratePrescanAODWaveformParam.IsHeaderAndFooter, Converter={StaticResource BoolNegationConverter}}"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.CenterFrequency}">
                                                            <hc:NumericUpDown.Style>
                                                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:NumericUpDown.Style>
                                                        </hc:NumericUpDown>
                                                        <hc:ComboBox hc:InfoElement.Title="Monotonic: "
                                                                     hc:InfoElement.TitlePlacement="Left"
                                                                     hc:InfoElement.TitleWidth="240"
                                                                     IsEnabled="{Binding GeneratePrescanAODWaveformParam.IsHeaderAndFooter, Converter={StaticResource BoolNegationConverter}}"
                                                                     SelectedItem="{Binding GeneratePrescanAODWaveformParam.FunctionMonotonicTypeEnum}"
                                                                     ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:FunctionMonotonicTypeEnum}}}">
                                                            <hc:ComboBox.Style>
                                                                <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="LightGray" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </hc:ComboBox.Style>
                                                            <hc:ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                                </DataTemplate>
                                                            </hc:ComboBox.ItemTemplate>
                                                        </hc:ComboBox>
                                                        <hc:NumericUpDown hc:InfoElement.Title="Offset Frequency(MHz): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Minimum="0"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.OffsetFrequency}" />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Offset Period Multiple(2pi): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.OffsetFrequencyPeriodMultiple}" />
                                                    </hc:UniformSpacingPanel>
                                                </Border>
                                            </Expander>
                                            <Expander Header="Others"
                                                      IsExpanded="False"
                                                      ExpandDirection="Down">
                                                <Border Style="{StaticResource BorderRegion}">
                                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                        <hc:NumericUpDown hc:InfoElement.Title="SampleRate(Msa/s): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Minimum="0"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.SampleRate}" />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Amplitude: "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Maximum="1"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Minimum="0"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.Amplitude}" />
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.AodWaveDirectory}"
                                                                 Height="50"
                                                                 TextWrapping="Wrap"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 hc:InfoElement.Title="Default Aod Wave Directory:"
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Button Content="Change Aod File Folder" Command="{Binding ChangePrescanAodWaveDirectoryCommand}" />
                                                        <Separator />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Zero Count(sa): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Minimum="0"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.ZeroSampleCount}" />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Endpoint Count(sa): "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Minimum="0"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.EndpointSampleCount}" />
                                                        <hc:NumericUpDown hc:InfoElement.Title="Generate Retry Times: "
                                                                          hc:InfoElement.TitlePlacement="Left"
                                                                          hc:TitleElement.TitleWidth="240"
                                                                          Style="{StaticResource NumericUpDownExtend}"
                                                                          Maximum="1000000"
                                                                          Minimum="1"
                                                                          Value="{Binding GeneratePrescanAODWaveformParam.GenerateRetryTimes}" />
                                                    </hc:UniformSpacingPanel>
                                                </Border>
                                            </Expander>
                                            <Expander Header="Compensation"
                                                      IsExpanded="False"
                                                      ExpandDirection="Down">
                                                <Border Style="{StaticResource BorderRegion}">
                                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.SincCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Sinc Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="0"
                                                                Maximum="10"
                                                                Value="{Binding GeneratePrescanAODWaveformParam.SincCoefficient}" />
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.AstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Astigmatism Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GeneratePrescanAODWaveformParam.AstigmatismCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.SphericalAberrationCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Spherical Aberration Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GeneratePrescanAODWaveformParam.SphericalAberrationCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.SecondaryAstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Secondary Astigmatism Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GeneratePrescanAODWaveformParam.SecondaryAstigmatismCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.ComaCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Coma Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GeneratePrescanAODWaveformParam.ComaCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.TrefoilCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Trefoil Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GeneratePrescanAODWaveformParam.TrefoilCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.QuadrafoilCompensationCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Quadrafoil Compensation: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GeneratePrescanAODWaveformParam.QuadrafoilCompensationCoefficient}" />
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.AlphaOrder, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Alpha Order: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GeneratePrescanAODWaveformParam.AlphaOrder}" />
                                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.AlphaOrderCoefficient, StringFormat={}{0:0.###############}}"
                                                                 hc:InfoElement.Title="Alpha Order Coefficient: "
                                                                 hc:InfoElement.TitlePlacement="Left"
                                                                 hc:TitleElement.TitleWidth="240"
                                                                 Style="{StaticResource TextBoxExtend}" />
                                                        <Slider VerticalAlignment="Center"
                                                                Minimum="-100"
                                                                Maximum="100"
                                                                Value="{Binding GeneratePrescanAODWaveformParam.AlphaOrderCoefficient}" />
                                                    </hc:UniformSpacingPanel>
                                                </Border>
                                            </Expander>
                                        </hc:UniformSpacingPanel>
                                    </Border>
                                </GroupBox>
                                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                        <TextBox Text="{Binding GeneratePrescanAODWaveformParam.FrequencyAmplitudesFilePath}"
                                                 Height="20"
                                                 TextWrapping="Wrap"
                                                 hc:TitleElement.TitleWidth="200"
                                                 hc:InfoElement.Title="Frequency Amplitudes File:"
                                                 hc:InfoElement.TitlePlacement="Left"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <Button Content="Change Frequency Amplitudes" Command="{Binding ChangePrescanAodWaveFrequencyCompensationsFilePathCommand}" />
                                        <Button Content="Generate" Command="{Binding GeneratePrescanAodWaveFileCommand}" />
                                        <TextBox Text="{Binding PrescanAodWaveFilePath}"
                                                 Height="50"
                                                 TextWrapping="Wrap"
                                                 hc:InfoElement.Title="Prescan Aod Wave File Name:"
                                                 hc:InfoElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="240"
                                                 Style="{StaticResource TextBoxExtend}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        <Button Content="Send" Command="{Binding SendPrescanAodWaveFileCommand}" />
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </hc:UniformSpacingPanel>
                        </hc:ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
            <Border Grid.Column="1"
                    Margin="5"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TabControl Grid.Row="2">
                        <TabItem Header="Aod Wave">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <wpf:WpfPlot Grid.Column="0">
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="Time Domain Signal" Plot0="{Binding AodWaveSignals}" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                                <wpf:WpfPlot Grid.Column="1">
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="Spectrum Analysis" Plot0="{Binding AodWaveSignalsFourier}" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                                <wpf:WpfPlot Grid.Column="2">
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="Dynamic Frequency Amplitude Profile" Plot0="{Binding AodWaveFrequencyAmplitudes}" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Flatness Frequency">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <wpf:WpfPlot Grid.Column="0">
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="Frequency Compensation Components"
                                                                        Plot0="{Binding AodWaveFlatnessLinearFrequencySignals}"
                                                                        Plot0Title="Liner"
                                                                        Plot1="{Binding AodWaveFlatnessAstigmatismCompensationSignals}"
                                                                        Plot1Title="Astigmatism"
                                                                        Plot2="{Binding AodWaveFlatnessSphericalAberrationCompensationSignals}"
                                                                        Plot2Title="Spherical Aberration"
                                                                        Plot3="{Binding AodWaveFlatnessSecondaryAstigmatismCompensationSignals}"
                                                                        Plot3Title="Secondary Astigmatism"
                                                                        Plot4="{Binding AodWaveFlatnessComaCompensationSignals}"
                                                                        Plot4Title="Coma"
                                                                        Plot5="{Binding AodWaveFlatnessTrefoilCompensationSignals}"
                                                                        Plot5Title="Trefoil"
                                                                        Plot6="{Binding AodWaveFlatnessQuadrafoilCompensationSignals}"
                                                                        Plot6Title="Quadrafoil"
                                                                        Plot7="{Binding AodWaveFlatnessAlphaOrderCompensationSignals}"
                                                                        Plot7Title="Alpha Order" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                                <wpf:WpfPlot Grid.Column="1">
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="Synthesized Frequency Profile" Plot0="{Binding AodWaveFlatnessTotalFrequencySignals}" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</hc:Window>