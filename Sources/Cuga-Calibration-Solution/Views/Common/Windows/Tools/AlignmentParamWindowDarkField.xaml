<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.AlignmentParamWindowDarkField"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Alignment"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           d:DataContext="{d:DesignInstance Type=viewModels:AlignmentParamWindowDarkFieldViewModel}"
           SizeToContent="WidthAndHeight"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           ShowInTaskbar="False"
           ResizeMode="NoResize"
           BorderThickness="2"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Dark Field Alignment Param"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                <hc:UniformSpacingPanel Spacing="10">
                    <GroupBox Header="Low Site">
                        <hc:UniformSpacingPanel Width="250"
                                                Orientation="Vertical"
                                                Spacing="10">
                            <hc:ComboBox hc:TitleElement.TitleWidth="160"
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.Title="BF Low Mag: "
                                         SelectedItem="{Binding Cache.LowMag}"
                                         ItemsSource="{Binding MicroscopeLensInformationList}" />
                            <hc:ComboBox hc:TitleElement.TitleWidth="160"
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.Title="BF Low Size: "
                                         SelectedItem="{Binding Cache.LowSizeEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateSizeEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                        </hc:UniformSpacingPanel>
                    </GroupBox>
                    <GroupBox Header="High Site">
                        <hc:UniformSpacingPanel Width="250"
                                                Orientation="Vertical"
                                                Spacing="10">
                            <hc:ComboBox hc:TitleElement.TitleWidth="160"
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.Title="BF High Mag: "
                                         SelectedItem="{Binding Cache.HighMag}"
                                         ItemsSource="{Binding MicroscopeLensInformationList}" />
                            <hc:ComboBox hc:TitleElement.TitleWidth="160"
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.Title="BF High Size: "
                                         SelectedItem="{Binding Cache.HighSizeEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateSizeEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <hc:ComboBox hc:TitleElement.Title="Productivity Information: "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="160"
                                         IsEnabled="{Binding IsToolsEnable}"
                                         IsEditable="True"
                                         IsReadOnly="True"
                                         Style="{StaticResource ComboBoxExtend}"
                                         ItemsSource="{Binding ApplicationCookie.ProductivityInformations}">
                                <i:Interaction.Behaviors>
                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                </i:Interaction.Behaviors>
                            </hc:ComboBox>
                        </hc:UniformSpacingPanel>
                    </GroupBox>
                    <pattern:OpticsConfigurationUserControl DataContext="{Binding OpticsConfiguration}" />
                    <pattern:CIBConfigurationUserControl DataContext="{Binding CIBConfiguration}" />
                </hc:UniformSpacingPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            Orientation="Vertical"
                                            Spacing="5">
                        <hc:ComboBox Width="300"
                                     HorizontalAlignment="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.Title="BF Template Type: "
                                     SelectedItem="{Binding Cache.AlgorithmTemplateTypeEnum}"
                                     ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                            <hc:ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </hc:ComboBox.ItemTemplate>
                        </hc:ComboBox>
                    </hc:UniformSpacingPanel>

                    <Button Grid.Column="1"
                            Content="OK"
                            Command="{Binding CloseCommand}"
                            Width="100"
                            Height="50"
                            Margin="10,0"
                            HorizontalAlignment="Right" />
                </Grid>
            </hc:UniformSpacingPanel>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>