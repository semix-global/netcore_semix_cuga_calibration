<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.FindWaferCenterWindowField"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:views="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.HandyControl.AttachedHelper;assembly=Net.Utilities.WPF.HandyControl"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Width="1100"
           Height="740"
           attachedHelper:LoadingHelper.IsShow="{Binding IsEnable, Converter={StaticResource BoolNegationConverter}}"
           d:DataContext="{d:DesignInstance Type=viewModels:FindWaferCenterWindowFieldViewModel}"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           ShowInTaskbar="False"
           ResizeMode="NoResize"
           BorderThickness="2"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Alignment"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="780" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--#region Left-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <GroupBox Header="Camera">
                        <views:FindWaferCenterByManuallyUserControl DataContext="{Binding DataContext.FindWaferCenterByManuallyWindowViewModel, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </GroupBox>
                </Grid>
                <!--#endregion-->
                <!--#region Right-->
                <hc:UniformSpacingPanel Grid.Column="2"
                                        Orientation="Vertical"
                                        Spacing="10">
                    <Border Grid.Row="1"
                            Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <StackPanel>
                                <TextBlock Text="Result"
                                           HorizontalAlignment="Center"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Spacing="5" />
                            <StackPanel Orientation="Vertical">
                                <TextBox x:Name="ThresholdTextBox"
                                         Text="{Binding AlignmentFindCenterCache.PositionErrorThreshold, StringFormat={}{0:f3}}"
                                         hc:InfoElement.Title="Position Error Threshold(um):"
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding AlignmentFindCenterCache.OffsetPosition, Converter={StaticResource PointToStringConverter}}"
                                         hc:InfoElement.Title="Center offset position:"
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                            </StackPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Grid.Row="2"
                            Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <StackPanel>
                                <TextBlock Text="Stage"
                                           HorizontalAlignment="Center"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Spacing="5" />
                            <StackPanel Orientation="Vertical" />
                            <hc:UniformSpacingPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button x:Name="ActionButton"
                                        Content="Action"
                                        Command="{Binding ActionCommand}"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button x:Name="CancelButton"
                                        Content="Cancel"
                                        Command="{Binding ActionCancelCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                                <Button Content="Finish"
                                        Command="{Binding CloseCommand}"
                                        hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                                        hc:IconElement.Height="20"
                                        Style="{StaticResource ButtonSuccess}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                </hc:UniformSpacingPanel>
                <!--#endregion-->
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>