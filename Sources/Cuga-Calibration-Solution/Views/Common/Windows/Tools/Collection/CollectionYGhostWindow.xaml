<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Collection.CollectionYGhostWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Collection"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
           xmlns:wpfScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:CollectionYGhostWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:SimplePanel Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="500"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                 IsInertiaEnabled="True"
                                 VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <GroupBox Header="Common Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:UniformSpacingPanel Margin="11,0"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <pattern:CIBConfigurationUserControl DataContext="{Binding CIBConfiguration}" />
                                        <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  SelectedItem="{Binding LaserLightInformation}"
                                                  ItemsSource="{Binding ApplicationCookie.LaserLightInformations}"
                                                  Style="{StaticResource ComboBoxExtend}" />
                                        <TextBox Text="{Binding BrightFieldPosition, Converter={StaticResource PointToStringConverter}}"
                                                 hc:TitleElement.Title="Bright Field Position:"
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="200"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <hc:NumericUpDown hc:TitleElement.Title="Image Width(px): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="200"
                                                          Minimum="0"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding ImageWidthPixel}" />
                                        <hc:NumericUpDown hc:TitleElement.Title="Curve MoveDown Threshold: "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="200"
                                                          Minimum="-5"
                                                          Maximum="-0.1"
                                                          Increment="0.1"
                                                          ValueFormat="F2"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding MoveDownThreshold}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Goto 0.16Array Region Action"
                                                Command="{Binding Step00Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Get  PMT8  Pictures  Action"
                                                Command="{Binding Step01Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Get  All Curve  Data  Action"
                                                Command="{Binding Step02Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Result">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:ComboBox HorizontalAlignment="Left"
                                                 hc:InfoElement.TitlePlacement="Left"
                                                 hc:InfoElement.Title="Channel Show Type: "
                                                 hc:TitleElement.TitleWidth="200"
                                                 hc:InfoElement.Necessary="False"
                                                 ItemsSource="{Binding AvailableChannelIds}"
                                                 SelectedItem="{Binding SelectedChannelId, Mode=TwoWay}" />
                                    <TextBox Text="{Binding PMT8Ch1PixselCompare}"
                                             hc:TitleElement.Title="CH1 Pixsel Compare:"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding PMT8Ch2PixselCompare}"
                                             hc:TitleElement.Title="CH2 Pixsel Compare:"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding PMT8Ch3PixselCompare}"
                                             hc:TitleElement.Title="CH3 Pixsel Compare:"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             IsReadOnly="True"
                                             IsEnabled="False"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </hc:ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" />
            <Border Grid.Column="2"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <TabControl>
                    <i:Interaction.Behaviors>
                        <wpf:SelectorAutoSelectFirstBehavior />
                    </i:Interaction.Behaviors>
                    <TabItem Header="All Images">
                        <TabControl SelectedIndex="0">
                            <TabItem Header="Image1">
                                <view:CanvasView BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="False"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding PMT8ChImagePath[0], Converter={StaticResource StringToBitmapFrameConverter}}" />
                            </TabItem>
                            <TabItem Header="Image2">
                                <view:CanvasView BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="False"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding PMT8ChImagePath[1], Converter={StaticResource StringToBitmapFrameConverter}}" />
                            </TabItem>
                            <TabItem Header="Image3">
                                <view:CanvasView BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="False"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding PMT8ChImagePath[2], Converter={StaticResource StringToBitmapFrameConverter}}" />
                            </TabItem>
                            <TabItem Header="Image4">
                                <view:CanvasView BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="False"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding PMT8ChImagePath[3], Converter={StaticResource StringToBitmapFrameConverter}}" />
                            </TabItem>
                            <TabItem Header="Image5">
                                <view:CanvasView BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="False"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding PMT8ChImagePath[4], Converter={StaticResource StringToBitmapFrameConverter}}" />
                            </TabItem>
                            <TabItem Header="Image6">
                                <view:CanvasView BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="False"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding PMT8ChImagePath[5], Converter={StaticResource StringToBitmapFrameConverter}}" />
                            </TabItem>
                            <TabItem Header="Image7">
                                <view:CanvasView BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="False"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding PMT8ChImagePath[6], Converter={StaticResource StringToBitmapFrameConverter}}" />
                            </TabItem>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="All Curves">
                        <TabControl SelectedIndex="0">
                            <TabItem Header="CurveCH1">
                                <Grid>
                                    <wpfScottPlot:WpfPlot Margin="5">
                                        <i:Interaction.Behaviors>
                                            <behaviors:WpfPlotMultiBehavior Title="Y Ghost Curve"
                                                                            Plot0Title="Curve1"
                                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                            Plot0="{Binding YGhostListCH11}"
                                                                            Plot1Title="Curve2"
                                                                            Plot1Color="{x:Static scottPlot:Colors.Red}"
                                                                            Plot1="{Binding YGhostListCH12}"
                                                                            Plot2Title="Curve3"
                                                                            Plot2Color="{x:Static scottPlot:Colors.Yellow}"
                                                                            Plot2="{Binding YGhostListCH13}"
                                                                            Plot3Title="Curve4"
                                                                            Plot3Color="{x:Static scottPlot:Colors.Blue}"
                                                                            Plot3="{Binding YGhostListCH14}"
                                                                            Plot4Title="Curve5"
                                                                            Plot4Color="{x:Static scottPlot:Colors.DarkOrange}"
                                                                            Plot4="{Binding YGhostListCH15}"
                                                                            Plot5Title="Curve6"
                                                                            Plot5Color="{x:Static scottPlot:Colors.Gold}"
                                                                            Plot5="{Binding YGhostListCH16}"
                                                                            Plot6Title="Curve7"
                                                                            Plot6Color="{x:Static scottPlot:Colors.Gray}"
                                                                            Plot6="{Binding YGhostListCH17}" />
                                        </i:Interaction.Behaviors>
                                    </wpfScottPlot:WpfPlot>
                                </Grid>
                            </TabItem>
                            <TabItem Header="CurveCH2">
                                <Grid>
                                    <wpfScottPlot:WpfPlot Margin="5">
                                        <i:Interaction.Behaviors>
                                            <behaviors:WpfPlotMultiBehavior Title="Y Ghost Curve"
                                                                            Plot0Title="Curve1"
                                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                            Plot0="{Binding YGhostListCH21}"
                                                                            Plot1Title="Curve2"
                                                                            Plot1Color="{x:Static scottPlot:Colors.Red}"
                                                                            Plot1="{Binding YGhostListCH22}"
                                                                            Plot2Title="Curve3"
                                                                            Plot2Color="{x:Static scottPlot:Colors.Yellow}"
                                                                            Plot2="{Binding YGhostListCH23}"
                                                                            Plot3Title="Curve4"
                                                                            Plot3Color="{x:Static scottPlot:Colors.Blue}"
                                                                            Plot3="{Binding YGhostListCH24}"
                                                                            Plot4Title="Curve5"
                                                                            Plot4Color="{x:Static scottPlot:Colors.DarkOrange}"
                                                                            Plot4="{Binding YGhostListCH25}"
                                                                            Plot5Title="Curve6"
                                                                            Plot5Color="{x:Static scottPlot:Colors.Gold}"
                                                                            Plot5="{Binding YGhostListCH26}"
                                                                            Plot6Title="Curve7"
                                                                            Plot6Color="{x:Static scottPlot:Colors.Gray}"
                                                                            Plot6="{Binding YGhostListCH27}" />
                                        </i:Interaction.Behaviors>
                                    </wpfScottPlot:WpfPlot>
                                </Grid>
                            </TabItem>
                            <TabItem Header="CurveCH3">
                                <Grid>
                                    <wpfScottPlot:WpfPlot Margin="5">
                                        <i:Interaction.Behaviors>
                                            <behaviors:WpfPlotMultiBehavior Title="Y Ghost Curve"
                                                                            Plot0Title="Curve1"
                                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                            Plot0="{Binding YGhostListCH31}"
                                                                            Plot1Title="Curve2"
                                                                            Plot1Color="{x:Static scottPlot:Colors.Red}"
                                                                            Plot1="{Binding YGhostListCH32}"
                                                                            Plot2Title="Curve3"
                                                                            Plot2Color="{x:Static scottPlot:Colors.Yellow}"
                                                                            Plot2="{Binding YGhostListCH33}"
                                                                            Plot3Title="Curve4"
                                                                            Plot3Color="{x:Static scottPlot:Colors.Blue}"
                                                                            Plot3="{Binding YGhostListCH34}"
                                                                            Plot4Title="Curve5"
                                                                            Plot4Color="{x:Static scottPlot:Colors.DarkOrange}"
                                                                            Plot4="{Binding YGhostListCH35}"
                                                                            Plot5Title="Curve6"
                                                                            Plot5Color="{x:Static scottPlot:Colors.Gold}"
                                                                            Plot5="{Binding YGhostListCH36}"
                                                                            Plot6Title="Curve7"
                                                                            Plot6Color="{x:Static scottPlot:Colors.Gray}"
                                                                            Plot6="{Binding YGhostListCH37}" />
                                        </i:Interaction.Behaviors>
                                    </wpfScottPlot:WpfPlot>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</hc:Window>