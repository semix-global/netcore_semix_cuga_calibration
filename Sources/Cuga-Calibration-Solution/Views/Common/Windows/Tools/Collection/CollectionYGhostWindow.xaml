<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Collection.CollectionYGhostWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Collection"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
           xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
           xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:CollectionYGhostWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>

        <Border Grid.Row="1"
                Margin="1"
                Padding="2"
                Effect="{StaticResource EffectShadow1}"
                Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource BorderRegion}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <GroupBox Header="Params">
                                <Border Style="{StaticResource BorderRegion}">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                        <hc:ComboBox hc:TitleElement.Title="Optics Illumination Mode: "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="160"
                                                     ItemsSource="{Binding ApplicationCookie.OpticsIlluminationModeEnums}"
                                                     SelectedItem="{Binding Cache.OpticsIlluminationModeEnum}"
                                                     Style="{StaticResource ComboBoxExtend}" />
                                        <hc:ComboBox hc:TitleElement.Title="Productivity Information: "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="160"
                                                     IsEditable="True"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                            <hc:ComboBox.ItemsSource>
                                                <MultiBinding Converter="{StaticResource MultiApplicationCookieToProductivityInformationsConvert}">
                                                    <Binding Path="ApplicationCookie" />
                                                    <Binding Path="Cache.OpticsIlluminationModeEnum" />
                                                </MultiBinding>
                                            </hc:ComboBox.ItemsSource>
                                        </hc:ComboBox>
                                        <ComboBox hc:TitleElement.Title="Cal Chip: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="160"
                                                  ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:CalChipSiteModelEnum}}}"
                                                  SelectedItem="{Binding Cache.CalChipSiteModelEnum}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="160"
                                                  ItemsSource="{Binding ApplicationCookie.LaserLightInformations}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                        <hc:NumericUpDown hc:TitleElement.Title="Width(px): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="160"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.ImageWidth}" />
                                        <TextBox Text="{Binding Cache.StartPosition, Converter={StaticResource PointToStringConverter}}"
                                                 hc:TitleElement.Title="Start Position(um): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="160"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding Cache.StopPosition, Converter={StaticResource PointToStringConverter}}"
                                                 hc:TitleElement.Title="Stop Position(um): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="160"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <hc:NumericUpDown hc:TitleElement.Title="Grab Cout: "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="160"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.GrabCount}" />
                                        <TextBox Text="{Binding Cache.YStep, Mode=OneWay}"
                                                 hc:TitleElement.Title="Y Step(um): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="160"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 IsReadOnly="True"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <hc:NumericUpDown hc:TitleElement.Title="Align Value(dB): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="160"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.AligndBValue}" />
                                        <hc:NumericUpDown hc:TitleElement.Title="YUmStandard(um): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="160"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.YUmStandard}" />
                                        <hc:NumericUpDown hc:TitleElement.Title="Threshold(dB): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="160"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.Threshold}" />
                                        <Expander ExpandDirection="Down"
                                                  Header="Optics Configuration"
                                                  IsExpanded="False">
                                            <Border Style="{StaticResource BorderRegion}">
                                                <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.OpticsConfiguration}" />
                                            </Border>
                                        </Expander>
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </GroupBox>
                            <GroupBox Header="Actions">
                                <Border Style="{StaticResource BorderRegion}">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                        <hc:Divider Content="{Binding Steps[0]}" Margin="0" />
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <TextBox Text="{Binding Cache.AlignmentResult.Degrees, StringFormat='0.##########'}"
                                                     hc:TitleElement.Title="Alignment Degrees(°): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="150"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource TextBoxExtend}" />
                                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Spacing="10">
                                                <Button Content="Action"
                                                        Command="{Binding Step0Command}"
                                                        CommandParameter="{x:Static models:Constants.False}"
                                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                        Style="{StaticResource ButtonPrimary.Loading}">
                                                    <Button.IsEnabled>
                                                        <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                            <Binding Path="Step0Command.IsRunning" />
                                                            <Binding Path="Step1Command.IsRunning" />
                                                        </MultiBinding>
                                                    </Button.IsEnabled>
                                                </Button>
                                                <Button Content="Cancel"
                                                        Command="{Binding Step0CancelCommand}"
                                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                        Style="{StaticResource ButtonWarning}" />
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>
                                        <hc:Divider Content="{Binding Steps[1]}" Margin="0" />
                                        <hc:UniformSpacingPanel Spacing="10">
                                            <Button Content="Action"
                                                    Command="{Binding Step1Command}"
                                                    CommandParameter="{x:Static models:Constants.False}"
                                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                    Style="{StaticResource ButtonPrimary.Loading}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                        <Binding Path="Step0Command.IsRunning" />
                                                        <Binding Path="Step1Command.IsRunning" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                            <Button Content="Cancel"
                                                    Command="{Binding Step1CancelCommand}"
                                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                    Style="{StaticResource ButtonWarning}" />
                                        </hc:UniformSpacingPanel>
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </GroupBox>
                        </hc:UniformSpacingPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" />

                <GroupBox Grid.Column="2" Header="History">
                    <Border Padding="5" Style="{StaticResource BorderRegion}">
                        <TabControl ItemsSource="{Binding YGhostResults}">
                            <i:Interaction.Behaviors>
                                <wpf:SelectorAutoSelectFirstBehavior />
                            </i:Interaction.Behaviors>
                            <TabControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:CollectionYGhostResult}">
                                    <TextBlock Text="{Binding CIBInformation}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type viewModels:CollectionYGhostResult}">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="7*" />
                                                <RowDefinition Height="5" />
                                                <RowDefinition Height="3*" />
                                            </Grid.RowDefinitions>
                                            <v2:PlotControl DataSource="{Binding PlotDataSource}" />
                                            <GridSplitter Grid.Row="1" Width="5" />
                                            <ListBox Grid.Row="2" ItemsSource="{Binding Items}">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewModels:CollectionYGhostResultItem}">
                                                        <Border Width="250"
                                                                Height="300"
                                                                Style="{StaticResource BorderRegion}">
                                                            <Grid>
                                                                <view:CanvasView AxisColor="Red"
                                                                                 BackgroundColor="#0A0A0A"
                                                                                 BackgroundImage="{Binding ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                                 Interactive="True"
                                                                                 ShowAxes="False"
                                                                                 ShowCursor="False"
                                                                                 ShowGrid="False" />
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding FindPosition, StringFormat={}Find Position: {0:F2}}"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="Yellow" />
                                                                    <TextBlock Grid.Row="1"
                                                                               Text="{Binding YGhostResultValue, StringFormat={}Y Ghost: {0:F3} dB}"
                                                                               HorizontalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsOk}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Border>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</hc:Window>