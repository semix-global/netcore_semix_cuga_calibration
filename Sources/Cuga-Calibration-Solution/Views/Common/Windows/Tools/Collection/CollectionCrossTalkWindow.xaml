<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.Collection.CollectionCrossTalkWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
           xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
           xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.Collection"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:CollectionCrossTalkWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>

        <Border Grid.Row="1"
                Margin="1"
                Padding="2"
                Effect="{StaticResource EffectShadow1}"
                Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource BorderRegion}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <GroupBox Header="Params">
                                <Border Style="{StaticResource BorderRegion}">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                        <hc:ComboBox hc:TitleElement.Title="Optics Illumination Mode: "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="160"
                                                     ItemsSource="{Binding ApplicationCookie.OpticsIlluminationModeEnums}"
                                                     SelectedItem="{Binding Cache.OpticsIlluminationModeEnum}"
                                                     Style="{StaticResource ComboBoxExtend}" />
                                        <hc:ComboBox hc:TitleElement.Title="Productivity Information: "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="160"
                                                     IsEditable="True"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                            <hc:ComboBox.ItemsSource>
                                                <MultiBinding Converter="{StaticResource MultiApplicationCookieToProductivityInformationsConvert}">
                                                    <Binding Path="ApplicationCookie" />
                                                    <Binding Path="Cache.OpticsIlluminationModeEnum" />
                                                </MultiBinding>
                                            </hc:ComboBox.ItemsSource>
                                        </hc:ComboBox>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CIB Informations: "
                                                       Width="160"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />
                                            <ListBox Grid.Column="1"
                                                     Height="300"
                                                     ItemContainerStyle="{StaticResource ListBoxItemStyle.Center}"
                                                     ItemsSource="{Binding ApplicationCookie.CIBInformations}"
                                                     SelectionMode="Extended">
                                                <i:Interaction.Behaviors>
                                                    <behaviors:ListBoxScrollToCurrentBehavior />
                                                    <behaviors:ListBoxSelectedItemsBehavior BindableSelectedItems="{Binding Cache.CIBInformations}" Type="{x:Type pattern:CIBInformation}" />
                                                </i:Interaction.Behaviors>
                                            </ListBox>
                                        </Grid>
                                        <ComboBox hc:TitleElement.Title="Cal Chip: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="160"
                                                  ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:CalChipSiteModelEnum}}}"
                                                  SelectedItem="{Binding Cache.CalChipSiteModelEnum}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="160"
                                                  ItemsSource="{Binding ApplicationCookie.LaserLightInformations}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                        <hc:NumericUpDown hc:TitleElement.Title="Width(px): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="160"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.ImageWidth}" />
                                        <TextBox Text="{Binding Cache.ScribeFindPosition, Converter={StaticResource PointToStringConverter}}"
                                                 hc:TitleElement.Title="Scribe BF Position(um): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="160"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding Cache.SignalFindPosition, Converter={StaticResource PointToStringConverter}}"
                                                 hc:TitleElement.Title="Signal BF Position(um): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="160"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <Expander ExpandDirection="Down"
                                                  Header="Optics Configuration"
                                                  IsExpanded="False">
                                            <Border Style="{StaticResource BorderRegion}">
                                                <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.OpticsConfiguration}" />
                                            </Border>
                                        </Expander>
                                        <StackPanel>
                                            <TextBlock Text="Step 1 Params"
                                                       HorizontalAlignment="Center"
                                                       Style="{StaticResource TextBlockDefaultInfo}" />
                                        </StackPanel>
                                        <Expander ExpandDirection="Down"
                                                  Header="{Binding Steps[0]}"
                                                  IsExpanded="False">
                                            <Border Style="{StaticResource BorderRegion}">
                                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                    <tools:AlignmentUserControl DataContext="{Binding .AlignmentUserControlViewModel}" />
                                                </hc:UniformSpacingPanel>
                                            </Border>
                                        </Expander>
                                        <StackPanel>
                                            <TextBlock Text="Step 2 Params"
                                                       HorizontalAlignment="Center"
                                                       Style="{StaticResource TextBlockDefaultInfo}" />
                                        </StackPanel>
                                        <Expander ExpandDirection="Down"
                                                  Header="{Binding Steps[1]}"
                                                  IsExpanded="False">
                                            <Border Style="{StaticResource BorderRegion}">
                                                <hc:UniformSpacingPanel Orientation="Vertical">
                                                    <view:CanvasView Width="150"
                                                                     Height="150"
                                                                     BackgroundColor="#0A0A0A"
                                                                     BackgroundImage="{Binding Cache.CropQuietFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                     Interactive="True"
                                                                     ShowAxes="False"
                                                                     ShowCursor="False"
                                                                     ShowGrid="False" />
                                                </hc:UniformSpacingPanel>
                                            </Border>
                                        </Expander>
                                        <StackPanel>
                                            <TextBlock Text="Step 3 Params"
                                                       HorizontalAlignment="Center"
                                                       Style="{StaticResource TextBlockDefaultInfo}" />
                                        </StackPanel>
                                        <Expander ExpandDirection="Down"
                                                  Header="{Binding Steps[2]}"
                                                  IsExpanded="False">
                                            <Border Style="{StaticResource BorderRegion}">
                                                <hc:UniformSpacingPanel Orientation="Vertical">
                                                    <view:CanvasView Width="150"
                                                                     Height="150"
                                                                     BackgroundColor="#0A0A0A"
                                                                     BackgroundImage="{Binding Cache.CropSignalFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                     Interactive="True"
                                                                     ShowAxes="False"
                                                                     ShowCursor="False"
                                                                     ShowGrid="False" />
                                                </hc:UniformSpacingPanel>
                                            </Border>
                                        </Expander>
                                        <StackPanel>
                                            <TextBlock Text="Step 4 Params"
                                                       HorizontalAlignment="Center"
                                                       Style="{StaticResource TextBlockDefaultInfo}" />
                                        </StackPanel>
                                        <Expander ExpandDirection="Down"
                                                  Header="{Binding Steps[3]}"
                                                  IsExpanded="False">
                                            <Border Style="{StaticResource BorderRegion}">
                                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                    <hc:NumericUpDown hc:TitleElement.Title="Threshold(radio): "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="160"
                                                                      Style="{StaticResource NumericUpDownExtend}"
                                                                      Value="{Binding Cache.Threshold}" />
                                                </hc:UniformSpacingPanel>
                                            </Border>
                                        </Expander>
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </GroupBox>
                            <GroupBox Header="Actions">
                                <Border Style="{StaticResource BorderRegion}">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                        <hc:Divider Content="{Binding Steps[0]}" Margin="0" />
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <TextBox Text="{Binding Cache.AlignmentResult.Degrees, StringFormat='0.##########'}"
                                                     hc:TitleElement.Title="Alignment Degrees(°): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="150"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource TextBoxExtend}" />
                                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Spacing="10">
                                                <Button Content="Action"
                                                        Command="{Binding Step0Command}"
                                                        CommandParameter="{x:Static models:Constants.False}"
                                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                        Style="{StaticResource ButtonPrimary.Loading}">
                                                    <Button.IsEnabled>
                                                        <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                            <Binding Path="Step0Command.IsRunning" />
                                                            <Binding Path="Step1Command.IsRunning" />
                                                            <Binding Path="Step2Command.IsRunning" />
                                                            <Binding Path="Step3Command.IsRunning" />
                                                        </MultiBinding>
                                                    </Button.IsEnabled>
                                                </Button>
                                                <Button Content="Cancel"
                                                        Command="{Binding Step0CancelCommand}"
                                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                        Style="{StaticResource ButtonWarning}" />
                                            </hc:UniformSpacingPanel>
                                        </hc:UniformSpacingPanel>
                                        <hc:Divider Content="{Binding Steps[1]}" Margin="0" />
                                        <hc:UniformSpacingPanel Spacing="10">
                                            <Button Content="Action"
                                                    Command="{Binding Step1Command}"
                                                    CommandParameter="{x:Static models:Constants.False}"
                                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                    Style="{StaticResource ButtonPrimary.Loading}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                        <Binding Path="Step0Command.IsRunning" />
                                                        <Binding Path="Step1Command.IsRunning" />
                                                        <Binding Path="Step2Command.IsRunning" />
                                                        <Binding Path="Step3Command.IsRunning" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                            <Button Content="Cancel"
                                                    Command="{Binding Step1CancelCommand}"
                                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                    Style="{StaticResource ButtonWarning}" />
                                        </hc:UniformSpacingPanel>
                                        <hc:Divider Content="{Binding Steps[2]}" Margin="0" />
                                        <hc:UniformSpacingPanel Spacing="10">
                                            <Button Content="Action"
                                                    Command="{Binding Step2Command}"
                                                    CommandParameter="{x:Static models:Constants.False}"
                                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                    Style="{StaticResource ButtonPrimary.Loading}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                        <Binding Path="Step0Command.IsRunning" />
                                                        <Binding Path="Step1Command.IsRunning" />
                                                        <Binding Path="Step2Command.IsRunning" />
                                                        <Binding Path="Step3Command.IsRunning" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                            <Button Content="Cancel"
                                                    Command="{Binding Step2CancelCommand}"
                                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                    Style="{StaticResource ButtonWarning}" />
                                        </hc:UniformSpacingPanel>
                                        <hc:Divider Content="{Binding Steps[3]}" Margin="0" />
                                        <hc:UniformSpacingPanel Spacing="10">
                                            <Button Content="Action"
                                                    Command="{Binding Step3Command}"
                                                    CommandParameter="{x:Static models:Constants.False}"
                                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                    Style="{StaticResource ButtonPrimary.Loading}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                        <Binding Path="Step0Command.IsRunning" />
                                                        <Binding Path="Step1Command.IsRunning" />
                                                        <Binding Path="Step2Command.IsRunning" />
                                                        <Binding Path="Step3Command.IsRunning" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                            <Button Content="Cancel"
                                                    Command="{Binding Step3CancelCommand}"
                                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                    Style="{StaticResource ButtonWarning}" />
                                        </hc:UniformSpacingPanel>
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </GroupBox>
                        </hc:UniformSpacingPanel>
                    </ScrollViewer>
                </Border>
                <GridSplitter Grid.Column="1" Width="5" />


                <GroupBox Grid.Column="2" Header="Data">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8*" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="HistoryListView"
                                  ItemsSource="{Binding Results}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ListView.Small}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOk}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn DisplayMemberBinding="{Binding CIBInformation}" Header="CIB Information" />
                                    <GridViewColumn DisplayMemberBinding="{Binding BackgroundNoise, StringFormat={}{0:F3}}" Header="Background Gray" />
                                    <GridViewColumn DisplayMemberBinding="{Binding ScribeResult.SubGray, StringFormat={}{0:F3}}" Header="Cross Talk" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Diff, StringFormat={}{0:F3}}" Header="Diff Gray" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Radio, StringFormat={}{0:F3}}" Header="Radio" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Log10, StringFormat={}{0:F6}}" Header="Log10" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <GridSplitter Grid.Row="1" Height="5" />
                        <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                            <TabControl>
                                <TabItem Header="Details">
                                    <ListBox HorizontalContentAlignment="Stretch" ItemsSource="{Binding Results}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:CollectionCrossTalkDTO}">
                                                <Border Height="300"
                                                        HorizontalAlignment="Stretch"
                                                        Style="{StaticResource BorderRegion}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <GroupBox Header="CIB Information">
                                                            <Label Content="{Binding CIBInformation}"
                                                                   Padding="0"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Background="Transparent"
                                                                   BorderBrush="Transparent"
                                                                   BorderThickness="0" />
                                                        </GroupBox>
                                                        <GroupBox Grid.Column="1" Header="Diff">
                                                            <Label Content="{Binding Diff, StringFormat={}{0:F3}}"
                                                                   Padding="0"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Background="Transparent"
                                                                   BorderBrush="Transparent"
                                                                   BorderThickness="0" />
                                                        </GroupBox>
                                                        <Grid Grid.Column="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <GroupBox Header="Scribe">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Margin="5">
                                                                        <view:CanvasView AxisColor="Red"
                                                                                         BackgroundColor="#0A0A0A"
                                                                                         BackgroundImage="{Binding ScribeResult.ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                                         Interactive="True"
                                                                                         ShowAxes="False"
                                                                                         ShowCursor="False"
                                                                                         ShowGrid="False" />
                                                                    </Grid>
                                                                    <Grid Grid.Column="1" Margin="5">
                                                                        <view:CanvasView AxisColor="Red"
                                                                                         BackgroundColor="#0A0A0A"
                                                                                         BackgroundImage="{Binding ScribeResult.SubImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                                         Interactive="True"
                                                                                         ShowAxes="False"
                                                                                         ShowCursor="False"
                                                                                         ShowGrid="False" />
                                                                        <TextBlock Text="{Binding ScribeResult.SubGray, StringFormat={}Gray Value: {0:F3}}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Top"
                                                                                   Foreground="Yellow" />
                                                                    </Grid>
                                                                </Grid>
                                                            </GroupBox>
                                                            <GroupBox Grid.Column="1" Header="Signal">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Margin="5">
                                                                        <view:CanvasView AxisColor="Red"
                                                                                         BackgroundColor="#0A0A0A"
                                                                                         BackgroundImage="{Binding SignalResult.ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                                         Interactive="True"
                                                                                         ShowAxes="False"
                                                                                         ShowCursor="False"
                                                                                         ShowGrid="False" />
                                                                    </Grid>
                                                                    <Grid Grid.Column="1" Margin="5">
                                                                        <view:CanvasView AxisColor="Red"
                                                                                         BackgroundColor="#0A0A0A"
                                                                                         BackgroundImage="{Binding SignalResult.SubImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                                         Interactive="True"
                                                                                         ShowAxes="False"
                                                                                         ShowCursor="False"
                                                                                         ShowGrid="False" />
                                                                        <TextBlock Text="{Binding SignalResult.SubGray, StringFormat={}Gray Value: {0:F3}}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Top"
                                                                                   Foreground="Yellow" />
                                                                    </Grid>
                                                                </Grid>
                                                            </GroupBox>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</hc:Window>