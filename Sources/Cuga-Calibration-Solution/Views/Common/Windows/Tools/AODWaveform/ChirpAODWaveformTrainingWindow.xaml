<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.AODWaveform.ChirpAODWaveformTrainingWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:paramUI="clr-namespace:Core.Models.Models.Common.AODWaveform.UI.Generates;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.AODWaveform"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:profileUI="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
           xmlns:darkField="clr-namespace:Core.Models.Models.Common.DarkField;assembly=Core.Models"
           xmlns:aodWaveform="clr-namespace:CugaCalibration.Views.Common.Windows.Tools.AODWaveform"
           xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:ChirpAODWaveformTrainingWindowViewModel}"
           attachedHelper:LoadingHelper.IsShow="{Binding LoadedCommand.IsRunning}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <paramUI:GenerateAODWaveformSlopeConfigurationsToStringConvert x:Key="GenerateAODWaveformSlopeConfigurationsToStringConvert" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:SimplePanel Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <GroupBox Header="AOD Waveform Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:UniformSpacingPanel Margin="11,0"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <ComboBox hc:TitleElement.Title="Productivity Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  ItemsSource="{Binding ApplicationCookie.OpticsMagTypeProductivityInformations}"
                                                  Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                        <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="200"
                                                  Style="{StaticResource ComboBoxExtend}"
                                                  ItemsSource="{Binding ApplicationCookie.LaserLightInformations}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                        </ComboBox>
                                    </hc:UniformSpacingPanel>
                                    <StackPanel>
                                        <Button Content="Import AOD Waveform Params"
                                                Command="{Binding ImportAODWaveformParamsCommand}"
                                                HorizontalAlignment="Right"
                                                hc:IconElement.Geometry="{StaticResource ImportGeometry}"
                                                Style="{StaticResource ButtonInfo.Small}" />
                                    </StackPanel>
                                    <Expander IsExpanded="False" ExpandDirection="Down">
                                        <Expander.Header>
                                            <TextBlock Text="Chirp AOD Waveform" Style="{StaticResource TextBlockDefaultInfo}" />
                                        </Expander.Header>
                                        <Border Style="{StaticResource BorderRegion}">
                                            <paramUI:GenerateChirpAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                              IsVisibleDirectoryPath="False"
                                                                                              IsVisibleSlopeConfiguration="False"
                                                                                              DataContext="{Binding Cache.GenerateChirpAODWaveformParam}" />
                                        </Border>
                                    </Expander>
                                    <Expander IsExpanded="False" ExpandDirection="Down">
                                        <Expander.Header>
                                            <TextBlock Text="Prescan AOD Waveform" />
                                        </Expander.Header>
                                        <Border Style="{StaticResource BorderRegion}">
                                            <paramUI:GeneratePrescanAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                                IsVisibleAmplitude="False"
                                                                                                IsVisibleDirectoryPath="False"
                                                                                                DataContext="{Binding Cache.GeneratePrescanAODWaveformParam}" />
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <ComboBox hc:TitleElement.Title="CIB Information: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              Style="{StaticResource ComboBoxExtend}"
                                              ItemsSource="{Binding ApplicationCookie.CIBInformations}">
                                        <i:Interaction.Behaviors>
                                            <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.CIBInformation}" FallbackSelectItem="{x:Static pattern:CIBInformation.Default}" />
                                        </i:Interaction.Behaviors>
                                    </ComboBox>
                                    <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.OpticsConfiguration}" />
                                    <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.CIBConfiguration}" />
                                    <StackPanel>
                                        <TextBlock Text="Step 1 Params"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <Expander Header="{Binding Steps[0]}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <tools:AlignmentUserControl DataContext="{Binding .AlignmentUserControlViewModel}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <StackPanel>
                                        <TextBlock Text="Step 2 Params"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <Expander Header="{Binding Steps[1]}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <ComboBox hc:TitleElement.Title="Microscope Lens: "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="160"
                                                          ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}"
                                                          Style="{StaticResource ComboBoxExtend}">
                                                    <i:Interaction.Behaviors>
                                                        <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.MicroscopeLensInformation}" FallbackSelectItem="{x:Static pattern:MicroscopeLensInformation.Default}" />
                                                    </i:Interaction.Behaviors>
                                                </ComboBox>
                                                <TextBox Text="{Binding Cache.DSWFindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                                         hc:TitleElement.Title="Position(um): "
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         hc:TitleElement.TitleWidth="160"
                                                         Style="{StaticResource TextBoxExtend}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <StackPanel>
                                        <TextBlock Text="Step 3 Params"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <Expander Header="{Binding Steps[2]}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <hc:NumericUpDown hc:TitleElement.Title="Scan Length(um): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="160"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.ScanLength}" />
                                                <hc:NumericUpDown hc:TitleElement.Title="Center(ECS): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="160"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.CenterECS}" />
                                                <hc:NumericUpDown hc:TitleElement.Title="±Range(ECS): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="160"
                                                                  Minimum="0"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.RangeECS}" />
                                                <Border Style="{StaticResource BorderRegion}">
                                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                        <StackPanel>
                                                            <TextBlock Text="Params"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Style="{StaticResource TextBlockDefaultInfo}" />
                                                        </StackPanel>
                                                        <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                                            <Button Content="Add"
                                                                    Command="{Binding AddChirpAODWaveformTrainingSlopeCommand}"
                                                                    hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                                                    Style="{StaticResource ButtonInfo}" />
                                                            <Button Content="Delete"
                                                                    Command="{Binding RemoveChirpAODWaveformTrainingSlopeCommand}"
                                                                    CommandParameter="{Binding Path=SelectedItems, ElementName=ListBoxChirpAODWaveformTrainingSlopes}"
                                                                    hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                                                                    Style="{StaticResource ButtonDanger}" />
                                                        </hc:UniformSpacingPanel>
                                                        <ListBox x:Name="ListBoxChirpAODWaveformTrainingSlopes"
                                                                 HorizontalContentAlignment="Stretch"
                                                                 SelectionMode="Extended"
                                                                 ItemsSource="{Binding Cache.ChirpAODWaveformTrainingSlopes}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type viewModels:ChirpAODWaveformTrainingSlope}">
                                                                    <Border Margin="0,2" Style="{StaticResource BorderRegion}">
                                                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                                            <hc:NumericUpDown hc:TitleElement.Title="Start: "
                                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                                              hc:TitleElement.TitleWidth="200"
                                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                                              ValueFormat="0.##################"
                                                                                              Value="{Binding StartDeltaKRate}" />
                                                                            <hc:NumericUpDown hc:TitleElement.Title="Step: "
                                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                                              hc:TitleElement.TitleWidth="200"
                                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                                              ValueFormat="0.##################"
                                                                                              Value="{Binding StepDeltaKRate}" />
                                                                            <hc:NumericUpDown hc:TitleElement.Title="Stop: "
                                                                                              hc:TitleElement.TitlePlacement="Left"
                                                                                              hc:TitleElement.TitleWidth="200"
                                                                                              Style="{StaticResource NumericUpDownExtend}"
                                                                                              ValueFormat="0.##################"
                                                                                              Value="{Binding StopDeltaKRate}" />
                                                                            <hc:UniformSpacingPanel Spacing="10">
                                                                                <Button Content="Action"
                                                                                        Command="{Binding Path=DataContext.TrainingCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}"
                                                                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                                                        Style="{StaticResource ButtonPrimary.Loading}">
                                                                                    <Button.CommandParameter>
                                                                                        <MultiBinding Converter="{aodWaveform:ChirpAODWaveformTrainingConvert}">
                                                                                            <Binding />
                                                                                            <Binding Source="{x:Static models:Constants.False}" />
                                                                                        </MultiBinding>
                                                                                    </Button.CommandParameter>
                                                                                </Button>
                                                                                <Button Content="Cancel"
                                                                                        Command="{Binding Path=DataContext.TrainingCancelCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=hc:Window}}"
                                                                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                                                        Style="{StaticResource ButtonWarning}" />
                                                                            </hc:UniformSpacingPanel>
                                                                        </hc:UniformSpacingPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </hc:UniformSpacingPanel>
                                                </Border>
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Training Actions">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Is Confirm Result: "
                                                       Width="120"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />
                                            <ToggleButton IsChecked="{Binding Cache.IsConfirmBestYStrehlRatioResult}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Background="{StaticResource DangerBrush}"
                                                          Style="{StaticResource ToggleButtonSwitch}" />
                                        </StackPanel>
                                        <Button Content="Continue"
                                                Command="{Binding ContinueCommand}"
                                                Style="{StaticResource ButtonDefault}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="{Binding Steps[0]}" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="2" Orientation="Vertical">
                                        <TextBox Text="{Binding Cache.AlignmentResult.Degrees, StringFormat='0.##########'}"
                                                 hc:TitleElement.Title="Alignment Degrees(°): "
                                                 hc:TitleElement.TitleWidth="150"
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Spacing="10">
                                            <Button Content="Action"
                                                    Command="{Binding Step0Command}"
                                                    CommandParameter="{x:Static models:Constants.False}"
                                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                    Style="{StaticResource ButtonPrimary.Loading}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                        <Binding Path="Step0Command.IsRunning" />
                                                        <Binding Path="Step1Command.IsRunning" />
                                                        <Binding Path="Step2Command.IsRunning" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                            <Button Content="Cancel"
                                                    Command="{Binding Step0CancelCommand}"
                                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                    Style="{StaticResource ButtonWarning}" />
                                        </hc:UniformSpacingPanel>
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="{Binding Steps[1]}" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step1Command}"
                                                CommandParameter="{x:Static models:Constants.False}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="Cancel"
                                                Command="{Binding Step1CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="{Binding Steps[2]}" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step2Command}"
                                                CommandParameter="{x:Static models:Constants.False}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="Cancel"
                                                Command="{Binding Step2CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" />
            <GroupBox Grid.Column="2" Header="History">
                <TabControl>
                    <TabItem Header="Items">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Margin="0,5" Style="{StaticResource BorderRegion}">
                                <TextBlock>
                                    <Run Text="[Best] Y Strehl: " />
                                    <Run Text="{Binding Cache.Item.BestFocus.BestYStrehlRatioPoint, Converter={StaticResource PointYToStringConverter}, ConverterParameter='0.###'}" />
                                    <Run Text=", " />
                                    <Run Text="Slope Configurations: " />
                                    <Run Text="{Binding Cache.Item.SlopeConfigurations, Converter={StaticResource GenerateAODWaveformSlopeConfigurationsToStringConvert}}" />
                                </TextBlock>
                            </Border>
                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding Cache.Items}"
                                      SelectedItem="{Binding Cache.SelectedItem}"
                                      Style="{StaticResource ListView.Small}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ListBoxScrollToCurrentBehavior />
                                </i:Interaction.Behaviors>
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MultiValueEqualsConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.Cache.Item"
                                                                 Mode="OneWay"
                                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Y Strehl" DisplayMemberBinding="{Binding BestFocus.BestYStrehlRatioPoint, Converter={StaticResource PointYToStringConverter}, ConverterParameter='0.###'}" />
                                        <GridViewColumn Header="Profiles">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type viewModels:ChirpAODWaveformTrainingItem}">
                                                    <Grid>
                                                        <ToggleButton x:Name="ToggleButtonAODWaveformProfiles"
                                                                      Content="Profiles"
                                                                      Margin="0,2"
                                                                      HorizontalAlignment="Left"
                                                                      hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                                        <Popup Width="800"
                                                               Height="800"
                                                               StaysOpen="False"
                                                               PlacementTarget="{Binding ElementName=ToggleButtonAODWaveformProfiles}"
                                                               Placement="Right"
                                                               AllowsTransparency="True"
                                                               PopupAnimation="Slide"
                                                               IsOpen="{Binding IsChecked, ElementName=ToggleButtonAODWaveformProfiles, Mode=TwoWay}">
                                                            <TabControl>
                                                                <TabItem Header="Chirp AOD Waveform">
                                                                    <profileUI:ChirpAODWaveformProfilesUserControl Margin="5" DataContext="{Binding ChirpAODWaveformProfiles}" />
                                                                </TabItem>
                                                                <TabItem Header="Prescan AOD Waveform">
                                                                    <profileUI:PrescanAODWaveformProfilesUserControl Margin="5" DataContext="{Binding PrescanAODWaveformProfiles}" />
                                                                </TabItem>
                                                            </TabControl>
                                                        </Popup>
                                                    </Grid>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="400" Header="Slope Configurations">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type viewModels:ChirpAODWaveformTrainingItem}">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding SlopeConfigurations, Converter={StaticResource GenerateAODWaveformSlopeConfigurationsToStringConvert}}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="400" Header="Raw File Path">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type viewModels:ChirpAODWaveformTrainingItem}">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Hyperlink Command="{x:Static wpf:Commands.OpenFilePathCommand}" CommandParameter="{Binding BestFocus.RawImageFilePath}">
                                                            <Run Text="{Binding BestFocus.RawImageFilePath}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <GridSplitter Grid.Row="2" Height="5" />
                            <darkField:BestFocusUserControl Grid.Row="3" DataContext="{Binding Cache.SelectedItem.BestFocus}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Best Item">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Raw File Path: "
                                                   Width="120"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <TextBlock TextWrapping="Wrap">
                                            <Hyperlink Command="{x:Static wpf:Commands.OpenFilePathCommand}" CommandParameter="{Binding Cache.Item.BestFocus.RawImageFilePath}">
                                                <Run Text="{Binding Cache.Item.BestFocus.RawImageFilePath}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                    <DataGrid x:Name="DataGridSlopeConfigurations"
                                              MaxHeight="500"
                                              hc:DataGridAttach.ShowRowNumber="True"
                                              Style="{StaticResource DataGrid.Small}"
                                              HeadersVisibility="All"
                                              RowHeaderWidth="60"
                                              AutoGenerateColumns="False"
                                              ItemsSource="{Binding Cache.Item.SlopeConfigurations}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="100"
                                                                IsReadOnly="True"
                                                                Header="Delta K Rate"
                                                                Binding="{Binding DeltaKRate, StringFormat='0.##################'}" />
                                            <DataGridTextColumn Width="100"
                                                                IsReadOnly="True"
                                                                Header="Coefficient"
                                                                Binding="{Binding Coefficient, StringFormat='0.###'}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <ToggleButton x:Name="ToggleButtonBestItemAODWaveformProfiles"
                                                  Content="Profiles"
                                                  Margin="0,2"
                                                  HorizontalAlignment="Left"
                                                  hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                    <Popup Width="800"
                                           Height="800"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=ToggleButtonBestItemAODWaveformProfiles}"
                                           Placement="Right"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide"
                                           IsOpen="{Binding IsChecked, ElementName=ToggleButtonBestItemAODWaveformProfiles, Mode=TwoWay}">
                                        <TabControl>
                                            <TabItem Header="Chirp AOD Waveform">
                                                <profileUI:ChirpAODWaveformProfilesUserControl Margin="5" DataContext="{Binding Cache.Item.ChirpAODWaveformProfiles}" />
                                            </TabItem>
                                            <TabItem Header="Prescan AOD Waveform">
                                                <profileUI:PrescanAODWaveformProfilesUserControl Margin="5" DataContext="{Binding Cache.Item.PrescanAODWaveformProfiles}" />
                                            </TabItem>
                                        </TabControl>
                                    </Popup>
                                </hc:UniformSpacingPanel>
                            </Border>
                            <GridSplitter Grid.Row="1" Height="5" />
                            <darkField:BestFocusUserControl Grid.Row="2" DataContext="{Binding Cache.SelectedItem.BestFocus}" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>
    </Grid>
</hc:Window>