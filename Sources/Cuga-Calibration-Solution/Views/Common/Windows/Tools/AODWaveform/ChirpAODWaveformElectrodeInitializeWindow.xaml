<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.AODWaveform.ChirpAODWaveformElectrodeInitializeWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:paramUI="clr-namespace:Core.Models.Models.Common.AODWaveform.UI.Generates;assembly=Core.Models"
           xmlns:profileUI="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools.AODWaveform"
           xmlns:system="clr-namespace:System;assembly=mscorlib"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:aodWaveform="clr-namespace:CugaCalibration.Views.Common.Windows.Tools.AODWaveform"
           xmlns:controls="clr-namespace:Net.Utilities.ScottPlot.WPF.WPF.Controls;assembly=Net.Utilities.ScottPlot.WPF"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:ChirpAODWaveformElectrodeInitializeWindowViewModel}"
           attachedHelper:LoadingHelper.IsShow="{Binding LoadedCommand.IsRunning}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <hc:Window.Resources>
        <ResourceDictionary>
            <paramUI:GenerateAODWaveformUniformityConfigurationsToPointsConvert x:Key="GenerateAODWaveformUniformityConfigurationsToPointsConvert" />
            <system:String x:Key="PrimaryParamTitleString">Flatness Changed Chirp AOD Waveform</system:String>
            <system:String x:Key="SecondaryParamTitleString">Flatness Fixed Prescan AOD Waveform</system:String>
            <system:String x:Key="ResultParamTitleString">Flatness Result Chirp AOD Waveform</system:String>
            <Style x:Key="FrequencyItemsListViewStyle"
                   x:Shared="False"
                   TargetType="ListView"
                   BasedOn="{StaticResource ListView.Small}">
                <Setter Property="Margin" Value="5" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ListViewItemBaseStyle.Small}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="View">
                    <Setter.Value>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Frequency(MHz)">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:ChirpAODWaveformElectrodeInitializeItem}">
                                        <TextBlock Text="{Binding Frequency, StringFormat={}{0:0.###}}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Period(2pi)">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:ChirpAODWaveformElectrodeInitializeItem}">
                                        <TextBlock Text="{Binding OffsetFrequencyPeriodCoefficient, StringFormat={}{0:0.###}}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Measure Power(mW)">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:ChirpAODWaveformElectrodeInitializeItem}">
                                        <TextBlock Text="{Binding MeasurePower, StringFormat={}{0:0.###}}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{StaticResource PrimaryParamTitleString}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:ChirpAODWaveformElectrodeInitializeItem}">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButtonChirpAODWaveformProfiles"
                                                          Content="Profiles"
                                                          Margin="0,2"
                                                          HorizontalAlignment="Left"
                                                          hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                            <Popup Width="800"
                                                   Height="800"
                                                   StaysOpen="False"
                                                   PlacementTarget="{Binding ElementName=ToggleButtonChirpAODWaveformProfiles}"
                                                   Placement="Right"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Slide"
                                                   IsOpen="{Binding IsChecked, ElementName=ToggleButtonChirpAODWaveformProfiles, Mode=TwoWay}">
                                                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                                    <profileUI:ChirpAODWaveformProfilesUserControl DataContext="{Binding ChirpAODWaveformProfiles}" />
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </hc:Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:SimplePanel Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="500"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                 IsInertiaEnabled="True"
                                 VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <GroupBox Header="AOD Waveform Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:UniformSpacingPanel Margin="11,0"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <hc:ComboBox hc:TitleElement.Title="Optics Illumination Mode: "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="200"
                                                     SelectedItem="{Binding Cache.OpticsIlluminationModeEnum}"
                                                     Style="{StaticResource ComboBoxExtend}"
                                                     ItemsSource="{Binding ApplicationCookie.OpticsIlluminationModeEnums}" />
                                        <hc:ComboBox hc:TitleElement.Title="Productivity Information: "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="200"
                                                     IsEditable="True"
                                                     IsReadOnly="True"
                                                     SelectedItem="{Binding Cache.ProductivityInformation}"
                                                     Style="{StaticResource ComboBoxExtend}">
                                            <i:Interaction.Behaviors>
                                                <wpf:ComboBoxFallbackBehavior FallbackDisplayText="{Binding Source={x:Static pattern:ProductivityInformation.Default}}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                            </i:Interaction.Behaviors>
                                            <hc:ComboBox.ItemsSource>
                                                <MultiBinding Converter="{StaticResource MultiApplicationCookieToProductivityInformationsConvert}">
                                                    <Binding Path="ApplicationCookie" />
                                                    <Binding Path="Cache.OpticsIlluminationModeEnum" />
                                                </MultiBinding>
                                            </hc:ComboBox.ItemsSource>
                                        </hc:ComboBox>
                                        <hc:NumericUpDown hc:TitleElement.Title="Default Amplitude(AMP): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="200"
                                                          Maximum="1"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Minimum="0"
                                                          Value="{Binding Cache.DefaultAmplitude}" />
                                    </hc:UniformSpacingPanel>
                                    <Expander IsExpanded="False" ExpandDirection="Down">
                                        <Expander.Header>
                                            <TextBlock Text="{StaticResource PrimaryParamTitleString}" Style="{StaticResource TextBlockDefaultInfo}" />
                                        </Expander.Header>
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <paramUI:GenerateChirpAODWaveformParamUserControl IsVisibleOpticsIlluminationModeEnum="False"
                                                                                                  IsVisibleProductivityInformation="False"
                                                                                                  IsVisibleFrequency="False"
                                                                                                  IsVisibleAmplitude="False"
                                                                                                  IsVisibleDirectoryPath="False"
                                                                                                  IsVisibleElectrodeConfiguration="False"
                                                                                                  IsVisibleUniformityConfiguration="False"
                                                                                                  IsVisibleSlopeDeltaKConfiguration="False"
                                                                                                  IsVisibleCompensation="False"
                                                                                                  DataContext="{Binding Cache.FlatnessGenerateChirpAODWaveformParam}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <Expander IsExpanded="False" ExpandDirection="Down">
                                        <Expander.Header>
                                            <TextBlock Text="{StaticResource SecondaryParamTitleString}" />
                                        </Expander.Header>
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <hc:UniformSpacingPanel Margin="11,0"
                                                                        Orientation="Vertical"
                                                                        Spacing="2">
                                                    <hc:NumericUpDown hc:TitleElement.Title="Prescan Frequency(MHz): "
                                                                      hc:TitleElement.TitlePlacement="Left"
                                                                      hc:TitleElement.TitleWidth="200"
                                                                      Minimum="0"
                                                                      Style="{StaticResource NumericUpDownExtend}"
                                                                      Value="{Binding Cache.PrescanFrequency}" />
                                                </hc:UniformSpacingPanel>
                                                <paramUI:GeneratePrescanAODWaveformParamUserControl IsVisibleOpticsIlluminationModeEnum="False"
                                                                                                    IsVisibleProductivityInformation="False"
                                                                                                    IsVisibleFrequency="False"
                                                                                                    IsVisibleAmplitude="False"
                                                                                                    IsVisibleDirectoryPath="False"
                                                                                                    IsVisibleUniformityConfiguration="False"
                                                                                                    IsVisibleSlopeDeltaKConfiguration="False"
                                                                                                    IsVisibleCompensation="False"
                                                                                                    DataContext="{Binding Cache.FlatnessGeneratePrescanAODWaveformParam}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <Expander Header="Prescan AOD Waveform"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <paramUI:GeneratePrescanAODWaveformParamUserControl IsVisibleOpticsIlluminationModeEnum="False"
                                                                                                    IsVisibleProductivityInformation="False"
                                                                                                    IsVisibleAmplitude="False"
                                                                                                    IsVisibleDirectoryPath="False"
                                                                                                    IsVisibleUniformityConfiguration="False"
                                                                                                    DataContext="{Binding Cache.GeneratePrescanAODWaveformParam}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <Expander Header="Chirp AOD Waveform"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <paramUI:GenerateChirpAODWaveformParamUserControl IsVisibleOpticsIlluminationModeEnum="False"
                                                                                                  IsVisibleProductivityInformation="False"
                                                                                                  IsVisibleAmplitude="False"
                                                                                                  IsVisibleDirectoryPath="False"
                                                                                                  IsVisibleElectrodeConfiguration="False"
                                                                                                  IsVisibleUniformityConfiguration="False"
                                                                                                  DataContext="{Binding Cache.GenerateChirpAODWaveformParam}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Params">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <TextBox Text="{Binding Cache.MeasureMaxPowerMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                             hc:TitleElement.Title="Measure Machine Position(um):"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="200"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <Button Content="Refresh Measure Machine Position"
                                            Command="{Binding RefreshMeasureMachinePositionCommand}"
                                            Style="{StaticResource ButtonDefault}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Wait Time(s): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.WaitTime}" />
                                    <StackPanel>
                                        <TextBlock Text="{StaticResource PrimaryParamTitleString}"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <Separator />
                                    <StackPanel>
                                        <TextBlock Text="Step1 Params"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <Expander Header="Electrode2 Electrode4 Offset Params"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                                <TextBox Text="{Binding Cache.Electrode2OffsetFrequencyPeriodCoefficients, Converter={StaticResource DoublesToStringConverter}}"
                                                         Height="50"
                                                         TextWrapping="Wrap"
                                                         hc:TitleElement.Title="Electrode 2 Offset(2pi): "
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         hc:TitleElement.TitleWidth="200"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         Style="{StaticResource TextBoxExtend}" />
                                                <TextBox Text="{Binding Cache.Electrode4OffsetFrequencyPeriodCoefficients, Converter={StaticResource DoublesToStringConverter}}"
                                                         Height="50"
                                                         TextWrapping="Wrap"
                                                         hc:TitleElement.Title="Electrode 4 Offset(2pi): "
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         hc:TitleElement.TitleWidth="200"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         Style="{StaticResource TextBoxExtend}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <StackPanel>
                                        <TextBlock Text="Step2 Params"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <Expander Header="Electrode3 Offset Params"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                                <hc:NumericUpDown hc:TitleElement.Title="Interpolation Count: "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="200"
                                                                  Minimum="1"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.InterpolationCount}" />
                                                <StackPanel>
                                                    <TextBlock Text="Electrode3"
                                                               HorizontalAlignment="Center"
                                                               Style="{StaticResource TextBlockDefaultInfo}" />
                                                </StackPanel>
                                                <hc:NumericUpDown hc:TitleElement.Title="Start Offset Period(2pi): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="200"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.StartElectrode3OffsetFrequencyPeriodCoefficient}" />
                                                <hc:NumericUpDown hc:TitleElement.Title="Step Offset Period(2pi): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="200"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.StepElectrode3OffsetFrequencyPeriodCoefficient}" />
                                                <hc:NumericUpDown hc:TitleElement.Title="Stop Offset Period(2pi): "
                                                                  hc:TitleElement.TitlePlacement="Left"
                                                                  hc:TitleElement.TitleWidth="200"
                                                                  Style="{StaticResource NumericUpDownExtend}"
                                                                  Value="{Binding Cache.StopElectrode3OffsetFrequencyPeriodCoefficient}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <Expander Header="Electrode3 Offset Frequency Weight Params"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                                <TextBox Text="{Binding Cache.Frequencies, Converter={StaticResource DoublesToStringConverter}}"
                                                         Height="50"
                                                         TextWrapping="Wrap"
                                                         hc:TitleElement.Title="Frequencies(MHz): "
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         hc:TitleElement.TitleWidth="200"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         Style="{StaticResource TextBoxExtend}" />
                                                <TextBox Text="{Binding Cache.Weights, Converter={StaticResource DoublesToStringConverter}}"
                                                         Height="50"
                                                         TextWrapping="Wrap"
                                                         hc:TitleElement.Title="Weights: "
                                                         hc:TitleElement.TitlePlacement="Left"
                                                         hc:TitleElement.TitleWidth="200"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         Style="{StaticResource TextBoxExtend}" />
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <StackPanel>
                                        <TextBlock Text="Step3 Params"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TextBlockDefaultInfo}" />
                                    </StackPanel>
                                    <Expander Header="{StaticResource ResultParamTitleString}"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                                    <Button Content="Add"
                                                            Command="{Binding AddResultCommand}"
                                                            hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                                            Style="{StaticResource ButtonInfo}" />
                                                    <Button Content="Delete"
                                                            Command="{Binding RemoveResultCommand}"
                                                            CommandParameter="{Binding SelectedItems, ElementName=ResultTabControl}"
                                                            hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                                                            Style="{StaticResource ButtonDanger}" />
                                                </hc:UniformSpacingPanel>
                                                <ListBox x:Name="ResultTabControl"
                                                         SelectionMode="Extended"
                                                         ItemsSource="{Binding Cache.Results}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type viewModels:ChirpAODWaveformElectrodeInitializeResult}">
                                                            <Border Height="360"
                                                                    Margin="0,2"
                                                                    Style="{StaticResource BorderRegion}">
                                                                <hc:ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                                                 IsInertiaEnabled="True"
                                                                                 VerticalScrollBarVisibility="Auto">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="5" />
                                                                            <RowDefinition Height="*" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock HorizontalAlignment="Center"
                                                                                   Style="{StaticResource TextBlockSubTitleBold}"
                                                                                   Foreground="{StaticResource InfoBrush}">
                                                                            <TextBlock.Text>
                                                                                <MultiBinding StringFormat="{}{0}-{1}">
                                                                                    <Binding Path="GenerateChirpAODWaveformParam.OpticsIlluminationModeEnum" />
                                                                                    <Binding Path="GenerateChirpAODWaveformParam.ProductivityInformation" />
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                        <paramUI:GenerateChirpAODWaveformParamUserControl Grid.Row="2"
                                                                                                                          IsVisibleDirectoryPath="False"
                                                                                                                          IsVisibleElectrodeConfiguration="False"
                                                                                                                          IsVisibleUniformityConfiguration="False"
                                                                                                                          DataContext="{Binding GenerateChirpAODWaveformParam}" />
                                                                    </Grid>
                                                                </hc:ScrollViewer>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                        <GroupBox Header="Actions">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <Expander IsExpanded="False" ExpandDirection="Down">
                                        <Expander.Header>
                                            <TextBlock Text="Electrode Offset Results" Style="{StaticResource TextBlockDefaultSuccess}" />
                                        </Expander.Header>
                                        <Border Style="{StaticResource BorderRegion}">
                                            <DataGrid MaxHeight="500"
                                                      hc:DataGridAttach.ShowRowNumber="False"
                                                      Style="{StaticResource DataGrid.Small}"
                                                      HeadersVisibility="Column"
                                                      RowHeaderWidth="60"
                                                      AutoGenerateColumns="False"
                                                      ItemsSource="{Binding Cache.ElectrodeConfigurationResults}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn IsReadOnly="True"
                                                                        Header="AOD Electrode"
                                                                        Binding="{Binding OpticsAODElectrodeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                                    <DataGridTextColumn Header="Frequency(MHz)" Binding="{Binding OffsetFrequency, StringFormat='0.###'}" />
                                                    <DataGridTextColumn Header="Period(2pi)" Binding="{Binding OffsetFrequencyPeriodCoefficient, StringFormat='0.###'}" />
                                                    <DataGridTextColumn Header="Amplitude" Binding="{Binding Amplitude, StringFormat='0.###'}" />
                                                    <DataGridTemplateColumn Header="Uniformity">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <ToggleButton x:Name="ToggleButtonUniformityConfigurations"
                                                                                  Content="Profiles"
                                                                                  Margin="0,2"
                                                                                  HorizontalAlignment="Left"
                                                                                  hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                                                    <Popup Width="800"
                                                                           Height="800"
                                                                           StaysOpen="False"
                                                                           PlacementTarget="{Binding ElementName=ToggleButtonUniformityConfigurations}"
                                                                           Placement="Right"
                                                                           AllowsTransparency="True"
                                                                           PopupAnimation="Slide"
                                                                           IsOpen="{Binding IsChecked, ElementName=ToggleButtonUniformityConfigurations, Mode=TwoWay}">
                                                                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                                                            <controls:ScatterMultiPlotControl Title="Uniformity Configurations(Y: Coefficient - X: MHz)" ScatterLine0Points="{Binding UniformityConfigurations, Converter={StaticResource GenerateAODWaveformUniformityConfigurationsToPointsConvert}}" />
                                                                        </Border>
                                                                    </Popup>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Expander>
                                    <hc:Divider Content="Step 1 Electrode2 Electrode4" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step0Command}"
                                                CommandParameter="{x:Static models:Constants.True}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                    <Binding Path="Step3Command.IsRunning" />
                                                    <Binding Path="AllCommand.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="Cancel"
                                                Command="{Binding Step0CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="Step 2 Electrode3" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step1Command}"
                                                CommandParameter="{x:Static models:Constants.True}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                    <Binding Path="Step3Command.IsRunning" />
                                                    <Binding Path="AllCommand.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="Cancel"
                                                Command="{Binding Step1CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="Step 3 Generate AOD Waveform" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step2Command}"
                                                CommandParameter="{x:Static models:Constants.True}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                    <Binding Path="Step3Command.IsRunning" />
                                                    <Binding Path="AllCommand.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="Cancel"
                                                Command="{Binding Step2CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="Step 4 Set AOD Waveform Config" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step3Command}"
                                                CommandParameter="{x:Static models:Constants.True}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                    <Binding Path="Step3Command.IsRunning" />
                                                    <Binding Path="AllCommand.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="Cancel"
                                                Command="{Binding Step3CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:Divider Content="One-click start" Margin="0" />
                                    <hc:UniformSpacingPanel Spacing="10">
                                        <Button Content="All Action"
                                                Command="{Binding AllCommand}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                                    <Binding Path="Step0Command.IsRunning" />
                                                    <Binding Path="Step1Command.IsRunning" />
                                                    <Binding Path="Step2Command.IsRunning" />
                                                    <Binding Path="Step3Command.IsRunning" />
                                                    <Binding Path="AllCommand.IsRunning" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <Button Content="All Cancel"
                                                Command="{Binding AllCancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                    <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                                  Content="{StaticResource SecondaryParamTitleString}"
                                                  Margin="0,5"
                                                  HorizontalAlignment="Left"
                                                  hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                    <Popup Width="800"
                                           Height="800"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                                           Placement="Right"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide"
                                           IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}">
                                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                            <profileUI:PrescanAODWaveformProfilesUserControl DataContext="{Binding Cache.PrescanAODWaveformProfiles}" />
                                        </Border>
                                    </Popup>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </GroupBox>
                    </hc:UniformSpacingPanel>
                </hc:ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" />
            <GroupBox Grid.Column="2"
                      Padding="5"
                      Header="History">
                <TabControl>
                    <TabItem Header="Step1 Offset">
                        <Border Style="{StaticResource BorderRegion}">
                            <ContentControl Grid.Row="1" Content="{Binding Cache.Step0.ScatterPlotControl, Mode=OneWay}" />
                        </Border>
                    </TabItem>
                    <TabItem Header="Step1 Offset Details">
                        <Border Style="{StaticResource BorderRegion}">
                            <TabControl Grid.Row="1" ItemsSource="{Binding Cache.Step0.Items}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <ListView ItemsSource="{Binding Items}" Style="{StaticResource FrequencyItemsListViewStyle}" />
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </Border>
                    </TabItem>
                    <TabItem Header="Step2 Offset">
                        <hc:ScrollViewer>
                            <ItemsControl Padding="10,5" ItemsSource="{Binding Cache.Step1Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <hc:UniformSpacingPanel Spacing="10" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="400" Style="{StaticResource BorderRegion}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Title}"
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource TextBlockSubTitleBold}"
                                                           Foreground="{StaticResource SuccessBrush}" />
                                                <ContentControl Grid.Row="1" Content="{Binding ScatterPlotControl, Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </hc:ScrollViewer>
                    </TabItem>
                    <TabItem Header="Step2 Offset Details">
                        <hc:ScrollViewer>
                            <ItemsControl Padding="10,5" ItemsSource="{Binding Cache.Step1Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <hc:UniformSpacingPanel Spacing="10" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="400" Style="{StaticResource BorderRegion}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Title}"
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource TextBlockSubTitleBold}"
                                                           Foreground="{StaticResource SuccessBrush}" />
                                                <TabControl Grid.Row="1" ItemsSource="{Binding Items}">
                                                    <TabControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding FrequencyItems, Converter={aodWaveform:ChirpAODWaveformElectrodeInitializeConvert}}" />
                                                        </DataTemplate>
                                                    </TabControl.ItemTemplate>
                                                    <TabControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <ListView ItemsSource="{Binding FrequencyItems}" Style="{StaticResource FrequencyItemsListViewStyle}" />
                                                        </DataTemplate>
                                                    </TabControl.ContentTemplate>
                                                </TabControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </hc:ScrollViewer>
                    </TabItem>
                    <TabItem Header="Step 3 Result">
                        <hc:ScrollViewer>
                            <ItemsControl Padding="10,5" ItemsSource="{Binding Cache.Results}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <hc:UniformSpacingPanel Spacing="10" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="800" Style="{StaticResource BorderRegion}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock HorizontalAlignment="Center"
                                                           Style="{StaticResource TextBlockSubTitleBold}"
                                                           Foreground="{StaticResource SuccessBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}-{1}">
                                                            <Binding Path="GenerateChirpAODWaveformParam.OpticsIlluminationModeEnum" />
                                                            <Binding Path="GenerateChirpAODWaveformParam.ProductivityInformation" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <UniformGrid Grid.Row="1"
                                                             Margin="2"
                                                             HorizontalAlignment="Center"
                                                             Rows="1"
                                                             Columns="2">
                                                    <Button Content="Set Profiles"
                                                            Command="{Binding DataContext.SetResultAODWaveformProfilesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="2"
                                                            Style="{StaticResource ButtonInfo.Loading}" />
                                                    <Button Content="Cancel"
                                                            Command="{Binding DataContext.SetResultAODWaveformProfilesCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Margin="2"
                                                            Style="{StaticResource ButtonWarning}" />
                                                </UniformGrid>
                                                <UniformGrid Grid.Row="2"
                                                             Margin="0,0,0,2"
                                                             HorizontalAlignment="Center"
                                                             Rows="1"
                                                             Columns="2">
                                                    <Button Content="Set Config"
                                                            Command="{Binding DataContext.SetResultAODWaveformConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="2"
                                                            Style="{StaticResource ButtonInfo.Loading}" />
                                                    <Button Content="Cancel"
                                                            Command="{Binding DataContext.SetResultAODWaveformConfigCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Margin="2"
                                                            Style="{StaticResource ButtonWarning}" />
                                                </UniformGrid>
                                                <Border Grid.Row="3"
                                                        Style="{StaticResource BorderRegion}"
                                                        Effect="{StaticResource EffectShadow1}">
                                                    <profileUI:ChirpAODWaveformProfilesUserControl DataContext="{Binding ChirpAODWaveformProfiles}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </hc:ScrollViewer>
                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>
    </Grid>
</hc:Window>