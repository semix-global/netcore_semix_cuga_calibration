<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.GrabbingDarkImageWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:behaviors="clr-namespace:Core.Models.Models.Common.Status.Behaviors;assembly=Core.Models"
           xmlns:cibMode="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:darkField="clr-namespace:Core.Models.Models.Common.DarkField;assembly=Core.Models"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
           xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
           xmlns:ui="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           xmlns:wpfImageViewer="clr-namespace:Net.Utilities.ImageViewer.WPF;assembly=Net.Utilities.ImageViewer.WPF"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:GrabbingDarkImageWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Grabbing Dark Image"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Padding="2"
                Effect="{StaticResource EffectShadow1}"
                Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="GrabbingDarkImage">
                    <Border Padding="5" Style="{StaticResource BorderRegion}">
                        <ListBox Margin="5" ItemsSource="{Binding Results}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BorderRegion}">
                                        <ListBox ItemsSource="{Binding .}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type darkField:DarkFieldRawScanImageDTO}">
                                                    <Border Width="300"
                                                            Height="300"
                                                            Style="{StaticResource BorderRegion}">
                                                        <hc:SimplePanel>
                                                            <wpfImageViewer:ImageViewerCanvas BitmapImageDrawable="{Binding RawImageFilePath, Converter={StaticResource StringToBitmapImageDrawableConverter}}"
                                                                                              IsShowCrossLine="True"
                                                                                              IsToggleAddOrModifyRectROIDrawable="False" />
                                                            <TextBlock TextWrapping="Wrap"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Top"
                                                                       Foreground="Yellow">
                                                                <Hyperlink Command="{x:Static wpf:Commands.OpenFilePathCommand}" CommandParameter="{Binding RawImageFilePath}">
                                                                    <Run Text="{Binding RawImageFilePath}" />
                                                                </Hyperlink>
                                                            </TextBlock>
                                                        </hc:SimplePanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </GroupBox>
                <GridSplitter Grid.Column="1" Width="5" />
                <Border Grid.Column="2" Style="{StaticResource BorderRegion}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <ComboBox hc:TitleElement.Title="Productivity Information: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      ItemsSource="{Binding ApplicationCookie.ProductivityInformations}"
                                      Style="{StaticResource ComboBoxExtend}">
                                <i:Interaction.Behaviors>
                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                </i:Interaction.Behaviors>
                            </ComboBox>
                            <ComboBox hc:TitleElement.Title="Stage Coordinate System: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:StageCoordinateSystemEnum}}}"
                                      SelectedItem="{Binding StageCoordinateSystemEnum}"
                                      Style="{StaticResource ComboBoxExtend}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <hc:NumericUpDown hc:TitleElement.Title="Width(px): "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="160"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding ImageWidth}" />
                            <hc:NumericUpDown hc:TitleElement.Title="PTP Length(um): "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="160"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding ScanLength}" />
                            <hc:NumericUpDown hc:TitleElement.Title="PEG Column Count: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="160"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding ColumnCount}" />
                            <hc:NumericUpDown hc:TitleElement.Title="PEG Column Width(um): "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="160"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding ColumnWidth}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CIB Informations: "
                                           Width="160"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <ListBox Grid.Column="1"
                                         Height="200"
                                         ItemContainerStyle="{StaticResource ListBoxItemStyle.Center}"
                                         ItemsSource="{Binding ApplicationCookie.CIBInformations}"
                                         SelectionMode="Extended">
                                    <i:Interaction.Behaviors>
                                        <behaviors:ListBoxSelectedItemsCIBInformationStatusBehavior BindableSelectedItems="{Binding CIBInformations}" />
                                    </i:Interaction.Behaviors>
                                </ListBox>
                            </Grid>
                            <ComboBox hc:TitleElement.Title="Cal Chip: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:CalChipSiteModelEnum}}}"
                                      SelectedItem="{Binding CalChipSiteModelEnum}"
                                      Style="{StaticResource ComboBoxExtend}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <cibMode:CibGrabModeTypeUserControl DataContext="{Binding CIBConfiguration}" />
                            <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      ItemsSource="{Binding ApplicationCookie.LaserLightInformations}"
                                      Style="{StaticResource ComboBoxExtend}">
                                <i:Interaction.Behaviors>
                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                </i:Interaction.Behaviors>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Forward: "
                                           Width="160"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <ToggleButton IsChecked="{Binding IsForward}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Background="{StaticResource DangerBrush}"
                                              Style="{StaticResource ToggleButtonSwitch}" />
                            </StackPanel>
                            <hc:NumericUpDown hc:TitleElement.Title="ECS: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="160"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding ECS}" />
                            <Separator />
                            <TextBox Text="{Binding PrescanAODWaveformResultFilePath}"
                                     Height="50"
                                     TextWrapping="Wrap"
                                     hc:TitleElement.Title="Prescan File Path: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     Background="LightGray"
                                     IsReadOnly="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:UniformSpacingPanel Spacing="10">
                                <Button Content="Prescan"
                                        Command="{Binding ChangedPrescanAODWaveformProfilesCommand}"
                                        hc:IconElement.Geometry="{StaticResource RotateRightGeometry}" />
                                <Button Content="Clear"
                                        Command="{Binding ClearPrescanAODWaveformProfilesCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}" />
                                <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                              Content="Profiles"
                                              Margin="0,5"
                                              HorizontalAlignment="Left"
                                              hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                <Popup Width="800"
                                       Height="800"
                                       AllowsTransparency="True"
                                       IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}"
                                       Placement="Right"
                                       PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                                       PopupAnimation="Slide"
                                       StaysOpen="False">
                                    <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                                        <ui:PrescanAODWaveformProfilesUserControl DataContext="{Binding PrescanAODWaveformProfiles}" />
                                    </Border>
                                </Popup>
                            </hc:UniformSpacingPanel>
                            <TextBox Text="{Binding ChirpAODWaveformResultFilePath}"
                                     Height="50"
                                     TextWrapping="Wrap"
                                     hc:TitleElement.Title="Chirp File Path: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     Background="LightGray"
                                     IsReadOnly="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:UniformSpacingPanel Spacing="10">
                                <Button Content="Chirp"
                                        Command="{Binding ChangedChirpAODWaveformProfilesCommand}"
                                        hc:IconElement.Geometry="{StaticResource RotateRightGeometry}" />
                                <Button Content="Clear"
                                        Command="{Binding ClearChirpAODWaveformProfilesCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}" />
                                <ToggleButton x:Name="ToggleButtonChirpAODWaveformProfiles"
                                              Content="Profiles"
                                              Margin="0,5"
                                              HorizontalAlignment="Left"
                                              hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                <Popup Width="800"
                                       Height="800"
                                       AllowsTransparency="True"
                                       IsOpen="{Binding IsChecked, ElementName=ToggleButtonChirpAODWaveformProfiles, Mode=TwoWay}"
                                       Placement="Right"
                                       PlacementTarget="{Binding ElementName=ToggleButtonChirpAODWaveformProfiles}"
                                       PopupAnimation="Slide"
                                       StaysOpen="False">
                                    <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                                        <ui:ChirpAODWaveformProfilesUserControl DataContext="{Binding ChirpAODWaveformProfiles}" />
                                    </Border>
                                </Popup>
                            </hc:UniformSpacingPanel>
                            <Separator />
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button Content="Action"
                                        Command="{Binding GetPMTImagesCommand}"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button Content="Cancel"
                                        Command="{Binding GetPMTImagesCancelCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>