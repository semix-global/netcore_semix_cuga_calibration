<hc:Window x:Class="CugaCalibration.Views.Common.Windows.Tools.GrabbingDarkImageWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:optics="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
           xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
           xmlns:helper="clr-namespace:Core.Models.Helper;assembly=Core.Models"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.Tools"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
           xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
           xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:cibMode="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
           xmlns:profileUI="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
           Width="1500"
           Height="1000"
           d:DataContext="{d:DesignInstance Type=viewModels:GrabbingDarkImageWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Grabbing Dark Image"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Padding="2"
                Effect="{StaticResource EffectShadow1}"
                Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="500" />
                    </Grid.RowDefinitions>
                    <GroupBox Header="GrabbingDarkImage">
                        <Border Padding="5" Style="{StaticResource BorderRegion}">
                            <ListView d:SelectedIndex="0"
                                      ItemsSource="{Binding GrabbingDarkImageList}"
                                      Style="{StaticResource ListView.Small}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      SelectedItem="{Binding SelectGrabbingDarkImageDto}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ListBoxScrollToCurrentBehavior />
                                </i:Interaction.Behaviors>
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridView.ColumnHeaderContainerStyle>
                                            <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </Style>
                                        </GridView.ColumnHeaderContainerStyle>
                                        <GridViewColumn Width="100"
                                                        Header="PmtId"
                                                        DisplayMemberBinding="{Binding PmtId}" />
                                        <GridViewColumn Width="100"
                                                        Header="Coefficient"
                                                        DisplayMemberBinding="{Binding Coefficient}" />
                                        <GridViewColumn Width="100"
                                                        Header="GainVoltage"
                                                        DisplayMemberBinding="{Binding CIBConfiguration.Gain}" />
                                        <GridViewColumn Width="100"
                                                        Header="Optics Mag"
                                                        DisplayMemberBinding="{Binding OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                        <GridViewColumn Width="100"
                                                        Header="Speed"
                                                        DisplayMemberBinding="{Binding StageSpeedEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                        <GridViewColumn Width="100"
                                                        Header="Cal Chip"
                                                        DisplayMemberBinding="{Binding CalChipSiteModelEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                        <GridViewColumn Width="100"
                                                        Header="Coordinate System"
                                                        DisplayMemberBinding="{Binding StageCoordinateSystemEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                        <GridViewColumn Width="100"
                                                        Header="LOK"
                                                        DisplayMemberBinding="{Binding CIBConfiguration.IsL0K}" />
                                        <GridViewColumn Width="100"
                                                        Header="Auto Gain"
                                                        DisplayMemberBinding="{Binding CIBConfiguration.IsAutoGainControl}" />
                                        <GridViewColumn Width="100"
                                                        Header="Forward"
                                                        DisplayMemberBinding="{Binding IsForward}" />
                                        <GridViewColumn Width="200" Header="Action">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <hc:ButtonGroup>
                                                        <Button Content="Delete"
                                                                Command="{Binding Path=DataContext.DeleteImageCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ButtonSuccess}" />
                                                    </hc:ButtonGroup>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="150"
                                                        Header="Width"
                                                        DisplayMemberBinding="{Binding XWidth}" />
                                        <GridViewColumn Width="150"
                                                        Header="Start Position"
                                                        DisplayMemberBinding="{Binding StartPosition}" />
                                        <GridViewColumn Width="150"
                                                        Header="End Position"
                                                        DisplayMemberBinding="{Binding EndPosition}" />
                                        <GridViewColumn Width="300"
                                                        Header="Prescan File"
                                                        DisplayMemberBinding="{Binding PrescanFilePath}" />
                                        <GridViewColumn Width="300"
                                                        Header="Chirp File"
                                                        DisplayMemberBinding="{Binding ChirpFilePath}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </GroupBox>
                    <GridSplitter Grid.Row="1" Height="5" />
                    <TabControl x:Name="TabControl" Grid.Row="2"
                                TabStripPlacement="Bottom">
                        <TabItem Header="Image">
                            <GroupBox Header="Images">
                                <Border Padding="5" Style="{StaticResource BorderRegion}">
                                    <Border.Resources>
                                        <attachedHelper:BindingProxy x:Key="BindingProxy" Value="{Binding}" />
                                        <ContextMenu x:Key="ContextMenu" Placement="Left">
                                            <MenuItem Command="{Binding Path=Value.(viewModels:GrabbingDarkImageWindowViewModel.SavePictureCommand), Source={StaticResource BindingProxy}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.(ContextMenu.Tag), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                                      Header="Save" />
                                            <MenuItem Command="{Binding Path=Value.(viewModels:GrabbingDarkImageWindowViewModel.ShowPlotCommand), Source={StaticResource BindingProxy}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.(ContextMenu.Tag), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                                      Header="Show Plot" />
                                        </ContextMenu>
                                    </Border.Resources>
                                    <ItemsControl VerticalAlignment="Bottom" ItemsSource="{Binding SelectGrabbingDarkImageDto.DarkFieldImageList}">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Width" Value="300" />
                                                <Setter Property="Height" Value="400" />
                                                <Setter Property="Margin" Value="5" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <hc:WaterfallPanel hc:PanelElement.FluidMoveBehavior="{StaticResource BehaviorXY200}" Groups="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <view:CanvasView AxisColor="Red"
                                                                 BackgroundColor="#0A0A0A"
                                                                 BackgroundImage="{Binding FilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                 ContextMenu="{StaticResource ContextMenu}"
                                                                 Interactive="True"
                                                                 ShowAxes="True"
                                                                 ShowCursor="False"
                                                                 ShowGrid="False"
                                                                 Tag="{Binding .}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </GroupBox>
                        </TabItem>
                        <TabItem Header="Plot">
                            <wpf:WpfPlot>
                                <i:Interaction.Behaviors>
                                    <behaviors:WpfPlotListBehavior Title="Plot" PlotList="{Binding SelectGrabbingDarkImageDto.PlotList, Mode=OneWay}" />
                                </i:Interaction.Behaviors>
                            </wpf:WpfPlot>
                        </TabItem>
                    </TabControl>
                </Grid>
                <GridSplitter Grid.Column="1" Width="10" />
                <Border Grid.Column="2"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}">
                    <hc:ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                     IsInertiaEnabled="True"
                                     VerticalScrollBarVisibility="Auto">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <StackPanel>
                                <TextBlock Text="Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:InfoElement.TitleWidth="150"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Stage Coordinate: "
                                         SelectedItem="{Binding StageCoordinateSystemEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:StageCoordinateSystemEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <Border Margin="-5"
                                    Padding="5"
                                    Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Is PTP:  "
                                                   Width="150"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton IsChecked="{Binding IsPtp}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Background="{StaticResource InfoBrush}"
                                                      Style="{StaticResource ToggleButtonSwitch}" />
                                    </StackPanel>
                                    <hc:UniformSpacingPanel Orientation="Vertical"
                                                            Spacing="8"
                                                            Visibility="{Binding IsPtp, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBox Text="{Binding StartPosition, Converter={StaticResource PointToStringConverter}}"
                                                 hc:InfoElement.Title="Start Position(um): "
                                                 hc:InfoElement.TitleWidth="150"
                                                 hc:InfoElement.TitlePlacement="Left"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding EndPosition, Converter={StaticResource PointToStringConverter}}"
                                                 hc:InfoElement.Title="End Position(um): "
                                                 hc:InfoElement.TitleWidth="150"
                                                 hc:InfoElement.TitlePlacement="Left"
                                                 Style="{StaticResource TextBoxExtend}" />
                                    </hc:UniformSpacingPanel>
                                    <hc:UniformSpacingPanel Orientation="Vertical"
                                                            Spacing="8"
                                                            Visibility="{Binding IsPtp, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                                        <hc:NumericUpDown hc:InfoElement.ShowClearButton="True"
                                                          hc:InfoElement.Title="Width(px): "
                                                          hc:InfoElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="150"
                                                          Minimum="10"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding XWidth}" />
                                    </hc:UniformSpacingPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Forward: "
                                                   Width="150"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton IsChecked="{Binding IsForward}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Background="{StaticResource DangerBrush}"
                                                      Style="{StaticResource ToggleButtonSwitch}" />
                                    </StackPanel>
                                </hc:UniformSpacingPanel>
                            </Border>
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:InfoElement.TitleWidth="150"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="PMT ID: "
                                         SelectedItem="{Binding PmtId}"
                                         ItemsSource="{x:Static helper:CalibrationConstantsHelper.PmtIds}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:InfoElement.TitleWidth="150"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Coefficient: "
                                         SelectedItem="{Binding LaserLightInformation}"
                                         ItemsSource="{Binding LaserLightInformationList}" />
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:InfoElement.TitleWidth="150"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Optics Mag: "
                                         SelectedItem="{Binding OpticsMagTypeEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type optics:OpticsMagTypeEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:InfoElement.TitleWidth="150"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Speed: "
                                         SelectedItem="{Binding StageSpeedEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:StageSpeedEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:InfoElement.TitleWidth="150"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Cal Chip: "
                                         SelectedItem="{Binding CalChipSiteModelEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:CalChipSiteModelEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                            <Separator />
                            <TextBox Text="{Binding PrescanAODWaveformResultFilePath}"
                                     Height="50"
                                     TextWrapping="Wrap"
                                     hc:InfoElement.Title="Prescan File Path: "
                                     hc:TitleElement.TitleWidth="150"
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:UniformSpacingPanel Spacing="10">
                                <Button Content="Prescan"
                                        Command="{Binding ChangedPrescanAODWaveformProfilesCommand}"
                                        hc:IconElement.Geometry="{StaticResource RotateRightGeometry}" />
                                <Button Content="Clear"
                                        Command="{Binding ClearPrescanAODWaveformProfilesCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}" />
                                <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                              Content="Profiles"
                                              Margin="0,5"
                                              HorizontalAlignment="Left"
                                              hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                <Popup Width="800"
                                       Height="800"
                                       StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                                       Placement="Right"
                                       AllowsTransparency="True"
                                       PopupAnimation="Slide"
                                       IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}">
                                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                        <profileUI:PrescanAODWaveformProfilesUserControl DataContext="{Binding PrescanAODWaveformProfiles}" />
                                    </Border>
                                </Popup>
                            </hc:UniformSpacingPanel>
                            <TextBox Text="{Binding ChirpAODWaveformResultFilePath}"
                                     Height="50"
                                     TextWrapping="Wrap"
                                     hc:InfoElement.Title="Chirp File Path: "
                                     hc:TitleElement.TitleWidth="150"
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:UniformSpacingPanel Spacing="10">
                                <Button Content="Chirp"
                                        Command="{Binding ChangedChirpAODWaveformProfilesCommand}"
                                        hc:IconElement.Geometry="{StaticResource RotateRightGeometry}" />
                                <Button Content="Clear"
                                        Command="{Binding ClearChirpAODWaveformProfilesCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}" />
                                <ToggleButton x:Name="ToggleButtonChirpAODWaveformProfiles"
                                              Content="Profiles"
                                              Margin="0,5"
                                              HorizontalAlignment="Left"
                                              hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                <Popup Width="800"
                                       Height="800"
                                       StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=ToggleButtonChirpAODWaveformProfiles}"
                                       Placement="Right"
                                       AllowsTransparency="True"
                                       PopupAnimation="Slide"
                                       IsOpen="{Binding IsChecked, ElementName=ToggleButtonChirpAODWaveformProfiles, Mode=TwoWay}">
                                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                        <profileUI:ChirpAODWaveformProfilesUserControl DataContext="{Binding ChirpAODWaveformProfiles}" />
                                    </Border>
                                </Popup>
                            </hc:UniformSpacingPanel>
                            <Separator />
                            <cibMode:CibGrabModeTypeUserControl HorizontalAlignment="Left"
                                                                hc:InfoElement.TitleWidth="150"
                                                                hc:InfoElement.TitlePlacement="Left"
                                                                hc:InfoElement.Title="Cib Grab Mode: "
                                                                DataContext="{Binding CIBConfiguration}" />
                            <hc:SimplePanel>
                                <Button Content="Grabbing"
                                        Command="{Binding GrabbingImageCommand}"
                                        Width="100"
                                        Height="30"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                            </hc:SimplePanel>
                        </hc:UniformSpacingPanel>
                    </hc:ScrollViewer>
                </Border>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>