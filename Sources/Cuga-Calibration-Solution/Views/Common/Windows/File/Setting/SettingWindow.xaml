<hc:Window x:Class="CugaCalibration.Views.Common.Windows.File.Setting.SettingWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:children="clr-namespace:CugaCalibration.Views.Common.Windows.File.Setting.Children"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.File.Setting"
           Width="1500"
           Height="900"
           d:DataContext="{d:DesignInstance Type=viewModels:SettingWindowViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Setting"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Padding="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TabControl>
                    <TabItem Header="Common">
                        <children:SettingCommonUserControl DataContext="{Binding .}" />
                    </TabItem>
                    <TabItem Header="Template">
                        <children:SettingTemplateMatchUserControl DataContext="{Binding .}" />
                    </TabItem>
                    <TabItem Header="Configure Calibration Status">
                        <children:SettingCalibrateItemsStatusUserControl DataContext="{Binding SettingCalibrateItemsStatusViewModel}" />
                    </TabItem>
                    <TabItem Header="Required Calibrations">
                        <children:SettingRequiredCalibrationUserControl DataContext="{Binding SettingRequiredCalibrationViewModel}" />
                    </TabItem>
                </TabControl>
                <hc:SimplePanel Grid.Row="1" Margin="0,10">
                    <Button Content="Restore"
                            Command="{Binding RestoreCommand}"
                            HorizontalAlignment="Left" />

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            HorizontalAlignment="Right" />
                </hc:SimplePanel>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>