<hc:Window x:Class="CugaCalibration.Views.Common.Windows.File.Setting.Children.SelectDisableConfigWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.File.Setting.Children"
           Width="600"
           Height="400"
           d:DataContext="{d:DesignInstance Type=viewModels:SelectDisableConfigViewModel}"
           BorderBrush="{StaticResource PrimaryBrush}"
           BorderThickness="2"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <hc:SimplePanel Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Select Disable Configuration"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CancelCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>

        <!--  主体内容  -->
        <Grid Grid.Row="1" Margin="10">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DataGrid hc:DataGridAttach.ShowRowNumber="True"
                          ItemsSource="{Binding ConfigList}"
                          SelectedItem="{Binding SelectedConfig}"
                          Style="{StaticResource DataGrid.Small}"
                          HeadersVisibility="All"
                          RowHeaderWidth="60"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*"
                                            Header="Configuration Name"
                                            Binding="{Binding ConfigDescription}"
                                            FontSize="12">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="5" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!--  底部按钮  -->
        <hc:SimplePanel Grid.Row="2" Margin="10">
            <hc:UniformSpacingPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="10">
                <Button Content="Confirm"
                        Command="{Binding ConfirmCommand}"
                        Width="100"
                        Style="{StaticResource ButtonPrimary}" />
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="100"
                        Style="{StaticResource ButtonDefault}" />
            </hc:UniformSpacingPanel>
        </hc:SimplePanel>
    </Grid>
</hc:Window>