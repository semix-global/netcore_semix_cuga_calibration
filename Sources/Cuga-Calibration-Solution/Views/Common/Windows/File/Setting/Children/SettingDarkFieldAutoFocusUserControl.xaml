<UserControl x:Class="CugaCalibration.Views.Common.Windows.File.Setting.Children.SettingDarkFieldAutoFocusUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.File.Setting.Children"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingDarkFieldAutoFocusViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Border>
        <Grid>
            <Grid.Resources>
                <Style BasedOn="{StaticResource GroupBoxBaseStyle}" TargetType="GroupBox">
                    <Style.Setters>
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Padding" Value="10" />
                    </Style.Setters>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Enable Auto Focus">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:SimplePanel Height="30">
                        <TextBlock Text="Chuck:"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />
                        <ToggleButton IsChecked="{Binding SettingDarkFieldAutoFocusParam.IsEnableChuck}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource DangerBrush}"
                                      Style="{StaticResource ToggleButtonSwitch}" />
                        <Button Content="RTFC"
                                Command="{Binding ChuckAutoRtfcCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource ButtonDefault.Loading}" />
                    </hc:SimplePanel>
                    <hc:SimplePanel Height="30">
                        <TextBlock Text="Dsw:"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />
                        <ToggleButton IsChecked="{Binding SettingDarkFieldAutoFocusParam.IsEnableDsw}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource DangerBrush}"
                                      Style="{StaticResource ToggleButtonSwitch}" />
                    </hc:SimplePanel>
                    <hc:SimplePanel Height="30">
                        <TextBlock Text="Undefined:"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />
                        <ToggleButton IsChecked="{Binding SettingDarkFieldAutoFocusParam.IsEnableUndefined}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource DangerBrush}"
                                      Style="{StaticResource ToggleButtonSwitch}" />
                    </hc:SimplePanel>
                    <hc:SimplePanel Height="30">
                        <TextBlock Text="Haze:"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />
                        <ToggleButton IsChecked="{Binding SettingDarkFieldAutoFocusParam.IsEnableHaze}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource DangerBrush}"
                                      Style="{StaticResource ToggleButtonSwitch}" />
                    </hc:SimplePanel>
                    <hc:SimplePanel Height="30">
                        <TextBlock Text="ShinyWafer:"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />
                        <ToggleButton IsChecked="{Binding SettingDarkFieldAutoFocusParam.IsEnableShinyWafer}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource DangerBrush}"
                                      Style="{StaticResource ToggleButtonSwitch}" />
                    </hc:SimplePanel>
                </hc:UniformSpacingPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Ecs">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Chuck: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.ChuckEcsValue}" />
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Dsw: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.DswEcsValue}" />
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Undefined: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.UndefinedEcsValue}" />
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Haze: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.HazeEcsValue}" />
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Shiny Wafer: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.ShinyWaferEcsValue}" />
                </hc:UniformSpacingPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Motor">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Chuck: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.ChuckMotorValue}" />
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Dsw: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.DswMotorValue}" />
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Undefined: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.UndefinedMotorValue}" />
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Haze: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.HazeMotorValue}" />
                    <hc:NumericUpDown Height="30"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Shiny Wafer: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="150"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldAutoFocusParam.ShinyWaferMotorValue}" />
                </hc:UniformSpacingPanel>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>