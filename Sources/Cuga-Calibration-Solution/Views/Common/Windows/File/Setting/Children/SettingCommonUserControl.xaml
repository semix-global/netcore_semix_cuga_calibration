<UserControl x:Class="CugaCalibration.Views.Common.Windows.File.Setting.Children.SettingCommonUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enumsUtilities="clr-namespace:Net.Utilities.Models.Enums.Loggings;assembly=Net.Utilities.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.File.Setting"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingWindowViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Border>
        <UniformGrid Columns="2" Rows="2">
            <GroupBox Margin="5" Header="Min Log Level">
                <Border>
                    <ItemsControl HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumsUtilities:LogLevelEnum}}}">
                        <i:Interaction.Behaviors>
                            <behaviors:RadioButtonSelectedItemBehavior SelectedItem="{Binding CalibrationSetting.SettingCommonParam.MinLogLevelEnum, Mode=TwoWay}" />
                        </i:Interaction.Behaviors>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                                             HorizontalAlignment="Left"
                                             FontSize="15"
                                             GroupName="67fa1ece-8b12-4ec1-9443-078bb25af07b"
                                             Tag="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </GroupBox>
            <GroupBox Margin="5" Header="HardWare Param">
                <ScrollViewer>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <hc:ComboBox hc:TitleElement.Title="Low Microscope: "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="200"
                                         ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}">
                                <i:Interaction.Behaviors>
                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding CalibrationSetting.SettingCommonParam.LowMicroscopeLensInformation}" FallbackSelectItem="{x:Static pattern:MicroscopeLensInformation.Default}" />
                                </i:Interaction.Behaviors>
                            </hc:ComboBox>
                            <hc:ComboBox hc:TitleElement.Title="High Microscope: "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="200"
                                         ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}">
                                <i:Interaction.Behaviors>
                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding CalibrationSetting.SettingCommonParam.HighMicroscopeLensInformation}" FallbackSelectItem="{x:Static pattern:MicroscopeLensInformation.Default}" />
                                </i:Interaction.Behaviors>
                            </hc:ComboBox>
                            <hc:ComboBox hc:TitleElement.Title="Light Information: "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="200"
                                         ItemsSource="{Binding ApplicationCookie.LaserLightInformations}">
                                <i:Interaction.Behaviors>
                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding CalibrationSetting.SettingCommonParam.MainLaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                </i:Interaction.Behaviors>
                            </hc:ComboBox>
                            <hc:NumericUpDown hc:TitleElement.Title="PMT Interval(um): "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding CalibrationSetting.SettingCommonParam.PMTInterval}" />
                            <hc:ComboBox hc:TitleElement.Title="Main PMTId: "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="200"
                                         SelectedItem="{Binding CalibrationSetting.SettingCommonParam.MainPMTId}"
                                         ItemsSource="{Binding ApplicationCookie.CIBInformationPMTIds}" />
                            <hc:NumericUpDown hc:TitleElement.Title="Measure Power Min Value(mW): "
                                              hc:TitleElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="200"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding CalibrationSetting.SettingCommonParam.MeasurePowerMeasurementMinValue}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                </ScrollViewer>
            </GroupBox>
        </UniformGrid>
    </Border>
</UserControl>