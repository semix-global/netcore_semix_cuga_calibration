<UserControl x:Class="CugaCalibration.Views.Common.Windows.File.Setting.Children.SettingTemplateMatchUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.File.Setting.Children"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingTemplateMatchViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Border>
        <UniformGrid Columns="2" Rows="2">
            <GroupBox Header="Threshold">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:NumericUpDown hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Match Score Threshold(Sharpe): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="200"
                                      Increment="0.1"
                                      Maximum="1"
                                      Minimum="0.001"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingTemplateMatchParam.SharpeTypeTemplateMatchScoreThreshold}" />
                    <hc:NumericUpDown hc:InfoElement.ShowClearButton="True"
                                      hc:InfoElement.Title="Match Score Threshold(NCC): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="200"
                                      Increment="0.1"
                                      Maximum="1"
                                      Minimum="0.001"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingTemplateMatchParam.NccTypeTemplateMatchScoreThreshold}" />
                </hc:UniformSpacingPanel>
            </GroupBox>
        </UniformGrid>
    </Border>
</UserControl>