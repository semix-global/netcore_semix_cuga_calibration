<UserControl x:Class="CugaCalibration.Views.Common.Windows.File.Setting.Children.SettingRelationCalibrationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cookiesUi="clr-namespace:Core.Models.Models.Common.Cookies.UI;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.File.Setting.Children"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingRelationCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <cookiesUi:CalibrationTreeView Grid.Row="0"
                                       Margin="5"
                                       ItemsSource="{Binding CalibrationRelationConfigs}"
                                       CheckBoxVisibility="Collapsed"
                                       DetailButtonStyle="{StaticResource ButtonIcon.Small}"
                                       DetailButtonIconGeometry="{StaticResource CustomEditGeometry}"
                                       MouseDoubleClickCommand="{Binding OpenDetailCommand}"
                                       DetailCommand="{Binding OpenDetailCommand}"
                                       DetailButtonVisibility="Visible" />

        <Button Grid.Row="1"
                Content="Clear"
                Command="{Binding ClearDependencyConfigCommand}"
                Width="100"
                Margin="5,0,5,5"
                HorizontalAlignment="Right"
                Style="{StaticResource ButtonPrimary}" />
    </Grid>
</UserControl>