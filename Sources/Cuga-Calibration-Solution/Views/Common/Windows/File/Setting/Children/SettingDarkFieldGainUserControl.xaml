<UserControl x:Class="CugaCalibration.Views.Common.Windows.File.Setting.Children.SettingDarkFieldGainUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:setting="clr-namespace:Core.Models.Models.Setting;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.File.Setting.Children"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingDarkFieldGainViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border>
        <Grid>
            <Grid.Resources>
                <Style BasedOn="{StaticResource GroupBoxBaseStyle}" TargetType="GroupBox">
                    <Style.Setters>
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Padding" Value="10" />
                    </Style.Setters>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Param">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:ComboBox hc:TitleElement.Title="Productivity Information: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="175"
                                 SelectedItem="{Binding ProductivityInformation}"
                                 Style="{StaticResource ComboBoxExtend}"
                                 ItemsSource="{Binding ApplicationCookie.NIOpticsMagTypeProductivityInformations}" />
                    <hc:ComboBox x:Name="ComboBoxPMTId"
                                 HorizontalAlignment="Left"
                                 hc:TitleElement.TitleWidth="175"
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.Title="PMT ID: "
                                 SelectedItem="{Binding PmtId}"
                                 ItemsSource="{Binding PmtIdList}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectedPmtIdChangedCommand}" CommandParameter="{Binding ElementName=ComboBoxPMTId, Path=SelectedItem}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </hc:ComboBox>
                    <hc:ComboBox x:Name="ComboChannelId"
                                 HorizontalAlignment="Left"
                                 hc:TitleElement.TitleWidth="175"
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.Title="Channel ID: "
                                 SelectedItem="{Binding ChannelId}"
                                 ItemsSource="{Binding ChannelIdList}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectedChannelChangedCommand}" CommandParameter="{Binding ElementName=ComboChannelId, Path=SelectedItem}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </hc:ComboBox>
                    <hc:NumericUpDown hc:TitleElement.Title="Gain Min: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="175"
                                      Maximum="10"
                                      Minimum="-10"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldGainParam.GainMin}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Gain Max: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="175"
                                      Maximum="10"
                                      Minimum="-10"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldGainParam.GainMax}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Gain Interval: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="175"
                                      Maximum="5"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldGainParam.GainInterval}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Target Pmt Average Value: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="175"
                                      Maximum="4000"
                                      Minimum="1000"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldGainParam.TargetPmtAverageValue}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Skip Cout: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="175"
                                      Maximum="100"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SettingDarkFieldGainParam.JudgeGainSkipCout}" />
                </hc:UniformSpacingPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Gain Setting">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <ListView d:SelectedIndex="0"
                              ItemsSource="{Binding SettingDarkFieldGainParam.GainOfCoefficientList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="100"
                                                Header="Coefficient"
                                                DisplayMemberBinding="{Binding Coefficient}" />
                                <GridViewColumn Width="100" Header="Gain">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:NumericUpDown Width="80"
                                                              d:DataContext="{d:DesignInstance Type=setting:GainOfCoefficientParam}"
                                                              Maximum="10"
                                                              Minimum="-10"
                                                              Style="{StaticResource NumericUpDownExtend}"
                                                              Value="{Binding Gain}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="150"
                                                Header="Pmt Average Value"
                                                DisplayMemberBinding="{Binding TargetPmtAverageValue}" />
                                <GridViewColumn Width="300" Header="Action">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <UniformGrid Columns="2">
                                                <Button Content="Auto Pmt Gain"
                                                        Command="{Binding Path=DataContext.AutoPmtGainCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Coefficient}"
                                                        d:DataContext="{d:DesignInstance Type=setting:GainOfCoefficientParam}"
                                                        Style="{StaticResource ButtonDefault.Loading}" />
                                                <Button Content="Cancel" Command="{Binding Path=DataContext.AutoPmtGainCancelCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                                            </UniformGrid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="100" Header="Action">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Plot"
                                                    Command="{Binding Path=DataContext.ShowPlotCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding TargetPmtValueList}"
                                                    d:DataContext="{d:DesignInstance Type=setting:GainOfCoefficientParam}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <GridSplitter Grid.Row="1" Height="5" />
                    <wpf:WpfPlot Grid.Row="2">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotListBehavior Title="Auto Pmt Gain" PlotList="{Binding PlotList, Mode=OneWay}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Grid>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>