<UserControl x:Class="CugaCalibration.Views.Common.Windows.File.Setting.Children.SettingCalibrateItemsStatusUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.File.Setting.Children"
             xmlns:cookiesUi="clr-namespace:Core.Models.Models.Common.Cookies.UI;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingCalibrateItemsStatusViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <cookiesUi:CalibrationTreeView Margin="5"
                                   CheckBoxStyle="{StaticResource CheckBoxBaseStyle}"
                                   ItemsSource="{Binding CalibrationCategories}" />
</UserControl>