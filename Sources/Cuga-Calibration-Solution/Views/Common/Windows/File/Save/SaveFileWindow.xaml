<Window x:Class="CugaCalibration.Views.Common.Windows.File.Save.SaveFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Common.Windows.File.Save"
        xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
        xmlns:enums="clr-namespace:Local.SQL.DB.Providers.Models.Enums;assembly=Local.SQL.DB.Providers"
        Width="800"
        Height="900"
        d:DataContext="{d:DesignInstance Type=viewModels:SaveFileWindowViewModel}"
        BorderBrush="{StaticResource PrimaryBrush}"
        BorderThickness="2"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <attachedHelper:LoadingHelper.IsShow>
            <MultiBinding Converter="{StaticResource MultiValueBooleanAnyConverter}">
                <Binding Path="LoadingCommand.IsRunning" />
                <Binding Path="SavingCommand.IsRunning" />
            </MultiBinding>
        </attachedHelper:LoadingHelper.IsShow>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction MethodName="DragMove" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="Save"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->

        <Grid Margin="10" Grid.Row="1">
            <TreeView ItemsSource="{Binding CalibrationVersionCategories}">
                <TreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid x:Name="Grid">
                            <Grid MinWidth="600" Margin="5,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding .Name}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="ComboBoxName"
                                          Margin="10,0,0,0"
                                          ItemsSource="{Binding .CategoryItem.Items}"
                                          SelectedItem="{Binding .CategoryItem.SelectItem, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ResultFilePath}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>
                        <HierarchicalDataTemplate.Triggers>
                            <!--  目录节点不显示 CheckBox  -->
                            <DataTrigger Binding="{Binding SysMenu.MenuTypeEnum}" Value="{x:Static enums:MenuTypeEnum.Catalog}">
                                <Setter TargetName="ComboBoxName" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!--  叶子节点（Menu 类型）缩进显示  -->
                            <DataTrigger Binding="{Binding SysMenu.MenuTypeEnum}" Value="{x:Static enums:MenuTypeEnum.Menu}">
                                <Setter TargetName="Grid" Property="Margin" Value="-20,0,0,0" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
        <hc:SimplePanel Margin="0,10" Grid.Row="2">
            <Button Content="Save"
                    Command="{Binding SavingCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                    Style="{StaticResource ButtonPrimary}" />
        </hc:SimplePanel>
    </Grid>

</Window>