<hc:Window x:Class="CugaCalibration.Views.LoadingWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="{Binding Title, Mode=OneWay}"
           Width="500"
           Height="400"
           d:DataContext="{d:DesignInstance Type=viewModels:LoadingWindowViewModel}"
           WindowStyle="None"
           ResizeMode="NoResize"
           BorderThickness="2"
           WindowStartupLocation="CenterScreen"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <!--  todo: 神奇组件bug, 改为Loaded后, 调试源码发现下面Command绑定失败: 当时View上设置了Window.SizeToContent属性有概率触发bug  -->
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding Title, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="1"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <hc:ScrollViewer IsInertiaEnabled="True"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <hc:CircleProgressBar Width="240"
                                          Height="240"
                                          d:Foreground="{StaticResource SuccessBrush}"
                                          IsIndeterminate="True"
                                          ArcThickness="16"
                                          ShowText="False"
                                          Foreground="{Binding IsFailed, Converter={StaticResource BoolNegationToBrushConverter}}" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding Message, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Margin="5"
                               FontSize="15"
                               Foreground="{Binding IsFailed, Converter={StaticResource BoolNegationToBrushConverter}}"
                               Style="{StaticResource TextBlockLargeBold}" />
                    <ProgressBar Grid.Row="2"
                                 Height="20"
                                 Margin="0,5"
                                 VerticalContentAlignment="Center"
                                 Foreground="{Binding IsFailed, Converter={StaticResource BoolNegationToBrushConverter}}"
                                 Value="{Binding ProcessValue, Mode=OneWay}" />
                </Grid>
            </hc:ScrollViewer>
        </Border>
        <!--#endregion-->
    </Grid>
</hc:Window>