<UserControl x:Class="CugaCalibration.Views.Laser.XTCCalibration.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXTCCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser XTC Step : "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.Threshold, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="Threshold: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Grid.Row="2" Header="Calibration Data">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <ListView d:SelectedIndex="0"
                              ItemsSource="{Binding ReviewList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectReviewItemDto}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="120"
                                                Header="Optics Mag"
                                                DisplayMemberBinding="{Binding OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                <GridViewColumn Width="100"
                                                Header="PMT Id"
                                                DisplayMemberBinding="{Binding PmtId}" />
                                <GridViewColumn Width="80"
                                                Header="Gain"
                                                DisplayMemberBinding="{Binding Gain}" />
                                <GridViewColumn Width="200"
                                                Header="Find Position"
                                                DisplayMemberBinding="{Binding FindPosition, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="80"
                                                Header="CH1Delay"
                                                DisplayMemberBinding="{Binding CH1Delay}" />
                                <GridViewColumn Width="80"
                                                Header="CH2Delay"
                                                DisplayMemberBinding="{Binding CH2Delay}" />
                                <GridViewColumn Width="80"
                                                Header="CH3Delay"
                                                DisplayMemberBinding="{Binding CH3Delay}" />
                                <GridViewColumn Width="200" Header="Action Review">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:ButtonGroup>
                                                <Button Content="Image"
                                                        Command="{Binding Path=DataContext.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="ImageYs"
                                                        Command="{Binding Path=DataContext.ImageProjectionYsReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </hc:ButtonGroup>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>