<UserControl x:Class="CugaCalibration.Views.Laser.XTCCalibration.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:helper="clr-namespace:Core.Models.Helper;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXTCCalibrationViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser XTC Step 1: "
                           Status="{Binding CalibrationStepList[1].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Mag: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Coefficient: "
                           Status="{Binding Cache.Coefficient, StringFormat={}{0:f3}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="Param "
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                             hc:InfoElement.Title="FindPostion: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:ButtonGroup>
                        <Button Content="Get" Command="{Binding GetPointCommand}" />
                        <Button Content="Goto" Command="{Binding GotoPointCommand}" />
                    </hc:ButtonGroup>

                    <hc:ComboBox HorizontalAlignment="Left"
                                 hc:InfoElement.TitleWidth="150"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Coefficient: "
                                 SelectedItem="{Binding Cache.Coefficient}"
                                 ItemsSource="{x:Static helper:CalibrationConstantsHelper.CalibrationCoefficients}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step1CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step1CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <ListView d:SelectedIndex="0"
                      ItemsSource="{Binding LaserXTCCalibrationItemDtoList}"
                      Style="{StaticResource ListView.Small}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <i:Interaction.Behaviors>
                    <behaviors:ListBoxScrollToCurrentBehavior />
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="150"
                                        Header="PmtId"
                                        DisplayMemberBinding="{Binding PmtId}" />
                        <GridViewColumn Width="200"
                                        Header="Find Position"
                                        DisplayMemberBinding="{Binding FindPosition, Converter={StaticResource PointToStringConverter}}" />
                        <GridViewColumn Width="150"
                                        Header="Gain"
                                        DisplayMemberBinding="{Binding Gain}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <GridSplitter Grid.Row="1" />
            <GroupBox Grid.Row="2" Header="History">
                <Border Padding="0"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        IsEnabled="{Binding Step2CalibrateActionCommand.IsRunning, Converter={StaticResource BoolNegationConverter}}">
                    <wpf:WpfPlot>
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotListBehavior Title="Auto Pmt Gain" PlotList="{Binding AutoGainSettingDarkFieldGainViewModel.PlotList, Mode=OneWay}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </GroupBox>
        </Grid>

        <!--#region Right-->
        <!--#endregion-->
    </Grid>
</UserControl>