<UserControl x:Class="CugaCalibration.Views.Laser.XPixelSize.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:Net.Utilities.ScottPlot.WPF.WPF.Controls;assembly=Net.Utilities.ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXPixelSizeCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="X Pixel Size Review : "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <Border Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}"
                            IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Verify"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:NumericUpDown hc:TitleElement.Title="Threshold(px): "
                                              hc:TitleElement.TitleWidth="160"
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.Threshold}" />
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button x:Name="ActionButton"
                                        Content="Action"
                                        Command="{Binding VerifyActionCommand}"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}"
                                        Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                                <Button x:Name="CancelButton"
                                        Content="Cancel"
                                        Command="{Binding VerifyActionCancelCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}"
                                        Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="Calibration Data">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="0.5*" />
                </Grid.RowDefinitions>
                <ListView x:Name="Listview"
                          d:SelectedIndex="0"
                          ItemsSource="{Binding Reviews}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Extended">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                        <behaviors:MultiSelectorListViewSelectedItemsBehavior BindableSelectedItems="{Binding SelectedReviewItems}" />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="ProductivityInformation" DisplayMemberBinding="{Binding ProductivityInformation}" />
                            <GridViewColumn Header="X Pixel Size(um/px)" DisplayMemberBinding="{Binding XPixelSize, StringFormat={}{0:f3}}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <hc:ScrollViewer>
                        <Border Padding="5" Style="{StaticResource BorderRegion}">
                            <ListBox ItemsSource="{Binding SelectedItem.VerifyItems, ElementName=Listview}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.CacheLength="2,2"
                                     VirtualizingPanel.CacheLengthUnit="Page">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Image Width="300"
                                               Height="300"
                                               Source="{Binding ImageFilePath}"
                                               Stretch="Uniform" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </hc:ScrollViewer>
                    <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                        <controls:ScatterMultiPlotControl Title="Match(Y: Score - X: px)"
                                                          ScatterLine0Title="Slide"
                                                          ScatterLine0Points="{Binding SelectedItem.SlideItemPoints, ElementName=Listview}"
                                                          ScatterLine0Color="{x:Static scottPlot:Colors.Blue}"
                                                          ScatterLine1Title="Verify"
                                                          ScatterLine1Points="{Binding SelectedItem.VerifyItemPoints, ElementName=Listview}"
                                                          ScatterLine1Color="{x:Static scottPlot:Colors.Red}" />
                    </Border>
                </Grid>
            </Grid>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>