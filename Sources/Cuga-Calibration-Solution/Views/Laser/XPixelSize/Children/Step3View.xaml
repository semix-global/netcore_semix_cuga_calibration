<UserControl x:Class="CugaCalibration.Views.Laser.XPixelSize.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:optics="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXPixelSizeCalibrationViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="X Pixel Size Step 3: "
                           Status="{Binding CalibrationStepList[4].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="OpticsMagType:"
                           Status="{Binding Cache.ProductivityInformation.OpticsMagType}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="StageSpeedType:"
                           Status="{Binding Cache.ProductivityInformation.StageSpeedType}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1.Params:"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <DockPanel>
                        <TextBox Text="{Binding Cache.Item.FindTemplatePosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="320"
                                 hc:InfoElement.Title="FindPostion: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <Button Content="Goto"
                                Command="{Binding GotoPointCommand}"
                                CommandParameter="FindTemplatePosition"
                                DockPanel.Dock="Right" />
                    </DockPanel>
                    <DockPanel>
                        <TextBox Text="{Binding Cache.FindStartPosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="320"
                                 hc:InfoElement.Title="FindStartPostion: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <Button Content="Goto"
                                Command="{Binding GotoPointCommand}"
                                CommandParameter="FindStartPosition"
                                DockPanel.Dock="Right" />
                    </DockPanel>
                    <DockPanel>
                        <TextBox Text="{Binding Cache.FindEndPosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="320"
                                 hc:InfoElement.Title="FindEndPosition: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <Button Content="Goto"
                                Command="{Binding GotoPointCommand}"
                                CommandParameter="FindEndPosition"
                                DockPanel.Dock="Right" />
                    </DockPanel>
                    <hc:NumericUpDown hc:InfoElement.Title="Column: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ColumnNumber}" />
                    <hc:ButtonGroup>
                        <Button Content="Get" Command="{Binding GetPointCommand}" />
                    </hc:ButtonGroup>
                    <hc:NumericUpDown hc:InfoElement.Title="ChuckRadius: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ChuckRadius}" />
                    <hc:NumericUpDown hc:InfoElement.Title="DieWidthUm: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.DieWidthUm}" />
                    <hc:NumericUpDown hc:InfoElement.Title="SlideWindowValue: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.SlideWindowValue}" />
                    <hc:NumericUpDown hc:InfoElement.Title="SlideStepValue: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.SlideStepValue}" />                    
                    <hc:NumericUpDown hc:InfoElement.Title="Image Count: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.SplitImageCount}" />
                    <TextBox Text="{Binding Cache.NccScoreThreshold}"
                             hc:InfoElement.Title="NccScoreThreshold: "
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="200"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.IdealUmPerPixel}"
                             hc:InfoElement.Title="IdealUmPerPixel: "
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="200">                        
                    </TextBox>

                    <TextBox Text="{Binding Cache.Threshold}"
                             hc:InfoElement.Title="Threshold: "
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="200"
                             Style="{StaticResource TextBoxExtend}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                    <StackPanel>
                        <TextBlock Text="2. Find"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding LaserXPixelSizeItem.XPixelSize}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="X-Pixel Size: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step3CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step3CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <Border Grid.Column="2"
                Padding="0"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <Grid>
                <GroupBox Header="Images">
                    <hc:ScrollViewer>
                        <Border Padding="5" Style="{StaticResource BorderRegion}">
                            <ItemsControl VerticalAlignment="Bottom" ItemsSource="{Binding DarkFieldCropImageList}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Width" Value="400" />
                                        <Setter Property="Height" Value="400" />
                                        <Setter Property="Margin" Value="5" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <hc:WaterfallPanel hc:PanelElement.FluidMoveBehavior="{StaticResource BehaviorXY200}" Groups="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <hc:SimplePanel>
                                            <view:CanvasView AxisColor="Red"
                                                             BackgroundColor="#0A0A0A"
                                                             BackgroundImage="{Binding FilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                             Interactive="True"
                                                             ShowAxes="True"
                                                             ShowCursor="False"
                                                             ShowGrid="False"
                                                             Tag="{Binding .}" />
                                            <TextBlock Text="{Binding Position, Converter={StaticResource PointToStringConverter}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Foreground="Yellow" />
                                        </hc:SimplePanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </hc:ScrollViewer>
                </GroupBox>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</UserControl>