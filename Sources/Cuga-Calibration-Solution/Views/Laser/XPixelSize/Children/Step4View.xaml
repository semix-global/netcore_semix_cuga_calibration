<UserControl x:Class="CugaCalibration.Views.Laser.XPixelSize.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXPixelSizeCalibrationViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
            <hc:Shield Subject="X Pixel Size Step 5: "
                       Status="{Binding CalibrationStepList[4].StepName}"
                       Color="{StaticResource InfoBrush}" />
            <hc:Shield DockPanel.Dock="Bottom"
                       Subject="Productivity: "
                       Status="{Binding Cache.ProductivityInformation}"
                       Color="{StaticResource SuccessBrush}" />
            <hc:Shield DockPanel.Dock="Bottom"
                       Subject="Microscope Lens: "
                       Status="{Binding Cache.Item.MicroscopeLensInformation}"
                       Color="{StaticResource SuccessBrush}" />
            <hc:Shield DockPanel.Dock="Bottom"
                       Subject="Alignment Degrees(°): "
                       Status="{Binding Cache.Item.AlignmentResult.Degrees, StringFormat='0.##########'}"
                       Color="{StaticResource SuccessBrush}" />
            <hc:Shield DockPanel.Dock="Bottom"
                       Subject="BF Machine Position(um): "
                       Status="{Binding Cache.Item.FindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                       Color="{StaticResource SuccessBrush}" />
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown hc:TitleElement.Title="Wafer Diameter(um): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.WaferDiameter}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Column Cell Width(um): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.ColumnCellWidth}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Threshold(px): "
                                      hc:TitleElement.TitleWidth="160"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Threshold}" />
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step4CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step4CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <hc:ScrollViewer>
                    <Border Padding="5" Style="{StaticResource BorderRegion}">
                        <ItemsControl VerticalAlignment="Bottom" ItemsSource="{Binding CalibratingItem.VerifyItems}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Width" Value="400" />
                                    <Setter Property="Height" Value="400" />
                                    <Setter Property="Margin" Value="5" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:WaterfallPanel hc:PanelElement.FluidMoveBehavior="{StaticResource BehaviorXY200}" Groups="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <hc:SimplePanel>
                                        <view:CanvasView AxisColor="Red"
                                                             BackgroundColor="#0A0A0A"
                                                             BackgroundImage="{Binding ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                             Interactive="True"
                                                             ShowAxes="True"
                                                             ShowCursor="False"
                                                             ShowGrid="False"
                                                             Tag="{Binding .}" />
                                        <TextBlock Text="{Binding MatchPoint, Converter={StaticResource PointToStringConverter}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Foreground="Yellow" />
                                    </hc:SimplePanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </hc:ScrollViewer>
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <ContentControl Content="{Binding ScatterPlotControl, Mode=OneWay}" />
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>