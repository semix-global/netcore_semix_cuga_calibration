<UserControl x:Class="CugaCalibration.Views.Laser.XPixelSize.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:wafer="clr-namespace:Core.Models.Enums.Recipe.Wafer;assembly=Core.Models"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXPixelSizeCalibrationViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="X Pixel Size Step 3: "
                           Status="{Binding CalibrationStepList[3].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="OpticsMagType:"
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="StageSpeedType:"
                           Status="{Binding Cache.XStageSpeedEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Params"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:ComboBox x:Name="MagCombobox"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Low Magnification: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.MicroscopeLensInformation, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformationList}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LensName}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding MagnificationSelectedCommand}" CommandParameter="{Binding ElementName=MagCombobox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                    <hc:ComboBox HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Template Mask Type: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.WaferMaskTypeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type wafer:WaferMaskTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <TextBox Text="{Binding Cache.FindTemplatePosition, Converter={StaticResource PointToStringConverter}}"
                             hc:InfoElement.Title="FindTemplatePosition: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:ButtonGroup>
                        <Button Content="Get" Command="{Binding GetPointCommand}" />
                        <Button Content="Goto"
                                Command="{Binding GotoPointCommand}"
                                CommandParameter="FindTemplatePosition" />
                    </hc:ButtonGroup>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Template"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:ComboBox HorizontalAlignment="Left"
                                 hc:InfoElement.TitleWidth="140"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Template Type: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.AlgorithmTemplateTypeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <view:CanvasView Width="100"
                                     Height="100"
                                     BackgroundColor="#0A0A0A"
                                     AxisColor="Red"
                                     Interactive="True"
                                     ShowAxes="True"
                                     ShowCursor="False"
                                     ShowGrid="False"
                                     BackgroundImage="{Binding Cache.TemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->

        <!--#endregion-->
    </Grid>
</UserControl>