<UserControl x:Class="CugaCalibration.Views.Laser.AodDelay.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:enum="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:aodDelay="clr-namespace:Core.Models.Models.Laser.AodDelay;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAodDelayCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser AOD Delay Step 3: "
                           Status="{Binding CalibrationStepList[1].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:NumericUpDown x:Name="WaitTimeNumeric"
                                          Width="275"
                                          hc:InfoElement.Title="Wait Time(s): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          hc:TitleElement.TitleWidth="180"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.WaitTime}" />
                        <hc:NumericUpDown x:Name="RoughAodDelayMinNumeric"
                                          Width="275"
                                          hc:InfoElement.Title="Rough Aod Delay Min: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.RoughAodDelayMinLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.RoughAodDelayMinMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.RoughAodDelayMinHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown x:Name="RoughAodDelayMaxNumeric"
                                          Width="275"
                                          hc:InfoElement.Title="Rough Aod Delay Max: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.RoughAodDelayMaxLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.RoughAodDelayMaxMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.RoughAodDelayMaxHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown x:Name="RoughAodDelayIntervalNumeric"
                                          Width="275"
                                          hc:InfoElement.Title="Rough Find Interval: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.RoughFindIntervalLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.RoughFindIntervalMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.RoughFindIntervalHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown x:Name="RefinedRangeNumeric"
                                          Width="275"
                                          hc:InfoElement.Title="Refined Range: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.RefinedRangeLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.RefinedRangeMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.RefinedRangeHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown x:Name="RefinedFindIntervalNumeric"
                                          Width="275"
                                          hc:InfoElement.Title="Refined Find Interval: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.RefinedFindIntervalLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.RefinedFindIntervalMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static enum:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.RefinedFindIntervalHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="2. Find AOD Delay"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding SelectedCalibrateItemDto.RefinedAodDelayTime, StringFormat={}{0:f3}, Mode=OneWay}"
                             Width="275"
                             hc:InfoElement.Title="AOD Delay Time: "
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding SelectedCalibrateItemDto.RefinedChirpAodDelayTime, StringFormat={}{0:f3}, Mode=OneWay}"
                             Width="275"
                             hc:InfoElement.Title="Chirp AOD Delay Time: "
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding SelectedCalibrateItemDto.RefinedPrescanAodDelayTime, StringFormat={}{0:f3}, Mode=OneWay}"
                             Width="275"
                             hc:InfoElement.Title="Prescan AOD Delay Time: "
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding SelectedCalibrateItemDto.AveragePmtData, StringFormat={}{0:f3}, Mode=OneWay}"
                             Width="275"
                             hc:InfoElement.Title="Max Average PMT: "
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding LaserAodDelayItemDtoList}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectedCalibrateItemDto, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="120"
                                            Header="Index"
                                            DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Width="100"
                                            Header="Optics Mag"
                                            DisplayMemberBinding="{Binding OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Width="200"
                                            Header="AOD Delay Time"
                                            DisplayMemberBinding="{Binding RefinedAodDelayTime, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="200"
                                            Header="Prescan AOD Delay Time"
                                            DisplayMemberBinding="{Binding RefinedPrescanAodDelayTime, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="200"
                                            Header="Chirp AOD Delay Time"
                                            DisplayMemberBinding="{Binding RefinedChirpAodDelayTime, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="Average PMT"
                                            DisplayMemberBinding="{Binding AveragePmtData, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="300" Header="Action Review">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ButtonGroup>
                                            <Button Content="PMT List"
                                                    Command="{Binding Path=DataContext.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding PmtDataList}"
                                                    d:DataContext="{d:DesignInstance Type=aodDelay:LaserAodDelayItemDto}" />
                                        </hc:ButtonGroup>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            <ToggleButton x:Name="ToggleButton"
                          Content="Function Image"
                          Margin="3.5"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          hc:IconElement.Geometry="{StaticResource AllGeometry}"
                          Style="{StaticResource ToggleButtonDefault.Small}" />
            <Popup StaysOpen="False"
                   PlacementTarget="{Binding ElementName=ToggleButton}"
                   Placement="Top"
                   AllowsTransparency="True"
                   PopupAnimation="Slide"
                   IsOpen="{Binding IsChecked, ElementName=ToggleButton, Mode=TwoWay}">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot Width="500" Height="400">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="Aod Delay" Plot0="{Binding AodDelayList}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </Popup>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>