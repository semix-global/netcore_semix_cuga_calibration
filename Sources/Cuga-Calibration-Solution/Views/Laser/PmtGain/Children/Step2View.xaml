<UserControl x:Class="CugaCalibration.Views.Laser.PmtGain.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserPmtGainCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser PMT Gain 3: "
                           Status="{Binding CalibrationStepList[0].StepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />

                        <hc:NumericUpDown hc:InfoElement.Title="Line Value: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          hc:TitleElement.TitleWidth="140"
                                          Minimum="0"
                                          Maximum="4095"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.LineValue}" />
                        <hc:NumericUpDown hc:InfoElement.Title="Min Value: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          hc:TitleElement.TitleWidth="140"
                                          Minimum="-100"
                                          Maximum="100"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.MinValue}" />
                        <hc:NumericUpDown hc:InfoElement.Title="Max Value: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          hc:TitleElement.TitleWidth="140"
                                          Minimum="-100"
                                          Maximum="100"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.MaxValue}" />

                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step2CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step2CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </StackPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
    </Grid>
</UserControl>