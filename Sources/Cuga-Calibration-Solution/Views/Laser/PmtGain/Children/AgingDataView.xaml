<UserControl x:Class="CugaCalibration.Views.Laser.PmtGain.Children.AgingDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserPmtGainCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Border Padding="2"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <GroupBox x:Name="groupBox"
                      Header="PMT Aging"
                      Style="{StaticResource GroupBoxTabBaseStyle}">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding SelectLaserPmtGainDto.Plot}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectLaserPmtGainDto}">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="150"
                                            Header="MeasurePower"
                                            DisplayMemberBinding="{Binding MeasurePower}" />
                            <GridViewColumn Width="100"
                                            Header="Voltage"
                                            DisplayMemberBinding="{Binding CurrentVoltage}" />
                            <GridViewColumn Width="150"
                                            Header="CurrentPower"
                                            DisplayMemberBinding="{Binding CurrentPower}" />
                            <GridViewColumn Width="150"
                                            Header="AgingPower"
                                            DisplayMemberBinding="{Binding AgingPower}" />
                            <GridViewColumn Width="120"
                                            Header="IsAging"
                                            DisplayMemberBinding="{Binding IsAging}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Border>
    </Grid>
</UserControl>