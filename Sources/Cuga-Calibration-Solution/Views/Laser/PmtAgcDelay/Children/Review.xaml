<UserControl x:Class="CugaCalibration.Views.Laser.PmtAgcDelay.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:pmtAgcDelay="clr-namespace:Core.Models.Models.Laser.PmtAgcDelay;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserPmtAgcDelayCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser AOD Delay: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Threshold: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Threshold}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="Calibration Data">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding LaserPmtAgcDelayItemDtoList}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                        <behaviors:MultiSelectorListViewSelectedItemsBehavior BindableSelectedItems="{Binding SelectReviewList}" />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Height" Value="250" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOk}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="100"
                                            Header="Pmt Id"
                                            DisplayMemberBinding="{Binding PmtId}" />
                            <GridViewColumn Width="150" Header="Offset">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding StringFormat="{}{0:f3}, {1:f3}, {2:f3}" Mode="OneWay">
                                        <Binding Path="Channel1AgcOffset" />
                                        <Binding Path="Channel2AgcOffset" />
                                        <Binding Path="Channel3AgcOffset" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn Width="400" Header="Channel1">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="400"
                                                     Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}"
                                                     d:DataContext="{d:DesignInstance Type=pmtAgcDelay:LaserPmtAgcDelayItemDto}"
                                                     Opacity="0.8">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotListBehavior IsShowLegend="False" PlotList="{Binding Channel1SenseData, Converter={StaticResource DoublesToPointsConverter}}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="400" Header="Channel2">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="400"
                                                     Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}"
                                                     d:DataContext="{d:DesignInstance Type=pmtAgcDelay:LaserPmtAgcDelayItemDto}"
                                                     Opacity="0.8">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotListBehavior IsShowLegend="False" PlotList="{Binding Channel2SenseData, Converter={StaticResource DoublesToPointsConverter}}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="400" Header="Channel3">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="400"
                                                     Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}"
                                                     d:DataContext="{d:DesignInstance Type=pmtAgcDelay:LaserPmtAgcDelayItemDto}"
                                                     Opacity="0.8">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotListBehavior IsShowLegend="False" PlotList="{Binding Channel3SenseData, Converter={StaticResource DoublesToPointsConverter}}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="150" Header="Delay">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding StringFormat="{}{0:f3}, {1:f3}, {2:f3}" Mode="OneWay">
                                        <Binding Path="Channel1AgcDelay" />
                                        <Binding Path="Channel2AgcDelay" />
                                        <Binding Path="Channel3AgcDelay" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>