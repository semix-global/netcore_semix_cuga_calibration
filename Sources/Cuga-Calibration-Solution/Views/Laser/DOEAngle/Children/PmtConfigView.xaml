<UserControl x:Class="CugaCalibration.Views.Laser.DOEAngle.Children.PmtConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserDOEAngleCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ListboxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <!--  默认边框颜色  -->
            <Setter Property="BorderBrush" Value="Transparent" />
            <!--  默认边框厚度  -->
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <!--  选中项的边框颜色  -->
                    <Setter Property="Background" Value="Gray" />
                </Trigger>
                <Trigger Property="IsSelected" Value="False">
                    <!--  未选中项的边框颜色  -->
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <!--  鼠标悬停时的边框颜色  -->
                    <Setter Property="Background" Value="LightGray" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
            <hc:Shield Subject="Laser DOE Angle Step 2: "
                       Status="{Binding CalibrationStepList[1].StepName}"
                       Color="{StaticResource InfoBrush}" />
            <GroupBox Header="PMT Enable">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <ListBox Width="auto"
                             Height="auto"
                             ItemsSource="{Binding Cache.PmtConfigList}"
                             ItemContainerStyle="{StaticResource ListboxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <hc:SimplePanel Height="28" Margin="5">
                                    <TextBlock Text="{Binding Id, StringFormat='PMT {0}'}"
                                               MinWidth="150"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                    <ToggleButton IsChecked="{Binding Enabled}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Background="{StaticResource DangerBrush}"
                                                  Style="{StaticResource ToggleButtonSwitch}" />
                                </hc:SimplePanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <hc:SimplePanel Margin="0,10">
                        <Button Content="Clear Selection"
                                Command="{Binding ChangeAllSelectionCommand}"
                                CommandParameter="False"
                                HorizontalAlignment="Left" />
                        <Button Content="Select All"
                                Command="{Binding ChangeAllSelectionCommand}"
                                CommandParameter="True"
                                HorizontalAlignment="Right" />
                    </hc:SimplePanel>
                </hc:UniformSpacingPanel>
            </GroupBox>
            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Spacing="10">
                <Button Content="Action"
                        Command="{Binding PmtConfigStepActionCommand}"
                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                        Style="{StaticResource ButtonPrimary.Loading}" />
            </hc:UniformSpacingPanel>
        </hc:UniformSpacingPanel>
    </Grid>
</UserControl>