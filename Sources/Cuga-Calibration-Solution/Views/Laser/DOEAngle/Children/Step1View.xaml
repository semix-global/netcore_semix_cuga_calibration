<UserControl x:Class="CugaCalibration.Views.Laser.DOEAngle.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Laser.PixelSize;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:scottplot="http://schemas.scottplot.net/2008/xaml/presentation"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserDOEAngleCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser DOE Angle Step 4: "
                           Status="{Binding CalibrationStepList[3].StepName}"
                           Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeLensInformation.LensName}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Threshold(um): "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="-5"
                                          Maximum="5"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Threshold}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Retry Count: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="50"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.RetryCount}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                    <StackPanel>
                        <TextBlock Text="2. Find DOE Angle Scale"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                        <TextBox Text="{Binding Cache.OriginDOEAngle}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Origin DOE Angle: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding LaserDOEAngleDto.DOEAngle}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Result DOE Angle Scale: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding LaserDOEAngleDto.AfPosError}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Result Af Pos Error(um): "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding LaserDOEAngleDto.DOEReviseAngle}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Result DOE Revise Angle: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding LaserDOEAngleDto.MultiRtfcFitSlope}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Fit Slope: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                Height="28"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <TabControl>
                <TabItem Header="Multiple RTFC History">
                    <GroupBox Header="History">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding DarkFieldRTFCDtoList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectDarkFieldRTFCItemDto}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="100"
                                                    Header="PMT Id"
                                                    DisplayMemberBinding="{Binding PmtId}" />
                                    <GridViewColumn Width="200"
                                                    Header="Find Position"
                                                    DisplayMemberBinding="{Binding Position, Converter={StaticResource PointToStringConverter}}" />
                                    <GridViewColumn Width="100"
                                                    Header="AF Ecs"
                                                    DisplayMemberBinding="{Binding AfEcs, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="100"
                                                    Header="AF Offset"
                                                    DisplayMemberBinding="{Binding AfOffset, StringFormat={}{0:f3}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
                <TabItem Header="Iteration History">
                    <GroupBox Header="History">
                        <ListView d:SelectedIndex="0"
                                  ItemsSource="{Binding LaserDOEAngleDtoItems}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectLaserDOEAngleDto}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="100"
                                                    Header="DOE Angle"
                                                    DisplayMemberBinding="{Binding DOEAngle, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200"
                                                    Header="DOE Revise Angle"
                                                    DisplayMemberBinding="{Binding DOEReviseAngle, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="100"
                                                    Header="Af Pos Error"
                                                    DisplayMemberBinding="{Binding AfPosError, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="100"
                                                    Header="Fit Slope"
                                                    DisplayMemberBinding="{Binding MultiRtfcFitSlope}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </TabItem>
            </TabControl>

            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <scottplot:WpfPlot>
                    <i:Interaction.Behaviors>
                        <behaviors:WpfPlotMultiBehavior Title="RTFC Result"
                                                        Plot0Title="Af Offset"
                                                        Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                        Plot0="{Binding AfOffsetPoints}" />
                    </i:Interaction.Behaviors>
                </scottplot:WpfPlot>
            </Border>

            <GroupBox Grid.Row="1" Grid.Column="0"
                      Grid.ColumnSpan="2"
                      Header="Images">
                <hc:ScrollViewer>
                    <Border Padding="5" Style="{StaticResource BorderRegion}">
                        <ItemsControl VerticalAlignment="Bottom" ItemsSource="{Binding DarkFieldRTFCDtoList}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Width" Value="400" />
                                    <Setter Property="Height" Value="400" />
                                    <Setter Property="Margin" Value="5" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:WaterfallPanel hc:PanelElement.FluidMoveBehavior="{StaticResource BehaviorXY200}" Groups="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <hc:SimplePanel>
                                        <view:CanvasView AxisColor="Red"
                                                         BackgroundColor="#0A0A0A"
                                                         BackgroundImage="{Binding AfImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                         Interactive="True"
                                                         ShowAxes="True"
                                                         ShowCursor="False"
                                                         ShowGrid="False"
                                                         Tag="{Binding .}" />
                                        <TextBlock Text="{Binding Position, Converter={StaticResource PointToStringConverter}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Foreground="Yellow" />
                                    </hc:SimplePanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </hc:ScrollViewer>
            </GroupBox>
        </Grid>

        <!--#endregion-->
    </Grid>
</UserControl>