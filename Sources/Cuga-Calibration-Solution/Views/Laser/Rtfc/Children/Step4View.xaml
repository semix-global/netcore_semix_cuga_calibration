<UserControl x:Class="CugaCalibration.Views.Laser.Rtfc.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:optics="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Laser.Rtfc;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserRtfcCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser Rtfc Step 3: "
                           Status="{Binding CalibrationStepList[5].StepName}"
                           Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Mag: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Speed: "
                           Status="{Binding FocusShiftCache.StageSpeedEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Find Focus Position: "
                           Status="{Binding FocusShiftCache.HighSiteFindPosition}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="ZLimitMinNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Z Limit Min: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                        <Setter Property="Value" Value="{Binding FocusShiftCache.LowMagFindFocusMin}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                        <Setter Property="Value" Value="{Binding FocusShiftCache.MiddleMagFindFocusMin}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                        <Setter Property="Value" Value="{Binding FocusShiftCache.HighMagFindFocusMin}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown x:Name="ZLimitMaxNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Z Limit Max: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                        <Setter Property="Value" Value="{Binding FocusShiftCache.LowMagFindFocusMax}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                        <Setter Property="Value" Value="{Binding FocusShiftCache.MiddleMagFindFocusMax}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                        <Setter Property="Value" Value="{Binding FocusShiftCache.HighMagFindFocusMax}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown x:Name="IntervalNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Z Interval: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1"
                                      Maximum="100">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                        <Setter Property="Value" Value="{Binding FocusShiftCache.LowMagFindFocusInterval}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                        <Setter Property="Value" Value="{Binding FocusShiftCache.MiddleMagFindFocusInterval}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                        <Setter Property="Value" Value="{Binding FocusShiftCache.HighMagFindFocusInterval}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="AfMotor Revise Threshold: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding FocusShiftCache.AfMotorReviseThreshold}" />
                    <hc:NumericUpDown hc:InfoElement.Title="Focus Shift Threshold: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding FocusShiftCache.FocusShiftThreshold}" />

                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="3. Find Focus"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding ResultRtfcDto.IdealEcs, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Ideal Ecs: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultRtfcDto.AutoFocusEcs, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="AutoFocus Ecs: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultRtfcDto.EcsValue, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Real Ecs: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultRtfcDto.DarkFieldMatchOffset, Converter={StaticResource PointToStringConverter}, Mode=OneWay}"
                             hc:InfoElement.Title="DarkField Match Offset: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}"
                             IsReadOnly="True" />
                    <TextBox Text="{Binding ResultRtfcDto.LightAxisOffset, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Light Axis Offset: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}"
                             IsReadOnly="True" />
                    <TextBox Text="{Binding ResultRtfcDto.DeltaEcs, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Reviese DeltaZ: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultRtfcDto.DarkFieldAutoFocusParam.DswEcsValue, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Reveise Dsw Ecs: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultRtfcDto.DarkFieldAutoFocusParam.DswMotorValue, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Reveise Dsw AfMotor : "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultRtfcDto.AfOffset, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Af Offset : "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultRtfcDto.DfOffset, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Df Offset : "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step4CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step4CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <GroupBox Header="Get Quality">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding RtfcDtoItems}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="80"
                                            Header="Index"
                                            DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Width="80"
                                            Header="EcsValue"
                                            DisplayMemberBinding="{Binding EcsValue, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="Quality"
                                            DisplayMemberBinding="{Binding Quality, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="200" Header="Action Review">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ButtonGroup>
                                            <Button Content="Image"
                                                    Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding DarkFieldImageFilePath}"
                                                    d:DataContext="{d:DesignInstance Type=coreModels:RtfcDto}" />
                                        </hc:ButtonGroup>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            <ToggleButton x:Name="ToggleButton"
                          Content="Function Image"
                          Margin="3.5"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          hc:IconElement.Geometry="{StaticResource AllGeometry}"
                          Style="{StaticResource ToggleButtonDefault.Small}" />
            <Popup StaysOpen="False"
                   PlacementTarget="{Binding ElementName=ToggleButton}"
                   Placement="Top"
                   AllowsTransparency="True"
                   PopupAnimation="Slide"
                   IsOpen="{Binding IsChecked, ElementName=ToggleButton, Mode=TwoWay}">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot Width="500" Height="400">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="Focus"
                                                            Plot0Title="Quality"
                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                            Plot0="{Binding EcsPoints}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </Popup>
            <GroupBox Grid.Row="1" Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding RtfcDtoIterationItems}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="120"
                                            Header="IdealEcs"
                                            DisplayMemberBinding="{Binding IdealEcs, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="120"
                                            Header="IdealEcsNsc"
                                            DisplayMemberBinding="{Binding IdealEcsNsc, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="120"
                                            Header="RealEcs"
                                            DisplayMemberBinding="{Binding EcsValue, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="120"
                                            Header="RealNsc"
                                            DisplayMemberBinding="{Binding NscValue, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="120"
                                            Header="AutoFocusEcs"
                                            DisplayMemberBinding="{Binding AutoFocusEcs, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="120"
                                            Header="AutoFocusNsc"
                                            DisplayMemberBinding="{Binding AutoFocusNsc, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="200"
                                            Header="DarkFieldMatchOffset"
                                            DisplayMemberBinding="{Binding DarkFieldMatchOffset, Converter={StaticResource PointToStringConverter}, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="200" Header="Action Review">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ButtonGroup>
                                            <Button Content="Image"
                                                    Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding DarkFieldImageFilePath}"
                                                    d:DataContext="{d:DesignInstance Type=coreModels:RtfcDto}" />
                                        </hc:ButtonGroup>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>