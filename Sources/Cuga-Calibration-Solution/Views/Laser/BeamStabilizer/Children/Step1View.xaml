<UserControl x:Class="CugaCalibration.Views.Laser.BeamStabilizer.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserBeamStabilizerCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Beam Stabilizer calibration"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="ThresholdNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="Threshold(um):           "
                                      hc:InfoElement.TitlePlacement="Left"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Threshold}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Repeat:"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.RepeatNumber}" />
                    <TextBox Text="{Binding Cache.CurrentPDPosition1, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Current PD Position1: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.CurrentPDPosition2, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Current PD Position2: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.OriginPosition1, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Origin Position1:        "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.OriginPosition2, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Origin Position2:        "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <ListView d:SelectedIndex="0"
                      ItemsSource="{Binding LaserBeamStabilizerObjDtoList}"
                      Style="{StaticResource ListView.Small}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <i:Interaction.Behaviors>
                    <behaviors:ListBoxScrollToCurrentBehavior />
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="50"
                                        Header="No."
                                        DisplayMemberBinding="{Binding Index, StringFormat={}{0}}" />
                        <GridViewColumn Width="200"
                                        Header="CurrentPDPosition1"
                                        DisplayMemberBinding="{Binding CurrentPDPosition1, Converter={StaticResource PointToStringConverter}}" />
                        <GridViewColumn Width="200"
                                        Header="CurrentPDPosition2"
                                        DisplayMemberBinding="{Binding CurrentPDPosition2, Converter={StaticResource PointToStringConverter}}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>