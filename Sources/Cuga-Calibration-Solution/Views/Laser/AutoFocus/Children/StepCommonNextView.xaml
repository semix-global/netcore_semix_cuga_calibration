<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.StepCommonNextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Color="{StaticResource InfoBrush}">
                    <hc:Shield.Style>
                        <Style BasedOn="{StaticResource ShieldBaseStyle}" TargetType="hc:Shield">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="1">
                                    <Setter Property="Subject" Value="AF Brightness Step 2:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[1].StepName}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="2">
                                    <Setter Property="Subject" Value="AF Brightness Step 3:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[2].StepName}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:Shield.Style>
                </hc:Shield>
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="2. Find Offset"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding ResultLaserAutoFocusDto.CurrentA, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="CurrentA: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             Visibility="{Binding Cache.IsA, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultLaserAutoFocusDto.Fa, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="FA: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             Visibility="{Binding Cache.IsA, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultLaserAutoFocusDto.Na, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="NA: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             Visibility="{Binding Cache.IsA, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultLaserAutoFocusDto.CurrentB, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="CurrentB: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             Visibility="{Binding Cache.IsA, Converter={StaticResource BoolNegationToVisibilityConverter}}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultLaserAutoFocusDto.Fb, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="FB: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             Visibility="{Binding Cache.IsA, Converter={StaticResource BoolNegationToVisibilityConverter}}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultLaserAutoFocusDto.Nb, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="NB: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             Visibility="{Binding Cache.IsA, Converter={StaticResource BoolNegationToVisibilityConverter}}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>

                    <hc:NumericUpDown x:Name="FminNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="F Min: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdFMin}" />
                    <hc:NumericUpDown x:Name="FmaxNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="F Max: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdFMax}" />
                    <hc:NumericUpDown x:Name="NminNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="N Min: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdNMin}" />
                    <hc:NumericUpDown x:Name="NmaxNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="N Max: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdNMax}" />
                    <hc:NumericUpDown x:Name="CurrentMinNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="Current Min: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdCurrentMin}" />
                    <hc:NumericUpDown x:Name="CurrentMaxNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="Current Max: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdCurrentMax}" />
                    <hc:NumericUpDown x:Name="CurrentIntervalNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="Interval: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1"
                                      Maximum="100"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.FindInterval}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Grid Grid.Row="2">
                <GroupBox Header="History">
                    <Grid>
                        <ListView d:SelectedIndex="0"
                                  Visibility="{Binding Cache.IsA, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ItemsSource="{Binding LaserAutoFocusDtoList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedLaserAutoFocusDto, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="200"
                                                    Header="Current A"
                                                    DisplayMemberBinding="{Binding CurrentA, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200"
                                                    Header="FA"
                                                    DisplayMemberBinding="{Binding Fa, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200"
                                                    Header="NA"
                                                    DisplayMemberBinding="{Binding Na, StringFormat={}{0:f3}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <ListView d:SelectedIndex="0"
                                  Visibility="{Binding Cache.IsA, Converter={StaticResource BoolNegationToVisibilityConverter}}"
                                  ItemsSource="{Binding LaserAutoFocusDtoList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedLaserAutoFocusDto, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="200"
                                                    Header="Current B"
                                                    DisplayMemberBinding="{Binding CurrentB, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200"
                                                    Header="FB"
                                                    DisplayMemberBinding="{Binding Fb, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200"
                                                    Header="NB"
                                                    DisplayMemberBinding="{Binding Nb, StringFormat={}{0:f3}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </GroupBox>
                <ToggleButton x:Name="ToggleButton"
                              Content="Function Image"
                              Margin="3.5"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              hc:IconElement.Geometry="{StaticResource AllGeometry}"
                              Style="{StaticResource ToggleButtonDefault.Small}" />
                <Popup StaysOpen="False"
                       PlacementTarget="{Binding ElementName=ToggleButton}"
                       Placement="Left"
                       AllowsTransparency="True"
                       PopupAnimation="Slide"
                       IsOpen="{Binding IsChecked, ElementName=ToggleButton, Mode=TwoWay}">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                            <wpf:WpfPlot Width="500" Height="400">
                                <i:Interaction.Behaviors>
                                    <behaviors:WpfPlotMultiBehavior Title="F"
                                                                    Plot0Title="Quality"
                                                                    Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                    Plot0="{Binding FList}" />
                                </i:Interaction.Behaviors>
                            </wpf:WpfPlot>
                            <wpf:WpfPlot Width="500" Height="400">
                                <i:Interaction.Behaviors>
                                    <behaviors:WpfPlotMultiBehavior Title="N" Plot0="{Binding NList}" />
                                </i:Interaction.Behaviors>
                            </wpf:WpfPlot>
                        </hc:UniformSpacingPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>