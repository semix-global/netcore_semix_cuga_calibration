<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Auto Focus Step 3: "
                           Status="{Binding CalibrationStepList[3].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Half Length Ecs: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.HalfEcsLength}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Speed Ecs(ecs/s): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.SpeedEcsPerSecond}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Nsc Standard(nsc/um): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.NscStandardNscPerNm}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Threshold Symmetry Ratio: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdNscStandardSymmetryRatio}" />
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="History">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <TextBox Text="{Binding ResultLaserAutoFocusDto.IsNscUseMaxValue}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Is Use Max: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultLaserAutoFocusDto.IsNscUsePositiveSlope}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Is Use Positive: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultLaserAutoFocusDto.OriginalSymmetryRatio, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Original Symmetry Ratio: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultLaserAutoFocusDto.EcsToNmRange, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Ecs Range(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ResultLaserAutoFocusDto.NscStandard, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Standard(nsc): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                        <wpf:WpfPlot Grid.Row="2">
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="Trace Buffer"
                                                                Plot0Title="Original ECS"
                                                                Plot0Color="{x:Static scottPlot:Colors.LightGreen}"
                                                                Plot0="{Binding ResultLaserAutoFocusDto.OriginalEcs, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot1Title="Original NSC"
                                                                Plot1Color="{x:Static scottPlot:Colors.LightBlue}"
                                                                Plot1="{Binding ResultLaserAutoFocusDto.OriginalNsc, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot2Title="Original Lvdt"
                                                                Plot2Color="{x:Static scottPlot:Colors.LightCoral}"
                                                                Plot2="{Binding ResultLaserAutoFocusDto.OriginalLvdt, Converter={StaticResource DoublesToPointsConverter}}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>