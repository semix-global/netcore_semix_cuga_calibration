<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Ads Pressure Gains: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown Width="310"
                                      hc:InfoElement.Title="Range Ratio: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ReviewThresholdRangeRatio}" />
                    <hc:NumericUpDown Width="310"
                                      hc:InfoElement.Title="F Min: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealFMin}" />
                    <hc:NumericUpDown Width="310"
                                      hc:InfoElement.Title="F Max: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealFMax}" />
                    <TextBox Width="310"
                             hc:InfoElement.Title="F Range: "
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Background="LightGray"
                             Style="{StaticResource TextBoxExtend}">
                        <TextBox.Text>
                            <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                <Binding Path="Cache.ReviewThresholdFMin" />
                                <Binding Path="Cache.ReviewThresholdFMax" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <hc:NumericUpDown Width="310"
                                      hc:InfoElement.Title="N Min: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealNMin}" />
                    <hc:NumericUpDown Width="310"
                                      hc:InfoElement.Title="N Max: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealNMax}" />
                    <TextBox Width="310"
                             hc:InfoElement.Title="N Range: "
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Background="LightGray"
                             Style="{StaticResource TextBoxExtend}">
                        <TextBox.Text>
                            <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                <Binding Path="Cache.ReviewThresholdNMin" />
                                <Binding Path="Cache.ReviewThresholdNMax" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <hc:NumericUpDown Width="310"
                                      hc:InfoElement.Title="Calibration Range (nsc/um): "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalibrationThresholdNscNscPerNmRange}" />
                    <hc:NumericUpDown Width="310"
                                      hc:InfoElement.Title="Calibration Symmetry Ratio: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalibrationThresholdNscSymmetryRatio}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="Calibration Data">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="2">
                            <UniformGrid.Resources>
                                <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                    <Setter Property="Margin" Value="5" />
                                </Style>
                            </UniformGrid.Resources>
                            <TextBox Text="{Binding ReviewDto.CurrentA, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="CurrentA: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock />
                            <TextBox Text="{Binding ReviewDto.Na, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="NA: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.Fa, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="FA: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.CurrentB, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="CurrentB: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock />
                            <TextBox Text="{Binding ReviewDto.Nb, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="NB: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.Fb, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="FB: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.IsNscUseMaxValue}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Is Use Max: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.IsNscUsePositiveSlope}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Is Use Positive: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.OriginalSymmetryRatio, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Original Symmetry Ratio: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock />
                            <TextBox Text="{Binding ReviewDto.EcsToNmRange, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Ecs Range(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.NscStandard, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Standard(nsc): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.NscOffset, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Offset: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.NscGain, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Gain: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.NscCurrentNscPerNm, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc(nsc/um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBox Text="{Binding ReviewDto.NscCurrentSymmetryRatio, StringFormat={}{0:f3}}"
                                     Width="375"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Symmetry Ratio: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="200"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        </UniformGrid>
                        <wpf:WpfPlot Grid.Row="2">
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="Trace Buffer"
                                                                Plot0Title="Original ECS"
                                                                Plot0Color="{x:Static scottPlot:Colors.LightGreen}"
                                                                Plot0="{Binding ReviewDto.OriginalEcs, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot1Title="Original NSC"
                                                                Plot1Color="{x:Static scottPlot:Colors.LightBlue}"
                                                                Plot1="{Binding ReviewDto.OriginalNsc, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot2Title="Original Lvdt"
                                                                Plot2Color="{x:Static scottPlot:Colors.LightCoral}"
                                                                Plot2="{Binding ReviewDto.OriginalLvdt, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot3Title="Calibration ECS"
                                                                Plot3Color="{x:Static scottPlot:Colors.Green}"
                                                                Plot3="{Binding ReviewDto.CalibrationEcs, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot4Title="Calibration NSC"
                                                                Plot4Color="{x:Static scottPlot:Colors.Blue}"
                                                                Plot4="{Binding ReviewDto.CalibrationNsc, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot5Title="Calibration Lvdt"
                                                                Plot5Color="{x:Static scottPlot:Colors.Coral}"
                                                                Plot5="{Binding ReviewDto.CalibrationLvdt, Converter={StaticResource DoublesToPointsConverter}}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>