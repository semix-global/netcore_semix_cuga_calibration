<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Ads Pressure Gains: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.ThresholdFMin, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="F Min: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.ThresholdFMax, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="F Max: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.ThresholdNMin, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="N Min: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.ThresholdNMax, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="N Max: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.VerifyResultFa, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="FA: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.VerifyResultFb, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="FB: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.VerifyResultNa, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="NA: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.VerifyResultNb, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:InfoElement.Title="NB: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Grid.Row="2"
                      VerticalAlignment="Top"
                      Header="Calibration Data">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <UniformGrid Rows="6" Columns="1">
                        <UniformGrid.Resources>
                            <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                                <Setter Property="Margin" Value="5" />
                            </Style>
                        </UniformGrid.Resources>
                        <TextBox Text="{Binding ReviewDto.CurrentA, StringFormat={}{0:f3}}"
                                 Width="275"
                                 Height="25"
                                 hc:InfoElement.Title="CurrentA: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="100"
                                 IsReadOnly="True"
                                 Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ReviewDto.Na, StringFormat={}{0:f3}}"
                                 Width="275"
                                 Height="25"
                                 hc:InfoElement.Title="NA: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="100"
                                 IsReadOnly="True"
                                 Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ReviewDto.Fa, StringFormat={}{0:f3}}"
                                 Width="275"
                                 Height="25"
                                 hc:InfoElement.Title="FA: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="100"
                                 IsReadOnly="True"
                                 Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ReviewDto.CurrentB, StringFormat={}{0:f3}}"
                                 Width="275"
                                 Height="25"
                                 hc:InfoElement.Title="CurrentB: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="100"
                                 IsReadOnly="True"
                                 Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ReviewDto.Nb, StringFormat={}{0:f3}}"
                                 Width="275"
                                 Height="25"
                                 hc:InfoElement.Title="NB: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="100"
                                 IsReadOnly="True"
                                 Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ReviewDto.Fb, StringFormat={}{0:f3}}"
                                 Width="275"
                                 Height="25"
                                 hc:InfoElement.Title="FB: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="100"
                                 IsReadOnly="True"
                                 Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                 Style="{StaticResource TextBoxExtend}" />
                    </UniformGrid>
                </Border>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>