<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Ads Pressure Gains: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Range Ratio: "
                                      hc:TitleElement.TitleWidth="150"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ReviewThresholdRangeRatio}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="F Min: "
                                      hc:TitleElement.TitleWidth="150"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealFMin}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="F Max: "
                                      hc:TitleElement.TitleWidth="150"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealFMax}" />
                    <TextBox Width="275"
                             hc:InfoElement.Title="F Range: "
                             hc:TitleElement.TitleWidth="150"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Background="LightGray"
                             Style="{StaticResource TextBoxExtend}">
                        <TextBox.Text>
                            <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                <Binding Path="Cache.ReviewThresholdFMin" />
                                <Binding Path="Cache.ReviewThresholdFMax" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="N Min: "
                                      hc:TitleElement.TitleWidth="150"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealNMin}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="N Max: "
                                      hc:TitleElement.TitleWidth="150"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealNMax}" />
                    <TextBox Width="275"
                             hc:InfoElement.Title="N Range: "
                             hc:TitleElement.TitleWidth="150"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Background="LightGray"
                             Style="{StaticResource TextBoxExtend}">
                        <TextBox.Text>
                            <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                <Binding Path="Cache.ReviewThresholdNMin" />
                                <Binding Path="Cache.ReviewThresholdNMax" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Threshold Nsc Offset: "
                                      hc:TitleElement.TitleWidth="150"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdNscOffset}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Threshold Nsc Gain: "
                                      hc:TitleElement.TitleWidth="150"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdNscGain}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="Calibration Data">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <TextBox Text="{Binding ReviewDto.CurrentA, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="CurrentA: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.Na, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="NA: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.Fa, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="FA: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.CurrentB, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="CurrentB: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.Nb, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="NB: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.Fb, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="FB: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.NscCurrentMax, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Max: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.NscCurrentMin, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Min: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.NscOffset, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Offset: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.NscGain, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Gain: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.NscGainReciprocal, Mode=OneWay, StringFormat={}{0:f3}}"
                                     Width="275"
                                     Height="25"
                                     hc:InfoElement.Title="Nsc Gain Reciprocal: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Foreground="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                        <wpf:WpfPlot Grid.Row="2">
                            <b:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="Trace Buffer"
                                                                Plot0Title="ECS"
                                                                Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                Plot0="{Binding ReviewDto.EcsData, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot1Title="NSC"
                                                                Plot1Color="{x:Static scottPlot:Colors.LightBlue}"
                                                                Plot1="{Binding ReviewDto.NscData, Converter={StaticResource DoublesToPointsConverter}}"
                                                                Plot2Title="Lvdt"
                                                                Plot2Color="{x:Static scottPlot:Colors.LightCoral}"
                                                                Plot2="{Binding ReviewDto.LvdtData, Converter={StaticResource DoublesToPointsConverter}}" />
                            </b:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>