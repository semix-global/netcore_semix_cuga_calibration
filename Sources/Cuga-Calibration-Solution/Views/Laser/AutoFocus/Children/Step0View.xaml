<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                            Orientation="Vertical"
                            Spacing="3">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
            <hc:Shield Subject="AF Brightness Step 1: "
                       Status="{Binding CalibrationStepList[0].StepName}"
                       Color="{StaticResource InfoBrush}" />
        </hc:UniformSpacingPanel>

        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <StackPanel>
                    <TextBlock Text="Find Position"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </StackPanel>
                <TextBox Text="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                         Width="275"
                         hc:InfoElement.Title="Position(um): "
                         hc:InfoElement.TitlePlacement="Left"
                         Style="{StaticResource TextBoxExtend}" />
                <hc:ButtonGroup Width="275">
                    <Button x:Name="GetButton"
                            Content="Get"
                            Command="{Binding GetPointCommand}" />
                    <Button x:Name="GotoButton"
                            Content="Goto"
                            Command="{Binding GotoPointCommand}" />
                </hc:ButtonGroup>
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step0CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step0CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </hc:UniformSpacingPanel>
        </Border>
    </hc:UniformSpacingPanel>
</UserControl>