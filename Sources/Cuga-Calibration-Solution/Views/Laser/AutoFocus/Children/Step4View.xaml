<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step4View "
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Auto Focus Step 5: "
                           Status="{Binding CalibrationStepList[5].StepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:NumericUpDown Width="290"
                                      hc:InfoElement.Title="Current Position of Motor: "
                                      hc:TitleElement.TitleWidth="210"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="5500"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CurrentMotorPosition, Mode=OneWay}" />
                    <hc:NumericUpDown Width="290"
                                      hc:InfoElement.Title="Increase Position of Motor: "
                                      hc:TitleElement.TitleWidth="210"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="5500"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.IncreateMotorPosition}" />
                    <TextBox Text="{Binding ResultLaserAutoFocusDto.EcsMotorPositionRelation, Mode=OneWay, StringFormat={}{0:f3}}"
                             Width="290"
                             hc:InfoElement.Title="Motor Calibration Result:(ecs/mm): "
                             hc:TitleElement.TitleWidth="210"
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step4CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step4CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="History">
                <Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <wpf:WpfPlot>
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="Transformational Relation Of The ECS And AF Motor Position"
                                                                Plot0Title="ECS And Motor Origin Position"
                                                                Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                Plot0="{Binding Cache.EcsMotorOriginPositionList}"
                                                                Plot1Title="ECS And Motor Smooth Position"
                                                                Plot1Color="{x:Static scottPlot:Colors.Orange}"
                                                                Plot1="{Binding Cache.EcsMotorSmoothPositionList}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>
