<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step1View "
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Auto Focus Step 2: "
                           Status="{Binding CalibrationStepList[2].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Range Ratio: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalibrationThresholdRangeRation}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="F Min: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealFMin}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="F Max: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealFMax}" />
                    <TextBox Width="275"
                             hc:InfoElement.Title="F Range: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Background="LightGray"
                             Style="{StaticResource TextBoxExtend}">
                        <TextBox.Text>
                            <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                <Binding Path="Cache.CalibrationThresholdFMin" />
                                <Binding Path="Cache.CalibrationThresholdFMax" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="N Min: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealNMin}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="N Max: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdIdealNMax}" />
                    <TextBox Width="275"
                             hc:InfoElement.Title="N Range: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Background="LightGray"
                             Style="{StaticResource TextBoxExtend}">
                        <TextBox.Text>
                            <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                <Binding Path="Cache.CalibrationThresholdNMin" />
                                <Binding Path="Cache.CalibrationThresholdNMax" />
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Current Min: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdCurrentMin}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Current Max: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ThresholdCurrentMax}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Current Step: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="100"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.FindCurrentStep}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListView ItemsSource="{Binding ABrightnessList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding ABrightnessSelected, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="200"
                                                    Header="Current A"
                                                    DisplayMemberBinding="{Binding CurrentA, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200"
                                                    Header="FA"
                                                    DisplayMemberBinding="{Binding Fa, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200"
                                                    Header="NA"
                                                    DisplayMemberBinding="{Binding Na, StringFormat={}{0:f3}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <ListView Grid.Column="2"
                                  ItemsSource="{Binding BBrightnessList}"
                                  Style="{StaticResource ListView.Small}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding BBrightnessSelected, Mode=OneWay}">
                            <i:Interaction.Behaviors>
                                <behaviors:ListBoxScrollToCurrentBehavior />
                            </i:Interaction.Behaviors>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="200"
                                                    Header="Current B"
                                                    DisplayMemberBinding="{Binding CurrentB, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200"
                                                    Header="FB"
                                                    DisplayMemberBinding="{Binding Fb, StringFormat={}{0:f3}}" />
                                    <GridViewColumn Width="200"
                                                    Header="NB"
                                                    DisplayMemberBinding="{Binding Nb, StringFormat={}{0:f3}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <wpf:WpfPlot>
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="A F N"
                                                                Plot0Title="F"
                                                                Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                Plot0="{Binding ABrightnessFList}"
                                                                Plot1Title="N"
                                                                Plot1Color="{x:Static scottPlot:Colors.LightBlue}"
                                                                Plot1="{Binding ABrightnessNList}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                        <wpf:WpfPlot Grid.Column="1">
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="B F N"
                                                                Plot0Title="F"
                                                                Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                Plot0="{Binding BBrightnessFList}"
                                                                Plot1Title="N"
                                                                Plot1Color="{x:Static scottPlot:Colors.LightBlue}"
                                                                Plot1="{Binding BBrightnessNList}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>