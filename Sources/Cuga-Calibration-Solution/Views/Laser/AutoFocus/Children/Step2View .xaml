<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step2View "
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:autoFocus="clr-namespace:Core.Models.Models.Laser.AutoFocus;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Auto Focus Step 3: "
                           Status="{Binding CalibrationStepList[2].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Half Length Ecs: "
                                          hc:TitleElement.TitleWidth="150"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.HalfEcsLength}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Speed Ecs(Ecs/s): "
                                          hc:TitleElement.TitleWidth="150"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.SpeedEcs}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Nsc Standard: "
                                          hc:TitleElement.TitleWidth="150"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.NscStandardValue}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Retry Count: "
                                          hc:TitleElement.TitleWidth="150"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.RetryCount}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Threshold Nsc Offset: "
                                          hc:TitleElement.TitleWidth="150"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdNscOffset}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Threshold Nsc Gain: "
                                          hc:TitleElement.TitleWidth="150"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdNscGain}" />
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding NscStandardList}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItem="{Binding NscStandardSelected, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Height" Value="250" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="500" Header="Min, Max, Offset, Gain">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding StringFormat="{}{0:f3}, {1:f3}, {2:f3}, {3:f3}" Mode="OneWay">
                                        <Binding Path="NscCurrentMin" />
                                        <Binding Path="NscCurrentMax" />
                                        <Binding Path="NscCurrentOffset" />
                                        <Binding Path="NscCurrentGain" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn Width="600" Header="Trans buffer">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="600"
                                                     Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}"
                                                     d:DataContext="{d:DesignInstance Type=autoFocus:LaserAutoFocusDto}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotMultiBehavior Plot0Title="ECS"
                                                                                Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                                Plot0="{Binding EcsData, Converter={StaticResource DoublesToPointsConverter}}"
                                                                                Plot1Title="NSC"
                                                                                Plot1Color="{x:Static scottPlot:Colors.LightBlue}"
                                                                                Plot1="{Binding NscData, Converter={StaticResource DoublesToPointsConverter}}"
                                                                                Plot2Title="Lvdt"
                                                                                Plot2Color="{x:Static scottPlot:Colors.LightCoral}"
                                                                                Plot2="{Binding LvdtData, Converter={StaticResource DoublesToPointsConverter}}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100"
                                            Header="Offset"
                                            DisplayMemberBinding="{Binding NscOffset, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="Gain"
                                            DisplayMemberBinding="{Binding NscGain, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="Gain Reciprocal"
                                            DisplayMemberBinding="{Binding NscGainReciprocal, Mode=OneWay, StringFormat={}{0:f3}}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>