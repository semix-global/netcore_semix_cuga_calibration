<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAutoFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Auto Focus Step 4: "
                           Status="{Binding CalibrationStepList[4].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Half Length Ecs: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.HalfEcsLength}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Speed Ecs(ecs/s): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.SpeedEcsPerSecond}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Nsc Standard(nsc/um): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.NscStandardNscPerNm}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Retry Count: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.RetryCount}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Calibration Range (nsc/um): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.CalibrationThresholdNscNscPerNmRange}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Calibration Symmetry Ratio: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.CalibrationThresholdNscSymmetryRatio}" />
                        <hc:NumericUpDown Width="275"
                                          hc:InfoElement.Title="Threshold Gain: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdNscStandardGain}" />
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step3CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step3CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding NscStandardList}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItem="{Binding NscStandardSelected, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Height" Value="250" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="310" Header="Standard, Offset, Gain, nsc/um, Symmetry Ratio">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding StringFormat="{}{0:f3}, {1:f3}, {2:f3}, {3:f3}, {4:f3}" Mode="OneWay">
                                        <Binding Path="NscStandard" />
                                        <Binding Path="NscOffset" />
                                        <Binding Path="NscGain" />
                                        <Binding Path="NscCurrentNscPerNm" />
                                        <Binding Path="NscCurrentSymmetryRatio" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn Width="600" Header="Trans buffer">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="600" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotMultiBehavior Plot0Title="ECS"
                                                                                Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                                Plot0="{Binding CalibrationEcs, Converter={StaticResource DoublesToPointsConverter}}"
                                                                                Plot1Title="NSC"
                                                                                Plot1Color="{x:Static scottPlot:Colors.LightBlue}"
                                                                                Plot1="{Binding CalibrationNsc, Converter={StaticResource DoublesToPointsConverter}}"
                                                                                Plot2Title="Lvdt"
                                                                                Plot2Color="{x:Static scottPlot:Colors.LightCoral}"
                                                                                Plot2="{Binding CalibrationLvdt, Converter={StaticResource DoublesToPointsConverter}}"
                                                                                Plot3Title="FA"
                                                                                Plot3Color="{x:Static scottPlot:Colors.DarkOrange}"
                                                                                Plot3="{Binding CalibrationFa, Converter={StaticResource DoublesToPointsConverter}}"
                                                                                Plot4Title="NA"
                                                                                Plot4Color="{x:Static scottPlot:Colors.DarkOliveGreen}"
                                                                                Plot4="{Binding CalibrationNa, Converter={StaticResource DoublesToPointsConverter}}"
                                                                                Plot5Title="FB"
                                                                                Plot5Color="{x:Static scottPlot:Colors.PaleGoldenRod}"
                                                                                Plot5="{Binding CalibrationFb, Converter={StaticResource DoublesToPointsConverter}}"
                                                                                Plot6Title="NB"
                                                                                Plot6Color="{x:Static scottPlot:Colors.DeepSkyBlue}"
                                                                                Plot6="{Binding CalibrationNb, Converter={StaticResource DoublesToPointsConverter}}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="600" Header="Ecs Nsc Curve And Slope">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="600" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotMultiBehavior Title="EcsNsc"
                                                                                Plot0Title="EcsNscCurve"
                                                                                Plot0Color="{x:Static scottPlot:Colors.DarkOrange}"
                                                                                Plot0="{Binding CalibrationEcsNscPointList}"
                                                                                Plot1Title="EcsNscSlope"
                                                                                Plot1Color="{x:Static scottPlot:Colors.Green}"
                                                                                Plot1="{Binding CalibrationEcsNscMaxMinList}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="600" Header="Ecs Nsc Curve And Slope">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="600" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotMultiBehavior Title="EcsNsc"
                                                                                Plot0Title="EcsNscCurve"
                                                                                Plot0Color="{x:Static scottPlot:Colors.DarkOrange}"
                                                                                Plot0="{Binding CalibrationEcsNscPointList}"
                                                                                Plot1Title="EcsNscSlope"
                                                                                Plot1Color="{x:Static scottPlot:Colors.Green}"
                                                                                Plot1="{Binding CalibrationEcsNscMaxMinList}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>