<UserControl x:Class="CugaCalibration.Views.Laser.PrescanChirpAodAlignment.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:constants="clr-namespace:Core.Models.Helper;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserPrescanChirpAodAlignmentCalibrationViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->

        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
            <hc:Shield Subject="Prescan Chirp Alignment Step 2: "
                       Status="{Binding CalibrationStepList[1].StepName}"
                       Color="{StaticResource InfoBrush}" />
            <hc:Shield DockPanel.Dock="Bottom"
                       Subject="Optics Mag: "
                       Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                       Color="{StaticResource SuccessBrush}" />
            <hc:Shield DockPanel.Dock="Bottom"
                       Subject="Position: "
                       Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                       Color="{StaticResource SuccessBrush}" />
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <Border Padding="5"
                            Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Coefficient:" />
                            <ItemsControl HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ItemsSource="{x:Static constants:CalibrationConstantsHelper.CalibrationCoefficients}">
                                <i:Interaction.Behaviors>
                                    <behaviors:RadioButtonSelectedItemBehavior SelectedItem="{Binding Cache.PrescanCoefficient, Mode=TwoWay}" />
                                </i:Interaction.Behaviors>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding ., StringFormat={}{0:0.###}}"
                                                     FontSize="12"
                                                     Tag="{Binding .}"
                                                     GroupName="06961348-8eea-4c0b-a2ab-1771146e9efb" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </hc:UniformSpacingPanel>
                    </Border>
                    <hc:NumericUpDown hc:InfoElement.Title="Gain: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="-10"
                                      Maximum="10"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Gain}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>