<UserControl x:Class="CugaCalibration.Views.Laser.PrescanChirpAodAlignment.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prescanChirpAodAlignment="clr-namespace:Core.Models.Models.Laser.PrescanChirpAodAlignment;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserPrescanChirpAodAlignmentCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Prescan Chirp Alignment Step 3: "
                           Status="{Binding CalibrationStepList[2].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Mag: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Coefficient: "
                           Status="{Binding Cache.PrescanCoefficient, StringFormat={}{0:f3}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:NumericUpDown hc:InfoElement.Title="Flatness Time(ns): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.PrescanFlatnessTime}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Endpoint Time(ns): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.PrescanFrontAndBackMonotonicEndpointTime}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Prescan Sample Rate: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.PrescanSampleRate}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Zero Num(ns): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.PrescanZeroNum}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Generate Retry Count: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.PrescanGenerateRetryCount}" />
                            <Separator />
                            <hc:NumericUpDown hc:InfoElement.Title="Start Center Frequency(Mhz): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.StartPrescanCenterFrequency}" />
                            <hc:NumericUpDown hc:InfoElement.Title="End Center Frequency(Mhz): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.EndPrescanCenterFrequency}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Center Frequency Step(Mhz): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.StepPrescanCenterFrequency}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="Find"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button Content="Action"
                                        Command="{Binding Step2CalibrateActionCommand}"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button Content="Cancel"
                                        Command="{Binding Step2CalibrateActionCancelCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding ResultCalibrateDto.Items}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Height" Value="250" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="150"
                                            Header="Center Frequency"
                                            DisplayMemberBinding="{Binding PrescanCenterFrequency, StringFormat={}{0:0.###}}" />
                            <GridViewColumn Width="100"
                                            Header="Optics Mag"
                                            DisplayMemberBinding="{Binding OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Width="100"
                                            Header="Max Pixel"
                                            DisplayMemberBinding="{Binding DarkFieldImageProjectionYsMaxPixel}" />
                            <GridViewColumn Width="100"
                                            Header="Max Value"
                                            DisplayMemberBinding="{Binding DarkFieldImageProjectionYsMaxValue, StringFormat={}{0:0.###}}" />
                            <GridViewColumn Width="400" Header="Fouriers">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="400" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotMultiBehavior Title="Fouriers"
                                                                                d:DataContext="{d:DesignInstance Type=prescanChirpAodAlignment:LaserPrescanChirpAodAlignmentItemDto}"
                                                                                Plot0="{Binding PrescanFouriers}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="400" Header="Signals">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="400" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotMultiBehavior Title="Signals"
                                                                                d:DataContext="{d:DesignInstance Type=prescanChirpAodAlignment:LaserPrescanChirpAodAlignmentItemDto}"
                                                                                Plot0="{Binding PrescanSignals}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="400" Header="Channel3">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="400" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotMultiBehavior Title="Channel3"
                                                                                d:DataContext="{d:DesignInstance Type=prescanChirpAodAlignment:LaserPrescanChirpAodAlignmentItemDto}"
                                                                                Plot0="{Binding Channel3DarkFieldImageProjectionYs, Converter={StaticResource DoublesToPointsConverter}}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" Header="Channel3">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image d:DataContext="{d:DesignInstance Type=prescanChirpAodAlignment:LaserPrescanChirpAodAlignmentItemDto}" Source="{Binding Channel3ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="400" Header="Channel2">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="400" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotMultiBehavior Title="Channel2"
                                                                                d:DataContext="{d:DesignInstance Type=prescanChirpAodAlignment:LaserPrescanChirpAodAlignmentItemDto}"
                                                                                Plot0="{Binding Channel2DarkFieldImageProjectionYs, Converter={StaticResource DoublesToPointsConverter}}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" Header="Channel2">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image d:DataContext="{d:DesignInstance Type=prescanChirpAodAlignment:LaserPrescanChirpAodAlignmentItemDto}" Source="{Binding Channel2ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="400" Header="Channel1">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <wpf:WpfPlot Width="400" Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:WpfPlotMultiBehavior Title="Channel1"
                                                                                d:DataContext="{d:DesignInstance Type=prescanChirpAodAlignment:LaserPrescanChirpAodAlignmentItemDto}"
                                                                                Plot0="{Binding Channel1DarkFieldImageProjectionYs, Converter={StaticResource DoublesToPointsConverter}}" />
                                            </i:Interaction.Behaviors>
                                        </wpf:WpfPlot>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="200" Header="Channel1">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image d:DataContext="{d:DesignInstance Type=prescanChirpAodAlignment:LaserPrescanChirpAodAlignmentItemDto}" Source="{Binding Channel1ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="1" Height="5" />
                <Border Grid.Row="2"
                        Padding="0"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        IsEnabled="{Binding Step1CalibrateActionCommand.IsRunning, Converter={StaticResource BoolNegationConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <wpf:WpfPlot>
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="Result"
                                                                Plot0="{Binding ResultCalibrateDto.ItemPoints}"
                                                                Plot0Title="Origin"
                                                                Plot1="{Binding ResultCalibrateDto.ItemFitPoints}"
                                                                Plot1Title="Fit" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                        <wpf:WpfPlot Grid.Column="1">
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="Fouriers" Plot0="{Binding ResultCalibrateDto.PrescanFouriers}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                        <wpf:WpfPlot Grid.Column="2">
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotMultiBehavior Title="Signals" Plot0="{Binding ResultCalibrateDto.PrescanSignals}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>