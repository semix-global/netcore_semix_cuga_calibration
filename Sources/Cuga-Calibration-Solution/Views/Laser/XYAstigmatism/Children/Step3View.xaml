<UserControl x:Class="CugaCalibration.Views.Laser.XYAstigmatism.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mag="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Laser.XYAstigmatism;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXYAstigmatismCalibrationViewModel}"
             d:DesignHeight="850"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="XY Astigmatism Step 4: "
                           Status="{Binding CalibrationStepList[4].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="1.Find EcsY Param"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:TextBox Text="{Binding Cache.Item.EcsXInitial}"
                                    hc:TitleElement.TitleWidth="180"
                                    hc:InfoElement.Title="Find X Optimum Ecs: "
                                    hc:InfoElement.TitlePlacement="Left"
                                    Style="{StaticResource TextBoxExtend}"
                                    IsReadOnly="True" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Upper Limit: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.EcsYPositionUpper}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Lower Limit: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.EcsYPositionLower}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Interval: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="{Binding ElementName=Threshold, Path=Value}"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.EcsYInterval}" />
                        <hc:NumericUpDown x:Name="Threshold"
                                          hc:InfoElement.Title="Threshold: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.Threshold}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Axis Center ECS Y: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="4500"
                                          Maximum="8500"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.EcsYInitial}" />
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="2.Chirp AOD Wave Param"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding Cache.Item.ChirpAodDefaultDto.SpectralDensity, Mode=OneWay, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="AOD Default Frequency ChangeRate: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="AOD Start RateChange: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find AOD Start RateChange:"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.StartSpectralDensity}" />

                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Chirp AOD IncreaseInterval: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="-100"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.IncreaseInterval}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Chirp AOD IncreaseCount: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.IncreaseCount}" />
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="2. Find Result"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.EcsX, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Find X ECS: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.EcsY, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Find Y ECS: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.EcsErrorValue, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="ECS Error: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.SpectralDensity, Mode=OneWay, StringFormat={}{0:f3}}"
                                 hc:InfoElement.Title="Find AOD Frequency RateChange: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step3CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step3CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Row="2" Grid.Column="2">
            <GroupBox Header="History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" />
                        <RowDefinition Height="5*" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0"
                              d:SelectedIndex="0"
                              ItemsSource="{Binding LaserXyAstigmatismItemDtoList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="50"
                                                Header="Index"
                                                DisplayMemberBinding="{Binding Index}" />
                                <GridViewColumn Width="120"
                                                Header="OpticsMagType"
                                                DisplayMemberBinding="{Binding ProductivityInformation, Converter={StaticResource EnumDescriptionConverter}}" />
                                <GridViewColumn Width="150"
                                                Header="Frequency Increment"
                                                DisplayMemberBinding="{Binding SpectralDensity, Mode=OneWay, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="EcsX"
                                                DisplayMemberBinding="{Binding EcsX, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="EcsY"
                                                DisplayMemberBinding="{Binding EcsY, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="QualityX"
                                                DisplayMemberBinding="{Binding QualityX, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="QualityY"
                                                DisplayMemberBinding="{Binding QualityY, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="200" Header="Action Review">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:ButtonGroup>
                                                <Button Content="Image"
                                                        Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding FilePath}"
                                                        d:DataContext="{d:DesignInstance Type=coreModels:LaserXYAstigmatismCalibrationItemDto}" />
                                            </hc:ButtonGroup>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TabControl x:Name="TabControlDetails" Grid.Row="1">
                        <!-- <TabItem Header="Action Details Result"> -->
                        <!--  <Border Padding="0"  -->
                        <!--  Style="{StaticResource BorderRegion}"  -->
                        <!--  Effect="{StaticResource EffectShadow1}">  -->
                        <!--         <wpf:WpfPlot x:Name="WpfPlotResultDtoListOfWindow" Margin="5" /> -->
                        <!--     </Border> -->
                        <!-- </TabItem> -->
                        <TabItem Header="Ecs Quality List">
                            <Border Padding="0"
                                    Style="{StaticResource BorderRegion}"
                                    Effect="{StaticResource EffectShadow1}">
                                <wpf:WpfPlot>
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="Focus"
                                                                        Plot0Title="Quality"
                                                                        Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                                        Plot0="{Binding EcsQualityList}" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                            </Border>
                        </TabItem>
                        <TabItem Header="Frequency Ecs List">
                            <Border Padding="0"
                                    Style="{StaticResource BorderRegion}"
                                    Effect="{StaticResource EffectShadow1}">
                                <wpf:WpfPlot>
                                    <i:Interaction.Behaviors>
                                        <behaviors:WpfPlotMultiBehavior Title="History"
                                                                        Plot0Title="Ecs"
                                                                        Plot0Color="{x:Static scottPlot:Colors.Blue}"
                                                                        Plot0="{Binding FrequencyEcsList}" />
                                    </i:Interaction.Behaviors>
                                </wpf:WpfPlot>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>