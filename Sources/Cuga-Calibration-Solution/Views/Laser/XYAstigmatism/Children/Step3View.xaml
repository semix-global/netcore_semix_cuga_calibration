<UserControl x:Class="CugaCalibration.Views.Laser.XYAstigmatism.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mag="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Laser.XYAstigmatism;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXYAstigmatismCalibrationViewModel}"
             d:DesignHeight="850"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="XY Astigmatism Step 4: "
                           Status="{Binding CalibrationStepList[4].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="OpticsMagType: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Find Focus Position: "
                           Color="{StaticResource SuccessBrush}">
                    <hc:Shield.Style>
                        <Style BasedOn="{StaticResource ShieldBaseStyle}" TargetType="hc:Shield">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                    <Setter Property="Status" Value="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                    <Setter Property="Status" Value="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                    <Setter Property="Status" Value="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:Shield.Style>
                </hc:Shield>
            </hc:UniformSpacingPanel>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="1.Find EcsY Param"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:TextBox hc:TitleElement.TitleWidth="180"
                                    hc:InfoElement.Title="Find X Optimum Ecs: "
                                    hc:InfoElement.TitlePlacement="Left"
                                    IsReadOnly="True">
                            <hc:TextBox.Style>
                                <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="hc:TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Text" Value="{Binding Cache.EcsXLowInitial}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Text" Value="{Binding Cache.EcsXMidInitial}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Text" Value="{Binding Cache.EcsXHighInitial}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:TextBox.Style>
                        </hc:TextBox>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Upper Limit: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYPositionUpperLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYPositionUpperMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYPositionUpperHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Lower Limit: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYPositionLowerLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYPositionLowerMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYPositionLowerHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Interval: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="{Binding ElementName=threshold, Path=Value}">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYIntervalLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYIntervalMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYIntervalHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown x:Name="threshold"
                                          hc:InfoElement.Title="Threshold: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.TitlePlacement="Left"
                                          Minimum="0">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.ThresholdLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.ThresholdMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.ThresholdHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Axis Center ECS Y: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="4500"
                                          Maximum="8500">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYLowInitial}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYMidInitial}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsYHighInitial}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="2.Chirp AOD Wave Param"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="AOD Center Frequence:"
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.CenterFrequenceLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.CenterFrequenceMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.CenterFrequenceHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="auto"
                                          hc:InfoElement.Title="AOD Sound Package Length:"
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.SoundPackageLengthLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.SoundPackageLengthMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.SoundPackageLengthHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Zero Count: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.ZeroNumLowY}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.ZeroNumMiddleY}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.ZeroNumHighY}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <TextBox Text="{Binding Cache.RegNum}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Register Count: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="AOD Start RateChange: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find AOD Start RateChange:"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="0">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.DefaultAodFrequenceLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.DefaultAodFrequenceMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.DefaultAodFrequenceHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <!--<hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value"
                                                    Value="{Binding Cache.RegNumLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.RegNumMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.RegNumHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>-->
                        <!--</hc:NumericUpDown>-->

                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Chirp AOD IncreaseInterval: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="-100">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.IncreaseIntervalLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.IncreaseIntervalMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.IncreaseIntervalHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Chirp AOD IncreaseCount: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.IncreaseCountLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.IncreaseCountMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.IncreaseCountHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="2. Find Result"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.QualityX, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Find X Optimum Quality: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.QualityY, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Find Y Optimum Quality: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.EcsX, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Find X ECS: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.EcsY, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Find Y ECS: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.EcsErrorValue, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="Find ECS Error: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectedLaserXyAstigmatismItemDto.FrequenceIncrease, StringFormat={}{0:f3}}"
                                 hc:InfoElement.Title="Find AOD Frequence RateChange: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step3CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step3CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Row="2" Grid.Column="2">
            <GroupBox Header="History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="2.5*" />
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0"
                              d:SelectedIndex="0"
                              ItemsSource="{Binding LaserXyAstigmatismItemDtoList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <!--  SelectedItem="{Binding SelectedlaserXYAstigmatismItemDto, Mode=OneWay}"  -->
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="50"
                                                Header="Index"
                                                DisplayMemberBinding="{Binding Index}" />
                                <GridViewColumn Width="120"
                                                Header="OpticsMagType"
                                                DisplayMemberBinding="{Binding OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                <GridViewColumn Width="150"
                                                Header="Frequence Increment"
                                                DisplayMemberBinding="{Binding FrequenceIncrease, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="EcsX"
                                                DisplayMemberBinding="{Binding EcsX, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="EcsY"
                                                DisplayMemberBinding="{Binding EcsY, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="QualityX"
                                                DisplayMemberBinding="{Binding QualityX, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="80"
                                                Header="QualityY"
                                                DisplayMemberBinding="{Binding QualityY, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="200" Header="Action Review">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:ButtonGroup>
                                                <Button Content="Image"
                                                        Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding FilePath}"
                                                        d:DataContext="{d:DesignInstance Type=coreModels:LaserXYAstigmatismCalibrationItemDto}" />
                                            </hc:ButtonGroup>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <GridSplitter Grid.Row="1" Height="5" />
                    <TabControl x:Name="TabControlDetails" Grid.Row="3">
                        <TabItem Header="Action Details Result">
                            <Border Padding="0"
                                    Style="{StaticResource BorderRegion}"
                                    Effect="{StaticResource EffectShadow1}"
                                    IsEnabled="{Binding Cache.IsGetWindow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <wpf:WpfPlot x:Name="WpfPlotResultDtoListOfWindow" Margin="5" />
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="Generate Chirp Aod Wave Details">
                            <Border Padding="0"
                                    Style="{StaticResource BorderRegion}"
                                    Effect="{StaticResource EffectShadow1}"
                                    IsEnabled="{Binding Cache.IsGetWindow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <wpf:WpfPlot x:Name="WpfPlotAodWaveSignalListOfWindow" Margin="5" />
                                    <wpf:WpfPlot x:Name="WpfPlotAodWaveSignalFourierListOfWindow" Grid.Column="1"
                                                 Margin="5" />
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </GroupBox>
            <ToggleButton x:Name="ToggleButton"
                          Content="Function Image"
                          Margin="3.5"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          hc:IconElement.Geometry="{StaticResource AllGeometry}"
                          Style="{StaticResource ToggleButtonDefault.Small}" />
            <Popup StaysOpen="False"
                   PlacementTarget="{Binding ElementName=ToggleButton}"
                   Placement="Top"
                   AllowsTransparency="True"
                   PopupAnimation="Slide"
                   IsOpen="{Binding IsChecked, ElementName=ToggleButton, Mode=TwoWay}">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot Width="500" Height="400">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="ECS" Plot0="{Binding EcsList}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </Popup>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>