<UserControl x:Class="CugaCalibration.Views.Laser.XYAstigmatism.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mag="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXYAstigmatismCalibrationViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="XY Astigmatism Step 2: "
                           Status="{Binding CalibrationStepList[2].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeMagnificationInfo, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <!--<hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <ItemsControl Grid.Row="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type microscope:MicroscopeMagnificationEnum}}}">
                    <i:Interaction.Behaviors>
                        <behaviors:RadioButtonSelectedItemBehavior SelectedItem="{Binding Cache.MicroscopeMagnificationEnum, Mode=TwoWay}" />
                    </i:Interaction.Behaviors>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                                         Command="{Binding DataContext.SwitchMagnificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}"
                                         FontSize="15"
                                         Tag="{Binding}"
                                         GroupName="67fa1ece-8b12-4ec1-9443-078bb25af07b" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </hc:UniformSpacingPanel>-->
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Find Focus Position"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <!--  Text="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"  -->
                    <hc:ComboBox x:Name="MagCombobox"
                                 Width="275"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="High Magnification: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.MicroscopeMagnificationInfo}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeMagnificationInfoList}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MicroscopeMagnificationName}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding MagnificationSelectedCommand}" CommandParameter="{Binding ElementName=MagCombobox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                    <TextBox Width="275"
                             hc:InfoElement.Title="Position(um): "
                             hc:InfoElement.TitlePlacement="Left">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                        <Setter Property="Text" Value="{Binding Cache.FindPositionLow, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                        <Setter Property="Text" Value="{Binding Cache.FindPositionMiddle, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                        <Setter Property="Text" Value="{Binding Cache.FindPositionHigh, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification5X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindPosition5X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification10X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindPosition10X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification50X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindPosition50X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification100X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindPosition100X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification150X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindPosition150X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>-->
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <UniformGrid Width="275">
                        <hc:UniformSpacingPanel Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step1CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                        </hc:UniformSpacingPanel>
                    </UniformGrid>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
    </Grid>
</UserControl>