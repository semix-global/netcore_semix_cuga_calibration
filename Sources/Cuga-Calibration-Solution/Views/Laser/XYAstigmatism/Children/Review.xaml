<UserControl x:Class="CugaCalibration.Views.Laser.XYAstigmatism.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Laser.XYAstigmatism;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mag="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXYAstigmatismCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="XY Astigmatism: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown hc:InfoElement.Title="Threshold: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectReviewItemDto.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                        <Setter Property="Value" Value="{Binding Cache.ThresholdLowReview}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectReviewItemDto.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                        <Setter Property="Value" Value="{Binding Cache.ThresholdMiddleReview}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectReviewItemDto.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                        <Setter Property="Value" Value="{Binding Cache.ThresholdHighReview}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <TextBox Text="{Binding ChirpAodReviewSelectDto.RateChange, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="AOD Frequence: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ChirpAodReviewSelectDto.SoundPackageLength, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="AOD Package Length: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultReviewItemDto.QualityX, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Result X Max Quality: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultReviewItemDto.QualityY, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Result Y Max Quality: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultReviewItemDto.EcsX, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Result X ECS: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultReviewItemDto.EcsY, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Result Y ECS: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultReviewItemDto.EcsErrorValue, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Result ECS Error: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <GroupBox Grid.Row="2" Grid.Column="2"
                  Header="Calibration Data">
            <ListView d:SelectedIndex="0"
                      ItemsSource="{Binding ReviewList}"
                      Style="{StaticResource ListView.Small}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectedItem="{Binding SelectReviewItemDto}">
                <i:Interaction.Behaviors>
                    <behaviors:ListBoxScrollToCurrentBehavior />
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="120"
                                        Header="OpticsMagType"
                                        DisplayMemberBinding="{Binding OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                        <GridViewColumn Width="100"
                                        Header="Microscope"
                                        DisplayMemberBinding="{Binding MicroscopeMagnificationEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                        <GridViewColumn Width="150"
                                        Header="Frequence Increment"
                                        DisplayMemberBinding="{Binding FrequenceIncrease, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="80"
                                        Header="EcsX"
                                        DisplayMemberBinding="{Binding EcsX, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="80"
                                        Header="EcsY"
                                        DisplayMemberBinding="{Binding EcsY, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="80"
                                        Header="QualityX"
                                        DisplayMemberBinding="{Binding QualityX, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="80"
                                        Header="QualityY"
                                        DisplayMemberBinding="{Binding QualityY, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="200" Header="Action Review">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ButtonGroup>
                                        <Button Content="Image"
                                                Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding FilePath}"
                                                d:DataContext="{d:DesignInstance Type=coreModels:LaserXYAstigmatismCalibrationItemDto}" />
                                    </hc:ButtonGroup>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>