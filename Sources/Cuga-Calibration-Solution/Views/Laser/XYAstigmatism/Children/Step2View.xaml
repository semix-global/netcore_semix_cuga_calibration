<UserControl x:Class="CugaCalibration.Views.Laser.XYAstigmatism.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mag="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:enumAlgorithm="clr-namespace:Net.Utilities.Models.Enums.Maths;assembly=Net.Utilities.Models"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:focus="clr-namespace:Core.Models.Models.Microscope.Focus;assembly=Core.Models"
             xmlns:scottplot="http://schemas.scottplot.net/2008/xaml/presentation"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXYAstigmatismCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="XY Astigmatism Step 3: "
                           Status="{Binding CalibrationStepList[3].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="OpticsMagType: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Find Focus Position: "
                           Color="{StaticResource SuccessBrush}">
                    <hc:Shield.Style>
                        <Style BasedOn="{StaticResource ShieldBaseStyle}" TargetType="hc:Shield">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                    <Setter Property="Status" Value="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                    <Setter Property="Status" Value="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                    <Setter Property="Status" Value="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:Shield.Style>
                </hc:Shield>
            </hc:UniformSpacingPanel>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="1. Chirp AOD Param"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <Expander Header="Frequency(MHz)"
                                  IsExpanded="False"
                                  ExpandDirection="Down">
                            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                                      hc:InfoElement.Title="Sound Package Length: "
                                                      hc:InfoElement.Necessary="True"
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      Minimum="1">
                                        <hc:NumericUpDown.Style>
                                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.SoundPackageLength}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.SoundPackageLength}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.SoundPackageLength}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:NumericUpDown.Style>
                                    </hc:NumericUpDown>
                                    <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                                      hc:InfoElement.Title="Band Width: "
                                                      hc:InfoElement.Necessary="True"
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      Minimum="1">
                                        <hc:NumericUpDown.Style>
                                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.BandWidth}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.BandWidth}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.BandWidth}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:NumericUpDown.Style>
                                    </hc:NumericUpDown>

                                    <hc:ComboBox hc:InfoElement.Title="Monotonic: "
                                                 hc:InfoElement.TitlePlacement="Left"
                                                 hc:InfoElement.TitleWidth="180"
                                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:FunctionMonotonicTypeEnum}}}">
                                        <hc:ComboBox.Style>
                                            <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="LightGray" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="SelectedItem" Value="{Binding Cache.LowChirpAodDefaultDto.FunctionMonotonicTypeEnum}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="SelectedItem" Value="{Binding Cache.MiddleChirpAodDefaultDto.FunctionMonotonicTypeEnum}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="SelectedItem" Value="{Binding Cache.HighChirpAodDefaultDto.FunctionMonotonicTypeEnum}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:ComboBox.Style>
                                        <hc:ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                            </DataTemplate>
                                        </hc:ComboBox.ItemTemplate>
                                    </hc:ComboBox>
                                    <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                                      hc:InfoElement.Title="Center Frequency: "
                                                      hc:InfoElement.Necessary="True"
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      Minimum="1">
                                        <hc:NumericUpDown.Style>
                                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.CenterFrequency}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.CenterFrequency}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.CenterFrequency}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:NumericUpDown.Style>
                                    </hc:NumericUpDown>
                                    <TextBox hc:TitleElement.TitleWidth="180"
                                             hc:InfoElement.Title="AOD Default Frequency ChangeRate: "
                                             hc:InfoElement.TitlePlacement="Left"
                                             IsReadOnly="True">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Text" Value="{Binding Cache.LowChirpAodDefaultDto.FrequencyChangeRate, Mode=OneWay, StringFormat={}{0:f3}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Text" Value="{Binding Cache.MiddleChirpAodDefaultDto.FrequencyChangeRate, Mode=OneWay, StringFormat={}{0:f3}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Text" Value="{Binding Cache.HighChirpAodDefaultDto.FrequencyChangeRate, Mode=OneWay, StringFormat={}{0:f3}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Expander>
                        <Expander Header="Others"
                                  IsExpanded="False"
                                  ExpandDirection="Down">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                                      hc:InfoElement.Title="SampleRate(Msa/s): "
                                                      hc:InfoElement.Necessary="True"
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:InfoElement.ShowClearButton="True"
                                                      Minimum="1">
                                        <hc:NumericUpDown.Style>
                                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.SampleRate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.SampleRate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.SampleRate}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:NumericUpDown.Style>
                                    </hc:NumericUpDown>
                                    <hc:NumericUpDown hc:InfoElement.Title="Amplitude: "
                                                      hc:InfoElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="180"
                                                      Maximum="1"
                                                      Minimum="0">
                                        <hc:NumericUpDown.Style>
                                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.Amplitude}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.Amplitude}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.Amplitude}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:NumericUpDown.Style>
                                    </hc:NumericUpDown>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Expander>
                        <Expander Header="Compensation"
                                  IsExpanded="False"
                                  ExpandDirection="Down">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <TextBox hc:InfoElement.Title="Sinc Compensation: "
                                             hc:InfoElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="240">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Text" Value="{Binding Cache.LowChirpAodDefaultDto.SincCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Text" Value="{Binding Cache.MiddleChirpAodDefaultDto.SincCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Text" Value="{Binding Cache.HighChirpAodDefaultDto.SincCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Slider VerticalAlignment="Center"
                                            Minimum="0"
                                            Maximum="10">
                                        <Slider.Style>
                                            <Style TargetType="Slider">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.SincCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.SincCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.SincCoefficient}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>
                                    <TextBox hc:InfoElement.Title="Astigmatism Compensation: "
                                             hc:InfoElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="240">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Text" Value="{Binding Cache.LowChirpAodDefaultDto.AstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Text" Value="{Binding Cache.MiddleChirpAodDefaultDto.AstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Text" Value="{Binding Cache.HighChirpAodDefaultDto.AstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Slider VerticalAlignment="Center"
                                            Minimum="-100"
                                            Maximum="100">
                                        <Slider.Style>
                                            <Style TargetType="Slider">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.AstigmatismCompensationCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.AstigmatismCompensationCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.AstigmatismCompensationCoefficient}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>
                                    <TextBox hc:InfoElement.Title="Spherical Aberration Compensation: "
                                             hc:InfoElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="240">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Text" Value="{Binding Cache.LowChirpAodDefaultDto.SphericalAberrationCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Text" Value="{Binding Cache.MiddleChirpAodDefaultDto.SphericalAberrationCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Text" Value="{Binding Cache.HighChirpAodDefaultDto.SphericalAberrationCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Slider VerticalAlignment="Center"
                                            Minimum="-100"
                                            Maximum="100">
                                        <Slider.Style>
                                            <Style TargetType="Slider">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.SphericalAberrationCompensationCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.SphericalAberrationCompensationCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.SphericalAberrationCompensationCoefficient}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>
                                    <TextBox hc:InfoElement.Title="Secondary Astigmatism Compensation: "
                                             hc:InfoElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="240">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Text" Value="{Binding Cache.LowChirpAodDefaultDto.SecondaryAstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Text" Value="{Binding Cache.MiddleChirpAodDefaultDto.SecondaryAstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Text" Value="{Binding Cache.HighChirpAodDefaultDto.SecondaryAstigmatismCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Slider VerticalAlignment="Center"
                                            Minimum="-100"
                                            Maximum="100">
                                        <Slider.Style>
                                            <Style TargetType="Slider">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.SecondaryAstigmatismCompensationCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.SecondaryAstigmatismCompensationCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.SecondaryAstigmatismCompensationCoefficient}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>
                                    <TextBox hc:InfoElement.Title="Coma Compensation: "
                                             hc:InfoElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="240">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Text" Value="{Binding Cache.LowChirpAodDefaultDto.ComaCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Text" Value="{Binding Cache.MiddleChirpAodDefaultDto.ComaCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Text" Value="{Binding Cache.HighChirpAodDefaultDto.ComaCompensationCoefficient, StringFormat={}{0:0.###############}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Slider VerticalAlignment="Center"
                                            Minimum="-100"
                                            Maximum="100">
                                        <Slider.Style>
                                            <Style TargetType="Slider">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                                        <Setter Property="Value" Value="{Binding Cache.LowChirpAodDefaultDto.ComaCompensationCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                                        <Setter Property="Value" Value="{Binding Cache.MiddleChirpAodDefaultDto.ComaCompensationCoefficient}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                                        <Setter Property="Value" Value="{Binding Cache.HighChirpAodDefaultDto.ComaCompensationCoefficient}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>
                                    <TextBox hc:InfoElement.Title="Trefoil Compensation:  "
                                             hc:InfoElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="240">
