<UserControl x:Class="CugaCalibration.Views.Laser.XYAstigmatism.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:scottplot="http://schemas.scottplot.net/2008/xaml/presentation"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:generates="clr-namespace:Core.Models.Models.Common.AODWaveform.UI.Generates;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXYAstigmatismCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="XY Astigmatism Step 3: "
                           Status="{Binding CalibrationStepList[3].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="1. Chirp AOD Param"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <generates:GenerateChirpAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                            IsVisibleDirectoryPath="False"
                                                                            IsVisibleElectrodeConfiguration="False"
                                                                            DataContext="{Binding Cache.Item.ChirpAodDefaultDto}" />
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="2. Ecs Param"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Upper Limit: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.EcsPositionUpper}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Lower Limit: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.EcsPositionLower}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Interval: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="100"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.EcsInterval}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Find Initial ECS X: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="4500"
                                          Maximum="8500"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.EcsXInitial}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step2CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step2CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
        </hc:UniformSpacingPanel>

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}">
                    <scottplot:WpfPlot>
                        <b:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="History"
                                                            Plot0Title="Quality"
                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                            Plot0="{Binding EcsQualityList}" />
                        </b:Interaction.Behaviors>
                    </scottplot:WpfPlot>
                </Border>
            </Grid>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>