<UserControl x:Class="CugaCalibration.Views.Laser.XYAstigmatism.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mag="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserXYAstigmatismCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="XY Astigmatism Step 3: "
                           Status="{Binding CalibrationStepList[3].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="OpticsMagType: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Find Focus Position: "
                           Color="{StaticResource SuccessBrush}">
                    <hc:Shield.Style>
                        <Style BasedOn="{StaticResource ShieldBaseStyle}" TargetType="hc:Shield">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                    <Setter Property="Status" Value="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                    <Setter Property="Status" Value="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                    <Setter Property="Status" Value="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:Shield.Style>
                </hc:Shield>
            </hc:UniformSpacingPanel>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="1. Chirp AOD Param"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">

                        <hc:ButtonGroup Width="auto">
                            <Button Content="Load Default AOD Wave File"
                                    Command="{Binding ChangeChirpAodFileCommand}"
                                    CommandParameter="TemplateFilePath2"
                                    Margin="-1,0,0,0"
                                    VerticalAlignment="Top" />
                        </hc:ButtonGroup>
                        <TextBox Text="{Binding ChirpAodDefaultDto.SoundPackageLength, Mode=OneWay, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="auto"
                                 hc:InfoElement.Title="AOD Default Sound Package Length: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />

                        <TextBox Text="{Binding ChirpAodDefaultDto.RateChange, Mode=OneWay, StringFormat={}{0:f3}}"
                                 hc:TitleElement.TitleWidth="180"
                                 hc:InfoElement.Title="AOD Default RateChange: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:NumericUpDown hc:InfoElement.Title="SampleRate(Msa/s): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="180"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.SampleRate}" />
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Zero Count: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.ZeroNumLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.ZeroNumMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.ZeroNumHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
            <Expander HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsEnabled="True"
                      IsExpanded="True"
                      ExpandDirection="Down"
                      BorderThickness="2"
                      BorderBrush="Green">
                <Expander.Header>
                    <TextBlock Text="2. Ecs Param"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </Expander.Header>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Upper Limit: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsPositionUpperLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsPositionUpperMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsPositionUpperHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Lower Limit: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsPositionLowerLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsPositionLowerMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsPositionLowerHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Z Interval: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="1"
                                          Maximum="100">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsIntervalLow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsIntervalMiddle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsIntervalHigh}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                          hc:InfoElement.Title="Find Initial ECS X: "
                                          hc:InfoElement.Necessary="True"
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.Placeholder="Input Find Focus Offset"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="4500"
                                          Maximum="8500">
                            <hc:NumericUpDown.Style>
                                <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Low}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsXLowInitial}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.Middle}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsXMidInitial}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static mag:OpticsMagTypeEnum.High}">
                                            <Setter Property="Value" Value="{Binding Cache.EcsXHighInitial}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:UniformSpacingPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step2CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step2CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </Expander>
        </hc:UniformSpacingPanel>
    </Grid>
</UserControl>