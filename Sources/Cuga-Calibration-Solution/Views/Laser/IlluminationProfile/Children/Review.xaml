<UserControl x:Class="CugaCalibration.Views.Laser.IlluminationProfile.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:illuminationProfile="clr-namespace:Core.Models.Models.Laser.IlluminationProfile;assembly=Core.Models"
             xmlns:laser="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=laser:LaserIlluminationProfileCalibrationViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Illumination Profile: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Threshold: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Value="{Binding Cache.VerifyThreshold}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Threshold Rate Min: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      IsReadOnly="True"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyThresholdDarkFieldImageListRateMin, Mode=OneWay}" />
                    <hc:NumericUpDown Width="275"
                                      hc:InfoElement.Title="Threshold Rate Max: "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      IsReadOnly="True"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyThresholdDarkFieldImageListRateMax, Mode=OneWay}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="Calibration Data">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <ListView d:SelectedIndex="0"
                              ItemsSource="{Binding ReviewList}"
                              SelectedItem="{Binding SelectReviewItemDto}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="100"
                                                Header="Coefficient"
                                                DisplayMemberBinding="{Binding LaserLightInformation}" />
                                <GridViewColumn Width="100"
                                                Header="Productivity Information"
                                                DisplayMemberBinding="{Binding ProductivityInformation}" />
                                <GridViewColumn Width="100"
                                                Header="Rate Min"
                                                DisplayMemberBinding="{Binding DarkFieldImageListRateMin, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100"
                                                Header="Rate Max"
                                                DisplayMemberBinding="{Binding DarkFieldImageListRateMax, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100"
                                                Header="P Power"
                                                DisplayMemberBinding="{Binding PolarizationPPower, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100"
                                                Header="S Power"
                                                DisplayMemberBinding="{Binding PolarizationSPower, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100"
                                                Header="C Power"
                                                DisplayMemberBinding="{Binding PolarizationCPower, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="400" Header="Action Review">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:ButtonGroup>
                                                <Button Content="Image"
                                                        Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Channel3ImageFilePath}"
                                                        d:DataContext="{d:DesignInstance Type=illuminationProfile:LaserIlluminationProfileItemDto}" />
                                                <Button Content="Image List"
                                                        Command="{Binding Path=DataContext.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Channel3DarkFieldImageList}"
                                                        d:DataContext="{d:DesignInstance Type=illuminationProfile:LaserIlluminationProfileItemDto}" />
                                                <Button Content="Prescan Rate"
                                                        Command="{Binding Path=DataContext.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding PrescanRateList}"
                                                        d:DataContext="{d:DesignInstance Type=illuminationProfile:LaserIlluminationProfileItemDto}" />
                                                <Button Content="OutPut"
                                                        Command="{Binding Path=DataContext.SavePrescanAodWaveCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding .}"
                                                        d:DataContext="{d:DesignInstance Type=illuminationProfile:LaserIlluminationProfileItemDto}" />
                                            </hc:ButtonGroup>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>