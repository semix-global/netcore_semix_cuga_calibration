<UserControl x:Class="CugaCalibration.Views.Laser.IlluminationProfile.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserIlluminationProfileCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Illumination Profile Step 4: "
                           Status="{Binding CalibrationStepList[4].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Mag: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Coefficient: "
                           Status="{Binding Cache.Coefficient, StringFormat={}{0:f3}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="Param "
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <TextBox Text="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.PrescanFilePath}"
                                     Height="50"
                                     TextWrapping="Wrap"
                                     hc:InfoElement.Title="FileName : "
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.TitlePlacement="Left"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource TextBoxExtend}" />
                            <Button Content="Change" Command="{Binding ChangePrescanFileCommand}" />
                            <Separator />
                            <hc:NumericUpDown hc:InfoElement.Title="Servings: "
                                              hc:TitleElement.TitleWidth="90"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.Servings}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Prescan Max Start Index: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MaxWindowStartIndex}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Prescan Min Start Index: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MinWindowStartIndex}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Window To Min Amount: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.WindowToMinAmount}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Judge Y Start Index: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="100"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.JudgeWindowStartIndex}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Judge Y End Index: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="100"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.JudgeWindowEndIndex}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                    <StackPanel>
                        <TextBlock Text="2. Find Window"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MaxWindowDarkImageListMinIndex}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Max Window Min Index: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MinWindowDarkImageListMinIndex}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Min Window Min Index: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.T1}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="T1: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.PrescanStartIndex}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Start Index: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.PrescanEndIndex}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="End Index: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step3CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step3CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                        <Button Content="Clear Result"
                                Command="{Binding Step3CalibrateClearCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonDanger}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <Border Padding="0"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding Step3CalibrateActionCommand.IsRunning, Converter={StaticResource BoolNegationConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <wpf:WpfPlot Margin="5">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="Dark Field Image List of Window"
                                                            Plot0Title="Min Scatter"
                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                            Plot0="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MinScatterDarkFieldImageList, Converter={StaticResource DoublesToPointsConverter}}"
                                                            Plot1Title="Max Scatter"
                                                            Plot1Color="{x:Static scottPlot:Colors.Red}"
                                                            Plot1="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MaxScatterDarkFieldImageList, Converter={StaticResource DoublesToPointsConverter}}"
                                                            Plot2Title="Min Smooth"
                                                            Plot2Color="{x:Static scottPlot:Colors.DarkGreen}"
                                                            Plot2="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MinSmoothDarkFieldImageList, Converter={StaticResource DoublesToPointsConverter}}"
                                                            Plot3Title="Max Smooth"
                                                            Plot3Color="{x:Static scottPlot:Colors.DarkRed}"
                                                            Plot3="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MaxSmoothDarkFieldImageList, Converter={StaticResource DoublesToPointsConverter}}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                    <wpf:WpfPlot Grid.Row="0" Grid.Column="1"
                                 Margin="5">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="Prescan List of Window"
                                                            Plot0Title="Min"
                                                            Plot0Color="{x:Static scottPlot:Colors.DarkGreen}"
                                                            Plot0="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MinWindowPrescanList, Converter={StaticResource DoublesToPointsConverter}}"
                                                            Plot1Title="Max"
                                                            Plot1Color="{x:Static scottPlot:Colors.DarkRed}"
                                                            Plot1="{Binding Cache.CurrentDarkFieldImageListToPrescanListCacheItem.MaxWindowPrescanList, Converter={StaticResource DoublesToPointsConverter}}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Grid>
            </Border>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>