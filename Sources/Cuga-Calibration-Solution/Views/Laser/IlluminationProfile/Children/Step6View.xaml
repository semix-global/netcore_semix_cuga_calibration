<UserControl x:Class="CugaCalibration.Views.Laser.IlluminationProfile.Children.Step6View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:illuminationProfile="clr-namespace:Core.Models.Models.Laser.IlluminationProfile;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserIlluminationProfileCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Illumination Profile Step 7: "
                           Status="{Binding CalibrationStepList[7].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Mag: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Coefficient: "
                           Status="{Binding Cache.Coefficient, StringFormat={}{0:f3}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:NumericUpDown hc:InfoElement.Title="Judge Skip Cout: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentCalibrationCacheItem.JudgeDarkFieldImageListRateSkipCout}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Image (Max - Min) Threshold: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="100"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.DarkImageListRangeThreshold}" />
                            <Separator />
                            <hc:NumericUpDown hc:InfoElement.Title="Repeat Count: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentCalibrationCacheItem.RepeatCount}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Wait P S C Power Time(s): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.WaitTime}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Coefficient Limit: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0"
                                              Maximum="10"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentCalibrationCacheItem.CoefficientLimit}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Repeat Coefficient Interval: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="0.001"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CurrentCalibrationCacheItem.RepeatCoefficientInterval}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Threshold: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Minimum="0"
                                              Value="{Binding Cache.CalibrateThreshold}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Threshold Rate Min: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              IsReadOnly="True"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CalibrateThresholdDarkFieldImageListRateMin, Mode=OneWay}" />
                            <hc:NumericUpDown hc:InfoElement.Title="Threshold Rate Max: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              IsReadOnly="True"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.CalibrateThresholdDarkFieldImageListRateMax, Mode=OneWay}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="Find"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding IlluminationCoefficientLimitMin, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Coefficient Limit Min: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding IlluminationCoefficientLimitMax, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Coefficient Limit Max: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding IlluminationTargetValue, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Target Value: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button Content="Action"
                                        Command="{Binding Step6CalibrateActionCommand}"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button Content="Cancel"
                                        Command="{Binding Step6CalibrateActionCancelCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding CalibrationLaserIlluminationProfileDtoList}"
                          Style="{StaticResource ListView.Small}"
                          SelectedItem="{Binding SelectCalibrateItemDto, Mode=OneWay}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="100"
                                            Header="Index"
                                            DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Width="100"
                                            Header="Coefficient"
                                            DisplayMemberBinding="{Binding Coefficient, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="Optics Mag"
                                            DisplayMemberBinding="{Binding OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Width="100"
                                            Header="Rate Min"
                                            DisplayMemberBinding="{Binding DarkFieldImageListRateMin, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="Rate Max"
                                            DisplayMemberBinding="{Binding DarkFieldImageListRateMax, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="P Power"
                                            DisplayMemberBinding="{Binding PolarizationPPower, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="S Power"
                                            DisplayMemberBinding="{Binding PolarizationSPower, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="C Power"
                                            DisplayMemberBinding="{Binding PolarizationCPower, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="400" Header="Action Review">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ButtonGroup>
                                            <Button Content="Image"
                                                    Command="{Binding Path=DataContext.ReviewImageCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ChannelImageFilePath}"
                                                    d:DataContext="{d:DesignInstance Type=illuminationProfile:LaserIlluminationProfileItemDto}" />
                                            <Button Content="Image List"
                                                    Command="{Binding Path=DataContext.ReviewPlotCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ChannelDarkFieldProjectYsList}"
                                                    d:DataContext="{d:DesignInstance Type=illuminationProfile:LaserIlluminationProfileItemDto}" />
                                            <Button Content="Prescan Rate"
                                                    Command="{Binding Path=DataContext.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding PrescanRateList}"
                                                    d:DataContext="{d:DesignInstance Type=illuminationProfile:LaserIlluminationProfileItemDto}" />
                                            <Button Content="OutPut"
                                                    Command="{Binding Path=DataContext.SavePrescanAodWaveCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding .}"
                                                    d:DataContext="{d:DesignInstance Type=illuminationProfile:LaserIlluminationProfileItemDto}" />
                                        </hc:ButtonGroup>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            <GridSplitter Grid.Row="1" />
            <TabControl x:Name="TabControl" Grid.Row="2"
                        TabStripPlacement="Bottom">
                <TabItem Header="Average Plot">
                    <Border Padding="0"
                            Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}">
                        <wpf:WpfPlot>
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotListBehavior Title="Average Plot" PlotList="{Binding PlotAverageList, Mode=OneWay}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Border>
                </TabItem>
                <TabItem Header="Prescan Plot">
                    <Border Padding="0"
                            Style="{StaticResource BorderRegion}"
                            Effect="{StaticResource EffectShadow1}">
                        <wpf:WpfPlot>
                            <i:Interaction.Behaviors>
                                <behaviors:WpfPlotListBehavior Title="Prescan Plot" PlotList="{Binding PlotPrescanList, Mode=OneWay}" />
                            </i:Interaction.Behaviors>
                        </wpf:WpfPlot>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
        <!--#region Right-->

        <!--#endregion-->
    </Grid>
</UserControl>