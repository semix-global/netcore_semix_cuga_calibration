<UserControl x:Class="CugaCalibration.Views.Laser.Attenuator.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserAttenuatorCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Attenuator Calibration Step 1: "
                           Status="{Binding CalibrationStepList[0].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Mag: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Attenuator Calibration"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding ResultLaserAttenuatorObjDto.StagePosition, Converter={StaticResource PointToStringConverter}}"
                             hc:InfoElement.Title="Position(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="180"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultLaserAttenuatorObjDto.InitialightIntensity, StringFormat={}{0}}"
                             hc:InfoElement.Title="Initial Light Intensity:"
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="180"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultLaserAttenuatorObjDto.LaserPowerMeterAverageIntensity, StringFormat={}{0}}"
                             hc:InfoElement.Title="Laser Power Intensity:"
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="180"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:NumericUpDown x:Name="IntervalNumeric"
                                      hc:InfoElement.Title="Interval(s): "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.WaitTime}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <wpf:WpfPlot>
                    <i:Interaction.Behaviors>
                        <behaviors:WpfPlotMultiBehavior Title="Data"
                                                        Plot0Title="origin"
                                                        Plot0="{Binding ResultLaserAttenuatorObjDto.CoefficientCurvePositions}"
                                                        Plot1Title="fit"
                                                        Plot1="{Binding ResultLaserAttenuatorObjDto.CoefficientFitCurvePositions}" />
                    </i:Interaction.Behaviors>
                </wpf:WpfPlot>
            </Border>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>