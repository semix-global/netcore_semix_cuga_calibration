<UserControl x:Class="CugaCalibration.Views.Laser.FocusShift.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:optics="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserFocusShiftCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser Focus Shift Step 4: "
                           Status="{Binding CalibrationStepList[4].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Mag: "
                           Status="{Binding Cache.OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Speed: "
                           Status="{Binding Cache.StageSpeedEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical">
                        <hc:UniformSpacingPanel Margin="2"
                                                HorizontalAlignment="Center"
                                                Orientation="Vertical">
                            <StackPanel>
                                <TextBlock Text="AF Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:NumericUpDown Height="30"
                                              Margin="2"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:InfoElement.Title="Ecs: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="100">
                                <hc:NumericUpDown.Style>
                                    <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                                <Setter Property="Value" Value="{Binding Cache.LowMagDarkFieldAutoFocusParam.DswEcsValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                                <Setter Property="Value" Value="{Binding Cache.MiddleMagDarkFieldAutoFocusParam.DswEcsValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                                <Setter Property="Value" Value="{Binding Cache.HighMagDarkFieldAutoFocusParam.DswEcsValue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                            <hc:NumericUpDown Height="30"
                                              Margin="2"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:InfoElement.Title="Motor: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:TitleElement.TitleWidth="100">
                                <hc:NumericUpDown.Style>
                                    <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                                <Setter Property="Value" Value="{Binding Cache.LowMagDarkFieldAutoFocusParam.DswMotorValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                                <Setter Property="Value" Value="{Binding Cache.MiddleMagDarkFieldAutoFocusParam.DswMotorValue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                                <Setter Property="Value" Value="{Binding Cache.HighMagDarkFieldAutoFocusParam.DswMotorValue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                            <hc:SimplePanel Height="30">
                                <TextBlock Text="AutoFocus:"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <ToggleButton HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Background="{StaticResource DangerBrush}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonSwitch}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                                    <Setter Property="IsChecked" Value="{Binding Cache.LowMagDarkFieldAutoFocusParam.IsEnableDsw}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                                    <Setter Property="IsChecked" Value="{Binding Cache.MiddleMagDarkFieldAutoFocusParam.IsEnableDsw}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                                    <Setter Property="IsChecked" Value="{Binding Cache.HighMagDarkFieldAutoFocusParam.IsEnableDsw}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </hc:SimplePanel>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Find Template"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:ComboBox x:Name="TemplateTypeComboBox"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitleWidth="90"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Template Type: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.AlgorithmTemplateTypeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <TextBox x:Name="PathTextBox"
                             Text="{Binding Cache.DarkFiledTemplateFilePath}"
                             Height="100"
                             TextWrapping="Wrap"
                             hc:InfoElement.Title="Template: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource TextBoxExtend}" />
                    <view:CanvasView Width="100"
                                     Height="100"
                                     BackgroundColor="#0A0A0A"
                                     AxisColor="Red"
                                     Interactive="True"
                                     ShowAxes="True"
                                     ShowCursor="False"
                                     ShowGrid="False"
                                     BackgroundImage="{Binding Cache.DarkFiledTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step3CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step3CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
    </Grid>
</UserControl>