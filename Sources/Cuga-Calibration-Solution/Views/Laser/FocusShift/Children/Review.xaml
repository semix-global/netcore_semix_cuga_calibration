<UserControl x:Class="CugaCalibration.Views.Laser.FocusShift.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:optics="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Laser.FocusShift;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Laser"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:LaserFocusShiftCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Laser Focus Shift: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="ZLimitMinNumeric"
                                      hc:TitleElement.TitleWidth="120"
                                      hc:InfoElement.Title="Z Limit Min: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                        <Setter Property="Value" Value="{Binding Cache.LowMagFindFocusMin}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                        <Setter Property="Value" Value="{Binding Cache.MiddleMagFindFocusMin}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                        <Setter Property="Value" Value="{Binding Cache.HighMagFindFocusMin}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown x:Name="ZLimitMaxNumeric"
                                      hc:TitleElement.TitleWidth="120"
                                      hc:InfoElement.Title="Z Limit Max: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                        <Setter Property="Value" Value="{Binding Cache.LowMagFindFocusMax}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                        <Setter Property="Value" Value="{Binding Cache.MiddleMagFindFocusMax}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                        <Setter Property="Value" Value="{Binding Cache.HighMagFindFocusMax}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown x:Name="IntervalNumeric"
                                      hc:TitleElement.TitleWidth="120"
                                      hc:InfoElement.Title="Z Interval: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1"
                                      Maximum="100">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Low}">
                                        <Setter Property="Value" Value="{Binding Cache.LowMagFindFocusInterval}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.Middle}">
                                        <Setter Property="Value" Value="{Binding Cache.MiddleMagFindFocusInterval}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.OpticsMagTypeEnum}" Value="{x:Static optics:OpticsMagTypeEnum.High}">
                                        <Setter Property="Value" Value="{Binding Cache.HighMagFindFocusInterval}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown hc:InfoElement.Title="Focus Shift Threshold: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.FocusShiftThreshold}" />

                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding ResultFocusShiftDto.AutoFocusEcs, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="AutoFocus Ecs: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultFocusShiftDto.DarkFieldEcsValue, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Real Ecs: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultFocusShiftDto.FocusShiftOffset, Mode=OneWay}"
                             hc:InfoElement.Title="Focus Shift Offset: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}"
                             IsReadOnly="True" />
                    <TextBox Text="{Binding ResultFocusShiftDto.SettingDarkFieldAutoFocusParam.DswEcsValue}"
                             hc:InfoElement.Title="Reviese Af Ecs: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultFocusShiftDto.SettingDarkFieldAutoFocusParam.DswMotorValue, StringFormat={}{0:f3}}"
                             hc:InfoElement.Title="Reviese Af Motor: "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <GroupBox Grid.Row="2" Grid.Column="2"
                  Header="Calibration Data">
            <ListView d:SelectedIndex="0"
                      ItemsSource="{Binding ReviewList}"
                      Style="{StaticResource ListView.Small}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectedItem="{Binding SelectReviewDto}">
                <i:Interaction.Behaviors>
                    <behaviors:ListBoxScrollToCurrentBehavior />
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="100"
                                        Header="OpticsMag"
                                        DisplayMemberBinding="{Binding OpticsMagTypeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                        <GridViewColumn Width="100"
                                        Header="AfEcs"
                                        DisplayMemberBinding="{Binding BrightFieldEcsValue, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="100"
                                        Header="RealNscEcs"
                                        DisplayMemberBinding="{Binding DarkFieldEcsValue, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="100"
                                        Header="Quality"
                                        DisplayMemberBinding="{Binding DarkFieldQuality, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="100"
                                        Header="RealNsc"
                                        DisplayMemberBinding="{Binding NscValue, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="100"
                                        Header="AutoFocusEcs"
                                        DisplayMemberBinding="{Binding AutoFocusEcs, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="100"
                                        Header="AutoFocusNsc"
                                        DisplayMemberBinding="{Binding AutoFocusNsc, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="100"
                                        Header="EcsOffset"
                                        DisplayMemberBinding="{Binding EcsOffset, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="100"
                                        Header="FocusShiftOffset"
                                        DisplayMemberBinding="{Binding FocusShiftOffset, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="100"
                                        Header="AfMotorOffset"
                                        DisplayMemberBinding="{Binding AfMotorOffset, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="200"
                                        Header="Bright Field Position"
                                        DisplayMemberBinding="{Binding BrightFieldFindPosition, Converter={StaticResource PointToStringConverter}}" />
                        <GridViewColumn Width="200"
                                        Header="Dark Field Position"
                                        DisplayMemberBinding="{Binding DarkFieldFindPosition, Converter={StaticResource PointToStringConverter}}" />
                        <GridViewColumn Width="200" Header="Action Review">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ButtonGroup>
                                        <Button Content="Image"
                                                Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding DarkFieldImageFilePath}"
                                                d:DataContext="{d:DesignInstance Type=coreModels:FocusShiftDto}" />
                                    </hc:ButtonGroup>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>