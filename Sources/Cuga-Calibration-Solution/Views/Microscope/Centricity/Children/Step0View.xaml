<UserControl x:Class="CugaCalibration.Views.Microscope.Centricity.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCentricityViewModel}"
             d:DesignHeight="1080"
             d:DesignWidth="1920"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <StackPanel>
                            <TextBlock Text="1. Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:ComboBox hc:TitleElement.TitleWidth="160"
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.Title="Cal Chip: "
                                     SelectedItem="{Binding Cache.CalChipSiteModelEnum}"
                                     ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type stage:CalChipSiteModelEnum}}}">
                            <hc:ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </hc:ComboBox.ItemTemplate>
                        </hc:ComboBox>
                        <hc:ComboBox x:Name="TemplateTypeComboBox"
                                     hc:TitleElement.TitleWidth="160"
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.Title="Template Type: "
                                     SelectedItem="{Binding Cache.AlgorithmTemplateTypeEnum}"
                                     ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                            <hc:ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </hc:ComboBox.ItemTemplate>
                        </hc:ComboBox>
                        <StackPanel>
                            <TextBlock Text="2. Find Position"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox Text="{Binding Cache.Item.FindPosition, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.TitleWidth="160"
                                 hc:TitleElement.Title="Position(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button x:Name="ActionButton"
                                    Content="Action"
                                    Command="{Binding Step0Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Command="{Binding Step0CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>