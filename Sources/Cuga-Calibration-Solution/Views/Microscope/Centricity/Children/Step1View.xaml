<UserControl x:Class="CugaCalibration.Views.Microscope.Centricity.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Microscope.Centricity;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:wafer="clr-namespace:Core.Models.Enums.Recipe.Wafer;assembly=Core.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCentricityCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Color="{StaticResource InfoBrush}">
                    <hc:Shield.Style>
                        <Style BasedOn="{StaticResource ShieldBaseStyle}" TargetType="hc:Shield">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="1">
                                    <Setter Property="Subject" Value="Microscope Centricity Step 2:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[1].StepName}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="2">
                                    <Setter Property="Subject" Value="Microscope Centricity Step 3:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[2].StepName}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="3">
                                    <Setter Property="Subject" Value="Microscope Centricity Step 4:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[3].StepName}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="4">
                                    <Setter Property="Subject" Value="Microscope Centricity Step 5:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[4].StepName}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CalibrationStepIndex}" Value="5">
                                    <Setter Property="Subject" Value="Microscope Centricity Step 6:" />
                                    <Setter Property="Status" Value="{Binding CalibrationStepList[5].StepName}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:Shield.Style>
                </hc:Shield>
                <hc:Shield Subject="Microscope Centricity Step : "
                           Status="{Binding CalibrationStepName}"
                           Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeLensInformation.LensName}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Find Position: "
                           Status="{Binding SelectMicroscopeCentricityCacheItem.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Find Position 、Template"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding SelectMicroscopeCentricityCacheItem.FindPosition, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Position(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="{Binding IsAutoCalibrate}"
                             Style="{StaticResource TextBoxExtend}" />
                    <view:CanvasView Width="100"
                                     Height="100"
                                     BackgroundColor="#0A0A0A"
                                     AxisColor="Red"
                                     Interactive="True"
                                     ShowAxes="True"
                                     ShowCursor="False"
                                     ShowGrid="False"
                                     BackgroundImage="{Binding SelectMicroscopeCentricityCacheItem.TemplateImageFilePath}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="2. Find Offset"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:ComboBox Width="275"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Wafer Mask Type: "
                                 SelectedItem="{Binding SelectMicroscopeCentricityCacheItem.WaferMaskTypeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type wafer:WaferMaskTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <TextBox Text="{Binding ResultMicroscopeCentricityItemDto.CentricityPosition, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Centricity: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultMicroscopeCentricityItemDto.Offset, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Offset: "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <ListView d:SelectedIndex="0"
                      ItemsSource="{Binding MicroscopeCentricityItemDtoList}"
                      Style="{StaticResource ListView.Small}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectedItem="{Binding SelectMicroscopeCentricityItemDto, Mode=OneWay}">
                <i:Interaction.Behaviors>
                    <behaviors:ListBoxScrollToCurrentBehavior />
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="120"
                                        Header="Magnification"
                                        DisplayMemberBinding="{Binding LensInformation.LensName, Converter={StaticResource EnumDescriptionConverter}}" />
                        <GridViewColumn Width="200"
                                        Header="Centricity"
                                        DisplayMemberBinding="{Binding CentricityPosition, Converter={StaticResource PointToStringConverter}}" />
                        <GridViewColumn Width="100"
                                        Header="Offset"
                                        DisplayMemberBinding="{Binding Offset, Converter={StaticResource PointToStringConverter}}" />
                        <GridViewColumn Width="100"
                                        Header="Score"
                                        DisplayMemberBinding="{Binding TemplateScore, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="100"
                                        Header="Angle"
                                        DisplayMemberBinding="{Binding TemplateAngle, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="200" Header="Action Review">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Image"
                                                Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding FilePath}"
                                                HorizontalAlignment="Center"
                                                d:DataContext="{d:DesignInstance Type=coreModels:MicroscopeCentricityItemDto}" />
                                        <Button Grid.Column="1"
                                                Content="Template"
                                                Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding TemplateImageFilePath}"
                                                HorizontalAlignment="Center"
                                                d:DataContext="{d:DesignInstance Type=coreModels:MicroscopeCentricityItemDto}" />
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>