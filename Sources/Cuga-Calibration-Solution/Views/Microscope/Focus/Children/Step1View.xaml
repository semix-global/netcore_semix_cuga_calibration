<UserControl x:Class="CugaCalibration.Views.Microscope.Focus.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:microscope="clr-namespace:Core.Models.Enums.Microscope;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeFocusCalibrationViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Microscope Focus Step 2: "
                           Status="{Binding CalibrationStepList[1].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeMagnificationEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Find Focus Position"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Width="275"
                             hc:InfoElement.Title="Position(um): "
                             hc:InfoElement.TitlePlacement="Left">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification5X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindFocusPosition5X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification10X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindFocusPosition10X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification50X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindFocusPosition50X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification100X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindFocusPosition100X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification150X}">
                                        <Setter Property="Text" Value="{Binding Cache.FindFocusPosition150X, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <UniformGrid Width="275" Columns="2">
                        <Button x:Name="GetButton"
                                Content="Get"
                                Command="{Binding GetPointCommand}"
                                HorizontalAlignment="Stretch"
                                hc:BorderElement.CornerRadius="4,0,0,4">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ButtonDefault}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification5X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition5X" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification10X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition10X" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification50X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition50X" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification100X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition100X" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification150X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition150X" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="GotoButton"
                                Content="Goto"
                                Command="{Binding GotoPointCommand}"
                                Margin="-1,0,0,0"
                                HorizontalAlignment="Stretch"
                                hc:BorderElement.CornerRadius="0,4,4,0">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ButtonDefault}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification5X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition5X" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification10X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition10X" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification50X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition50X" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification100X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition100X" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification150X}">
                                            <Setter Property="CommandParameter" Value="FindFocusPosition150X" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
    </Grid>
</UserControl>