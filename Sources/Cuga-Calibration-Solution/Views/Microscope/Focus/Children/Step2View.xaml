<UserControl x:Class="CugaCalibration.Views.Microscope.Focus.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Microscope.Focus;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Microscope Focus Step 3: "
                           Status="{Binding CalibrationStepList[2].StepName}"
                           Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeLensInformation.LensName}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Find Focus Position: "
                           Status="{Binding SelectMicroscopeFocusCacheItem.FindFocusPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:SearchBar x:Name="QualitySearchBar"
                                  Text="{Binding ReviewViewModel.Quality, Mode=OneWay, StringFormat={}{0:f3}}"
                                  Command="{Binding ReviewViewModel.GetQualityCommand}"
                                  hc:TitleElement.TitleWidth="180"
                                  hc:TitleElement.Title="Quality: "
                                  hc:TitleElement.TitlePlacement="Left"
                                  IsReadOnly="True"
                                  Style="{StaticResource SearchBarExtend}" />
                    <hc:NumericUpDown x:Name="ZLimitMinNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:TitleElement.Title="Z Limit Min: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SelectMicroscopeFocusCacheItem.FindFocusMin}" />
                    <hc:NumericUpDown x:Name="ZLimitMaxNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:TitleElement.Title="Z Limit Max: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SelectMicroscopeFocusCacheItem.FindFocusMax}" />
                    <hc:NumericUpDown x:Name="IntervalNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:TitleElement.Title="Z Interval: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Maximum="100"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SelectMicroscopeFocusCacheItem.FindFocusInterval}" />
                    <hc:NumericUpDown x:Name="VoltageAfErrorThresholdNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:TitleElement.Title="Voltage Af Error Threshold: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding SelectMicroscopeFocusCacheItem.SetVoltageAfErrorThreshold}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="2. Find Focus"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding SelectedMicroscopeFocusItemDto.Quality, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Find Focus Max Quality: "
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding SelectedMicroscopeFocusItemDto.EcsValue, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Find Focus ECS: "
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding SelectedMicroscopeFocusItemDto.TransBufferAfErrorValue, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Find Focus TransBuffer: "
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding SelectedMicroscopeFocusItemDto.MicroscopeVoltage, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Microscope Voltage: "
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="4*" />
                </Grid.RowDefinitions>
                <GroupBox Header="History">
                    <ListView d:SelectedIndex="0"
                              ItemsSource="{Binding MicroscopeFocusItemDtoList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectedMicroscopeFocusItemDto, Mode=OneWay}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="100"
                                                Header="Index"
                                                DisplayMemberBinding="{Binding Index}" />
                                <GridViewColumn Width="200"
                                                Header="Magnification"
                                                DisplayMemberBinding="{Binding LensInformation.LensName}" />
                                <GridViewColumn Width="200"
                                                Header="FindPosition"
                                                DisplayMemberBinding="{Binding FindPosition, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="100"
                                                Header="Ecs"
                                                DisplayMemberBinding="{Binding EcsValue, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100"
                                                Header="Quality"
                                                DisplayMemberBinding="{Binding Quality, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="200" Header="Action Review">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:ButtonGroup>
                                                <Button Content="Image"
                                                        Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding FilePath}"
                                                        d:DataContext="{d:DesignInstance Type=coreModels:MicroscopeFocusItemDto}" />
                                            </hc:ButtonGroup>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
                <Border Grid.Row="1"
                        Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot>
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="Focus"
                                                            Plot0Title="Quality"
                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                            Plot0="{Binding EcsPoints}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </Grid>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>