<UserControl x:Class="CugaCalibration.Views.Microscope.Focus.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:microscope="clr-namespace:Core.Models.Enums.Microscope;assembly=Core.Models"
             xmlns:coreModels="clr-namespace:Core.Models.Models.Microscope.Focus;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Microscope Focus Step 3: "
                           Status="{Binding CalibrationStepList[2].StepName}"
                           Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeMagnificationEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Find Focus Position: "
                           Color="{StaticResource SuccessBrush}">
                    <hc:Shield.Style>
                        <Style BasedOn="{StaticResource ShieldBaseStyle}" TargetType="hc:Shield">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification5X}">
                                    <Setter Property="Status" Value="{Binding Cache.FindFocusPosition5X, Converter={StaticResource PointToStringConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification10X}">
                                    <Setter Property="Status" Value="{Binding Cache.FindFocusPosition10X, Converter={StaticResource PointToStringConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification50X}">
                                    <Setter Property="Status" Value="{Binding Cache.FindFocusPosition50X, Converter={StaticResource PointToStringConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification100X}">
                                    <Setter Property="Status" Value="{Binding Cache.FindFocusPosition100X, Converter={StaticResource PointToStringConverter}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification150X}">
                                    <Setter Property="Status" Value="{Binding Cache.FindFocusPosition150X, Converter={StaticResource PointToStringConverter}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:Shield.Style>
                </hc:Shield>
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:SearchBar x:Name="QualitySearchBar"
                                  Text="{Binding ReviewViewModel.Quality, Mode=OneWay, StringFormat={}{0:f3}}"
                                  Command="{Binding ReviewViewModel.GetQualityCommand}"
                                  hc:TitleElement.TitleWidth="180"
                                  hc:InfoElement.Title="Quality: "
                                  hc:InfoElement.TitlePlacement="Left"
                                  IsReadOnly="True"
                                  Style="{StaticResource SearchBarExtend}" />
                    <hc:NumericUpDown x:Name="ZLimitMinNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Z Limit Min: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification5X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMin5X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification10X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMin10X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification50X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMin50X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification100X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMin100X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification150X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMin150X}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown x:Name="ZLimitMaxNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Z Limit Max: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification5X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMax5X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification10X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMax10X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification50X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMax50X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification100X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMax100X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification150X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMax150X}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown x:Name="IntervalNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Z Interval: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1"
                                      Maximum="100">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification5X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusInterval5X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification10X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusInterval10X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification50X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusInterval50X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification100X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusInterval100X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification150X}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusInterval150X}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown x:Name="VoltageAfErrorThresholdNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Voltage Af Error Threshold: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification5X}">
                                        <Setter Property="Value" Value="{Binding Cache.SetVoltageAfErrorThreshold5X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification10X}">
                                        <Setter Property="Value" Value="{Binding Cache.SetVoltageAfErrorThreshold10X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification50X}">
                                        <Setter Property="Value" Value="{Binding Cache.SetVoltageAfErrorThreshold50X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification100X}">
                                        <Setter Property="Value" Value="{Binding Cache.SetVoltageAfErrorThreshold100X}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.MicroscopeMagnificationEnum}" Value="{x:Static microscope:MicroscopeMagnificationEnum.Magnification150X}">
                                        <Setter Property="Value" Value="{Binding Cache.SetVoltageAfErrorThreshold150X}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="2. Find Focus"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding SelectedMicroscopeFocusItemDto.Quality, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Find Focus Max Quality: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding SelectedMicroscopeFocusItemDto.EcsValue, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Find Focus ECS: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding SelectedMicroscopeFocusItemDto.TransBufferAfErrorValue, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Find Focus TransBuffer: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding SelectedMicroscopeFocusItemDto.MicroscopeVoltage, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Microscope Voltage: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding MicroscopeFocusItemDtoList}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectedMicroscopeFocusItemDto, Mode=OneWay}">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="100"
                                            Header="Index"
                                            DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Width="200"
                                            Header="Magnification"
                                            DisplayMemberBinding="{Binding MicroscopeMagnificationEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Width="200"
                                            Header="FindPosition"
                                            DisplayMemberBinding="{Binding FindPosition, Converter={StaticResource PointToStringConverter}}" />
                            <GridViewColumn Width="100"
                                            Header="Ecs"
                                            DisplayMemberBinding="{Binding EcsValue, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="Quality"
                                            DisplayMemberBinding="{Binding Quality, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="200" Header="Action Review">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ButtonGroup>
                                            <Button Content="Image"
                                                    Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding FilePath}"
                                                    d:DataContext="{d:DesignInstance Type=coreModels:MicroscopeFocusItemDto}" />
                                        </hc:ButtonGroup>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            <ToggleButton x:Name="ToggleButton"
                          Content="Function Image"
                          Margin="3.5"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          hc:IconElement.Geometry="{StaticResource AllGeometry}"
                          Style="{StaticResource ToggleButtonDefault.Small}" />
            <Popup StaysOpen="False"
                   PlacementTarget="{Binding ElementName=ToggleButton}"
                   Placement="Top"
                   AllowsTransparency="True"
                   PopupAnimation="Slide"
                   IsOpen="{Binding IsChecked, ElementName=ToggleButton, Mode=TwoWay}">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot Width="500" Height="400">
                        <i:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="Focus"
                                                            Plot0Title="Quality"
                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                            Plot0="{Binding EcsPoints}" />
                        </i:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </Popup>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>