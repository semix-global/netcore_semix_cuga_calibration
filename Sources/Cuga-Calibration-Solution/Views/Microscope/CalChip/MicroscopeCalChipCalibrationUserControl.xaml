<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.MicroscopeCalChipCalibrationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:childrenView="clr-namespace:CugaCalibration.Views.Microscope.CalChip.Children"
             xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipCalibrationViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1920"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <hc:TransitioningContentControl TransitionStoryboard="{StaticResource Left2RightWithFadeTransition}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="500" />
            </Grid.ColumnDefinitions>
            <!--#region Left-->
            <Border Margin="5"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow2}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsLoadingToVisibilityConverter}}">
                        <hc:LoadingCircle Width="200"
                                          Height="200"
                                          Style="{StaticResource LoadingCircleLarge}" />
                        <TextBlock Text="Loading calibration..." Style="{StaticResource TextBlockLargeBold}" />
                    </StackPanel>
                    <Grid Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsWelcomeToVisibilityConverter}}">
                        <TextBlock Text="Welcome to calibration!" Style="{StaticResource TextBlockLargeBold}" />
                    </Grid>
                    <Grid Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsCalibrationToVisibilityConverter}}">
                        <childrenView:StepCommonNextView Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs0ToVisibilityConverter}}" />
                        <childrenView:StepCommonNextView Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs1ToVisibilityConverter}}" />
                        <childrenView:StepCommonNextView Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs2ToVisibilityConverter}}" />
                        <childrenView:StepCommonNextView Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs3ToVisibilityConverter}}" />
                    </Grid>
                    <Grid Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsReviewToVisibilityConverter}}">
                        <childrenView:Review />
                    </Grid>
                </Grid>
            </Border>
            <!--#endregion-->
            <GridSplitter Grid.Column="1" Margin="-5,0" />
            <!--#region Right-->
            <Border Grid.Column="2"
                    Margin="5"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow2}">
                <Grid hc:BorderElement.Circular="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Instructions"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource TextBlockLargeBold}" />
                    <RichTextBox Grid.Row="1"
                                 Margin="5"
                                 Padding="5"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <FlowDocument>
                            <Paragraph>
                                <Run Text="1. Switch the mode so that the wafer on the cal chip can use the microscope servo and autofocus servo modes;" />
                                <LineBreak />
                                <Run Text="2. Chuck moves the four corners to the center of the bright field in the order of upper left, upper right, lower left, and lower right. After each move, switch to microscope servo mode, move the cross mark to the die corner of the DSW wafer, click to confirm, and record The translation stage coordinates and ECS height value at this time. For Haze and shiny wafer, confirm whether the wafer is in the bright field, then click Confirm to record the coordinates of the translation stage and the ECS height value at this time;" />
                                <LineBreak />
                                <Run Text="3. Generate a calibration file, which includes the translation stage coordinates and ECS values of each wafer in bright field." />
                                <LineBreak />
                            </Paragraph>
                            <Paragraph>
                                <Hyperlink>https://www.semixchina.com</Hyperlink>
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                    <hc:StepBar Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                StepIndex="{Binding CalibrationStepIndex}"
                                ItemsSource="{Binding CalibrationStepList}">
                        <hc:StepBar.ItemTemplate>
                            <DataTemplate />
                        </hc:StepBar.ItemTemplate>
                    </hc:StepBar>
                    <ProgressBar Grid.Row="3"
                                 Margin="5"
                                 Style="{StaticResource ProgressBarSuccess}"
                                 Value="{Binding CalibrationProgress, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </hc:TransitioningContentControl>
</UserControl>