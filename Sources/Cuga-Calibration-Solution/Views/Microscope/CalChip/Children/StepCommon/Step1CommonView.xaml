<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.Children.StepCommon.Step1CommonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipViewModel}"
             d:DesignWidth="430"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
        <StackPanel>
            <TextBlock Text="Find Ecs Right Bottom Position"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       FontWeight="Bold"
                       Style="{StaticResource TextBlockDefaultInfo}" />
        </StackPanel>
        <TextBox Text="{Binding Cache.Item.RightBottomMachinePosition, Converter={StaticResource PointToStringConverter}}"
                 hc:TitleElement.Title="Right-Bottom Position(um): "
                 hc:TitleElement.TitleWidth="250"
                 hc:TitleElement.TitlePlacement="Left"
                 Style="{StaticResource TextBoxExtend}" />
    </hc:UniformSpacingPanel>
</UserControl>