<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:focus="clr-namespace:Core.Models.Models.Microscope.Focus;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationStepIndex, StringFormat='Cal Chip Step {0}'}" Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeMagnificationEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:SearchBar x:Name="QualitySearchBar"
                                  Text="{Binding ReviewViewModel.Quality, Mode=OneWay, StringFormat={}{0:f3}}"
                                  Command="{Binding ReviewViewModel.GetQualityCommand}"
                                  hc:TitleElement.TitleWidth="180"
                                  hc:InfoElement.Title="Quality: "
                                  hc:InfoElement.TitlePlacement="Left"
                                  IsReadOnly="True"
                                  Style="{StaticResource SearchBarExtend}" />
                    <hc:NumericUpDown x:Name="ZLimitMinNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Z Limit Min: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMinDsw}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMinUndefined}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMinHaze}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMinShinyWafer}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown x:Name="ZLimitMaxNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Z Limit Max: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMaxDsw}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMaxUndefined}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMaxHaze}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusMaxShinyWafer}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <hc:NumericUpDown x:Name="IntervalNumeric"
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.Title="Z Limit Interval: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.Placeholder="Input Find Focus Offset"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="1">
                        <hc:NumericUpDown.Style>
                            <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusIntervalDsw}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusIntervalUndefined}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusIntervalHaze}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Value" Value="{Binding Cache.FindFocusIntervalShinyWafer}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="2. Ecs Center Position"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox x:Name="PositionTextbox"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Position(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Text" Value="{Binding Cache.DswPosition, Mode=OneWay, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Text" Value="{Binding Cache.UndefinedPosition, Mode=OneWay, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Text" Value="{Binding Cache.HazePosition, Mode=OneWay, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Text" Value="{Binding Cache.ShinyWaferPosition, Mode=OneWay, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox x:Name="BrightMachinePositionTextbox"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Bright Machine Position(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswBrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.UndefinedBrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.HazeBrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.ShinyWaferBrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox x:Name="DarkMachinePositionTextbox"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Dark Machine Position(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswDarkFieldMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.UndefinedDarkFieldMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.HazeDarkFieldMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.ShinyWaferDarkFieldMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="3. Find Esc"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Find Focus Max Quality: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswQuality, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.UndefinedQuality, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.HazeQuality, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.ShinyWaferQuality, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Find Focus Max Ecs: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswEcsValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.UndefinedEcsValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.HazeEcsValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.ShinyWaferEcsValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Rtfc Af Ecs: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswAfEcsValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswAfEcsValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswAfEcsValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswAfEcsValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Rtfc Af Motor: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswAfMotorValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswAfMotorValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswAfMotorValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                        <Setter Property="Text" Value="{Binding ResultMicroscopeCalChipDto.DswAfMotorValue, StringFormat={}{0:f3}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding MicroscopeFocusItemDtoList}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectedMicroscopeFocusItemDto, Mode=OneWay}">
                    <b:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </b:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="100"
                                            Header="Index"
                                            DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Width="200"
                                            Header="Magnification"
                                            DisplayMemberBinding="{Binding MicroscopeMagnificationEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Width="200"
                                            Header="FindPosition"
                                            DisplayMemberBinding="{Binding FindPosition, Converter={StaticResource PointToStringConverter}}" />
                            <GridViewColumn Width="100"
                                            Header="Ecs"
                                            DisplayMemberBinding="{Binding EcsValue, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="Quality"
                                            DisplayMemberBinding="{Binding Quality, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="200" Header="Action Review">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ButtonGroup>
                                            <Button Content="Image"
                                                    Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding FilePath}"
                                                    d:DataContext="{d:DesignInstance Type=focus:MicroscopeFocusItemDto}" />
                                        </hc:ButtonGroup>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            <ToggleButton x:Name="ToggleButton"
                          Content="Function Image"
                          Margin="3.5"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          hc:IconElement.Geometry="{StaticResource AllGeometry}"
                          Style="{StaticResource ToggleButtonDefault.Small}" />
            <Popup StaysOpen="False"
                   PlacementTarget="{Binding ElementName=ToggleButton}"
                   Placement="Top"
                   AllowsTransparency="True"
                   PopupAnimation="Slide"
                   IsOpen="{Binding IsChecked, ElementName=ToggleButton, Mode=TwoWay}">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot Width="500" Height="400">
                        <b:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="Focus"
                                                            Plot0Title="Quality"
                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                            Plot0="{Binding EcsPoints}" />
                        </b:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </Popup>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>