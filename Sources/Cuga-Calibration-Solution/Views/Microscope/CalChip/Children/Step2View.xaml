<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:focus="clr-namespace:Core.Models.Models.Microscope.Focus;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationStepIndex, StringFormat={}Cal Chip Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="High Microscope Magnification: "
                           Status="{Binding Cache.LowMicroscopeLensInformation.LensName}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="CalChip Mode: "
                           Status="{Binding Cache.CalChipSiteModelEnum}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:SearchBar x:Name="QualitySearchBar"
                                  Text="{Binding ReviewViewModel.Quality, Mode=OneWay, StringFormat={}{0:f3}}"
                                  Command="{Binding ReviewViewModel.GetQualityCommand}"
                                  hc:TitleElement.TitleWidth="180"
                                  hc:TitleElement.Title="Quality: "
                                  hc:TitleElement.TitlePlacement="Left"
                                  IsReadOnly="True"
                                  Style="{StaticResource SearchBarExtend}" />
                    <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                      hc:TitleElement.Title="Z Limit Min: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.FindFocusMin}" />
                    <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                      hc:TitleElement.Title="Z Limit Max: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.FindFocusMax}" />
                    <hc:NumericUpDown hc:TitleElement.TitleWidth="180"
                                      hc:TitleElement.Title="Z Limit Interval: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Item.FindFocusInterval}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="2. Ecs Center Position"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.Item.CenterPosition, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Position(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultMicroscopeCalChipDto.CurrentItem.BrightFieldMachinePosition, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Bright Machine Position(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultMicroscopeCalChipDto.CurrentItem.DarkFieldMachinePosition, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Dark Machine Position(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="3. Find Esc"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding ResultMicroscopeCalChipDto.CurrentItem.BrightFieldQuality, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Find Focus Max Quality: "
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ResultMicroscopeCalChipDto.CurrentItem.EcsValue, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Find Focus Max Ecs: "
                             hc:TitleElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}"
                             IsReadOnly="True" />
                    <TextBox Text="{Binding ResultMicroscopeCalChipDto.CurrentItem.AfEcsValue, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Rtfc Af Ecs: "
                             hc:TitleElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}"
                             IsReadOnly="True" />
                    <TextBox Text="{Binding ResultMicroscopeCalChipDto.CurrentItem.AfMotorValue, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Rtfc Af Motor: "
                             hc:TitleElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}"
                             IsReadOnly="True" />
                    <TextBox Text="{Binding ResultMicroscopeCalChipDto.CurrentItem.DarkFieldQuality, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.Title="Rtfc Quality: "
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding MicroscopeFocusItemDtoList}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectedMicroscopeFocusItemDto, Mode=OneWay}">
                    <b:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </b:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="100"
                                            Header="Index"
                                            DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Width="200"
                                            Header="Magnification"
                                            DisplayMemberBinding="{Binding LensInformation.LensName, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Width="200"
                                            Header="FindPosition"
                                            DisplayMemberBinding="{Binding FindPosition, Converter={StaticResource PointToStringConverter}}" />
                            <GridViewColumn Width="100"
                                            Header="Ecs"
                                            DisplayMemberBinding="{Binding EcsValue, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="100"
                                            Header="Quality"
                                            DisplayMemberBinding="{Binding Quality, StringFormat={}{0:f3}}" />
                            <GridViewColumn Width="200" Header="Action Review">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ButtonGroup>
                                            <Button Content="Image"
                                                    Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding FilePath}"
                                                    d:DataContext="{d:DesignInstance Type=focus:MicroscopeFocusItemDto}" />
                                        </hc:ButtonGroup>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            <ToggleButton x:Name="ToggleButton"
                          Content="Function Image"
                          Margin="3.5"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          hc:IconElement.Geometry="{StaticResource AllGeometry}"
                          Style="{StaticResource ToggleButtonDefault.Small}" />
            <Popup StaysOpen="False"
                   PlacementTarget="{Binding ElementName=ToggleButton}"
                   Placement="Top"
                   AllowsTransparency="True"
                   PopupAnimation="Slide"
                   IsOpen="{Binding IsChecked, ElementName=ToggleButton, Mode=TwoWay}">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <wpf:WpfPlot Width="500" Height="400">
                        <b:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="Focus"
                                                            Plot0Title="Quality"
                                                            Plot0Color="{x:Static scottPlot:Colors.Green}"
                                                            Plot0="{Binding EcsPoints}" />
                        </b:Interaction.Behaviors>
                    </wpf:WpfPlot>
                </Border>
            </Popup>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>