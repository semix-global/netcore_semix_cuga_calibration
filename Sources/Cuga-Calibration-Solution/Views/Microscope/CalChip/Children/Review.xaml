<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Microscope Cal Chip: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="ThresholdNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="Threshold: "
                                      hc:TitleElement.TitleWidth="100"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Threshold}" />
                    <TextBox Text="{Binding Cache.VerifyResultQuality}"
                             Width="275"
                             hc:InfoElement.Title="Result Position: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.VerifyResultError}"
                             Width="275"
                             hc:InfoElement.Title="Result Error: "
                             hc:TitleElement.TitleWidth="100"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="Calibration Data">
            <UniformGrid Columns="2" Rows="2">
                <UniformGrid.Resources>
                    <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                        <Setter Property="Margin" Value="5" />
                    </Style>
                    <Style BasedOn="{StaticResource TextBlockDefaultInfo}" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                    </Style>
                </UniformGrid.Resources>
                <Border>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <StackPanel>
                            <TextBlock Text="DSW" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <TextBox Text="{Binding ReviewDto.DswPosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.DswBrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Bright Machine Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.DswDarkFieldMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Dark Machine Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.DswQuality, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Quality: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.DswEcsValue, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Ecs: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="DswBrightFieldGotoButton"
                                    Content="Goto Bright Field"
                                    Command="{Binding StageViewModel.SetCalChipDswBrightFieldAbsoluteStageXyCommand}"
                                    CommandParameter="{Binding ReviewDto.DswPosition}"
                                    Width="120" />
                            <Button x:Name="DswDarkFieldGotoButton"
                                    Content="Goto Dark Field"
                                    Command="{Binding StageViewModel.SetCalChipDswDarkFieldAbsoluteStageXyByNotAutoFocusCommand}"
                                    CommandParameter="{Binding ReviewDto.DswPosition}"
                                    Width="120" />
                            <Button x:Name="DswReviewButton"
                                    Content="Review"
                                    Command="{Binding ReviewViewModel.ReviewCommand}"
                                    CommandParameter="{Binding ReviewDto.DswFilePath}"
                                    Width="70" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <StackPanel>
                            <TextBlock Text="Undefined" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <TextBox Text="{Binding ReviewDto.UndefinedPosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.UndefinedBrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Bright Machine Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.UndefinedDarkFieldMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Dark Machine Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.UndefinedQuality, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Quality: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.UndefinedEcsValue, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Ecs: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="UndefinedBrightFieldGotoButton"
                                    Content="Goto Bright Field"
                                    Command="{Binding StageViewModel.SetCalChipUndefinedBrightFieldAbsoluteStageXyCommand}"
                                    CommandParameter="{Binding ReviewDto.UndefinedPosition}"
                                    Width="120" />
                            <Button x:Name="UndefinedDarkFieldGotoButton"
                                    Content="Goto Dark Field"
                                    Command="{Binding StageViewModel.SetCalChipUndefinedDarkFieldAbsoluteStageXyByNotAutoFocusCommand}"
                                    CommandParameter="{Binding ReviewDto.UndefinedPosition}"
                                    Width="120" />
                            <Button x:Name="UndefinedReviewButton"
                                    Content="Review"
                                    Command="{Binding ReviewViewModel.ReviewCommand}"
                                    CommandParameter="{Binding ReviewDto.UndefinedFilePath}"
                                    Width="70" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <StackPanel>
                            <TextBlock Text="Haze" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <TextBox Text="{Binding ReviewDto.HazePosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.HazeBrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Bright Machine Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.HazeDarkFieldMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Dark Machine Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.HazeQuality, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Quality: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.HazeEcsValue, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Ecs: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="HazeBrightFieldGotoButton"
                                    Content="Goto Bright Field"
                                    Command="{Binding StageViewModel.SetCalChipHazeBrightFieldAbsoluteStageXyCommand}"
                                    CommandParameter="{Binding ReviewDto.HazePosition}"
                                    Width="120" />
                            <Button x:Name="HazeDarkFieldGotoButton"
                                    Content="Goto Dark Field"
                                    Command="{Binding StageViewModel.SetCalChipHazeDarkFieldAbsoluteStageXyByNotAutoFocusCommand}"
                                    CommandParameter="{Binding ReviewDto.HazePosition}"
                                    Width="120" />
                            <Button x:Name="HazeReviewButton"
                                    Content="Review"
                                    Command="{Binding ReviewViewModel.ReviewCommand}"
                                    CommandParameter="{Binding ReviewDto.HazeFilePath}"
                                    Width="70" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <StackPanel>
                            <TextBlock Text="Shiny Wafer" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                            <TextBox Text="{Binding ReviewDto.ShinyWaferPosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.ShinyWaferBrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Bright Machine Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.ShinyWaferDarkFieldMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Dark Machine Position(um): "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.ShinyWaferQuality, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Quality: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.ShinyWaferEcsValue, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="180"
                                     hc:InfoElement.Title="Ecs: "
                                     hc:InfoElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="ShinyBrightFieldGotoButton"
                                    Content="Goto Bright Field"
                                    Command="{Binding StageViewModel.SetCalChipShinyWaferBrightFieldAbsoluteStageXyCommand}"
                                    CommandParameter="{Binding ReviewDto.ShinyWaferPosition}"
                                    Width="120" />
                            <Button x:Name="ShinyDarkFieldGotoButton"
                                    Content="Goto Dark Field"
                                    Command="{Binding StageViewModel.SetCalChipShinyWaferDarkFieldAbsoluteStageXyByNotAutoFocusCommand}"
                                    CommandParameter="{Binding ReviewDto.ShinyWaferPosition}"
                                    Width="120" />
                            <Button x:Name="ShinyReviewButton"
                                    Content="Review"
                                    Command="{Binding ReviewViewModel.ReviewCommand}"
                                    CommandParameter="{Binding ReviewDto.ShinyWaferFilePath}"
                                    Width="70" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </UniformGrid>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>