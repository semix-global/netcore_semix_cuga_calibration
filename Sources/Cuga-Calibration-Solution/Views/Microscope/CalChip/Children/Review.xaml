<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:Shield Subject="Microscope Cal Chip: "
                               Status="Review"
                               Color="{StaticResource InfoBrush}" />
                    <hc:Shield DockPanel.Dock="Bottom"
                               Subject="Low Microscope Magnification: "
                               Status="{Binding Cache.LowMicroscopeLensInformation}"
                               Color="{StaticResource SuccessBrush}" />
                    <hc:Shield DockPanel.Dock="Bottom"
                               Subject="High Microscope Magnification: "
                               Status="{Binding Cache.HighMicroscopeLensInformation}"
                               Color="{StaticResource SuccessBrush}" />
                </hc:UniformSpacingPanel>
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Verify"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Quality Threshold(score): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="180"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.QualityThreshold}" />
                        <TextBox Text="{Binding SelectReviewItem.DSWAlignmentDegree, StringFormat={}{0:F6}}"
                                 hc:TitleElement.Title="Alignment Verify Degree(°): "
                                 hc:TitleElement.TitleWidth="180"
                                 hc:TitleElement.TitlePlacement="Left"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Cache.VerifyQualityError}"
                                 hc:TitleElement.Title="Quality Result Error(score): "
                                 hc:TitleElement.TitleWidth="180"
                                 hc:TitleElement.TitlePlacement="Left"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button x:Name="ActionButton"
                                    Content="Action"
                                    Command="{Binding VerifyCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Command="{Binding VerifyCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />

        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6*" />
                </Grid.RowDefinitions>
                <ListView x:Name="ListView"
                          ItemsSource="{Binding SelectReviewItem.Results}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <b:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </b:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="CalChip" DisplayMemberBinding="{Binding Key, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Header="Ecs" DisplayMemberBinding="{Binding Value.EcsValue, StringFormat={}{0:f3}}" />
                            <GridViewColumn Header="Quality" DisplayMemberBinding="{Binding Value.Quality, StringFormat={}{0:f3}}" />
                            <GridViewColumn Header="BrightFieldMachinePosition" DisplayMemberBinding="{Binding Value.BrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}, StringFormat={}{0:f3}}" />
                            <GridViewColumn Header="Action Review">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ButtonGroup>
                                            <Button Content="Goto BF"
                                                    Command="{Binding Path=DataContext.GotoBrightFieldPositionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Key}" />
                                        </hc:ButtonGroup>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="1" Height="5" />
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <TabControl>
                        <TabItem Header="Images">
                            <ListBox ItemsSource="{Binding SelectReviewItem.Results}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="300"
                                                Height="300"
                                                Style="{StaticResource BorderRegion}">
                                            <hc:SimplePanel>
                                                <view:CanvasView AxisColor="Red"
                                                                 BackgroundColor="#0A0A0A"
                                                                 BackgroundImage="{Binding Value.FilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                 Interactive="True"
                                                                 ShowAxes="False"
                                                                 ShowCursor="False"
                                                                 ShowGrid="False" />
                                                <TextBlock Text="{Binding Value.EcsValue, StringFormat='0.###'}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"
                                                           Foreground="Yellow" />
                                            </hc:SimplePanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>