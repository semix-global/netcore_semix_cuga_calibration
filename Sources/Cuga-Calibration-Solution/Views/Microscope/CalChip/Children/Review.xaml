<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:calChip="clr-namespace:Core.Models.Models.Microscope.CalChip;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Microscope Cal Chip: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown hc:TitleElement.Title="Dsw Alignment Threshold: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Increment="0.01"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.DSWAlignmentVerifyThreshold}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Bright Field Quality Threshold: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.BfQualityThreshold}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Dark Field Quality Threshold: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.DfQualityThreshold}" />
                    <TextBox Text="{Binding ResultMicroscopeCalChipDto.DSWAlignmentDegree, StringFormat={}{0:F6}}"
                             hc:TitleElement.Title="Alignment Verify Degree: "
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.TitlePlacement="Left"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.VerifyBrightFieldResultError}"
                             hc:TitleElement.Title="Bright Field Result Error: "
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.TitlePlacement="Left"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.VerifyDarkFieldResultError}"
                             hc:TitleElement.Title="Dark Field Result Error: "
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.TitlePlacement="Left"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <ListView d:SelectedIndex="0"
                      ItemsSource="{Binding ResultMicroscopeCalChipDto.Items}"
                      Style="{StaticResource ListView.Small}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <b:Interaction.Behaviors>
                    <behaviors:ListBoxScrollToCurrentBehavior />
                </b:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="100"
                                        Header="CalChip"
                                        DisplayMemberBinding="{Binding Key, Converter={StaticResource EnumDescriptionConverter}}" />
                        <GridViewColumn Width="120"
                                        Header="BrightFieldEcs"
                                        DisplayMemberBinding="{Binding Value.EcsValue, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="150"
                                        Header="BrightFieldQuality"
                                        DisplayMemberBinding="{Binding Value.BrightFieldQuality, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="200"
                                        Header="BrightFieldMachinePosition"
                                        DisplayMemberBinding="{Binding Value.BrightFieldMachinePosition, Converter={StaticResource PointToStringConverter}, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="120"
                                        Header="DarkFieldAfEcs"
                                        DisplayMemberBinding="{Binding Value.AfEcsValue, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="120"
                                        Header="DarkFieldAfMotor"
                                        DisplayMemberBinding="{Binding Value.AfMotorValue, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="150"
                                        Header="DarkFieldQuality"
                                        DisplayMemberBinding="{Binding Value.DarkFieldQuality, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="200"
                                        Header="DarkFieldMachinePosition"
                                        DisplayMemberBinding="{Binding Value.DarkFieldMachinePosition, Converter={StaticResource PointToStringConverter}, StringFormat={}{0:f3}}" />
                        <GridViewColumn Width="500" Header="Action Review">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ButtonGroup>
                                        <Button Content="BF Review"
                                                Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding BrightFieldFilePath}"
                                                d:DataContext="{d:DesignInstance Type=calChip:MicroscopeCalChipDtoItem}" />
                                        <Button Content="DF Review"
                                                Command="{Binding Path=DataContext.ReviewViewModel.ReviewCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding DarkFieldFilePath}"
                                                d:DataContext="{d:DesignInstance Type=calChip:MicroscopeCalChipDtoItem}" />
                                        <Button Content="Goto BF"
                                                Command="{Binding Path=DataContext.GotoBrightFieldPositionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding CalChipSiteModelEnum}"
                                                d:DataContext="{d:DesignInstance Type=calChip:MicroscopeCalChipDtoItem}" />
                                        <Button Content="Goto DF"
                                                Command="{Binding Path=DataContext.GotoDarkFieldPositionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                CommandParameter="{Binding CalChipSiteModelEnum}"
                                                d:DataContext="{d:DesignInstance Type=calChip:MicroscopeCalChipDtoItem}" />
                                    </hc:ButtonGroup>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>