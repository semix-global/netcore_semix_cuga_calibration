<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipCalibrationViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                            Orientation="Vertical"
                            Spacing="3">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
            <hc:Shield Subject="{Binding CalibrationStepIndex, StringFormat={}Cal Chip Step {0}:}"
                       Status="{Binding CalibrationStepName}"
                       Color="{StaticResource InfoBrush}" />
            <hc:Shield DockPanel.Dock="Bottom"
                       Subject="CalChip Mode: "
                       Status="{Binding Cache.CalChipSiteModelEnum}"
                       Color="{StaticResource SuccessBrush}" />
        </hc:UniformSpacingPanel>
        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel.Style>
                        <Style TargetType="hc:UniformSpacingPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:UniformSpacingPanel.Style>
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:ComboBox x:Name="LowMagCombobox"
                                 HorizontalAlignment="Left"
                                 hc:TitleElement.TitleWidth="150"
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.Title="Low Magnification: "
                                 SelectedItem="{Binding Cache.LowMicroscopeLensInformation, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding MagnificationSelectedCommand}" CommandParameter="{Binding ElementName=LowMagCombobox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                    <hc:ComboBox x:Name="HighMagCombobox"
                                 HorizontalAlignment="Left"
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.Title="High Magnification: "
                                 hc:TitleElement.TitleWidth="150"
                                 SelectedItem="{Binding Cache.HighMicroscopeLensInformation, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding MagnificationSelectedCommand}" CommandParameter="{Binding ElementName=HighMagCombobox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                </hc:UniformSpacingPanel>

                <StackPanel>
                    <TextBlock Text="Find Ecs Left Top Position"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Style="{StaticResource TextBlockDefaultInfo}" />
                </StackPanel>
                <TextBox Text="{Binding Cache.Item.LeftTopPosition, Converter={StaticResource PointToStringConverter}}"
                         Width="275"
                         hc:InfoElement.Title="Left-Top Position(um): "
                         hc:InfoElement.TitlePlacement="Left"
                         Style="{StaticResource TextBoxExtend}" />
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step0CalibrateActionCommand}"
                                CommandParameter="LeftTop"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step0CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </hc:UniformSpacingPanel>
        </Border>
    </hc:UniformSpacingPanel>
</UserControl>