<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:Shield Subject="{Binding CalibrationStepIndex, StringFormat={}Step {0}:}"
                               Status="{Binding CalibrationStepName}"
                               Color="{StaticResource InfoBrush}" />
                    <hc:Shield DockPanel.Dock="Bottom"
                               Subject="CalChip Mode: "
                               Status="{Binding Cache.CalChipSiteModelEnum}"
                               Color="{StaticResource SuccessBrush}" />
                    <hc:Shield DockPanel.Dock="Bottom"
                               Subject="Low Microscope Magnification: "
                               Status="{Binding Cache.LowMicroscopeLensInformation}"
                               Color="{StaticResource SuccessBrush}" />
                </hc:UniformSpacingPanel>
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <hc:UniformSpacingPanel.Style>
                                <Style TargetType="hc:UniformSpacingPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:UniformSpacingPanel.Style>
                            <StackPanel>
                                <TextBlock Text="Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:ComboBox x:Name="LowMagCombobox"
                                         HorizontalAlignment="Left"
                                         hc:TitleElement.TitleWidth="250"
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.Title="Low Magnification: "
                                         SelectedItem="{Binding Cache.LowMicroscopeLensInformation, UpdateSourceTrigger=PropertyChanged}"
                                         ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}" />
                            <hc:ComboBox x:Name="HighMagCombobox"
                                         HorizontalAlignment="Left"
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.Title="High Magnification: "
                                         hc:TitleElement.TitleWidth="250"
                                         SelectedItem="{Binding Cache.HighMicroscopeLensInformation, UpdateSourceTrigger=PropertyChanged}"
                                         ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}" />
                            <hc:ComboBox HorizontalAlignment="Left"
                                         hc:TitleElement.TitleWidth="250"
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.Title="Wafer Type: "
                                         SelectedItem="{Binding Cache.AlgorithmWaferTypeEnum}"
                                         ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmWaferTypeEnum}}}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                            </hc:ComboBox>
                        </hc:UniformSpacingPanel>

                        <StackPanel>
                            <TextBlock Text="Find Ecs Left Top Position"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox Text="{Binding Cache.Item.LeftTopMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.Title="Left-Top Position(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="250"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button Content="Action"
                                        Command="{Binding Step0Command}"
                                        CommandParameter="{x:Static stage:StageDirectionTypeEnum.UpLeft}"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button Content="Cancel"
                                        Command="{Binding Step0CancelCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>