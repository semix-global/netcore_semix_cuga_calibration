<UserControl x:Class="CugaCalibration.Views.Microscope.CalChip.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Microscope"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:stepCommon="clr-namespace:CugaCalibration.Views.Microscope.CalChip.Children.StepCommon"
             d:DataContext="{d:DesignInstance Type=viewModels:MicroscopeCalChipViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                               Status="{Binding CalibrationStepName}"
                               Color="{StaticResource InfoBrush}" />
                    <hc:Shield DockPanel.Dock="Bottom"
                               Subject="CalChip Mode: "
                               Status="{Binding Cache.CalChipSiteModelEnum}"
                               Color="{StaticResource SuccessBrush}" />
                    <hc:Shield DockPanel.Dock="Bottom"
                               Subject="Low Microscope Magnification: "
                               Status="{Binding Cache.LowMicroscopeLensInformation}"
                               Color="{StaticResource SuccessBrush}" />
                </hc:UniformSpacingPanel>
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <stepCommon:Step0CommonView />
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button Content="Action"
                                        Command="{Binding Step0Command}"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button Content="Cancel"
                                        Command="{Binding Step0CancelCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>