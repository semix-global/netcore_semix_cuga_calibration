<UserControl x:Class="CugaCalibration.Views.AutoFocus.CalChipFocusOffset.Children.StepCommon.Step1CommonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:autoFocus="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=autoFocus:AutoFocusCalChipFocusOffsetViewModel}"
             d:DesignWidth="450"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
            <hc:UniformSpacingPanel.Style>
                <Style TargetType="hc:UniformSpacingPanel">
                    <Setter Property="IsEnabled" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ChuckModel}">
                            <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </hc:UniformSpacingPanel.Style>
            <StackPanel>
                <TextBlock Text="Param"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Style="{StaticResource TextBlockDefaultInfo}" />
            </StackPanel>
            <hc:NumericUpDown hc:TitleElement.Title="Ecs Range(±ecs): "
                              hc:TitleElement.TitleWidth="180"
                              hc:TitleElement.TitlePlacement="Left"
                              Minimum="0"
                              Style="{StaticResource NumericUpDownExtend}"
                              Value="{Binding Cache.EcsRange}" />
            <hc:NumericUpDown hc:TitleElement.Title="Speed Ecs(ecs/s): "
                              hc:TitleElement.TitleWidth="180"
                              hc:TitleElement.TitlePlacement="Left"
                              Minimum="0"
                              Style="{StaticResource NumericUpDownExtend}"
                              Value="{Binding Cache.SpeedEcsPerSecond}" />
        </hc:UniformSpacingPanel>
        <StackPanel>
            <TextBlock Text="Result"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       FontWeight="Bold"
                       Style="{StaticResource TextBlockDefaultInfo}" />
        </StackPanel>
        <hc:NumericUpDown hc:TitleElement.Title="Ecs Value: "
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.TitleWidth="180"
                          IsReadOnly="True"
                          Background="{StaticResource SecondaryRegionBrush}"
                          Style="{StaticResource NumericUpDownExtend}"
                          Value="{Binding CalibratingItem.CurrentItem.ECSValue}" />
        <hc:NumericUpDown hc:TitleElement.Title="Motor Value: "
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.TitleWidth="180"
                          IsReadOnly="True"
                          Background="{StaticResource SecondaryRegionBrush}"
                          Style="{StaticResource NumericUpDownExtend}"
                          Value="{Binding CalibratingItem.CurrentItem.MotorValue}" />
    </hc:UniformSpacingPanel>
</UserControl>