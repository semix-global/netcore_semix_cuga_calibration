<UserControl x:Class="CugaCalibration.Views.AutoFocus.CalChipFocusOffset.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:autoFocus="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=autoFocus:AutoFocusCalChipFocusOffsetViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:Shield Subject="{Binding CalibrationStepIndex, StringFormat={}Step {0}:}"
                               Status="{Binding CalibrationStepName}"
                               Color="{StaticResource InfoBrush}" />
                    <hc:Shield DockPanel.Dock="Bottom"
                               Subject="CalChip Mode: "
                               Status="{Binding Cache.CalChipSiteModelEnum}"
                               Color="{StaticResource SuccessBrush}" />
                </hc:UniformSpacingPanel>
                <hc:Shield Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="1. Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <hc:UniformSpacingPanel.Style>
                                <Style TargetType="hc:UniformSpacingPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ChuckModel}">
                                            <Setter Property="IsEnabled" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:UniformSpacingPanel.Style>
                            <hc:NumericUpDown hc:TitleElement.Title="Half Length Ecs: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.HalfEcsLength}" />
                            <hc:NumericUpDown hc:TitleElement.Title="Speed Ecs(ecs/s): "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.SpeedEcsPerSecond}" />
                        </hc:UniformSpacingPanel>
                        <StackPanel>
                            <TextBlock Text="2. Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Ecs Value: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="180"
                                          IsReadOnly="True"
                                          Background="{StaticResource SecondaryRegionBrush}"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding CalibratingItem.CurrentItem.ECSValue}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Motor Value: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="180"
                                          IsReadOnly="True"
                                          Background="{StaticResource SecondaryRegionBrush}"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding CalibratingItem.CurrentItem.MotorValue}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step1Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step1CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="Plot">
            <ContentControl Content="{Binding CalibratingItem.CurrentItem.ScatterPlotControl, Mode=OneWay}" />
        </GroupBox>
    </Grid>
</UserControl>