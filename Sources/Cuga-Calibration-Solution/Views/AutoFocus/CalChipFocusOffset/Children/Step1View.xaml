<UserControl x:Class="CugaCalibration.Views.AutoFocus.CalChipFocusOffset.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:autoFocus="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
             d:DataContext="{d:DesignInstance Type=autoFocus:AutoFocusCalChipFocusOffsetViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:Shield Subject="{Binding CalibrationStepIndex, StringFormat={}Step {0}:}"
                               Status="{Binding CalibrationStepName}"
                               Color="{StaticResource InfoBrush}" />
                    <hc:Shield DockPanel.Dock="Bottom"
                               Subject="CalChip Mode: "
                               Status="{Binding Cache.CalChipSiteModelEnum}"
                               Color="{StaticResource SuccessBrush}" />
                </hc:UniformSpacingPanel>
                <hc:Shield Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Threshold(Pos): "
                                          hc:TitleElement.TitleWidth="250"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Value="{Binding Cache.MotorOffsetThreshold}">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ShinyWaferModel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.UndefinedModel}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ChuckModel}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <TextBox hc:TitleElement.Title="RTFC Servo Motor: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="250"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalibratingItem.DSWRuntimeAfCalibrationResultDTO.IsAFServo}" Value="{x:Static models:Constants.True}">
                                            <Setter Property="Text" Value="Af" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CalibratingItem.DSWRuntimeAfCalibrationResultDTO.IsAFServo}" Value="{x:Static models:Constants.False}">
                                            <Setter Property="Text" Value="Relay" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <hc:NumericUpDown hc:TitleElement.Title="Ecs Value: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="250"
                                          IsReadOnly="True"
                                          Background="{StaticResource SecondaryRegionBrush}">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                            <Setter Property="Value" Value="{Binding CalibratingItem.DSWRuntimeAfCalibrationResultDTO.ECSValue}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ChuckModel}">
                                            <Setter Property="Value" Value="{Binding CalibratingItem.ChuckRuntimeAfCalibrationResultDTO.ECSValue}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                            <Setter Property="Value" Value="{Binding CalibratingItem.HazeRuntimeAfCalibrationResultDTO.ECSValue}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.Title="Motor Value: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="250"
                                          IsReadOnly="True"
                                          Background="{StaticResource SecondaryRegionBrush}">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                            <Setter Property="Value" Value="{Binding CalibratingItem.DSWRuntimeAfCalibrationResultDTO.MotorValue}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ChuckModel}">
                                            <Setter Property="Value" Value="{Binding CalibratingItem.ChuckRuntimeAfCalibrationResultDTO.MotorValue}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                            <Setter Property="Value" Value="{Binding CalibratingItem.HazeRuntimeAfCalibrationResultDTO.MotorValue}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:NumericUpDown hc:TitleElement.Title="Dark Field Quality: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="250"
                                          IsReadOnly="True"
                                          Background="{StaticResource SecondaryRegionBrush}">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.DswModel}">
                                            <Setter Property="Value" Value="{Binding CalibratingItem.DSWRuntimeAfCalibrationResultDTO.DarkFieldQuality}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.ChuckModel}">
                                            <Setter Property="Value" Value="{Binding CalibratingItem.ChuckRuntimeAfCalibrationResultDTO.DarkFieldQuality}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Cache.CalChipSiteModelEnum}" Value="{x:Static stage:CalChipSiteModelEnum.HazeModel}">
                                            <Setter Property="Value" Value="{Binding CalibratingItem.HazeRuntimeAfCalibrationResultDTO.DarkFieldQuality}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step1Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step1CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>