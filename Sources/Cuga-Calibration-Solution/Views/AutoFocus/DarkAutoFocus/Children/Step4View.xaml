<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step4View "
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             d:DataContext="{d:DesignInstance Type=viewModels:AutoFocusDarkAutoFocusViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:NumericUpDown hc:TitleElement.Title="Start AF(mm): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.StartAFMotorAbsoluteValue}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Step AF(mm): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.StepAFMotorAbsoluteValue}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Stop AF(mm): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="190"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.StopAFMotorAbsoluteValue}" />
                    <TextBox Text="{Binding CalibratingItem.EcsMotorPositionRelationSlope, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:TitleElement.Title="Motor Calibration Result:(ecs/mm): "
                             hc:TitleElement.TitleWidth="210"
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step4CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step4CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <ContentControl Content="{Binding CalibratingItem.ScatterPlotControl, Mode=OneWay}" />
                <GridSplitter Grid.Row="1" Height="5" />
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>