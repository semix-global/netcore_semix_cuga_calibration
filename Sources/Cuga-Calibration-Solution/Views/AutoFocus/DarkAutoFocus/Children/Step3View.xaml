<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:darkAutoFocus="clr-namespace:Core.Models.Models.AutoFocus.DarkAutoFocus;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             d:DataContext="{d:DesignInstance Type=viewModels:AutoFocusDarkAutoFocusViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Half Length Ecs: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.HalfEcsLength}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Speed Ecs(ecs/s): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.SpeedEcsPerSecond}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Nsc Standard(nsc/nm): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          IsReadOnly="True"
                                          Background="{StaticResource SecondaryRegionBrush}"
                                          Value="{Binding Cache.NscStandardNscPerNm}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Retry Count: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.RetryCount}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Calibration Range (nsc/nm): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.CalibrationThresholdNscNscPerNmRange}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Calibration Symmetry Ratio: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.CalibrationThresholdNscSymmetryRatio}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Threshold Gain: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdNscStandardGain}" />
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step3CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step3CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="Calibration Data">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5*" />
                </Grid.RowDefinitions>
                <ListView x:Name="HistoryListView"
                          ItemsSource="{Binding CalibratingItem.NSCGainDTOItems}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Standard" DisplayMemberBinding="{Binding DataContext.CalibratingItem.NscStandard, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:F3}}" />
                            <GridViewColumn Header="Offset" DisplayMemberBinding="{Binding NscOffset, StringFormat={}{0:F3}}" />
                            <GridViewColumn Header="Gain" DisplayMemberBinding="{Binding NscGain, StringFormat={}{0:F3}}" />
                            <GridViewColumn Header="nsc/nm" DisplayMemberBinding="{Binding NscCurrentNscPerNm, StringFormat={}{0:F3}}" />
                            <GridViewColumn Header="Symmetry Ratio" DisplayMemberBinding="{Binding NscCurrentSymmetryRatio, StringFormat={}{0:F3}}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="1" Height="5" />
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <TabControl>
                        <TabItem Header="Plots">
                            <ListBox ItemsSource="{Binding SelectedItems, ElementName=HistoryListView}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type darkAutoFocus:DarkAutoFocusNSCDTO}">
                                        <Border Width="300"
                                                Height="300"
                                                Style="{StaticResource BorderRegion}">
                                            <ContentControl Content="{Binding ScatterPlotControl, Mode=OneWay}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Border>

            </Grid>
        </GroupBox>
    </Grid>

</UserControl>