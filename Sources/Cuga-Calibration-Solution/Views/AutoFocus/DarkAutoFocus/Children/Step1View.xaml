<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step1View "
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             d:DataContext="{d:DesignInstance Type=viewModels:AutoFocusDarkAutoFocusViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Range Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Range Ratio: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Maximum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.CalibratingThresholdRangeRatio}" />
                        <hc:NumericUpDown hc:TitleElement.Title="F Min: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdIdealFMin}" />
                        <hc:NumericUpDown hc:TitleElement.Title="F Max: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdIdealFMax}" />
                        <TextBox hc:TitleElement.Title="F Range: "
                                 hc:TitleElement.TitleWidth="100"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                    <Binding Path="Cache.CalibratingThresholdFMin" />
                                    <Binding Path="Cache.CalibratingThresholdFMax" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <hc:NumericUpDown hc:TitleElement.Title="N Min: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdIdealNMin}" />
                        <hc:NumericUpDown hc:TitleElement.Title="N Max: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdIdealNMax}" />
                        <TextBox hc:TitleElement.Title="N Range: "
                                 hc:TitleElement.TitleWidth="100"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                    <Binding Path="Cache.CalibratingThresholdNMin" />
                                    <Binding Path="Cache.CalibratingThresholdNMax" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <hc:NumericUpDown hc:TitleElement.Title="Current Min: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdCurrentMin}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Current Max: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Maximum="5500"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdCurrentMax}" />
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Current Start: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.FindCurrentStart}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Current Stop: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.FindCurrentStop}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Current Step: "
                                          hc:TitleElement.TitleWidth="100"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.FindCurrentStep}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Low LED Coefficient: "
                                          hc:TitleElement.TitleWidth="150"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.LowCoefficient}" />
                        <hc:NumericUpDown hc:TitleElement.Title="High LED Coefficient: "
                                          hc:TitleElement.TitleWidth="150"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.HighCoefficient}" />
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox Text="{Binding CalibratingItem.CurrentA, Mode=OneWay}"
                                 hc:TitleElement.Title="Current A: "
                                 hc:TitleElement.TitleWidth="100"
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}"
                                 IsReadOnly="False"
                                 Background="{StaticResource SecondaryRegionBrush}" />
                        <TextBox Text="{Binding CalibratingItem.CurrentB, Mode=OneWay}"
                                 hc:TitleElement.Title="Current B: "
                                 hc:TitleElement.TitleWidth="100"
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}"
                                 IsReadOnly="False"
                                 Background="{StaticResource SecondaryRegionBrush}" />
                        <TextBox Text="{Binding CalibratingItem.Fa, Mode=OneWay}"
                                 hc:TitleElement.Title="FA: "
                                 hc:TitleElement.TitleWidth="100"
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}"
                                 IsReadOnly="False"
                                 Background="{StaticResource SecondaryRegionBrush}" />
                        <TextBox Text="{Binding CalibratingItem.Fb, Mode=OneWay}"
                                 hc:TitleElement.Title="FB: "
                                 hc:TitleElement.TitleWidth="100"
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}"
                                 IsReadOnly="False"
                                 Background="{StaticResource SecondaryRegionBrush}" />
                        <TextBox Text="{Binding CalibratingItem.Na, Mode=OneWay}"
                                 hc:TitleElement.Title="NA: "
                                 hc:TitleElement.TitleWidth="100"
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}"
                                 IsReadOnly="False"
                                 Background="{StaticResource SecondaryRegionBrush}" />
                        <TextBox Text="{Binding CalibratingItem.Nb, Mode=OneWay}"
                                 hc:TitleElement.Title="NB: "
                                 hc:TitleElement.TitleWidth="100"
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}"
                                 IsReadOnly="False"
                                 Background="{StaticResource SecondaryRegionBrush}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step1CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step1CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView ItemsSource="{Binding CalibratingItem.CurrentADTO.CurrentItems}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="100"
                                                Header="Current A"
                                                DisplayMemberBinding="{Binding Current, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100"
                                                Header="FA"
                                                DisplayMemberBinding="{Binding F, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100"
                                                Header="NA"
                                                DisplayMemberBinding="{Binding N, StringFormat={}{0:f3}}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListView Grid.Column="2"
                              ItemsSource="{Binding CalibratingItem.CurrentBDTO.CurrentItems}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="100"
                                                Header="Current B"
                                                DisplayMemberBinding="{Binding Current, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100"
                                                Header="FB"
                                                DisplayMemberBinding="{Binding F, StringFormat={}{0:f3}}" />
                                <GridViewColumn Width="100"
                                                Header="NB"
                                                DisplayMemberBinding="{Binding N, StringFormat={}{0:f3}}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
                <GridSplitter Grid.Row="1" Height="5" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Current A">
                        <ContentControl Content="{Binding CalibratingItem.CurrentADTO.ScatterPlotControl, Mode=OneWay}" />
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Current B">
                        <ContentControl Content="{Binding CalibratingItem.CurrentBDTO.ScatterPlotControl, Mode=OneWay}" />
                    </GroupBox>
                </Grid>

            </Grid>
        </GroupBox>
    </Grid>
</UserControl>