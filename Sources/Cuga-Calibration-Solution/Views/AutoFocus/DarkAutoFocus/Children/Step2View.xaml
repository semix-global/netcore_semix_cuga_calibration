<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:autoFocus="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             d:DataContext="{d:DesignInstance Type=autoFocus:AutoFocusDarkAutoFocusViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Step 3: "
                           Status="{Binding CalibrationStepList[2].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Position: "
                           Status="{Binding Cache.FindPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <hc:NumericUpDown 
                                              hc:TitleElement.Title="Half Length Ecs: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.HalfEcsLength}" />
                            <hc:NumericUpDown 
                                              hc:TitleElement.Title="Speed Ecs(ecs/s): "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.SpeedEcsPerSecond}" />
                            <hc:NumericUpDown 
                                              hc:TitleElement.Title="Nsc Standard(nsc/nm): "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.NscStandardNscPerNm}" />
                            <hc:NumericUpDown 
                                              hc:TitleElement.Title="Threshold Symmetry Ratio: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.ThresholdNscStandardSymmetryRatio}" />
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step2CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step2CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <Border Grid.Column="2" Style="{StaticResource BorderRegion}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding CalibratingItem.IsNscUseMaxValue}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Is Use Max: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.IsNscUsePositiveSlope}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Is Use Positive: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.OriginalSymmetryRatio, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Original Symmetry Ratio: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.EcsToNmRange, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Ecs Range(nm): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.NscStandard, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Standard(nsc): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                    </hc:UniformSpacingPanel>
                    <GridSplitter Grid.Row="1" />
                    <GroupBox Grid.Row="2" Header="Plot">
                        <ContentControl Content="{Binding CalibratingItem.NSCProfileResultDTO.ScatterPlotControl, Mode=OneWay}" />
                    </GroupBox>
                </Grid>

            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>