<UserControl x:Class="CugaCalibration.Views.Laser.AutoFocus.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             xmlns:scottplot="http://schemas.scottplot.net/2008/xaml/presentation"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             d:DataContext="{d:DesignInstance Type=viewModels:AutoFocusDarkAutoFocusViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review: " Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Verify"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Range Ratio: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Maximum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ReviewThresholdRangeRatio}" />
                        <hc:NumericUpDown hc:TitleElement.Title="F Min: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdIdealFMin}" />
                        <hc:NumericUpDown hc:TitleElement.Title="F Max: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdIdealFMax}" />
                        <TextBox hc:TitleElement.Title="F Range: "
                                 hc:TitleElement.TitleWidth="180"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                    <Binding Path="Cache.ReviewThresholdFMin" />
                                    <Binding Path="Cache.ReviewThresholdFMax" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <hc:NumericUpDown hc:TitleElement.Title="N Min: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdIdealNMin}" />
                        <hc:NumericUpDown hc:TitleElement.Title="N Max: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ThresholdIdealNMax}" />
                        <TextBox hc:TitleElement.Title="N Range: "
                                 hc:TitleElement.TitleWidth="180"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}[{0:f3}, {1:f3}]" Mode="OneWay">
                                    <Binding Path="Cache.ReviewThresholdNMin" />
                                    <Binding Path="Cache.ReviewThresholdNMax" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                        <hc:NumericUpDown hc:TitleElement.Title="Calibration Range (nsc/nm): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.CalibrationThresholdNscNscPerNmRange}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Calibration Symmetry Ratio: "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.CalibrationThresholdNscSymmetryRatio}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button x:Name="ActionButton"
                                    Content="Action"
                                    Command="{Binding VerifyActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Command="{Binding VerifyActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="2">
                        <UniformGrid.Resources>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Setter Property="Margin" Value="5" />
                            </Style>
                        </UniformGrid.Resources>
                        <TextBox Text="{Binding Review.CurrentA, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="CurrentA: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBlock />
                        <TextBox Text="{Binding Review.Na, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="NA: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.Fa, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="FA: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.CurrentB, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="CurrentB: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBlock />
                        <TextBox Text="{Binding Review.Nb, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="NB: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.Fb, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="FB: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.IsNscUseMaxValue, Mode=OneWay}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Is Use Max: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.IsNscUsePositiveSlope, Mode=OneWay}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Is Use Positive: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.OriginalSymmetryRatio, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Original Symmetry Ratio: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBlock />
                        <TextBox Text="{Binding Review.EcsToNmRange, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Ecs Range(nm): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.NscStandard, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Standard(nsc): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.NSCGainResultDTO.NscOffset, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Offset: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.NSCGainResultDTO.NscGain, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Gain: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.NSCGainResultDTO.NscCurrentNscPerNm, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc(nsc/nm): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        <TextBox Text="{Binding Review.NSCGainResultDTO.NscCurrentSymmetryRatio, Mode=OneWay, StringFormat={}{0:f3}}"
                                 Width="375"
                                 Height="25"
                                 hc:TitleElement.Title="Nsc Symmetry Ratio: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="200"
                                 IsReadOnly="True"
                                 Foreground="{Binding Review.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                    </UniformGrid>
                    <scottplot:WpfPlot Grid.Row="2">
                        <b:Interaction.Behaviors>
                            <behaviors:WpfPlotMultiBehavior Title="Trace Buffer"
                                                            Plot0Title="Original ECS"
                                                            Plot0Color="{x:Static scottPlot:Colors.LightGreen}"
                                                            Plot0="{Binding Review.NSCGainResultDTO.CalibrationEcs, Converter={StaticResource DoublesToPointsConverter}}"
                                                            Plot1Title="Original NSC"
                                                            Plot1Color="{x:Static scottPlot:Colors.LightBlue}"
                                                            Plot1="{Binding Review.NSCGainResultDTO.CalibrationNsc, Converter={StaticResource DoublesToPointsConverter}}"
                                                            Plot2Title="Original Lvdt"
                                                            Plot2Color="{x:Static scottPlot:Colors.LightCoral}"
                                                            Plot2="{Binding Review.NSCGainResultDTO.CalibrationLvdt, Converter={StaticResource DoublesToPointsConverter}}"
                                                            Plot3Title="Calibration ECS"
                                                            Plot3Color="{x:Static scottPlot:Colors.LightGreen}"
                                                            Plot3="{Binding Calibration.NSCGainResultDTO.CalibrationEcs, Converter={StaticResource DoublesToPointsConverter}}"
                                                            Plot4Title="Calibration NSC"
                                                            Plot4Color="{x:Static scottPlot:Colors.LightBlue}"
                                                            Plot4="{Binding Calibration.NSCGainResultDTO.CalibrationNsc, Converter={StaticResource DoublesToPointsConverter}}"
                                                            Plot5Title="Calibration Lvdt"
                                                            Plot5Color="{x:Static scottPlot:Colors.LightCoral}"
                                                            Plot5="{Binding Calibration.NSCGainResultDTO.CalibrationLvdt, Converter={StaticResource DoublesToPointsConverter}}" />
                        </b:Interaction.Behaviors>
                    </scottplot:WpfPlot>

                </Grid>
            </Border>
        </GroupBox>
    </Grid>
</UserControl>