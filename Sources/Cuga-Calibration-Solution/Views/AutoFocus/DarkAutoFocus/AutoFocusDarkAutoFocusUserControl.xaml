<UserControl x:Class="CugaCalibration.Views.AutoFocus.DarkAutoFocus.AutoFocusDarkAutoFocusUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:children="clr-namespace:CugaCalibration.Views.Laser.AutoFocus.Children"
             xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
             d:DataContext="{d:DesignInstance Type=viewModels:AutoFocusDarkAutoFocusViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1920"
             mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsLoadingToVisibilityConverter}}">
                    <hc:LoadingCircle Width="200"
                                      Height="200"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource LoadingCircleLarge}" />
                </Grid>
                <Grid Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsWelcomeToVisibilityConverter}}">
                    <TextBlock Text="Welcome to calibration!" Style="{StaticResource TextBlockLargeBold}" />
                </Grid>
                <Grid Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsCalibrationToVisibilityConverter}}">
                    <children:Step0View Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs0ToVisibilityConverter}}" />
                    <children:Step1View Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs1ToVisibilityConverter}}" />
                    <children:Step2View Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs2ToVisibilityConverter}}" />
                    <children:Step3View Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs3ToVisibilityConverter}}" />
                    <children:Step4View Visibility="{Binding CalibrationStepIndex, Converter={StaticResource IntIs4ToVisibilityConverter}}" />
                </Grid>
                <Grid Visibility="{Binding ViewEnum, Converter={StaticResource CalibrationItemViewEnumIsReviewToVisibilityConverter}}">
                    <children:Review />
                </Grid>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="5" />
        <Border Grid.Column="2" Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Instructions"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextBlockLargeBold}" />
                <RichTextBox Grid.Row="1"
                             Margin="5"
                             Padding="5"
                             FontSize="14"
                             IsReadOnly="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <FlowDocument>
                        <Paragraph>
                            <Run Text="1. Test the NSC curve, obtain the upper and lower limits of the curve, and determine whether the upper and lower limits of the curve are greater than 0.25. If so, proceed to the next step, otherwise it will return to calibration failure;" />
                            <LineBreak />
                            <Run Text="2. Switch NSC working mode;" />
                            <LineBreak />
                            <Run Text="3. Read the values of Fa, Fb, Na, and Nb and determine whether these four values ​​are within the interval (13000&lt;Na, Nb&lt;16000; 6500&lt;Fa, Fb&lt;8000);" />
                            <LineBreak />
                            <Run Text="4. If the values of Na and Fa are low or high, increase or decrease the current value of lamp A. If the current value of lamp A increases to the upper limit (550mA), the values ​​of Na and Fa still do not reach the set range. Return calibration failed.If the values ​​of Nb and Fb are low or high, increase or decrease the current value of lamp B. If the current value of lamp B increases to the upper limit, the values ​​of Na and Fa still do not reach the set range, and the calibration fails." />
                            <LineBreak />
                        </Paragraph>
                        <Paragraph>
                            <Hyperlink>https://www.semixchina.com</Hyperlink>
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>
                <hc:StepBar Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="10"
                            StepIndex="{Binding CalibrationStepIndex}"
                            ItemsSource="{Binding CalibrationStepList}">
                    <hc:StepBar.ItemTemplate>
                        <DataTemplate />
                    </hc:StepBar.ItemTemplate>
                </hc:StepBar>
                <ProgressBar Grid.Row="3"
                             Margin="5"
                             Style="{StaticResource ProgressBarSuccess}"
                             Value="{Binding CalibrationProgress, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>