<UserControl x:Class="CugaCalibration.Views.AutoFocus.FAFBCompensation.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.AutoFocus"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
             d:DataContext="{d:DesignInstance Type=viewModels:AutoFocusFAFBCompensationViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Microscope Lens Information: "
                           Status="{Binding Cache.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="±Range(ECS): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.RangeECS}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Speed(ecs/s): "
                                          hc:TitleElement.TitleWidth="180"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.SpeedECSPerSecond}" />
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Slopes Params"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                                <Button Content="Add"
                                        Command="{Binding AddAutoFocusFAFBCompensationCacheItemCommand}"
                                        hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                        Style="{StaticResource ButtonInfo}" />
                                <Button Content="Delete"
                                        Command="{Binding RemoveAutoFocusFAFBCompensationCacheItemCommand}"
                                        CommandParameter="{Binding Path=SelectedItems, ElementName=DataGridAutoFocusFAFBCompensationCacheItems}"
                                        hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                                        Style="{StaticResource ButtonDanger}" />
                            </hc:UniformSpacingPanel>
                            <DataGrid x:Name="DataGridAutoFocusFAFBCompensationCacheItems"
                                      MaxHeight="500"
                                      hc:DataGridAttach.ShowRowNumber="True"
                                      Style="{StaticResource DataGrid.Small}"
                                      HeadersVisibility="All"
                                      RowHeaderWidth="60"
                                      CanUserSortColumns="False"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding Cache.Items}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="150"
                                                        Header="Points"
                                                        Binding="{Binding DSWFindBrightMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                    <DataGridTemplateColumn Width="150" Header="Actions">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Mark"
                                                        Command="{Binding DataContext.MarkDSWFindBrightMachinePositionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </hc:UniformSpacingPanel>
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultSuccess}" />
                        </StackPanel>
                        <TextBox Text="{Binding CalibratingItem.KA, StringFormat='0.###', Mode=OneWay}"
                                 hc:TitleElement.Title="KA: "
                                 hc:TitleElement.TitleWidth="200"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.OffsetA, StringFormat='0.###', Mode=OneWay}"
                                 hc:TitleElement.Title="OffsetA: "
                                 hc:TitleElement.TitleWidth="200"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.KB, StringFormat='0.###', Mode=OneWay}"
                                 hc:TitleElement.Title="KB: "
                                 hc:TitleElement.TitleWidth="200"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.OffsetB, StringFormat='0.###', Mode=OneWay}"
                                 hc:TitleElement.Title="OffsetB: "
                                 hc:TitleElement.TitleWidth="200"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step2Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step2CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <Border Style="{StaticResource BorderRegion}">
                <v2:PlotControl DataSource="{Binding CalibratingItem.CalibratingPlotDataSource}" />
            </Border>
        </GroupBox>
    </Grid>
</UserControl>