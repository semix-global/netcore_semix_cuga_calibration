<UserControl x:Class="CugaCalibration.Views.Optics.Relay.Children.Step6View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Optics"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:relay="clr-namespace:Core.Models.Models.Optics.Relay;assembly=Core.Models"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Optics;assembly=Core.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:darkField="clr-namespace:Core.Models.Models.Common.DarkField;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:OpticsRelayViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical"
                                    Spacing="2"
                                    Visibility="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2VisibilityReConverter}}">
                <hc:Shield Subject="Step 7: "
                           Status="{Binding CalibrationStepList[6].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Optics Illumination Mode: "
                           Status="{Binding Cache.OpticsIlluminationModeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Productivity Information: "
                           Status="{Binding Cache.Item.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Laser Light: "
                           Status="{Binding Cache.Item.LaserLightInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="CIB Information: "
                           Status="{Binding Cache.Item.CIBInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="XZ DSW BF Machine Position(um): "
                           Status="{Binding Cache.Item.XZDSWFindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Scan Length(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.XZScanLength}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Start X/Z Sync Relay(mm): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.StartXZRelayMotorAbsoluteValue}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Step X/Z Sync Relay(mm): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.StepXZRelayMotorAbsoluteValue}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Stop X/Z Sync Relay(mm): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.StopXZRelayMotorAbsoluteValue}" />
                        <hc:NumericUpDown hc:TitleElement.Title="X/Z Sync Center(ECS): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.XZCenterECS}" />
                        <hc:NumericUpDown hc:TitleElement.Title="X/Z Sync ±Range(ECS): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.XZRangeECS}" />
                        <ComboBox hc:TitleElement.TitleWidth="190"
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.Title="X/Z Sync Quality Type: "
                                  Style="{StaticResource ComboBoxExtend}"
                                  SelectedItem="{Binding Cache.Item.OpticsStrehlRatioQualityTypeEnum}"
                                  ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:OpticsStrehlRatioQualityTypeEnum}}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <hc:NumericUpDown hc:TitleElement.Title="Threshold(RSquared): "
                                          hc:TitleElement.TitleWidth="190"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Maximum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Threshold}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step6Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step6CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <ListView x:Name="ListView"
                          ItemsSource="{Binding CalibratingItem.XZItems}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Relay(mm)" DisplayMemberBinding="{Binding RelayMotorAbsoluteValue, StringFormat='0.###'}" />
                            <GridViewColumn Header="Best X Strehl ECS" DisplayMemberBinding="{Binding BestFocus.BestXStrehlRatioECS, StringFormat='0.###'}" />
                            <GridViewColumn Header="Best Y Strehl ECS" DisplayMemberBinding="{Binding BestFocus.BestYStrehlRatioECS, StringFormat='0.###'}" />
                            <GridViewColumn Width="400" Header="Raw File Path">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type relay:OpticsRelayDTOXZItem}">
                                        <TextBlock TextWrapping="Wrap">
                                            <Hyperlink Command="{x:Static wpf:Commands.OpenFilePathCommand}" CommandParameter="{Binding BestFocus.RawImageFilePath}">
                                                <Run Text="{Binding BestFocus.RawImageFilePath}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="1" Height="5" />
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <TabControl>
                        <TabItem Header="Plots">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
                                <ContentControl Content="{Binding CalibratingItem.XZScatterPlotControl, Mode=OneWay}" />
                            </Border>
                        </TabItem>
                        <TabItem Header="X/Z Sync Plots">
                            <ListBox Margin="5"
                                     HorizontalContentAlignment="Stretch"
                                     ItemsSource="{Binding SelectedItems, ElementName=ListView}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type relay:OpticsRelayDTOXZItem}">
                                        <Border Height="400" Style="{StaticResource BorderRegion}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding RelayMotorAbsoluteValue, StringFormat={}{0:0.###}(mm)}"
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource TextBlockSubTitleBold}"
                                                           Foreground="{StaticResource SuccessBrush}" />
                                                <darkField:BestFocusUserControl Grid.Row="1" DataContext="{Binding BestFocus}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>