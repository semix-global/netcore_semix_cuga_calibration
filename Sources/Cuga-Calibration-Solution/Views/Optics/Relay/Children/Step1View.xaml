<UserControl x:Class="CugaCalibration.Views.Optics.Relay.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Optics"
             xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:OpticsRelayViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical"
                                    Spacing="2"
                                    Visibility="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2VisibilityReConverter}}">
                <hc:Shield Subject="Optics Relay Step 2: "
                           Status="{Binding CalibrationStepList[0].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Illumination Mode: "
                           Status="{Binding Cache.OpticsIlluminationModeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <ComboBox hc:TitleElement.Title="Microscope Lens: "
                              hc:TitleElement.TitlePlacement="Left"
                              hc:TitleElement.TitleWidth="190"
                              SelectedItem="{Binding Cache.MicroscopeLensInformation}"
                              Style="{StaticResource ComboBoxExtend.ReadOnlyEditable}"
                              ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}">
                        <i:Interaction.Behaviors>
                            <wpf:ComboBoxFallbackBehavior FallbackDisplayText="{Binding Source={x:Static pattern:MicroscopeLensInformation.Default}}" FallbackSelectItem="{x:Static pattern:MicroscopeLensInformation.Default}" />
                        </i:Interaction.Behaviors>
                    </ComboBox>
                    <ComboBox hc:TitleElement.Title="Productivity Information: "
                              hc:TitleElement.TitlePlacement="Left"
                              hc:TitleElement.TitleWidth="190"
                              SelectedItem="{Binding Cache.Item.ProductivityInformation}"
                              Style="{StaticResource ComboBoxExtend.ReadOnlyEditable}">
                        <i:Interaction.Behaviors>
                            <wpf:ComboBoxFallbackBehavior FallbackDisplayText="{Binding Source={x:Static pattern:ProductivityInformation.Default}}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                        </i:Interaction.Behaviors>
                        <ComboBox.ItemsSource>
                            <MultiBinding Converter="{StaticResource MultiApplicationCookieToProductivityInformationsConvert}">
                                <Binding Path="ApplicationCookie" />
                                <Binding Path="Cache.OpticsIlluminationModeEnum" />
                            </MultiBinding>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                    <ComboBox hc:TitleElement.Title="Laser Light Information: "
                              hc:TitleElement.TitlePlacement="Left"
                              hc:TitleElement.TitleWidth="190"
                              SelectedItem="{Binding Cache.Item.LaserLightInformation}"
                              Style="{StaticResource ComboBoxExtend.ReadOnlyEditable}"
                              ItemsSource="{Binding ApplicationCookie.LaserLightInformations}">
                        <i:Interaction.Behaviors>
                            <wpf:ComboBoxFallbackBehavior FallbackDisplayText="{Binding Source={x:Static pattern:LaserLightInformation.Default}}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                        </i:Interaction.Behaviors>
                    </ComboBox>
                    <ComboBox hc:TitleElement.Title="CIB Information: "
                              hc:TitleElement.TitlePlacement="Left"
                              hc:TitleElement.TitleWidth="190"
                              SelectedItem="{Binding Cache.Item.CIBInformation}"
                              Style="{StaticResource ComboBoxExtend.ReadOnlyEditable}"
                              ItemsSource="{Binding ApplicationCookie.CIBInformations}">
                        <i:Interaction.Behaviors>
                            <wpf:ComboBoxFallbackBehavior FallbackDisplayText="{Binding Source={x:Static pattern:CIBInformation.Default}}" FallbackSelectItem="{x:Static pattern:CIBInformation.Default}" />
                        </i:Interaction.Behaviors>
                    </ComboBox>
                    <tools:CibGrabModeTypeUserControl DataContext="{Binding Cache.Item.CIBConfiguration}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>