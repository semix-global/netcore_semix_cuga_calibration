<UserControl x:Class="CugaCalibration.Views.Optics.SC.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Optics"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:OpticsSCViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Optics Illumination Mode: "
                           Status="{Binding Cache.OpticsIlluminationModeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Productivity Information: "
                           Status="{Binding Cache.Item.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Laser Light: "
                           Status="{Binding Cache.Item.LaserLightInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="CIB Information: "
                           Status="{Binding Cache.Item.CIBInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Result: Alignment Setting Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultSuccess}" />
                            </StackPanel>
                            <TextBox Text="{Binding MicroscopeCalChipCache.LowSite1.Location, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.Title="Low Site1(um): "
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Background="{StaticResource SecondaryRegionBrush}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding MicroscopeCalChipCache.LowSite2.Location, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.Title="Low Site2(um): "
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Background="{StaticResource SecondaryRegionBrush}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding MicroscopeCalChipCache.HighSite1.Location, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.Title="High Site1(um): "
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Background="{StaticResource SecondaryRegionBrush}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding MicroscopeCalChipCache.HighSite2.Location, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.Title="High Site2(um): "
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="150"
                                     IsReadOnly="True"
                                     Background="{StaticResource SecondaryRegionBrush}"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:UniformSpacingPanel Spacing="10">
                                <view:CanvasView Width="100"
                                                 Height="100"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding MicroscopeCalChipCache.LowSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                                <view:CanvasView Width="100"
                                                 Height="100"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding MicroscopeCalChipCache.HighSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>
                        <TextBox Text="{Binding Cache.Item.AlignmentResult.Degrees, StringFormat='0.##########'}"
                                 hc:TitleElement.Title="Alignment Degrees(°): "
                                 hc:TitleElement.TitleWidth="150"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step2Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step2CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>