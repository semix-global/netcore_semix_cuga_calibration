<UserControl x:Class="CugaCalibration.Views.Optics.SC.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Optics"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:relay="clr-namespace:Core.Models.Models.Optics.SC;assembly=Core.Models"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:darkField="clr-namespace:Core.Models.Models.Common.DarkField;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:OpticsSCViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Optics Illumination Mode: "
                           Status="{Binding Cache.OpticsIlluminationModeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Productivity Information: "
                           Status="{Binding Cache.Item.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Laser Light: "
                           Status="{Binding Cache.Item.LaserLightInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="CIB Information: "
                           Status="{Binding Cache.Item.CIBInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="XZ DSW BF Machine Position(um): "
                           Status="{Binding Cache.Item.DSWFindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Scan Length(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.ScanLength}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Start(λ): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.StartLambda}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Step(λ): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.StepLambda}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Stop(λ): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.StopLambda}" />
                        <hc:NumericUpDown hc:TitleElement.Title="λ to L1 Coefficient: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.LambdaToL1Coefficient}" />
                        <hc:NumericUpDown hc:TitleElement.Title="λ to L3 Coefficient: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.LambdaToL3Coefficient}" />
                        <hc:NumericUpDown hc:TitleElement.Title="L1 Center(mm): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.SCMotorAbsoluteValueL1Center}" />
                        <hc:NumericUpDown hc:TitleElement.Title="L3 Center(mm): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.SCMotorAbsoluteValueL3Center}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="L1 =&gt; L2: "
                                       Width="190"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <ToggleButton IsChecked="{Binding Cache.Item.IsL1ToL2Direction}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="{StaticResource DangerBrush}"
                                          Style="{StaticResource ToggleButtonSwitch}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="L2 =&gt; L3: "
                                       Width="190"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <ToggleButton IsChecked="{Binding Cache.Item.IsL2ToL3Direction}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="{StaticResource DangerBrush}"
                                          Style="{StaticResource ToggleButtonSwitch}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="X/Z Sync Center(ECS): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.CenterECS}" />
                        <hc:NumericUpDown hc:TitleElement.Title="X/Z Sync ±Range(ECS): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.RangeECS}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step4Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step4CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <ListView x:Name="ListView"
                          ItemsSource="{Binding CalibratingItem.Items}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="80"
                                            Header="λ"
                                            DisplayMemberBinding="{Binding Lambda, StringFormat='0.###'}" />
                            <GridViewColumn Header="Y Strehl" DisplayMemberBinding="{Binding BestFocus.BestYStrehlRatioPoint, Converter={StaticResource PointYToStringConverter}, ConverterParameter='0.###'}" />
                            <GridViewColumn Header="X Strehl" DisplayMemberBinding="{Binding BestFocus.BestXStrehlRatioPoint, Converter={StaticResource PointYToStringConverter}, ConverterParameter='0.###'}" />
                            <GridViewColumn Header="Spot Area Percent" DisplayMemberBinding="{Binding BestFocus.SpotAreaPercentMean, StringFormat='0.###'}" />
                            <GridViewColumn Header="L1(mm)" DisplayMemberBinding="{Binding SCMotorAbsoluteValueL1, StringFormat='0.###'}" />
                            <GridViewColumn Header="L3(mm)" DisplayMemberBinding="{Binding SCMotorAbsoluteValueL3, StringFormat='0.###'}" />
                            <GridViewColumn Header="Best X Strehl ECS" DisplayMemberBinding="{Binding BestFocus.BestXStrehlRatioECS, StringFormat='0.###'}" />
                            <GridViewColumn Header="Best Y Strehl ECS" DisplayMemberBinding="{Binding BestFocus.BestYStrehlRatioECS, StringFormat='0.###'}" />
                            <GridViewColumn Width="400" Header="Raw File Path">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type relay:OpticsSCDTOItem}">
                                        <TextBlock TextWrapping="Wrap">
                                            <Hyperlink Command="{x:Static wpf:Commands.OpenFilePathCommand}" CommandParameter="{Binding BestFocus.RawImageFilePath}">
                                                <Run Text="{Binding BestFocus.RawImageFilePath}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="1" Height="5" />
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <TabControl>
                        <TabItem Header="Plots">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
                                <ContentControl Content="{Binding CalibratingItem.ScatterPlotControl, Mode=OneWay}" />
                            </Border>
                        </TabItem>
                        <TabItem Header="X/Z Sync Plots">
                            <ListBox Margin="5"
                                     HorizontalContentAlignment="Stretch"
                                     ItemsSource="{Binding SelectedItems, ElementName=ListView}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type relay:OpticsSCDTOItem}">
                                        <Border Height="400" Style="{StaticResource BorderRegion}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock HorizontalAlignment="Center"
                                                           Style="{StaticResource TextBlockSubTitleBold}"
                                                           Foreground="{StaticResource SuccessBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:0.###}(λ) L1: {1:0.###}(mm) L3: {2:0.###}(mm)">
                                                            <Binding Path="Lambda" />
                                                            <Binding Path="SCMotorAbsoluteValueL1" />
                                                            <Binding Path="SCMotorAbsoluteValueL3" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <darkField:BestFocusUserControl Grid.Row="1" DataContext="{Binding BestFocus}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>