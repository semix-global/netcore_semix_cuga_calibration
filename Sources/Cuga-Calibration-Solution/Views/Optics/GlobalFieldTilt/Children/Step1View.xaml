<UserControl x:Class="CugaCalibration.Views.Optics.GlobalFieldTilt.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:optics="clr-namespace:CugaCalibration.ViewModels.Optics"
             xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=optics:OpticsGlobalFieldTiltViewModel}"
             d:DesignHeight="1080"
             d:DesignWidth="1920"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ListboxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <!--  默认边框颜色  -->
            <Setter Property="BorderBrush" Value="Transparent" />
            <!--  默认边框厚度  -->
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <!--  选中项的边框颜色  -->
                    <Setter Property="Background" Value="Gray" />
                </Trigger>
                <Trigger Property="IsSelected" Value="False">
                    <!--  未选中项的边框颜色  -->
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <!--  鼠标悬停时的边框颜色  -->
                    <Setter Property="Background" Value="LightGray" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Status="{Binding Cache.Item.ProductivityInformation}"
                           Subject="Productivity: "
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Status="{Binding Cache.MicroscopeLensInformation.LensName}"
                           Subject="Microscope Magnification: "
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                                    <Expander ExpandDirection="Down"
                                              Header="Configuration"
                                              IsExpanded="False">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <StackPanel>
                                                <TextBlock Text="Param"
                                                           HorizontalAlignment="Center"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Style="{StaticResource TextBlockDefaultInfo}" />
                                            </StackPanel>
                                            <ComboBox hc:TitleElement.Title="Microscope Lens: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="190"
                                                      ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}"
                                                      Style="{StaticResource ComboBoxExtend}">
                                                <i:Interaction.Behaviors>
                                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.MicroscopeLensInformation}" FallbackSelectItem="{x:Static pattern:MicroscopeLensInformation.Default}" />
                                                </i:Interaction.Behaviors>
                                            </ComboBox>
                                            <ComboBox hc:TitleElement.Title="Productivity Information: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="190"
                                                      Style="{StaticResource ComboBoxExtend}">
                                                <i:Interaction.Behaviors>
                                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.Item.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                                                </i:Interaction.Behaviors>
                                                <ComboBox.ItemsSource>
                                                    <MultiBinding Converter="{StaticResource MultiApplicationCookieToProductivityInformationsConvert}">
                                                        <Binding Path="ApplicationCookie" />
                                                        <Binding Path="Cache.OpticsIlluminationModeEnum" />
                                                    </MultiBinding>
                                                </ComboBox.ItemsSource>
                                            </ComboBox>
                                            <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="190"
                                                      ItemsSource="{Binding ApplicationCookie.LaserLightInformations}"
                                                      Style="{StaticResource ComboBoxExtend}">
                                                <i:Interaction.Behaviors>
                                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.Item.LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                                                </i:Interaction.Behaviors>
                                            </ComboBox>
                                            <ComboBox hc:TitleElement.Title="CIB Information: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="190"
                                                      ItemsSource="{Binding ApplicationCookie.CIBInformations}"
                                                      Style="{StaticResource ComboBoxExtend}">
                                                <i:Interaction.Behaviors>
                                                    <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.Item.CIBInformation}" FallbackSelectItem="{x:Static pattern:CIBInformation.Default}" />
                                                </i:Interaction.Behaviors>
                                            </ComboBox>
                                            <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.Item.OpticsConfiguration}" />
                                            <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.Item.CIBConfiguration}" />
                                        </hc:UniformSpacingPanel>
                                    </Expander>
                                </Border>
                                <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                                    <Expander ExpandDirection="Down"
                                              Header="PMT Config"
                                              IsExpanded="False">
                                        <ListBox Height="200"
                                                 ItemContainerStyle="{StaticResource ListBoxItemStyle.Center}"
                                                 ItemsSource="{Binding ApplicationCookie.CIBInformationPMTIds}"
                                                 SelectionMode="Extended">
                                            <i:Interaction.Behaviors>
                                                <wpf:ListBoxSelectedItemsBehavior Type="{x:Type system:Int32}" BindableSelectedItems="{Binding Cache.PMTIds}" />
                                            </i:Interaction.Behaviors>
                                        </ListBox>
                                    </Expander>
                                </Border>
                                <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Spacing="10">
                                        <Button Content="Action"
                                                Command="{Binding Step1Command}"
                                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                                Style="{StaticResource ButtonPrimary.Loading}" />
                                        <Button Content="Cancel"
                                                Command="{Binding Step1CancelCommand}"
                                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                Style="{StaticResource ButtonWarning}" />
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </hc:UniformSpacingPanel>
                        </Border>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>