<UserControl x:Class="CugaCalibration.Views.Optics.GlobalFieldTilt.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:optics="clr-namespace:CugaCalibration.ViewModels.Optics"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:globalFieldTilt="clr-namespace:Core.Models.Models.Optics.GlobalFieldTilt;assembly=Core.Models"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=optics:OpticsGlobalFieldTiltViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeLensInformation.LensName}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Productivity Information: "
                           Status="{Binding Cache.Item.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="CIB Information: "
                           Status="{Binding Cache.Item.CIBInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">

                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <StackPanel>
                                <TextBlock Text="Common Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />

                                <hc:ComboBox HorizontalAlignment="Left"
                                             hc:TitleElement.TitleWidth="220"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.Title="Algorithm Type: "
                                             IsEnabled="False"
                                             SelectedItem="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}"
                                             ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmImageQualityTypeEnum}}}">
                                    <hc:ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                        </DataTemplate>
                                    </hc:ComboBox.ItemTemplate>
                                </hc:ComboBox>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Multiple PMT Once Collection: "
                                               Width="220"
                                               VerticalAlignment="Center" />
                                    <ToggleButton IsChecked="{Binding Cache.Item.IsMultiPMTOnceCollection}"
                                                  VerticalAlignment="Center"
                                                  Background="{StaticResource DangerBrush}"
                                                  Style="{StaticResource ToggleButtonSwitch}" />
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.Laplace}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.StrehlRatio}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.MTF}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                                <hc:NumericUpDown hc:TitleElement.Title="Retry Count: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="220"
                                                  Minimum="1"
                                                  Maximum="50"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.Item.RetryCount}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Threshold(um): "
                                                  hc:TitleElement.TitleWidth="220"
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  Minimum="0"
                                                  Increment="0.1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.Item.Threshold}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="X Axis Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <TextBox Text="{Binding Cache.Item.ImageCollectionConfiguration.StartPoint, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="220"
                                     hc:TitleElement.Title="Start Position(um): "
                                     hc:TitleElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding Cache.Item.ImageCollectionConfiguration.EndPoint, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="220"
                                     hc:TitleElement.Title="End Position(um): "
                                     hc:TitleElement.TitlePlacement="Left"
                                     Style="{StaticResource TextBoxExtend}" />
                            <StackPanel>
                                <TextBlock Text="Z Axis Param"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                              hc:TitleElement.Title="Center ECS: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.Item.CenterECS}" />
                            <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                              hc:TitleElement.Title="Range ECS: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.Item.RangeECS}" />
                            <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                              hc:TitleElement.Title="Step ECS: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Value="{Binding Cache.Item.StepECS}">
                                <hc:NumericUpDown.Style>
                                    <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.Laplace}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.StrehlRatio}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.MTF}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                            <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                              hc:TitleElement.Title="Range Refined ECS(±): "
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Value="{Binding Cache.Item.RangeRefinedECS}">
                                <hc:NumericUpDown.Style>
                                    <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.Laplace}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.StrehlRatio}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.MTF}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                            <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                              hc:TitleElement.Title="Step Refined ECS: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              Minimum="0"
                                              Value="{Binding Cache.Item.StepRefinedECS}">
                                <hc:NumericUpDown.Style>
                                    <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.Laplace}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.StrehlRatio}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Cache.Item.AlgorithmImageQualityTypeEnum}" Value="{x:Static enumAlgorithm:AlgorithmImageQualityTypeEnum.MTF}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                            <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                              hc:TitleElement.Title="Start Z Ecs: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              IsReadOnly="True"
                                              Visibility="Collapsed"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Background="{StaticResource SecondaryRegionBrush}"
                                              Value="{Binding Cache.Item.ImageCollectionConfiguration.ZStartEcs, Mode=OneWay}" />
                            <hc:NumericUpDown hc:TitleElement.TitleWidth="220"
                                              hc:TitleElement.Title="End Z Ecs: "
                                              hc:TitleElement.TitlePlacement="Left"
                                              IsReadOnly="True"
                                              Visibility="Collapsed"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Background="{StaticResource SecondaryRegionBrush}"
                                              Value="{Binding Cache.Item.ImageCollectionConfiguration.ZEndEcs, Mode=OneWay}" />
                            <StackPanel>
                                <TextBlock Text="Result"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Style="{StaticResource TextBlockDefaultInfo}" />
                            </StackPanel>
                            <hc:TextBox Text="{Binding CalibratingItem.ResultItem.AppliedDOEPos, StringFormat='0.###', Mode=OneWay}"
                                        hc:TitleElement.TitleWidth="220"
                                        hc:TitleElement.Title="Applied DOE Pos(mm): "
                                        hc:TitleElement.TitlePlacement="Left"
                                        Background="{StaticResource SecondaryRegionBrush}"
                                        Style="{StaticResource TextBoxExtend}"
                                        IsReadOnly="True" />
                            <hc:TextBox Text="{Binding CalibratingItem.ResultItem.GlobalFieldTiltError, StringFormat='0.###', Mode=OneWay}"
                                        hc:TitleElement.TitleWidth="220"
                                        hc:TitleElement.Title="Global Field Tilt Error(um): "
                                        hc:TitleElement.TitlePlacement="Left"
                                        Background="{StaticResource SecondaryRegionBrush}"
                                        Style="{StaticResource TextBoxExtend}"
                                        IsReadOnly="True" />
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Spacing="10">
                                <Button Content="Action"
                                        Command="{Binding Step3Command}"
                                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                        Style="{StaticResource ButtonPrimary.Loading}" />
                                <Button Content="Cancel"
                                        Command="{Binding Step3CancelCommand}"
                                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                        Style="{StaticResource ButtonWarning}" />
                            </hc:UniformSpacingPanel>
                        </hc:UniformSpacingPanel>

                    </Border>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <Grid Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="6*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Row="0" Grid.Column="0"
                      Header="History">
                <ListView x:Name="HistoryListView"
                          ItemsSource="{Binding CalibratingItem.Items}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <b:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </b:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="OpticsIlluminationMode" DisplayMemberBinding="{Binding DataContext.CalibratingItem.OpticsIlluminationModeEnum, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <GridViewColumn Header="Applied DOE Pos" DisplayMemberBinding="{Binding AppliedDOEPos, StringFormat='0.###'}" />
                            <GridViewColumn Header="Revise DOE Pos" DisplayMemberBinding="{Binding ReviseDOEPos, StringFormat='0.###'}" />
                            <GridViewColumn Header="Ecs Error" DisplayMemberBinding="{Binding GlobalFieldTiltError, StringFormat='0.###'}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <GridSplitter Grid.Row="0" Grid.Column="1"
                          Grid.RowSpan="3" />

            <GroupBox Grid.Row="0" Grid.Column="2"
                      Header="History Plot">
                <TabControl>
                    <TabItem Header="Summary">
                        <hc:ScrollViewer>
                            <ContentControl Content="{Binding CalibratingItem.ScatterPlotControl, Mode=OneWay}" />
                        </hc:ScrollViewer>
                    </TabItem>
                </TabControl>
            </GroupBox>

            <GridSplitter Grid.Row="1" Grid.Column="0"
                          Grid.ColumnSpan="3" />

            <GroupBox Grid.Row="2" Grid.Column="0"
                      Header="Details">
                <ListView x:Name="DetailListView"
                          ItemsSource="{Binding SelectedItem.BestFocusChannelItems, ElementName=HistoryListView}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <b:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </b:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="PMT ID" DisplayMemberBinding="{Binding PmtId}" />
                            <GridViewColumn Header="Channel ID" DisplayMemberBinding="{Binding ChannelId}" />
                            <GridViewColumn Header="X Best Focus" DisplayMemberBinding="{Binding XBestFocusEcs, StringFormat='0.###'}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <GroupBox Grid.Row="2" Grid.Column="2"
                      Header="Details Plot">
                <TabControl>
                    <TabItem Header="Muti PMT Best Focus">
                        <hc:ScrollViewer>
                            <ContentControl Content="{Binding SelectedItem.ScatterPlotControl, ElementName=HistoryListView, Mode=OneWay}" />
                        </hc:ScrollViewer>
                    </TabItem>
                    <TabItem Header="Images">
                        <ListBox ItemsSource="{Binding SelectedItems, ElementName=DetailListView}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type globalFieldTilt:GlobalFieldTiltDTOItem+Item}">
                                    <Border Width="300"
                                            Height="300"
                                            Style="{StaticResource BorderRegion}">
                                        <view:CanvasView AxisColor="Red"
                                                         BackgroundColor="#0A0A0A"
                                                         BackgroundImage="{Binding FilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                         Interactive="True"
                                                         ShowAxes="True"
                                                         ShowCursor="False"
                                                         ShowGrid="False" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Best Focus Details">
                        <hc:ScrollViewer>
                            <ContentControl Content="{Binding SelectedItem.ScatterPlotControl, ElementName=DetailListView, Mode=OneWay}" />
                        </hc:ScrollViewer>
                    </TabItem>

                </TabControl>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>