<UserControl x:Class="CugaCalibration.Views.Optics.CollectPolarization.Children.StepCommon.StepCommonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:collectPolarization="clr-namespace:Core.Models.Models.Optics.CollectPolarization;assembly=Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Optics"
             xmlns:wpf1="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
             d:DataContext="{d:DesignInstance Type=viewModels:CollectionPolarizationViewModel}"
             d:DesignHeight="1080"
             d:DesignWidth="1920"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="6*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Row="0" Grid.Column="0"
                  Header="History">
            <ListView x:Name="HistoryListView"
                      ItemsSource="{Binding CalibratingItems}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectedIndex="0"
                      Style="{StaticResource ListView.Small}">
                <i:Interaction.Behaviors>
                    <behaviors:ListBoxScrollToCurrentBehavior />
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn DisplayMemberBinding="{Binding OpticsCollectorPolarizationMode}" Header="Collector Polarization Mode" />
                        <GridViewColumn DisplayMemberBinding="{Binding ChannelId}" Header="Channel ID" />
                        <GridViewColumn DisplayMemberBinding="{Binding NDFRotaryMotorPosition, StringFormat='0.###'}" Header="Result Pos" />
                        <GridViewColumn DisplayMemberBinding="{Binding GrayValue, StringFormat='0.###'}" Header="Result Gray" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <GridSplitter Grid.Row="0" Grid.Column="1"
                      Grid.RowSpan="3" />

        <GroupBox Grid.Row="0" Grid.Column="2"
                  Header="History Plot">
            <TabControl ItemsSource="{Binding SelectedItems, ElementName=HistoryListView}" SelectedIndex="0">
                <i:Interaction.Behaviors>
                    <wpf1:SelectorAutoSelectFirstBehavior />
                </i:Interaction.Behaviors>
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type collectPolarization:CollectPolarizationDTO}">
                        <TextBlock Text="{Binding ChannelId}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type collectPolarization:CollectPolarizationDTO}">
                        <Border Margin="5" Style="{StaticResource BorderRegion}">
                            <v2:PlotControl DataSource="{Binding PlotDataSource}" />
                        </Border>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </GroupBox>

        <GridSplitter Grid.Row="1" Grid.Column="0"
                      Grid.ColumnSpan="3" />

        <GroupBox Grid.Row="2" Grid.Column="0"
                  Header="Details History">
            <ListView x:Name="HistoryDetailsListView"
                      ItemsSource="{Binding SelectedItem.Items, ElementName=HistoryListView}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectedIndex="0"
                      Style="{StaticResource ListView.Small}">
                <i:Interaction.Behaviors>
                    <behaviors:ListBoxScrollToCurrentBehavior />
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn DisplayMemberBinding="{Binding NDFRotaryMotorPosition, StringFormat='0.###'}" Header="NDF Pos" />
                        <GridViewColumn DisplayMemberBinding="{Binding GrayValue, StringFormat='0.###'}" Header="Gray" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <GroupBox Grid.Row="2" Grid.Column="2"
                  Header="Image">
            <Border Margin="5" Style="{StaticResource BorderRegion}">
                <ListBox ItemsSource="{Binding SelectedItems, ElementName=HistoryDetailsListView}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type collectPolarization:CollectPolarizationDTOItem}">
                            <Border Width="300"
                                    Height="300"
                                    Style="{StaticResource BorderRegion}">
                                <hc:SimplePanel>
                                    <view:CanvasView AxisColor="Red"
                                                     BackgroundColor="#0A0A0A"
                                                     BackgroundImage="{Binding ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False" />
                                    <hc:UniformSpacingPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            Orientation="Vertical">
                                        <TextBlock Text="{Binding NDFRotaryMotorPosition, StringFormat={}Motor Pos: {0:F3}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Foreground="Yellow" />
                                        <TextBlock Text="{Binding GrayValue, StringFormat={}Gray Value: {0:F3}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="Coral" />
                                    </hc:UniformSpacingPanel>

                                </hc:SimplePanel>

                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </GroupBox>
    </Grid>
</UserControl>