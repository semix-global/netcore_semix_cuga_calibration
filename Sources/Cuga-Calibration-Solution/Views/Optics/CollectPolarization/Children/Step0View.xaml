<UserControl x:Class="CugaCalibration.Views.Optics.CollectPolarization.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Optics"
             d:DataContext="{d:DesignInstance Type=viewModels:CollectionPolarizationViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Collect Polarization Calibration Step 1: "
                           Status="{Binding CalibrationStepList[0].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Find Collect Polarization Position Of NDF: "
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBox Text="{Binding Cache.HazeWaferPosition, Converter={StaticResource PointToStringConverter}}"
                                 Width="275"
                                 hc:InfoElement.Title="Haze Wafer Position(um): "
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step0Command}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step0CancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>