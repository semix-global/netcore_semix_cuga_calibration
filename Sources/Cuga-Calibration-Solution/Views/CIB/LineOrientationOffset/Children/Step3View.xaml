<UserControl x:Class="CugaCalibration.Views.CIB.LineOrientationOffset.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.CIB"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:wafer="clr-namespace:Core.Models.Enums.Recipe.Wafer;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:CIBLineOrientationOffsetViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.Item.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">

                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <StackPanel>
                                    <TextBlock Text="1. Param"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Style="{StaticResource TextBlockDefaultInfo}" />
                                </StackPanel>
                                <hc:ComboBox x:Name="TemplateTypeComboBox"
                                             HorizontalAlignment="Left"
                                             hc:TitleElement.TitleWidth="220"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.Title="Template Type: "
                                             SelectedItem="{Binding Cache.AlgorithmTemplateTypeEnum}"
                                             ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                                    <hc:ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                        </DataTemplate>
                                    </hc:ComboBox.ItemTemplate>
                                </hc:ComboBox>
                                <hc:ComboBox x:Name="MagCombobox"
                                             HorizontalAlignment="Left"
                                             hc:TitleElement.TitleWidth="220"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.Title="Magnification: "
                                             SelectedItem="{Binding Cache.Item.MicroscopeLensInformation}"
                                             ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}">
                                    <hc:ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LensName}" />
                                        </DataTemplate>
                                    </hc:ComboBox.ItemTemplate>
                                </hc:ComboBox>
                                <hc:ComboBox HorizontalAlignment="Left"
                                             hc:TitleElement.TitleWidth="220"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.Title="Template Mask Type: "
                                             SelectedItem="{Binding Cache.Item.WaferMaskTypeEnum}"
                                             ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type wafer:WaferMaskTypeEnum}}}">
                                    <hc:ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                        </DataTemplate>
                                    </hc:ComboBox.ItemTemplate>
                                </hc:ComboBox>
                                <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Width(um): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="220"
                                                  Minimum="1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.Item.DiePitchWidth}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Reticle Reference Die Col Count: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="220"
                                                  Minimum="1"
                                                  Increment="1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.Item.ReticleDieCountX}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Wafer Radius(um): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="220"
                                                  Minimum="1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.Item.WaferRadius}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <StackPanel>
                                    <TextBlock Text="2. Find Low Position Template"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Style="{StaticResource TextBlockDefaultInfo}" />
                                </StackPanel>
                                <TextBox Text="{Binding Cache.Item.StartPosition, Converter={StaticResource PointToStringConverter}}"
                                         hc:TitleElement.Title="Start Position(um): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="120"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Cache.Item.EndPosition, Converter={StaticResource PointToStringConverter}}"
                                         hc:TitleElement.TitleWidth="120"
                                         hc:TitleElement.Title="End Position(um): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Cache.Item.FindPosition, Converter={StaticResource PointToStringConverter}}"
                                         hc:TitleElement.TitleWidth="120"
                                         hc:TitleElement.Title="Find Position(um): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <view:CanvasView Width="100"
                                                 Height="100"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding Cache.Item.BrightTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Spacing="10">
                                    <Button x:Name="ActionButton"
                                            Content="Action"
                                            Command="{Binding Step3Command}"
                                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                            Style="{StaticResource ButtonPrimary.Loading}" />
                                    <Button x:Name="CancelButton"
                                            Content="Cancel"
                                            Command="{Binding Step3CancelCommand}"
                                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                            Style="{StaticResource ButtonWarning}" />
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </Border>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>