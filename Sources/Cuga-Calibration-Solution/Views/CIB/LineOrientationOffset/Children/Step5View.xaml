<UserControl x:Class="CugaCalibration.Views.CIB.LineOrientationOffset.Children.Step5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.CIB"
             d:DataContext="{d:DesignInstance Type=viewModels:CIBLineOrientationOffsetViewModel}"
             d:DesignHeight="1080"
             d:DesignWidth="1920"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Status="{Binding CalibrationStepName}"
                           Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Status="{Binding Cache.ProductivityInformation}"
                           Subject="Productivity: "
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                            <view:CanvasView Width="100"
                                             Height="100"
                                             AxisColor="Red"
                                             BackgroundColor="#0A0A0A"
                                             BackgroundImage="{Binding Cache.Item.TemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False" />
                        </hc:UniformSpacingPanel>
                        <Border Effect="{StaticResource EffectShadow1}" Style="{StaticResource BorderRegion}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                <StackPanel>
                                    <TextBlock Text="Offset"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Style="{StaticResource TextBlockDefaultInfo}" />
                                </StackPanel>
                                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Spacing="10">
                                    <Button x:Name="ActionButton"
                                            Content="Action"
                                            Command="{Binding Step5Command}"
                                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                            Style="{StaticResource ButtonPrimary.Loading}" />
                                    <Button x:Name="CancelButton"
                                            Content="Cancel"
                                            Command="{Binding Step5CancelCommand}"
                                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                            Style="{StaticResource ButtonWarning}" />
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </Border>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <Border Grid.Column="2" Style="{StaticResource BorderRegion}">
            <GroupBox Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding CalibratingItems}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ListView.Small}">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="200"
                                            DisplayMemberBinding="{Binding ProductivityInformation}"
                                            Header="Production" />
                            <GridViewColumn Width="80"
                                            DisplayMemberBinding="{Binding PmtId}"
                                            Header="PMT Id" />
                            <GridViewColumn Width="100"
                                            DisplayMemberBinding="{Binding XOffset, StringFormat='0.####'}"
                                            Header="X Offset(um)" />
                            <GridViewColumn Width="200"
                                            DisplayMemberBinding="{Binding ForwardFindDarkMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                            Header="Forward Dark Position" />
                            <GridViewColumn Width="200"
                                            DisplayMemberBinding="{Binding ReverseFindDarkMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                            Header="Reverse Dark Position" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Border>
    </Grid>
</UserControl>