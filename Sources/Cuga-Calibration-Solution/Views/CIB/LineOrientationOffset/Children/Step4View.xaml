<UserControl x:Class="CugaCalibration.Views.CIB.LineOrientationOffset.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.CIB"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:CIBLineOrientationOffsetViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <StackPanel>
                                    <TextBlock Text="Param"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Style="{StaticResource TextBlockDefaultInfo}" />
                                </StackPanel>
                                <hc:ComboBox x:Name="TemplateTypeComboBox"
                                             HorizontalAlignment="Left"
                                             hc:TitleElement.TitleWidth="220"
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.Title="Template Type: "
                                             SelectedItem="{Binding Cache.Item.AlgorithmTemplateTypeEnum}"
                                             ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                                    <hc:ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                        </DataTemplate>
                                    </hc:ComboBox.ItemTemplate>
                                </hc:ComboBox>
                            </hc:UniformSpacingPanel>
                        </Border>
                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <StackPanel>
                                    <TextBlock Text="Find Template"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Style="{StaticResource TextBlockDefaultInfo}" />
                                </StackPanel>
                                <TextBox x:Name="PathTextBox"
                                         Text="{Binding Cache.Item.TemplateFilePath}"
                                         Height="100"
                                         TextWrapping="Wrap"
                                         hc:TitleElement.Title="Template: "
                                         hc:TitleElement.TitleWidth="90"
                                         hc:TitleElement.TitlePlacement="Left"
                                         IsReadOnly="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource TextBoxExtend}" />
                                <view:CanvasView Width="100"
                                                 Height="100"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding Cache.Item.TemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Spacing="10">
                                    <Button x:Name="ActionButton"
                                            Content="Action"
                                            Command="{Binding Step4Command}"
                                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                            Style="{StaticResource ButtonPrimary.Loading}" />
                                    <Button x:Name="CancelButton"
                                            Content="Cancel"
                                            Command="{Binding Step4CancelCommand}"
                                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                            Style="{StaticResource ButtonWarning}" />
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </Border>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>