<UserControl x:Class="CugaCalibration.Views.CIB.XPixelSize.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.CIB"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:Net.Utilities.ScottPlot.WPF.WPF.Controls;assembly=Net.Utilities.ScottPlot.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:CIBXPixelSizeViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.Item.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Alignment Degrees(°): "
                           Status="{Binding Cache.Item.AlignmentResult.Degrees, StringFormat='0.##########'}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="BF Machine Position(um): "
                           Status="{Binding Cache.Item.FindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Wafer Radius(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="160"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.WaferRadius}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Die Pitch With(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="160"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.DiePitchWidth}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Reticle Die Count X: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="160"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.ReticleDieCountX}" />
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultSuccess}" />
                        </StackPanel>
                        <TextBox Text="{Binding CalibratingItem.XPixelSize, StringFormat='0.##########'}"
                                 hc:TitleElement.Title="X Pixel Size(um/px): "
                                 hc:TitleElement.TitleWidth="160"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step4Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step4CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource BorderRegion}">
                    <controls:ScatterMultiPlotControl Title="Slide Match(Y: Score - X: px)" ScatterLine0Points="{Binding CalibratingItem.SlideItemPoints}" />
                </Border>
                <GridSplitter Grid.Row="1" Height="5" />
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <controls:ScatterMultiPlotControl Title="Slide Split Differences(Y: px - X: Die - Die)" ScatterLine0Points="{Binding CalibratingItem.SlideSplitDifferences, Converter={StaticResource DoublesToPointsConverter}}" />
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>