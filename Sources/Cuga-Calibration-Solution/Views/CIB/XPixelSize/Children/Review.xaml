<UserControl x:Class="CugaCalibration.Views.CIB.XPixelSize.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.CIB"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:Net.Utilities.ScottPlot.WPF.WPF.Controls;assembly=Net.Utilities.ScottPlot.WPF"
             xmlns:scottPlot="clr-namespace:ScottPlot;assembly=ScottPlot"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:CIBXPixelSizeViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review : "
                           Status="Verify"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Verify"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Threshold(px): "
                                          hc:TitleElement.TitleWidth="160"
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Threshold}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding VerifyActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding VerifyActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="Calibration Data">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="2.5*" />
                </Grid.RowDefinitions>
                <ListView x:Name="Listview"
                          d:SelectedIndex="0"
                          ItemsSource="{Binding Reviews}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Extended">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                        <behaviors:MultiSelectorListViewSelectedItemsBehavior BindableSelectedItems="{Binding SelectedReviewItems}" />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Optics Illumination Mode" DisplayMemberBinding="{Binding OpticsIlluminationModeEnum, Converter={StaticResource EnumDescriptionConverter}}" />
                            <GridViewColumn Header="ProductivityInformation" DisplayMemberBinding="{Binding ProductivityInformation}" />
                            <GridViewColumn Header="X Pixel Size(um/px)" DisplayMemberBinding="{Binding XPixelSize, StringFormat={}{0:f3}}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="5" Style="{StaticResource BorderRegion}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Split Images"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource TextBlockSubTitleBold}"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding SelectedItem.VerifyItems, ElementName=Listview}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="300"
                                                    Height="300"
                                                    Style="{StaticResource BorderRegion}">
                                                <hc:SimplePanel>
                                                    <view:CanvasView AxisColor="Red"
                                                                     BackgroundColor="#0A0A0A"
                                                                     BackgroundImage="{Binding ImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                                     Interactive="True"
                                                                     ShowAxes="True"
                                                                     ShowCursor="False"
                                                                     ShowGrid="False" />
                                                    <TextBlock Text="{Binding MatchPoint, Converter={StaticResource PointToStringConverter}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top"
                                                               Foreground="Yellow" />
                                                </hc:SimplePanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BorderRegion}">
                                <controls:ScatterMultiPlotControl Title="Match(Y: Score - X: px)"
                                                                  ScatterLine0Title="Calibrate"
                                                                  ScatterLine0Points="{Binding SelectedItem.SlideItemPoints, ElementName=Listview}"
                                                                  ScatterLine0Color="{x:Static scottPlot:Colors.Blue}"
                                                                  ScatterLine1Title="Verify"
                                                                  ScatterLine1Points="{Binding SelectedItem.VerifyItemPoints, ElementName=Listview}"
                                                                  ScatterLine1Color="{x:Static scottPlot:Colors.Red}" />
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource BorderRegion}">
                                <controls:ScatterMultiPlotControl Title="Split Differences(Y: px - X: Die - Die)"
                                                                  ScatterLine0Title="Slide"
                                                                  ScatterLine0Points="{Binding SelectedItem.SlideSplitDifferences, Converter={StaticResource DoublesToPointsConverter}, ElementName=Listview}"
                                                                  ScatterLine0Color="{x:Static scottPlot:Colors.Blue}"
                                                                  ScatterLine1Title="Verify"
                                                                  ScatterLine1Points="{Binding SelectedItem.VerifySplitDifferences, Converter={StaticResource DoublesToPointsConverter}, ElementName=Listview}"
                                                                  ScatterLine1Color="{x:Static scottPlot:Colors.Red}" />
                            </Border>
                        </Grid>

                    </Border>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>