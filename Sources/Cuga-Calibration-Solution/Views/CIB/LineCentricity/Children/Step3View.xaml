<UserControl x:Class="CugaCalibration.Views.CIB.LineCentricity.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cib="clr-namespace:CugaCalibration.ViewModels.CIB"
             d:DataContext="{d:DesignInstance Type=cib:CIBLineCentricityViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Step 4: "
                           Status="{Binding CalibrationSteps[3].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Productivity Information: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.Item.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:ComboBox x:Name="MagCombobox"
                                     HorizontalAlignment="Left"
                                     hc:TitleElement.TitleWidth="160"
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.Title="Magnification: "
                                     SelectedItem="{Binding Cache.Item.MicroscopeLensInformation, UpdateSourceTrigger=PropertyChanged}"
                                     ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}">
                            <hc:ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LensName}" />
                                </DataTemplate>
                            </hc:ComboBox.ItemTemplate>
                        </hc:ComboBox>
                        <hc:ComboBox HorizontalAlignment="Left"
                                     hc:TitleElement.TitleWidth="160"
                                     hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.Title="Template Type: "
                                     SelectedItem="{Binding Cache.AlgorithmTemplateTypeEnum}"
                                     ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                            <hc:ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </hc:ComboBox.ItemTemplate>
                        </hc:ComboBox>

                        <hc:NumericUpDown hc:TitleElement.Title="Width(px): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="160"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Item.ImageWidth}" />
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultSuccess}" />
                        </StackPanel>
                        <TextBox Text="{Binding Cache.Item.FindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.Title="BF Position(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="160"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Cache.Item.TemplateFilePath}"
                                 Height="100"
                                 TextWrapping="Wrap"
                                 hc:TitleElement.Title="Template: "
                                 hc:TitleElement.TitleWidth="160"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel Spacing="10">
                            <view:CanvasView Width="100"
                                             Height="100"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding Cache.Item.BrightTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <view:CanvasView Width="100"
                                             Height="100"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding Cache.Item.TemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />

                        </hc:UniformSpacingPanel>

                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step3Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step3CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>