<UserControl x:Class="CugaCalibration.Views.CIB.MMD.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.CIB"
             xmlns:mmd="clr-namespace:Core.Models.Models.CIB.MMD;assembly=Core.Models"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:ui="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:CIBMMDViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review: "
                           Status="Verify"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Algorithm Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <Expander Header="Algorithm"
                                  IsExpanded="False"
                                  ExpandDirection="Down">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:NumericUpDown hc:TitleElement.Title="Dark Current: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.DarkCurrent}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Denominator: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.Denominator}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Scale Factor: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.ScaleFactor}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Min Valid Fraction: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.MinValidFraction}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Max Valid Fraction: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.MaxValidFraction}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Smooth Log Gain Window Size: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="1"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.SmoothLogGainMul128U12BitWindowSize}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Smooth Gain Window Size: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="1"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.SmoothGainS16BitWindowSize}" />
                                    <Expander Header="MMD Configurations"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Spacing="10">
                                                    <Button Content="Import"
                                                            Command="{Binding ImportCIBMMDCacheMMDConfigurationCommand}"
                                                            hc:IconElement.Geometry="{StaticResource DialogBoxLauncherGeometry}"
                                                            Style="{StaticResource ButtonInfo}" />
                                                    <Button Content="Cancel"
                                                            Command="{Binding ImportCIBMMDCacheMMDConfigurationCancelCommand}"
                                                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                                            Style="{StaticResource ButtonWarning}" />
                                                    <ToggleButton Content="Template"
                                                                  Command="{x:Static wpf:Commands.SaveFileAsCommand}"
                                                                  CommandParameter="Assets\Data\MMDTemplate\CIBMMDCache.MMDConfiguration.B4.xlsx"
                                                                  HorizontalAlignment="Left"
                                                                  hc:IconElement.Geometry="{StaticResource DownloadGeometry}" />
                                                </hc:UniformSpacingPanel>
                                                <ToggleButton x:Name="ToggleButtonMMDConfigurations"
                                                              Content="MMD Configurations"
                                                              HorizontalAlignment="Left"
                                                              hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                                <Popup Width="800"
                                                       Height="800"
                                                       StaysOpen="False"
                                                       PlacementTarget="{Binding ElementName=ToggleButtonMMDConfigurations}"
                                                       Placement="Right"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Slide"
                                                       IsOpen="{Binding IsChecked, ElementName=ToggleButtonMMDConfigurations, Mode=TwoWay}">
                                                    <Border Style="{StaticResource BorderRegion}">
                                                        <DataGrid hc:DataGridAttach.ShowRowNumber="True"
                                                                  Style="{StaticResource DataGrid.Small}"
                                                                  HeadersVisibility="All"
                                                                  RowHeaderWidth="60"
                                                                  AutoGenerateColumns="False"
                                                                  ItemsSource="{Binding Cache.MMDConfigurations}">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="CIB"
                                                                                    Binding="{Binding CIBInformation}"
                                                                                    IsReadOnly="True" />
                                                                <DataGridTextColumn Header="Filter Min Gain(V)" Binding="{Binding FilterMinGain, StringFormat='0.######'}" />
                                                                <DataGridTextColumn Header="Power Rate" Binding="{Binding PowerRate, StringFormat='0.##################'}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </Border>
                                                </Popup>
                                            </hc:UniformSpacingPanel>
                                        </Border>
                                    </Expander>
                                    <hc:NumericUpDown hc:TitleElement.Title="Verify Min LogGain: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.VerifyMinLogGain}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Verify Max LogGain: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.VerifyMaxLogGain}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Expander>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Save Aging Template"
                                    Command="{Binding SaveAgingTemplateCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonInfo.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding SaveAgingTemplateCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Set CIB MMD"
                                    Command="{Binding SetCIBMMDsCommand}"
                                    hc:IconElement.Geometry="{StaticResource DialogBoxLauncherGeometry}"
                                    Style="{StaticResource ButtonInfo.Loading}" />
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Algorithm"
                                    Command="{Binding AlgorithmCommand}"
                                    hc:IconElement.Geometry="{StaticResource RotateRightGeometry}"
                                    Style="{StaticResource ButtonInfo.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding AlgorithmCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Custom Data Algorithm"
                                    Command="{Binding ManualCustomDataAlgorithmCommand}"
                                    hc:IconElement.Geometry="{StaticResource RotateRightGeometry}"
                                    Style="{StaticResource ButtonInfo.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding ManualCustomDataAlgorithmCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                            <ToggleButton Content="Template"
                                          Command="{x:Static wpf:Commands.SaveDirectoryAsCommand}"
                                          CommandParameter="Assets\Data\MMDTemplate\CIBMMDManualCustomData"
                                          HorizontalAlignment="Left"
                                          hc:IconElement.Geometry="{StaticResource DownloadGeometry}" />
                        </hc:UniformSpacingPanel>
                        <Separator />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Verify"
                                    Command="{Binding VerifyCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding VerifyCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                        <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                      Content="Prescan AOD Waveform Profiles"
                                      HorizontalAlignment="Left"
                                      hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                        <Popup Width="800"
                               Height="800"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                               Placement="Right"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}">
                            <Border Style="{StaticResource BorderRegion}">
                                <ui:PrescanAODWaveformProfilesUserControl DataContext="{Binding Cache.PrescanAODWaveformProfiles}" />
                            </Border>
                        </Popup>
                        <ToggleButton x:Name="ToggleButtonChirpAODWaveformProfiles"
                                      Content="Chirp AOD Waveform Profiles"
                                      HorizontalAlignment="Left"
                                      hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                        <Popup Width="800"
                               Height="800"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=ToggleButtonChirpAODWaveformProfiles}"
                               Placement="Right"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               IsOpen="{Binding IsChecked, ElementName=ToggleButtonChirpAODWaveformProfiles, Mode=TwoWay}">
                            <Border Style="{StaticResource BorderRegion}">
                                <ui:ChirpAODWaveformProfilesUserControl DataContext="{Binding Cache.ChirpAODWaveformProfiles}" />
                            </Border>
                        </Popup>
                        <ToggleButton x:Name="ToggleButtonODFilterResult"
                                      Content="OD Filter Result"
                                      HorizontalAlignment="Left"
                                      hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                        <Popup Width="800"
                               Height="800"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=ToggleButtonODFilterResult}"
                               Placement="Right"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               IsOpen="{Binding IsChecked, ElementName=ToggleButtonODFilterResult, Mode=TwoWay}">
                            <Border Style="{StaticResource BorderRegion}">
                                <ContentControl Content="{Binding Cache.ScatterPlotControl, Mode=OneWay}" />
                            </Border>
                        </Popup>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="Calibration Data">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <ListView ItemsSource="{Binding Reviews}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                        <wpf:ListBoxSelectedItemsBehavior Type="{x:Type mmd:CIBMMDDTO}" BindableSelectedItems="{Binding SelectedReviewItems}" />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsCalibrated}" Value="False">
                                    <Setter Property="FontSize" Value="{StaticResource SubHeadFontSize}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="CIB Information" DisplayMemberBinding="{Binding CIBInformation}" />
                            <GridViewColumn Header="Gain RSquared" DisplayMemberBinding="{Binding GainRSquared, StringFormat='0.###'}" />
                            <GridViewColumn Header="Gain Residual" DisplayMemberBinding="{Binding GainResidual, StringFormat='0.###'}" />
                            <GridViewColumn Header="LogGain RSquared" DisplayMemberBinding="{Binding LogGainRSquared, StringFormat='0.###'}" />
                            <GridViewColumn Header="RelationShip">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type mmd:CIBMMDDTO}">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButtonReviewGainRelationships"
                                                          Content="Profiles"
                                                          Margin="0,2"
                                                          HorizontalAlignment="Left"
                                                          hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                            <Popup Width="800"
                                                   Height="800"
                                                   StaysOpen="False"
                                                   PlacementTarget="{Binding ElementName=ToggleButtonReviewGainRelationships}"
                                                   Placement="Right"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Slide"
                                                   IsOpen="{Binding IsChecked, ElementName=ToggleButtonReviewGainRelationships, Mode=TwoWay}">
                                                <DataGrid hc:DataGridAttach.ShowRowNumber="True"
                                                          FontSize="{StaticResource TextFontSize}"
                                                          FontWeight="Normal"
                                                          Style="{StaticResource DataGrid.Small}"
                                                          HeadersVisibility="All"
                                                          RowHeaderWidth="60"
                                                          AutoGenerateColumns="False"
                                                          ItemsSource="{Binding GainRelationships}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Gain(V)" Binding="{Binding Gain, StringFormat='0.###'}" />
                                                        <DataGridTextColumn Header="SenseU14Bit" Binding="{Binding SenseU14Bit}" />
                                                        <DataGridTextColumn Header="GainS16Bit" Binding="{Binding GainS16Bit}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="1" Height="5" />
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <TabControl ItemsSource="{Binding SelectedReviewItems}" SelectedIndex="0">
                        <i:Interaction.Behaviors>
                            <wpf:SelectorAutoSelectFirstBehavior />
                        </i:Interaction.Behaviors>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CIBInformation}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type mmd:CIBMMDDTO}">
                                <Border Margin="5" Style="{StaticResource BorderRegion}">
                                    <ContentControl Content="{Binding ScatterPlotControl, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>