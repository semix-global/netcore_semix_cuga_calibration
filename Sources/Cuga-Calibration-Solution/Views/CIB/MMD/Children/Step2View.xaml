<UserControl x:Class="CugaCalibration.Views.CIB.MMD.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.CIB"
             xmlns:generates="clr-namespace:Core.Models.Models.Common.AODWaveform.UI.Generates;assembly=Core.Models"
             xmlns:ui="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:cibEnum="clr-namespace:Core.Models.Enums.CIB;assembly=Core.Models"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:mmd="clr-namespace:Core.Models.Models.CIB.MMD;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:CIBMMDViewModel}"
             d:DesignHeight="1920"
             d:DesignWidth="1920"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="415" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="CIB MMD Step 3: "
                           Status="{Binding CalibrationStepList[1].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="BF Machine Position(um): "
                           Status="{Binding Cache.FindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:ComboBox hc:TitleElement.Title="Productivity Information: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 SelectedItem="{Binding Cache.ProductivityInformation}"
                                 Style="{StaticResource ComboBoxExtend}"
                                 ItemsSource="{Binding ApplicationCookie.OpticsMagTypeProductivityInformations}" />
                    <Expander Header="AF"
                              IsExpanded="True"
                              ExpandDirection="Down">
                        <Border Style="{StaticResource BorderRegion}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <hc:NumericUpDown hc:TitleElement.Title="AF Offset Motor(mm): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.AFOffsetMotor}" />
                                <hc:NumericUpDown hc:TitleElement.Title="AF ECS: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.AFECS}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AF Enable: "
                                               Width="190"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                    <ToggleButton IsChecked="{Binding Cache.IsAFEnable}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Background="{StaticResource DangerBrush}"
                                                  Style="{StaticResource ToggleButtonSwitch}" />
                                </StackPanel>
                            </hc:UniformSpacingPanel>
                        </Border>
                    </Expander>
                    <Expander Header="Prescan AOD Waveform"
                              IsExpanded="False"
                              ExpandDirection="Down">
                        <Border Style="{StaticResource BorderRegion}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <hc:UniformSpacingPanel Margin="11,0"
                                                        Orientation="Vertical"
                                                        Spacing="2">
                                    <hc:NumericUpDown hc:TitleElement.Title="Prescan Frequency(MHz): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.PrescanFrequency}" />
                                </hc:UniformSpacingPanel>
                                <generates:GeneratePrescanAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                      IsVisibleFrequency="False"
                                                                                      IsVisibleAmplitude="False"
                                                                                      IsVisibleDirectoryPath="False"
                                                                                      IsVisibleUniformityConfiguration="False"
                                                                                      IsVisibleSlopeDeltaKConfiguration="False"
                                                                                      IsVisibleCompensation="False"
                                                                                      DataContext="{Binding Cache.GeneratePrescanAODWaveformParam}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                    </Expander>
                    <Expander Header="Chirp AOD Waveform"
                              IsExpanded="False"
                              ExpandDirection="Down">
                        <Border Style="{StaticResource BorderRegion}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <hc:UniformSpacingPanel Margin="11,0"
                                                        Orientation="Vertical"
                                                        Spacing="2">
                                    <hc:NumericUpDown hc:TitleElement.Title="Chirp Frequency(MHz): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.ChirpFrequency}" />
                                </hc:UniformSpacingPanel>
                                <generates:GenerateChirpAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                    IsVisibleFrequency="False"
                                                                                    IsVisibleAmplitude="False"
                                                                                    IsVisibleDirectoryPath="False"
                                                                                    IsVisibleUniformityConfiguration="False"
                                                                                    IsVisibleSlopeDeltaKConfiguration="False"
                                                                                    IsVisibleCompensation="False"
                                                                                    DataContext="{Binding Cache.GenerateChirpAODWaveformParam}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                    </Expander>
                    <Expander Header="MMD"
                              IsExpanded="True"
                              ExpandDirection="Down">
                        <Border Style="{StaticResource BorderRegion}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <hc:ComboBox hc:TitleElement.Title="Log Mode: "
                                             hc:TitleElement.TitlePlacement="Left"
                                             hc:TitleElement.TitleWidth="190"
                                             ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type cibEnum:CIBProfileModeEnum}}}"
                                             SelectedItem="{Binding Path=Cache.CIBProfileMode}">
                                    <hc:ComboBox.Style>
                                        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="LightGray" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:ComboBox.Style>
                                    <hc:ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                        </DataTemplate>
                                    </hc:ComboBox.ItemTemplate>
                                </hc:ComboBox>
                                <hc:NumericUpDown hc:TitleElement.Title="Measure Power Wait Time(s): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.MeasurePowerWaitTime}" />
                                <hc:NumericUpDown hc:TitleElement.Title="PMT Value Wait Time(s): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.PMTValueWaitTime}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Start Coefficient: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Maximum="1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.StartCoefficient}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Step Coefficient: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Maximum="1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.StepCoefficient}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Stop Coefficient: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Maximum="1"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.StopCoefficient}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Start Gain(V): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="-10"
                                                  Maximum="10"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.StartGain}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Step Gain(V): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="-10"
                                                  Maximum="10"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.StepGain}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Stop Gain(V): "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="-10"
                                                  Maximum="10"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.StopGain}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Protected PMT Value: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.ProtectedPMTValue}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Protected Count: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.ProtectedCount}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Catch PMT Value Count: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.CatchPMTValueCount}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Concurrent Count: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.ConcurrentCount}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                    </Expander>
                    <Expander Header="Algorithm"
                              IsExpanded="False"
                              ExpandDirection="Down">
                        <Border Style="{StaticResource BorderRegion}">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                <hc:NumericUpDown hc:TitleElement.Title="Dark Current: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.DarkCurrent}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Denominator: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.Denominator}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Scale Factor: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.ScaleFactor}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Min Valid Fraction: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.MinValidFraction}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Max Valid Fraction: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.MaxValidFraction}" />
                                <hc:NumericUpDown hc:TitleElement.Title="Min LogGain: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.MinLogGain}" />
                                <hc:NumericUpDown hc:TitleElement.Title="LogGain Smooth Order: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.LogGainSmoothOrder}" />
                                <hc:NumericUpDown hc:TitleElement.Title="LogGain Smooth Window Size: "
                                                  hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.TitleWidth="190"
                                                  Minimum="0"
                                                  Style="{StaticResource NumericUpDownExtend}"
                                                  Value="{Binding Cache.LogGainSmoothWindowSize}" />
                                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Spacing="10">
                                    <Button Content="Import"
                                            Command="{Binding ImportGainConfigurationCommand}"
                                            hc:IconElement.Geometry="{StaticResource ImportGeometry}"
                                            Style="{StaticResource ButtonInfo}" />
                                    <ToggleButton x:Name="ToggleButtonGainConfigurations"
                                                  Content="Gain Configurations"
                                                  HorizontalAlignment="Left"
                                                  hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                    <Popup Width="800"
                                           Height="800"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=ToggleButtonGainConfigurations}"
                                           Placement="Right"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide"
                                           IsOpen="{Binding IsChecked, ElementName=ToggleButtonGainConfigurations, Mode=TwoWay}">
                                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                                            <DataGrid hc:DataGridAttach.ShowRowNumber="True"
                                                      Style="{StaticResource DataGrid.Small}"
                                                      HeadersVisibility="All"
                                                      RowHeaderWidth="60"
                                                      AutoGenerateColumns="False"
                                                      ItemsSource="{Binding Cache.GainConfigurations}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Gain(V)" Binding="{Binding Gain, StringFormat='0.###'}" />
                                                    <DataGridTextColumn Header="SenseU14Bit" Binding="{Binding SenseU14Bit}" />
                                                    <DataGridTextColumn Header="GainS16Bit" Binding="{Binding GainS16Bit}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Popup>
                                </hc:UniformSpacingPanel>
                            </hc:UniformSpacingPanel>
                        </Border>
                    </Expander>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                    <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                  Content="Prescan AOD Waveform Profiles"
                                  HorizontalAlignment="Left"
                                  hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                    <Popup Width="800"
                           Height="800"
                           StaysOpen="False"
                           PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                           Placement="Right"
                           AllowsTransparency="True"
                           PopupAnimation="Slide"
                           IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}">
                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                            <ui:PrescanAODWaveformProfilesUserControl DataContext="{Binding Cache.PrescanAODWaveformProfiles}" />
                        </Border>
                    </Popup>
                    <ToggleButton x:Name="ToggleButtonChirpAODWaveformProfiles"
                                  Content="Chirp AOD Waveform Profiles"
                                  HorizontalAlignment="Left"
                                  hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                    <Popup Width="800"
                           Height="800"
                           StaysOpen="False"
                           PlacementTarget="{Binding ElementName=ToggleButtonChirpAODWaveformProfiles}"
                           Placement="Right"
                           AllowsTransparency="True"
                           PopupAnimation="Slide"
                           IsOpen="{Binding IsChecked, ElementName=ToggleButtonChirpAODWaveformProfiles, Mode=TwoWay}">
                        <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                            <ui:ChirpAODWaveformProfilesUserControl DataContext="{Binding Cache.ChirpAODWaveformProfiles}" />
                        </Border>
                    </Popup>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <ListView ItemsSource="{Binding CalibratingItems}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                        <wpf:ListBoxSelectedItemsBehavior Type="{x:Type mmd:CIBMMDDto}" BindableSelectedItems="{Binding SelectedCalibratingItems}" />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="CIB Information" DisplayMemberBinding="{Binding CIBInformation}" />
                            <GridViewColumn Header="Gain Residual" DisplayMemberBinding="{Binding GainResidual, StringFormat='0.###'}" />
                            <GridViewColumn Header="Gain Norm" DisplayMemberBinding="{Binding GainL2Norm, StringFormat='0.###'}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <TabControl ItemsSource="{Binding SelectedCalibratingItems}" SelectedIndex="0">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CIBInformation}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type mmd:CIBMMDDto}">
                                <ContentControl Content="{Binding ScatterPlotControl, Mode=OneWay}" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Border>
            </Grid>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>