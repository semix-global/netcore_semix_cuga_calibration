<UserControl x:Class="CugaCalibration.Views.CIB.MMD.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.CIB"
             xmlns:generates="clr-namespace:Core.Models.Models.Common.AODWaveform.UI.Generates;assembly=Core.Models"
             xmlns:ui="clr-namespace:Core.Models.Models.Common.AODWaveform.UI;assembly=Core.Models"
             xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
             xmlns:mmd="clr-namespace:Core.Models.Models.CIB.MMD;assembly=Core.Models"
             xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:CIBMMDViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Step 3: "
                           Status="{Binding CalibrationStepList[2].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Haze BF Machine Position(um): "
                           Status="{Binding Cache.HazeFindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <ComboBox hc:TitleElement.Title="Productivity Information: "
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.TitleWidth="200"
                                  ItemsSource="{Binding ApplicationCookie.ProductivityInformations}"
                                  Style="{StaticResource ComboBoxExtend}">
                            <i:Interaction.Behaviors>
                                <wpf:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.ProductivityInformation}" FallbackSelectItem="{x:Static pattern:ProductivityInformation.Default}" />
                            </i:Interaction.Behaviors>
                        </ComboBox>
                        <Expander Header="Prescan AOD Waveform"
                                  IsExpanded="False"
                                  ExpandDirection="Down">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:UniformSpacingPanel Margin="11,0"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <hc:NumericUpDown hc:TitleElement.Title="Prescan Frequency(MHz): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="200"
                                                          Minimum="0"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.PrescanFrequency}" />
                                    </hc:UniformSpacingPanel>
                                    <generates:GeneratePrescanAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                          IsVisibleFrequency="False"
                                                                                          IsVisibleDirectoryPath="False"
                                                                                          IsVisibleUniformityConfiguration="False"
                                                                                          IsVisibleCompensation="False"
                                                                                          DataContext="{Binding Cache.GeneratePrescanAODWaveformParam}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Expander>
                        <Expander Header="Chirp AOD Waveform"
                                  IsExpanded="False"
                                  ExpandDirection="Down">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:UniformSpacingPanel Margin="11,0"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <hc:NumericUpDown hc:TitleElement.Title="Chirp Frequency(MHz): "
                                                          hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.TitleWidth="200"
                                                          Minimum="0"
                                                          Style="{StaticResource NumericUpDownExtend}"
                                                          Value="{Binding Cache.ChirpFrequency}" />
                                    </hc:UniformSpacingPanel>
                                    <generates:GenerateChirpAODWaveformParamUserControl IsVisibleProductivityInformation="False"
                                                                                        IsVisibleFrequency="False"
                                                                                        IsVisibleDirectoryPath="False"
                                                                                        IsVisibleUniformityConfiguration="False"
                                                                                        IsVisibleCompensation="False"
                                                                                        DataContext="{Binding Cache.GenerateChirpAODWaveformParam}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Expander>
                        <Expander Header="MMD"
                                  IsExpanded="False"
                                  ExpandDirection="Down">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:NumericUpDown hc:TitleElement.Title="Measure Power Wait Time(s): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.MeasurePowerWaitTime}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="PMT Value Wait Time(s): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.PMTValueWaitTime}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Start Coefficient: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Maximum="1"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.StartCoefficient}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Step Coefficient: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Maximum="1"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.StepCoefficient}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Stop Coefficient: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Maximum="1"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.StopCoefficient}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Measure Power Common Ratio: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.MeasurePowerSequenceCommonRatio}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Not Use OD Min Value(mW): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.MeasurePowerNotUseODFilterMinValue}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Max/Min(mW/mW): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.MMDMeasurePowerRangeRatio}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Start Gain(V): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="-10"
                                                      Maximum="10"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.StartGain}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Step Gain(V): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="-10"
                                                      Maximum="10"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.StepGain}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Stop Gain(V): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="-10"
                                                      Maximum="10"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.StopGain}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Protected PMT Value: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.ProtectedPMTValue}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Protected Count: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.ProtectedOverflowProtectedPMTValueCount}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Width(px): "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.ImageWidth}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Expander>
                        <Expander Header="Algorithm"
                                  IsExpanded="False"
                                  ExpandDirection="Down">
                            <Border Style="{StaticResource BorderRegion}">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                    <hc:NumericUpDown hc:TitleElement.Title="Dark Current: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.DarkCurrent}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Denominator: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.Denominator}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Scale Factor: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.ScaleFactor}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Min Valid Fraction: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.MinValidFraction}" />
                                    <hc:NumericUpDown hc:TitleElement.Title="Max Valid Fraction: "
                                                      hc:TitleElement.TitlePlacement="Left"
                                                      hc:TitleElement.TitleWidth="200"
                                                      Minimum="0"
                                                      Style="{StaticResource NumericUpDownExtend}"
                                                      Value="{Binding Cache.MaxValidFraction}" />
                                    <Expander Header="MMD Configurations"
                                              IsExpanded="False"
                                              ExpandDirection="Down">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <DataGrid hc:DataGridAttach.ShowRowNumber="True"
                                                      Style="{StaticResource DataGrid.Small}"
                                                      HeadersVisibility="All"
                                                      RowHeaderWidth="60"
                                                      AutoGenerateColumns="False"
                                                      ItemsSource="{Binding Cache.MMDConfigurations}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="CIB"
                                                                        Binding="{Binding CIBInformation}"
                                                                        IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Filter Min Gain(V)" Binding="{Binding FilterMinGain, StringFormat='0.######'}" />
                                                    <DataGridTextColumn Header="Power Rate" Binding="{Binding PowerRate, StringFormat='0.######'}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Expander>
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Expander>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step2Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step2CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                        <ToggleButton x:Name="ToggleButtonPrescanAODWaveformProfiles"
                                      Content="Prescan AOD Waveform Profiles"
                                      HorizontalAlignment="Left"
                                      hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                        <Popup Width="800"
                               Height="800"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=ToggleButtonPrescanAODWaveformProfiles}"
                               Placement="Right"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               IsOpen="{Binding IsChecked, ElementName=ToggleButtonPrescanAODWaveformProfiles, Mode=TwoWay}">
                            <Border Style="{StaticResource BorderRegion}">
                                <ui:PrescanAODWaveformProfilesUserControl DataContext="{Binding Cache.PrescanAODWaveformProfiles}" />
                            </Border>
                        </Popup>
                        <ToggleButton x:Name="ToggleButtonChirpAODWaveformProfiles"
                                      Content="Chirp AOD Waveform Profiles"
                                      HorizontalAlignment="Left"
                                      hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                        <Popup Width="800"
                               Height="800"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=ToggleButtonChirpAODWaveformProfiles}"
                               Placement="Right"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               IsOpen="{Binding IsChecked, ElementName=ToggleButtonChirpAODWaveformProfiles, Mode=TwoWay}">
                            <Border Style="{StaticResource BorderRegion}">
                                <ui:ChirpAODWaveformProfilesUserControl DataContext="{Binding Cache.ChirpAODWaveformProfiles}" />
                            </Border>
                        </Popup>
                        <ToggleButton x:Name="ToggleButtonODFilterResult"
                                      Content="OD Filter Result"
                                      HorizontalAlignment="Left"
                                      hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                        <Popup Width="800"
                               Height="800"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=ToggleButtonODFilterResult}"
                               Placement="Right"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               IsOpen="{Binding IsChecked, ElementName=ToggleButtonODFilterResult, Mode=TwoWay}">
                            <Border Style="{StaticResource BorderRegion}">
                                <ContentControl Content="{Binding Cache.ScatterPlotControl, Mode=OneWay}" />
                            </Border>
                        </Popup>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <ListView ItemsSource="{Binding Calibratings}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                        <wpf:ListBoxSelectedItemsBehavior Type="{x:Type mmd:CIBMMDDTO}" BindableSelectedItems="{Binding SelectedCalibratingItems}" />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsCalibrated}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DarkDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="CIB Information" DisplayMemberBinding="{Binding CIBInformation}" />
                            <GridViewColumn Header="Gain RSquared" DisplayMemberBinding="{Binding GainRSquared, StringFormat='0.###'}" />
                            <GridViewColumn Header="Gain Residual" DisplayMemberBinding="{Binding GainResidual, StringFormat='0.###'}" />
                            <GridViewColumn Header="LogGain RSquared" DisplayMemberBinding="{Binding LogGainRSquared, StringFormat='0.###'}" />
                            <GridViewColumn Header="RelationShip">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type mmd:CIBMMDDTO}">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButtonCalibratingsGainRelationships"
                                                          Content="Profiles"
                                                          Margin="0,2"
                                                          HorizontalAlignment="Left"
                                                          hc:IconElement.Geometry="{StaticResource AllGeometry}" />
                                            <Popup Width="800"
                                                   Height="800"
                                                   StaysOpen="False"
                                                   PlacementTarget="{Binding ElementName=ToggleButtonCalibratingsGainRelationships}"
                                                   Placement="Right"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Slide"
                                                   IsOpen="{Binding IsChecked, ElementName=ToggleButtonCalibratingsGainRelationships, Mode=TwoWay}">
                                                <DataGrid hc:DataGridAttach.ShowRowNumber="True"
                                                          Style="{StaticResource DataGrid.Small}"
                                                          HeadersVisibility="All"
                                                          RowHeaderWidth="60"
                                                          AutoGenerateColumns="False"
                                                          ItemsSource="{Binding GainRelationships}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Gain(V)" Binding="{Binding Gain, StringFormat='0.###'}" />
                                                        <DataGridTextColumn Header="SenseU14Bit" Binding="{Binding SenseU14Bit}" />
                                                        <DataGridTextColumn Header="GainS16Bit" Binding="{Binding GainS16Bit}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="1" Height="5" />
                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                    <TabControl ItemsSource="{Binding SelectedCalibratingItems}">
                        <i:Interaction.Behaviors>
                            <wpf:SelectorAutoSelectFirstBehavior />
                        </i:Interaction.Behaviors>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CIBInformation}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type mmd:CIBMMDDTO}">
                                <Border Margin="5" Style="{StaticResource BorderRegion}">
                                    <ContentControl Content="{Binding ScatterPlotControl, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>