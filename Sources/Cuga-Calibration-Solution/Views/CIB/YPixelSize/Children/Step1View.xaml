<UserControl x:Class="CugaCalibration.Views.CIB.YPixelSize.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cib="clr-namespace:CugaCalibration.ViewModels.CIB"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
             xmlns:setting="clr-namespace:Core.Models.Models.Setting;assembly=Core.Models"
             xmlns:calibrationAlgorithm="clr-namespace:Net.Utilities.Calibration;assembly=Net.Utilities.Calibration"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             d:DataContext="{d:DesignInstance Type=cib:CIBYPixelSizeViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <ComboBox hc:TitleElement.Title="Microscope Lens: "
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.TitleWidth="190"
                                  Style="{StaticResource ComboBoxExtend}"
                                  ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformations}">
                            <b:Interaction.Behaviors>
                                <behaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.Item.MicroscopeLensInformation}" FallbackSelectItem="{x:Static pattern:MicroscopeLensInformation.Default}" />
                            </b:Interaction.Behaviors>
                        </ComboBox>
                        <ComboBox hc:TitleElement.Title="Laser Light Information: "
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.TitleWidth="190"
                                  Style="{StaticResource ComboBoxExtend}"
                                  ItemsSource="{Binding ApplicationCookie.LaserLightInformations}">
                            <b:Interaction.Behaviors>
                                <behaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.Item.LaserLightInformation}" FallbackSelectItem="{x:Static pattern:LaserLightInformation.Default}" />
                            </b:Interaction.Behaviors>
                        </ComboBox>
                        <ComboBox hc:TitleElement.Title="Channel ID: "
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.TitleWidth="190"
                                  Style="{StaticResource ComboBoxExtend}"
                                  ItemsSource="{Binding ApplicationCookie.CIBInformationChannelIds}">
                            <b:Interaction.Behaviors>
                                <behaviors:ComboBoxSelectedItemBehavior BindableSelectedItem="{Binding Cache.Item.CIBChannelId}" />
                            </b:Interaction.Behaviors>
                        </ComboBox>
                        <pattern:OpticsConfigurationUserControl DataContext="{Binding Cache.Item.OpticsConfiguration}" />
                        <pattern:CIBConfigurationUserControl DataContext="{Binding Cache.Item.CIBConfiguration}" />
                        <!--  2026-10-24 用户裁定：Y 像素尺寸算法库切换与引擎参数设置放同一页面（自 Step4View 迁入）  -->
                        <hc:ComboBox hc:TitleElement.TitlePlacement="Left"
                                     hc:TitleElement.TitleWidth="160"
                                     hc:TitleElement.Title="Algorithm Engine Type: "
                                     SelectedItem="{Binding Cache.AlgorithmEngineTypeEnum}"
                                     ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type calibrationAlgorithm:AlgorithmEngineTypeEnum}}}">
                            <hc:ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </hc:ComboBox.ItemTemplate>
                        </hc:ComboBox>
                        <!--  Y 像素尺寸引擎参数设置（仿模板匹配范式，默认折叠），引擎取本流程 Cache.AlgorithmEngineTypeEnum  -->
                        <setting:YPixelSizeSettingUserControl DataContext="{Binding Cache.YPixelSizeSetting}" Engine="{Binding DataContext.Cache.AlgorithmEngineTypeEnum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step1Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step1CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>