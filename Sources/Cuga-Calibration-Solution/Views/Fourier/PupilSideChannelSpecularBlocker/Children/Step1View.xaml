<UserControl x:Class="CugaCalibration.Views.Fourier.PupilSideChannelSpecularBlocker.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imageViewer="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignHeight="900"
             d:DesignWidth="1800"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!--  在此处将转换器注册为资源，确保 StaticResource 可以找到它  -->
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <RichTextBox Margin="5"
                                 Padding="5"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <FlowDocument>
                            <Paragraph>
                                <Run Text="{Binding Cache.Item.ImageGrayCompareCh1}" />
                                <LineBreak />
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1Command}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Padding="3"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    Style="{StaticResource BorderRegion}">
                <hc:SimplePanel>
                    <hc:UniformSpacingPanel Spacing="5" Orientation="Horizontal">
                        <Button Content="Get CH1 Image File Initial"
                                Command="{Binding OpenImageFileCh12Command}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Get CH1 Image File Process"
                                Command="{Binding SaveImageFileCh12Command}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Get CH1 Image File Result"
                                Command="{Binding GetImageFileResultCh12Command}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                    </hc:UniformSpacingPanel>
                </hc:SimplePanel>
            </Border>
            <TabControl Grid.Row="2" SelectionChanged="TabControl_SelectionChanged">
                <!--  👇 新增：统一设置滚动条滑块为红色  -->
                <TabControl.Resources />
                <TabItem Header="Initial Image File">
                    <Border Padding="1"
                            CornerRadius="3"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            Style="{StaticResource BorderRegion}">
                        <imageViewer:OpticsFourierImageViewerCanvas BitmapImageDrawable="{Binding Cache.BitmapImageDrawableCh10}"
                                                                    RectROIDrawableList="{Binding Cache.RectROIDrawableListCh11}"
                                                                    IsToggleAddOrModifyRectROIDrawable="{Binding Cache.IsToggleSelectRectROIDrawableInitialCh1}" />
                    </Border>
                </TabItem>
                <TabItem Header="Process Image File">
                    <Border Padding="1"
                            CornerRadius="3"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            Style="{StaticResource BorderRegion}">
                        <imageViewer:OpticsFourierImageViewerCanvas BitmapImageDrawable="{Binding Cache.BitmapImageDrawableCh11}"
                                                                    RectROIDrawable="{Binding Cache.RectROIDrawableCh11}"
                                                                    CircleROIDrawable="{Binding Cache.CircleROIDrawableCh11}"
                                                                    RectROIDrawableList="{Binding Cache.RectROIDrawableListCh11}" />
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>