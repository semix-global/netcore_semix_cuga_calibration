<UserControl x:Class="CugaCalibration.Views.Fourier.PupilSideChannelFlexibleAperture.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imageViewer="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignHeight="900"
             d:DesignWidth="1800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <RichTextBox Margin="5"
                                 Padding="5"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <FlowDocument>
                            <Paragraph>
                                <Run Text="2、Get CH1 fourier image and save;" />
                                <LineBreak />
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step2Command}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step2CancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                    <hc:NumericUpDown Width="185"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="Move Rods First: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Ch12Percentage1, StringFormat={}{0:f1}}" />
                    <hc:NumericUpDown Width="205"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="Move Rods Second: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Ch12Percentage2, StringFormat={}{0:f1}}" />
                    <Button Content="Get Odd Rod Image(First)"
                            Command="{Binding GetImageOddFirstCh1Command}"
                            Style="{StaticResource ButtonPrimary.Loading}" />
                    <Button Content="Set Odd Rod Result(First)" Command="{Binding RefreshOddFirstCh1Command}" />
                    <Button Content="Get Odd Rod Image(Second)"
                            Command="{Binding GetImageOddSecondCh1Command}"
                            Style="{StaticResource ButtonPrimary.Loading}" />
                    <Button Content="Set Odd Rod Result(Second)" Command="{Binding RefreshOddSecondCh1Command}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Grid.Row="1"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                    <ListBox MaxHeight="120"
                             ItemsSource="{Binding AllOddRodsCh1Percent1}"
                             BorderBrush="Gray"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2"
                                        Padding="8"
                                        Background="#F9F9F9"
                                        CornerRadius="4">
                                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                            <TextBlock Text="Width:" />
                                            <TextBox Text="{Binding Width, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Height:" />
                                            <TextBox Text="{Binding Height, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox MaxHeight="120"
                             ItemsSource="{Binding AllOddRodsCh1Percent2}"
                             BorderBrush="Gray"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2"
                                        Padding="8"
                                        Background="#F9F9F9"
                                        CornerRadius="4">
                                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                            <TextBlock Text="Width:" />
                                            <TextBox Text="{Binding Width, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Height:" />
                                            <TextBox Text="{Binding Height, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Grid.Row="2"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                    <hc:NumericUpDown Width="185"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="Move Rods First: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Ch12Percentage1, StringFormat={}{0:f1}}" />
                    <hc:NumericUpDown Width="205"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="Move Rods Second: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Ch12Percentage2, StringFormat={}{0:f1}}" />
                    <Button Content="Get Even Rod Image(First)"
                            Command="{Binding GetImageEvenFirstCh1Command}"
                            Style="{StaticResource ButtonPrimary.Loading}" />
                    <Button Content="Set Even Rod Result(First)" Command="{Binding RefreshEvenFirstCh1Command}" />
                    <Button Content="Get Even Rod Image(Second)"
                            Command="{Binding GetImageEvenSecondCh1Command}"
                            Style="{StaticResource ButtonPrimary.Loading}" />
                    <Button Content="Set Even Rod Result(Second)" Command="{Binding RefreshEvenSecondCh1Command}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Grid.Row="3"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                    <ListBox MaxHeight="120"
                             ItemsSource="{Binding AllEvenRodsCh1Percent1}"
                             BorderBrush="Gray"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2"
                                        Padding="8"
                                        Background="#F9F9F9"
                                        CornerRadius="4">
                                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                            <TextBlock Text="Width:" />
                                            <TextBox Text="{Binding Width, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Height:" />
                                            <TextBox Text="{Binding Height, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox MaxHeight="120"
                             ItemsSource="{Binding AllEvenRodsCh1Percent2}"
                             BorderBrush="Gray"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2"
                                        Padding="8"
                                        Background="#F9F9F9"
                                        CornerRadius="4">
                                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                            <TextBlock Text="Width:" />
                                            <TextBox Text="{Binding Width, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Height:" />
                                            <TextBox Text="{Binding Height, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="70"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="True"
                                                     Background="LightGray" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Grid.Row="4"
                    Padding="1"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    Style="{StaticResource BorderRegion}">
                <imageViewer:OpticsFourierImageViewerCanvas BitmapImageDrawable="{Binding Cache.BitmapImageDrawableCh1}"
                                                            RectROIDrawable="{Binding Cache.RectROIDrawable}"
                                                            CircleROIDrawable="{Binding Cache.CircleROIDrawable}"
                                                            RectROIDrawableList="{Binding Cache.RectROIDrawableList}" />
            </Border>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>