<UserControl x:Class="CugaCalibration.Views.Fourier.PupilSideChannelFlexibleAperture.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CugaCalibration.Views.Fourier.PupilSideChannelFlexibleAperture.Children"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Flourier"
             xmlns:imageViewer="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignHeight="900"
             d:DesignWidth="1800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <RichTextBox Grid.Row="1"
                                 Margin="5"
                                 Padding="5"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <FlowDocument>
                            <Paragraph>
                                <Run Text="3、Get CH2 begin and end rods;" />
                                <LineBreak />
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step3Command}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step3CancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                    <hc:NumericUpDown Width="155"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="Begin Number1: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CgFFBoxBeginNumber1Ch2}" />
                    <Button Content="Get CH2 Begin Number1" Command="{Binding GetCH2BeginNumber1Command}" />
                    <hc:NumericUpDown Width="145"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="End Number1: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="2"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CgFFBoxEndNumber1Ch2}" />
                    <Button Content="Get CH2 End Number1" Command="{Binding GetCH2EndNumber1Command}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Grid.Row="1"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                    <hc:NumericUpDown Width="155"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="Begin Number2: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CgFFBoxBeginNumber2Ch2}" />
                    <Button Content="Get CH2 Begin Number2" Command="{Binding GetCH2BeginNumber2Command}" />
                    <hc:NumericUpDown Width="145"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="End Number2: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="2"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CgFFBoxEndNumber2Ch2}" />
                    <Button Content="Get CH2 End Number2" Command="{Binding GetCH2EndNumber2Command}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Grid.Row="2"
                    Padding="1"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    Style="{StaticResource BorderRegion}">
                <imageViewer:OpticsFourierImageViewerCanvas BitmapImageDrawable="{Binding Cache.BitmapImageDrawableCh2}"
                                                            RectROIDrawable="{Binding Cache.RectROIDrawable}"
                                                            CircleROIDrawable="{Binding Cache.CircleROIDrawable}"
                                                            RectROIDrawableList="{Binding Cache.RectROIDrawableList}" />
            </Border>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>


