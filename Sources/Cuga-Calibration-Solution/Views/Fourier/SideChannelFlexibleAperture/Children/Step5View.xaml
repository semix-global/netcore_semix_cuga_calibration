<UserControl x:Class="CugaCalibration.Views.Fourier.SideChannelFlexibleAperture.Children.Step5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Fourier"
             xmlns:wpf="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:FourierSideChannelFlexibleApertureViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Rod Total Count: "
                           Status="{Binding Cache.RodTotalCount}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Min Motor: "
                           Status="{Binding Cache.MinMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Max Motor: "
                           Status="{Binding Cache.MaxMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Productivity: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Laser Light: "
                           Status="{Binding Cache.LaserLightInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Haze BF Machine Position(um): "
                           Status="{Binding Cache.HazeFindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Step0/Step1 Motor: "
                           Status="{Binding Cache.Step0AndStep1MotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Step2 Motor: "
                           Status="{Binding Cache.Step2MotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step5Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step5CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="Channel 2 Image">
            <TabControl>
                <TabItem Header="Odd">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <wpf:OpticsFourierImageCanvasControl Document="{Binding CalibratingItem.Channel2Item.OddItem.Document, Mode=OneWay}" />
                    </Border>
                </TabItem>
                <TabItem Header="Result">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <wpf:OpticsFourierImageCanvasControl Document="{Binding CalibratingItem.Channel2Item.Document, Mode=OneWay}" />
                    </Border>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</UserControl>