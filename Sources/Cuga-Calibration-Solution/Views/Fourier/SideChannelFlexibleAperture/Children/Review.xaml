<UserControl x:Class="CugaCalibration.Views.Fourier.SideChannelFlexibleAperture.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Fourier"
             xmlns:wpf="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:itemsControlBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:FourierSideChannelFlexibleApertureViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review: "
                           Status="Verify"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Rod Total Count: "
                           Status="{Binding Cache.RodTotalCount}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Min Motor: "
                           Status="{Binding Cache.MinMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Max Motor: "
                           Status="{Binding Cache.MaxMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Step0/Step1 Motor: "
                           Status="{Binding Cache.Step0AndStep1MotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Step2 Motor: "
                           Status="{Binding Cache.Step2MotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding VerifyCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding VerifyCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <TabControl>
                <i:Interaction.Behaviors>
                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                </i:Interaction.Behaviors>
                <TabItem Header="Channel 1">
                    <TabControl Margin="5">
                        <i:Interaction.Behaviors>
                            <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                        </i:Interaction.Behaviors>
                        <TabItem Header="Result">
                            <TabControl Margin="5" DataContext="{Binding Review.Channel1Item, Mode=OneWay}">
                                <i:Interaction.Behaviors>
                                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                                </i:Interaction.Behaviors>
                                <TabItem Header="Image">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Document, Mode=OneWay}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Rod Information">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding RodResults, Mode=OneWay}" ContentTemplate="{StaticResource RodResultListTemplate}" />
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem Header="Even">
                            <TabControl Margin="5" DataContext="{Binding Review.Channel1Item.EvenItem, Mode=OneWay}">
                                <i:Interaction.Behaviors>
                                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                                </i:Interaction.Behaviors>
                                <TabItem Header="Image">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Document, Mode=OneWay}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 0">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <TextBox Text="{Binding Step0LeftRod.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                     hc:TitleElement.Title="Left Rod ROI(px): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="190"
                                                     IsReadOnly="True"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     Style="{StaticResource TextBoxExtend}" />
                                            <TextBox Text="{Binding Step0RightRod.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                     hc:TitleElement.Title="Right Rod ROI(px): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="190"
                                                     IsReadOnly="True"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     Style="{StaticResource TextBoxExtend}" />
                                        </hc:UniformSpacingPanel>
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 1">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding Step1Rods, Mode=OneWay}" ContentTemplate="{StaticResource RodListTemplate}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 2">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding Step2Rods, Mode=OneWay}" ContentTemplate="{StaticResource RodListTemplate}" />
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem Header="Odd">
                            <TabControl Margin="5" DataContext="{Binding Review.Channel1Item.OddItem, Mode=OneWay}">
                                <i:Interaction.Behaviors>
                                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                                </i:Interaction.Behaviors>
                                <TabItem Header="Image">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Document, Mode=OneWay}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 0">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <TextBox Text="{Binding Step0LeftRod.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                     hc:TitleElement.Title="Left Rod ROI(px): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="190"
                                                     IsReadOnly="True"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     Style="{StaticResource TextBoxExtend}" />
                                            <TextBox Text="{Binding Step0RightRod.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                     hc:TitleElement.Title="Right Rod ROI(px): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="190"
                                                     IsReadOnly="True"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     Style="{StaticResource TextBoxExtend}" />
                                        </hc:UniformSpacingPanel>
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 1">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding Step1Rods, Mode=OneWay}" ContentTemplate="{StaticResource RodListTemplate}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 2">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding Step2Rods, Mode=OneWay}" ContentTemplate="{StaticResource RodListTemplate}" />
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem Header="Channel 2">
                    <TabControl Margin="5">
                        <i:Interaction.Behaviors>
                            <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                        </i:Interaction.Behaviors>
                        <TabItem Header="Result">
                            <TabControl Margin="5" DataContext="{Binding Review.Channel2Item, Mode=OneWay}">
                                <i:Interaction.Behaviors>
                                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                                </i:Interaction.Behaviors>
                                <TabItem Header="Image">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Document, Mode=OneWay}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Rod Information">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding RodResults, Mode=OneWay}" ContentTemplate="{StaticResource RodResultListTemplate}" />
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem Header="Even">
                            <TabControl Margin="5" DataContext="{Binding Review.Channel2Item.EvenItem, Mode=OneWay}">
                                <i:Interaction.Behaviors>
                                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                                </i:Interaction.Behaviors>
                                <TabItem Header="Image">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Document, Mode=OneWay}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 0">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <TextBox Text="{Binding Step0LeftRod.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                     hc:TitleElement.Title="Left Rod ROI(px): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="190"
                                                     IsReadOnly="True"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     Style="{StaticResource TextBoxExtend}" />
                                            <TextBox Text="{Binding Step0RightRod.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                     hc:TitleElement.Title="Right Rod ROI(px): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="190"
                                                     IsReadOnly="True"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     Style="{StaticResource TextBoxExtend}" />
                                        </hc:UniformSpacingPanel>
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 1">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding Step1Rods, Mode=OneWay}" ContentTemplate="{StaticResource RodListTemplate}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 2">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding Step2Rods, Mode=OneWay}" ContentTemplate="{StaticResource RodListTemplate}" />
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem Header="Odd">
                            <TabControl Margin="5" DataContext="{Binding Review.Channel2Item.OddItem, Mode=OneWay}">
                                <i:Interaction.Behaviors>
                                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                                </i:Interaction.Behaviors>
                                <TabItem Header="Image">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Document, Mode=OneWay}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 0">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                                            <TextBox Text="{Binding Step0LeftRod.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                     hc:TitleElement.Title="Left Rod ROI(px): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="190"
                                                     IsReadOnly="True"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     Style="{StaticResource TextBoxExtend}" />
                                            <TextBox Text="{Binding Step0RightRod.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                     hc:TitleElement.Title="Right Rod ROI(px): "
                                                     hc:TitleElement.TitlePlacement="Left"
                                                     hc:TitleElement.TitleWidth="190"
                                                     IsReadOnly="True"
                                                     Background="{StaticResource SecondaryRegionBrush}"
                                                     Style="{StaticResource TextBoxExtend}" />
                                        </hc:UniformSpacingPanel>
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 1">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding Step1Rods, Mode=OneWay}" ContentTemplate="{StaticResource RodListTemplate}" />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Step 2">
                                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                                        <ContentPresenter Content="{Binding Step2Rods, Mode=OneWay}" ContentTemplate="{StaticResource RodListTemplate}" />
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</UserControl>