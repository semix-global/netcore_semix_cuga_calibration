<UserControl x:Class="CugaCalibration.Views.Fourier.SideChannelFlexibleAperture.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Fourier"
             xmlns:wpf="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:FourierSideChannelFlexibleApertureViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review: "
                           Status="Verify"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Step0/Step1 Motor: "
                           Status="{Binding Cache.Step0AndStep1MotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Step2 Motor: "
                           Status="{Binding Cache.Step2MotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultSuccess}" />
                        </StackPanel>
                        <TextBox Text="{Binding Review.Channel1Item.EvenItem.Step0AndStep1MotorAbsoluteValue, Mode=OneWay}"
                                 hc:TitleElement.Title="Ch1 Even Step0/1 Motor: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.Channel1Item.EvenItem.Step2MotorAbsoluteValue, Mode=OneWay}"
                                 hc:TitleElement.Title="Ch1 Even Step2 Motor: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.Channel1Item.OddItem.Step0AndStep1MotorAbsoluteValue, Mode=OneWay}"
                                 hc:TitleElement.Title="Ch1 Odd Step0/1 Motor: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.Channel1Item.OddItem.Step2MotorAbsoluteValue, Mode=OneWay}"
                                 hc:TitleElement.Title="Ch1 Odd Step2 Motor: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.Channel2Item.EvenItem.Step0AndStep1MotorAbsoluteValue, Mode=OneWay}"
                                 hc:TitleElement.Title="Ch2 Even Step0/1 Motor: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.Channel2Item.EvenItem.Step2MotorAbsoluteValue, Mode=OneWay}"
                                 hc:TitleElement.Title="Ch2 Even Step2 Motor: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.Channel2Item.OddItem.Step0AndStep1MotorAbsoluteValue, Mode=OneWay}"
                                 hc:TitleElement.Title="Ch2 Odd Step0/1 Motor: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.Channel2Item.OddItem.Step2MotorAbsoluteValue, Mode=OneWay}"
                                 hc:TitleElement.Title="Ch2 Odd Step2 Motor: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding VerifyCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding VerifyCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <TabControl>
                <TabItem Header="Channel 1 Even">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.Channel1Item.EvenItem.Document, Mode=OneWay}" />
                    </Border>
                </TabItem>
                <TabItem Header="Channel 1 Odd">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.Channel1Item.OddItem.Document, Mode=OneWay}" />
                    </Border>
                </TabItem>
                <TabItem Header="Channel 2 Even">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.Channel2Item.EvenItem.Document, Mode=OneWay}" />
                    </Border>
                </TabItem>
                <TabItem Header="Channel 2 Odd">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.Channel2Item.OddItem.Document, Mode=OneWay}" />
                    </Border>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</UserControl>
