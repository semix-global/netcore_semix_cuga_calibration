<UserControl x:Class="CugaCalibration.Views.Fourier.PupilCenterChannelSpecularBlocker.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CugaCalibration.Views.Fourier.PupilCenterChannelSpecularBlocker.Children"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Flourier"
             xmlns:imageViewer="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignHeight="900"
             d:DesignWidth="1800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <RichTextBox Grid.Row="1"
                                 Margin="5"
                                 Padding="5"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <FlowDocument>
                            <Paragraph>
                                <Run Text="{Binding Cache.Item.ImageGrayCompareCh3}" />
                                <LineBreak />
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step3Command}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step3CancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="3"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    Style="{StaticResource BorderRegion}">
                <hc:SimplePanel>
                    <hc:UniformSpacingPanel Spacing="5" Orientation="Horizontal">
                        <hc:NumericUpDown Width="255"
                                          Margin="0,0,0,5"
                                          hc:InfoElement.Title="Horizal TurnY MotorRelation: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          IsReadOnly="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Ch3TurnYMotorRelation, StringFormat={}{0:f2}}" />
                        <hc:NumericUpDown Width="255"
                                          Margin="0,0,0,5"
                                          hc:InfoElement.Title="Vertical PushX MotorRelation: "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          IsReadOnly="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Ch3PushXMotorRelation, StringFormat={}{0:f2}}" />
                        <hc:NumericUpDown Width="225"
                                          Margin="0,0,0,5"
                                          hc:InfoElement.Title="SelectRod Width(Pixsel): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          IsReadOnly="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding SelectRodWidth}" />
                        <hc:NumericUpDown Width="225"
                                          Margin="0,0,0,5"
                                          hc:InfoElement.Title="SelectRod Height(Pixsel): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          IsReadOnly="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding SelectRodHeight}" />
                        <Button Content="Get Image File Initial" Command="{Binding OpenImageFileCH3Command}" />
                    </hc:UniformSpacingPanel>
                </hc:SimplePanel>
            </Border>
            <Border Grid.Row="1"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="2">
                    <hc:ComboBox Width="225"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Chart Show Type: "
                                 hc:InfoElement.Necessary="False"
                                 ItemsSource="{Binding Ch3ShowTypeValues}"
                                 SelectedItem="{Binding SelectedCh3ShowType, Mode=TwoWay}" />
                    <hc:NumericUpDown Width="175"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="TurnY Motor: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="-100"
                                      Maximum="100"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Ch3TurnY, StringFormat={}{0:f2}}" />
                    <hc:NumericUpDown Width="175"
                                      Margin="0,0,0,5"
                                      hc:InfoElement.Title="PushX Motor: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      Minimum="-100"
                                      Maximum="100"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Ch3Push, StringFormat={}{0:f2}}" />
                    <Button Content="Get Image File Process" Command="{Binding SaveImageFileCH3Command}" />
                </hc:UniformSpacingPanel>
            </Border>
            <TabControl Grid.Row="3">
                <!--  👇 新增：统一设置滚动条滑块为红色  -->
                <TabControl.Resources>
                    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="Red" />
                    <SolidColorBrush x:Key="ScrollBarThumbBackgroundMouseOver" Color="#CC0000" />
                    <SolidColorBrush x:Key="ScrollBarThumbBackgroundPressed" Color="#990000" />
                </TabControl.Resources>
                <TabItem Header="Initial Image File">
                    <Border Padding="1"
                            CornerRadius="3"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            Style="{StaticResource BorderRegion}">
                        <imageViewer:OpticsFourierImageViewerCanvas BitmapImageDrawable="{Binding Cache.BitmapImageDrawableCh30}"
                                                                    RectROIDrawable="{Binding Cache.RectROIDrawable}"
                                                                    CircleROIDrawable="{Binding Cache.CircleROIDrawable}" />
                    </Border>
                </TabItem>
                <TabItem Header="Process Image File">
                    <Border Padding="1"
                            CornerRadius="3"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            Style="{StaticResource BorderRegion}">
                        <imageViewer:OpticsFourierImageViewerCanvas BitmapImageDrawable="{Binding Cache.BitmapImageDrawableCh31}"
                                                                    RectROIDrawable="{Binding Cache.RectROIDrawable}"
                                                                    CircleROIDrawable="{Binding Cache.CircleROIDrawable}"
                                                                    RectROIDrawableList="{Binding Cache.RectROIDrawableList}" />
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>
