<UserControl x:Class="CugaCalibration.Views.Fourier.V0CenterChannelFlexibleAperture.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Fourier"
             xmlns:wpf="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:itemsControlBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:V0FourierCenterChannelFlexibleApertureViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review: "
                           Status="Verify"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="X Min Motor: "
                           Status="{Binding Cache.XMinMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="X Max Motor: "
                           Status="{Binding Cache.XMaxMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="X Push Min Motor: "
                           Status="{Binding Cache.PushMinMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="X Push Max Motor: "
                           Status="{Binding Cache.PushMaxMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Y Min Motor: "
                           Status="{Binding Cache.YMinMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Y Max Motor: "
                           Status="{Binding Cache.YMaxMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Verify"
                                    Command="{Binding VerifyCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding VerifyCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <TabControl>
                <i:Interaction.Behaviors>
                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                </i:Interaction.Behaviors>
                <TabItem Header="X Aperture">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <DockPanel>
                            <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                    Orientation="Vertical"
                                                    Spacing="2">
                                <TextBox Text="{Binding Review.XApertureItem.AngleMotorAbsoluteValue, Mode=OneWay}"
                                         hc:TitleElement.Title="Angle(°): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XApertureItem.Step0MotorAbsoluteValue, Mode=OneWay}"
                                         hc:TitleElement.Title="Step 0 Position(mm): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XApertureItem.Step1MotorAbsoluteValue, Mode=OneWay}"
                                         hc:TitleElement.Title="Step 1 Position(mm): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XApertureItem.Step0ROI.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                         hc:TitleElement.Title="Step 0 Rect(px): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XApertureItem.Step0ROI.ImageROI, Mode=OneWay, Converter={StaticResource RectToEllipseStringConverter}, ConverterParameter=0.###}"
                                         hc:TitleElement.Title="Step 0 Ellipse(px): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XApertureItem.Step1ROI.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                         hc:TitleElement.Title="Step 1 Rect(px): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XApertureItem.Step1ROI.ImageROI, Mode=OneWay, Converter={StaticResource RectToEllipseStringConverter}, ConverterParameter=0.###}"
                                         hc:TitleElement.Title="Step 1 Ellipse(px): "
