<UserControl x:Class="CugaCalibration.Views.Fourier.CenterChannelFlexibleAperture.Children.Step8View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Fourier"
             xmlns:wpf="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:FourierCenterChannelFlexibleApertureViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Kind: "
                           Status="{Binding CalibratingItem.YLightHoleItem.CenterChannelMotionKindEnum}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Circle Center (px): "
                           Status="{Binding CalibratingItem.YLightHoleItem.Circle.Center, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Circle Radius (px): "
                           Status="{Binding CalibratingItem.YLightHoleItem.Circle.Radius}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Haze BF Machine Position(um): "
                           Status="{Binding Cache.HazeFindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="Capture at 60 degrees, linear position 0 and push position 0. Place all five ROI crosshair centers on distinct points spread along the visible curved aperture edge. Avoid straight rod edges. Press Enter to fit the center and radius."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Capture and Fit Circle"
                                    Command="{Binding Step8Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step8CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="CH3 Y 60 Degree Light Hole">
            <Border Margin="5" Style="{StaticResource BorderRegion}">
                <wpf:OpticsFourierImageCanvasControl Document="{Binding CalibratingItem.YLightHoleItem.Document, Mode=OneWay}" />
            </Border>
        </GroupBox>
    </Grid>
</UserControl>