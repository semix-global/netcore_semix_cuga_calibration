<UserControl x:Class="CugaCalibration.Views.Fourier.CenterChannelFlexibleAperture.Children.Step11View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Fourier"
             xmlns:wpf="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:FourierCenterChannelFlexibleApertureViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Kind: "
                           Status="{Binding CalibratingItem.YRodItems[2].CenterChannelMotionKindEnum}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Default Angle: "
                           Status="{Binding CalibratingItem.YRodItems[2].DefaultAngleMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Pixel Size (motor/px): "
                           Status="{Binding CalibratingItem.YRodItems[2].PixelSize}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Y Min Motor: "
                           Status="{Binding Cache.YMinMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Y Max Motor: "
                           Status="{Binding Cache.YMaxMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Haze BF Machine Position(um): "
                           Status="{Binding Cache.HazeFindBFMachinePosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="Step 0: move Y; top/bottom handles resize height. Step 1: align the same rod; size locked."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <hc:NumericUpDown hc:TitleElement.Title="Angle (deg): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          IsEnabled="{Binding Step11Command.IsRunning, Converter={StaticResource BoolNegationConverter}}"
                                          Minimum="0"
                                          Maximum="360"
                                          Increment="0.001"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding CalibratingItem.YRodItems[2].AngleMotorAbsoluteValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Step 0 Position: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          IsEnabled="{Binding Step11Command.IsRunning, Converter={StaticResource BoolNegationConverter}}"
                                          Minimum="-100000"
                                          Maximum="100000"
                                          Increment="0.001"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding CalibratingItem.YRodItems[2].Step0MotorAbsoluteValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Step 1 Position: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          IsEnabled="{Binding Step11Command.IsRunning, Converter={StaticResource BoolNegationConverter}}"
                                          Minimum="-100000"
                                          Maximum="100000"
                                          Increment="0.001"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding CalibratingItem.YRodItems[2].Step1MotorAbsoluteValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Capture and Calibrate"
                                    Command="{Binding Step11Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step11CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="CH3 Y 240 Degree Rod">
            <Border Margin="5" Style="{StaticResource BorderRegion}">
                <wpf:OpticsFourierImageCanvasControl Document="{Binding CalibratingItem.YRodItems[2].Document, Mode=OneWay}" />
            </Border>
        </GroupBox>
    </Grid>
</UserControl>