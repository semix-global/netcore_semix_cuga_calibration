<UserControl x:Class="CugaCalibration.Views.Fourier.CenterChannelFlexibleAperture.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Fourier"
             xmlns:wpf="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:itemsControlBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:FourierCenterChannelFlexibleApertureViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review: "
                           Status="Verify"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="X Min Motor: "
                           Status="{Binding Cache.XMinMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="X Max Motor: "
                           Status="{Binding Cache.XMaxMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="X Reflection Push Min Motor: "
                           Status="{Binding Cache.ReflectionPushMinMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="X Reflection Push Max Motor: "
                           Status="{Binding Cache.ReflectionPushMaxMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="X Diffraction Push Min Motor: "
                           Status="{Binding Cache.DiffractionPushMinMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="X Diffraction Push Max Motor: "
                           Status="{Binding Cache.DiffractionPushMaxMotorAbsoluteValue}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Verify"
                                    Command="{Binding VerifyCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding VerifyCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <TabControl>
                <i:Interaction.Behaviors>
                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                </i:Interaction.Behaviors>
                <TabItem Header="X Origin">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <DockPanel>
                            <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                    Orientation="Vertical"
                                                    Spacing="2">
                                <TextBox Text="{Binding Review.XOriginItem.Width, Mode=OneWay}"
                                         hc:TitleElement.Title="Width(mm): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XOriginItem.Height, Mode=OneWay}"
                                         hc:TitleElement.Title="Height(mm): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XOriginItem.AngleMotorAbsoluteValue, Mode=OneWay}"
                                         hc:TitleElement.Title="Angle(°): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XOriginItem.Step0MotorAbsoluteValue, Mode=OneWay}"
                                         hc:TitleElement.Title="Step 0 Position(mm): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XOriginItem.Step1MotorAbsoluteValue, Mode=OneWay}"
                                         hc:TitleElement.Title="Step 1 Position(mm): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XOriginItem.Step0ROI.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                         hc:TitleElement.Title="Step 0 Rect(px): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XOriginItem.Step1ROI.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                         hc:TitleElement.Title="Step 1 Rect(px): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                                <TextBox Text="{Binding Review.XOriginItem.PixelSize, Mode=OneWay}"
                                         hc:TitleElement.Title="Pixel Size(mm/px): "
                                         hc:TitleElement.TitlePlacement="Left"
                                         hc:TitleElement.TitleWidth="190"
                                         IsReadOnly="True"
                                         Background="{StaticResource SecondaryRegionBrush}"
                                         Style="{StaticResource TextBoxExtend}" />
                            </hc:UniformSpacingPanel>
                            <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.XOriginItem.Document, Mode=OneWay}" />
                        </DockPanel>
                    </Border>
