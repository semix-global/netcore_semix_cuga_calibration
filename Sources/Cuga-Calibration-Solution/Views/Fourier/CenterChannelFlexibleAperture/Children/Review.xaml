                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Pixel Size (motor/px): "
                                                   Status="{Binding Review.XItems[2].PixelSize}"
                                                   Color="{StaticResource SuccessBrush}" />
                                    </hc:UniformSpacingPanel>
                                    <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.XItems[2].Document, Mode=OneWay}" />
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="300">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
                                <DockPanel>
                                    <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <hc:Shield Subject="Angle (deg): "
                                                   Status="{Binding Review.XItems[3].AngleMotorAbsoluteValue}"
                                                   Color="{StaticResource InfoBrush}" />
                                        <hc:Shield Subject="Step 0 Position: "
                                                   Status="{Binding Review.XItems[3].Step0MotorAbsoluteValue}"
                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Step 1 Position: "
