                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Pixel Size (motor/px): "
                                                   Status="{Binding Review.XItems[1].PixelSize}"
                                                   Color="{StaticResource SuccessBrush}" />
                                    </hc:UniformSpacingPanel>
                                    <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.XItems[1].Document, Mode=OneWay}" />
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="240">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
