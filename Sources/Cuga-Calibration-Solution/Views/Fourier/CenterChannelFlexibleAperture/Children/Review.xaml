<UserControl x:Class="CugaCalibration.Views.Fourier.CenterChannelFlexibleAperture.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Fourier"
             xmlns:wpf="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:itemsControlBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:FourierCenterChannelFlexibleApertureViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review: "
                           Status="Verify"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="X Circle Center: "
                           Status="{Binding Review.XLightHoleItem.Circle.Center, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="X Circle Radius: "
                           Status="{Binding Review.XLightHoleItem.Circle.Radius}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Y Circle Center: "
                           Status="{Binding Review.YLightHoleItem.Circle.Center, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Y Circle Radius: "
                           Status="{Binding Review.YLightHoleItem.Circle.Radius}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding VerifyCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding VerifyCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <TabControl>
                <i:Interaction.Behaviors>
                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                </i:Interaction.Behaviors>
                <TabItem Header="X Light Hole">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <DockPanel>
                            <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                    Orientation="Vertical"
                                                    Spacing="2">
                                <hc:Shield Subject="Circle Center (px): "
                                           Status="{Binding Review.XLightHoleItem.Circle.Center}"
                                           Color="{StaticResource SuccessBrush}" />
                                <hc:Shield Subject="Circle Radius (px): "
                                           Status="{Binding Review.XLightHoleItem.Circle.Radius}"
                                           Color="{StaticResource SuccessBrush}" />
                            </hc:UniformSpacingPanel>
                            <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.XLightHoleItem.Document, Mode=OneWay}" />
                        </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="X Motion">
                    <TabControl Margin="5">
                        <i:Interaction.Behaviors>
                            <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                        </i:Interaction.Behaviors>
                        <TabItem Header="120">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
                                <DockPanel>
                                    <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <hc:Shield Subject="Angle (deg): "
                                                   Status="{Binding Review.XItems[0].AngleMotorAbsoluteValue}"
                                                   Color="{StaticResource InfoBrush}" />
                                        <hc:Shield Subject="Step 0 Position: "
                                                   Status="{Binding Review.XItems[0].Step0MotorAbsoluteValue}"
                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Step 1 Position: "
                                                   Status="{Binding Review.XItems[0].Step1MotorAbsoluteValue}"
                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Pixel Size (motor/px): "
                                                   Status="{Binding Review.XItems[0].PixelSize}"
                                                   Color="{StaticResource SuccessBrush}" />
                                    </hc:UniformSpacingPanel>
                                    <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.XItems[0].Document, Mode=OneWay}" />
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="180">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
                                <DockPanel>
                                    <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <hc:Shield Subject="Angle (deg): "
                                                   Status="{Binding Review.XItems[1].AngleMotorAbsoluteValue}"
                                                   Color="{StaticResource InfoBrush}" />
                                        <hc:Shield Subject="Step 0 Position: "
