                                                   Color="{StaticResource SuccessBrush}" />
                                    </hc:UniformSpacingPanel>
                                    <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.YItems[0].Document, Mode=OneWay}" />
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="180">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
                                <DockPanel>
                                    <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <hc:Shield Subject="Angle (deg): "
                                                   Status="{Binding Review.YItems[1].AngleMotorAbsoluteValue}"
