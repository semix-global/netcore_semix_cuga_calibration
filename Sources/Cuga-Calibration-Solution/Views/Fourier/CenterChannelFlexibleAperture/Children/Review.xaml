                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Pixel Size (motor/px): "
                                                   Status="{Binding Review.XItems[3].PixelSize}"
                                                   Color="{StaticResource SuccessBrush}" />
                                    </hc:UniformSpacingPanel>
                                    <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.XItems[3].Document, Mode=OneWay}" />
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="Push">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
                                <DockPanel>
                                    <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <hc:Shield Subject="Angle (deg): "
                                                   Status="{Binding Review.PushItem.AngleMotorAbsoluteValue}"
                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Step 0 Position: "
                                                   Status="{Binding Review.PushItem.Step0MotorAbsoluteValue}"
                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Step 1 Position: "
                                                   Status="{Binding Review.PushItem.Step1MotorAbsoluteValue}"
                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Pixel Size (motor/px): "
                                                   Status="{Binding Review.PushItem.PixelSize}"
                                                   Color="{StaticResource SuccessBrush}" />
                                    </hc:UniformSpacingPanel>
                                    <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.PushItem.Document, Mode=OneWay}" />
                                </DockPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem Header="Y Light Hole">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <DockPanel>
                            <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                    Orientation="Vertical"
                                                    Spacing="2">
                                <hc:Shield Subject="Circle Center (px): "
                                           Status="{Binding Review.YLightHoleItem.Circle.Center}"
                                           Color="{StaticResource SuccessBrush}" />
                                <hc:Shield Subject="Circle Radius (px): "
                                           Status="{Binding Review.YLightHoleItem.Circle.Radius}"
                                           Color="{StaticResource SuccessBrush}" />
                            </hc:UniformSpacingPanel>
                            <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.YLightHoleItem.Document, Mode=OneWay}" />
                        </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Y Motion">
                    <TabControl Margin="5">
                        <i:Interaction.Behaviors>
                            <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                        </i:Interaction.Behaviors>
                        <TabItem Header="120">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
                                <DockPanel>
                                    <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <hc:Shield Subject="Angle (deg): "
                                                   Status="{Binding Review.YItems[0].AngleMotorAbsoluteValue}"
                                                   Color="{StaticResource InfoBrush}" />
                                        <hc:Shield Subject="Step 0 Position: "
                                                   Status="{Binding Review.YItems[0].Step0MotorAbsoluteValue}"
                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Step 1 Position: "
                                                   Status="{Binding Review.YItems[0].Step1MotorAbsoluteValue}"
                                                   Color="{StaticResource SuccessBrush}" />
                                        <hc:Shield Subject="Pixel Size (motor/px): "
