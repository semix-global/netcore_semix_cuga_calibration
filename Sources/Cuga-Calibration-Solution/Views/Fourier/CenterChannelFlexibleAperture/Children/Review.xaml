                        <TabItem Header="{Binding Review.YRodItems[3].AngleMotorAbsoluteValue, Mode=OneWay, StringFormat={}{0:0.###}°}">
                            <Border Margin="5" Style="{StaticResource BorderRegion}">
                                <DockPanel>
                                    <hc:UniformSpacingPanel DockPanel.Dock="Top"
                                                            Orientation="Vertical"
                                                            Spacing="2">
                                        <TextBox Text="{Binding Review.YRodItems[3].Width, Mode=OneWay}"
                                                 hc:TitleElement.Title="Width(mm): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="190"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding Review.YRodItems[3].Height, Mode=OneWay}"
                                                 hc:TitleElement.Title="Height(mm): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="190"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding Review.YRodItems[3].AngleMotorAbsoluteValue, Mode=OneWay}"
                                                 hc:TitleElement.Title="Angle(°): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="190"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding Review.YRodItems[3].Step0MotorAbsoluteValue, Mode=OneWay}"
                                                 hc:TitleElement.Title="Step 0 Position(mm): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="190"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding Review.YRodItems[3].Step1MotorAbsoluteValue, Mode=OneWay}"
                                                 hc:TitleElement.Title="Step 1 Position(mm): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="190"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding Review.YRodItems[3].Step0ROI.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                 hc:TitleElement.Title="Step 0 Rect(px): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="190"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding Review.YRodItems[3].Step1ROI.ImageROI, Mode=OneWay, Converter={StaticResource RectToStringConverter}}"
                                                 hc:TitleElement.Title="Step 1 Rect(px): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="190"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 Style="{StaticResource TextBoxExtend}" />
                                        <TextBox Text="{Binding Review.YRodItems[3].PixelSize, Mode=OneWay}"
                                                 hc:TitleElement.Title="Pixel Size(mm/px): "
                                                 hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.TitleWidth="190"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource SecondaryRegionBrush}"
                                                 Style="{StaticResource TextBoxExtend}" />
                                    </hc:UniformSpacingPanel>
                                    <wpf:OpticsFourierImageCanvasControl Document="{Binding Review.YRodItems[3].Document, Mode=OneWay}" />
                                </DockPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</UserControl>