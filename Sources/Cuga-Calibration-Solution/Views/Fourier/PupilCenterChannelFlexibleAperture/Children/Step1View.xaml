<UserControl x:Class="CugaCalibration.Views.Fourier.PupilCenterChannelFlexibleAperture.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CugaCalibration.Views.Fourier.PupilCenterChannelFlexibleAperture.Children"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Flourier"
             xmlns:imageViewer="clr-namespace:Net.Utilities.OpticsFourierImageViewer.WPF;assembly=Net.Utilities.OpticsFourierImageViewer.WPF"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignHeight="900"
             d:DesignWidth="1800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <RichTextBox Grid.Row="1"
                                 Margin="5"
                                 Padding="5"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <FlowDocument>
                            <Paragraph>
                                <Run Text="Get CH3 fourier image and save。" />
                                <LineBreak />
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1Command}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="3"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    Style="{StaticResource BorderRegion}">
                <hc:SimplePanel>
                    <hc:UniformSpacingPanel Spacing="5" Orientation="Horizontal">
                        <hc:ComboBox Width="280"
                                     HorizontalAlignment="Left"
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:InfoElement.Title="Position Show Type: "
                                     hc:InfoElement.Necessary="False"
                                     ItemsSource="{Binding Ch3PositionTypeValues}"
                                     SelectedItem="{Binding SelectedCh3PositionType, Mode=TwoWay}" />
                        <hc:ComboBox Width="215"
                                     HorizontalAlignment="Left"
                                     hc:InfoElement.TitlePlacement="Left"
                                     hc:InfoElement.Title="Chart Show Type: "
                                     hc:InfoElement.Necessary="False"
                                     ItemsSource="{Binding Ch3ShowTypeValues}"
                                     SelectedItem="{Binding SelectedCh3ShowType, Mode=TwoWay}" />
                        <hc:NumericUpDown Width="142"
                                          Margin="0,0,0,5"
                                          hc:InfoElement.Title="Degrees(°): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="10"
                                          Maximum="360"
                                          Increment="0.1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Ch3Angle, StringFormat={}{0:f1}}" />
                        <hc:NumericUpDown Width="195"
                                          Margin="0,0,0,5"
                                          hc:InfoElement.Title="TurnX Postion(mm): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="-100"
                                          Maximum="100"
                                          Increment="0.1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Ch3TurnX, StringFormat={}{0:f1}}" />
                        <Button Content="Get Image Degree" Command="{Binding GetImageDegree11Command}" />
                        <Button Content="Get Image TurnX" Command="{Binding GetImageTurn_X11Command}" />
                    </hc:UniformSpacingPanel>
                </hc:SimplePanel>
            </Border>
            <Border Grid.Row="1"
                    Padding="3"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    Style="{StaticResource BorderRegion}">
                <hc:SimplePanel>
                    <hc:UniformSpacingPanel Spacing="5" Orientation="Horizontal">
                        <hc:NumericUpDown Width="270"
                                          Margin="0,0,0,5"
                                          hc:InfoElement.Title="Vertical Rod Width(Pixsel): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="10"
                                          Maximum="900"
                                          IsReadOnly="True"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding RodWidthHeight}" />
                        <Button Content="Get VerticalRod Rect Data1" Command="{Binding GetVerticalRodRectData11Command}" />
                        <Button Content="Get VerticalRod Rect Data2" Command="{Binding GetVerticalRodRectData12Command}" />
                    </hc:UniformSpacingPanel>
                </hc:SimplePanel>
            </Border>
            <Border Grid.Row="2"
                    Padding="3"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    Style="{StaticResource BorderRegion}">
                <hc:SimplePanel>
                    <hc:UniformSpacingPanel Spacing="5" Orientation="Horizontal">
                        <hc:NumericUpDown Width="190"
                                          Margin="0,0,0,5"
                                          hc:InfoElement.Title="LightHole Degrees(°): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          Minimum="50"
                                          Maximum="70"
                                          Increment="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Ch3Angle60}" />
                        <Button Content="Get LightHole Image" Command="{Binding GetLightHoleImage1Command}" />
                        <TextBox Text="{Binding CirclePointX[0], Converter={StaticResource PointToStringConverter}}"
                                 Width="185"
                                 hc:InfoElement.Title="Point1: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CirclePointX[1], Converter={StaticResource PointToStringConverter}}"
                                 Width="185"
                                 hc:InfoElement.Title="Point2: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CirclePointX[2], Converter={StaticResource PointToStringConverter}}"
                                 Width="185"
                                 hc:InfoElement.Title="Point3: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CirclePointX[3], Converter={StaticResource PointToStringConverter}}"
                                 Width="185"
                                 hc:InfoElement.Title="Point4: "
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <Button Content="Get LightHole Data" Command="{Binding GetLightHoleData1Command}" />
                    </hc:UniformSpacingPanel>
                </hc:SimplePanel>
            </Border>
            <Border Grid.Row="4"
                    Padding="1"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    Style="{StaticResource BorderRegion}">
                <imageViewer:OpticsFourierImageViewerCanvas BitmapImageDrawable="{Binding Cache.BitmapImageDrawable1}"
                                                            CircleROIDrawable="{Binding Cache.CircleROIDrawable}"
                                                            RectROIDrawableList="{Binding Cache.RectROIDrawableList}" />
            </Border>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>

