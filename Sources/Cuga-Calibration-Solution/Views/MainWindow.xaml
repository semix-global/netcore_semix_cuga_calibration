<hc:Window x:Class="CugaCalibration.Views.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:converters="clr-namespace:CugaCalibration.Core.Converters"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels"
           xmlns:constants="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:wpfAttachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
           xmlns:nlog="clr-namespace:Net.Utilities.WPF.UI.Nlog;assembly=Net.Utilities.WPF"
           xmlns:valueConverters="clr-namespace:ValueConverters;assembly=ValueConverters"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:enums="clr-namespace:Local.SQL.DB.Providers.Models.Enums;assembly=Local.SQL.DB.Providers"
           xmlns:wpf="clr-namespace:Core.Utilities.WPF;assembly=Core.Utilities.WPF"
           xmlns:cookies="clr-namespace:Core.Models.Models.Common.Cookies;assembly=Core.Models"
           Width="1200"
           Height="800"
           d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
           wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
           Background="{StaticResource SecondaryRegionBrush}"
           Icon="pack://application:,,,/Cuga-Calibration-Solution;component/Assets/Images/CugaCalibration.ico"
           NonClientAreaBackground="{StaticResource PrimaryBrush}"
           NonClientAreaForeground="White"
           ResizeMode="CanResizeWithGrip"
           ShowTitle="False"
           Style="{StaticResource WindowWin10}"
           WindowStartupLocation="CenterScreen"
           WindowState="Maximized"
           mc:Ignorable="d">
    <Window.Resources>
        <converters:MultiValueEqualityViewModelConverter x:Key="MultiValueEqualityViewModelConverter" />
        <valueConverters:ValueConverterGroup x:Key="IntIsLessThan1ToBooleanConverter">
            <!--  [1, 100000000]之间true  -->
            <valueConverters:IsInRangeConverter MaxValue="100000000" MinValue="1" />
            <!--  反转  -->
            <valueConverters:BoolNegationConverter />
        </valueConverters:ValueConverterGroup>
    </Window.Resources>
    <hc:Window.NonClientAreaContent>
        <TextBlock Margin="5,0"
                   HorizontalAlignment="Left"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="White"
                   Style="{StaticResource TextBlockDefault}">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} [{1}]">
                    <Binding Path="ApplicationCookie.Title" Mode="OneWay" />
                    <Binding Path="RecipeCookie.SysRecipeInformationDTO.RecipeDbName" Mode="OneWay" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </hc:Window.NonClientAreaContent>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding ClosedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <DockPanel IsEnabled="{Binding StatusViewModel.IsEnable}">
            <Menu DockPanel.Dock="Top"
                  IsEnabled="{Binding IsEnable}"
                  ItemsSource="{Binding ApplicationCookie.TitleMenu.ChildList}">
                <Menu.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding DataContext.OpenToolMenuCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
                        <Setter Property="CommandParameter" Value="{Binding .}" />
                        <Setter Property="ItemsSource" Value="{Binding ChildList}" />
                        <Setter Property="Padding" Value="8,3" />
                    </Style>
                </Menu.ItemContainerStyle>
            </Menu>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TreeView ItemsSource="{Binding ApplicationCookie.CalibrationMenu.Children}">
                    <TreeView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Children.Count, Converter={StaticResource IntIsLessThan1ToBooleanConverter}}" Value="True">
                                    <Setter Property="wpfAttachedHelper:MouseDoubleClickHelper.Command" Value="{Binding DataContext.OpenCalibrationCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
                                    <Setter Property="wpfAttachedHelper:MouseDoubleClickHelper.CommandParameter" Value="{Binding SysMenu.Component}" />
                                </DataTrigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource MultiValueEqualityViewModelConverter}">
                                            <Binding Mode="OneWay" Path="SysMenu.Component" />
                                            <Binding Mode="OneWay"
                                                     Path="DataContext.ActiveItem"
                                                     RelativeSource="{RelativeSource FindAncestor,
                                                                                     AncestorType=Window}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Foreground" Value="{StaticResource DarkAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid x:Name="Grid">
                                <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Spacing="10"
                                                        Orientation="Horizontal">
                                    <wpf:CircleProgressToggleButton x:Name="ToggleButtonStatus"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Foreground="{StaticResource SuccessBrush}"
                                                                    Background="{StaticResource BorderBrush}"
                                                                    EffectBackground="{StaticResource InfoBrush}"
                                                                    Progress="{Binding Entry.Status.Progress}"
                                                                    IsOk="{Binding Entry.Status.IsOk}" />
                                    <Popup Width="450"
                                           Height="600"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=Grid}"
                                           Placement="Right"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide"
                                           IsOpen="{Binding IsChecked, ElementName=ToggleButtonStatus, Mode=TwoWay}">
                                        <Border Style="{StaticResource BorderRegion}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="5" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Entry.Name}"
                                                                   HorizontalAlignment="Center"
                                                                   Style="{StaticResource TextBlockSubTitle}" />
                                                    </StackPanel>
                                                    <Separator />
                                                    <StackPanel>
                                                        <TextBlock HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style BasedOn="{StaticResource TextBlockDefault}" TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Entry.Status.IsOk}" Value="{x:Static constants:Constants.True}">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Entry.Status.IsOk}" Value="{x:Static constants:Constants.False}">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run>
                                                                <Run.Style>
                                                                    <Style TargetType="Run">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Entry.Status.IsOk}" Value="{x:Static constants:Constants.True}">
                                                                                <Setter Property="Text" Value="OK: " />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Entry.Status.IsOk}" Value="{x:Static constants:Constants.False}">
                                                                                <Setter Property="Text" Value="Not OK: " />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Run.Style>
                                                            </Run>
                                                            <Run Text="{Binding Entry.Status.Progress, Mode=OneWay, StringFormat={}{0:0.###}%}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Style="{StaticResource BorderRegion}">
                                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                                            <StackPanel>
                                                                <TextBlock Text="Calibration"
                                                                           HorizontalAlignment="Center"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Style="{StaticResource TextBlockDefaultInfo}" />
                                                            </StackPanel>
                                                            <UniformGrid Columns="3">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="Total Count" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Entry.Status.TotalCalibrationCount}"
                                                                               HorizontalAlignment="Center"
                                                                               FontWeight="Bold" />
                                                                </StackPanel>
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="OK" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Entry.Status.CalibratedCount}"
                                                                               HorizontalAlignment="Center"
                                                                               FontWeight="Bold" />
                                                                </StackPanel>
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="Not Ok" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Entry.Status.NotOkCalibratedCount}"
                                                                               HorizontalAlignment="Center"
                                                                               FontWeight="Bold" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </hc:UniformSpacingPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource BorderRegion}">
                                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                                            <StackPanel>
                                                                <TextBlock Text="Review"
                                                                           HorizontalAlignment="Center"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"
                                                                           Style="{StaticResource TextBlockDefaultInfo}" />
                                                            </StackPanel>
                                                            <UniformGrid Columns="3">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="Total Count" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Entry.Status.TotalCalibrationCount}"
                                                                               HorizontalAlignment="Center"
                                                                               FontWeight="Bold" />
                                                                </StackPanel>
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="OK" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Entry.Status.ReviewCount}"
                                                                               HorizontalAlignment="Center"
                                                                               FontWeight="Bold" />
                                                                </StackPanel>
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="Not Ok" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Entry.Status.NotOkReviewCount}"
                                                                               HorizontalAlignment="Center"
                                                                               FontWeight="Bold" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </hc:UniformSpacingPanel>
                                                    </Border>
                                                </hc:UniformSpacingPanel>
                                                <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                                                        <StackPanel>
                                                            <TextBlock Text="Details"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Style="{StaticResource TextBlockDefaultInfo}" />
                                                        </StackPanel>
                                                        <ListView ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                  Style="{StaticResource ListView.Small}"
                                                                  ItemsSource="{Binding Entry.Status.Details}">
                                                            <ListView.View>
                                                                <GridView>
                                                                    <GridViewColumn Width="200"
                                                                                    Header="Item"
                                                                                    DisplayMemberBinding="{Binding Item}" />
                                                                    <GridViewColumn Width="100" Header="Calibration">
                                                                        <GridViewColumn.CellTemplate>
                                                                            <DataTemplate DataType="{x:Type cookies:CalibrationViewModelStatus+Detail}">
                                                                                <Ellipse Width="10"
                                                                                         Height="10"
                                                                                         HorizontalAlignment="Center"
                                                                                         VerticalAlignment="Center">
                                                                                    <Ellipse.Style>
                                                                                        <Style TargetType="Ellipse">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsCalibrated}" Value="null">
                                                                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsCalibrated}" Value="false">
                                                                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsCalibrated}" Value="true">
                                                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Ellipse.Style>
                                                                                </Ellipse>
                                                                            </DataTemplate>
                                                                        </GridViewColumn.CellTemplate>
                                                                    </GridViewColumn>
                                                                    <GridViewColumn Width="100" Header="Review">
                                                                        <GridViewColumn.CellTemplate>
                                                                            <DataTemplate DataType="{x:Type cookies:CalibrationViewModelStatus+Detail}">
                                                                                <Ellipse Width="10"
                                                                                         Height="10"
                                                                                         HorizontalAlignment="Center"
                                                                                         VerticalAlignment="Center">
                                                                                    <Ellipse.Style>
                                                                                        <Style TargetType="Ellipse">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsReviewed}" Value="null">
                                                                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsReviewed}" Value="false">
                                                                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding IsReviewed}" Value="true">
                                                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Ellipse.Style>
                                                                                </Ellipse>
                                                                            </DataTemplate>
                                                                        </GridViewColumn.CellTemplate>
                                                                    </GridViewColumn>
                                                                </GridView>
                                                            </ListView.View>
                                                        </ListView>
                                                    </hc:UniformSpacingPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                    <TextBlock Text="{Binding SysMenu.Name}" />
                                </hc:UniformSpacingPanel>
                            </Grid>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SysMenu.MenuTypeEnum}" Value="{x:Static enums:MenuTypeEnum.Catalog}">
                                    <Setter TargetName="ToggleButtonStatus" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SysMenu.MenuTypeEnum}" Value="{x:Static enums:MenuTypeEnum.Menu}">
                                    <Setter TargetName="Grid" Property="Margin" Value="-20,0,0,0" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <GridSplitter Grid.Column="1" Width="5" />
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="230" />
                    </Grid.RowDefinitions>
                    <hc:UniformSpacingPanel Spacing="10">
                        <Button Content="Calibrate"
                                Command="{Binding CalibrateCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonSuccess}" />
                        <Button Content="Review"
                                Command="{Binding ReviewCommand}"
                                hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                                Style="{StaticResource ButtonSuccess}" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                        <Button Content="Previous"
                                Command="{Binding PreviousCommand}"
                                hc:IconElement.Geometry="{StaticResource LeftGeometry}"
                                Style="{StaticResource ButtonPrimary}" />
                        <Button Content="Next"
                                Command="{Binding NextCommand}"
                                hc:IconElement.Geometry="{StaticResource RightGeometry}"
                                Style="{StaticResource ButtonPrimary}" />
                    </hc:UniformSpacingPanel>
                    <ContentControl Grid.Row="2">
                        <ContentControl.Style>
                            <Style BasedOn="{StaticResource {x:Type ContentControl}}" TargetType="{x:Type ContentControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveItem, Converter={x:Static valueConverters:NullToBoolConverter.Instance}}" Value="{x:Static constants:Constants.True}">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Viewbox Width="800" Height="800">
                                                    <Image HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Source="pack://application:,,,/Cuga-Calibration-Solution;component/Assets/Images/Logo1.png" />
                                                </Viewbox>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActiveItem, Converter={x:Static valueConverters:NullToBoolConverter.Instance}}" Value="{x:Static constants:Constants.False}">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <ContentControl Content="{Binding ActiveItem, Converter={StaticResource ViewModel2ViewConverter}}" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <GridSplitter Grid.Row="3" Height="5" />
                    <Grid Grid.Row="4">
                        <nlog:NLogViewer MinLogLevelEnum="{Binding CalibrationSetting.SettingCommonParam.MinLogLevelEnum, Mode=TwoWay}" TargetName="targetNLogViewer" />
                        <Button Content="Popup"
                                Command="{Binding ShowLogCommand}"
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                hc:IconElement.Geometry="{StaticResource AllGeometry}"
                                Style="{StaticResource ButtonDefault.Small}" />
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
        <Button Content="Refresh Cookie"
                Command="{Binding StatusViewModel.RefreshCookieCommand}"
                CommandParameter="{x:Static constants:Constants.False}"
                Margin="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                hc:IconElement.Geometry="{StaticResource RotateRightGeometry}"
                IsEnabled="{Binding StatusViewModel.IsEnable, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
            <Button.Style>
                <Style BasedOn="{StaticResource ButtonDefault.Small}" TargetType="Button">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding StatusViewModel.IsEnable}" Value="{x:Static constants:Constants.False}" />
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="{x:Static constants:Constants.False}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="wpfAttachedHelper:LoadingHelper.IsShow" Value="True" />
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource SecondaryBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</hc:Window>