<hc:Window x:Class="CugaCalibration.Views.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:converters="clr-namespace:CugaCalibration.Core.Converters"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels"
           xmlns:constants="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
           xmlns:wpfAttachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           xmlns:wpfMvvmAttachedHelper="clr-namespace:Net.Utilities.WPF.MVVM.AttachedHelper;assembly=Net.Utilities.WPF.MVVM"
           xmlns:nlog="clr-namespace:Net.Utilities.WPF.UI.Nlog;assembly=Net.Utilities.WPF"
           xmlns:valueConverters="clr-namespace:ValueConverters;assembly=ValueConverters"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:enums="clr-namespace:Local.SQL.DB.Providers.Models.Enums;assembly=Local.SQL.DB.Providers"
           xmlns:ui="clr-namespace:Core.Utilities.WPF.UI;assembly=Core.Utilities.WPF"
           xmlns:calibration="clr-namespace:Net.Utilities.WPF.CustomControl.Calibration;assembly=Net.Utilities.WPF.CustomControl.Calibration"
           Width="1200"
           Height="800"
           d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
           wpfMvvmAttachedHelper:AutoWireViewModelHelper.IsAutoWireViewModel="True"
           Background="{StaticResource SecondaryRegionBrush}"
           Icon="pack://application:,,,/Cuga-Calibration-Solution;component/Assets/Images/CugaCalibration.ico"
           NonClientAreaBackground="{StaticResource PrimaryBrush}"
           NonClientAreaForeground="White"
           ResizeMode="CanResizeWithGrip"
           ShowTitle="False"
           Style="{StaticResource WindowWin10}"
           WindowStartupLocation="CenterScreen"
           WindowState="Maximized"
           mc:Ignorable="d">
    <Window.Resources>
        <converters:MultiValueEqualityViewModelConverter x:Key="MultiValueEqualityViewModelConverter" />
        <valueConverters:ValueConverterGroup x:Key="IntIsLessThan1ToBooleanConverter">
            <valueConverters:IsInRangeConverter MaxValue="100000000" MinValue="1" />
            <valueConverters:BoolNegationConverter />
        </valueConverters:ValueConverterGroup>
    </Window.Resources>
    <hc:Window.NonClientAreaContent>
        <TextBlock Margin="5,0"
                   HorizontalAlignment="Left"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="White">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource TextBlockDefault}" TargetType="TextBlock">
                    <Setter Property="Text">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0} Calibration[{1}] Recipe[{2}]">
                                <Binding Path="ApplicationCookie.Title" Mode="OneWay" />
                                <Binding Path="ActiveItem.Name" Mode="OneWay" />
                                <Binding Path="RecipeCookie.SysRecipeInformationDTO.RecipeDbName" Mode="OneWay" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveItem}" Value="{x:Null}">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <MultiBinding StringFormat="{}{0} Recipe[{1}]">
                                        <Binding Path="ApplicationCookie.Title" Mode="OneWay" />
                                        <Binding Path="RecipeCookie.SysRecipeInformationDTO.RecipeDbName" Mode="OneWay" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </hc:Window.NonClientAreaContent>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding ClosedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel IsEnabled="{Binding StatusViewModel.IsEnable}">
        <Grid DockPanel.Dock="Top">
            <Menu IsEnabled="{Binding IsMenuEnable}" ItemsSource="{Binding ApplicationCookie.TitleMenu.ChildList}">
                <Menu.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding DataContext.OpenToolMenuCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
                        <Setter Property="CommandParameter" Value="{Binding .}" />
                        <Setter Property="ItemsSource" Value="{Binding ChildList}" />
                        <Setter Property="Padding" Value="8,3" />
                    </Style>
                </Menu.ItemContainerStyle>
            </Menu>
            <Button Content="Refresh Cookie"
                    Command="{Binding StatusViewModel.RefreshCookieCommand}"
                    CommandParameter="{x:Static constants:Constants.False}"
                    Margin="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    hc:IconElement.Geometry="{StaticResource RotateRightGeometry}"
                    IsEnabled="{Binding StatusViewModel.IsEnable, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonDefault.Small}" TargetType="Button">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StatusViewModel.IsEnable}" Value="{x:Static constants:Constants.False}" />
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="{x:Static constants:Constants.False}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="wpfAttachedHelper:LoadingHelper.IsShow" Value="True" />
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource SecondaryBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TreeView ItemsSource="{Binding ApplicationCookie.CalibrationMenu.Children}">
                <TreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Children.Count, Converter={StaticResource IntIsLessThan1ToBooleanConverter}}" Value="True">
                                <Setter Property="wpfAttachedHelper:MouseDoubleClickHelper.Command" Value="{Binding DataContext.OpenCalibrationCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
                                <Setter Property="wpfAttachedHelper:MouseDoubleClickHelper.CommandParameter" Value="{Binding SysMenu.Component}" />
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource MultiValueEqualityViewModelConverter}">
                                        <Binding Mode="OneWay" Path="SysMenu.Component" />
                                        <Binding Mode="OneWay"
                                                 Path="DataContext.ActiveItem"
                                                 RelativeSource="{RelativeSource FindAncestor,
                                                                                 AncestorType=Window}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Foreground" Value="{StaticResource DarkAccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid x:Name="Grid">
                            <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Spacing="10"
                                                    Orientation="Horizontal">
                                <calibration:CircleProgressButton x:Name="StatusButton"
                                                                  Command="{Binding DataContext.ShowCalibrationMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"
                                                                  Width="14"
                                                                  Height="14"
                                                                  Foreground="{StaticResource SuccessBrush}"
                                                                  Background="{StaticResource BorderBrush}"
                                                                  EffectBackground="{StaticResource InfoBrush}"
                                                                  Progress="{Binding Entry.Status.Progress}"
                                                                  IsOk="{Binding Entry.Status.IsOk}" />
                                <TextBlock Text="{Binding SysMenu.Name}" />
                            </hc:UniformSpacingPanel>
                        </Grid>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding SysMenu.MenuTypeEnum}" Value="{x:Static enums:MenuTypeEnum.Catalog}">
                                <Setter TargetName="StatusButton" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SysMenu.MenuTypeEnum}" Value="{x:Static enums:MenuTypeEnum.Menu}">
                                <Setter TargetName="Grid" Property="Margin" Value="-20,0,0,0" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <GridSplitter Grid.Column="1" Width="5" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>
                <hc:UniformSpacingPanel Spacing="10">
                    <Button Content="Calibrate"
                            Command="{Binding CalibrateCommand}"
                            hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                            IsEnabled="{Binding IsCalibrateEnable, Mode=OneWay}"
                            Style="{StaticResource ButtonSuccess}" />
                    <Button Content="Review"
                            Command="{Binding ReviewCommand}"
                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                            IsEnabled="{Binding IsReviewEnable, Mode=OneWay}"
                            Style="{StaticResource ButtonSuccess}" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                            IsEnabled="{Binding IsCancelEnable, Mode=OneWay}"
                            Style="{StaticResource ButtonWarning}" />
                    <Button Content="Previous"
                            Command="{Binding PreviousCommand}"
                            hc:IconElement.Geometry="{StaticResource LeftGeometry}"
                            IsEnabled="{Binding IsPreviousEnable, Mode=OneWay}"
                            Style="{StaticResource ButtonPrimary}" />
                    <Button Content="Next"
                            Command="{Binding NextCommand}"
                            hc:IconElement.Geometry="{StaticResource RightGeometry}"
                            IsEnabled="{Binding IsNextEnable, Mode=OneWay}"
                            Style="{StaticResource ButtonPrimary}" />
                </hc:UniformSpacingPanel>
                <Grid Grid.Row="2">
                    <calibration:HorizontalExpandPanel x:Name="HorizontalExpandPanel"
                                                       PanelBackground="{StaticResource DarkDefaultBrush}"
                                                       PanelHoverBackground="{StaticResource RegionBrush}"
                                                       PanelForeground="{StaticResource SecondaryTextBrush}"
                                                       PanelBorderBrush="{StaticResource BorderBrush}"
                                                       PanelBorderThickness="1"
                                                       PanelBorderCornerRadius="5"
                                                       HorizontalExpandDirectionEnum="Right"
                                                       IsExpanded="False"
                                                       PanelVisibility="{Binding ActiveItem, Converter={StaticResource NotNullToVisibilityConverter}, Mode=OneWay}">
                        <calibration:HorizontalExpandPanel.MainContent>
                            <ContentControl>
                                <ContentControl.Style>
                                    <Style BasedOn="{StaticResource {x:Type ContentControl}}" TargetType="{x:Type ContentControl}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveItem, Converter={x:Static valueConverters:NullToBoolConverter.Instance}}" Value="{x:Static constants:Constants.True}">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Viewbox Width="800" Height="800">
                                                            <Image HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Source="pack://application:,,,/Cuga-Calibration-Solution;component/Assets/Images/Logo1.png" />
                                                        </Viewbox>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveItem, Converter={x:Static valueConverters:NullToBoolConverter.Instance}}" Value="{x:Static constants:Constants.False}">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ContentControl Content="{Binding ActiveItem, Converter={StaticResource ViewModel2ViewConverter}}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </calibration:HorizontalExpandPanel.MainContent>
                        <calibration:HorizontalExpandPanel.ExpandContent>
                            <Border Style="{StaticResource BorderRegion}"
                                    CornerRadius="5,5,0,5"
                                    BorderThickness="1,1,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="50" />
                                        <RowDefinition Height="35" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Instructions"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource TextBlockLargeBold}" />
                                    <hc:ButtonGroup Grid.Row="1"
                                                    Margin="5"
                                                    HorizontalAlignment="Center">
                                        <RadioButton Content="Introduction"
                                                     IsChecked="True"
                                                     GroupName="InstructionTabs"
                                                     Style="{StaticResource RadioGroupItemHorizontalFirst}" />
                                        <RadioButton Content="Others"
                                                     IsChecked="False"
                                                     GroupName="InstructionTabs"
                                                     Style="{StaticResource RadioGroupItemHorizontalLast}" />
                                    </hc:ButtonGroup>
                                    <Grid Grid.Row="2">
                                        <ui:MarkdownViewer Margin="10"
                                                           MarkdownFilePath="{Binding ActiveItem.HtmlPath}"
                                                           Tag="{Binding ActiveItem}"
                                                           IsPopupEnabled="True" />
                                    </Grid>
                                    <hc:StepBar Grid.Row="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                StepIndex="{Binding ActiveItem.CalibrationStepIndex}"
                                                ItemsSource="{Binding ActiveItem.CalibrationSteps}">
                                        <hc:StepBar.ItemTemplate>
                                            <DataTemplate />
                                        </hc:StepBar.ItemTemplate>
                                    </hc:StepBar>
                                    <ProgressBar Grid.Row="4"
                                                 Margin="5"
                                                 Style="{StaticResource ProgressBarSuccess}"
                                                 Value="{Binding ActiveItem.CalibrationProgress, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </calibration:HorizontalExpandPanel.ExpandContent>
                    </calibration:HorizontalExpandPanel>
                    <hc:UniformSpacingPanel>
                        <hc:UniformSpacingPanel.Style>
                            <Style TargetType="{x:Type hc:UniformSpacingPanel}">
                                <Setter Property="Margin" Value="-3" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                <Setter Property="Orientation" Value="Vertical" />
                                <Setter Property="Spacing" Value="5" />
                                <Setter Property="Visibility" Value="{Binding ActiveItem, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=HorizontalExpandPanel}" Value="{x:Static constants:Constants.True}">
                                        <Setter Property="Margin" Value="5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:UniformSpacingPanel.Style>
                        <Button Command="{Binding ExportCommand}"
                                Padding="5"
                                hc:IconElement.Geometry="{StaticResource CustomExportGeometry}"
                                Style="{StaticResource ButtonIcon}" />
                        <Button Command="{Binding ImportCommand}"
                                Padding="5"
                                hc:IconElement.Geometry="{StaticResource CustomImportGeometry}"
                                Style="{StaticResource ButtonIcon}" />
                        <hc:StepBar Margin="0,0,10,0"
                                    Dock="Right"
                                    StepIndex="{Binding ActiveItem.CalibrationStepIndex}"
                                    ItemsSource="{Binding ActiveItem.CalibrationSteps}"
                                    Visibility="{Binding IsExpanded, ElementName=HorizontalExpandPanel, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                            <hc:StepBar.ItemTemplate>
                                <DataTemplate />
                            </hc:StepBar.ItemTemplate>
                        </hc:StepBar>
                    </hc:UniformSpacingPanel>
                </Grid>
                <GridSplitter Grid.Row="3" Height="5" />
                <Grid Grid.Row="4" Grid.Column="0">
                    <nlog:NLogViewer MinLogLevelEnum="{Binding CalibrationSetting.SettingCommonParam.MinLogLevelEnum, Mode=TwoWay}" TargetName="targetNLogViewer" />
                    <Button Content="Popup"
                            Command="{Binding ShowLogCommand}"
                            Margin="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            hc:IconElement.Geometry="{StaticResource AllGeometry}"
                            Style="{StaticResource ButtonDefault.Small}" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</hc:Window>