<UserControl x:Class="CugaCalibration.Views.Chuck.AutoFocus.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:children="clr-namespace:CugaCalibration.Views.Chuck.AutoFocus.Children"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckAutoFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Auto Focus: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Verify calibration result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown Margin="0,0,0,5"
                                      hc:InfoElement.Title="Threshold(Rate): "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="140"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Threshold}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <children:MapView Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ActualHeight}" />
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>