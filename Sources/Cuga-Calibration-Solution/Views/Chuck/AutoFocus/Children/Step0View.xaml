<UserControl x:Class="CugaCalibration.Views.Chuck.AutoFocus.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:children="clr-namespace:CugaCalibration.Views.Chuck.AutoFocus.Children"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckAutoFocusCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Auto Focus Step 1: "
                           Status="{Binding CalibrationStepList[0].StepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <StackPanel>
                        <TextBlock Text="1. Param "
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:ComboBox x:Name="LowMagCombobox"
                                         HorizontalAlignment="Left"
                                         hc:InfoElement.TitlePlacement="Left"
                                         hc:InfoElement.Title="Low Magnification: "
                                         hc:InfoElement.Necessary="True"
                                         SelectedItem="{Binding Cache.MicroscopeLensInformation}"
                                         ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformationList}">
                                <hc:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LensName}" />
                                    </DataTemplate>
                                </hc:ComboBox.ItemTemplate>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="SelectionChanged">
                                        <b:InvokeCommandAction Command="{Binding MagnificationSelectedCommand}" CommandParameter="{Binding ElementName=LowMagCombobox, Path=SelectedItem}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </hc:ComboBox>
                            <hc:NumericUpDown Margin="0,0,0,5"
                                              hc:InfoElement.Title="Row Number: "
                                              hc:TitleElement.TitleWidth="180"
                                              hc:InfoElement.TitlePlacement="Left"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.RowNumber}" />
                            <hc:NumericUpDown Margin="0,0,0,5"
                                              hc:InfoElement.Title="Column Number: "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.ColumnNumber}" />
                            <hc:NumericUpDown Margin="0,0,0,5"
                                              hc:InfoElement.Title="Chuck Diameter(um): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.ChuckDiameter}" />
                            <hc:NumericUpDown Margin="0,0,0,5"
                                              hc:InfoElement.Title="Wafer Reduce Width(um): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.WaferReduceWidth}" />
                            <hc:NumericUpDown Margin="0,0,0,5"
                                              hc:InfoElement.Title="Wafer Reduce Height(um): "
                                              hc:InfoElement.TitlePlacement="Left"
                                              hc:InfoElement.ShowClearButton="True"
                                              hc:TitleElement.TitleWidth="180"
                                              Minimum="1"
                                              Style="{StaticResource NumericUpDownExtend}"
                                              Value="{Binding Cache.WaferReduceHeight}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                    <StackPanel>
                        <TextBlock Text="2. Chuck Map"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.ColumnCellWidth, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Column Cell Width: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.RowCellHeight, Mode=OneWay, StringFormat={}{0:f3}}"
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.Title="Column Cell Height: "
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step0CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step0CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2" Header="History">
            <children:MapView Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ActualHeight}" />
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>