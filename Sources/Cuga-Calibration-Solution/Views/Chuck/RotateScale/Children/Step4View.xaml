<UserControl x:Class="CugaCalibration.Views.Chuck.RotateScale.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckRotateScaleCalibrationViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="1600"
             mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--#region Left-->
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:Shield Subject="Rotate Scale Step 5: "
                               Status="{Binding CalibrationStepList[4].StepName}"
                               Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                               Color="{StaticResource InfoBrush}" />
                </hc:UniformSpacingPanel>

                <Border Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Calibration Global Scale Coeffiecient"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown Margin="0,5,0,5"
                                          hc:InfoElement.Title="Threshold(um): "
                                          hc:InfoElement.TitlePlacement="Left"
                                          hc:InfoElement.ShowClearButton="True"
                                          hc:TitleElement.TitleWidth="120"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Threshold}" />
                        <TextBox Text="{Binding ResultRotateScaleErrorDto.AppliedScaleT, StringFormat={}{0:f6}}"
                                 hc:InfoElement.Title="Applied Scale: "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ResultRotateScaleErrorDto.ResultScaleT, StringFormat={}{0:f6}}"
                                 hc:InfoElement.Title="Result Scale: "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ResultRotateScaleErrorDto.ScaleErrorValueAverage}"
                                 hc:InfoElement.Title="Error Value(um): "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10"
                                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
                            <Button x:Name="ActionButton"
                                    Content="Action"
                                    Command="{Binding Step4CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Command="{Binding Step4CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </hc:UniformSpacingPanel>
            <!--#endregion-->

            <GridSplitter Grid.Column="1" Width="5" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox MinHeight="250"
                          Margin="0,0,0,10"
                          Header="History">
                    <ListView d:SelectedIndex="0"
                              ItemsSource="{Binding RotateErrorDtoItemDtoList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectRotateScaleErrorDto}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="150"
                                                Header="AppliedScale"
                                                DisplayMemberBinding="{Binding AppliedScaleT}" />
                                <GridViewColumn Width="150"
                                                Header="ResultScale"
                                                DisplayMemberBinding="{Binding ResultScaleT}" />
                                <GridViewColumn Width="150"
                                                Header="Angle Error(°)"
                                                DisplayMemberBinding="{Binding RealAngleErrorsAverage}" />
                                <GridViewColumn Width="150"
                                                Header="Error Value(um)"
                                                DisplayMemberBinding="{Binding ScaleErrorValueAverage}" />

                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
                <GridSplitter Grid.Row="1" />
                <hc:UniformSpacingPanel Grid.Row="2"
                                        Orientation="Vertical"
                                        Spacing="5">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <TextBlock Text="Find Result Image"
                                   HorizontalAlignment="Center"
                                   Background="Transparent" />
                    </Border>
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.Column="0"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectRotateScaleErrorDto.PositiveTopFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectRotateScaleErrorDto.PositiveTopHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Positive-Top Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1"
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectRotateScaleErrorDto.PositiveBottomFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectRotateScaleErrorDto.PositiveBottomHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Positive-Bottom Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectRotateScaleErrorDto.PositiveLeftFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectRotateScaleErrorDto.PositiveLeftHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Positive-Left Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="3"
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectRotateScaleErrorDto.PositiveRightFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectRotateScaleErrorDto.PositiveRightHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Positive-Right Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectRotateScaleErrorDto.NegativeTopFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectRotateScaleErrorDto.NegativeTopHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Negative-Top Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectRotateScaleErrorDto.NegativeBottomFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectRotateScaleErrorDto.NegativeBottomHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Negative-Bottom Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectRotateScaleErrorDto.NegativeLeftFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectRotateScaleErrorDto.NegativeLeftHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Negative-Left Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3"
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <hc:UniformSpacingPanel HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Orientation="Vertical"
                                                        Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectRotateScaleErrorDto.NegativeRightFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectRotateScaleErrorDto.NegativeRightHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Negative-Right Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Grid>
                    </Border>
                </hc:UniformSpacingPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>