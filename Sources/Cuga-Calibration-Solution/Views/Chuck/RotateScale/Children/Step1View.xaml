<UserControl x:Class="CugaCalibration.Views.Chuck.RotateScale.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:wafer="clr-namespace:Core.Models.Enums.Recipe.Wafer;assembly=Core.Models"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckRotateScaleCalibrationViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Rotate Scale Step 2: "
                           Status="{Binding CalibrationStepList[1].StepName}"
                           Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:ComboBox x:Name="TemplateTypeComboBox"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitleWidth="140"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Template Type: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.AlgorithmTemplateTypeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox x:Name="LowMagCombobox"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Low Magnification: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding IdeaPositionCache.LowGlobalScaleErrorCacheItem.LensInformation, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformationList}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LensName}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding MagnificationSelectedCommand}" CommandParameter="{Binding ElementName=LowMagCombobox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                    <hc:ComboBox x:Name="HighMagCombobox"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="High Magnification: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding IdeaPositionCache.HighGlobalScaleErrorCacheItem.LensInformation, UpdateSourceTrigger=PropertyChanged}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeLensInformationList}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LensName}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding MagnificationSelectedCommand}" CommandParameter="{Binding ElementName=HighMagCombobox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                    <hc:ComboBox HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Template Mask Type: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding IdeaPositionCache.WaferMaskTypeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type wafer:WaferMaskTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:NumericUpDown Margin="0,0,0,5"
                                      hc:InfoElement.Title="Column Cell Width(um): "
                                      hc:TitleElement.TitleWidth="180"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding IdeaPositionCache.ColumnCellWidth}" />
                    <hc:NumericUpDown Margin="0,0,0,5"
                                      hc:InfoElement.Title="Row Cell Height(um): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding IdeaPositionCache.RowCellHeight}" />
                    <hc:NumericUpDown Margin="0,0,0,5"
                                      hc:InfoElement.Title="Wafer Diameter(um): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding IdeaPositionCache.WaferDiameter}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="2. Find Low Position Template"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding IdeaPositionCache.BaseLowSiteFindPosition, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Position(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10"
                                            Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>