<UserControl x:Class="CugaCalibration.Views.Chuck.RotateScale.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:stage="clr-namespace:Core.Models.Enums.Stage;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckRotateScaleCalibrationViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Rotate Scale Step 4: "
                           Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Site Direction: "
                           Status="{Binding IdeaPositionCache.SiteDirection}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Find High Position Template"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Width="275"
                             Margin="5"
                             hc:InfoElement.Title="Position(um): "
                             hc:InfoElement.TitlePlacement="Left">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IdeaPositionCache.SiteDirection}" Value="{x:Static stage:StageDirectionTypeEnum.Up}">
                                        <Setter Property="Text" Value="{Binding IdeaPositionCache.HighGlobalScaleErrorCacheItem.TopPosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IdeaPositionCache.SiteDirection}" Value="{x:Static stage:StageDirectionTypeEnum.Down}">
                                        <Setter Property="Text" Value="{Binding IdeaPositionCache.HighGlobalScaleErrorCacheItem.BottomPosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IdeaPositionCache.SiteDirection}" Value="{x:Static stage:StageDirectionTypeEnum.Left}">
                                        <Setter Property="Text" Value="{Binding IdeaPositionCache.HighGlobalScaleErrorCacheItem.LeftPosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IdeaPositionCache.SiteDirection}" Value="{x:Static stage:StageDirectionTypeEnum.Right}">
                                        <Setter Property="Text" Value="{Binding IdeaPositionCache.HighGlobalScaleErrorCacheItem.RightPosition, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <view:CanvasView Width="100"
                                     Height="100"
                                     BackgroundColor="#0A0A0A"
                                     AxisColor="Red"
                                     Interactive="True"
                                     ShowAxes="True"
                                     ShowCursor="False"
                                     ShowGrid="False">
                        <view:CanvasView.Style>
                            <Style TargetType="view:CanvasView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IdeaPositionCache.SiteDirection}" Value="{x:Static stage:StageDirectionTypeEnum.Up}">
                                        <Setter Property="BackgroundImage" Value="{Binding IdeaPositionCache.HighGlobalScaleErrorCacheItem.TopTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IdeaPositionCache.SiteDirection}" Value="{x:Static stage:StageDirectionTypeEnum.Down}">
                                        <Setter Property="BackgroundImage" Value="{Binding IdeaPositionCache.HighGlobalScaleErrorCacheItem.BottomTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IdeaPositionCache.SiteDirection}" Value="{x:Static stage:StageDirectionTypeEnum.Left}">
                                        <Setter Property="BackgroundImage" Value="{Binding IdeaPositionCache.HighGlobalScaleErrorCacheItem.LeftTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IdeaPositionCache.SiteDirection}" Value="{x:Static stage:StageDirectionTypeEnum.Right}">
                                        <Setter Property="BackgroundImage" Value="{Binding IdeaPositionCache.HighGlobalScaleErrorCacheItem.RightTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </view:CanvasView.Style>
                    </view:CanvasView>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10"
                                            Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step3CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step3CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>