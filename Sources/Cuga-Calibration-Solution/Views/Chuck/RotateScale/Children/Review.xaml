<UserControl x:Class="CugaCalibration.Views.Chuck.RotateScale.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckRotateScaleCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1300"
             mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="8*" />
            </Grid.ColumnDefinitions>
            <!--#region Left-->
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:Shield Subject="Rotate Scale Step: "
                               Status="Review"
                               Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                               Color="{StaticResource InfoBrush}" />
                </hc:UniformSpacingPanel>

                <Border Style="{StaticResource BorderRegion}"
                        Effect="{StaticResource EffectShadow1}"
                        IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Calibration Rotate Scale Coefficient"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox x:Name="ThresholdTextBox"
                                 Text="{Binding Cache.Threshold}"
                                 hc:InfoElement.Title="Threshold: "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectRotateScaleErrorDto.AppliedScaleT, StringFormat={}{0:f14}}"
                                 hc:InfoElement.Title="Applied Scale: "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectRotateScaleErrorDto.ResultScaleT, StringFormat={}{0:f14}}"
                                 hc:InfoElement.Title="Result Scale: "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectRotateScaleErrorDto.ScaleErrorValueAverage}"
                                 hc:InfoElement.Title="Error Value(um): "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10"
                                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
                            <Button x:Name="ActionButton"
                                    Content="Action"
                                    Command="{Binding VerifyActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Command="{Binding VerifyActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </hc:UniformSpacingPanel>
            <!--#endregion-->
            <GridSplitter Grid.Column="1" Width="5" />

        </Grid>
    </Grid>
</UserControl>