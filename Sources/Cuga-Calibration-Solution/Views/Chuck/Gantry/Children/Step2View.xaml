<UserControl x:Class="CugaCalibration.Views.Chuck.Gantry.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckGantryCalibrationViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Gantry Step 3: "
                           Status="{Binding CalibrationStepList[2].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="High Microscope Magnification: "
                           Status="{Binding Cache.HighMicroscopeMagnificationEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Find Position 、Template"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.HighFindPosition1, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Position1(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:ButtonGroup Width="275">
                        <Button x:Name="HighSiteP1GetButton"
                                Content="Get"
                                Command="{Binding GetPointCommand}"
                                CommandParameter="HighFindPosition1" />
                        <Button x:Name="HighSiteP1GotoButton"
                                Content="Goto"
                                Command="{Binding GotoPointCommand}"
                                CommandParameter="HighFindPosition1" />
                    </hc:ButtonGroup>
                    <view:CanvasView Width="100"
                                     Height="100"
                                     BackgroundColor="#0A0A0A"
                                     AxisColor="Red"
                                     Interactive="True"
                                     ShowAxes="True"
                                     ShowCursor="False"
                                     ShowGrid="False"
                                     BackgroundImage="{Binding Cache.HighTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                    <TextBox Text="{Binding Cache.HighFindPosition2, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Position2(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:ButtonGroup Width="275">
                        <Button x:Name="HighSiteP2GetButton"
                                Content="Get"
                                Command="{Binding GetPointCommand}"
                                CommandParameter="HighFindPosition2" />
                        <Button x:Name="HighSiteP2GotoButton"
                                Content="Goto"
                                Command="{Binding GotoPointCommand}"
                                CommandParameter="HighFindPosition2" />
                    </hc:ButtonGroup>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step2CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step2CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
    </Grid>
</UserControl>