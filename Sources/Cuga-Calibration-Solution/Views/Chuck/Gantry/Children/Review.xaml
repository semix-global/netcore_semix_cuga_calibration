<UserControl x:Class=" CugaCalibration.Views.Chuck.Gantry.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckGantryCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Gantry Step: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="ThresholdNumeric"
                                      Width="275"
                                      hc:TitleElement.Title="Threshold: "
                                      hc:TitleElement.TitleWidth="90"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Threshold}" />
                    <TextBox Text="{Binding Cache.VerifyResultOffset, StringFormat={}{0:f3}}"
                             Width="275"
                             hc:TitleElement.Title="Result Offset: "
                             hc:TitleElement.TitleWidth="90"
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <GroupBox Grid.Column="2"
                  Height="350"
                  VerticalAlignment="Top"
                  Header="Calibration Data">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                        <Setter Property="Margin" Value="5" />
                    </Style>
                    <Style BasedOn="{StaticResource TextBlockDefaultInfo}" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                    </Style>
                </Grid.Resources>
                <Border Grid.Row="0" Grid.Column="0"
                        Grid.ColumnSpan="2">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <TextBox Text="{Binding ReviewDto.Offset, StringFormat={}{0:f3}}"
                                 VerticalAlignment="Center"
                                 hc:TitleElement.TitleWidth="90"
                                 hc:TitleElement.Title="Offset(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ReviewDto.Slope, Mode=OneWay, StringFormat={}{0:f3}}"
                                 VerticalAlignment="Center"
                                 hc:TitleElement.TitleWidth="90"
                                 hc:TitleElement.Title="Slope: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                    </hc:UniformSpacingPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <StackPanel>
                            <TextBlock Text="Position1" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <TextBox Text="{Binding ReviewDto.Position1, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="Position(um): "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.TemplateScore1, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="Score:"
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.TemplateAngle1, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="Angle: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:ButtonGroup>
                                <Button x:Name="P1GotoButton"
                                        Content="Goto"
                                        Command="{Binding StageViewModel.SetBrightFieldAbsoluteStageXyCommand}"
                                        CommandParameter="{Binding ReviewDto.Position1}"
                                        Width="120" />
                                <Button x:Name="P1ReviewTemplateButton"
                                        Content="Review Template"
                                        Command="{Binding ReviewViewModel.ReviewCommand}"
                                        CommandParameter="{Binding Cache.LowBaseTemplateImageFilePath}"
                                        Width="120" />
                                <Button x:Name="P1ReviewImageButton"
                                        Content="Review Image"
                                        Command="{Binding ReviewViewModel.ReviewCommand}"
                                        CommandParameter="{Binding ReviewDto.FilePath1}"
                                        Width="120" />
                            </hc:ButtonGroup>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                        <StackPanel>
                            <TextBlock Text="Position2" />
                        </StackPanel>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <TextBox Text="{Binding ReviewDto.Position2, Converter={StaticResource PointToStringConverter}}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="Position(um): "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.TemplateScore2, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="Score:"
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <TextBox Text="{Binding ReviewDto.TemplateAngle2, StringFormat={}{0:f3}}"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:TitleElement.Title="Angle: "
                                     hc:TitleElement.TitlePlacement="Left"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                            <hc:ButtonGroup>
                                <Button x:Name="P2GotoButton"
                                        Content="Goto"
                                        Command="{Binding StageViewModel.SetBrightFieldAbsoluteStageXyCommand}"
                                        CommandParameter="{Binding ReviewDto.Position2}"
                                        Width="120" />
                                <Button x:Name="P2ReviewTemplateButton"
                                        Content="Review Template"
                                        Command="{Binding ReviewViewModel.ReviewCommand}"
                                        CommandParameter="{Binding Cache.HighBaseTemplateImageFilePath}"
                                        Width="120" />
                                <Button x:Name="P2ReviewImageButton"
                                        Content="Review Image"
                                        Command="{Binding ReviewViewModel.ReviewCommand}"
                                        CommandParameter="{Binding ReviewDto.FilePath2}"
                                        Width="120" />
                            </hc:ButtonGroup>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </Grid>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>