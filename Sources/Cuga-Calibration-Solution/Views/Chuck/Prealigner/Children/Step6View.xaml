<UserControl x:Class="CugaCalibration.Views.Chuck.Prealigner.Children.Step6View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckPrealignerCalibrationViewModel}"
             d:DesignHeight="1080"
             d:DesignWidth="1800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
            <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                       Status="{Binding CalibrationStepName}"
                       Color="{StaticResource InfoBrush}" />
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown hc:TitleElement.TitleWidth="190"
                                      hc:TitleElement.Title="Times:"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="50"
                                      Increment="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.Times}" />
                    <hc:NumericUpDown x:Name="PositionThresholdNumeric"
                                      hc:TitleElement.TitleWidth="190"
                                      hc:TitleElement.Title="Verify Offset Threshold(um):"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="500"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyPositionThreshold}" />
                    <hc:NumericUpDown x:Name="AngleThresholdNumeric"
                                      hc:TitleElement.Title="Verify Degrees Threshold(°): "
                                      hc:TitleElement.TitleWidth="190"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.0001"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyDegreesThreshold}" />
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding CalibrateItem.EfemLoadWaferChuckAbsoluteAngle, Mode=OneWay, StringFormat={}{0:f10}}"
                             hc:TitleElement.Title="Teaching Degrees(°): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding CalibrateItem.OffsetPosition, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="Teaching Offset Position(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding CalibrateDTO.ResultItemDto.EfemLoadWaferChuckAbsoluteAngle, StringFormat={}{0:f10}}"
                             hc:TitleElement.Title="Verify Degrees(°): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding CalibrateDTO.ResultItemDto.OffsetPosition, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="Verify Offset Position(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />

                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action"
                                Command="{Binding Step6CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step6CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>

        <GridSplitter Grid.Column="1" Width="5" />

        <GroupBox Grid.Column="2" Header="History">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="6*" />
                </Grid.RowDefinitions>
                <ListView x:Name="ListView"
                          ItemsSource="{Binding CalibrateDTO.Items}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </i:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Offset Position" DisplayMemberBinding="{Binding OffsetPosition, Converter={StaticResource PointToStringConverter}, StringFormat='0.###'}" />
                            <GridViewColumn Header="Load Wafer Stage Position" DisplayMemberBinding="{Binding EfemLoadWaferStagePosition, Converter={StaticResource PointToStringConverter}, StringFormat='0.###'}" />
                            <GridViewColumn Header="New Load Wafer Stage Position" DisplayMemberBinding="{Binding NewEfemLoadWaferStagePosition, Converter={StaticResource PointToStringConverter}, StringFormat='0.###'}" />
                            <GridViewColumn Header="Offset Angle" DisplayMemberBinding="{Binding EfemLoadWaferChuckAbsoluteAngle, StringFormat='0.#####'}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" />

                <GroupBox Grid.Row="2" Header="History Plot">
                    <TabControl>
                        <TabItem Header="Summary">
                            <hc:ScrollViewer>
                                <ContentControl Content="{Binding CalibrateDTO.ScatterPlotControl, Mode=OneWay}" />
                            </hc:ScrollViewer>
                        </TabItem>
                    </TabControl>
                </GroupBox>


            </Grid>
        </GroupBox>
    </Grid>
</UserControl>