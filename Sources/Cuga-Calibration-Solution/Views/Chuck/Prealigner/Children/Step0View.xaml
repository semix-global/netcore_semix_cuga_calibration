                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Top"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:ImageViewer Width="200"
                                            Height="200"
                                            ShowToolBar="False"
                                            ShowImgMap="False"
                                            Background="#0A0A0A"
                                            ImageSource="{Binding Cache.WaferCenterThumb4, Converter={StaticResource BitmapMemoryByteArrayToBitmapFrameConverter}}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ImageViewerClickBehavior BitmapSource="{Binding Cache.WaferCenterThumb4, Mode=TwoWay, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" ClickPosition="{Binding Cache.FindWaferCenterOffset4}" />
                                </i:Interaction.Behaviors>
                            </hc:ImageViewer>
                            <TextBox Text="{Binding Cache.FindWaferCenterOffset4, Converter={StaticResource PointToStringConverter}}"
                                     Width="180"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Top"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:ImageViewer Width="200"
                                            Height="200"
                                            ShowToolBar="False"
                                            ShowImgMap="False"
                                            Background="#0A0A0A"
                                            ImageSource="{Binding Cache.WaferCenterThumb5, Converter={StaticResource BitmapMemoryByteArrayToBitmapFrameConverter}}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ImageViewerClickBehavior BitmapSource="{Binding Cache.WaferCenterThumb5, Mode=TwoWay, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" ClickPosition="{Binding Cache.FindWaferCenterOffset5}" />
                                </i:Interaction.Behaviors>
                            </hc:ImageViewer>
                            <TextBox Text="{Binding Cache.FindWaferCenterOffset5, Converter={StaticResource PointToStringConverter}}"
                                     Width="180"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Top"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:ImageViewer Width="200"
                                            Height="200"
                                            ShowToolBar="False"
                                            ShowImgMap="False"
                                            Background="#0A0A0A"
                                            ImageSource="{Binding Cache.WaferCenterThumb6, Converter={StaticResource BitmapMemoryByteArrayToBitmapFrameConverter}}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ImageViewerClickBehavior BitmapSource="{Binding Cache.WaferCenterThumb6, Mode=TwoWay, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" ClickPosition="{Binding Cache.FindWaferCenterOffset6}" />
                                </i:Interaction.Behaviors>
                            </hc:ImageViewer>
                            <TextBox Text="{Binding Cache.FindWaferCenterOffset6, Converter={StaticResource PointToStringConverter}}"
                                     Width="180"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Top"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:ImageViewer Width="200"
                                            Height="200"
                                            ShowToolBar="False"
                                            ShowImgMap="False"
                                            Background="#0A0A0A"
                                            ImageSource="{Binding Cache.WaferCenterThumb7, Converter={StaticResource BitmapMemoryByteArrayToBitmapFrameConverter}}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ImageViewerClickBehavior BitmapSource="{Binding Cache.WaferCenterThumb7, Mode=TwoWay, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" ClickPosition="{Binding Cache.FindWaferCenterOffset7}" />
                                </i:Interaction.Behaviors>
                            </hc:ImageViewer>
                            <TextBox Text="{Binding Cache.FindWaferCenterOffset7, Converter={StaticResource PointToStringConverter}}"
                                     Width="180"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Top"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:ImageViewer Width="200"
                                            Height="200"
                                            ShowToolBar="False"
                                            ShowImgMap="False"
                                            Background="#0A0A0A"
                                            ImageSource="{Binding Cache.WaferCenterThumb8, Converter={StaticResource BitmapMemoryByteArrayToBitmapFrameConverter}}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ImageViewerClickBehavior BitmapSource="{Binding Cache.WaferCenterThumb8, Mode=TwoWay, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" ClickPosition="{Binding Cache.FindWaferCenterOffset8}" />
                                </i:Interaction.Behaviors>
                            </hc:ImageViewer>
                            <TextBox Text="{Binding Cache.FindWaferCenterOffset8, Converter={StaticResource PointToStringConverter}}"
                                     Width="180"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Top"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                </UniformGrid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>