<UserControl x:Class="CugaCalibration.Views.Chuck.Prealigner.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckPrealignerCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Prealigner Step 1: "
                           Status="{Binding CalibrationStepList[0].StepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text=" Calibration Position Offset"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="PositionThresholdNumeric"
                                      Width="275"
                                      hc:InfoElement.Title="Offset Threshold(um):"
                                      hc:InfoElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="400"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.PositionThreshold}" />
                    <TextBox Text="{Binding Cache.OffsetPosition, Converter={StaticResource PointToStringConverter}}"
                             Width="275"
                             hc:InfoElement.Title="Center offset(um):"
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step0CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step0CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <Grid Grid.Column="2">
            <GroupBox Header="Find Wafer Center Image" IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <UniformGrid Columns="4" Rows="2">
                    <UniformGrid.Resources>
                        <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                            <Setter Property="Margin" Value="1" />
                        </Style>
                        <Style BasedOn="{StaticResource TextBlockDefaultInfo}" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        </Style>
                    </UniformGrid.Resources>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:ImageViewer Width="200"
                                            Height="200"
                                            ShowToolBar="False"
                                            ShowImgMap="False"
                                            Background="#0A0A0A"
                                            ImageSource="{Binding Cache.WaferCenterThumb1, Converter={StaticResource BitmapMemoryByteArrayToBitmapFrameConverter}}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ImageViewerClickBehavior BitmapSource="{Binding Cache.WaferCenterThumb1, Mode=TwoWay, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" ClickPosition="{Binding Cache.FindWaferCenterOffset1}" />
                                </i:Interaction.Behaviors>
                            </hc:ImageViewer>
                            <TextBox Text="{Binding Cache.FindWaferCenterOffset1, Converter={StaticResource PointToStringConverter}}"
                                     Width="180"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Top"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:ImageViewer Width="200"
                                            Height="200"
                                            ShowToolBar="False"
                                            ShowImgMap="False"
                                            Background="#0A0A0A"
                                            ImageSource="{Binding Cache.WaferCenterThumb2, Converter={StaticResource BitmapMemoryByteArrayToBitmapFrameConverter}}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ImageViewerClickBehavior BitmapSource="{Binding Cache.WaferCenterThumb2, Mode=TwoWay, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" ClickPosition="{Binding Cache.FindWaferCenterOffset2}" />
                                </i:Interaction.Behaviors>
                            </hc:ImageViewer>
                            <TextBox Text="{Binding Cache.FindWaferCenterOffset2, Converter={StaticResource PointToStringConverter}}"
                                     Width="180"
                                     hc:TitleElement.TitleWidth="90"
                                     hc:InfoElement.Title="Position(um): "
                                     hc:InfoElement.TitlePlacement="Top"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                            <hc:ImageViewer Width="200"
                                            Height="200"
                                            ShowToolBar="False"
                                            ShowImgMap="False"
                                            Background="#0A0A0A"
                                            ImageSource="{Binding Cache.WaferCenterThumb3, Converter={StaticResource BitmapMemoryByteArrayToBitmapFrameConverter}}">
                                <i:Interaction.Behaviors>
                                    <behaviors:ImageViewerClickBehavior BitmapSource="{Binding Cache.WaferCenterThumb3, Mode=TwoWay, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" ClickPosition="{Binding Cache.FindWaferCenterOffset3}" />
                                </i:Interaction.Behaviors>
                            </hc:ImageViewer>
                            <TextBox Text="{Binding Cache.FindWaferCenterOffset3, Converter={StaticResource PointToStringConverter}}"
                                     Width="180"
