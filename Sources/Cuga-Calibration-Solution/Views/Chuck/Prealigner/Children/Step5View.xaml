<UserControl x:Class="CugaCalibration.Views.Chuck.Prealigner.Children.Step5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckPrealignerCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Prealigner Step 6: "
                           Status="{Binding CalibrationStepList[5].StepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown hc:TitleElement.Title="Teaching Degrees Threshold(°): "
                                      hc:TitleElement.TitleWidth="190"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.0001"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.TeachingDegreesThreshold}" />
                    <StackPanel>
                        <TextBlock Text="Alignment Setting Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.LowSite1.Location, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="Low Site1(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.LowSite2.Location, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="Low Site2(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.HighSite1.Location, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="High Site1(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.HighSite2.Location, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="High Site2(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel Spacing="10">
                        <view:CanvasView Width="100"
                                         Height="100"
                                         BackgroundColor="#0A0A0A"
                                         AxisColor="Red"
                                         Interactive="True"
                                         ShowAxes="True"
                                         ShowCursor="False"
                                         ShowGrid="False"
                                         BackgroundImage="{Binding Cache.LowSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                        <view:CanvasView Width="100"
                                         Height="100"
                                         BackgroundColor="#0A0A0A"
                                         AxisColor="Red"
                                         Interactive="True"
                                         ShowAxes="True"
                                         ShowCursor="False"
                                         ShowGrid="False"
                                         BackgroundImage="{Binding Cache.HighSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                    </hc:UniformSpacingPanel>
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding CalibratingItem.EfemLoadWaferChuckAbsoluteAngle, StringFormat={}{0:f10}}"
                             hc:TitleElement.Title="Teaching Degrees(°): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding CalibratingItem.OffsetPosition, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="Teaching Offset Position(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step5CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step5CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
    </Grid>
</UserControl>