<UserControl x:Class="CugaCalibration.Views.Chuck.Prealigner.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckPrealignerCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Prealigner: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Verify Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="PositionThresholdNumeric"
                                      hc:TitleElement.TitleWidth="190"
                                      hc:TitleElement.Title="Verify Offset Threshold(um):"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="500"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyPositionThreshold}" />
                    <hc:NumericUpDown x:Name="AngleThresholdNumeric"
                                      hc:TitleElement.Title="Verify Degrees Threshold(°): "
                                      hc:TitleElement.TitleWidth="190"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.0001"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyDegreesThreshold}" />
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding ReviewDto.ResultItemDto.EfemLoadWaferChuckAbsoluteAngle, StringFormat={}{0:f6}}"
                             hc:TitleElement.Title="Teaching Degrees(°): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding ReviewDto.ResultItemDto.OffsetPosition, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="Teaching Offset Position(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.Degrees, StringFormat={}{0:f6}}"
                             hc:TitleElement.Title="Verify Degrees(°): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.OffsetPosition, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="Verify Offset Position(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="190"
                             IsReadOnly="True"
                             Background="{StaticResource SecondaryRegionBrush}"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2" />
        <!--#endregion-->
    </Grid>
</UserControl>