<UserControl x:Class="CugaCalibration.Views.Chuck.CenterAndThetaScale.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckCenterAndThetaCalibrationViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Center: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    IsEnabled="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2BooleanReConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:NumericUpDown hc:TitleElement.Title="Center Threshold(um):"
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="150"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.CenterVerifyThreshold}" />
                        <hc:NumericUpDown Margin="0,5,0,5"
                                          hc:TitleElement.Title="Scale Threshold(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="150"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.RotateScaleThreshold}" />
                        <StackPanel>
                            <TextBlock Text="Center Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox Text="{Binding SelectCenterAndThetaItemDto.ChuckCenterPosition, Converter={StaticResource PointToStringConverter}}"
                                 Margin="0,5,0,5"
                                 hc:TitleElement.Title="Center Position(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="150"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <StackPanel>
                            <TextBlock Text="Scale Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox Text="{Binding SelectCenterAndThetaItemDto.AppliedScaleT, StringFormat={}{0:f6}}"
                                 Margin="0,5,0,5"
                                 hc:TitleElement.Title="Applied Scale: "
                                 hc:TitleElement.TitleWidth="150"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectCenterAndThetaItemDto.ResultScaleT, StringFormat={}{0:f6}}"
                                 Margin="0,5,0,5"
                                 hc:TitleElement.Title="Result Scale: "
                                 hc:TitleElement.TitleWidth="150"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding SelectCenterAndThetaItemDto.ScaleErrorUmAverage, StringFormat={}{0:f6}}"
                                 Margin="0,5,0,5"
                                 hc:TitleElement.Title="Error Value(um): "
                                 hc:TitleElement.TitleWidth="150"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <hc:UniformSpacingPanel Grid.Column="2"
                                Orientation="Vertical"
                                Spacing="5">
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <TextBlock Text="Find Result Image"
                           HorizontalAlignment="Center"
                           Background="Transparent" />
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0"
                            Margin="10">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <view:CanvasView Width="180"
                                             Height="180"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.TopFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <TextBox Text="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.TopPosition, Converter={StaticResource PointToStringConverter}}"
                                     Width="auto"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     hc:TitleElement.TitleWidth="auto"
                                     hc:TitleElement.Title="Positive-Top Real Position(um): "
                                     hc:TitleElement.TitlePlacement="Top"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1"
                            Margin="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <view:CanvasView Width="180"
                                             Height="180"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.BottomFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <TextBox Text="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.BottomPosition, Converter={StaticResource PointToStringConverter}}"
                                     Width="auto"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     hc:TitleElement.TitleWidth="auto"
                                     hc:TitleElement.Title="Positive-Bottom Real Position(um): "
                                     hc:TitleElement.TitlePlacement="Top"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2"
                            Margin="10">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <view:CanvasView Width="180"
                                             Height="180"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.LeftFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <TextBox Text="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.LeftPosition, Converter={StaticResource PointToStringConverter}}"
                                     Width="auto"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     hc:TitleElement.TitleWidth="auto"
                                     hc:TitleElement.Title="Positive-Left Real Position(um): "
                                     hc:TitleElement.TitlePlacement="Top"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3"
                            Margin="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <view:CanvasView Width="180"
                                             Height="180"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.RightFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <TextBox Text="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.RightPosition, Converter={StaticResource PointToStringConverter}}"
                                     Width="auto"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     hc:TitleElement.TitleWidth="auto"
                                     hc:TitleElement.Title="Positive-Right Real Position(um): "
                                     hc:TitleElement.TitlePlacement="Top"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0"
                            Margin="10">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <view:CanvasView Width="180"
                                             Height="180"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.TopFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <TextBox Text="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.TopPosition, Converter={StaticResource PointToStringConverter}}"
                                     Width="auto"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     hc:TitleElement.TitleWidth="auto"
                                     hc:TitleElement.Title="Negative-Top Real Position(um): "
                                     hc:TitleElement.TitlePlacement="Top"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1"
                            Margin="10">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <view:CanvasView Width="180"
                                             Height="180"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.BottomFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <TextBox Text="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.BottomPosition, Converter={StaticResource PointToStringConverter}}"
                                     Width="auto"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     hc:TitleElement.TitleWidth="auto"
                                     hc:TitleElement.Title="Negative-Bottom Real Position(um): "
                                     hc:TitleElement.TitlePlacement="Top"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2"
                            Margin="10">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <view:CanvasView Width="180"
                                             Height="180"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.LeftFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <TextBox Text="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.LeftPosition, Converter={StaticResource PointToStringConverter}}"
                                     Width="auto"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     hc:TitleElement.TitleWidth="auto"
                                     hc:TitleElement.Title="Negative-Left Real Position(um): "
                                     hc:TitleElement.TitlePlacement="Top"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="3"
                            Margin="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <hc:UniformSpacingPanel HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Orientation="Vertical"
                                                Spacing="3">
                            <view:CanvasView Width="180"
                                             Height="180"
                                             BackgroundColor="#0A0A0A"
                                             AxisColor="Red"
                                             Interactive="True"
                                             ShowAxes="True"
                                             ShowCursor="False"
                                             ShowGrid="False"
                                             BackgroundImage="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.RightFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                            <TextBox Text="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.RightPosition, Converter={StaticResource PointToStringConverter}}"
                                     Width="auto"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     hc:TitleElement.TitleWidth="auto"
                                     hc:TitleElement.Title="Negative-Right Real Position(um): "
                                     hc:TitleElement.TitlePlacement="Top"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxExtend}" />
                        </hc:UniformSpacingPanel>
                    </Border>
                </Grid>
            </Border>
        </hc:UniformSpacingPanel>
    </Grid>
</UserControl>