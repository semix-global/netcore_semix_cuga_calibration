<UserControl x:Class="CugaCalibration.Views.Chuck.CenterAndThetaScale.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF.Behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckCenterAndThetaCalibrationViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                        <hc:NumericUpDown Margin="0,0,0,5"
                                          hc:TitleElement.Title="Times: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="150"
                                          Minimum="1"
                                          Maximum="10"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Times}" />
                        <hc:NumericUpDown x:Name="AngleNumeric"
                                          hc:TitleElement.TitleWidth="150"
                                          hc:TitleElement.Title="Rotate Angle(°)： "
                                          hc:TitleElement.TitlePlacement="Left"
                                          Minimum="0"
                                          Maximum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.RotateAngle}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Center Threshold(um):"
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="150"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.CenterCalibrationThreshold}" />
                        <hc:NumericUpDown Margin="0,5,0,5"
                                          hc:TitleElement.Title="Scale Threshold(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="150"
                                          Minimum="0"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.RotateScaleThreshold}" />
                        <StackPanel>
                            <TextBlock Text="Center Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox Text="{Binding ResultCenterAndThetaItemDto.ChuckCenterPosition, Converter={StaticResource PointToStringConverter}}"
                                 Margin="0,5,0,5"
                                 hc:TitleElement.Title="Center Position(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="150"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <StackPanel>
                            <TextBlock Text="Scale Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox Text="{Binding ResultCenterAndThetaItemDto.AppliedScaleT, StringFormat={}{0:f6}}"
                                 Margin="0,5,0,5"
                                 hc:TitleElement.Title="Applied Scale: "
                                 hc:TitleElement.TitleWidth="150"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ResultCenterAndThetaItemDto.ResultScaleT, StringFormat={}{0:f6}}"
                                 Margin="0,5,0,5"
                                 hc:TitleElement.Title="Result Scale: "
                                 hc:TitleElement.TitleWidth="150"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ResultCenterAndThetaItemDto.ScaleErrorUmAverage, StringFormat={}{0:f6}}"
                                 Margin="0,5,0,5"
                                 hc:TitleElement.Title="Error Value(um): "
                                 hc:TitleElement.TitleWidth="150"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                    </hc:UniformSpacingPanel>
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step4CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step4CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="250" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox MinHeight="250"
                      Margin="0,0,0,10"
                      Header="History">
                <ListView d:SelectedIndex="0"
                          ItemsSource="{Binding ChuckCenterAndThetaItemDtoList}"
                          Style="{StaticResource ListView.Small}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectCenterAndThetaItemDto}">
                    <b:Interaction.Behaviors>
                        <behaviors:ListBoxScrollToCurrentBehavior />
                    </b:Interaction.Behaviors>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="180"
                                            Header="Center Position"
                                            DisplayMemberBinding="{Binding ChuckCenterPosition, StringFormat={}{0:f4}}" />
                            <GridViewColumn Width="180"
                                            Header="Applied Scale"
                                            DisplayMemberBinding="{Binding AppliedScaleT, StringFormat={}{0:f6}}" />
                            <GridViewColumn Width="180"
                                            Header="Result Scale"
                                            DisplayMemberBinding="{Binding ResultScaleT, StringFormat={}{0:f6}}" />
                            <GridViewColumn Width="180"
                                            Header="Real Angle Offset(°)"
                                            DisplayMemberBinding="{Binding RealAngleOffsetAverage, StringFormat={}{0:f4}}" />
                            <GridViewColumn Width="180"
                                            Header="Scale Error Um(um)"
                                            DisplayMemberBinding="{Binding ScaleErrorUmAverage, StringFormat={}{0:f4}}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
            <GridSplitter Grid.Row="1" />
            <hc:UniformSpacingPanel Grid.Row="2"
                                    Orientation="Vertical"
                                    Spacing="5">
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <TextBlock Text="Find Result Image"
                               HorizontalAlignment="Center"
                               Background="Transparent" />
                </Border>
                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0"
                                Margin="10">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                <view:CanvasView Width="180"
                                                 Height="180"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.TopFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <TextBox Text="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.TopPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="auto"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         hc:TitleElement.TitleWidth="auto"
                                         hc:TitleElement.Title="Positive-Top Real Position(um): "
                                         hc:TitleElement.TitlePlacement="Top"
                                         IsReadOnly="True"
                                         Style="{StaticResource TextBoxExtend}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1"
                                Margin="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                <view:CanvasView Width="180"
                                                 Height="180"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.BottomFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <TextBox Text="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.BottomPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="auto"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         hc:TitleElement.TitleWidth="auto"
                                         hc:TitleElement.Title="Positive-Bottom Real Position(um): "
                                         hc:TitleElement.TitlePlacement="Top"
                                         IsReadOnly="True"
                                         Style="{StaticResource TextBoxExtend}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2"
                                Margin="10">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                <view:CanvasView Width="180"
                                                 Height="180"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.LeftFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <TextBox Text="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.LeftPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="auto"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         hc:TitleElement.TitleWidth="auto"
                                         hc:TitleElement.Title="Positive-Left Real Position(um): "
                                         hc:TitleElement.TitlePlacement="Top"
                                         IsReadOnly="True"
                                         Style="{StaticResource TextBoxExtend}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3"
                                Margin="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                <view:CanvasView Width="180"
                                                 Height="180"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.RightFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <TextBox Text="{Binding SelectCenterAndThetaItemDto.PositiveMatchResult.RightPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="auto"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         hc:TitleElement.TitleWidth="auto"
                                         hc:TitleElement.Title="Positive-Right Real Position(um): "
                                         hc:TitleElement.TitlePlacement="Top"
                                         IsReadOnly="True"
                                         Style="{StaticResource TextBoxExtend}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0"
                                Margin="10">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                <view:CanvasView Width="180"
                                                 Height="180"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.TopFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <TextBox Text="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.TopPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="auto"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         hc:TitleElement.TitleWidth="auto"
                                         hc:TitleElement.Title="Negative-Top Real Position(um): "
                                         hc:TitleElement.TitlePlacement="Top"
                                         IsReadOnly="True"
                                         Style="{StaticResource TextBoxExtend}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1"
                                Margin="10">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                <view:CanvasView Width="180"
                                                 Height="180"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.BottomFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <TextBox Text="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.BottomPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="auto"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         hc:TitleElement.TitleWidth="auto"
                                         hc:TitleElement.Title="Negative-Bottom Real Position(um): "
                                         hc:TitleElement.TitlePlacement="Top"
                                         IsReadOnly="True"
                                         Style="{StaticResource TextBoxExtend}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2"
                                Margin="10">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                <view:CanvasView Width="180"
                                                 Height="180"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.LeftFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <TextBox Text="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.LeftPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="auto"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         hc:TitleElement.TitleWidth="auto"
                                         hc:TitleElement.Title="Negative-Left Real Position(um): "
                                         hc:TitleElement.TitlePlacement="Top"
                                         IsReadOnly="True"
                                         Style="{StaticResource TextBoxExtend}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3"
                                Margin="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <hc:UniformSpacingPanel HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Orientation="Vertical"
                                                    Spacing="3">
                                <view:CanvasView Width="180"
                                                 Height="180"
                                                 BackgroundColor="#0A0A0A"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False"
                                                 BackgroundImage="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.RightFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                <TextBox Text="{Binding SelectCenterAndThetaItemDto.NegativeMatchResult.RightPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="auto"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         hc:TitleElement.TitleWidth="auto"
                                         hc:TitleElement.Title="Negative-Right Real Position(um): "
                                         hc:TitleElement.TitlePlacement="Top"
                                         IsReadOnly="True"
                                         Style="{StaticResource TextBoxExtend}" />
                            </hc:UniformSpacingPanel>
                        </Border>
                    </Grid>
                </Border>
            </hc:UniformSpacingPanel>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>