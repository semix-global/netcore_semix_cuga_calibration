<UserControl x:Class="CugaCalibration.Views.Chuck.StageMap.Children.Step8View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:itemsControlBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:stageMap="clr-namespace:Core.Models.Models.Common.StageMap;assembly=Core.Models"
             xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckStageMapViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Productivity: "
                           Status="{Binding Cache.ChuckStageMapCacheDFItem.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Laser Light: "
                           Status="{Binding Cache.ChuckStageMapCacheDFItem.LaserLightInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="CIB: "
                           Status="{Binding Cache.ChuckStageMapCacheDFItem.CIBInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Repeat Times: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          DecimalPlaces="0"
                                          Increment="1"
                                          Value="{Binding Cache.ChuckStageMapCacheDFItem.StageMapRepeatTimes}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step8Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step8CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="DF Repeat StageMaps">
            <TabControl>
                <i:Interaction.Behaviors>
                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                </i:Interaction.Behaviors>
                <TabItem Header="DF StageMap">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <ContentPresenter Content="{Binding CalibratingItem.DFStageMap, Mode=OneWay}">
                            <ContentPresenter.ContentTemplate>
                                <DataTemplate DataType="{x:Type stageMap:StageMap}">
                                    <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
                                </DataTemplate>
                            </ContentPresenter.ContentTemplate>
                        </ContentPresenter>
                    </Border>
                </TabItem>
                <TabItem Header="DF Repeat StageMaps">
                    <Border Margin="5" Style="{StaticResource BorderRegion}">
                        <ContentPresenter Content="{Binding CalibratingItem.DFRepeatStageMaps, Mode=OneWay}">
                            <ContentPresenter.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="150" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ListView x:Name="RepeatStageMapsList"
                                                  ItemsSource="{Binding}"
                                                  Style="{StaticResource ListView.Small}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  SelectionMode="Single">
                                            <i:Interaction.Behaviors>
                                                <itemsControlBehaviors:ListBoxScrollToCurrentBehavior />
                                                <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                                            </i:Interaction.Behaviors>
                                            <ListView.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.View>
                                                <GridView>
                                                    <GridView.ColumnHeaderContainerStyle>
                                                        <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        </Style>
                                                    </GridView.ColumnHeaderContainerStyle>
                                                    <GridView.Columns>
                                                        <GridViewColumn Width="160"
                                                                        Header="Repeat"
                                                                        DisplayMemberBinding="{Binding DisplayIndex, Mode=OneWay}" />
                                                    </GridView.Columns>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <GridSplitter Grid.Row="1"
                                                      Height="5"
                                                      HorizontalAlignment="Stretch" />
                                        <ContentPresenter Grid.Row="2" Content="{Binding SelectedItem, ElementName=RepeatStageMapsList, Mode=OneWay}">
                                            <ContentPresenter.ContentTemplate>
                                                <DataTemplate DataType="{x:Type stageMap:StageMap}">
                                                    <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
                                                </DataTemplate>
                                            </ContentPresenter.ContentTemplate>
                                        </ContentPresenter>
                                    </Grid>
                                </DataTemplate>
                            </ContentPresenter.ContentTemplate>
                        </ContentPresenter>
                    </Border>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</UserControl>