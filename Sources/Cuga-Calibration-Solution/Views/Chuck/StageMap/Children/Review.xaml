<UserControl x:Class="CugaCalibration.Views.Chuck.StageMap.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:itemsControlBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
             xmlns:stageMap="clr-namespace:Core.Models.Models.Common.StageMap;assembly=Core.Models"
             xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckStageMapViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review: "
                           Status="Verify"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown hc:TitleElement.Title="Verify Threshold(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="0"
                                          DecimalPlaces="6"
                                          Increment="0.01"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Threshold}" />
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultSuccess}" />
                        </StackPanel>
                        <TextBox Text="{Binding Review.IsCalibrated, Mode=OneWay}"
                                 hc:TitleElement.Title="Calibrated: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.IsVerified, Mode=OneWay}"
                                 hc:TitleElement.Title="Verified: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.BFAlignmentResult.Degrees, Mode=OneWay, StringFormat='0.##########'}"
                                 hc:TitleElement.Title="BF Alignment Degrees(°): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.BFAlignmentResult.MarkPoint1, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.Title="BF Mark Point 1(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.BFAlignmentResult.MarkPoint2, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.Title="BF Mark Point 2(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.IsDarkFieldAlignment, Mode=OneWay}"
                                 hc:TitleElement.Title="Dark Field Alignment: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.DFAlignmentResult.Degrees, Mode=OneWay, StringFormat='0.##########'}"
                                 hc:TitleElement.Title="DF Alignment Degrees(°): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.DFAlignmentResult.MarkPoint1, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.Title="DF Mark Point 1(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.DFAlignmentResult.MarkPoint2, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.Title="DF Mark Point 2(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.BFVerifyMaxError.X, Mode=OneWay, StringFormat='0.######'}"
                                 hc:TitleElement.Title="BF Max |Error| X(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.BFVerifyMaxError.Y, Mode=OneWay, StringFormat='0.######'}"
                                 hc:TitleElement.Title="BF Max |Error| Y(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.DFVerifyMaxError.X, Mode=OneWay, StringFormat='0.######'}"
                                 hc:TitleElement.Title="DF Max |Error| X(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.DFVerifyMaxError.Y, Mode=OneWay, StringFormat='0.######'}"
                                 hc:TitleElement.Title="DF Max |Error| Y(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding VerifyCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding VerifyCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <ContentPresenter Content="{Binding Review, Mode=OneWay}">
                <ContentPresenter.ContentTemplate>
                    <DataTemplate>
                        <TabControl>
                            <i:Interaction.Behaviors>
                                <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                            </i:Interaction.Behaviors>
                            <TabItem Header="BF StageMap">
                                <Border Margin="5" Style="{StaticResource BorderRegion}">
                                    <ContentPresenter Content="{Binding BFStageMap, Mode=OneWay}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate DataType="{x:Type stageMap:StageMap}">
                                                <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                            </TabItem>
                            <TabItem Header="DF StageMap">
                                <Border Margin="5" Style="{StaticResource BorderRegion}">
                                    <ContentPresenter Content="{Binding DFStageMap, Mode=OneWay}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate DataType="{x:Type stageMap:StageMap}">
                                                <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                            </TabItem>
                            <TabItem Header="DF Repeat StageMaps">
                                <Border Margin="5" Style="{StaticResource BorderRegion}">
                                    <ContentPresenter Content="{Binding DFRepeatStageMaps, Mode=OneWay}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="150" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <ListView x:Name="RepeatStageMapsList"
                                                              ItemsSource="{Binding}"
                                                              Style="{StaticResource ListView.Small}"
                                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                              SelectionMode="Single">
                                                        <i:Interaction.Behaviors>
                                                            <itemsControlBehaviors:ListBoxScrollToCurrentBehavior />
                                                            <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                                                        </i:Interaction.Behaviors>
                                                        <ListView.ItemContainerStyle>
                                                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                        <ListView.View>
                                                            <GridView>
                                                                <GridView.ColumnHeaderContainerStyle>
                                                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                    </Style>
                                                                </GridView.ColumnHeaderContainerStyle>
                                                                <GridView.Columns>
                                                                    <GridViewColumn Width="160"
                                                                                    Header="Repeat"
                                                                                    DisplayMemberBinding="{Binding DisplayIndex, Mode=OneWay}" />
                                                                </GridView.Columns>
                                                            </GridView>
                                                        </ListView.View>
                                                    </ListView>
                                                    <GridSplitter Grid.Row="1"
                                                                  Height="5"
                                                                  HorizontalAlignment="Stretch" />
                                                    <ContentPresenter Grid.Row="2" Content="{Binding SelectedItem, ElementName=RepeatStageMapsList, Mode=OneWay}">
                                                        <ContentPresenter.ContentTemplate>
                                                            <DataTemplate DataType="{x:Type stageMap:StageMap}">
                                                                <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
                                                            </DataTemplate>
                                                        </ContentPresenter.ContentTemplate>
                                                    </ContentPresenter>
                                                </Grid>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                            </TabItem>
                            <TabItem Header="Expand StageMap">
                                <Border Margin="5" Style="{StaticResource BorderRegion}">
                                    <ContentPresenter Content="{Binding ExpandStageMap, Mode=OneWay}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate DataType="{x:Type stageMap:StageMap}">
                                                <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                            </TabItem>
                            <TabItem Header="BF Verify StageMap">
                                <Border Margin="5" Style="{StaticResource BorderRegion}">
                                    <ContentPresenter Content="{Binding BFVerifyStageMap, Mode=OneWay}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate DataType="{x:Type stageMap:StageMap}">
                                                <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                            </TabItem>
                            <TabItem Header="DF Verify StageMap">
                                <Border Margin="5" Style="{StaticResource BorderRegion}">
                                    <ContentPresenter Content="{Binding DFVerifyStageMap, Mode=OneWay}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate DataType="{x:Type stageMap:StageMap}">
                                                <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </DataTemplate>
                </ContentPresenter.ContentTemplate>
            </ContentPresenter>
        </GroupBox>
    </Grid>
</UserControl>