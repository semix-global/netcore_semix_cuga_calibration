<UserControl x:Class="CugaCalibration.Views.Chuck.StageMap.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckStageMapViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Review: "
                           Status="Verify"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                        <TextBox Text="{Binding Review.IsCalibrated, Mode=OneWay}"
                                 hc:TitleElement.Title="Calibrated: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding Review.IsVerified, Mode=OneWay}"
                                 hc:TitleElement.Title="Verified: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <GroupBox Header="BF Alignment">
                            <Border Style="{StaticResource BorderRegion}">
                                <ContentPresenter Content="{Binding Review.BFAlignmentResult, Mode=OneWay}" ContentTemplate="{StaticResource AlignmentResultTemplate}" />
                            </Border>
                        </GroupBox>
                        <TextBox Text="{Binding Review.IsDarkFieldAlignment, Mode=OneWay}"
                                 hc:TitleElement.Title="Dark Field Alignment: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <GroupBox Header="DF Alignment">
                            <Border Style="{StaticResource BorderRegion}">
                                <ContentPresenter Content="{Binding Review.DFAlignmentResult, Mode=OneWay}" ContentTemplate="{StaticResource AlignmentResultTemplate}" />
                            </Border>
                        </GroupBox>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Verify"
                                    Command="{Binding VerifyCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{StaticResource MultiValueBooleanNegationAnyConverter}">
                                        <Binding Path="VerifyCommand.IsRunning" />
                                    </MultiBinding>
                                </Button.IsEnabled>
                            </Button>
                            <Button Content="Cancel"
                                    Command="{Binding VerifyCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="History">
            <ContentPresenter Content="{Binding Review, Mode=OneWay}" ContentTemplate="{StaticResource StageMapResultsTemplate}" />
        </GroupBox>
    </Grid>
</UserControl>