<UserControl x:Class="CugaCalibration.Views.Chuck.StageMap.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:children="clr-namespace:CugaCalibration.Views.Chuck.StageMap.Children"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckStageMapCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Stage Map Step: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.RowNumber}"
                             hc:TitleElement.Title="Row Number: "
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.ColumnNumber}"
                             hc:TitleElement.Title="Column Number: "
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Alignment Threshold(um): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyAlignmentThreshold}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Gantry Threshold(um): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyGantryThreshold}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Scale Threshold(um): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyScaleThreshold}" />
                    <TextBox Text="{Binding Cache.Threshold, Converter={StaticResource PointToStringConverter}}"
                             hc:TitleElement.Title="Threshold: "
                             hc:TitleElement.TitleWidth="180"
                             hc:TitleElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10"
                                            Visibility="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2VisibilityReConverter}}">
                        <Button Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <TabControl Grid.Column="2">
            <TabItem Header="Verify Error Map">
                <children:DarkFieldMapView Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ActualHeight}"
                                           IsEnabled="{Binding Step3CalibrateActionCommand.IsRunning, Converter={StaticResource BoolNegationConverter}}"
                                           ChildName="ReviewVerify" />
            </TabItem>
            <TabItem Header="Calibration Error Map">
                <children:DarkFieldMapView Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ActualHeight}"
                                           IsEnabled="{Binding Step3CalibrateActionCommand.IsRunning, Converter={StaticResource BoolNegationConverter}}"
                                           ChildName="ReviewCalibration" />
            </TabItem>
        </TabControl>
        <!--#endregion-->
    </Grid>
</UserControl>