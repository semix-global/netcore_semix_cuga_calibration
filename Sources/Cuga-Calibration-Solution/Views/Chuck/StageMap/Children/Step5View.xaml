<UserControl x:Class="CugaCalibration.Views.Chuck.StageMap.Children.Step5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:tools="clr-namespace:CugaCalibration.Views.Common.Windows.Tools"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckStageMapViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Productivity: "
                           Status="{Binding Cache.ChuckStageMapCacheDFItem.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Laser Light: "
                           Status="{Binding Cache.ChuckStageMapCacheDFItem.LaserLightInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="CIB: "
                           Status="{Binding Cache.ChuckStageMapCacheDFItem.CIBInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <tools:AlignmentUserControl DataContext="{Binding AlignmentUserControlViewModel}" />
                        <StackPanel>
                            <TextBlock Text="Result"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultSuccess}" />
                        </StackPanel>
                        <TextBox Text="{Binding CalibratingItem.IsDarkFieldAlignment, Mode=OneWay}"
                                 hc:TitleElement.Title="Dark Field Alignment: "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.DFAlignmentResult.Degrees, Mode=OneWay, StringFormat='0.##########'}"
                                 hc:TitleElement.Title="Alignment Degrees(°): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.DFAlignmentResult.MarkPoint1, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.Title="Mark Point 1(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding CalibratingItem.DFAlignmentResult.MarkPoint2, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.Title="Mark Point 2(um): "
                                 hc:TitleElement.TitlePlacement="Left"
                                 hc:TitleElement.TitleWidth="190"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step5Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step5CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
    </Grid>
</UserControl>