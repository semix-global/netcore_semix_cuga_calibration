<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:children="clr-namespace:CugaCalibration.Views.Chuck.StageMap.Children"
                    xmlns:itemsControlBehaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
                    xmlns:stageMap="clr-namespace:Core.Models.Models.Common.StageMap;assembly=Core.Models"
                    xmlns:alignment="clr-namespace:Core.Models.Models.Common.Alignment;assembly=Core.Models"
                    xmlns:graphicsWPF="clr-namespace:Net.Utilities.Graphics.WPF;assembly=Net.Utilities.Graphics.WPF"
                    xmlns:v2="clr-namespace:Net.Utilities.ScottPlot.WPF.V2;assembly=Net.Utilities.ScottPlot.WPF.V2"
                    mc:Ignorable="d">
    <Style x:Key="StageMapListViewItemStyle"
           BasedOn="{StaticResource ListViewItemBaseStyle.Small}"
           TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StageMapColumnHeaderStyle"
           BasedOn="{StaticResource {x:Type GridViewColumnHeader}}"
           TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <DataTemplate x:Key="AlignmentResultTemplate" DataType="{x:Type alignment:AlignmentResultDto}">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
            <TextBox Text="{Binding Degrees, Mode=OneWay, StringFormat='0.##########'}"
                     hc:TitleElement.Title="Alignment Degrees(°): "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="190"
                     IsReadOnly="True"
                     Background="{StaticResource SecondaryRegionBrush}"
                     Style="{StaticResource TextBoxExtend}" />
            <TextBox Text="{Binding MarkPoint1, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                     hc:TitleElement.Title="Mark Point 1(um): "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="190"
                     IsReadOnly="True"
                     Background="{StaticResource SecondaryRegionBrush}"
                     Style="{StaticResource TextBoxExtend}" />
            <TextBox Text="{Binding MarkPoint2, Mode=OneWay, Converter={StaticResource PointToStringConverter}}"
                     hc:TitleElement.Title="Mark Point 2(um): "
                     hc:TitleElement.TitlePlacement="Left"
                     hc:TitleElement.TitleWidth="190"
                     IsReadOnly="True"
                     Background="{StaticResource SecondaryRegionBrush}"
                     Style="{StaticResource TextBoxExtend}" />
        </hc:UniformSpacingPanel>
    </DataTemplate>
    <DataTemplate x:Key="StageMapPlotTemplate" DataType="{x:Type stageMap:StageMap}">
        <v2:PlotControl DataSource="{Binding PlotDataSource, Mode=OneWay}" />
    </DataTemplate>
    <DataTemplate x:Key="StageMapRepeatResultsTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ListView x:Name="RepeatStageMapsList"
                      ItemsSource="{Binding}"
                      Style="{StaticResource ListView.Small}"
                      ItemContainerStyle="{StaticResource StageMapListViewItemStyle}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectionMode="Single">
                <i:Interaction.Behaviors>
                    <itemsControlBehaviors:ListBoxScrollToCurrentBehavior />
                    <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
                </i:Interaction.Behaviors>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource StageMapColumnHeaderStyle}">
                        <GridViewColumn Width="160"
                                        Header="Repeat"
                                        DisplayMemberBinding="{Binding DisplayIndex, Mode=OneWay}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch" />
            <ContentPresenter Grid.Row="2"
                              Content="{Binding SelectedItem, ElementName=RepeatStageMapsList, Mode=OneWay}"
                              ContentTemplate="{StaticResource StageMapPlotTemplate}" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="BFStageMapDocumentTemplate">
        <graphicsWPF:WPFCanvasControl Document="{Binding CalibratingItem.BFStageMapDocument, Mode=OneWay}" CursorTextVisibility="Collapsed">
            <graphicsWPF:WPFCanvasControl.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/Net.Utilities.WPF.CustomControl.Themes;component/Themes/ToolBarStyles.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </graphicsWPF:WPFCanvasControl.Resources>
            <graphicsWPF:WPFCanvasControl.LeftToolBars>
                <ToolBar Margin="3,2"
                         Padding="3,2"
                         Background="Transparent"
                         Band="0"
                         BandIndex="2">
                    <ItemsControl ItemsSource="{Binding Cache.ChuckStageMapCacheBFItem.StageMapTemplates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type stageMap:StageMapTemplate}">
                                <Button Content="{Binding DisplayIndex, Mode=OneWay}"
                                        Command="{Binding DataContext.GotoBFStageMapDocumentSelectedItemPositionCommand, RelativeSource={RelativeSource AncestorType={x:Type children:Step2View}}}"
                                        CommandParameter="{Binding}"
                                        Height="24"
                                        Margin="3,0"
                                        Padding="5,3"
                                        ContentStringFormat="Goto {0}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ToolBar>
            </graphicsWPF:WPFCanvasControl.LeftToolBars>
            <graphicsWPF:WPFCanvasControl.RightToolBars>
                <ToolBar Margin="3,2"
                         Padding="3,2"
                         Background="Transparent"
                         Band="0"
                         BandIndex="1">
                    <TextBlock d:Text="0, 0 | (0.0, 0.0)" Style="{StaticResource ToolBarTextBlock}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static stageMap:StageMapDocumentCursorToStringConverter.Instance}">
                                <Binding Path="CalibratingItem.BFStageMapDocument.View.Cursor.Point" />
                                <Binding Path="CalibratingItem.BFStageMapDocument" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </ToolBar>
            </graphicsWPF:WPFCanvasControl.RightToolBars>
        </graphicsWPF:WPFCanvasControl>
    </DataTemplate>
    <DataTemplate x:Key="DFStageMapDocumentTemplate">
        <graphicsWPF:WPFCanvasControl Document="{Binding CalibratingItem.DFStageMapDocument, Mode=OneWay}" CursorTextVisibility="Collapsed">
            <graphicsWPF:WPFCanvasControl.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/Net.Utilities.WPF.CustomControl.Themes;component/Themes/ToolBarStyles.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </graphicsWPF:WPFCanvasControl.Resources>
            <graphicsWPF:WPFCanvasControl.LeftToolBars>
                <ToolBar Margin="3,2"
                         Padding="3,2"
                         Background="Transparent"
                         Band="0"
                         BandIndex="2">
                    <ItemsControl ItemsSource="{Binding Cache.ChuckStageMapCacheDFItem.StageMapTemplates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type stageMap:StageMapTemplate}">
                                <Button Content="{Binding DisplayIndex, Mode=OneWay}"
                                        Command="{Binding DataContext.GotoDFStageMapDocumentSelectedItemPositionCommand, RelativeSource={RelativeSource AncestorType={x:Type children:Step6View}}}"
                                        CommandParameter="{Binding}"
                                        Height="24"
                                        Margin="3,0"
                                        Padding="5,3"
                                        ContentStringFormat="Goto {0}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ToolBar>
            </graphicsWPF:WPFCanvasControl.LeftToolBars>
            <graphicsWPF:WPFCanvasControl.RightToolBars>
                <ToolBar Margin="3,2"
                         Padding="3,2"
                         Background="Transparent"
                         Band="0"
                         BandIndex="1">
                    <TextBlock d:Text="0, 0 | (0.0, 0.0)" Style="{StaticResource ToolBarTextBlock}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static stageMap:StageMapDocumentCursorToStringConverter.Instance}">
                                <Binding Path="CalibratingItem.DFStageMapDocument.View.Cursor.Point" />
                                <Binding Path="CalibratingItem.DFStageMapDocument" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </ToolBar>
            </graphicsWPF:WPFCanvasControl.RightToolBars>
        </graphicsWPF:WPFCanvasControl>
    </DataTemplate>
    <DataTemplate x:Key="StageMapResultsTemplate">
        <TabControl>
            <i:Interaction.Behaviors>
                <itemsControlBehaviors:SelectorAutoSelectFirstBehavior />
            </i:Interaction.Behaviors>
            <TabItem Header="BF StageMap">
                <Border Margin="5" Style="{StaticResource BorderRegion}">
                    <ContentPresenter Content="{Binding BFStageMap, Mode=OneWay}" ContentTemplate="{StaticResource StageMapPlotTemplate}" />
                </Border>
            </TabItem>
            <TabItem Header="DF StageMap">
                <Border Margin="5" Style="{StaticResource BorderRegion}">
                    <ContentPresenter Content="{Binding DFStageMap, Mode=OneWay}" ContentTemplate="{StaticResource StageMapPlotTemplate}" />
                </Border>
            </TabItem>
            <TabItem Header="DF Repeat StageMaps">
                <Border Margin="5" Style="{StaticResource BorderRegion}">
                    <ContentPresenter Content="{Binding DFRepeatStageMaps, Mode=OneWay}" ContentTemplate="{StaticResource StageMapRepeatResultsTemplate}" />
                </Border>
            </TabItem>
            <TabItem Header="Expand StageMap">
                <Border Margin="5" Style="{StaticResource BorderRegion}">
                    <ContentPresenter Content="{Binding ExpandStageMap, Mode=OneWay}" ContentTemplate="{StaticResource StageMapPlotTemplate}" />
                </Border>
            </TabItem>
            <TabItem Header="BF Verify StageMap">
                <Border Margin="5" Style="{StaticResource BorderRegion}">
                    <ContentPresenter Content="{Binding BFVerifyStageMap, Mode=OneWay}" ContentTemplate="{StaticResource StageMapPlotTemplate}" />
                </Border>
            </TabItem>
            <TabItem Header="DF Verify StageMap">
                <Border Margin="5" Style="{StaticResource BorderRegion}">
                    <ContentPresenter Content="{Binding DFVerifyStageMap, Mode=OneWay}" ContentTemplate="{StaticResource StageMapPlotTemplate}" />
                </Border>
            </TabItem>
        </TabControl>
    </DataTemplate>
</ResourceDictionary>