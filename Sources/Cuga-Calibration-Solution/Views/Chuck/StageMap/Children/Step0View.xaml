<UserControl x:Class="CugaCalibration.Views.Chuck.StageMap.Children.Step0View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:constants="clr-namespace:Net.Utilities.Constants;assembly=Net.Utilities"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckStageMapCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical"
                                    Spacing="2"
                                    Visibility="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2VisibilityReConverter}}">
                <hc:Shield Subject="{Binding CalibrationStepList[0].StepIndex, StringFormat='Chuck Stage Map Step {0}'}"
                           Status="{Binding CalibrationStepList[0].StepName}"
                           Visibility="{Binding Cache.IsDarkField, Converter={StaticResource Boolean2VisibilityReConverter}}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="{Binding CalibrationStepList[4].StepIndex, StringFormat='Chuck Stage Map Step {0}'}"
                           Status="{Binding CalibrationStepList[4].StepName}"
                           Visibility="{Binding Cache.IsDarkField, Converter={StaticResource Boolean2VisibilityConverter}}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Alignment Setting Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox hc:InfoElement.Title="Low Site1(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="100"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.True}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheDarkField.LowSite1.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.False}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheBrightField.LowSite1.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox hc:InfoElement.Title="Low Site2(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="100"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.True}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheDarkField.LowSite2.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.False}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheBrightField.LowSite2.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox hc:InfoElement.Title="High Site1(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="100"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.True}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheDarkField.HighSite1.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.False}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheBrightField.HighSite1.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox hc:InfoElement.Title="High Site2(um): "
                             hc:InfoElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="100"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.True}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheDarkField.HighSite2.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.False}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheBrightField.HighSite2.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <hc:UniformSpacingPanel Spacing="10">
                        <view:CanvasView Width="100"
                                         Height="100"
                                         BackgroundColor="#0A0A0A"
                                         AxisColor="Red"
                                         Interactive="True"
                                         ShowAxes="True"
                                         ShowCursor="False"
                                         ShowGrid="False">
                            <view:CanvasView.Style>
                                <Style TargetType="view:CanvasView">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.True}">
                                            <Setter Property="BackgroundImage" Value="{Binding AlignmentCacheDarkField.LowSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.False}">
                                            <Setter Property="BackgroundImage" Value="{Binding AlignmentCacheBrightField.LowSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </view:CanvasView.Style>
                        </view:CanvasView>
                        <view:CanvasView Width="100"
                                         Height="100"
                                         BackgroundColor="#0A0A0A"
                                         AxisColor="Red"
                                         Interactive="True"
                                         ShowAxes="True"
                                         ShowCursor="False"
                                         ShowGrid="False">
                            <view:CanvasView.Style>
                                <Style TargetType="view:CanvasView">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.True}">
                                            <Setter Property="BackgroundImage" Value="{Binding AlignmentCacheDarkField.HighSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:ConstantHelper.False}">
                                            <Setter Property="BackgroundImage" Value="{Binding AlignmentCacheBrightField.HighSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </view:CanvasView.Style>
                        </view:CanvasView>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="P5"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.P5Angle, StringFormat={}{0:f10}}"
                             hc:InfoElement.Title="Degrees(°): "
                             hc:TitleElement.TitleWidth="90"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10"
                                            Visibility="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2VisibilityReConverter}}">
                        <Button Content="Action"
                                Command="{Binding Step0CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step0CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
    </Grid>
</UserControl>