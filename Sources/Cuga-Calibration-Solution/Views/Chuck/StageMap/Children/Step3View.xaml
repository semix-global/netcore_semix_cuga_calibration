<UserControl x:Class="CugaCalibration.Views.Chuck.StageMap.Children.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:children="clr-namespace:CugaCalibration.Views.Chuck.StageMap.Children"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckStageMapCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical"
                                    Spacing="2"
                                    Visibility="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2VisibilityReConverter}}">
                <hc:Shield Subject="{Binding CalibrationStepList[3].StepIndex, StringFormat='Chuck Stage Map Step {0}'}"
                           Status="{Binding CalibrationStepList[3].StepName}"
                           Visibility="{Binding Cache.IsDarkField, Converter={StaticResource Boolean2VisibilityReConverter}}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="{Binding CalibrationStepList[7].StepIndex, StringFormat='Chuck Stage Map Step {0}'}"
                           Status="{Binding CalibrationStepList[7].StepName}"
                           Visibility="{Binding Cache.IsDarkField, Converter={StaticResource Boolean2VisibilityConverter}}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="High Microscope Magnification: "
                           Status="{Binding Cache.HighMagnificationEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="First Position: "
                           Status="{Binding Cache.FirstStageMapPosition, Converter={StaticResource PointToStringConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="1. Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown hc:InfoElement.Title="Repeat Count: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Visibility="{Binding Cache.IsDarkField, Converter={StaticResource Boolean2VisibilityConverter}}"
                                      Value="{Binding Cache.RepeatCount}" />
                    <hc:NumericUpDown hc:InfoElement.Title="Cal Row Min Cout: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalculateContainRowMinCout}" />
                    <hc:NumericUpDown hc:InfoElement.Title="Cal Column Min Count: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalculateContainColumnMinCount}" />
                    <hc:NumericUpDown hc:InfoElement.Title="Alignment Threshold(um): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalibrationAlignmentThreshold}" />
                    <hc:NumericUpDown hc:InfoElement.Title="Gantry Threshold(um): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalibrationGantryThreshold}" />
                    <hc:NumericUpDown hc:InfoElement.Title="Scale Threshold(um): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalibrationScaleThreshold}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Stage Map"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.RowNumber}"
                             hc:InfoElement.Title="Row Number: "
                             hc:TitleElement.TitleWidth="120"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.ColumnNumber}"
                             hc:InfoElement.Title="Column Number: "
                             hc:TitleElement.TitleWidth="120"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <view:CanvasView Width="100"
                                     Height="100"
                                     BackgroundColor="#0A0A0A"
                                     AxisColor="Red"
                                     Interactive="True"
                                     ShowAxes="True"
                                     ShowCursor="False"
                                     ShowGrid="False"
                                     BackgroundImage="{Binding Cache.TemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10"
                                            Visibility="{Binding IsAutoCalibrate, Converter={StaticResource Boolean2VisibilityReConverter}}">
                        <Button Content="Action"
                                Command="{Binding Step3CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button Content="Cancel"
                                Command="{Binding Step3CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2"
                  VerticalAlignment="Stretch"
                  Header="Calibration Data"
                  Visibility="{Binding Cache.IsDarkField, Converter={StaticResource Boolean2VisibilityReConverter}}">
            <children:BrightFieldMapView Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ActualHeight}" ChildName="Step3View">
                <children:BrightFieldMapView.IsEnabled>
                    <MultiBinding Converter="{StaticResource MultiValueBooleanConverter}">
                        <Binding Path="Step3CalibrateActionCommand.IsRunning" Converter="{StaticResource BoolNegationConverter}" />
                        <Binding Path="Cache.IsDarkField" Converter="{StaticResource Boolean2BooleanReConverter}" />
                    </MultiBinding>
                </children:BrightFieldMapView.IsEnabled>
            </children:BrightFieldMapView>
        </GroupBox>
        <GroupBox Grid.Column="2"
                  VerticalAlignment="Stretch"
                  Header="Calibration Data"
                  Visibility="{Binding Cache.IsDarkField, Converter={StaticResource Boolean2VisibilityConverter}}">
            <children:DarkFieldMapView Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ActualHeight}" ChildName="Step3View">
                <children:DarkFieldMapView.IsEnabled>
                    <MultiBinding Converter="{StaticResource MultiValueBooleanConverter}">
                        <Binding Path="Step3CalibrateActionCommand.IsRunning" Converter="{StaticResource BoolNegationConverter}" />
                        <Binding Path="Cache.IsDarkField" />
                    </MultiBinding>
                </children:DarkFieldMapView.IsEnabled>
            </children:DarkFieldMapView>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>