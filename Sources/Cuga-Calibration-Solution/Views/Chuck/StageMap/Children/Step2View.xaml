<UserControl x:Class="CugaCalibration.Views.Chuck.StageMap.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:children="clr-namespace:CugaCalibration.Views.Chuck.StageMap.Children"
             xmlns:stageMap="clr-namespace:Core.Models.Models.Common.StageMap;assembly=Core.Models"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:controls="clr-namespace:Core.Models.Models.Setting;assembly=Core.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckStageMapViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <Expander Header="Template Match Setting"
                                  IsExpanded="False"
                                  ExpandDirection="Down">
                            <Border Style="{StaticResource BorderRegion}">
                                <controls:TemplateMatchSettingUserControl DataContext="{Binding Cache.ChuckStageMapCacheBFItem.TemplateMatchSetting}" Engine="{Binding DataContext.CalibrationSetting.SettingTemplateMatchParam.AlgorithmEngineTypeEnum, RelativeSource={RelativeSource AncestorType={x:Type children:Step2View}}}" />
                            </Border>
                        </Expander>
                        <hc:NumericUpDown hc:TitleElement.Title="Wafer Radius(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ChuckStageMapCacheBFItem.WaferRadius}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Width(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ChuckStageMapCacheBFItem.DiePitchWidth}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Height(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ChuckStageMapCacheBFItem.DiePitchHeight}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left" Spacing="10">
                            <Button Content="Mark"
                                    Command="{Binding AddBFStageMapTemplateCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding AddBFStageMapTemplateCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                            <Button Content="Delete"
                                    Command="{Binding Cache.RemoveBFStageMapTemplatesCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=BFStageMapTemplatesList}"
                                    hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                                    Style="{StaticResource ButtonDanger}" />
                        </hc:UniformSpacingPanel>
                        <DataGrid x:Name="BFStageMapTemplatesList"
                                  MaxHeight="360"
                                  hc:DataGridAttach.ShowRowNumber="True"
                                  RowHeight="110"
                                  Style="{StaticResource DataGrid.Small}"
                                  HeadersVisibility="All"
                                  RowHeaderWidth="60"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Cache.ChuckStageMapCacheBFItem.StageMapTemplates}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="BF Machine Position(um)" Binding="{Binding FindBFMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                <DataGridTemplateColumn Header="Images">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type stageMap:StageMapTemplate}">
                                            <view:CanvasView Width="100"
                                                             Height="100"
                                                             BackgroundColor="#0A0A0A"
                                                             AxisColor="Red"
                                                             Interactive="True"
                                                             ShowAxes="True"
                                                             ShowCursor="False"
                                                             ShowGrid="False"
                                                             BackgroundImage="{Binding TemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step2Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step2CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="BF StageMap">
            <Border Style="{StaticResource BorderRegion}">
                <ContentPresenter Content="{Binding ., Mode=OneWay}" ContentTemplate="{StaticResource BFStageMapDocumentTemplate}" />
            </Border>
        </GroupBox>
    </Grid>
</UserControl>