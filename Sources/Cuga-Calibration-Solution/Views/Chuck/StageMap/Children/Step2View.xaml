<UserControl x:Class="CugaCalibration.Views.Chuck.StageMap.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:children="clr-namespace:CugaCalibration.Views.Chuck.StageMap.Children"
             xmlns:stageMap="clr-namespace:Core.Models.Models.Common.StageMap;assembly=Core.Models"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:controls="clr-namespace:Core.Models.Models.Setting;assembly=Core.Models"
             xmlns:graphicsWPF="clr-namespace:Net.Utilities.Graphics.WPF;assembly=Net.Utilities.Graphics.WPF"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckStageMapViewModel}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="{Binding CalibrationDisplayStepIndex, StringFormat={}Step {0}:}"
                           Status="{Binding CalibrationStepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield Subject="Microscope: "
                           Status="{Binding Cache.MicroscopeLensInformation}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Grid.Row="2" Style="{StaticResource BorderRegion}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                        <StackPanel>
                            <TextBlock Text="Param"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <controls:TemplateMatchSettingUserControl DataContext="{Binding Cache.ChuckStageMapCacheBFItem.TemplateMatchSetting}" Engine="{Binding DataContext.CalibrationSetting.SettingTemplateMatchParam.AlgorithmEngineTypeEnum, RelativeSource={RelativeSource AncestorType={x:Type children:Step2View}}}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Wafer Radius(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ChuckStageMapCacheBFItem.WaferRadius}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Width(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ChuckStageMapCacheBFItem.DiePitchWidth}" />
                        <hc:NumericUpDown hc:TitleElement.Title="Die Pitch Height(um): "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="190"
                                          Minimum="1"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.ChuckStageMapCacheBFItem.DiePitchHeight}" />
                        <StackPanel>
                            <TextBlock Text="StageMap Template Points"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Mark"
                                    Command="{Binding StageMapCommands.AddStageMapTemplateCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding StageMapCommands.AddStageMapTemplateCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                            <Button Content="Delete"
                                    Command="{Binding StageMapCommands.CacheItem.RemoveStageMapTemplatesCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=BFStageMapTemplatesList}"
                                    hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                                    Style="{StaticResource ButtonDanger}" />
                        </hc:UniformSpacingPanel>
                        <DataGrid x:Name="BFStageMapTemplatesList"
                                  MaxHeight="360"
                                  hc:DataGridAttach.ShowRowNumber="True"
                                  RowHeight="110"
                                  Style="{StaticResource DataGrid.Small}"
                                  HeadersVisibility="All"
                                  RowHeaderWidth="60"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Cache.ChuckStageMapCacheBFItem.StageMapTemplates}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="BF Machine Position(um)" Binding="{Binding FindBFMachinePosition, Converter={StaticResource PointToStringConverter}}" />
                                <DataGridTemplateColumn Header="Images">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type stageMap:StageMapTemplate}">
                                            <view:CanvasView Width="100"
                                                             Height="100"
                                                             BackgroundColor="#0A0A0A"
                                                             AxisColor="Red"
                                                             Interactive="True"
                                                             ShowAxes="True"
                                                             ShowCursor="False"
                                                             ShowGrid="False"
                                                             BackgroundImage="{Binding TemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button Content="Action"
                                    Command="{Binding Step2Command}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button Content="Cancel"
                                    Command="{Binding Step2CancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" />
        <GroupBox Grid.Column="2" Header="BF StageMap">
            <Border Style="{StaticResource BorderRegion}">
                <graphicsWPF:WPFCanvasControl Document="{Binding CalibratingItem.BFStageMapDocument, Mode=OneWay}" CursorTextVisibility="Collapsed">
                    <graphicsWPF:WPFCanvasControl.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="pack://application:,,,/Net.Utilities.WPF.CustomControl.Themes;component/Themes/ToolBarStyles.xaml" />
                            </ResourceDictionary.MergedDictionaries>
                        </ResourceDictionary>
                    </graphicsWPF:WPFCanvasControl.Resources>
                    <graphicsWPF:WPFCanvasControl.LeftToolBars>
                        <ToolBar Margin="3,2"
                                 Padding="3,2"
                                 Background="Transparent"
                                 Band="0"
                                 BandIndex="2">
                            <ItemsControl ItemsSource="{Binding Cache.ChuckStageMapCacheBFItem.StageMapTemplates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type stageMap:StageMapTemplate}">
                                        <Button Content="{Binding DisplayIndex, Mode=OneWay}"
                                                Command="{Binding DataContext.StageMapCommands.GotoStageMapDocumentSelectedItemPositionCommand, RelativeSource={RelativeSource AncestorType={x:Type children:Step2View}}}"
                                                CommandParameter="{Binding}"
                                                Height="24"
                                                Margin="3,0"
                                                Padding="5,3"
                                                ContentStringFormat="Goto {0}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ToolBar>
                    </graphicsWPF:WPFCanvasControl.LeftToolBars>
                    <graphicsWPF:WPFCanvasControl.RightToolBars>
                        <ToolBar Margin="3,2"
                                 Padding="3,2"
                                 Background="Transparent"
                                 Band="0"
                                 BandIndex="1">
                            <TextBlock d:Text="0, 0 | (0.0, 0.0)" Style="{StaticResource ToolBarTextBlock}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static stageMap:StageMapDocumentCursorToStringConverter.Instance}">
                                        <Binding Path="CalibratingItem.BFStageMapDocument.View.Cursor.Point" />
                                        <Binding Path="CalibratingItem.BFStageMapDocument" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </ToolBar>
                    </graphicsWPF:WPFCanvasControl.RightToolBars>
                </graphicsWPF:WPFCanvasControl>
            </Border>
        </GroupBox>
    </Grid>
</UserControl>