<UserControl x:Class="CugaCalibration.Views.Chuck.Center.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enumAlgorithm="clr-namespace:Core.Models.Enums.Algorithm;assembly=Core.Models"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:wafer="clr-namespace:Core.Models.Enums.Recipe.Wafer;assembly=Core.Models"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckCenterCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Center Step 1: "
                           Status="{Binding CalibrationStepList[0].StepName}"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:ComboBox x:Name="LowMagCombobox"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Low Magnification: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.LowChuckCenterCacheItem.MagnificationInfo}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeMagnificationInfoList}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MicroscopeMagnificationName}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding MagnificationSelectedCommand}" CommandParameter="{Binding ElementName=LowMagCombobox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                    <hc:ComboBox x:Name="HighMagCombobox"
                                 HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="High Magnification: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.HighChuckCenterCacheItem.MagnificationInfo}"
                                 ItemsSource="{Binding ApplicationCookie.MicroscopeMagnificationInfoList}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MicroscopeMagnificationName}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding MagnificationSelectedCommand}" CommandParameter="{Binding ElementName=HighMagMagCombobox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                    <hc:ComboBox HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Template Mask Type: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.WaferMaskTypeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type wafer:WaferMaskTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                    <hc:ComboBox HorizontalAlignment="Left"
                                 hc:InfoElement.TitlePlacement="Left"
                                 hc:InfoElement.Title="Template Type: "
                                 hc:InfoElement.Necessary="True"
                                 SelectedItem="{Binding Cache.AlgorithmTemplateTypeEnum}"
                                 ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type enumAlgorithm:AlgorithmTemplateTypeEnum}}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                    </hc:ComboBox>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}"
                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->

        <GridSplitter Grid.Column="1" Width="5" />

        <!--#region Right-->
        <Grid Grid.Column="2">
            <GroupBox Header="Calibration Data">
                <UniformGrid Columns="2" Rows="2">
                    <UniformGrid.Resources>
                        <Style BasedOn="{StaticResource BorderRegion}" TargetType="Border">
                            <Setter Property="Margin" Value="5" />
                        </Style>
                        <Style BasedOn="{StaticResource TextBlockDefaultInfo}" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{Binding ReviewDto.IsVerified, Converter={StaticResource BoolToBrushConverter}}" />
                        </Style>
                    </UniformGrid.Resources>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <StackPanel>
                                <TextBlock Text="Top-LowSite" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding Cache.LowChuckCenterCacheItem.TopPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="245"
                                         hc:TitleElement.TitleWidth="90"
                                         hc:InfoElement.Title="Position(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button x:Name="TopleftLowSiteGetButton"
                                        Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="LowTop" />
                                <Button x:Name="TopleftLowSiteGotoButton"
                                        Content="Goto"
                                        Command="{Binding GotoPointCommand}"
                                        CommandParameter="LowTop"
                                        Width="70" />
                            </hc:UniformSpacingPanel>
                            <StackPanel>
                                <TextBlock Text="Top-HighSite" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding Cache.HighChuckCenterCacheItem.TopPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="245"
                                         hc:TitleElement.TitleWidth="90"
                                         hc:InfoElement.Title="Position(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button x:Name="TopleftHighSiteGetButton"
                                        Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="HighTop" />
                                <Button x:Name="TopleftHighSiteGotoButton"
                                        Content="Goto"
                                        Command="{Binding GotoPointCommand}"
                                        CommandParameter="HighTop"
                                        Width="70" />
                            </hc:UniformSpacingPanel>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <view:CanvasView Width="160"
                                                 Height="160"
                                                 BackgroundColor="#0A0A0A"
                                                 BackgroundImage="{Binding Cache.LowChuckCenterCacheItem.TopTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False" />
                                <Border Width="4" />
                                <view:CanvasView Width="160"
                                                 Height="160"
                                                 BackgroundColor="#0A0A0A"
                                                 BackgroundImage="{Binding Cache.HighChuckCenterCacheItem.TopTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False" />
                            </StackPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <StackPanel>
                                <TextBlock Text="Right-LowSite" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding Cache.LowChuckCenterCacheItem.RightPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="245"
                                         hc:TitleElement.TitleWidth="90"
                                         hc:InfoElement.Title="Position(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button x:Name="RightLowSiteGetButton"
                                        Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="LowRight" />
                                <Button x:Name="RightLowSiteGotoButton"
                                        Content="Goto"
                                        Command="{Binding GotoPointCommand}"
                                        CommandParameter="LowRight"
                                        Width="70" />
                            </hc:UniformSpacingPanel>
                            <StackPanel>
                                <TextBlock Text="Right-HighSite" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding Cache.HighChuckCenterCacheItem.RightPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="245"
                                         hc:TitleElement.TitleWidth="90"
                                         hc:InfoElement.Title="Position(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button x:Name="TopHighSiteGetButton"
                                        Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="HighRight" />
                                <Button x:Name="TopHighSiteGotoButton"
                                        Content="Goto"
                                        Command="{Binding GotoPointCommand}"
                                        CommandParameter="HighRight"
                                        Width="70" />
                            </hc:UniformSpacingPanel>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <view:CanvasView Width="160"
                                                 Height="160"
                                                 BackgroundColor="#0A0A0A"
                                                 BackgroundImage="{Binding Cache.LowChuckCenterCacheItem.RightTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False" />
                                <Border Width="4" />
                                <view:CanvasView Width="160"
                                                 Height="160"
                                                 BackgroundColor="#0A0A0A"
                                                 BackgroundImage="{Binding Cache.HighChuckCenterCacheItem.RightTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False" />
                            </StackPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <StackPanel>
                                <TextBlock Text="Bottom-LowSite" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding Cache.LowChuckCenterCacheItem.BottomPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="245"
                                         hc:TitleElement.TitleWidth="90"
                                         hc:InfoElement.Title="Position(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button x:Name="BottomLowSiteGetButton"
                                        Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="LowBottom" />
                                <Button x:Name="BottomLowSiteGotoButton"
                                        Content="Goto"
                                        Command="{Binding GotoPointCommand}"
                                        CommandParameter="LowBottom"
                                        Width="70" />
                            </hc:UniformSpacingPanel>
                            <StackPanel>
                                <TextBlock Text="Bottom-HighSite" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding Cache.HighChuckCenterCacheItem.BottomPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="245"
                                         hc:TitleElement.TitleWidth="90"
                                         hc:InfoElement.Title="Position(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button x:Name="BottomHighSiteGetButton"
                                        Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="HighBottom" />
                                <Button x:Name="BottomHighSiteGotoButton"
                                        Content="Goto"
                                        Command="{Binding GotoPointCommand}"
                                        CommandParameter="HighBottom"
                                        Width="70" />
                            </hc:UniformSpacingPanel>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <view:CanvasView Width="160"
                                                 Height="160"
                                                 BackgroundColor="#0A0A0A"
                                                 BackgroundImage="{Binding Cache.LowChuckCenterCacheItem.BottomTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False" />
                                <Border Width="4" />
                                <view:CanvasView Width="160"
                                                 Height="160"
                                                 BackgroundColor="#0A0A0A"
                                                 BackgroundImage="{Binding Cache.HighChuckCenterCacheItem.BottomTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False" />
                            </StackPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                    <Border>
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                            <StackPanel>
                                <TextBlock Text="Left-LowSite" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding Cache.LowChuckCenterCacheItem.LeftPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="245"
                                         hc:TitleElement.TitleWidth="90"
                                         hc:InfoElement.Title="Position(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button x:Name="LeftLowSiteGetButton"
                                        Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="LowLeft" />
                                <Button x:Name="LeftLowSiteGotoButton"
                                        Content="Goto"
                                        Command="{Binding GotoPointCommand}"
                                        CommandParameter="LowLeft"
                                        Width="70" />
                            </hc:UniformSpacingPanel>
                            <StackPanel>
                                <TextBlock Text="Left-HighSite" />
                            </StackPanel>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding Cache.HighChuckCenterCacheItem.LeftPosition, Converter={StaticResource PointToStringConverter}}"
                                         Width="245"
                                         hc:TitleElement.TitleWidth="90"
                                         hc:InfoElement.Title="Position(um): "
                                         hc:InfoElement.TitlePlacement="Left"
                                         Style="{StaticResource TextBoxExtend}" />
                                <Button x:Name="LeftHighSiteGetButton"
                                        Content="Get"
                                        Command="{Binding GetPointCommand}"
                                        CommandParameter="HighLeft" />
                                <Button x:Name="LeftHighSiteGotoButton"
                                        Content="Goto"
                                        Command="{Binding GotoPointCommand}"
                                        CommandParameter="HighLeft"
                                        Width="70" />
                            </hc:UniformSpacingPanel>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <view:CanvasView Width="160"
                                                 Height="160"
                                                 BackgroundColor="#0A0A0A"
                                                 BackgroundImage="{Binding Cache.LowChuckCenterCacheItem.LeftTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False" />
                                <Border Width="4" />
                                <view:CanvasView Width="160"
                                                 Height="160"
                                                 BackgroundColor="#0A0A0A"
                                                 BackgroundImage="{Binding Cache.HighChuckCenterCacheItem.LeftTemplateImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}"
                                                 AxisColor="Red"
                                                 Interactive="True"
                                                 ShowAxes="True"
                                                 ShowCursor="False"
                                                 ShowGrid="False" />
                            </StackPanel>
                        </hc:UniformSpacingPanel>
                    </Border>
                </UniformGrid>
            </GroupBox>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>