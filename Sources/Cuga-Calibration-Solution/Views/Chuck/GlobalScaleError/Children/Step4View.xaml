<UserControl x:Class="CugaCalibration.Views.Chuck.GlobalScaleError.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckGlobalScaleErrorCalibrationViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="1600"
             mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--#region Left-->
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:Shield Subject="Global Scale Error Step 5: "
                               Status="{Binding CalibrationSteps[7].StepName}"
                               Color="{StaticResource InfoBrush}" />
                </hc:UniformSpacingPanel>

                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Calibration Global Scale"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <hc:NumericUpDown Margin="0,0,0,5"
                                          hc:TitleElement.Title="Times: "
                                          hc:TitleElement.TitlePlacement="Left"
                                          hc:TitleElement.TitleWidth="120"
                                          Minimum="1"
                                          Maximum="10"
                                          Style="{StaticResource NumericUpDownExtend}"
                                          Value="{Binding Cache.Times}" />
                        <TextBox x:Name="ThresholdTextBox"
                                 Text="{Binding Cache.Threshold, Converter={StaticResource PointToStringConverter}}"
                                 hc:TitleElement.Title="Threshold(x,y): "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:TitleElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ResultGlobalScaleErrorDto.AppliedScaleXY, StringFormat={}{0:f8}}"
                                 hc:TitleElement.Title="Applied Scale: "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ResultGlobalScaleErrorDto.ScaleErrorValue, Converter={StaticResource PointToStringConverter}, StringFormat={}{0:f4}}"
                                 hc:TitleElement.Title="Error Value(um): "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:TitleElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Background="{StaticResource SecondaryRegionBrush}"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10">
                            <Button x:Name="ActionButton"
                                    Content="Action"
                                    Command="{Binding Step4CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Command="{Binding Step4CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </hc:UniformSpacingPanel>
            <!--#endregion-->

            <GridSplitter Grid.Column="1" Width="5" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox MinHeight="180"
                          Margin="0,0,0,10"
                          Header="History">
                    <ListView d:SelectedIndex="0"
                              ItemsSource="{Binding GlobalScaleErrorDtoItemDtoList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectGlobalScaleErrorDto}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="auto"
                                                Header="Applied Scale"
                                                DisplayMemberBinding="{Binding AppliedScaleXY, StringFormat={}{0:f8}}" />
                                <GridViewColumn Width="auto"
                                                Header="Result Scale"
                                                DisplayMemberBinding="{Binding ResultScaleXY, StringFormat={}{0:f8}}" />
                                <GridViewColumn Width="auto"
                                                Header="Error Value(um)"
                                                DisplayMemberBinding="{Binding ScaleErrorValue, Converter={StaticResource PointToStringConverter}, StringFormat={}{0:f6}}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
                <GridSplitter Grid.Row="1" />
                <hc:UniformSpacingPanel Grid.Row="2"
                                        Orientation="Vertical"
                                        Spacing="5">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <TextBlock Text="Find Result Image"
                                   HorizontalAlignment="Center"
                                   Background="Transparent" />
                    </Border>
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.HighSiteMatchResult.TopFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.HighSiteMatchResult.TopPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:TitleElement.Title="High-Top Real Position(um): "
                                             hc:TitleElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Background="{StaticResource SecondaryRegionBrush}"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.HighSiteMatchResult.BottomFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.HighSiteMatchResult.BottomPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:TitleElement.Title="High-Bottom Real Position(um): "
                                             hc:TitleElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Background="{StaticResource SecondaryRegionBrush}"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Column="2" Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.HighSiteMatchResult.LeftFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.HighSiteMatchResult.LeftPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:TitleElement.Title="High-Left Real Position(um): "
                                             hc:TitleElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Background="{StaticResource SecondaryRegionBrush}"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Column="3"
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <hc:UniformSpacingPanel HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Orientation="Vertical"
                                                        Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.HighSiteMatchResult.RightFindResultImageFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.HighSiteMatchResult.RightPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:TitleElement.Title="High-Right Real Position(um): "
                                             hc:TitleElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Background="{StaticResource SecondaryRegionBrush}"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Grid>
                    </Border>
                </hc:UniformSpacingPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>