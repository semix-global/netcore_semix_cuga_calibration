<UserControl x:Class="CugaCalibration.Views.Chuck.GlobalScaleError.Children.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors;assembly=Net.Utilities.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckGlobalScaleErrorCalibrationViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="1600"
             mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--#region Left-->
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:Shield Subject="Global Scale Error Step 5: "
                               Status="{Binding CalibrationStepList[4].StepName}"
                               Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                               Color="{StaticResource InfoBrush}" />
                </hc:UniformSpacingPanel>

                <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Calibration Global Scale Coefficient"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Style="{StaticResource TextBlockDefaultInfo}" />
                        </StackPanel>
                        <TextBox x:Name="ThresholdTextBox"
                                 Text="{Binding Cache.Threshold, Converter={StaticResource PointToStringConverter}}"
                                 hc:InfoElement.Title="Threshold(x,y): "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ResultGlobalScaleErrorDto.ScaleX, StringFormat={}{0:f6}}"
                                 hc:InfoElement.Title="X Scale: "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ResultGlobalScaleErrorDto.ScaleY, StringFormat={}{0:f6}}"
                                 hc:InfoElement.Title="Y Scale: "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <TextBox Text="{Binding ResultGlobalScaleErrorDto.ScaleErrorValue, Converter={StaticResource PointToStringConverter}}"
                                 hc:InfoElement.Title="Error Value(um): "
                                 hc:TitleElement.TitleWidth="120"
                                 hc:InfoElement.TitlePlacement="Left"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxExtend}" />
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Spacing="10"
                                                Visibility="{Binding Path=DataContext.IsAutoCalibrate, Converter={StaticResource BoolNegationToVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
                            <Button x:Name="ActionButton"
                                    Content="Action"
                                    Command="{Binding Step4CalibrateActionCommand}"
                                    hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                    Style="{StaticResource ButtonPrimary.Loading}" />
                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Command="{Binding Step4CalibrateActionCancelCommand}"
                                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                    Style="{StaticResource ButtonWarning}" />
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </Border>
            </hc:UniformSpacingPanel>
            <!--#endregion-->

            <GridSplitter Grid.Column="1" Width="5" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox MinHeight="180"
                          Margin="0,0,0,10"
                          Header="History">
                    <ListView d:SelectedIndex="0"
                              ItemsSource="{Binding GlobalScaleErrorDtoItemDtoList}"
                              Style="{StaticResource ListView.Small}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectGlobalScaleErrorDto}">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type GridViewColumnHeader}}" TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="auto"
                                                Header="ScaleX"
                                                DisplayMemberBinding="{Binding ScaleX, StringFormat={}{0:f14}}" />
                                <GridViewColumn Width="auto"
                                                Header="ScaleY"
                                                DisplayMemberBinding="{Binding ScaleY, StringFormat={}{0:f14}}" />
                                <GridViewColumn Width="auto"
                                                Header="Error Value(um)"
                                                DisplayMemberBinding="{Binding ScaleErrorValue, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="auto"
                                                Header="Top-Low Real Point"
                                                DisplayMemberBinding="{Binding TopLowSiteRealPosition, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="auto"
                                                Header="Top-High Real Point"
                                                DisplayMemberBinding="{Binding TopHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="auto"
                                                Header="Bottom-Low Real Point"
                                                DisplayMemberBinding="{Binding BottomLowSiteRealPosition, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="auto"
                                                Header="Bottom-High Real Point"
                                                DisplayMemberBinding="{Binding BottomHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="auto"
                                                Header="Left-Low Real Point"
                                                DisplayMemberBinding="{Binding LeftLowSiteRealPosition, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="auto"
                                                Header="Left-High Real Point"
                                                DisplayMemberBinding="{Binding LeftHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="auto"
                                                Header="Right-Low Real Point"
                                                DisplayMemberBinding="{Binding RightLowSiteRealPosition, Converter={StaticResource PointToStringConverter}}" />
                                <GridViewColumn Width="auto"
                                                Header="Right-High Real Point"
                                                DisplayMemberBinding="{Binding RightHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
                <GridSplitter Grid.Row="1" />
                <hc:UniformSpacingPanel Grid.Row="2"
                                        Orientation="Vertical"
                                        Spacing="5">
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <TextBlock Text="Find Result Image"
                                   HorizontalAlignment="Center"
                                   Background="Transparent" />
                    </Border>
                    <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.Column="0"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.TopLowSiteFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.TopLowSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Low-Top Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1"
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.BottomLowSiteFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.BottomLowSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Low-Bottom Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.LeftLowSiteFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.LeftLowSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Low-Left Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="3"
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.RightLowSiteFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.RightLowSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="Low-Right Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.TopHighSiteFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding Cache.TopSideIdeaPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="High-Top Idea Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.TopHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="High-Top Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.BottomHighSiteFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding Cache.BottomSideIdeaPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="High-Bottom Idea Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.BottomHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="High-Bottom Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2"
                                    Margin="10">
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.LeftHighSiteFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding Cache.LeftSideIdeaPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="High-Left Idea Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.LeftHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="High-Left Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3"
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <hc:UniformSpacingPanel HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Orientation="Vertical"
                                                        Spacing="3">
                                    <view:CanvasView Width="180"
                                                     Height="180"
                                                     BackgroundColor="#0A0A0A"
                                                     AxisColor="Red"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     BackgroundImage="{Binding SelectGlobalScaleErrorDto.RightHighSiteFindResultFilePath, Converter={StaticResource StringToBitmapSourceConverter}}" />
                                    <TextBox Text="{Binding Cache.RightSideIdeaPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="High-Right Idea Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                    <TextBox Text="{Binding SelectGlobalScaleErrorDto.RightHighSiteRealPosition, Converter={StaticResource PointToStringConverter}}"
                                             Width="auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             hc:TitleElement.TitleWidth="auto"
                                             hc:InfoElement.Title="High-Right Real Position(um): "
                                             hc:InfoElement.TitlePlacement="Top"
                                             IsReadOnly="True"
                                             Style="{StaticResource TextBoxExtend}" />
                                </hc:UniformSpacingPanel>
                            </Border>
                        </Grid>
                    </Border>
                </hc:UniformSpacingPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>