<UserControl x:Class="CugaCalibration.Views.Chuck.AlignmentDegreeOffset.Children.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:constants="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckAlignmentDegreeOffsetCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Alignment Degree Offset Step : P5" Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Productivity Information: "
                           Status="{Binding Cache.ProductivityInformation}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Optics Illumination Mode: "
                           Status="{Binding Cache.OpticsIlluminationModeEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
                <hc:Shield Subject="Alignment Mode: " Color="{StaticResource InfoBrush}">
                    <hc:Shield.Style>
                        <Style TargetType="hc:Shield" BasedOn="{StaticResource ShieldBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="False">
                                    <Setter Property="Status" Value="BrightFiled" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="True">
                                    <Setter Property="Status" Value="DarkFiled" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:Shield.Style>
                </hc:Shield>
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    Visibility="{Binding IsDarkFieldAlignment, Converter={StaticResource Boolean2VisibilityConverter}}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Config Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="PositionThresholdNumeric"
                                      hc:TitleElement.TitleWidth="190"
                                      hc:TitleElement.Title="Teaching Offset Threshold(°):"
                                      hc:TitleElement.TitlePlacement="Left"
                                      Minimum="0"
                                      Maximum="2"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.TeachingThreshold}" />
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Alignment Setting Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox hc:TitleElement.Title="Low Site1(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="100"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.True}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheDarkField.LowSite1.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.False}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheBrightField.LowSite1.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox hc:TitleElement.Title="Low Site2(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="100"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.True}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheDarkField.LowSite2.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.False}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheBrightField.LowSite2.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox hc:TitleElement.Title="High Site1(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="100"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.True}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheDarkField.HighSite1.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.False}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheBrightField.HighSite1.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox hc:TitleElement.Title="High Site2(um): "
                             hc:TitleElement.TitlePlacement="Left"
                             hc:TitleElement.TitleWidth="100"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.True}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheDarkField.HighSite2.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.False}">
                                        <Setter Property="Text" Value="{Binding AlignmentCacheBrightField.HighSite2.Location, Converter={StaticResource PointToStringConverter}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <hc:UniformSpacingPanel Spacing="10">
                        <view:CanvasView Width="100"
                                         Height="100"
                                         BackgroundColor="#0A0A0A"
                                         AxisColor="Red"
                                         Interactive="True"
                                         ShowAxes="True"
                                         ShowCursor="False"
                                         ShowGrid="False">
                            <view:CanvasView.Style>
                                <Style TargetType="view:CanvasView">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.True}">
                                            <Setter Property="BackgroundImage" Value="{Binding AlignmentCacheDarkField.LowSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.False}">
                                            <Setter Property="BackgroundImage" Value="{Binding AlignmentCacheBrightField.LowSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </view:CanvasView.Style>
                        </view:CanvasView>
                        <view:CanvasView Width="100"
                                         Height="100"
                                         BackgroundColor="#0A0A0A"
                                         AxisColor="Red"
                                         Interactive="True"
                                         ShowAxes="True"
                                         ShowCursor="False"
                                         ShowGrid="False">
                            <view:CanvasView.Style>
                                <Style TargetType="view:CanvasView">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.True}">
                                            <Setter Property="BackgroundImage" Value="{Binding AlignmentCacheDarkField.HighSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.False}">
                                            <Setter Property="BackgroundImage" Value="{Binding AlignmentCacheBrightField.HighSite1.Template.Thumb, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </view:CanvasView.Style>
                        </view:CanvasView>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Result"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding CalibratingItem.BrightFieldAlignmentDegree, StringFormat={}{0:f6}}"
                             hc:TitleElement.Title="Bright Field Degrees(°): "
                             hc:TitleElement.TitleWidth="200"
                             hc:TitleElement.TitlePlacement="Left"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding CalibratingItem.DarkFieldAlignmentDegree, StringFormat={}{0:f6}}"
                             hc:TitleElement.Title="Dark Field Degrees(°): "
                             hc:TitleElement.TitleWidth="200"
                             hc:TitleElement.TitlePlacement="Left"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True"
                             Visibility="{Binding IsDarkFieldAlignment, Converter={StaticResource Boolean2VisibilityConverter}}"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding CalibratingItem.DegreeOffset, Mode=OneWay, StringFormat={}{0:f6}}"
                             hc:TitleElement.Title="Degrees Offset(°): "
                             hc:TitleElement.TitleWidth="200"
                             hc:TitleElement.TitlePlacement="Left"
                             Background="{StaticResource SecondaryRegionBrush}"
                             IsReadOnly="True"
                             Visibility="{Binding IsDarkFieldAlignment, Converter={StaticResource Boolean2VisibilityConverter}}"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button Content="Action" hc:IconElement.Geometry="{StaticResource DownloadGeometry}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ButtonPrimary.Loading}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.True}">
                                            <Setter Property="Command" Value="{Binding Step3CalibrateActionCommand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.False}">
                                            <Setter Property="Command" Value="{Binding Step2CalibrateActionCommand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Cancel" hc:IconElement.Geometry="{StaticResource CloseGeometry}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ButtonWarning}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.True}">
                                            <Setter Property="Command" Value="{Binding Step3CalibrateActionCancelCommand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDarkFieldAlignment}" Value="{x:Static constants:Constants.False}">
                                            <Setter Property="Command" Value="{Binding Step2CalibrateActionCancelCommand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
    </Grid>
</UserControl>