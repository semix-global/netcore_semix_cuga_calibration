<UserControl x:Class="CugaCalibration.Views.Chuck.BrightFieldStageMap.Children.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:children="clr-namespace:CugaCalibration.Views.Chuck.BrightFieldStageMap.Children"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckBrightFieldStageMapCalibrationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Bright Field Stage Map Step 2: "
                           Status="{Binding CalibrationStepList[1].StepName}"
                           Color="{StaticResource InfoBrush}" />
                <hc:Shield DockPanel.Dock="Bottom"
                           Subject="Low Microscope Magnification: "
                           Status="{Binding Cache.MicroscopeMagnificationEnum, Converter={StaticResource EnumDescriptionConverter}}"
                           Color="{StaticResource SuccessBrush}" />
            </hc:UniformSpacingPanel>
            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Param"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <hc:NumericUpDown x:Name="RowNumberNumeric"
                                      Margin="0,5,0,5"
                                      hc:InfoElement.Title="Row Number: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="140"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.RowNumber}" />
                    <hc:NumericUpDown x:Name="ColumnNumberNumeric"
                                      Margin="0,5,0,5"
                                      hc:InfoElement.Title="Column Number: "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="140"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ColumnNumber}" />
                    <hc:NumericUpDown x:Name="ColumnCellWidthNumeric"
                                      Margin="0,5,0,5"
                                      hc:InfoElement.Title="Column Cell Width(um): "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="140"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.ColumnCellWidth}" />
                    <hc:NumericUpDown x:Name="RowCellHeightNumeric"
                                      Margin="0,5,0,5"
                                      hc:InfoElement.Title="Row Cell Height(um): "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="140"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.RowCellHeight}" />
                    <hc:NumericUpDown x:Name="WaferDiameterNumeric"
                                      Margin="0,5,0,5"
                                      hc:InfoElement.Title="Wafer Diameter(um): "
                                      hc:InfoElement.Necessary="True"
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="140"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.WaferDiameter}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding Step1CalibrateActionCommand}"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding Step1CalibrateActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <GroupBox Grid.Column="2"
                  VerticalAlignment="Stretch"
                  Header="Calibration Data">
            <children:MapView Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ActualHeight}"
                              IsEnabled="{Binding Step1CalibrateActionCommand.IsRunning, Converter={StaticResource BoolNegationConverter}}"
                              ChildName="Step1View" />
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>