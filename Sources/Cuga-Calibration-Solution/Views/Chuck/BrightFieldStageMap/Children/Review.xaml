<UserControl x:Class="CugaCalibration.Views.Chuck.BrightFieldStageMap.Children.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels.Chuck"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:children="clr-namespace:CugaCalibration.Views.Chuck.BrightFieldStageMap.Children"
             d:DataContext="{d:DesignInstance Type=viewModels:ChuckBrightFieldStageMapCalibrationViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Left-->
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <hc:Shield Subject="Chuck Bright Field Stage Map Step: "
                           Status="Review"
                           Color="{StaticResource InfoBrush}" />
            </hc:UniformSpacingPanel>

            <Border Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow1}">
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                    <StackPanel>
                        <TextBlock Text="Verify"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Style="{StaticResource TextBlockDefaultInfo}" />
                    </StackPanel>
                    <TextBox Text="{Binding Cache.RowNumber}"
                             Margin="0,5,0,5"
                             hc:InfoElement.Title="Row Number: "
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <TextBox Text="{Binding Cache.ColumnNumber}"
                             Margin="0,5,0,5"
                             hc:InfoElement.Title="Column Number: "
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.TitlePlacement="Left"
                             IsReadOnly="True"
                             Style="{StaticResource TextBoxExtend}" />
                    <Separator />
                    <hc:NumericUpDown Margin="0,5,0,5"
                                      hc:InfoElement.Title="Cal Row Min Cout: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalculateContainRowMinCount}" />
                    <hc:NumericUpDown Margin="0,5,0,5"
                                      hc:InfoElement.Title="Cal Column Min Count: "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="1"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.CalculateContainColumnMinCount}" />
                    <hc:NumericUpDown Margin="0,5,0,5"
                                      hc:InfoElement.Title="Alignment Threshold(um): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyAlignmentThreshold}" />
                    <hc:NumericUpDown Margin="0,5,0,5"
                                      hc:InfoElement.Title="Gantry Threshold(um): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyGantryThreshold}" />
                    <hc:NumericUpDown Margin="0,5,0,5"
                                      hc:InfoElement.Title="Scale Threshold(um): "
                                      hc:InfoElement.TitlePlacement="Left"
                                      hc:InfoElement.ShowClearButton="True"
                                      hc:TitleElement.TitleWidth="180"
                                      Minimum="0"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Value="{Binding Cache.VerifyScaleThreshold}" />
                    <TextBox x:Name="ThresholdTextBox"
                             Text="{Binding Cache.Threshold, Converter={StaticResource PointToStringConverter}}"
                             Margin="0,5,0,5"
                             hc:InfoElement.Title="Threshold: "
                             hc:TitleElement.TitleWidth="180"
                             hc:InfoElement.TitlePlacement="Left"
                             Style="{StaticResource TextBoxExtend}" />
                    <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="10">
                        <Button x:Name="ActionButton"
                                Content="Action"
                                Command="{Binding VerifyActionCommand}"
                                Height="28"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                                Style="{StaticResource ButtonPrimary.Loading}" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Command="{Binding VerifyActionCancelCommand}"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                Style="{StaticResource ButtonWarning}" />
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </hc:UniformSpacingPanel>
        <!--#endregion-->
        <GridSplitter Grid.Column="1" Width="5" />
        <!--#region Right-->
        <TabControl Grid.Column="2">
            <TabItem Header="Verify Error Map">
                <children:MapView Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ActualHeight}"
                                  IsEnabled="{Binding Step3CalibrateActionCommand.IsRunning, Converter={StaticResource BoolNegationConverter}}"
                                  ChildName="ReviewVerify" />
            </TabItem>
            <TabItem Header="Calibration Error Map">
                <children:MapView Width="{Binding RelativeSource={RelativeSource Mode=Self}, Path=ActualHeight}"
                                  IsEnabled="{Binding Step3CalibrateActionCommand.IsRunning, Converter={StaticResource BoolNegationConverter}}"
                                  ChildName="ReviewCalibration" />
            </TabItem>
        </TabControl>
        <!--#endregion-->
    </Grid>
</UserControl>