<hc:Window x:Class="CugaCalibration.Views.ApplicationAboutWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:behaviors="clr-namespace:Net.Utilities.WPF.Behaviors.ItemsControlBehaviors;assembly=Net.Utilities.WPF.Behaviors"
           xmlns:viewModels="clr-namespace:CugaCalibration.ViewModels"
           Title="About"
           Width="500"
           Height="800"
           d:DataContext="{d:DesignInstance Type=viewModels:ApplicationAboutWindowViewModel}"
           Icon="pack://application:,,,/Cuga-Calibration-Solution;component/Assets/Images/CugaCalibration.ico"
           WindowStyle="None"
           ResizeMode="NoResize"
           BorderThickness="2"
           WindowStartupLocation="CenterScreen"
           BorderBrush="{StaticResource PrimaryBrush}"
           mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="BoldTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="About"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <!--#endregion-->
        <!--#region Body-->
        <Border Grid.Row="1"
                Margin="0"
                CornerRadius="0"
                Style="{StaticResource BorderRegion}"
                Effect="{StaticResource EffectShadow1}">
            <Grid Margin="30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.5*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Source="pack://application:,,,/Cuga-Calibration-Solution;component/Assets/Images/CugaCalibration2.ico" />
                    <Grid Grid.Column="1" Margin="10,0,0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Cuga Calibration"
                                   HorizontalAlignment="Left"
                                   FontSize="30"
                                   Foreground="#3099c5" />
                        <hc:UniformSpacingPanel Grid.Row="1">
                            <TextBlock Text="{Binding ApplicationInfo.VersionInfo.Metadata.Version, StringFormat='{}{0} |'}"
                                       Padding="5,5,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <TextBlock Padding="5,5,0,0" HorizontalAlignment="Right">
                                <Hyperlink Command="{Binding ShowUpdateMarkDownCommand}">
                                    <Hyperlink.Style>
                                        <Style TargetType="Hyperlink">
                                            <Setter Property="TextDecorations" Value="None" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryRegionBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Hyperlink.Style>
                                    Update Document
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="|"
                                       Padding="5,5,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <TextBlock Padding="5,5,0,0" HorizontalAlignment="Right">
                                <Hyperlink Command="{Binding OutputAssemblyInfoFileCommand}">
                                    <Hyperlink.Style>
                                        <Style TargetType="Hyperlink">
                                            <Setter Property="TextDecorations" Value="None" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryRegionBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Hyperlink.Style>
                                    Assemblies Download
                                </Hyperlink>
                            </TextBlock>
                        </hc:UniformSpacingPanel>
                    </Grid>
                </Grid>
                <RichTextBox Grid.Row="1"
                             FontSize="15"
                             IsReadOnly="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderBrush="Transparent">
                    <FlowDocument>
                        <Paragraph>
                            <Run Text="Cuga-Calibration it's a application used for defect inspection equipment system calibration." />
                        </Paragraph>
                        <Paragraph>
                            <Run Text="This software is supported by .NET" />
                        </Paragraph>
                        <Paragraph>
                            <Run Text="{Binding ApplicationInfo.CLRVersion, StringFormat='CLR Version {0}', Mode=OneWay}" />
                        </Paragraph>
                        <Paragraph>
                            <Run Text="Copyright Reserved ©2020-2026 Semix" />
                            <LineBreak />
                            <Hyperlink>https://www.semixchina.com</Hyperlink>
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>
                <TextBlock Grid.Row="2"
                           Text="System"
                           Margin="0,10,0,5"
                           HorizontalAlignment="Left"
                           Style="{StaticResource BoldTextStyle}" />
                <Border Grid.Row="3" BorderBrush="Transparent">
                    <ListBox ItemsSource="{Binding SystemInfoList}"
                             Style="{StaticResource ListBox.Small}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <hc:UniformSpacingPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SystemName}"
                                               Width="300"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SystemInformation}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextTrimming="None" />
                                </hc:UniformSpacingPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock Grid.Row="4"
                           Text="Components"
                           Margin="0,5"
                           HorizontalAlignment="Left"
                           Style="{StaticResource BoldTextStyle}" />
                <Border Grid.Row="5" BorderBrush="Transparent">
                    <ListBox ItemsSource="{Binding AssemblyList}"
                             Style="{StaticResource ListBox.Small}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:ListBoxScrollToCurrentBehavior />
                        </i:Interaction.Behaviors>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <hc:UniformSpacingPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}"
                                               Width="300"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AssemblyVersion}"
                                               Width="120"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextTrimming="None" />
                                </hc:UniformSpacingPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
        <!--#endregion-->
        <hc:UniformSpacingPanel Grid.Row="2"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Spacing="10">
            <Button Content="Update"
                    Command="{Binding VersionUpdateCommand}"
                    hc:IconElement.Geometry="{StaticResource RotateRightGeometry}"
                    Style="{StaticResource ButtonPrimary.Loading}" />
            <Button Content="Cancel"
                    Command="{Binding CloseCommand}"
                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                    Style="{StaticResource ButtonWarning}" />
        </hc:UniformSpacingPanel>
    </Grid>
</hc:Window>