<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="D:/Nano/Cuga-Calibration/logs/nlog/nlog-window.log">

    <variable name="logDirectory" value="D:/Nano/Cuga-Calibration/logs" />

    <extensions>
        <add assembly="Net.Utilities.Nlog" />
        <add assembly="Net.Utilities.WPF.NLogViewer" />
    </extensions>
    <targets async="true">
        <target xsi:type="NLogViewer" name="targetNLogViewer"
                layout="[${date:format=yyyy-MM-dd HH\:mm\:ss} ${level:uppercase=true}] ${htmlViewLayout}${onexception: \: ${exception:format=tostring}} " />
        <target xsi:type="Html" name="targetHtml"
                dateTime="${longdate}"
                version="${assembly-version}"
                logger="${logger}"
                thread="${threadname:whenEmpty=${threadid}}"
                callSite="${callsite:methodName=true}.${callsite-linenumber}"
                stackTrace="${stacktrace}"
                exception="${exception:format=tostring}"
                fileName="${logDirectory}-html-v2/${logger}/${shortdate}/${htmlFileLayout}-${date:format=yyyyMMddHHmmssfffff}.html" />
        <!-- archiveAboveSize: 单个文件最大大小（单位B）, 下例： 20MB -->
        <!-- maxArchiveFiles: 保留的存档文件的最大数量 -->
        <!-- maxArchiveDays: 保存天数 -->
        <target xsi:type="File" name="allFileAppender" encoding="utf-8"
                archiveAboveSize="10000000" maxArchiveFiles="50" maxArchiveDays="7"
                fileName="${logDirectory}/all/${shortdate}.log"
                layout="[${longdate}] ${level:uppercase=true} ${callsite:methodName=true}.${callsite-linenumber} ${message}${onexception: \: ${exception:format=tostring}}" />
        <target xsi:type="File" name="traceFileAppender" encoding="utf-8"
                archiveAboveSize="20971520" maxArchiveFiles="50" maxArchiveDays="7"
                fileName="${logDirectory}/trace/${shortdate}.log"
                layout="[${longdate}] ${message}" />
        <target xsi:type="File" name="debugFileAppender" encoding="utf-8"
                archiveAboveSize="20971520" maxArchiveFiles="50" maxArchiveDays="7"
                fileName="${logDirectory}/debug/${shortdate}.log"
                layout="======================================================================
				       ${newline}[记录时间] ${longdate}
					   ${newline}[日志级别] ${level:uppercase=false}
					   ${newline}[当前版本] ${assembly-version}
					   ${newline}[线程编号] ${threadname:whenEmpty=${threadid}}
					   ${newline}[当前类名] ${logger}
					   ${newline}[当前行号] ${callsite:methodName=true}.${callsite-linenumber}
					   ${newline}[当前描述] ${message}
					   ${newline}[调用堆栈] ${stacktrace}
					   ${onexception: ${newline}[异常描述] ${exception:format=tostring}}" />
        <target xsi:type="File" name="infoFileAppender" encoding="utf-8"
                archiveAboveSize="20971520" maxArchiveFiles="50" maxArchiveDays="10"
                fileName="${logDirectory}/info/${shortdate}.log"
                layout="======================================================================
				       ${newline}[记录时间] ${longdate}
					   ${newline}[日志级别] ${level:uppercase=false}
					   ${newline}[当前版本] ${assembly-version}
					   ${newline}[线程编号] ${threadname:whenEmpty=${threadid}}
					   ${newline}[当前类名] ${logger}
					   ${newline}[当前行号] ${callsite:methodName=true}.${callsite-linenumber}
					   ${newline}[当前描述] ${message}
					   ${newline}[调用堆栈] ${stacktrace}
					   ${onexception: ${newline}[异常描述] ${exception:format=tostring}}" />
        <target xsi:type="File" name="warnFileAppender" encoding="utf-8"
                archiveAboveSize="20971520" maxArchiveFiles="100" maxArchiveDays="30"
                fileName="${logDirectory}/warn/${shortdate}.log"
                layout="======================================================================
				       ${newline}[记录时间] ${longdate}
					   ${newline}[日志级别] ${level:uppercase=false}
					   ${newline}[当前版本] ${assembly-version}
					   ${newline}[线程编号] ${threadname:whenEmpty=${threadid}}
					   ${newline}[出错类名] ${logger}
					   ${newline}[出错行号] ${callsite:methodName=true}.${callsite-linenumber}
					   ${newline}[错误描述] ${message}
					   ${newline}[调用堆栈] ${stacktrace}
					   ${onexception: ${newline}[异常描述] ${exception:format=tostring}}" />
        <target xsi:type="File" name="errorFileAppender" encoding="utf-8"
                archiveAboveSize="20971520" maxArchiveFiles="100" maxArchiveDays="30"
                fileName="${logDirectory}/error/${shortdate}.log"
                layout="======================================================================
				       ${newline}[记录时间] ${longdate}
					   ${newline}[日志级别] ${level:uppercase=false}
					   ${newline}[当前版本] ${assembly-version}
					   ${newline}[线程编号] ${threadname:whenEmpty=${threadid}}
					   ${newline}[出错类名] ${logger}
					   ${newline}[出错行号] ${callsite:methodName=true}.${callsite-linenumber}
					   ${newline}[错误描述] ${message}
					   ${newline}[调用堆栈] ${stacktrace}
					   ${onexception: ${newline}[异常描述] ${exception:format=tostring}}" />
        <target xsi:type="File" name="fatalFileAppender" encoding="utf-8"
                archiveAboveSize="20971520" maxArchiveFiles="100" maxArchiveDays="30"
                fileName="${logDirectory}/fatal/${shortdate}.log"
                layout="======================================================================
				       ${newline}[记录时间] ${longdate}
					   ${newline}[日志级别] ${level:uppercase=false}
					   ${newline}[当前版本] ${assembly-version}
					   ${newline}[线程编号] ${threadname:whenEmpty=${threadid}}
					   ${newline}[出错类名] ${logger}
					   ${newline}[出错行号] ${callsite:methodName=true}.${callsite-linenumber}
					   ${newline}[错误描述] ${message}
					   ${newline}[调用堆栈] ${stacktrace}
					   ${onexception: ${newline}[异常描述] ${exception:format=tostring}}" />
    </targets>

    <rules>
        <logger name="*" minlevel="Trace" maxlevel="Fatal" writeTo="targetNLogViewer" />
        <logger name="*" minlevel="Trace" maxlevel="Fatal" writeTo="allFileAppender" />
        <logger name="*" minlevel="Trace" maxlevel="Trace" writeTo="traceFileAppender" />
        <logger name="*" minlevel="Debug" maxlevel="Debug" writeTo="debugFileAppender" />
        <logger name="*" minlevel="Info" maxlevel="Info" writeTo="infoFileAppender" />
        <logger name="*" minlevel="Warn" maxlevel="Warn" writeTo="warnFileAppender" />
        <logger name="*" minlevel="Error" maxlevel="Error" writeTo="errorFileAppender" />
        <logger name="*" minlevel="Fatal" maxlevel="Fatal" writeTo="fatalFileAppender" />
        <logger name='*' minlevel="Trace" maxlevel="Fatal" writeTo='targetHtml' />
    </rules>
</nlog>