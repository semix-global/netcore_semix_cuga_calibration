<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:units="clr-namespace:WPF.CustomControl.UI.Common"
                    xmlns:treeViewList="clr-namespace:WPF.CustomControl.UI.DepartmentTreeView">
    <Style TargetType="{x:Type treeViewList:DepartmentTreeView}">
        <Setter Property="BorderBrush" Value="#AAAAAA" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type treeViewList:DepartmentTreeView}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"
                                                  MinWidth="150"
                                                  SharedSizeGroup="FirstColumn" />
                                <ColumnDefinition Width="Auto"
                                                  MinWidth="250"
                                                  SharedSizeGroup="SecondColumn" />
                                <ColumnDefinition Width="Auto"
                                                  MinWidth="100"
                                                  SharedSizeGroup="ThirdColumn" />
                                <ColumnDefinition Width="Auto"
                                                  MinWidth="180"
                                                  SharedSizeGroup="FourthColumn" />
                            </Grid.ColumnDefinitions>
                            <Label x:Name="isSelected" Grid.Column="0"
                                   Content="Id"
                                   Padding="1"
                                   BorderBrush="#AAAAAA"
                                   BorderThickness="0,0,0,0" />
                            <Label Grid.Column="1"
                                   Content="Name"
                                   Padding="1"
                                   BorderBrush="#AAAAAA"
                                   BorderThickness="0,0,0,0" />
                            <Label Grid.Column="2"
                                   Content="Leader"
                                   Padding="1"
                                   BorderBrush="#AAAAAA"
                                   BorderThickness="0,0,0,0" />
                            <Label Grid.Column="3"
                                   Content="Remark"
                                   Padding="1"
                                   BorderBrush="#AAAAAA"
                                   BorderThickness="0,0,0,0" />
                            <units:MagicStackPanel Grid.Row="1"
                                                   Grid.ColumnSpan="4"
                                                   VerticalAlignment="Top"
                                                   ItemHeight="{Binding ElementName=Items, Path=ActualHeight}" />
                            <ItemsPresenter x:Name="Items" Grid.Row="1"
                                            Grid.ColumnSpan="4"
                                            VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>