<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <UseWPF>true</UseWPF>
        <AssemblyName>Core.Services</AssemblyName>
        <RootNamespace>Core.Services</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SourceGenerator.InjectHostDI">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="HAlgorithm">
            <HintPath>$(RepositoryDirectory)\Dependencies\HAlgorithm.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="System.ServiceModel" />
        <Reference Include="Semix.WcfTransfer.Interfaces">
            <HintPath>$(RepositoryDirectory)\Dependencies\Semix.Cuga.Runtime2.0\Semix.WcfTransfer.Interfaces.dll</HintPath>
        </Reference>
        <Reference Include="Cuga.Agent.EngineBase">
            <HintPath>$(RepositoryDirectory)\Dependencies\Semix.Cuga.Runtime2.0\Cuga.Agent.EngineBase.dll</HintPath>
        </Reference>
        <Reference Include="Cuga.Engine.Interface">
            <HintPath>$(RepositoryDirectory)\Dependencies\Semix.Cuga.Runtime2.0\Cuga.Engine.Interface.dll</HintPath>
        </Reference>
        <Reference Include="Semix.CoreLib">
            <HintPath>$(RepositoryDirectory)\Dependencies\Semix.Cuga.Runtime2.0\Semix.CoreLib.dll</HintPath>
        </Reference>
        <Reference Include="Semix.WcfTransfer.DTO">
            <HintPath>$(RepositoryDirectory)\Dependencies\Semix.Cuga.Runtime2.0\Semix.WcfTransfer.DTO.dll</HintPath>
        </Reference>
        <Reference Include="Cuga.Data.DataStruct">
            <HintPath>$(RepositoryDirectory)\Dependencies\Semix.Cuga.Runtime2.0\Cuga.Data.DataStruct.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core.Algorithm\03. Core.Algorithm.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Interfaces\ICalibrationStageService.*.cs">
            <DependentUpon>ICalibrationStageService.cs</DependentUpon>
        </Compile>
        <Compile Update="Implements\WCF\CalibrationStageServiceImpl.*.cs">
            <DependentUpon>CalibrationStageServiceImpl.cs</DependentUpon>
        </Compile>
        <Compile Update="Implements\Mock\CalibrationStageServiceMockImpl.*.cs">
            <DependentUpon>CalibrationStageServiceMockImpl.cs</DependentUpon>
        </Compile>
        <Compile Update="Interfaces\ICalibrationAlgorithmService.*.cs">
            <DependentUpon>ICalibrationAlgorithmService.cs</DependentUpon>
        </Compile>
        <Compile Update="Implements\CalibrationAlgorithmServiceImpl.*.cs">
            <DependentUpon>CalibrationAlgorithmServiceImpl.cs</DependentUpon>
        </Compile>
        <Compile Update="Implements\Mock\CalibrationAlgorithmServiceMockImpl.*.cs">
            <DependentUpon>CalibrationAlgorithmServiceMockImpl.cs</DependentUpon>
        </Compile>
    </ItemGroup>

</Project>