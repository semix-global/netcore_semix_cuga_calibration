<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net480;net8.0-windows</TargetFrameworks>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SourceGenerator.InjectHostDI">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="halcondotnetxl">
            <HintPath>..\..\Dependencies\Halcon\halcondotnetxl.dll</HintPath>
        </Reference>
        <Reference Include="HAlgorithm">
            <HintPath>..\..\Dependencies\Semix.Arithmetic2.0\HAlgorithm.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Utilities\Net.Utilities.WPF\Net.Utilities.WPF.csproj" />
        <ProjectReference Include="..\Core.Models\Core.Models.csproj" />
    </ItemGroup>

    <!--<ItemGroup>
        <Using Include="System.IO" />
    </ItemGroup>-->

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
        <PackageReference Include="Grpc.Net.Client" />
        <PackageReference Include="Semix.CoreLib.Grpc" />
        <PackageReference Include="Cuga.Interface" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net480'">
        <Reference Include="System.ServiceModel" />
        <Reference Include="System.Net.Http" />
        <Reference Include="Semix.WcfTransfer.Interfaces">
            <HintPath>..\..\Dependencies\Semix.Cuga.Runtime2.0\Semix.WcfTransfer.Interfaces.dll</HintPath>
        </Reference>
        <Reference Include="Cuga.Agent.EngineBase">
            <HintPath>..\..\Dependencies\Semix.Cuga.Runtime2.0\Cuga.Agent.EngineBase.dll</HintPath>
        </Reference>
        <Reference Include="Cuga.Engine.Interface">
            <HintPath>..\..\Dependencies\Semix.Cuga.Runtime2.0\Cuga.Engine.Interface.dll</HintPath>
        </Reference>
        <Reference Include="Semix.CoreLib">
            <HintPath>..\..\Dependencies\Semix.Cuga.Runtime2.0\Semix.CoreLib.dll</HintPath>
        </Reference>
        <Reference Include="Semix.WcfTransfer.DTO">
            <HintPath>..\..\Dependencies\Semix.Cuga.Runtime2.0\Semix.WcfTransfer.DTO.dll</HintPath>
        </Reference>
        <Reference Include="Cuga.Data.DataStruct">
            <HintPath>..\..\Dependencies\Semix.Cuga.Runtime2.0\Cuga.Data.DataStruct.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
        <Compile Remove="Implements\Wcf\*.cs" />
        <None Include="Implements\Wcf\*.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net480'">
        <Compile Remove="Implements\Grpc\*.cs" />
        <None Include="Implements\Grpc\*.cs" />
    </ItemGroup>

</Project>