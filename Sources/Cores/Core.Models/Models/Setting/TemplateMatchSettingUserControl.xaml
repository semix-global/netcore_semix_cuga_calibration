<UserControl x:Class="Core.Models.Models.Setting.TemplateMatchSettingUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:algorithm="clr-namespace:Core.Models.Enums.Algorithm"
             xmlns:calibrationAlgorithm="clr-namespace:Net.Utilities.Calibration;assembly=Net.Utilities.Calibration"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:Core.Models.Models.Setting"
             xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--  2026-10-24 用户裁定：参数设置默认折叠（低频修改项，减少界面占用），点击展开  -->
    <Expander Header="Template Match Param"
              IsExpanded="False"
              ExpandDirection="Down">
        <Border Style="{StaticResource BorderRegion}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                <!--  模板尺寸：两算法库通用  -->
                <ComboBox hc:TitleElement.Title="Template Size: "
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.TitleWidth="160"
                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type algorithm:AlgorithmTemplateSizeEnum}}}"
                          SelectedItem="{Binding TemplateSize}"
                          Style="{StaticResource ComboBoxExtend}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--  Halcon 模板类型：仅 HAlgorithm 显示  -->
                <ComboBox hc:TitleElement.Title="Template Type: "
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.TitleWidth="160"
                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type algorithm:AlgorithmTemplateTypeEnum}}}"
                          SelectedItem="{Binding Halcon.TemplateType}">
                    <ComboBox.Style>
                        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Engine, RelativeSource={RelativeSource AncestorType={x:Type local:TemplateMatchSettingUserControl}}}" Value="{x:Static calibrationAlgorithm:AlgorithmEngineTypeEnum.HAlgorithm}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--  AlgoCSharp 匹配方法：仅 AlgoCSharp 显示  -->
                <ComboBox hc:TitleElement.Title="Match Method: "
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.TitleWidth="160"
                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type algorithm:TemplateMatchMethodEnum}}}"
                          SelectedItem="{Binding AlgoCSharp.Method}">
                    <ComboBox.Style>
                        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Engine, RelativeSource={RelativeSource AncestorType={x:Type local:TemplateMatchSettingUserControl}}}" Value="{x:Static calibrationAlgorithm:AlgorithmEngineTypeEnum.AlgoCSharp}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--  AlgoCSharp 金字塔层级：仅 AlgoCSharp 显示  -->
                <hc:NumericUpDown hc:TitleElement.Title="Pyramid Levels: "
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.TitleWidth="160"
                                  Minimum="0"
                                  Value="{Binding AlgoCSharp.PyramidLevels}">
                    <hc:NumericUpDown.Style>
                        <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Engine, RelativeSource={RelativeSource AncestorType={x:Type local:TemplateMatchSettingUserControl}}}" Value="{x:Static calibrationAlgorithm:AlgorithmEngineTypeEnum.AlgoCSharp}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>
                <Button Content="Restore"
                        Command="{Binding RestoreCommand}"
                        CommandParameter="{x:Static models:Constants.False}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ButtonDefault}" />
            </hc:UniformSpacingPanel>
        </Border>
    </Expander>
</UserControl>