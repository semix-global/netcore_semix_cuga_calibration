<UserControl x:Class="Core.Models.Models.Setting.PixelSizeSettingUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:algorithm="clr-namespace:Core.Models.Enums.Algorithm"
             xmlns:calibrationAlgorithm="clr-namespace:Net.Utilities.Calibration;assembly=Net.Utilities.Calibration"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:Core.Models.Models.Setting"
             xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--  仿 TemplateMatchSettingUserControl 范式：默认折叠（低频修改项，减少界面占用），点击展开；库专属参数按引擎显隐  -->
    <Expander Header="Pixel Size Param"
              IsExpanded="False"
              ExpandDirection="Down">
        <Border Style="{StaticResource BorderRegion}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                <!--  AlgoCSharp 算法库专属参数：仅 AlgoCSharp 引擎显示；Halcon 引擎当前无可开放参数  -->
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:UniformSpacingPanel.Style>
                        <Style TargetType="hc:UniformSpacingPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Engine, RelativeSource={RelativeSource AncestorType={x:Type local:PixelSizeSettingUserControl}}}" Value="{x:Static calibrationAlgorithm:AlgorithmEngineTypeEnum.AlgoCSharp}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:UniformSpacingPanel.Style>

                    <hc:NumericUpDown hc:TitleElement.Title="Roi Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.RoiFrac}" />
                    <ComboBox hc:TitleElement.Title="Period Op: "
                              hc:TitleElement.TitlePlacement="Left"
                              hc:TitleElement.TitleWidth="160"
                              ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type algorithm:AlgorithmPeriodOpEnum}}}"
                              SelectedItem="{Binding AlgoCSharp.PeriodOp}"
                              Style="{StaticResource ComboBoxExtend}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <hc:NumericUpDown hc:TitleElement.Title="Proj Median R: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1024"
                                      Value="{Binding AlgoCSharp.ProjMedianR}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Proj Gauss Sigma: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="100"
                                      Increment="0.1"
                                      Value="{Binding AlgoCSharp.ProjGaussSigma}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period Half (0=Auto): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="4096"
                                      Value="{Binding AlgoCSharp.PeriodHalf}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period N Min: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="4096"
                                      Value="{Binding AlgoCSharp.PeriodNMin}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period N Max (0=Auto): "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="4096"
                                      Value="{Binding AlgoCSharp.PeriodNMax}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period Peak Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.PeriodPeakFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Median Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.001"
                                      Value="{Binding AlgoCSharp.AnchorMedianFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Gauss Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.001"
                                      Value="{Binding AlgoCSharp.AnchorGaussFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Lo Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.AnchorLoFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Hi Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.AnchorHiFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Nms Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.AnchorNmsFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Template Size Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.TemplateSizeFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Match Radius Px: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1024"
                                      Value="{Binding AlgoCSharp.MatchRadiusPx}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Match Score Thresh: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.MatchScoreThresh}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Fit Jitter: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="100"
                                      Increment="0.1"
                                      Value="{Binding AlgoCSharp.FitJitter}" />
                </hc:UniformSpacingPanel>
                <Button Content="Restore"
                        Command="{Binding RestoreCommand}"
                        CommandParameter="{x:Static models:Constants.False}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ButtonDefault}" />
            </hc:UniformSpacingPanel>
        </Border>
    </Expander>
</UserControl>