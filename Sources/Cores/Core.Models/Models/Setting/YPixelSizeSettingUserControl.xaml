<UserControl x:Class="Core.Models.Models.Setting.YPixelSizeSettingUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:algorithm="clr-namespace:Core.Models.Enums.Algorithm"
             xmlns:calibrationAlgorithm="clr-namespace:Net.Utilities.Calibration;assembly=Net.Utilities.Calibration"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.NLogViewer.Extensions;assembly=Net.Utilities.WPF.NLogViewer"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:Core.Models.Models.Setting"
             xmlns:models="clr-namespace:Net.Utilities.Models;assembly=Net.Utilities.Models"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--  仿 TemplateMatchSettingUserControl 范式：默认折叠（低频修改项，减少界面占用），点击展开；库专属参数按引擎显隐  -->
    <Expander Header="Y Pixel Size Param"
              IsExpanded="False"
              ExpandDirection="Down">
        <Border Style="{StaticResource BorderRegion}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                <!--  AlgoCSharp 算法库专属参数（24 项）：仅 AlgoCSharp 引擎显示；Halcon 引擎当前无可开放参数  -->
                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5">
                    <hc:UniformSpacingPanel.Style>
                        <Style TargetType="hc:UniformSpacingPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Engine, RelativeSource={RelativeSource AncestorType={x:Type local:YPixelSizeSettingUserControl}}}" Value="{x:Static calibrationAlgorithm:AlgorithmEngineTypeEnum.AlgoCSharp}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:UniformSpacingPanel.Style>

                    <ComboBox hc:TitleElement.Title="Period Y Op: "
                              hc:TitleElement.TitlePlacement="Left"
                              hc:TitleElement.TitleWidth="160"
                              ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type algorithm:AlgorithmPeriodOpEnum}}}"
                              SelectedItem="{Binding AlgoCSharp.PeriodYOp}"
                              Style="{StaticResource ComboBoxExtend}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox hc:TitleElement.Title="Period X Op: "
                              hc:TitleElement.TitlePlacement="Left"
                              hc:TitleElement.TitleWidth="160"
                              ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type algorithm:AlgorithmPeriodOpEnum}}}"
                              SelectedItem="{Binding AlgoCSharp.PeriodXOp}"
                              Style="{StaticResource ComboBoxExtend}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <hc:NumericUpDown hc:TitleElement.Title="Period Zeropad: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="4096"
                                      Value="{Binding AlgoCSharp.PeriodZeropad}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period Top N: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="64"
                                      Value="{Binding AlgoCSharp.PeriodTopN}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period Y Min Px: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1024"
                                      Value="{Binding AlgoCSharp.PeriodYMinPx}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period X Min Px: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1024"
                                      Value="{Binding AlgoCSharp.PeriodXMinPx}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period Y Min Dist: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1024"
                                      Value="{Binding AlgoCSharp.PeriodYMinDist}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period X Min Dist: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1024"
                                      Value="{Binding AlgoCSharp.PeriodXMinDist}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period Y Min Cycles: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1024"
                                      Increment="0.1"
                                      Value="{Binding AlgoCSharp.PeriodYMinCycles}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Period X Min Cycles: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1024"
                                      Increment="0.1"
                                      Value="{Binding AlgoCSharp.PeriodXMinCycles}" />

                    <!--  检测行 Detect 参数  -->
                    <hc:NumericUpDown hc:TitleElement.Title="Mid Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.MidFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Detect Min Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.DetectMinFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Detect Max Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.DetectMaxFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Detect Need Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.DetectNeedFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Detect Inset K: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.DetectInsetK}" />

                    <!--  锚点 Anchor 参数  -->
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Median Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.001"
                                      Value="{Binding AlgoCSharp.AnchorMedianFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Gauss Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.001"
                                      Value="{Binding AlgoCSharp.AnchorGaussFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Lo Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.AnchorLoFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Hi Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.AnchorHiFrac}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Anchor Nms Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.AnchorNmsFrac}" />

                    <!--  配对 Match / 模板 Template 参数  -->
                    <hc:NumericUpDown hc:TitleElement.Title="Match Radius Px: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1024"
                                      Value="{Binding AlgoCSharp.MatchRadiusPx}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Match Score Thresh: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="1"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.MatchScoreThresh}" />
                    <hc:NumericUpDown hc:TitleElement.Title="Template Size Frac: "
                                      hc:TitleElement.TitlePlacement="Left"
                                      hc:TitleElement.TitleWidth="160"
                                      Style="{StaticResource NumericUpDownExtend}"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="0.01"
                                      Value="{Binding AlgoCSharp.TemplateSizeFrac}" />
                </hc:UniformSpacingPanel>
                <Button Content="Restore"
                        Command="{Binding RestoreCommand}"
                        CommandParameter="{x:Static models:Constants.False}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ButtonDefault}" />
            </hc:UniformSpacingPanel>
        </Border>
    </Expander>
</UserControl>