<UserControl x:Class="Core.Models.Models.Common.DarkField.BestFocusDTOUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:darkField="clr-namespace:Core.Models.Models.Common.DarkField"
             d:DataContext="{d:DesignInstance Type=darkField:BestFocus}"
             d:DesignHeight="300"
             d:DesignWidth="300"
             mc:Ignorable="d">
    <TabControl>
        <TabItem Header="Y Strehl Ratio">
            <Border Margin="5" Style="{StaticResource BorderRegion}">
                <ContentControl Content="{Binding YStrehlRatioScatterPlotControl, Mode=OneWay}" />
            </Border>
        </TabItem>
        <TabItem Header="X Strehl Ratio">
            <Border Margin="5" Style="{StaticResource BorderRegion}">
                <ContentControl Content="{Binding XStrehlRatioScatterPlotControl, Mode=OneWay}" />
            </Border>
        </TabItem>
    </TabControl>
</UserControl>