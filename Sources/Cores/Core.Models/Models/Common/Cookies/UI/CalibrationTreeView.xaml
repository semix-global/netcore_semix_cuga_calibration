<UserControl x:Name="Root"
             x:Class="Core.Models.Models.Common.Cookies.UI.CalibrationTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:enums="clr-namespace:Local.SQL.DB.Providers.Models.Enums;assembly=Local.SQL.DB.Providers"
             xmlns:wpfAttachedHelper="clr-namespace:Net.Utilities.WPF.AttachedProperties;assembly=Net.Utilities.WPF.AttachedProperties"
             d:DesignHeight="800"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <TreeView ItemsSource="{Binding ItemsSource, ElementName=Root}">
            <TreeView.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="wpfAttachedHelper:MouseDoubleClickHelper.Command" Value="{Binding MouseDoubleClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Setter Property="wpfAttachedHelper:MouseDoubleClickHelper.CommandParameter" Value="{Binding}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Grid x:Name="Grid">
                        <hc:UniformSpacingPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                Orientation="Horizontal">
                            <CheckBox x:Name="CheckBox"
                                      IsChecked="{Binding CategoryItem.IsChecked, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      IsEnabled="{Binding CategoryItem.IsEnabled}"
                                      Visibility="{Binding CheckBoxVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="{Binding CheckBoxToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Style="{Binding CheckBoxStyle, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="{Binding SysMenu.Name}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource TextBlockDefault}" />
                            <Button x:Name="DetailButton"
                                    Content="Edit"
                                    Command="{Binding DetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="5,0"
                                    VerticalAlignment="Center"
                                    hc:IconElement.Geometry="{Binding DetailButtonIconGeometry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding DetailButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{Binding DetailButtonStyle, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </hc:UniformSpacingPanel>
                    </Grid>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding SysMenu.MenuTypeEnum}" Value="{x:Static enums:MenuTypeEnum.Catalog}">
                            <Setter TargetName="CheckBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DetailButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SysMenu.MenuTypeEnum}" Value="{x:Static enums:MenuTypeEnum.Menu}">
                            <Setter TargetName="Grid" Property="Margin" Value="-20,0,0,0" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>