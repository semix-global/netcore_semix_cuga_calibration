<UserControl x:Class="Core.Models.Models.Common.Pattern.OpticsConfigurationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:extensions="clr-namespace:Net.Utilities.WPF.Extensions;assembly=Net.Utilities.WPF"
             xmlns:pattern="clr-namespace:Core.Models.Models.Common.Pattern;assembly=Core.Models"
             xmlns:optics="clr-namespace:Core.Models.Enums.Optics"
             d:DataContext="{d:DesignInstance Type=pattern:OpticsConfiguration}"
             d:DesignWidth="300"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox Header="Optics Configuration">
        <Border Style="{StaticResource BorderRegion}">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2">
                <ComboBox hc:TitleElement.Title="Apodization Mode: "
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.TitleWidth="190"
                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type optics:OpticsApodizationModeEnum}}}"
                          SelectedItem="{Binding Path=OpticsApodizationModeEnum}"
                          Style="{StaticResource ComboBoxExtend}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox hc:TitleElement.Title="Polarization Mode: "
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.TitleWidth="190"
                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type optics:OpticsPolarizationModeEnum}}}"
                          SelectedItem="{Binding Path=OpticsPolarizationModeEnum}"
                          Style="{StaticResource ComboBoxExtend}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox hc:TitleElement.Title="Collector Polarization Mode: "
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.TitleWidth="190"
                          ItemsSource="{Binding Source={extensions:EnumBindingSource EnumType={x:Type optics:OpticsCollectorPolarizationModeEnum}}}"
                          SelectedItem="{Binding Path=OpticsCollectorPolarizationModeEnum}"
                          Style="{StaticResource ComboBoxExtend}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </hc:UniformSpacingPanel>
        </Border>
    </GroupBox>
</UserControl>