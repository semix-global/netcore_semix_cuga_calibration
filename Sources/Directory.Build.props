<Project>

    <PropertyGroup>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>12.0</LangVersion>
        <NeutralLanguage>en-US</NeutralLanguage>

        <AssemblyVersion>2.1.0.0523</AssemblyVersion>
        <FileVersion>2.1.0.0523</FileVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!-- VSTHRD002后面要删除, 警告是同步方法不能调用异步方法 -->
        <NoWarn>$(NoWarn);VSTHRD001;VSTHRD101;</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <MvvmToolkitEnableINotifyPropertyChangingSupport>false</MvvmToolkitEnableINotifyPropertyChangingSupport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="IDisposableAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(MSBuildProjectFile)'!='SourceGenerator.AssemblyMetadata.csproj' and '$(MSBuildProjectFile)'!='SourceGenerator.InjectHostDI.csproj'">
        <PackageReference Include="SourceGenerator.AssemblyMetadata">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net480' or '$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="PolySharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--<ItemGroup Condition="'$(TargetFramework)' == 'net480' or '$(TargetFramework)' == 'netstandard2.0'">
        <Compile Include="$(SolutionDir)\Utilities\RuntimeHelpers.cs">
            <Link>%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>-->

</Project>