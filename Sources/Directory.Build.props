<Project>

    <PropertyGroup>
        <RepositoryDirectory>$([System.IO.Path]::GetDirectoryName($(MSBuildThisFileDirectory.TrimEnd('\'))))</RepositoryDirectory>
        <BuildToolsDirectory>$(RepositoryDirectory)\Build</BuildToolsDirectory>
        <SolutionDirectory>$(SolutionDir.TrimEnd('\'))</SolutionDirectory>
    </PropertyGroup>

    <Import Project="$(BuildToolsDirectory)\Common.Build.props" />

    <PropertyGroup>
        <LangVersion>12.0</LangVersion>
        <Version>2.1.630</Version>
		<AssemblyVersion>2.1.630.0</AssemblyVersion>
        <FileVersion>2.1.630.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SourceGenerator.AssemblyMetadata">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>