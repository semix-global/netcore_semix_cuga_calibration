<Project>

    <PropertyGroup>
        <RepositoryDirectory>$([System.IO.Path]::GetDirectoryName($(MSBuildThisFileDirectory.TrimEnd('\'))))</RepositoryDirectory>
        <BuildToolsDirectory>$(RepositoryDirectory)\Build</BuildToolsDirectory>
        <SolutionDirectory>$(SolutionDir.TrimEnd('\'))</SolutionDirectory>

        <GitType>GitLab</GitType>
        <GitURL>http://192.168.0.28:8099/semix/software/publiclibraries/common/Net.Utilities</GitURL>
    </PropertyGroup>

    <Import Project="$(BuildToolsDirectory)\Common.Build.props" />

    <PropertyGroup Condition="$(Configuration.EndsWith('-B3')) Or $(Configuration.EndsWith('-B4'))">
        <Configurations>Debug-B3;Debug-B4;Release-B3;Release-B4</Configurations>
        <DefineConstants Condition="$(Configuration.EndsWith('-B3'))">$(DefineConstants);B3</DefineConstants>
        <DefineConstants Condition="$(Configuration.EndsWith('-B4'))">$(DefineConstants);B4</DefineConstants>
        <DefineConstants Condition="$(Configuration.StartsWith('Debug-'))">$(DefineConstants);DEBUG;TRACE</DefineConstants>
        <DefineConstants Condition="$(Configuration.StartsWith('Release-'))">$(DefineConstants);RELEASE;TRACE</DefineConstants>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>$(Configuration.StartsWith('Release-'))</Optimize>
    </PropertyGroup>

    <PropertyGroup>
        <Version>2.5.0603</Version>
        <AssemblyVersion>2.5.3.0603</AssemblyVersion>
        <FileVersion>2.5.3.0603</FileVersion>
    </PropertyGroup>

</Project>