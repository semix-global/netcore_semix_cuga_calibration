<Window x:Class="SkiaTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="MainWindow"
        Width="1000"
        Height="1000"
        WindowState="Maximized"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Content="10"
                    Width="50"
                    Height="20"
                    Margin="5"
                    Click="ButtonBaseOnClick"
                    Tag="10" />
            <Button Content="100"
                    Width="50"
                    Height="20"
                    Margin="5"
                    Click="ButtonBaseOnClick"
                    Tag="100" />
            <Button Content="500"
                    Width="50"
                    Height="20"
                    Margin="5"
                    Click="ButtonBaseOnClick"
                    Tag="500" />
            <Button Content="1000"
                    Width="50"
                    Height="20"
                    Margin="5"
                    Click="ButtonBaseOnClick"
                    Tag="1000" />
            <Button Content="???"
                    Width="50"
                    Height="20"
                    Margin="5"
                    Click="ButtonBase_OnClick" />
            <TextBox x:Name="TextBox"
                     Text="700"
                     Width="100"
                     Margin="5"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="TextBlockTime"
                       Text="time"
                       Margin="5"
                       VerticalAlignment="Center"
                       Foreground="Green" />
            <TextBlock x:Name="TextBlockFps"
                       Text="fps"
                       Margin="5"
                       VerticalAlignment="Center"
                       Foreground="Green" />
        </StackPanel>

        <wpf:SKElement x:Name="SkElement" Grid.Row="1"
                       PaintSurface="SKElement_OnPaintSurface" />
    </Grid>
</Window>