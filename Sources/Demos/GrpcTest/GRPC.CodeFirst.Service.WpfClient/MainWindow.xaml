<Window x:Class="GRPC.CodeFirst.Service.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfClient="clr-namespace:GRPC.CodeFirst.Service.WpfClient"
        xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
        xmlns:behaviors="clr-namespace:CanvasViewer.Behaviors;assembly=WPF.CanvasViewer"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:converters="clr-namespace:Net.Utilities.WPF.Converters;assembly=Net.Utilities.WPF"
        Title="MainWindow"
        Width="1000"
        Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        mc:Ignorable="d">
    <Window.DataContext>
        <wpfClient:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <converters:BitmapMemoryByteArrayToBitmapSourceConverter x:Key="BitmapMemoryByteArrayToBitmapSourceConverter" />
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding ClosedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <TabControl>
        <TabItem Header="Camera">
            <view:CanvasView BackgroundColor="#0A0A0A"
                             AxisColor="Red"
                             Interactive="True"
                             ShowAxes="True"
                             ShowCursor="False"
                             ShowGrid="False"
                             BackgroundImage="{Binding FpsImage, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}">
                <i:Interaction.Behaviors>
                    <behaviors:CanvasViewerFpsBehavior FpsValue="{Binding Fps}" />
                </i:Interaction.Behaviors>
            </view:CanvasView>
        </TabItem>
        <TabItem Header="Caller">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Local" HorizontalAlignment="Center" />
                        <Border Grid.Row="1"
                                Margin="10"
                                Background="LightGray">
                            <Image Source="{Binding LocalImage, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" Stretch="Uniform" />
                        </Border>
                        <TextBox Grid.Row="2"
                                 Text="{Binding LocalJson}"
                                 Margin="10" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Remote" HorizontalAlignment="Center" />
                        <Border Grid.Row="1"
                                Margin="10"
                                Background="LightGray">
                            <Image Source="{Binding RemoteImage, Converter={StaticResource BitmapMemoryByteArrayToBitmapSourceConverter}}" Stretch="Uniform" />
                        </Border>
                        <TextBox Grid.Row="2"
                                 Text="{Binding RemoteJson}"
                                 Margin="10" />
                    </Grid>
                </Grid>
                <Button Grid.Row="1"
                        Content="Read"
                        Command="{Binding ReadCommand}"
                        Height="50"
                        Margin="10" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>