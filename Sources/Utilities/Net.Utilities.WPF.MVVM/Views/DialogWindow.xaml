<hc:Window x:Class="Net.Utilities.WPF.MVVM.Views.DialogWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:wpfConverters="clr-namespace:Net.Utilities.WPF.Converters;assembly=Net.Utilities.WPF"
           xmlns:viewModels="clr-namespace:Net.Utilities.WPF.MVVM.ViewModels"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Width="1200"
           d:DataContext="{d:DesignInstance Type=viewModels:DialogWindowViewModel}"
           WindowStartupLocation="CenterScreen"
           SizeToContent="Height"
           WindowStyle="None"
           ResizeMode="NoResize"
           ShowInTaskbar="False"
           BorderThickness="2"
           BorderBrush="{Binding DialogTitleColor, Mode=OneWay, TargetNullValue=Black, FallbackValue=Black}"
           mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <hc:SimplePanel Background="{Binding DialogTitleColor, Mode=OneWay, TargetNullValue=Black, FallbackValue=Black}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                    <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <TextBlock Text="{Binding DialogTitle, Mode=OneWay, TargetNullValue='', FallbackValue=''}"
                       TextWrapping="Wrap"
                       Margin="0,5"
                       HorizontalAlignment="Center"
                       FontSize="15"
                       FontWeight="Bold"
                       Style="{StaticResource TextBlockDefault}" />
        </hc:SimplePanel>
        <TextBlock Grid.Row="1"
                   Text="{Binding DialogMessage, Mode=OneWay, TargetNullValue=Null}"
                   TextWrapping="Wrap"
                   Margin="10"
                   VerticalAlignment="Center"
                   FontSize="15" />
        <ItemsControl Grid.Row="2" ItemsSource="{Binding DialogButtonList}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Background="WhiteSmoke" Columns="{Binding DialogButtonList.Count}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Converter={x:Static wpfConverters:EnumLocalizationConverter.Instance}}"
                            Command="{Binding DataContext.ConfirmDialogResultCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Height="35"
                            Margin="10"
                            FontSize="15" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</hc:Window>