<hc:Window x:Class="Net.Utilities.WPF.MVVM.Views.ImageViewerWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:view="clr-namespace:CanvasViewer.View;assembly=WPF.CanvasViewer"
           xmlns:wpfConverters="clr-namespace:Net.Utilities.WPF.Converters;assembly=Net.Utilities.WPF"
           xmlns:viewModels="clr-namespace:Net.Utilities.WPF.MVVM.ViewModels"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:attachedHelper="clr-namespace:Net.Utilities.WPF.AttachedHelper;assembly=Net.Utilities.WPF"
           Width="1230"
           Height="420"
           d:DataContext="{d:DesignInstance Type=viewModels:ImageViewerWindowViewModel}"
           WindowStartupLocation="CenterScreen"
           WindowStyle="None"
           ShowInTaskbar="False"
           ResizeMode="NoResize"
           BorderThickness="2"
           mc:Ignorable="d">
    <hc:Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </hc:Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--#region Title-->
        <hc:SimplePanel Background="{StaticResource PrimaryBrush}">
            <StackPanel Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=Width}"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MethodName="DragMove" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TextBlock Text="{Binding ImageFilePath, StringFormat='Image Viewer {0}'}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource TextBlockDefault}" />
            </StackPanel>
            <Button Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Cursor="Hand">
                <Button.Style>
                    <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </hc:SimplePanel>
        <hc:ScrollViewer Grid.Row="1">
            <Border Padding="5"
                    Style="{StaticResource BorderRegion}"
                    Effect="{StaticResource EffectShadow1}"
                    Background="LightGray">
                <Border.Resources>
                    <attachedHelper:BindingProxy x:Key="BindingProxy" Value="{Binding}" />
                    <ContextMenu x:Key="ContextMenu" Placement="Left">
                        <MenuItem Command="{Binding Path=Value.(viewModels:ImageViewerWindowViewModel.SavePictureCommand), Source={StaticResource BindingProxy}}"
                                  CommandParameter="{Binding Path=PlacementTarget.(ContextMenu.Tag), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                                  Header="Save" />
                    </ContextMenu>
                </Border.Resources>
                <StackPanel Orientation="Vertical">
                    <ItemsControl VerticalAlignment="Bottom" ItemsSource="{Binding ImageList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:WaterfallPanel hc:PanelElement.FluidMoveBehavior="{StaticResource BehaviorXY200}" Groups="{Binding ImageCount}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <hc:UniformSpacingPanel Orientation="Vertical">
                                    <view:CanvasView Width="400"
                                                     Height="400"
                                                     AxisColor="Red"
                                                     BackgroundColor="#0A0A0A"
                                                     ContextMenu="{StaticResource ContextMenu}"
                                                     BackgroundImage="{Binding FilePath, Converter={x:Static wpfConverters:StringToBitmapSourceConverter.Instance}}"
                                                     Interactive="True"
                                                     ShowAxes="True"
                                                     ShowCursor="False"
                                                     ShowGrid="False"
                                                     Tag="{Binding .}" />
                                    <TextBlock Text="{Binding ImageName}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Foreground="Yellow" />
                                </hc:UniformSpacingPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </hc:ScrollViewer>
        <!--#endregion-->
    </Grid>
</hc:Window>